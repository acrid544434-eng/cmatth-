\section{Continuous Yield Mode Stability Envelope}
\label{app:continuous_yield_stability}

\subsection{Hybrid Dynamics Recap}

We recall the governing hybrid dynamics of the COSE engine:
\begin{equation}
  \frac{dX}{dt}
  = S \cdot v(X,p)
    + \sum_{k} v_k \, a_k(X) \circ dP_k(t),
  \label{eq:hybrid_dynamics}
\end{equation}
where
\begin{itemize}
  \item $X(t) \in \mathbb{R}^n$ is the intra-cellular species vector,
  \item $S \in \mathbb{R}^{n \times m}$ is the stoichiometric matrix,
  \item $v(X,p) \in \mathbb{R}^m$ is the kinetic rate vector (Michaelis–Menten / Hill),
  \item $v_k \in \mathbb{R}^n$ is the state-change vector for event $k$,
  \item $a_k(X)$ is the propensity function,
  \item $dP_k(t)$ is the increment of a Poisson process capturing discrete jumps.
\end{itemize}

Under \emph{Continuous Yield Mode}, the reactive stream bus ingests
high-frequency telemetry while enforcing a forced data output limit and
continuous stream ingestion.

\subsection{Composite Lyapunov Function Construction}

We construct a composite Lyapunov functional
\begin{equation}
  \mathcal{V}(X)
  = \mathcal{V}_{\mathrm{cont}}(X)
    + \mathcal{V}_{\mathrm{disc}}(X),
  \label{eq:composite_lyapunov}
\end{equation}
with
\begin{align}
  \mathcal{V}_{\mathrm{cont}}(X)
  &= (X - X^\star)^\top Q (X - X^\star),
  \label{eq:lyap_cont}\\
  \mathcal{V}_{\mathrm{disc}}(X)
  &= \sum_{k} D_{\mathrm{KL}}\!\left(
      \pi_k(X) \,\big\|\, \pi_k^\star
    \right),
  \label{eq:lyap_disc}
\end{align}
where
\begin{itemize}
  \item $X^\star$ is a nominal equilibrium or operating point,
  \item $Q \succ 0$ is a positive definite weighting matrix,
  \item $D_{\mathrm{KL}}(\cdot\|\cdot)$ is the Kullback–Leibler divergence,
  \item $\pi_k(X)$ is the instantaneous event distribution induced by $a_k(X)$,
  \item $\pi_k^\star$ is a reference distribution under nominal load.
\end{itemize}

\paragraph{Continuous Part.}
Along the continuous flow \eqref{eq:hybrid_dynamics} with $dP_k(t) = 0$,
we obtain
\begin{equation}
  \dot{\mathcal{V}}_{\mathrm{cont}}(X)
  = (X - X^\star)^\top
    \left( Q S \, v(X,p) + S^\top Q (X - X^\star) \right).
\end{equation}
Under standard dissipativity and boundedness assumptions on $v(X,p)$,
there exists $\alpha > 0$ such that
\begin{equation}
  \dot{\mathcal{V}}_{\mathrm{cont}}(X)
  \leq - \alpha \, \| X - X^\star \|^2
\end{equation}
for all $X$ in the operating region.

\paragraph{Discrete Part.}
For each jump event $k$ with $X^+ = X + v_k$, the discrete Lyapunov
increment satisfies
\begin{equation}
  \Delta \mathcal{V}_{\mathrm{disc}}(X)
  = \mathcal{V}_{\mathrm{disc}}(X^+) - \mathcal{V}_{\mathrm{disc}}(X).
\end{equation}
Under appropriate design of the event propensities $a_k(X)$ and
reference distributions $\pi_k^\star$, we enforce
\begin{equation}
  \mathbb{E}\left[ \Delta \mathcal{V}_{\mathrm{disc}}(X) \right]
  \leq 0,
\end{equation}
ensuring that the expected discrete contribution does not destabilize
the continuous drift.

\subsection{Token Index Integration into Drift Correction}

The active token transformation index
\begin{equation}
  \text{sr}
  = \div\{\degree\bullet\bigcirc\bullet\}
    + \{\mathbb{W}\yen\pounds\euro\}
    = \hat{^}
\end{equation}
is incorporated as a control parameter in the drift correction mapping
\begin{equation}
  v_{\mathrm{eff}}(X,p,\text{sr})
  = f_{\text{sr}}\!\left( v(X,p) \right),
\end{equation}
where $f_{\text{sr}}$ is chosen such that
\begin{equation}
  \dot{\mathcal{V}}_{\mathrm{cont}}(X;\text{sr})
  \leq - \alpha_{\text{sr}} \, \| X - X^\star \|^2,
  \qquad \alpha_{\text{sr}} > 0,
\end{equation}
for all admissible values of $\text{sr}$ in Continuous Yield Mode.
This guarantees that token-driven recalibration of the drift vector
preserves Lyapunov stability under high-frequency stream ingestion.

\subsection{Stability Envelope Theorem}

\begin{theorem}[Continuous Yield Mode Stability Envelope]
  Consider the hybrid system \eqref{eq:hybrid_dynamics} operating under
  Continuous Yield Mode with event rates bounded by
  \begin{equation}
    \lambda_{\max}
    = 1.5 \times 10^7 \; \text{events/sec},
  \end{equation}
  and with drift correction governed by the token index $\text{sr}$.
  Suppose:
  \begin{enumerate}
    \item The continuous kinetics $v(X,p)$ satisfy a global
          dissipativity condition with respect to $X^\star$.
    \item The discrete event distributions $\pi_k(X)$ are designed such
          that $\mathbb{E}[\Delta \mathcal{V}_{\mathrm{disc}}(X)] \leq 0$.
    \item The token mapping $f_{\text{sr}}$ preserves
          $\alpha_{\text{sr}} > 0$ for all admissible $\text{sr}$.
  \end{enumerate}
  Then the composite Lyapunov functional $\mathcal{V}(X)$ is
  non-increasing in expectation, and the COSE engine is
  \emph{Lyapunov stable} under Continuous Yield Mode, even in the
  presence of high-frequency asynchronous telemetry loads and extreme
  spatial density.
\end{theorem}

