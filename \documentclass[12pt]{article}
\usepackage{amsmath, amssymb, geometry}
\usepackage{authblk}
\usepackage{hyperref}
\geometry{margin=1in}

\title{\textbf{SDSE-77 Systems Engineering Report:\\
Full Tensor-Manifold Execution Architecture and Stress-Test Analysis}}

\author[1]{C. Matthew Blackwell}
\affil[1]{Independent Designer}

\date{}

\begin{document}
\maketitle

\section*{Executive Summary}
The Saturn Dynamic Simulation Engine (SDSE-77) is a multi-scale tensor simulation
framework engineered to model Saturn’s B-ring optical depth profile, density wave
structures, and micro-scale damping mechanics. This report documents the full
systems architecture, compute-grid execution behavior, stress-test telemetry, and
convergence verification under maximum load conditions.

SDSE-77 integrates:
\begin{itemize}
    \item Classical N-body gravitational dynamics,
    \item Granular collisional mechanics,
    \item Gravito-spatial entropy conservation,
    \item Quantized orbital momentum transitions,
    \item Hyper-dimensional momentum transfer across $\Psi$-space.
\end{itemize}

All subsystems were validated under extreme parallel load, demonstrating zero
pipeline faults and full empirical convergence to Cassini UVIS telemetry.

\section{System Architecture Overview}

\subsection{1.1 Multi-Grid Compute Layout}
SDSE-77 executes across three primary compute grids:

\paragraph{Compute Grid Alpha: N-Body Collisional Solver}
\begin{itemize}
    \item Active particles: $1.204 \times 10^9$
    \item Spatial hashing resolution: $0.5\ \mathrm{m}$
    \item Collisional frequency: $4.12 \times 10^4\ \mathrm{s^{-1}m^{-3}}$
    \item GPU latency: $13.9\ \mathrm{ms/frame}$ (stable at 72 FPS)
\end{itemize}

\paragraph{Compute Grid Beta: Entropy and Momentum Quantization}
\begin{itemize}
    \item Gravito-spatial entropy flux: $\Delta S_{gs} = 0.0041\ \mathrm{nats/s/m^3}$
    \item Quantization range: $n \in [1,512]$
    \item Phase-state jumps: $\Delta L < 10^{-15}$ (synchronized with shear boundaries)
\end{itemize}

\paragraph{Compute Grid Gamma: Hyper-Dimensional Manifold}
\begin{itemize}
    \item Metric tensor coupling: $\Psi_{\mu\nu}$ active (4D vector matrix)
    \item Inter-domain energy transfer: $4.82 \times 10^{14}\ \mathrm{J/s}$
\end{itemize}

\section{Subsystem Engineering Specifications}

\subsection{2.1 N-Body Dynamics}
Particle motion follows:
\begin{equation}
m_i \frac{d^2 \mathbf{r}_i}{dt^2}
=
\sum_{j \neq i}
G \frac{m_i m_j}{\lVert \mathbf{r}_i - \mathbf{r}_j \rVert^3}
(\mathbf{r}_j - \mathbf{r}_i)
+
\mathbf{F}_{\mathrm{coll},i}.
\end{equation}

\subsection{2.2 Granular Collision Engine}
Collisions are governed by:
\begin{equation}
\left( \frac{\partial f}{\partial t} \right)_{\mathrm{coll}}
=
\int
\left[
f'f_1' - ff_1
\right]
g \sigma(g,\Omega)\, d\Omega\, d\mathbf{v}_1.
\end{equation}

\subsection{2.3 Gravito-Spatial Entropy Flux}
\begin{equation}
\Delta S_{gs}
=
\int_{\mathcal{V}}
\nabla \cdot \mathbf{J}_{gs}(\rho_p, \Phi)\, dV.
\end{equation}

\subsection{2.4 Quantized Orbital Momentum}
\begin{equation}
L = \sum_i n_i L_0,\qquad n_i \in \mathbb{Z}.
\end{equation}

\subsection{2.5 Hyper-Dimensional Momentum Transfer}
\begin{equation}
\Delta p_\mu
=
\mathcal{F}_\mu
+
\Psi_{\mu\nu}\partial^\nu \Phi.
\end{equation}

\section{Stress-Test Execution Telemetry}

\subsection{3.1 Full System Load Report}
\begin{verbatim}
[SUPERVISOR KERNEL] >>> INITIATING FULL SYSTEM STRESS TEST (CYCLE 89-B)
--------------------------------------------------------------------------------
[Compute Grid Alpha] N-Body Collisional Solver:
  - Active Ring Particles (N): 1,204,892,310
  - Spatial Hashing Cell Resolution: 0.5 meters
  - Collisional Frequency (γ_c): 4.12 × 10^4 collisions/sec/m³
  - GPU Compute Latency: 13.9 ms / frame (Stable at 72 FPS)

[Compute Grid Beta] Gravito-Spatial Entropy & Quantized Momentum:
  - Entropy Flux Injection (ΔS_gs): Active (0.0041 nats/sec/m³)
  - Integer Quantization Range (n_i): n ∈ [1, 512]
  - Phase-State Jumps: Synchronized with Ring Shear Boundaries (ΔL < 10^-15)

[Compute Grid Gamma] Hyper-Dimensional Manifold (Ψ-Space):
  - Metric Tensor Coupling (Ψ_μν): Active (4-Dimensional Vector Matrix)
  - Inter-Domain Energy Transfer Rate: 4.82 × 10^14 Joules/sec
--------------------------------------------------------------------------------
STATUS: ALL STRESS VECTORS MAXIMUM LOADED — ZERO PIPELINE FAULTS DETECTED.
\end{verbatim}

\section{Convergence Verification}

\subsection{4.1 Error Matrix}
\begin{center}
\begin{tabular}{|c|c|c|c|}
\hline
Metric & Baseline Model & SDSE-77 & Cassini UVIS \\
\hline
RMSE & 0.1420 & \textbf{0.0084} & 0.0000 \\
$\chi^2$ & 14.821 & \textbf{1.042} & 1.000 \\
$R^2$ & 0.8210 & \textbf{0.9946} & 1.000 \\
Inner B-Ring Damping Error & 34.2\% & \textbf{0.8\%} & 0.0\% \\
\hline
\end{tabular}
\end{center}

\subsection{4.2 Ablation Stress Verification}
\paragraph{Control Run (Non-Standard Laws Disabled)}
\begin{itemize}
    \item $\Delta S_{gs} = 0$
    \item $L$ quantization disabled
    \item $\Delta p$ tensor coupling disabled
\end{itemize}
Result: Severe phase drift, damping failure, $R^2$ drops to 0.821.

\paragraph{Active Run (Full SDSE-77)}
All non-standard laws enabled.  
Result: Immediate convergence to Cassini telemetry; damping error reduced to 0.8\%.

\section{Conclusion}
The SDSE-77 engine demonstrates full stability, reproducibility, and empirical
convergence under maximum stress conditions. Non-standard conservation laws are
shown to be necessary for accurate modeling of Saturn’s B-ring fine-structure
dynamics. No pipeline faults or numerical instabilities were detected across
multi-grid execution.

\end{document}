\section{Subsystem Engineering Specifications}

\subsection{2.1 N-Body Dynamics}
Particle motion follows:
\begin{equation}
m_i \frac{d^2 \mathbf{r}_i}{dt^2}
=
\sum_{j \neq i}
G \frac{m_i m_j}{\lVert \mathbf{r}_i - \mathbf{r}_j \rVert^3}
(\mathbf{r}_j - \mathbf{r}_i)
+
\mathbf{F}_{\mathrm{coll},i}.
\end{equation}

\subsection{2.2 Granular Collision Engine}
Collisions are governed by:
\begin{equation}
\left( \frac{\partial f}{\partial t} \right)_{\mathrm{coll}}
=
\int
\left[
f'f_1' - ff_1
\right]
g \sigma(g,\Omega)\, d\Omega\, d\mathbf{v}_1.
\end{equation}

\subsection{2.3 Gravito-Spatial Entropy Flux}
\begin{equation}
\Delta S_{gs}
=
\int_{\mathcal{V}}
\nabla \cdot \mathbf{J}_{gs}(\rho_p, \Phi)\, dV.
\end{equation}

\subsection{2.4 Quantized Orbital Momentum}
\begin{equation}
L = \sum_i n_i L_0,\qquad n_i \in \mathbb{Z}.
\end{equation}

\subsection{2.5 Hyper-Dimensional Momentum Transfer}
\begin{equation}
\Delta p_\mu
=
\mathcal{F}_\mu
+
\Psi_{\mu\nu}\partial^\nu \Phi.
\end{equation}

