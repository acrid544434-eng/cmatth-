\subsection{General Relativistic Orbital Mechanics}

\subsubsection{Kerr–Newman Metric Tensor}
The Kerr–Newman metric in Boyer–Lindquist coordinates is:
\[
ds^2 = -\frac{\Delta - a^2\sin^2\theta}{\Sigma} dt^2 
- \frac{2a\sin^2\theta (2Mr - Q^2)}{\Sigma} dt\, d\phi
+ \frac{\Sigma}{\Delta} dr^2
+ \Sigma\, d\theta^2
+ \frac{A\sin^2\theta}{\Sigma} d\phi^2
\]
where:
\[
\Delta = r^2 - 2Mr + a^2 + Q^2, \quad
\Sigma = r^2 + a^2\cos^2\theta, \quad
A = (r^2 + a^2)^2 - a^2\Delta\sin^2\theta.
\]

\subsubsection{Geodesic Equation Derivation}
The geodesic equation:
\[
\frac{d^2 x^\mu}{d\tau^2} + \Gamma^\mu_{\alpha\beta}
\frac{dx^\alpha}{d\tau}\frac{dx^\beta}{d\tau} = 0
\]
is derived by extremizing the action:
\[
S = \int d\tau \sqrt{-g_{\mu\nu} \dot{x}^\mu \dot{x}^\nu}.
\]

Variation yields:
\[
\delta S = 0 \Rightarrow 
\Gamma^\mu_{\alpha\beta} = 
\frac{1}{2} g^{\mu\lambda}
(\partial_\alpha g_{\beta\lambda}
+ \partial_\beta g_{\alpha\lambda}
- \partial_\lambda g_{\alpha\beta}).
\]

\subsection{Spectroscopic Redshift Derivations}

\subsubsection{Doppler Shift}
For radial velocity $v$:
\[
\lambda_{\text{obs}} = \lambda_0
\sqrt{\frac{1 + v/c}{1 - v/c}}.
\]

\subsubsection{Gravitational Redshift}
From the Kerr–Newman metric:
\[
\frac{\Delta \lambda}{\lambda}
= \sqrt{\frac{g_{tt}(r_{\text{emit}})}{g_{tt}(r_{\text{obs}})}} - 1.
\]

For weak fields:
\[
\frac{\Delta \lambda}{\lambda} \approx \frac{GM}{rc^2}.
\]

\subsection{Navier–Stokes Derivations on Cubed-Sphere Grids}

\subsubsection{Compressible Navier–Stokes}
\[
\frac{\partial \rho}{\partial t}
+ \nabla \cdot (\rho \mathbf{u}) = 0,
\]
\[
\frac{\partial (\rho \mathbf{u})}{\partial t}
+ \nabla \cdot (\rho \mathbf{u}\mathbf{u})
= -\nabla p + \nabla \cdot \bm{\tau},
\]
\[
\frac{\partial E}{\partial t}
+ \nabla \cdot [(E + p)\mathbf{u}]
= \nabla \cdot (k\nabla T) + \Phi.
\]

\subsubsection{Cubed-Sphere Coordinate Transform}
Let $(\xi, \eta)$ be local coordinates on a face:
\[
\mathbf{x} = R \frac{(1, \xi, \eta)}{\sqrt{1 + \xi^2 + \eta^2}}.
\]

Jacobian:
\[
J = \frac{R^2}{(1 + \xi^2 + \eta^2)^{3/2}}.
\]

