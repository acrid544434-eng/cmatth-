\section{Manifolds and Coordinate Systems}
Let $(\mathcal{M}, g_{\mu\nu})$ denote a four-dimensional Lorentzian
manifold. Coordinates $x^\mu$ are chosen such that the metric signature
is $(-,+,+,+)$.

\subsection{Metric Tensor}
The metric tensor $g_{\mu\nu}$ defines the invariant interval:
\[
ds^2 = g_{\mu\nu} dx^\mu dx^\nu.
\]

For Kerr spacetime in Boyer–Lindquist coordinates:
\[
g_{\mu\nu} =
\begin{pmatrix}
-(1 - \frac{2Mr}{\Sigma}) & 0 & 0 & -\frac{2Mar\sin^2\theta}{\Sigma} \\
0 & \frac{\Sigma}{\Delta} & 0 & 0 \\
0 & 0 & \Sigma & 0 \\
-\frac{2Mar\sin^2\theta}{\Sigma} & 0 & 0 &
\left(r^2 + a^2 + \frac{2Ma^2 r \sin^2\theta}{\Sigma}\right)\sin^2\theta
\end{pmatrix}
\]
where
\[
\Sigma = r^2 + a^2 \cos^2\theta, \qquad
\Delta = r^2 - 2Mr + a^2.
\]

\section{Tensor Calculus}
\subsection{Christoffel Symbols}
The Levi–Civita connection is defined by:
\[
\Gamma^\lambda_{\mu\nu}
= \frac{1}{2} g^{\lambda\sigma}
\left(
\partial_\mu g_{\sigma\nu}
+ \partial_\nu g_{\sigma\mu}
- \partial_\sigma g_{\mu\nu}
\right).
\]

\subsection{Riemann Curvature Tensor}
\[
R^\rho_{\ \sigma\mu\nu}
= \partial_\mu \Gamma^\rho_{\sigma\nu}
- \partial_\nu \Gamma^\rho_{\sigma\mu}
+ \Gamma^\rho_{\lambda\mu}\Gamma^\lambda_{\sigma\nu}
- \Gamma^\rho_{\lambda\nu}\Gamma^\lambda_{\sigma\mu}.
\]

