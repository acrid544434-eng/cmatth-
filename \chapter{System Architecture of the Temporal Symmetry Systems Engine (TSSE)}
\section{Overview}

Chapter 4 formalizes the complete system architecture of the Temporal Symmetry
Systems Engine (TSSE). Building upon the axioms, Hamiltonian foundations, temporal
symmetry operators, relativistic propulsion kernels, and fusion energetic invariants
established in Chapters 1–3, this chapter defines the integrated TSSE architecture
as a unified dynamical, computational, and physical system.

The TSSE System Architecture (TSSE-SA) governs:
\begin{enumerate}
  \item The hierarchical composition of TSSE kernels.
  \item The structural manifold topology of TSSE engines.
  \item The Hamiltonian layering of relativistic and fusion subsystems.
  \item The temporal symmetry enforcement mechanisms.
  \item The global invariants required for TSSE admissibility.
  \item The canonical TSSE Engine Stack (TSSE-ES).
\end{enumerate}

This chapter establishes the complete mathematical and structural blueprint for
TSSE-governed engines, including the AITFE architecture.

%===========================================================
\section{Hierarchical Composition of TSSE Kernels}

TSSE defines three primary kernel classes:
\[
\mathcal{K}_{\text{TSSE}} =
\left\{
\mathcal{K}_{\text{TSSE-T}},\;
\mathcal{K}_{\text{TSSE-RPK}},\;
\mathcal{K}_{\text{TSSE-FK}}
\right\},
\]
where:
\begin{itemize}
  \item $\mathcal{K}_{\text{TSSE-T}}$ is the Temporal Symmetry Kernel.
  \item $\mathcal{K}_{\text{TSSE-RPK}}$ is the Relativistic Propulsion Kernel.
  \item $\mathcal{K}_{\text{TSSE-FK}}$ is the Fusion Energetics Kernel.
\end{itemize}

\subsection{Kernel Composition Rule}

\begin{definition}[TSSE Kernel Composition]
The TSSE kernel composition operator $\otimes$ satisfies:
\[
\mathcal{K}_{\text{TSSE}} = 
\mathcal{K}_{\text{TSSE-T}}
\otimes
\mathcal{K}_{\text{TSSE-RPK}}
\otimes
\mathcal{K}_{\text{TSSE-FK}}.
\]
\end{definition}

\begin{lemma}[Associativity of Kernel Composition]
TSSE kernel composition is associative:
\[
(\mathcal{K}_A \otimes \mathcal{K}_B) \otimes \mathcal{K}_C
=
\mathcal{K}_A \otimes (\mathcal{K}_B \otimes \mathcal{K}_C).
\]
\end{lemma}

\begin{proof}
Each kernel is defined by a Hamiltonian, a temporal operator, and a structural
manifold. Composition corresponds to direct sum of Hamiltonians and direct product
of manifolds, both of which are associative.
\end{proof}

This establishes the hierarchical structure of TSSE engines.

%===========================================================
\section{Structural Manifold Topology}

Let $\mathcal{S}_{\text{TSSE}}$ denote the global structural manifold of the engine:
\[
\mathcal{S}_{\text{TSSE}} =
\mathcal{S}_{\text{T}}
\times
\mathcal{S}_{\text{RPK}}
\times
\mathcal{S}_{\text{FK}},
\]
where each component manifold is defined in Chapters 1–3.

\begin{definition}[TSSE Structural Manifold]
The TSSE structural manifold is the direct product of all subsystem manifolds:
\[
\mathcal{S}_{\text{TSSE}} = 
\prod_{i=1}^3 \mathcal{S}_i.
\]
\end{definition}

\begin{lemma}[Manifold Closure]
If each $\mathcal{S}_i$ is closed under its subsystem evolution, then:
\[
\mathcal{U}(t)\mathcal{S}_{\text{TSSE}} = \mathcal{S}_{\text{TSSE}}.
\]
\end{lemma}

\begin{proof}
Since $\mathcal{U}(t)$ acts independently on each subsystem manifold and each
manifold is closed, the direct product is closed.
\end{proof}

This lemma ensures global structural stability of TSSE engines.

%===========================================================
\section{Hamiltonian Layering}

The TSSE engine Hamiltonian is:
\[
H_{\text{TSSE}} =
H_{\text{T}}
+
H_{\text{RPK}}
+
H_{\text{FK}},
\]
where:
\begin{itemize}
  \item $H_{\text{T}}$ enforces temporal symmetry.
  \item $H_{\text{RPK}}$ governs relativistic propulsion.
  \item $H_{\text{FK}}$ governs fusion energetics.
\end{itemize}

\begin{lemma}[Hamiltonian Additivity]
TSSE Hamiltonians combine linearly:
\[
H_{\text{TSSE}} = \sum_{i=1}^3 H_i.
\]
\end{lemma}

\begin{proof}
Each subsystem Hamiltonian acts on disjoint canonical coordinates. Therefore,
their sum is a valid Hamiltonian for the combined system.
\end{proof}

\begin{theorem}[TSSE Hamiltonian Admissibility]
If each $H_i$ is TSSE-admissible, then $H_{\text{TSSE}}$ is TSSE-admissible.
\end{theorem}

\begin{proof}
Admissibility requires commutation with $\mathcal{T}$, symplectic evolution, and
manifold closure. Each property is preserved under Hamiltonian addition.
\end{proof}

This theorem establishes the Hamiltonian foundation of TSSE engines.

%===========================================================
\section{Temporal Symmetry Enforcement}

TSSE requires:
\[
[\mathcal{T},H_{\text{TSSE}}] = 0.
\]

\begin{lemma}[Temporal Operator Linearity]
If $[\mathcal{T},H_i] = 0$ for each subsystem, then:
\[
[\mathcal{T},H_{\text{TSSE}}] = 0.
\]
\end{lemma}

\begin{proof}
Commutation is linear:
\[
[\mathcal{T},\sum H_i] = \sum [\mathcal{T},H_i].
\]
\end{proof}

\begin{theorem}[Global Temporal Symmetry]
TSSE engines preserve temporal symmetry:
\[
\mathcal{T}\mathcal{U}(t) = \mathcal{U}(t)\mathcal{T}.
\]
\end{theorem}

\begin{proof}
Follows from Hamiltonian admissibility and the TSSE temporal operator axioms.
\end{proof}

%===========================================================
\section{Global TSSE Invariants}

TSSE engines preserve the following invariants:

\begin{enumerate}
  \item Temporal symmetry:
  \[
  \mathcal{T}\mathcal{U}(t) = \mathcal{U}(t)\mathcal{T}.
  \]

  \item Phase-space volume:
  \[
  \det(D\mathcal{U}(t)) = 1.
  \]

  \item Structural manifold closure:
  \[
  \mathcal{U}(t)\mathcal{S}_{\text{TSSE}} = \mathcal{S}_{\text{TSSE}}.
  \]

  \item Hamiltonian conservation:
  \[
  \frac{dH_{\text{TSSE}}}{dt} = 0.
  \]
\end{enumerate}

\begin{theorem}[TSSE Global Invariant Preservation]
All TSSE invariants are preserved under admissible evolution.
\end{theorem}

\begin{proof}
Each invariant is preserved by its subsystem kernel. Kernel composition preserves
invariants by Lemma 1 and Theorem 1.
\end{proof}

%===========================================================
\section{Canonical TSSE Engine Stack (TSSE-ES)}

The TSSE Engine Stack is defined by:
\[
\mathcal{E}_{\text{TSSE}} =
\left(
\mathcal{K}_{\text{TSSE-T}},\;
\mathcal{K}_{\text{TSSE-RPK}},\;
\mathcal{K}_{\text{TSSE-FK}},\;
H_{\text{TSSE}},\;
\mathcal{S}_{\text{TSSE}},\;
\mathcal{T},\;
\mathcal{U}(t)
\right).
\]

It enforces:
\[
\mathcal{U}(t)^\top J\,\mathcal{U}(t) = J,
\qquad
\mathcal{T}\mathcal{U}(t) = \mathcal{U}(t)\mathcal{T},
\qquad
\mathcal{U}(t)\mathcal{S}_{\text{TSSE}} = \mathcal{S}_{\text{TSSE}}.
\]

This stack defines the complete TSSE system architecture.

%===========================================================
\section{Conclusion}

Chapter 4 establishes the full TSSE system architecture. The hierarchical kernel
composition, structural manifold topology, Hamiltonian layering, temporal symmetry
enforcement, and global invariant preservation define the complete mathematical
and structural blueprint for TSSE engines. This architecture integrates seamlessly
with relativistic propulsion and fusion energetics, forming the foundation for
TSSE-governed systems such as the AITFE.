\section{Temporal Symmetry Enforcement}

TSSE requires:
\[
[\mathcal{T},H_{\text{TSSE}}] = 0.
\]

\begin{lemma}[Temporal Operator Linearity]
If $[\mathcal{T},H_i] = 0$ for each subsystem, then:
\[
[\mathcal{T},H_{\text{TSSE}}] = 0.
\]
\end{lemma}

\begin{proof}
Commutation is linear:
\[
[\mathcal{T},\sum H_i] = \sum [\mathcal{T},H_i].
\]
\end{proof}

\begin{theorem}[Global Temporal Symmetry]
TSSE engines preserve temporal symmetry:
\[
\mathcal{T}\mathcal{U}(t) = \mathcal{U}(t)\mathcal{T}.
\]
\end{theorem}

\begin{proof}
Follows from Hamiltonian admissibility and the TSSE temporal operator axioms.
\end{proof}

