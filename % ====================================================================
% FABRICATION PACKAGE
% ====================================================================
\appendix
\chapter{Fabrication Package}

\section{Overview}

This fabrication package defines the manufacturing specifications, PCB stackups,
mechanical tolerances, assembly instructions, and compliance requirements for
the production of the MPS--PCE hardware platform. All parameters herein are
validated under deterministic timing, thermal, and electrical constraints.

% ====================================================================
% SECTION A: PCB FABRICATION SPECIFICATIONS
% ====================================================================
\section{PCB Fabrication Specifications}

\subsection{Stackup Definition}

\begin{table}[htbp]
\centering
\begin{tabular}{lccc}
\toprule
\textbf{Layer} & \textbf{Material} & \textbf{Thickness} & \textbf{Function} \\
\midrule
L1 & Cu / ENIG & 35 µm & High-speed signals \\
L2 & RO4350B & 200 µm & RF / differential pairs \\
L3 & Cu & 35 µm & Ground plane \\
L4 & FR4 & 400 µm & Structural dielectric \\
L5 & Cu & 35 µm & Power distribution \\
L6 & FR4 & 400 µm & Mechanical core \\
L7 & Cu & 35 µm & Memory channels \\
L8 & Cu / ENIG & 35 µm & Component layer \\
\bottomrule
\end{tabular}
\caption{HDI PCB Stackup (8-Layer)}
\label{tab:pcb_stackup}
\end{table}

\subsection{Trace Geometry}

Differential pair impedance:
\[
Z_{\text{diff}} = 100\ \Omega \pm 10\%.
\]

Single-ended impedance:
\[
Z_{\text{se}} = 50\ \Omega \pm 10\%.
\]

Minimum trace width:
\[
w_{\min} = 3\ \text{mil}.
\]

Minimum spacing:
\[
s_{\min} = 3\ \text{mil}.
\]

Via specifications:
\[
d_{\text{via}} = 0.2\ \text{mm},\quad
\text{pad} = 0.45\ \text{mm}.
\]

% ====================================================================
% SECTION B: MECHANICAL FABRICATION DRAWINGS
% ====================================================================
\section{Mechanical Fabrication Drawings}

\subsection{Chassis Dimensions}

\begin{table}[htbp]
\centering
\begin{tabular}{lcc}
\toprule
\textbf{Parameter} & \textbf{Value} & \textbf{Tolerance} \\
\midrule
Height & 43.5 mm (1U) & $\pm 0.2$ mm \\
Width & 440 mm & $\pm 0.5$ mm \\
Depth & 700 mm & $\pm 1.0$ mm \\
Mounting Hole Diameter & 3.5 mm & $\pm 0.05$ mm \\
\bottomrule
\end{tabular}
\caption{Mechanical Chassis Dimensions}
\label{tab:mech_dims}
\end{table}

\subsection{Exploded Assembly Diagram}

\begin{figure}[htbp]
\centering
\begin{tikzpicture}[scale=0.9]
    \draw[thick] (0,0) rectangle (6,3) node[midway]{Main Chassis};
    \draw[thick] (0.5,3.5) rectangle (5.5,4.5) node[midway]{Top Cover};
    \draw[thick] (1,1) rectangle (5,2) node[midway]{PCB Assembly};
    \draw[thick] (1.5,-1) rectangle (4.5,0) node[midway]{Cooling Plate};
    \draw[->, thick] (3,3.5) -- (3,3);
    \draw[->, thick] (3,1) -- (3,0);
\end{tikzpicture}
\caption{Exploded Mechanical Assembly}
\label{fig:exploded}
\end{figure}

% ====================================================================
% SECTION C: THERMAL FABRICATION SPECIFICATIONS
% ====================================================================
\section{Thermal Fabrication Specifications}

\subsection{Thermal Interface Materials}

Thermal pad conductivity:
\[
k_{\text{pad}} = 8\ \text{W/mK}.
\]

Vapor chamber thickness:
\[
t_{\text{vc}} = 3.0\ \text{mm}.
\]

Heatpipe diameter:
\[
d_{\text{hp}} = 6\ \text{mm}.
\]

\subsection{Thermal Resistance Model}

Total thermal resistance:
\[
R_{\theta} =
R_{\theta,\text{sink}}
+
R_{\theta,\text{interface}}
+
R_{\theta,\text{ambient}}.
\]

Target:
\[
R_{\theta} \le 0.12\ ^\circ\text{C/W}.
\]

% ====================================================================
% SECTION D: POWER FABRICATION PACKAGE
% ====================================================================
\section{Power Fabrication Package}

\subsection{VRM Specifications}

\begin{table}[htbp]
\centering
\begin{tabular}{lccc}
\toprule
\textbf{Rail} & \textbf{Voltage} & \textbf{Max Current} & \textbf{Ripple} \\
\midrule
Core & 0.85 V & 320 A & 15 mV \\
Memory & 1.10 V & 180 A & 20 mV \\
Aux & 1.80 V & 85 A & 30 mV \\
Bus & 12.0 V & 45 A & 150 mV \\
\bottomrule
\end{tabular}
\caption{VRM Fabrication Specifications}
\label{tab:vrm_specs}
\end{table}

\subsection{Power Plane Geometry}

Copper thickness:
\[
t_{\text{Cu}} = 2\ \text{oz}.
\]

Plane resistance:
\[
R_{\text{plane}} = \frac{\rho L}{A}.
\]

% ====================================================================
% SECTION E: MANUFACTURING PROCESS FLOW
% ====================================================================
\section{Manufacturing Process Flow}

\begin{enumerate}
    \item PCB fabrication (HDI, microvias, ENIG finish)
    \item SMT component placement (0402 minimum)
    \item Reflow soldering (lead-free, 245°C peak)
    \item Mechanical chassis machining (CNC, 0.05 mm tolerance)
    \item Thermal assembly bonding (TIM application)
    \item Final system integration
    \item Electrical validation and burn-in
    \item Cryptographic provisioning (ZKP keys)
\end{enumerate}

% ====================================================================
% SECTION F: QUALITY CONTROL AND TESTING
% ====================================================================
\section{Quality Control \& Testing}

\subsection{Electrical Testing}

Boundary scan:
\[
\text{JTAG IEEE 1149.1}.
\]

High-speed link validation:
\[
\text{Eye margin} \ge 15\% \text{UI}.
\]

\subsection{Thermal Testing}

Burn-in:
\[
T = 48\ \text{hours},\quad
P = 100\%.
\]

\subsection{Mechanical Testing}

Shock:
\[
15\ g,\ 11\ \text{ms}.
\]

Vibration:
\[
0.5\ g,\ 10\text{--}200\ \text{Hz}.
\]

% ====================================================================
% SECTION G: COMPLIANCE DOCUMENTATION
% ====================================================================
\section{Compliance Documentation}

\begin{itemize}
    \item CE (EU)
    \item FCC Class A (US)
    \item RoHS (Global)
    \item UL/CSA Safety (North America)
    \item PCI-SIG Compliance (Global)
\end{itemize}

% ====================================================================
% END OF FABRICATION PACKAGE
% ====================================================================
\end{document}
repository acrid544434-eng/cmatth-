\section{Thermal Fabrication Specifications}

\subsection{Thermal Interface Materials}

Thermal pad conductivity:
\[
k_{\text{pad}} = 8\ \text{W/mK}.
\]

Vapor chamber thickness:
\[
t_{\text{vc}} = 3.0\ \text{mm}.
\]

Heatpipe diameter:
\[
d_{\text{hp}} = 6\ \text{mm}.
\]

\subsection{Thermal Resistance Model}

Total thermal resistance:
\[
R_{\theta} =
R_{\theta,\text{sink}}
+
R_{\theta,\text{interface}}
+
R_{\theta,\text{ambient}}.
\]

Target:
\[
R_{\theta} \le 0.12\ ^\circ\text{C/W}.
\]

