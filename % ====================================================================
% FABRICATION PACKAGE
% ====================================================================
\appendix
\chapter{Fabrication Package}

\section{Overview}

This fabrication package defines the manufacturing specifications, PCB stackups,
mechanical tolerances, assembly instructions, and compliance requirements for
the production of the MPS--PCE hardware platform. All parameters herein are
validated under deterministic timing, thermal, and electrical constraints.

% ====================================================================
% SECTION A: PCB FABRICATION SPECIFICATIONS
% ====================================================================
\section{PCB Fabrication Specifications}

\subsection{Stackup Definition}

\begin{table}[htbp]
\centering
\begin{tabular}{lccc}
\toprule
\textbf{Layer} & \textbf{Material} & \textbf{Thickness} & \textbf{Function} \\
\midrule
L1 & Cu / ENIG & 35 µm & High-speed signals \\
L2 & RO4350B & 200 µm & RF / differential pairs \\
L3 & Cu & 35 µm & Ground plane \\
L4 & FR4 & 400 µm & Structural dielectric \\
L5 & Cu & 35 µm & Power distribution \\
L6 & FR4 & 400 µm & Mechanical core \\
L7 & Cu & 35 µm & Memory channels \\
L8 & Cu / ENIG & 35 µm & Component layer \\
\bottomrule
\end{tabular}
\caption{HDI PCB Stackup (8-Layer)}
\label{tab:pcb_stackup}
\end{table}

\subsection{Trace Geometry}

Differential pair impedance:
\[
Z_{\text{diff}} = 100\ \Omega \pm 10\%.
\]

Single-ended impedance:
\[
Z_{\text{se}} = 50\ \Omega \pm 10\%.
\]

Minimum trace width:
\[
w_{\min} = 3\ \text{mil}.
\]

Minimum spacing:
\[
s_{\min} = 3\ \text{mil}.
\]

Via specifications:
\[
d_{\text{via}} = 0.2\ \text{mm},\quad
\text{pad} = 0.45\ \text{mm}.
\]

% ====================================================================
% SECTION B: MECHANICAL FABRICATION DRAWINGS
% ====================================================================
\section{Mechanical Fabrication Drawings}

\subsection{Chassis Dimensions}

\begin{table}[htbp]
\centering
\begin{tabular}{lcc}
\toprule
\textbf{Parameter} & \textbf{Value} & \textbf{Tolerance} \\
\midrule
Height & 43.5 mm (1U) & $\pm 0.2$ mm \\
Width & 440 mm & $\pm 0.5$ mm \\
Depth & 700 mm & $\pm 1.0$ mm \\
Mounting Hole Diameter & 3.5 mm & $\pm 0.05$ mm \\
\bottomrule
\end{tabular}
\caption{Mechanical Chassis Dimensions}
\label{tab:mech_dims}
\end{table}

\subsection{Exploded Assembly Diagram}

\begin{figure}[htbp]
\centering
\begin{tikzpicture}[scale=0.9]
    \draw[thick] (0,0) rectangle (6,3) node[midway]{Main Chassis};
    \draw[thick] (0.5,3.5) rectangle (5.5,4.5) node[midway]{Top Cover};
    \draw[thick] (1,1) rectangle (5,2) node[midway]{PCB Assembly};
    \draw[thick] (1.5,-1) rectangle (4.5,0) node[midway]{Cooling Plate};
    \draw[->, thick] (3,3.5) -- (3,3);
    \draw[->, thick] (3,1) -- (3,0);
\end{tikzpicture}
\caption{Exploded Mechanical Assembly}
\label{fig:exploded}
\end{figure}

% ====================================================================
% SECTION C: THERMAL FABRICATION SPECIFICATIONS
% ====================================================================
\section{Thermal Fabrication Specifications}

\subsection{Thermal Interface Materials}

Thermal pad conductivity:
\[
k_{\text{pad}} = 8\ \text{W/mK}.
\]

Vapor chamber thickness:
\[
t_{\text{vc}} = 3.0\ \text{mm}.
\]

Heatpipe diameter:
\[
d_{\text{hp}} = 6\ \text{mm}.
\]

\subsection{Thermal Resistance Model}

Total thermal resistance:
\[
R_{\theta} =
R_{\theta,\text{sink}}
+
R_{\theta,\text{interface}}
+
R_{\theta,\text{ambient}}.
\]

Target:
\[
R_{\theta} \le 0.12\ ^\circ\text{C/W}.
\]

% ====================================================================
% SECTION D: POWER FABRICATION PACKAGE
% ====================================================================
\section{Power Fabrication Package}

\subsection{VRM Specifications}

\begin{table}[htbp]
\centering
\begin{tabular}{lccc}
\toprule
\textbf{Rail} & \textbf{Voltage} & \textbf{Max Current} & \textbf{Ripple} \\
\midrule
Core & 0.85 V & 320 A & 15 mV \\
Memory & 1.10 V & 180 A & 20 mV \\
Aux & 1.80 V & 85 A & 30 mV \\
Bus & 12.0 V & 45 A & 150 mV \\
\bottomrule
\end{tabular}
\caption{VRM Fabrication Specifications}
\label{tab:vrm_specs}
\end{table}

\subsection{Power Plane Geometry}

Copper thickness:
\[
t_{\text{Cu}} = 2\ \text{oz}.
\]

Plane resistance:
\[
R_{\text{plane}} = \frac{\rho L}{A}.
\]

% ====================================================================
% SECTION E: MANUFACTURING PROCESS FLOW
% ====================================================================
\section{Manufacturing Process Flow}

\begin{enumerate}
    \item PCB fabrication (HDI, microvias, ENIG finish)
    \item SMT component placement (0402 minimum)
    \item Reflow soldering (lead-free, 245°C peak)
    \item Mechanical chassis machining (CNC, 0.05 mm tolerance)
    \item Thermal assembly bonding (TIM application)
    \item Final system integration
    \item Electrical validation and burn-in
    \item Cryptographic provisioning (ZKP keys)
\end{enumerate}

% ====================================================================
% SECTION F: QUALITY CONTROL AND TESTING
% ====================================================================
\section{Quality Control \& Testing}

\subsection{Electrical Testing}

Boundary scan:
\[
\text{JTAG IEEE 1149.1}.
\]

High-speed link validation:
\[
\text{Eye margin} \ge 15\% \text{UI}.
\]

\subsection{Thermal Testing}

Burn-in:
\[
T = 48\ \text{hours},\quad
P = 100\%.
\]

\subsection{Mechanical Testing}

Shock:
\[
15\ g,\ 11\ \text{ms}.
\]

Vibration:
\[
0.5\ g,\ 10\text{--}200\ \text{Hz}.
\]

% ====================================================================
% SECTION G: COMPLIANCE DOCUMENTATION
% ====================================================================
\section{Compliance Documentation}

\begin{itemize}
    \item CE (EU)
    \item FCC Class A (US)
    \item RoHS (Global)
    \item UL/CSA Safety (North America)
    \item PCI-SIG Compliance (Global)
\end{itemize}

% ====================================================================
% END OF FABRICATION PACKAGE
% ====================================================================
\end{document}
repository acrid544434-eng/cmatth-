\section{Quality Control \& Testing}

\subsection{Electrical Testing}

Boundary scan:
\[
\text{JTAG IEEE 1149.1}.
\]

High-speed link validation:
\[
\text{Eye margin} \ge 15\% \text{UI}.
\]

\subsection{Thermal Testing}

Burn-in:
\[
T = 48\ \text{hours},\quad
P = 100\%.
\]

\subsection{Mechanical Testing}

Shock:
\[
15\ g,\ 11\ \text{ms}.
\]

Vibration:
\[
0.5\ g,\ 10\text{--}200\ \text{Hz}.
\]

