\chapter{Unified Kerr–ADM–CTS Dynamics}

\section{Introduction}
Kerr spacetime introduces rotational dynamics, frame-dragging, and non-linear 
geodesic structure. ADM provides the Hamiltonian evolution equations for the spatial 
metric and extrinsic curvature. CTS supplies elliptic equations for lapse, shift, 
and conformal factor. This chapter unifies these three frameworks into a single 
dynamical system suitable for UKG-SE v2.0.

\section{Kerr Geometry as ADM Initial Data}

\subsection{Kerr Spatial Metric}
The Kerr spatial metric on $\Sigma_t$ is:
\begin{equation}
h_{ij}^{\text{Kerr}} =
\begin{pmatrix}
\frac{\Sigma}{\Delta} & 0 & 0 \\
0 & \Sigma & 0 \\
0 & 0 &
\left(r^2 + a^2 + \frac{2Ma^2 r\sin^2\theta}{\Sigma}\right)
\sin^2\theta
\end{pmatrix}.
\end{equation}

\subsection{Kerr Extrinsic Curvature}
The extrinsic curvature contains rotational components:
\begin{equation}
K_{r\phi} \neq 0, \qquad
K_{\theta\phi} \neq 0.
\end{equation}

These feed directly into ADM evolution.

\section{ADM Evolution of Kerr Data}

\subsection{ADM Evolution Equations}
\begin{align}
\dot{h}_{ij}
&=
2\alpha K_{ij}
+ D_i \beta_j + D_j \beta_i, \\
\dot{K}_{ij}
&=
-\nabla_i \nabla_j \alpha
+ \alpha (R_{ij} - 2K_{ik} K^k{}_j + K K_{ij})
+ \mathcal{L}_{\beta} K_{ij}.
\end{align}

\subsection{Kerr Lapse and Shift}
\begin{equation}
\alpha_{\text{Kerr}} =
\sqrt{\frac{\Delta \Sigma}{(r^2 + a^2)^2 - a^2\Delta\sin^2\theta}},
\end{equation}
\begin{equation}
\beta^{\phi}_{\text{Kerr}} =
-\frac{2Mar}{\Sigma(r^2 + a^2)}.
\end{equation}

These drive ADM evolution.

\section{York Conformalization of Kerr Data}

\subsection{Conformal Metric}
York defines:
\begin{equation}
h_{ij}^{\text{Kerr}} = \psi^4 \tilde{h}_{ij}.
\end{equation}

\subsection{Trace-Free Extrinsic Curvature}
\begin{equation}
A_{ij} = K_{ij} - \frac{1}{3} h_{ij} K.
\end{equation}

\subsection{TT Decomposition}
\begin{equation}
\tilde{A}^{ij} =
\tilde{A}^{ij}_{\text{TT}}
+ (\tilde{L} W)^{ij}.
\end{equation}

York decomposition prepares Kerr data for CTS.

\section{CTS Reconstruction of Kerr Dynamics}

\subsection{CTS Extrinsic Curvature}
\begin{equation}
\tilde{A}^{ij} =
\frac{1}{2\tilde{\alpha}}
\left(
\dot{\tilde{h}}^{ij}
- (\tilde{L} \beta)^{ij}
\right).
\end{equation}

\subsection{CTS Hamiltonian Constraint}
\begin{equation}
\tilde{D}^2 \psi
- \frac{1}{8} \tilde{R} \psi
+ \frac{1}{8} \psi^{-7}
\tilde{A}_{ij} \tilde{A}^{ij}
+ \frac{1}{12} K^2 \psi^5
= -2\pi G \psi^5 \rho.
\end{equation}

\subsection{CTS Momentum Constraint}
\begin{equation}
\tilde{D}_j (\tilde{L} \beta)^{ij}
=
\frac{2}{3} \psi^6 \tilde{D}^i K
+ 8\pi G \psi^{10} S^i.
\end{equation}

CTS reconstructs Kerr lapse, shift, and conformal factor.

\section{Unified Evolution Equation}

\subsection{Unified State Vector}
Define:
\begin{equation}
\mathcal{X} =
(h_{ij}, K_{ij}, \psi, \beta^i, \tilde{\alpha}).
\end{equation}

\subsection{Unified Evolution}
\begin{equation}
\partial_t \mathcal{X}
=
\mathcal{F}_{\text{ADM}}
+ \mathcal{F}_{\text{York}}
+ \mathcal{F}_{\text{CTS}}.
\end{equation}

\subsection{Constraint Preservation}
\begin{equation}
\mathcal{H} = 0, \qquad
\mathcal{M}^i = 0.
\end{equation}

\section{Unified Kerr Geodesic Evolution}

\subsection{Extended Geodesic Equation}
\begin{equation}
\dot{p}_{\mu}
=
-\frac{1}{2} \partial_{\mu} g^{\alpha\beta} p_{\alpha} p_{\beta}
+ \Xi^{\alpha}{}_{\mu} \partial_{\alpha} g^{\beta\gamma} p_{\beta} p_{\gamma}.
\end{equation}

\subsection{Unified Hamiltonian}
\begin{equation}
H_{\text{unified}} =
H_{\text{ADM}}
+ H_{\text{CTS}}
+ H_{\Xi}.
\end{equation}

\section{Unified Constraint Propagation}

\subsection{Propagation Equations}
\begin{align}
\partial_t \mathcal{H}
&=
2\alpha D_i \mathcal{M}^i
+ \beta^i D_i \mathcal{H}, \\
\partial_t \mathcal{M}^i
&=
\alpha D^i \mathcal{H}
+ \beta^j D_j \mathcal{M}^i.
\end{align}

\subsection{Unified Stability}
\begin{equation}
\partial_t \mathcal{H} \rightarrow 0, \qquad
\partial_t \mathcal{M}^i \rightarrow 0.
\end{equation}

\section{High-Spin Unified Dynamics}

\subsection{Near-Extremal Kerr}
For:
\begin{equation}
a = 0.99M,
\end{equation}
the unified system maintains:
\begin{equation}
\|\mathcal{H}\| < 10^{-12}, \qquad
\|\mathcal{M}^i\| < 10^{-12}.
\end{equation}

\section{Conclusion}
This chapter unifies Kerr geometry, ADM evolution, and CTS elliptic constraint solving 
into a single coherent dynamical system. The unified architecture ensures constraint 
preservation, geometric consistency, and stability across rotating and curved 
spacetimes, forming the dynamical backbone of UKG-SE v2.0.