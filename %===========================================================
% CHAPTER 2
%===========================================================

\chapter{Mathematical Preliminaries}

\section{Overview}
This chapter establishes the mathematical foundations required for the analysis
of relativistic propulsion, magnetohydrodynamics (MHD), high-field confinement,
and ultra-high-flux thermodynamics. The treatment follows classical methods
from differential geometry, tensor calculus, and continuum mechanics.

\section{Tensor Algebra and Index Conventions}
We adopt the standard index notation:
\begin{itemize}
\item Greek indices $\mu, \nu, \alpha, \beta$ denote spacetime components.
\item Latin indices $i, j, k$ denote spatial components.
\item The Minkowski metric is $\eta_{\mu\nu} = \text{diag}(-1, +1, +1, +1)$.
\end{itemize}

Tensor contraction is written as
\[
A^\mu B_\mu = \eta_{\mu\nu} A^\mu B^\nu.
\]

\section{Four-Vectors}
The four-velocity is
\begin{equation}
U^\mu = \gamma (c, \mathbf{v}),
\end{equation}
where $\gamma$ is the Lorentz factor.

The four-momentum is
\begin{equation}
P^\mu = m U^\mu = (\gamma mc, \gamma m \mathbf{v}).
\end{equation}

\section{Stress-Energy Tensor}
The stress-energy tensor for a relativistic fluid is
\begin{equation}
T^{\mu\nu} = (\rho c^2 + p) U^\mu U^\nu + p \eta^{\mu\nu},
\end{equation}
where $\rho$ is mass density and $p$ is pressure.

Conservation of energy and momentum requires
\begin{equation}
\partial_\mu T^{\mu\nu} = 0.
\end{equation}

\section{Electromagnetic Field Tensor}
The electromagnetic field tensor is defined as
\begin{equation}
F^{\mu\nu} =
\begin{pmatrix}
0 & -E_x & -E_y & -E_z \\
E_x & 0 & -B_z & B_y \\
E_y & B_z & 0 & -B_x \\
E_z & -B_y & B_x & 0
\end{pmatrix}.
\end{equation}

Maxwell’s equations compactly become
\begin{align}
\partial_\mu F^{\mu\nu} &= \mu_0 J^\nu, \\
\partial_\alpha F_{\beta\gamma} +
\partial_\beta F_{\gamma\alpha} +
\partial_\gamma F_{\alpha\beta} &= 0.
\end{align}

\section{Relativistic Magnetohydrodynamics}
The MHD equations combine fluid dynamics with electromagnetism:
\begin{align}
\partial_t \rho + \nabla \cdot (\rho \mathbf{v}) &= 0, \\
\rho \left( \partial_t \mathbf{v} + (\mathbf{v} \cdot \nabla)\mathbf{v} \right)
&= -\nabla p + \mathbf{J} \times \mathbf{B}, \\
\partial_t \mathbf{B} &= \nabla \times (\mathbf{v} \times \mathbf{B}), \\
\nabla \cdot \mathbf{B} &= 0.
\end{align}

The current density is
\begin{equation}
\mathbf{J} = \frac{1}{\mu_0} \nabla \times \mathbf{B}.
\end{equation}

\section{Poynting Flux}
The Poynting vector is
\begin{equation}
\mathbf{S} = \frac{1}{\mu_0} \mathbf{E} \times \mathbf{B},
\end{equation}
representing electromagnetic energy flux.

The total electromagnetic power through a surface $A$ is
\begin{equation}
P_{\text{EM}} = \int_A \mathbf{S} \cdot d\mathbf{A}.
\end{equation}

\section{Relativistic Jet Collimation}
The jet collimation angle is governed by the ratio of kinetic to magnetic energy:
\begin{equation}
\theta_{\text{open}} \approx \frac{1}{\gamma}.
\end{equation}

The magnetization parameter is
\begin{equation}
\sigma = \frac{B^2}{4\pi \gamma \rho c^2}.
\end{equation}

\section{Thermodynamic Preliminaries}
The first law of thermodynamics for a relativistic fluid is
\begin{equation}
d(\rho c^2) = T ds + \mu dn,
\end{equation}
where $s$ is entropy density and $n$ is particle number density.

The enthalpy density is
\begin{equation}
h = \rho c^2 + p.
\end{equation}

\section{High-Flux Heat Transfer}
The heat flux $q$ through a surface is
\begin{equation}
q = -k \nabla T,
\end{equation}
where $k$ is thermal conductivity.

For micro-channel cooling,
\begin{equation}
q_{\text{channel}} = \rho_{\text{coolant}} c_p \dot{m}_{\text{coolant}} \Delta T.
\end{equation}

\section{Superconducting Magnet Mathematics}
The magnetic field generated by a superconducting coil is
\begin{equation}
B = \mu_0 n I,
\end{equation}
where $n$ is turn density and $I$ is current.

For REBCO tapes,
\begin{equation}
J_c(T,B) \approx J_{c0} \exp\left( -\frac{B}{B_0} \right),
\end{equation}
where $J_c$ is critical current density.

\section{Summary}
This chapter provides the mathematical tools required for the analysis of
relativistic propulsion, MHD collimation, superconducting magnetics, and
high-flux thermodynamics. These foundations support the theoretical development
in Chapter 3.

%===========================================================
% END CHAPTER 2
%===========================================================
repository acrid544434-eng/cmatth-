\chapter{Mathematical Preliminaries}

\section{Overview}
This chapter establishes the mathematical foundations required for the analysis
of relativistic propulsion, magnetohydrodynamics (MHD), high-field confinement,
and ultra-high-flux thermodynamics. The treatment follows classical methods
from differential geometry, tensor calculus, and continuum mechanics.

\section{Tensor Algebra and Index Conventions}
We adopt the standard index notation:
\begin{itemize}
\item Greek indices $\mu, \nu, \alpha, \beta$ denote spacetime components.
\item Latin indices $i, j, k$ denote spatial components.
\item The Minkowski metric is $\eta_{\mu\nu} = \text{diag}(-1, +1, +1, +1)$.
\end{itemize}

Tensor contraction is written as
\[
A^\mu B_\mu = \eta_{\mu\nu} A^\mu B^\nu.
\]

\section{Four-Vectors}
The four-velocity is
\begin{equation}
U^\mu = \gamma (c, \mathbf{v}),
\end{equation}
where $\gamma$ is the Lorentz factor.

The four-momentum is
\begin{equation}
P^\mu = m U^\mu = (\gamma mc, \gamma m \mathbf{v}).
\end{equation}

\section{Stress-Energy Tensor}
The stress-energy tensor for a relativistic fluid is
\begin{equation}
T^{\mu\nu} = (\rho c^2 + p) U^\mu U^\nu + p \eta^{\mu\nu},
\end{equation}
where $\rho$ is mass density and $p$ is pressure.

Conservation of energy and momentum requires
\begin{equation}
\partial_\mu T^{\mu\nu} = 0.
\end{equation}

\section{Electromagnetic Field Tensor}
The electromagnetic field tensor is defined as
\begin{equation}
F^{\mu\nu} =
\begin{pmatrix}
0 & -E_x & -E_y & -E_z \\
E_x & 0 & -B_z & B_y \\
E_y & B_z & 0 & -B_x \\
E_z & -B_y & B_x & 0
\end{pmatrix}.
\end{equation}

Maxwell’s equations compactly become
\begin{align}
\partial_\mu F^{\mu\nu} &= \mu_0 J^\nu, \\
\partial_\alpha F_{\beta\gamma} +
\partial_\beta F_{\gamma\alpha} +
\partial_\gamma F_{\alpha\beta} &= 0.
\end{align}

\section{Relativistic Magnetohydrodynamics}
The MHD equations combine fluid dynamics with electromagnetism:
\begin{align}
\partial_t \rho + \nabla \cdot (\rho \mathbf{v}) &= 0, \\
\rho \left( \partial_t \mathbf{v} + (\mathbf{v} \cdot \nabla)\mathbf{v} \right)
&= -\nabla p + \mathbf{J} \times \mathbf{B}, \\
\partial_t \mathbf{B} &= \nabla \times (\mathbf{v} \times \mathbf{B}), \\
\nabla \cdot \mathbf{B} &= 0.
\end{align}

The current density is
\begin{equation}
\mathbf{J} = \frac{1}{\mu_0} \nabla \times \mathbf{B}.
\end{equation}

\section{Poynting Flux}
The Poynting vector is
\begin{equation}
\mathbf{S} = \frac{1}{\mu_0} \mathbf{E} \times \mathbf{B},
\end{equation}
representing electromagnetic energy flux.

The total electromagnetic power through a surface $A$ is
\begin{equation}
P_{\text{EM}} = \int_A \mathbf{S} \cdot d\mathbf{A}.
\end{equation}

\section{Relativistic Jet Collimation}
The jet collimation angle is governed by the ratio of kinetic to magnetic energy:
\begin{equation}
\theta_{\text{open}} \approx \frac{1}{\gamma}.
\end{equation}

The magnetization parameter is
\begin{equation}
\sigma = \frac{B^2}{4\pi \gamma \rho c^2}.
\end{equation}

\section{Thermodynamic Preliminaries}
The first law of thermodynamics for a relativistic fluid is
\begin{equation}
d(\rho c^2) = T ds + \mu dn,
\end{equation}
where $s$ is entropy density and $n$ is particle number density.

The enthalpy density is
\begin{equation}
h = \rho c^2 + p.
\end{equation}

\section{High-Flux Heat Transfer}
The heat flux $q$ through a surface is
\begin{equation}
q = -k \nabla T,
\end{equation}
where $k$ is thermal conductivity.

For micro-channel cooling,
\begin{equation}
q_{\text{channel}} = \rho_{\text{coolant}} c_p \dot{m}_{\text{coolant}} \Delta T.
\end{equation}

\section{Superconducting Magnet Mathematics}
The magnetic field generated by a superconducting coil is
\begin{equation}
B = \mu_0 n I,
\end{equation}
where $n$ is turn density and $I$ is current.

For REBCO tapes,
\begin{equation}
J_c(T,B) \approx J_{c0} \exp\left( -\frac{B}{B_0} \right),
\end{equation}
where $J_c$ is critical current density.

\section{Summary}
This chapter provides the mathematical tools required for the analysis of
relativistic propulsion, MHD collimation, superconducting magnetics, and
high-flux thermodynamics. These foundations support the theoretical development
in Chapter 3.

