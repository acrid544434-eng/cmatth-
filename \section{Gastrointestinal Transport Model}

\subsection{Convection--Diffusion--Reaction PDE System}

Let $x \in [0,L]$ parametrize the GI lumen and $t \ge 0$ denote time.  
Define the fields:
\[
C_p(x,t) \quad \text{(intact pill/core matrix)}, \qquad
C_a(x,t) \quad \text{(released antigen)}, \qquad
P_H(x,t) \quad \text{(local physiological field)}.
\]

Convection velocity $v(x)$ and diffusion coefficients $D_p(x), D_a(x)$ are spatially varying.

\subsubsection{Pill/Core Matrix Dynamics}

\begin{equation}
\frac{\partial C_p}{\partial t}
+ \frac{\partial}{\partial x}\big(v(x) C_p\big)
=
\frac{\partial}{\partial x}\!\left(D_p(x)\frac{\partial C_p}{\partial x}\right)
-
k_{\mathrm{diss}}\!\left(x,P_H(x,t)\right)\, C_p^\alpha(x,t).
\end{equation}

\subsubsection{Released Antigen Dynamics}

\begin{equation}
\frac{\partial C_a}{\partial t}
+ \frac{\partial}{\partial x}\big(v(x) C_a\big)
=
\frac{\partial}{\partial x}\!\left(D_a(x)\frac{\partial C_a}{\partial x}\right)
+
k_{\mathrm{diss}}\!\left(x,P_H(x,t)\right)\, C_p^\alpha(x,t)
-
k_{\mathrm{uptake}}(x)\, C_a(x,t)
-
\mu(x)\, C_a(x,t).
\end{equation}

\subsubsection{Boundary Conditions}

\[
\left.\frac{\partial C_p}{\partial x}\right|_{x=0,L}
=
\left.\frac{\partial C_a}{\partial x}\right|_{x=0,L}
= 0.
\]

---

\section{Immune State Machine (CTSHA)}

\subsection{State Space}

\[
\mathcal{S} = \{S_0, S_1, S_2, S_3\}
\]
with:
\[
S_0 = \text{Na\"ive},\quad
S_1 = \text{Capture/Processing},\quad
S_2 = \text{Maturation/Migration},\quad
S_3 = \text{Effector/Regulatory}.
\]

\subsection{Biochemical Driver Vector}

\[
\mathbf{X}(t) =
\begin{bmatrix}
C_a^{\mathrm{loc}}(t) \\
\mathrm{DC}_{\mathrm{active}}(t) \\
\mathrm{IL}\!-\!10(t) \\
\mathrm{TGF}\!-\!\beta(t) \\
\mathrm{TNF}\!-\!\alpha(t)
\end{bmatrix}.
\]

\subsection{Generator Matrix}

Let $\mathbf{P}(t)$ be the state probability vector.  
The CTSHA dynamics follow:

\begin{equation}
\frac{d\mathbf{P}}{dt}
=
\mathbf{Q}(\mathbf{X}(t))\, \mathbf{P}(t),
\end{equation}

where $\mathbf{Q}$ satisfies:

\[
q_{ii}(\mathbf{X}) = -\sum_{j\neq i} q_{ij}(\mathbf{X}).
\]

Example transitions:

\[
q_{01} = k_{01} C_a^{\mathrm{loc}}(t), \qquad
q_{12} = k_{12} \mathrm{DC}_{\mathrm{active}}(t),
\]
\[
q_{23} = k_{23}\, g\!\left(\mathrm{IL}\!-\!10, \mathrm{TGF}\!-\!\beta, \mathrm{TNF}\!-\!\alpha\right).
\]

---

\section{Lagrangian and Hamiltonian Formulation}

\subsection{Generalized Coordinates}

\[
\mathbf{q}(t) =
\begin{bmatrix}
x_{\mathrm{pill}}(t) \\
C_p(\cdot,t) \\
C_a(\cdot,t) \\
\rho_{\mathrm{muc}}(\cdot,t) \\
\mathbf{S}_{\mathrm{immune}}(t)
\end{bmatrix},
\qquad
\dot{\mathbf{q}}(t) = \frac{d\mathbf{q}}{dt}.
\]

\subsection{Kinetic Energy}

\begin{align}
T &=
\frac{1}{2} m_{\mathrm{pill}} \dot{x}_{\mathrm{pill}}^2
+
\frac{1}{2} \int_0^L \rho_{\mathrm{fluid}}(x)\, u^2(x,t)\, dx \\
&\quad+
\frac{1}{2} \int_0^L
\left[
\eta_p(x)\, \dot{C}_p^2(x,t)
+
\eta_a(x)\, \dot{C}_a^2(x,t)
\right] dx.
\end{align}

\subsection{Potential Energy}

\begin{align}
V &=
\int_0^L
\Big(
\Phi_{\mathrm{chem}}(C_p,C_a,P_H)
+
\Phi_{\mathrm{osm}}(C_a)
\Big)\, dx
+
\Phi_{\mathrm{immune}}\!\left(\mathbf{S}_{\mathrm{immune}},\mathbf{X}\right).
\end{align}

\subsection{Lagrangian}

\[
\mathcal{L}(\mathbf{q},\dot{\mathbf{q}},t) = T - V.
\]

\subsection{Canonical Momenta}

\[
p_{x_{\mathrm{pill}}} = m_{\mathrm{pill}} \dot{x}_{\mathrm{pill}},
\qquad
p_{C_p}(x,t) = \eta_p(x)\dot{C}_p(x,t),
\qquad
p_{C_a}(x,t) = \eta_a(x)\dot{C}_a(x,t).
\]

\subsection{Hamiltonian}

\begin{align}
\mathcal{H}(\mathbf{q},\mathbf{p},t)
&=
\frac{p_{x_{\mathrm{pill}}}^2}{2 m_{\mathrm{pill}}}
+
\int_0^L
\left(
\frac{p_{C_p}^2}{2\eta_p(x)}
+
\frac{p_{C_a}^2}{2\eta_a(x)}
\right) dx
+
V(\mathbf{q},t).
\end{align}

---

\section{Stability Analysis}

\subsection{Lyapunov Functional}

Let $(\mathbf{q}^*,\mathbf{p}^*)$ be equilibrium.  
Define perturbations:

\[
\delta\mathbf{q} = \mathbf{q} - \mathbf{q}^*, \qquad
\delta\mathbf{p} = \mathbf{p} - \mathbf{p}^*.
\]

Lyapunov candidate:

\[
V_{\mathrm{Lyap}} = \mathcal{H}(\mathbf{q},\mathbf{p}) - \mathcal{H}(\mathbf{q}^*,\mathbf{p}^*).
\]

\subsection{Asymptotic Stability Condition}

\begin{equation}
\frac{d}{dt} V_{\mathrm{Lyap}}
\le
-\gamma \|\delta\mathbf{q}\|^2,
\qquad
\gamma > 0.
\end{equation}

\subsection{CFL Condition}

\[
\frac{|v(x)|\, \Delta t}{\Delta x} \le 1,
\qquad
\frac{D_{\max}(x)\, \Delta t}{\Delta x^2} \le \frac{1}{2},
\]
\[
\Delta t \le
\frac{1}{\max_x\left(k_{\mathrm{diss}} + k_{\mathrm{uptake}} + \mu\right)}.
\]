\section{Gastrointestinal Transport Model}

\subsection{Convection--Diffusion--Reaction PDE System}

Let $x \in [0,L]$ parametrize the GI lumen and $t \ge 0$ denote time.  
Define the fields:
\[
C_p(x,t) \quad \text{(intact pill/core matrix)}, \qquad
C_a(x,t) \quad \text{(released antigen)}, \qquad
P_H(x,t) \quad \text{(local physiological field)}.
\]

Convection velocity $v(x)$ and diffusion coefficients $D_p(x), D_a(x)$ are spatially varying.

\subsubsection{Pill/Core Matrix Dynamics}

\begin{equation}
\frac{\partial C_p}{\partial t}
+ \frac{\partial}{\partial x}\big(v(x) C_p\big)
=
\frac{\partial}{\partial x}\!\left(D_p(x)\frac{\partial C_p}{\partial x}\right)
-
k_{\mathrm{diss}}\!\left(x,P_H(x,t)\right)\, C_p^\alpha(x,t).
\end{equation}

\subsubsection{Released Antigen Dynamics}

\begin{equation}
\frac{\partial C_a}{\partial t}
+ \frac{\partial}{\partial x}\big(v(x) C_a\big)
=
\frac{\partial}{\partial x}\!\left(D_a(x)\frac{\partial C_a}{\partial x}\right)
+
k_{\mathrm{diss}}\!\left(x,P_H(x,t)\right)\, C_p^\alpha(x,t)
-
k_{\mathrm{uptake}}(x)\, C_a(x,t)
-
\mu(x)\, C_a(x,t).
\end{equation}

\subsubsection{Boundary Conditions}

\[
\left.\frac{\partial C_p}{\partial x}\right|_{x=0,L}
=
\left.\frac{\partial C_a}{\partial x}\right|_{x=0,L}
= 0.
\]

