\section{Stability Analysis}

\subsection{Lyapunov Functional}

Let $(\mathbf{q}^*,\mathbf{p}^*)$ be equilibrium.  
Define perturbations:

\[
\delta\mathbf{q} = \mathbf{q} - \mathbf{q}^*, \qquad
\delta\mathbf{p} = \mathbf{p} - \mathbf{p}^*.
\]

Lyapunov candidate:

\[
V_{\mathrm{Lyap}} = \mathcal{H}(\mathbf{q},\mathbf{p}) - \mathcal{H}(\mathbf{q}^*,\mathbf{p}^*).
\]

\subsection{Asymptotic Stability Condition}

\begin{equation}
\frac{d}{dt} V_{\mathrm{Lyap}}
\le
-\gamma \|\delta\mathbf{q}\|^2,
\qquad
\gamma > 0.
\end{equation}

\subsection{CFL Condition}

\[
\frac{|v(x)|\, \Delta t}{\Delta x} \le 1,
\qquad
\frac{D_{\max}(x)\, \Delta t}{\Delta x^2} \le \frac{1}{2},
\]
\[
\Delta t \le
\frac{1}{\max_x\left(k_{\mathrm{diss}} + k_{\mathrm{uptake}} + \mu\right)}.
\]