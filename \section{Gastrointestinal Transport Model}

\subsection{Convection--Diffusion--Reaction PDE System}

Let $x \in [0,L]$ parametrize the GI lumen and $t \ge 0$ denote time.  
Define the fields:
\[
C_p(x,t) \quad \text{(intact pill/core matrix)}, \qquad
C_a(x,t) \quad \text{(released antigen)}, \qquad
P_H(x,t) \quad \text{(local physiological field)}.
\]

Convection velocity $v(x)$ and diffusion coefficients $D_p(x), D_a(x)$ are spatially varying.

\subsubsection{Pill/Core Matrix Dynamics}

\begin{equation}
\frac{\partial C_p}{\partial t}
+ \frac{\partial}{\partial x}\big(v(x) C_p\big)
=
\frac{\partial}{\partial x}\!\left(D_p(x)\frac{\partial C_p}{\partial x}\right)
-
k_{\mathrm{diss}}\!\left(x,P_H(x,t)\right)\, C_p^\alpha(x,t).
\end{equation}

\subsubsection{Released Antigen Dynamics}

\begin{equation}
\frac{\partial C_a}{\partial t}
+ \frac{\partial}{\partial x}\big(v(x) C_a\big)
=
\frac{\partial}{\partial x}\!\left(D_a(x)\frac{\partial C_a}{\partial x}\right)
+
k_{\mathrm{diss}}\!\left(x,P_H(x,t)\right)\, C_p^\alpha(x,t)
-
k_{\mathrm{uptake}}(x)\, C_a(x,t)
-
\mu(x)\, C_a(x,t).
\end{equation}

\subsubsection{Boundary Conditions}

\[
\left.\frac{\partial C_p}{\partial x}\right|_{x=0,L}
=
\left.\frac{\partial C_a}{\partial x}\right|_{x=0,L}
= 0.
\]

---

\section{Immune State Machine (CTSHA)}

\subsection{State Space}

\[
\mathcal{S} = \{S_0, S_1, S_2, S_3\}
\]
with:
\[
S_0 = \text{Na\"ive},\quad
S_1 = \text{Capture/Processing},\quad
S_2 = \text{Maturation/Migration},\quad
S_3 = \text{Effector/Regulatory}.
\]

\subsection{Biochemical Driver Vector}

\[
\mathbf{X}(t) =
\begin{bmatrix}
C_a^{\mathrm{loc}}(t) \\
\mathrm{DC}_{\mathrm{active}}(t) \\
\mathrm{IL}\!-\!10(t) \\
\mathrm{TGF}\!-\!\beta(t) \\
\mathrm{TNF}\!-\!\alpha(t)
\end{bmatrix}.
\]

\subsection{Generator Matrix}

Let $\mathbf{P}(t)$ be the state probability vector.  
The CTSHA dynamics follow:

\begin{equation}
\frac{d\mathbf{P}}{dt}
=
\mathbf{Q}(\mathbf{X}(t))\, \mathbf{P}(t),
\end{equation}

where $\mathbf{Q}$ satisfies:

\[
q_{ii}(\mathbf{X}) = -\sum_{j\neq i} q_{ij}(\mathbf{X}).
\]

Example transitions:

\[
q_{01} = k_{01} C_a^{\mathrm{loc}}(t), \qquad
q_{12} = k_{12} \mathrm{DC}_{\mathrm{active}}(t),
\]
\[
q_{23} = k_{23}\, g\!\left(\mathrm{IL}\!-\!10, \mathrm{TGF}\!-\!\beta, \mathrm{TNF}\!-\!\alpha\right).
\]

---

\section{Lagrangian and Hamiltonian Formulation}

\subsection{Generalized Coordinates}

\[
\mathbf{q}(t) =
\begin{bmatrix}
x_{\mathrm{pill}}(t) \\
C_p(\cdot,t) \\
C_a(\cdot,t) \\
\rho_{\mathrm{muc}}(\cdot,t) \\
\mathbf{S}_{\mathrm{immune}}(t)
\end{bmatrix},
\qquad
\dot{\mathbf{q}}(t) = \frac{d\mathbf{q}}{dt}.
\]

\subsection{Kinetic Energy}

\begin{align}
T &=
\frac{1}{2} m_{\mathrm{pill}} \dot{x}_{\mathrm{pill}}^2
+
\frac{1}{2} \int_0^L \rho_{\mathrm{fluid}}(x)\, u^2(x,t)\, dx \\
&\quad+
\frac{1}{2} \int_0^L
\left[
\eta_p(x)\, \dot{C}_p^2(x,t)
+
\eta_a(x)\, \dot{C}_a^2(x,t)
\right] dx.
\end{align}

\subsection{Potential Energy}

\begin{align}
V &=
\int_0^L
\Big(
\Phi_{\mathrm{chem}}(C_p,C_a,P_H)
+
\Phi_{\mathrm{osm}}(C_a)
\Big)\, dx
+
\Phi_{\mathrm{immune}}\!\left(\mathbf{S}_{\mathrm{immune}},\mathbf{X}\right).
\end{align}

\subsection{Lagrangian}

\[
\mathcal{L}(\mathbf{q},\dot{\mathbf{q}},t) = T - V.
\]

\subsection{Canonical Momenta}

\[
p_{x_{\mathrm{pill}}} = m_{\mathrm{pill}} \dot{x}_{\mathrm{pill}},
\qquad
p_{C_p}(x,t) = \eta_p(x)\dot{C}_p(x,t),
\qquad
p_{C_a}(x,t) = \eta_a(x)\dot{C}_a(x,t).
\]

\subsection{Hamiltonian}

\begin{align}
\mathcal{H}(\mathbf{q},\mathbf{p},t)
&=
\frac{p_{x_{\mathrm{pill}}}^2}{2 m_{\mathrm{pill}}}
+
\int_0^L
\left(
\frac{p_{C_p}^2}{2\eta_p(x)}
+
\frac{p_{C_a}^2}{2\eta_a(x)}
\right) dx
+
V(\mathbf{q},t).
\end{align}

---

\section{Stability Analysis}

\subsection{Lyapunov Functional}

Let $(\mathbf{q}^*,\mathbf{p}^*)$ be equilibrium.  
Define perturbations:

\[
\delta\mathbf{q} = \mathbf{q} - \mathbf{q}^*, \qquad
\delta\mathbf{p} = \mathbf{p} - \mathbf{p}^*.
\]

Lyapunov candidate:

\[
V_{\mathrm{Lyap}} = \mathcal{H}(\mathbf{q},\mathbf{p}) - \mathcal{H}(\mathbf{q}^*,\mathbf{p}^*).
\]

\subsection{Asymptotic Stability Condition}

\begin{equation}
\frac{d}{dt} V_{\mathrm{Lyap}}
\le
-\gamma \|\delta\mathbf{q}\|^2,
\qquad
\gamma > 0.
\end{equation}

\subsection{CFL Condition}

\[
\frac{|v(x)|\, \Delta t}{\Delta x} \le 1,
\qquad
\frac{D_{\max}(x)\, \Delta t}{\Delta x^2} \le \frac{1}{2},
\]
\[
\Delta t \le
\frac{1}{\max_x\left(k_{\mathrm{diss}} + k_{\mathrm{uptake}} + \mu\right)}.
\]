\section{Lagrangian and Hamiltonian Formulation}

\subsection{Generalized Coordinates}

\[
\mathbf{q}(t) =
\begin{bmatrix}
x_{\mathrm{pill}}(t) \\
C_p(\cdot,t) \\
C_a(\cdot,t) \\
\rho_{\mathrm{muc}}(\cdot,t) \\
\mathbf{S}_{\mathrm{immune}}(t)
\end{bmatrix},
\qquad
\dot{\mathbf{q}}(t) = \frac{d\mathbf{q}}{dt}.
\]

\subsection{Kinetic Energy}

\begin{align}
T &=
\frac{1}{2} m_{\mathrm{pill}} \dot{x}_{\mathrm{pill}}^2
+
\frac{1}{2} \int_0^L \rho_{\mathrm{fluid}}(x)\, u^2(x,t)\, dx \\
&\quad+
\frac{1}{2} \int_0^L
\left[
\eta_p(x)\, \dot{C}_p^2(x,t)
+
\eta_a(x)\, \dot{C}_a^2(x,t)
\right] dx.
\end{align}

\subsection{Potential Energy}

\begin{align}
V &=
\int_0^L
\Big(
\Phi_{\mathrm{chem}}(C_p,C_a,P_H)
+
\Phi_{\mathrm{osm}}(C_a)
\Big)\, dx
+
\Phi_{\mathrm{immune}}\!\left(\mathbf{S}_{\mathrm{immune}},\mathbf{X}\right).
\end{align}

\subsection{Lagrangian}

\[
\mathcal{L}(\mathbf{q},\dot{\mathbf{q}},t) = T - V.
\]

\subsection{Canonical Momenta}

\[
p_{x_{\mathrm{pill}}} = m_{\mathrm{pill}} \dot{x}_{\mathrm{pill}},
\qquad
p_{C_p}(x,t) = \eta_p(x)\dot{C}_p(x,t),
\qquad
p_{C_a}(x,t) = \eta_a(x)\dot{C}_a(x,t).
\]

\subsection{Hamiltonian}

\begin{align}
\mathcal{H}(\mathbf{q},\mathbf{p},t)
&=
\frac{p_{x_{\mathrm{pill}}}^2}{2 m_{\mathrm{pill}}}
+
\int_0^L
\left(
\frac{p_{C_p}^2}{2\eta_p(x)}
+
\frac{p_{C_a}^2}{2\eta_a(x)}
\right) dx
+
V(\mathbf{q},t).
\end{align}

