\section{Immune State Machine (CTSHA)}

\subsection{State Space}

\[
\mathcal{S} = \{S_0, S_1, S_2, S_3\}
\]
with:
\[
S_0 = \text{Na\"ive},\quad
S_1 = \text{Capture/Processing},\quad
S_2 = \text{Maturation/Migration},\quad
S_3 = \text{Effector/Regulatory}.
\]

\subsection{Biochemical Driver Vector}

\[
\mathbf{X}(t) =
\begin{bmatrix}
C_a^{\mathrm{loc}}(t) \\
\mathrm{DC}_{\mathrm{active}}(t) \\
\mathrm{IL}\!-\!10(t) \\
\mathrm{TGF}\!-\!\beta(t) \\
\mathrm{TNF}\!-\!\alpha(t)
\end{bmatrix}.
\]

\subsection{Generator Matrix}

Let $\mathbf{P}(t)$ be the state probability vector.  
The CTSHA dynamics follow:

\begin{equation}
\frac{d\mathbf{P}}{dt}
=
\mathbf{Q}(\mathbf{X}(t))\, \mathbf{P}(t),
\end{equation}

where $\mathbf{Q}$ satisfies:

\[
q_{ii}(\mathbf{X}) = -\sum_{j\neq i} q_{ij}(\mathbf{X}).
\]

Example transitions:

\[
q_{01} = k_{01} C_a^{\mathrm{loc}}(t), \qquad
q_{12} = k_{12} \mathrm{DC}_{\mathrm{active}}(t),
\]
\[
q_{23} = k_{23}\, g\!\left(\mathrm{IL}\!-\!10, \mathrm{TGF}\!-\!\beta, \mathrm{TNF}\!-\!\alpha\right).
\]

