%===========================================================

\subsection{2.1 Overview of Cross-Scale Mapping}
The cross-scale invariance bridge $\mathcal{K}_{\mathrm{bridge}}$ provides
a mathematically consistent transformation between macro-scale astrophysical
fields and micro-scale cellular tensors. Unlike traditional multi-scale
models, $\mathcal{K}_{\mathrm{bridge}}$ preserves thermodynamic, informational,
and dynamical invariants across all scales.

\subsection{2.2 Formal Definition}
\begin{definition}[Cross-Scale Operator]
Let $\Phi_{\mathrm{MW}}$ denote the macro-scale field invariant and
$\mathbf{T}_{\mathrm{cell}}$ the micro-scale cellular tensor. The operator
$\mathcal{K}_{\mathrm{bridge}}$ is defined as:
\[
\mathcal{K}_{\mathrm{bridge}} : \Phi_{\mathrm{MW}} \mapsto \mathbf{T}_{\mathrm{cell}},
\]
subject to the conservation constraint:
\[
\Delta E_{\mathrm{macro} \to \mathrm{micro}} = 0.
\]
\end{definition}

\subsection{2.3 Conservation Laws}
The operator must satisfy:
\[
\nabla \cdot \mathbf{J}_{\mathrm{macro}} = 0
\quad \Longrightarrow \quad
\nabla \cdot \mathbf{J}_{\mathrm{micro}} = 0,
\]
ensuring that no energy, momentum, or informational leakage occurs during
cross-scale transformation.

\subsection{2.4 Theorem: Zero-Leakage Transformation}
\begin{theorem}
Under maximum gradient flux, the operator $\mathcal{K}_{\mathrm{bridge}}$
preserves all thermodynamic and informational invariants. In particular:
\[
\Delta E_{\mathrm{macro} \to \mathrm{micro}} = 0,
\qquad
\Delta S_{\mathrm{macro} \to \mathrm{micro}} = 0,
\qquad
\Delta I_{\mathrm{macro} \to \mathrm{micro}} = 0.
\]
\end{theorem}

\begin{proof}
Since $\mathcal{K}_{\mathrm{bridge}}$ is defined as a conservative mapping,
it must satisfy:
\[
\frac{d}{dt} \int_{\Omega_{\mathrm{macro}}} \mathbf{J}_{\mathrm{macro}} \cdot d\mathbf{A}
=
\frac{d}{dt} \int_{\Omega_{\mathrm{micro}}} \mathbf{J}_{\mathrm{micro}} \cdot d\mathbf{A}.
\]
Because the flux divergence is zero at the macro scale, it must also be zero
at the micro scale. Therefore, all conservation laws are preserved.
\end{proof}

\subsection{2.5 Tensor Algebra of the Bridge}
Let $\mathbf{T}_{\mathrm{macro}}$ denote the macro-scale tensor field and
$\mathbf{T}_{\mathrm{micro}}$ the micro-scale tensor field. Then:
\[
\mathbf{T}_{\mathrm{micro}}
=
\mathcal{K}_{\mathrm{bridge}}(\mathbf{T}_{\mathrm{macro}}),
\]
with the constraint:
\[
\|\mathbf{T}_{\mathrm{micro}}\| = \|\mathbf{T}_{\mathrm{macro}}\|.
\]

