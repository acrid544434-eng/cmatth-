\chapter{ADM Decomposition and Canonical Gravity}

\section{Introduction}
The Arnowitt–Deser–Misner (ADM) 3+1 decomposition provides the canonical Hamiltonian 
formulation of general relativity. It rewrites spacetime as a foliation of spatial 
hypersurfaces $\Sigma_t$ evolving in time. This chapter develops the full ADM formalism 
required for UKG-SE, including the lapse–shift structure, extrinsic curvature, 
Hamiltonian and momentum constraints, and canonical evolution equations.

\section{Spacetime Foliation}

\subsection{3+1 Split}
Let spacetime $(\mathcal{M}, g_{\mu\nu})$ be decomposed into spatial hypersurfaces 
$\Sigma_t$ labeled by coordinate time $t$. The metric becomes:
\begin{equation}
ds^2 = -\alpha^2 dt^2 + h_{ij}(dx^i + \beta^i dt)(dx^j + \beta^j dt),
\end{equation}
where:
\begin{itemize}
    \item $\alpha$ is the lapse function,
    \item $\beta^i$ is the shift vector,
    \item $h_{ij}$ is the induced 3-metric on $\Sigma_t$.
\end{itemize}

\subsection{Geometric Interpretation}
\begin{itemize}
    \item $\alpha$ controls the rate of advance of proper time.
    \item $\beta^i$ controls spatial coordinate drift.
    \item $h_{ij}$ describes intrinsic geometry of $\Sigma_t$.
\end{itemize}

\section{Extrinsic Curvature}

\subsection{Definition}
The extrinsic curvature $K_{ij}$ measures how $\Sigma_t$ is embedded in spacetime:
\begin{equation}
K_{ij} =
\frac{1}{2\alpha}
\left(
\dot{h}_{ij} - D_i \beta_j - D_j \beta_i
\right),
\end{equation}
where $D_i$ is the covariant derivative compatible with $h_{ij}$.

\subsection{Trace and Tensor Decomposition}
Define:
\begin{equation}
K = h^{ij} K_{ij}.
\end{equation}

Decompose:
\begin{equation}
K_{ij} = A_{ij} + \frac{1}{3} h_{ij} K,
\end{equation}
where $A_{ij}$ is the trace-free part.

\section{ADM Hamiltonian}

\subsection{Canonical Variables}
The canonical variables are:
\begin{equation}
(h_{ij}, \pi^{ij}),
\end{equation}
where the conjugate momentum is:
\begin{equation}
\pi^{ij} = \sqrt{h} (K^{ij} - h^{ij} K).
\end{equation}

\subsection{Hamiltonian Density}
The ADM Hamiltonian density is:
\begin{equation}
\mathcal{H}_{\text{ADM}} =
\alpha \mathcal{H}
+ \beta_i \mathcal{M}^i,
\end{equation}
where $\mathcal{H}$ and $\mathcal{M}^i$ are the Hamiltonian and momentum constraints.

\section{Constraint Equations}

\subsection{Hamiltonian Constraint}
\begin{equation}
\mathcal{H} =
R^{(3)} + K^2 - K_{ij} K^{ij}
- 16\pi G \rho = 0,
\end{equation}
where $R^{(3)}$ is the Ricci scalar of $h_{ij}$.

\subsection{Momentum Constraint}
\begin{equation}
\mathcal{M}^i =
D_j (K^{ij} - h^{ij} K)
- 8\pi G S^i = 0.
\end{equation}

\section{Canonical Evolution Equations}

\subsection{Metric Evolution}
\begin{equation}
\dot{h}_{ij} =
\frac{\delta H}{\delta \pi^{ij}}
=
2\alpha (K_{ij})
+ D_i \beta_j + D_j \beta_i.
\end{equation}

\subsection{Momentum Evolution}
\begin{equation}
\dot{\pi}^{ij} =
-\frac{\delta H}{\delta h_{ij}}.
\end{equation}

Explicitly:
\begin{align}
\dot{\pi}^{ij}
&=
-\alpha \sqrt{h}
\left(
R^{ij} - \frac{1}{2} h^{ij} R^{(3)}
\right)
+ \sqrt{h}
\left(
D^i D^j \alpha - h^{ij} D_k D^k \alpha
\right) \\
&\quad
+ \alpha \sqrt{h}
\left(
K K^{ij} - 2 K^{ik} K^j{}_k
\right)
+ \mathcal{L}_{\beta} \pi^{ij}.
\end{align}

\section{ADM Formalism in Kerr Geometry}

\subsection{ADM Variables for Kerr}
The Kerr metric yields:
\begin{equation}
h_{ij} =
\begin{pmatrix}
\frac{\Sigma}{\Delta} & 0 & 0 \\
0 & \Sigma & 0 \\
0 & 0 & \left(r^2 + a^2 + \frac{2Ma^2 r\sin^2\theta}{\Sigma}\right)\sin^2\theta
\end{pmatrix},
\end{equation}

\begin{equation}
\beta^{\phi} = -\frac{2Mar}{\Sigma(r^2 + a^2)}.
\end{equation}

\begin{equation}
\alpha = \sqrt{\frac{\Delta \Sigma}{(r^2 + a^2)^2 - a^2 \Delta \sin^2\theta}}.
\end{equation}

\subsection{Extrinsic Curvature in Kerr}
The extrinsic curvature tensor $K_{ij}$ contains rotational contributions from 
frame-dragging, producing non-zero off-diagonal components.

\section{ADM and UKG-SE Integration}

\subsection{Canonical Momentum Flux}
UKG-SE extends ADM by defining:
\begin{equation}
\Pi^{ij} =
\pi^{ij}
+ \Theta^{ij}_{\text{momentum}},
\end{equation}
where $\Theta^{ij}_{\text{momentum}}$ includes curvature-bound corrections.

\subsection{Constraint Stabilization}
UKG-SE enforces:
\begin{equation}
\mathcal{H} < 10^{-12}, \qquad
\mathcal{M}^i < 10^{-12}.
\end{equation}

\section{Conclusion}
This chapter develops the ADM 3+1 Hamiltonian formalism required for UKG-SE v2.0. 
The ADM decomposition provides the canonical structure for evolving spacetime, 
propagating momentum, and enforcing constraint stability in curved geometries, 
including high-spin Kerr systems.