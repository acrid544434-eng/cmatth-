def write_ledger(T, R, q, p):
    entry = {
        "tensor": T.tolist(),
        "residual": float(R),
        "q": float(q),
        "p": float(p),
        "timestamp": time.time(),
    }
    entry_str = str(entry).encode('utf-8')
    entry["hash"] = hashlib.sha3_256(entry_str).hexdigest()
