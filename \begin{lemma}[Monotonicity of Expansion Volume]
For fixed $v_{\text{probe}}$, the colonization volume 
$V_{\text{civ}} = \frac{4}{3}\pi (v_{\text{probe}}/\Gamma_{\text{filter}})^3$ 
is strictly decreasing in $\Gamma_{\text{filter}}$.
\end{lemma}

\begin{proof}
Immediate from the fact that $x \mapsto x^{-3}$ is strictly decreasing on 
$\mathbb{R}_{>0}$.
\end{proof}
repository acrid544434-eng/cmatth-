\begin{lemma}[Monotonicity of Expansion Volume]
For fixed $v_{\text{probe}}$, the colonization volume 
$V_{\text{civ}} = \frac{4}{3}\pi (v_{\text{probe}}/\Gamma_{\text{filter}})^3$ 
is strictly decreasing in $\Gamma_{\text{filter}}$.
\end{lemma}

\begin{proof}
Immediate from the fact that $x \mapsto x^{-3}$ is strictly decreasing on 
$\mathbb{R}_{>0}$.
\end{proof}