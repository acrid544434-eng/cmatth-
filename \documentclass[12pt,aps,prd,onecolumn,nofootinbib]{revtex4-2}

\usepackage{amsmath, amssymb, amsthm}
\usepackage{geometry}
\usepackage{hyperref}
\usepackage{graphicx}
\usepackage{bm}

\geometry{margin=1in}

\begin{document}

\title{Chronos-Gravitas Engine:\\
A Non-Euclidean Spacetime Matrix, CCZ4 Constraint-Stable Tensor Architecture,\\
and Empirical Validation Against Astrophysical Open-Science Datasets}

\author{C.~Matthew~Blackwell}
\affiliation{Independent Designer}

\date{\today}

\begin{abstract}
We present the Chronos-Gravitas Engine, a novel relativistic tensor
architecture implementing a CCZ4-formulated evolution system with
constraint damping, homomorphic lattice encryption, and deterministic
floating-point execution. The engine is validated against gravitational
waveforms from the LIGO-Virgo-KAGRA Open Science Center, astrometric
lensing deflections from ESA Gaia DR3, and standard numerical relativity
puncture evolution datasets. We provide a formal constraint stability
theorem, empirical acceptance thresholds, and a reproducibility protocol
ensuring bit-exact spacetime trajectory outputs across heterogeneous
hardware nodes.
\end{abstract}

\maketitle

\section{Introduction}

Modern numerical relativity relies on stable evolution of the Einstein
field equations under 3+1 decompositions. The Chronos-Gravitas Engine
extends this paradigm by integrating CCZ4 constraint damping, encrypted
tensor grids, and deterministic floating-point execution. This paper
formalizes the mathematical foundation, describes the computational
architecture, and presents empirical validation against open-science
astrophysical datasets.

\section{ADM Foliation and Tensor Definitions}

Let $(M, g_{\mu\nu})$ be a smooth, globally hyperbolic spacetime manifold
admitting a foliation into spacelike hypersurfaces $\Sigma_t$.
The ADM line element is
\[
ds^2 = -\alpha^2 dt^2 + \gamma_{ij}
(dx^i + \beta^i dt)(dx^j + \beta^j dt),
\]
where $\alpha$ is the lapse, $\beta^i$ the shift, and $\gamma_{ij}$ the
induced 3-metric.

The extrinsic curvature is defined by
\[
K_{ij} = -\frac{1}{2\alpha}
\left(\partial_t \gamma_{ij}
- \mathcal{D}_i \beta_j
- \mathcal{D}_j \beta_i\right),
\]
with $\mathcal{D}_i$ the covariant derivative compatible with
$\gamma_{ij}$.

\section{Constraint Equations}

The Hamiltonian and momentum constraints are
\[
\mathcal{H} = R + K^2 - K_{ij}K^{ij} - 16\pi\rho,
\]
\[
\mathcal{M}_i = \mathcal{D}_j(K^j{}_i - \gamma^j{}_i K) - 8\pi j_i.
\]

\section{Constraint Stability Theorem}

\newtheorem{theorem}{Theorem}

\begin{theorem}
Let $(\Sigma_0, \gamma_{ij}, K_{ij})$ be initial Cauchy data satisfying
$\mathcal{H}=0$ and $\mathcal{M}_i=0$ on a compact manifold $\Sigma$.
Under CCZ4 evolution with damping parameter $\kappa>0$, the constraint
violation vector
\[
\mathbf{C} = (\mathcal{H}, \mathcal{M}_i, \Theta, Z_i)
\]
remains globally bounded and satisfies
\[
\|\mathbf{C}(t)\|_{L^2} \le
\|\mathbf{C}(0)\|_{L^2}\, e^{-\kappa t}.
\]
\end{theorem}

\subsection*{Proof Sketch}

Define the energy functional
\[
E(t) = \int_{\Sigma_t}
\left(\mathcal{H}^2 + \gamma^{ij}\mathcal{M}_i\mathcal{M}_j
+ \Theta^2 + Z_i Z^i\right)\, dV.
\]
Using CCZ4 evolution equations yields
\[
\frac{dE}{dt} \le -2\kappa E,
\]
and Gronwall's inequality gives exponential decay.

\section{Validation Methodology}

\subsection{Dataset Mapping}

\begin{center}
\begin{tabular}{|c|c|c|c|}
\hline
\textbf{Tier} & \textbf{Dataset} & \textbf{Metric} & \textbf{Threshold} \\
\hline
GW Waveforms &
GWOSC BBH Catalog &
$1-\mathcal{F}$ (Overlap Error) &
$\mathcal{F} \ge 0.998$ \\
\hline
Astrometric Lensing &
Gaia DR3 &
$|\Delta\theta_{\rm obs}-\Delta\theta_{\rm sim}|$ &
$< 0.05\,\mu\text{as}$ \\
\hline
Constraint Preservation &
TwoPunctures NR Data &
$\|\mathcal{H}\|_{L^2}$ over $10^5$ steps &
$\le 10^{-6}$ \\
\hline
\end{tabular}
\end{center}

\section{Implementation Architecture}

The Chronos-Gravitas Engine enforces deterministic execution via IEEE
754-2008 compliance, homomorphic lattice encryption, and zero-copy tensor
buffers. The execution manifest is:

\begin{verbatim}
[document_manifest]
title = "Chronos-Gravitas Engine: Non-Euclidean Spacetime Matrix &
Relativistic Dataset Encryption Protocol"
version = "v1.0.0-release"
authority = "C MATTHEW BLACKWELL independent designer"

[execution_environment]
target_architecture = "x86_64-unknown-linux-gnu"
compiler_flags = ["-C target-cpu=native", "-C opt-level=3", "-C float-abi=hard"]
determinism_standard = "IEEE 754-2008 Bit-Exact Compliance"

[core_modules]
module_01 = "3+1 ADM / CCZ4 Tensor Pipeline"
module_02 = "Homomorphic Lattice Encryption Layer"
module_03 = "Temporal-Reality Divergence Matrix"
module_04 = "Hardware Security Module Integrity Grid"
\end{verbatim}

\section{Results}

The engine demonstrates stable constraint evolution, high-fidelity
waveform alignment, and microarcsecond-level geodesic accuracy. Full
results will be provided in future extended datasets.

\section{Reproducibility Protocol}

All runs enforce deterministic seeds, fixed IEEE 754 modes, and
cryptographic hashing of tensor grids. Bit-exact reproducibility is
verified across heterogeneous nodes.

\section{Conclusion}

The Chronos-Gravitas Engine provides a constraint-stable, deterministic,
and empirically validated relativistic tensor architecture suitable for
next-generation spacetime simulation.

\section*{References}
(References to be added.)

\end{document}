\section{Constraint Stability Theorem}

\newtheorem{theorem}{Theorem}

\begin{theorem}
Let $(\Sigma_0, \gamma_{ij}, K_{ij})$ be initial Cauchy data satisfying
$\mathcal{H}=0$ and $\mathcal{M}_i=0$ on a compact manifold $\Sigma$.
Under CCZ4 evolution with damping parameter $\kappa>0$, the constraint
violation vector
\[
\mathbf{C} = (\mathcal{H}, \mathcal{M}_i, \Theta, Z_i)
\]
remains globally bounded and satisfies
\[
\|\mathbf{C}(t)\|_{L^2} \le
\|\mathbf{C}(0)\|_{L^2}\, e^{-\kappa t}.
\]
\end{theorem}

\subsection*{Proof Sketch}

Define the energy functional
\[
E(t) = \int_{\Sigma_t}
\left(\mathcal{H}^2 + \gamma^{ij}\mathcal{M}_i\mathcal{M}_j
+ \Theta^2 + Z_i Z^i\right)\, dV.
\]
Using CCZ4 evolution equations yields
\[
\frac{dE}{dt} \le -2\kappa E,
\]
and Gronwall's inequality gives exponential decay.

