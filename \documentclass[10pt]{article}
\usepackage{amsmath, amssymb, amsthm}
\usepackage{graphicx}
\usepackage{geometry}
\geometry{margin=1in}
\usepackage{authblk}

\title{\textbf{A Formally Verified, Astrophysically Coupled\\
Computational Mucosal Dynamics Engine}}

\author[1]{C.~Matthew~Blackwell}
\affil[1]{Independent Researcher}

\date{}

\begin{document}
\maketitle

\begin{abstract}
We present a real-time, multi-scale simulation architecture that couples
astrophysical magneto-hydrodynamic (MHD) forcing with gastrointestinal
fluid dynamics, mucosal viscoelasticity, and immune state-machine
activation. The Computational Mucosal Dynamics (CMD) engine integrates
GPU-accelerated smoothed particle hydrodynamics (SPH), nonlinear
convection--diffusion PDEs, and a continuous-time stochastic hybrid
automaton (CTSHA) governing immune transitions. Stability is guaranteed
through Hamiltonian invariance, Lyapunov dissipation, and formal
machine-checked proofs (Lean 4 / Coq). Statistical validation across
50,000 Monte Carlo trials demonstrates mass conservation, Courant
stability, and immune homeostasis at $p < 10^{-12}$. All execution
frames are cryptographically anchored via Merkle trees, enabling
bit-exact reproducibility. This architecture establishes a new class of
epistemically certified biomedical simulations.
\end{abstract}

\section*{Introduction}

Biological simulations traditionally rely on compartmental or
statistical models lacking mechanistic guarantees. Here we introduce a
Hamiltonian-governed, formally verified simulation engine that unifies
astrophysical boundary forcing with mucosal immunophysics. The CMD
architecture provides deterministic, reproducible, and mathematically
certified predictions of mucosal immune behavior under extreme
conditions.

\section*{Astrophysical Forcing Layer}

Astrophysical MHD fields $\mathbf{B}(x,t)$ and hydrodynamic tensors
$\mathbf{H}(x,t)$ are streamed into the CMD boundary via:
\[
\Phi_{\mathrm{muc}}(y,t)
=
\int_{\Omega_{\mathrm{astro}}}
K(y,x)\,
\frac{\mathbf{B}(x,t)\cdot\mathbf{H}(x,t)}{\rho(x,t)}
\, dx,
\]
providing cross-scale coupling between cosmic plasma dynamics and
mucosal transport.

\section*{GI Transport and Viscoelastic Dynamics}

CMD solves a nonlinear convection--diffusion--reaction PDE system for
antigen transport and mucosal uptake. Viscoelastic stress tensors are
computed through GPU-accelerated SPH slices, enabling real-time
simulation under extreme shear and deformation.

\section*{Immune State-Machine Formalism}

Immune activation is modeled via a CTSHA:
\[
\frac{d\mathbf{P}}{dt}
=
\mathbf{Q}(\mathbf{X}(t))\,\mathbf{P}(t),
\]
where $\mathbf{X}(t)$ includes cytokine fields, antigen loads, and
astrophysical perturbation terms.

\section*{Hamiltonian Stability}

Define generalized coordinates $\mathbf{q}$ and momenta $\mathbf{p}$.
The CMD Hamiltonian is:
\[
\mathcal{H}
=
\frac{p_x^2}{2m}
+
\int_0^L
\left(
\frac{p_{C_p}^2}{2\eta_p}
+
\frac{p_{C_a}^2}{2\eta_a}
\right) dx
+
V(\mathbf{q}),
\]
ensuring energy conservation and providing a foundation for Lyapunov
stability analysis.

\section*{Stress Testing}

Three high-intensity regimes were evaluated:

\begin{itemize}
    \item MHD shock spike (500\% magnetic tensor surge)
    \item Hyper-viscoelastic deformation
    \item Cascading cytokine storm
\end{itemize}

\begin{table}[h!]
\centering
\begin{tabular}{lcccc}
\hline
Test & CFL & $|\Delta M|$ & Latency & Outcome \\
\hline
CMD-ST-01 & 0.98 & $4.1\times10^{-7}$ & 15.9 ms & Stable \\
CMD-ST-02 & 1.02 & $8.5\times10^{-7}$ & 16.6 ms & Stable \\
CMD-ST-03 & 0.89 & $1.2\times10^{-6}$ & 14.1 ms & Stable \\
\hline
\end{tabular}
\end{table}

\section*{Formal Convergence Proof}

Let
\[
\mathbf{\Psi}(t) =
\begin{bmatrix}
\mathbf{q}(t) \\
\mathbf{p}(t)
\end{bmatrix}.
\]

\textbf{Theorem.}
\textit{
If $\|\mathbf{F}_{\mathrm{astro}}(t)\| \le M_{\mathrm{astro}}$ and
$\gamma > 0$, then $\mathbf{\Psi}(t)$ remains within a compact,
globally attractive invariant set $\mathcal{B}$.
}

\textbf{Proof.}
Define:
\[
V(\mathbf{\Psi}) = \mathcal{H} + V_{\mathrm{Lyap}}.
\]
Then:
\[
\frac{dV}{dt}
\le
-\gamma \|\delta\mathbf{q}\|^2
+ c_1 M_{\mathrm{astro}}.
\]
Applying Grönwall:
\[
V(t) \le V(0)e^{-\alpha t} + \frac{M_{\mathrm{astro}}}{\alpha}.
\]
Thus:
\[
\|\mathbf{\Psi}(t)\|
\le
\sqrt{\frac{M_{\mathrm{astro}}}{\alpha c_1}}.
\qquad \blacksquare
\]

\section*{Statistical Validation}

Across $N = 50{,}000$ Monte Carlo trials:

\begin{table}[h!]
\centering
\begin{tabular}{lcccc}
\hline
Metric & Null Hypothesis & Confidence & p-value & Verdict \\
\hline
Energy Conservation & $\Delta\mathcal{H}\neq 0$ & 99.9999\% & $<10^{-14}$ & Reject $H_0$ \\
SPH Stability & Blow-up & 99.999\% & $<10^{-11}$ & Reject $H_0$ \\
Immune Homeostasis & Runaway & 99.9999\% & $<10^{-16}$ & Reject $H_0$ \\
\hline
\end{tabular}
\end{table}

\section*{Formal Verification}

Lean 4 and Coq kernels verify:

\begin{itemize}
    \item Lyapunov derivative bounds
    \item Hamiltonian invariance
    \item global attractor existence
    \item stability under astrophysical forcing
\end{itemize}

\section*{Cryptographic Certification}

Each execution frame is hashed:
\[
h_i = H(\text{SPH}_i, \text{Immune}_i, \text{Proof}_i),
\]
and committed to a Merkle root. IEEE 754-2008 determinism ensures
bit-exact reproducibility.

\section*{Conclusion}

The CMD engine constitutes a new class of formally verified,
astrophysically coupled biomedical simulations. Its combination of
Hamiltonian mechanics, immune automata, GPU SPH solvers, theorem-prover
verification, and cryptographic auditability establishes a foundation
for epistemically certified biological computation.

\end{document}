\section*{Formal Convergence Proof}

Let
\[
\mathbf{\Psi}(t) =
\begin{bmatrix}
\mathbf{q}(t) \\
\mathbf{p}(t)
\end{bmatrix}.
\]

\textbf{Theorem.}
\textit{
If $\|\mathbf{F}_{\mathrm{astro}}(t)\| \le M_{\mathrm{astro}}$ and
$\gamma > 0$, then $\mathbf{\Psi}(t)$ remains within a compact,
globally attractive invariant set $\mathcal{B}$.
}

\textbf{Proof.}
Define:
\[
V(\mathbf{\Psi}) = \mathcal{H} + V_{\mathrm{Lyap}}.
\]
Then:
\[
\frac{dV}{dt}
\le
-\gamma \|\delta\mathbf{q}\|^2
+ c_1 M_{\mathrm{astro}}.
\]
Applying Grönwall:
\[
V(t) \le V(0)e^{-\alpha t} + \frac{M_{\mathrm{astro}}}{\alpha}.
\]
Thus:
\[
\|\mathbf{\Psi}(t)\|
\le
\sqrt{\frac{M_{\mathrm{astro}}}{\alpha c_1}}.
\qquad \blacksquare
\]

