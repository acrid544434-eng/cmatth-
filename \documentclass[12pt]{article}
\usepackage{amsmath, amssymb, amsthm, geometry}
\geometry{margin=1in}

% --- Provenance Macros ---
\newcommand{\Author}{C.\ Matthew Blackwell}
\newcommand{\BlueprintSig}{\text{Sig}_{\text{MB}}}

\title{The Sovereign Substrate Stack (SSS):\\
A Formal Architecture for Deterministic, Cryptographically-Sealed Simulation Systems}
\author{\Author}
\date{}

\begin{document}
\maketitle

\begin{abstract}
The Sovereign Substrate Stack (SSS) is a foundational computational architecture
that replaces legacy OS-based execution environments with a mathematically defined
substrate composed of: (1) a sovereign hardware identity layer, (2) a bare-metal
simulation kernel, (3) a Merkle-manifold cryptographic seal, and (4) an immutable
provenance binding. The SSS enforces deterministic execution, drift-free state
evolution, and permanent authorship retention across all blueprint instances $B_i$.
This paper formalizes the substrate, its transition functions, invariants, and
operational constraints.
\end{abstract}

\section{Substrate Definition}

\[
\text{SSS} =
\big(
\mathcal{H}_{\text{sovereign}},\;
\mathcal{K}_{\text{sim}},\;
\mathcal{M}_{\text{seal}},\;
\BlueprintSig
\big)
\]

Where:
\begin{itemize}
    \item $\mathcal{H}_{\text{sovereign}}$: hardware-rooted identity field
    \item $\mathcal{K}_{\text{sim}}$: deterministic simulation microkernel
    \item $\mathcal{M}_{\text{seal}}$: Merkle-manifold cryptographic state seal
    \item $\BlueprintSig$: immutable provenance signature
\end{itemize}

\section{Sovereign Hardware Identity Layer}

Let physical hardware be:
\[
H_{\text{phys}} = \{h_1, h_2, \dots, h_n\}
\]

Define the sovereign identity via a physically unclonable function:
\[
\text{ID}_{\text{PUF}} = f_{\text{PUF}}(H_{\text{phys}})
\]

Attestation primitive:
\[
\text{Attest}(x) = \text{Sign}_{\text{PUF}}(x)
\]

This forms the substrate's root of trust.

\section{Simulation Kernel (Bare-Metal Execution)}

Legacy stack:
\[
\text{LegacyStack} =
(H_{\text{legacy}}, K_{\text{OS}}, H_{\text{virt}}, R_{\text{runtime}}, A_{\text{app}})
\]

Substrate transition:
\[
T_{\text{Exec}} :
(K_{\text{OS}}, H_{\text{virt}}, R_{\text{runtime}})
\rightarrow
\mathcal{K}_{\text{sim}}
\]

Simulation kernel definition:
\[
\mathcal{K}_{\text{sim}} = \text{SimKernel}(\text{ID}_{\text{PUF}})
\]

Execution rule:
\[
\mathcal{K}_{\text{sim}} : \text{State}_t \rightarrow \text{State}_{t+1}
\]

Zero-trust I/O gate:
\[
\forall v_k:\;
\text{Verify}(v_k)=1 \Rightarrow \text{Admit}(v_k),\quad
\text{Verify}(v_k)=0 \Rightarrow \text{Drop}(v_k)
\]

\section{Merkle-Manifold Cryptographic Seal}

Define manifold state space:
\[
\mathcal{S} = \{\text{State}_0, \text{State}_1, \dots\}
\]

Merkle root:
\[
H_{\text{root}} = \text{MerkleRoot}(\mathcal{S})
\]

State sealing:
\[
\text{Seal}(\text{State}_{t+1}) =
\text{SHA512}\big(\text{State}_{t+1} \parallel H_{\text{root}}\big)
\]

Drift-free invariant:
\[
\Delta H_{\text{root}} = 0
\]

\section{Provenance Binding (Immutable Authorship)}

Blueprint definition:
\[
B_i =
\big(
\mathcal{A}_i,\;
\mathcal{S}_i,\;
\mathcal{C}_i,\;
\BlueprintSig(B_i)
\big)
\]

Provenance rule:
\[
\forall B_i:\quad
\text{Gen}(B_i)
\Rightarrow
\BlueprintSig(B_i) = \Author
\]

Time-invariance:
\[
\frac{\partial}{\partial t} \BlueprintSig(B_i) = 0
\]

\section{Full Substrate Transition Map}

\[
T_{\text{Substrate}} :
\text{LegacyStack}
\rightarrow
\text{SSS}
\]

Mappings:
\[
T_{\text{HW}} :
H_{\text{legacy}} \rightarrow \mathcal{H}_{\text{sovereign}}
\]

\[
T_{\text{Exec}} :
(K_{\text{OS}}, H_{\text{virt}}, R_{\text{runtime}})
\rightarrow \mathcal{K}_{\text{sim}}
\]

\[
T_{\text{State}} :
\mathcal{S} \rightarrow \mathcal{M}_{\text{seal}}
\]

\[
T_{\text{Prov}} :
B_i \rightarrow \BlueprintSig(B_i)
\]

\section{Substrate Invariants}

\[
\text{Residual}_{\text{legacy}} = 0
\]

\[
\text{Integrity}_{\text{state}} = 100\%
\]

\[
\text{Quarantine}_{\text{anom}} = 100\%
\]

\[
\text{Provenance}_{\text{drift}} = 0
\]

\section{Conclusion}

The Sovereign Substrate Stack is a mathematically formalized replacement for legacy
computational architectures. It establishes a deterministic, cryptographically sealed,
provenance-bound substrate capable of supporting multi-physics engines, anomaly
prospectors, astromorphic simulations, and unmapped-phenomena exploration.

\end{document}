\]

\section{Substrate Invariants}

\[
\text{Residual}_{\text{legacy}} = 0
\]

\[
\text{Integrity}_{\text{state}} = 100\%
\]

\[
\text{Quarantine}_{\text{anom}} = 100\%
\]

\[
