\section{Experiment 1: Nominal Vitality Dynamics}
\subsection{Objective}
Evaluate baseline follicular vitality under nominal biological
parameters.

\subsection{Materials}
\begin{itemize}
    \item Nominal parameter set $\{\alpha,\beta,\gamma\}$
    \item Initial vitality index $F(0)=F^*$
    \item Phase indicator $\sigma(0)=A$
\end{itemize}

\subsection{Procedure}
\begin{enumerate}
    \item Initialize $F(0)=F^*$.
    \item Simulate $\frac{dF}{dt}$ for 365 days.
    \item Record phase transitions and vitality trajectory.
\end{enumerate}

\subsection{Expected Outcome}
Vitality remains bounded within the nominal operating band.

