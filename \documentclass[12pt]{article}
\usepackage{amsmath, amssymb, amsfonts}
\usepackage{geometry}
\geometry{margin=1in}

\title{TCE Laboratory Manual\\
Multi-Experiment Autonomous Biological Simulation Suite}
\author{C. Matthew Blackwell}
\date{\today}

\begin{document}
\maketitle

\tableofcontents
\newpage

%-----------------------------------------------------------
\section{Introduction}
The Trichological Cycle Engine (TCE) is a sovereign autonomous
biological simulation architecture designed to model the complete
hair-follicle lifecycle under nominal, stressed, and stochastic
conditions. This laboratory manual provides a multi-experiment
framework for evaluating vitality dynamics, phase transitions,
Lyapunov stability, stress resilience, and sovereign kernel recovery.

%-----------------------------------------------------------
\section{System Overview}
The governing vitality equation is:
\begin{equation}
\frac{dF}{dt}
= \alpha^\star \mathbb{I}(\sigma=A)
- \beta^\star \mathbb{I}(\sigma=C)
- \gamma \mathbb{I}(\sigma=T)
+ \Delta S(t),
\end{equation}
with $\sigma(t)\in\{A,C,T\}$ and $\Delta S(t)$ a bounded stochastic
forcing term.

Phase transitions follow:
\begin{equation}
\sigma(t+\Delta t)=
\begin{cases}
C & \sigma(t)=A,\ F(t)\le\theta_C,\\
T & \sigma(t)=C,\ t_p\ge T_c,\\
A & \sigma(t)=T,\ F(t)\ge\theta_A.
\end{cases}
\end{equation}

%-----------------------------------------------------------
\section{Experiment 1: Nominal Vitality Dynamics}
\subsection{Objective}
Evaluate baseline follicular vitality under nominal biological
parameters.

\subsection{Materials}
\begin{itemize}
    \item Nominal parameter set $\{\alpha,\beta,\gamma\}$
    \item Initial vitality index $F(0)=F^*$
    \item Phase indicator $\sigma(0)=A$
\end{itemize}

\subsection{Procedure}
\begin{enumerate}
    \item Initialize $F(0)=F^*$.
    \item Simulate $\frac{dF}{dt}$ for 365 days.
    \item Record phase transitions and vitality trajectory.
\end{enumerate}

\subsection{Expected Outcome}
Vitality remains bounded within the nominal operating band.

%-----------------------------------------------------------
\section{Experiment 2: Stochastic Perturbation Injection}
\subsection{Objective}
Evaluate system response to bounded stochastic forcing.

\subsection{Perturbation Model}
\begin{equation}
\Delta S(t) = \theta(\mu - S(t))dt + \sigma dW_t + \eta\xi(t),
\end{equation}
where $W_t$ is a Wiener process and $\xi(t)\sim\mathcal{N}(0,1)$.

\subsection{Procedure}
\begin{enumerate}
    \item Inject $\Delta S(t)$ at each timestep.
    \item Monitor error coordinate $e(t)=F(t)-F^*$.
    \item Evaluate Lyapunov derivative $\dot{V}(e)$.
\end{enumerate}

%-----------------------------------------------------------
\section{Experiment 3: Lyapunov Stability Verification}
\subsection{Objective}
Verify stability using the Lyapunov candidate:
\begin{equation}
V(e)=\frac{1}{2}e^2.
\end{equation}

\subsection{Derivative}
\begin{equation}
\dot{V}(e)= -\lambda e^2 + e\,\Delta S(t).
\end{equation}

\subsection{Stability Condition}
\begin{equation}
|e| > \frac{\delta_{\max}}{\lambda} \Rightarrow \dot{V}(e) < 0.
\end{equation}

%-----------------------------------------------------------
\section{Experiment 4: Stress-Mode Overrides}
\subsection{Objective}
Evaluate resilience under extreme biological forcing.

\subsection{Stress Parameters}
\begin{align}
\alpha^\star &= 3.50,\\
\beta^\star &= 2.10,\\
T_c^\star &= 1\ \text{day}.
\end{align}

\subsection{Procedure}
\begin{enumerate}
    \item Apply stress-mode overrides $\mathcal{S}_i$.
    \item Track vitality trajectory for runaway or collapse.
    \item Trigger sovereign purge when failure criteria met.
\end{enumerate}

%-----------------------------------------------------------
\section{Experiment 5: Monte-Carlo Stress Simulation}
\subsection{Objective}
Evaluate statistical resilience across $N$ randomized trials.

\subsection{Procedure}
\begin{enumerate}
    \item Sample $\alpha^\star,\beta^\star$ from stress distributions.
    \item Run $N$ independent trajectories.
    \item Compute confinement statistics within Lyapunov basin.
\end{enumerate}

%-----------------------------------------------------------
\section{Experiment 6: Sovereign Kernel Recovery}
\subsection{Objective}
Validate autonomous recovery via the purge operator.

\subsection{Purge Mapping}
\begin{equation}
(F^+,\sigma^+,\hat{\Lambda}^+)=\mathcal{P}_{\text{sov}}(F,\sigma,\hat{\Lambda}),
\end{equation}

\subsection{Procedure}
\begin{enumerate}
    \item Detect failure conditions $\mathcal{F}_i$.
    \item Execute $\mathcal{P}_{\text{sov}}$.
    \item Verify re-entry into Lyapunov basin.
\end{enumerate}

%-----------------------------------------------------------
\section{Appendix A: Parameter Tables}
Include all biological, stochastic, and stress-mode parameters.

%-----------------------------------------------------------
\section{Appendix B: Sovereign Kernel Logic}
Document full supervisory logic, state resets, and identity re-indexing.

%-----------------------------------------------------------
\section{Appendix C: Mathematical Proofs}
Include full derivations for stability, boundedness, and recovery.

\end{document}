\section{Experiment 2: Stochastic Perturbation Injection}
\subsection{Objective}
Evaluate system response to bounded stochastic forcing.

\subsection{Perturbation Model}
\begin{equation}
\Delta S(t) = \theta(\mu - S(t))dt + \sigma dW_t + \eta\xi(t),
\end{equation}
where $W_t$ is a Wiener process and $\xi(t)\sim\mathcal{N}(0,1)$.

\subsection{Procedure}
\begin{enumerate}
    \item Inject $\Delta S(t)$ at each timestep.
    \item Monitor error coordinate $e(t)=F(t)-F^*$.
    \item Evaluate Lyapunov derivative $\dot{V}(e)$.
\end{enumerate}

%-----------------------------------------------------------
\section{Experiment 3: Lyapunov Stability Verification}
\subsection{Objective}
Verify stability using the Lyapunov candidate:
\begin{equation}
V(e)=\frac{1}{2}e^2.
\end{equation}

\subsection{Derivative}
\begin{equation}
\dot{V}(e)= -\lambda e^2 + e\,\Delta S(t).
\end{equation}

\subsection{Stability Condition}
\begin{equation}
|e| > \frac{\delta_{\max}}{\lambda} \Rightarrow \dot{V}(e) < 0.
\end{equation}

