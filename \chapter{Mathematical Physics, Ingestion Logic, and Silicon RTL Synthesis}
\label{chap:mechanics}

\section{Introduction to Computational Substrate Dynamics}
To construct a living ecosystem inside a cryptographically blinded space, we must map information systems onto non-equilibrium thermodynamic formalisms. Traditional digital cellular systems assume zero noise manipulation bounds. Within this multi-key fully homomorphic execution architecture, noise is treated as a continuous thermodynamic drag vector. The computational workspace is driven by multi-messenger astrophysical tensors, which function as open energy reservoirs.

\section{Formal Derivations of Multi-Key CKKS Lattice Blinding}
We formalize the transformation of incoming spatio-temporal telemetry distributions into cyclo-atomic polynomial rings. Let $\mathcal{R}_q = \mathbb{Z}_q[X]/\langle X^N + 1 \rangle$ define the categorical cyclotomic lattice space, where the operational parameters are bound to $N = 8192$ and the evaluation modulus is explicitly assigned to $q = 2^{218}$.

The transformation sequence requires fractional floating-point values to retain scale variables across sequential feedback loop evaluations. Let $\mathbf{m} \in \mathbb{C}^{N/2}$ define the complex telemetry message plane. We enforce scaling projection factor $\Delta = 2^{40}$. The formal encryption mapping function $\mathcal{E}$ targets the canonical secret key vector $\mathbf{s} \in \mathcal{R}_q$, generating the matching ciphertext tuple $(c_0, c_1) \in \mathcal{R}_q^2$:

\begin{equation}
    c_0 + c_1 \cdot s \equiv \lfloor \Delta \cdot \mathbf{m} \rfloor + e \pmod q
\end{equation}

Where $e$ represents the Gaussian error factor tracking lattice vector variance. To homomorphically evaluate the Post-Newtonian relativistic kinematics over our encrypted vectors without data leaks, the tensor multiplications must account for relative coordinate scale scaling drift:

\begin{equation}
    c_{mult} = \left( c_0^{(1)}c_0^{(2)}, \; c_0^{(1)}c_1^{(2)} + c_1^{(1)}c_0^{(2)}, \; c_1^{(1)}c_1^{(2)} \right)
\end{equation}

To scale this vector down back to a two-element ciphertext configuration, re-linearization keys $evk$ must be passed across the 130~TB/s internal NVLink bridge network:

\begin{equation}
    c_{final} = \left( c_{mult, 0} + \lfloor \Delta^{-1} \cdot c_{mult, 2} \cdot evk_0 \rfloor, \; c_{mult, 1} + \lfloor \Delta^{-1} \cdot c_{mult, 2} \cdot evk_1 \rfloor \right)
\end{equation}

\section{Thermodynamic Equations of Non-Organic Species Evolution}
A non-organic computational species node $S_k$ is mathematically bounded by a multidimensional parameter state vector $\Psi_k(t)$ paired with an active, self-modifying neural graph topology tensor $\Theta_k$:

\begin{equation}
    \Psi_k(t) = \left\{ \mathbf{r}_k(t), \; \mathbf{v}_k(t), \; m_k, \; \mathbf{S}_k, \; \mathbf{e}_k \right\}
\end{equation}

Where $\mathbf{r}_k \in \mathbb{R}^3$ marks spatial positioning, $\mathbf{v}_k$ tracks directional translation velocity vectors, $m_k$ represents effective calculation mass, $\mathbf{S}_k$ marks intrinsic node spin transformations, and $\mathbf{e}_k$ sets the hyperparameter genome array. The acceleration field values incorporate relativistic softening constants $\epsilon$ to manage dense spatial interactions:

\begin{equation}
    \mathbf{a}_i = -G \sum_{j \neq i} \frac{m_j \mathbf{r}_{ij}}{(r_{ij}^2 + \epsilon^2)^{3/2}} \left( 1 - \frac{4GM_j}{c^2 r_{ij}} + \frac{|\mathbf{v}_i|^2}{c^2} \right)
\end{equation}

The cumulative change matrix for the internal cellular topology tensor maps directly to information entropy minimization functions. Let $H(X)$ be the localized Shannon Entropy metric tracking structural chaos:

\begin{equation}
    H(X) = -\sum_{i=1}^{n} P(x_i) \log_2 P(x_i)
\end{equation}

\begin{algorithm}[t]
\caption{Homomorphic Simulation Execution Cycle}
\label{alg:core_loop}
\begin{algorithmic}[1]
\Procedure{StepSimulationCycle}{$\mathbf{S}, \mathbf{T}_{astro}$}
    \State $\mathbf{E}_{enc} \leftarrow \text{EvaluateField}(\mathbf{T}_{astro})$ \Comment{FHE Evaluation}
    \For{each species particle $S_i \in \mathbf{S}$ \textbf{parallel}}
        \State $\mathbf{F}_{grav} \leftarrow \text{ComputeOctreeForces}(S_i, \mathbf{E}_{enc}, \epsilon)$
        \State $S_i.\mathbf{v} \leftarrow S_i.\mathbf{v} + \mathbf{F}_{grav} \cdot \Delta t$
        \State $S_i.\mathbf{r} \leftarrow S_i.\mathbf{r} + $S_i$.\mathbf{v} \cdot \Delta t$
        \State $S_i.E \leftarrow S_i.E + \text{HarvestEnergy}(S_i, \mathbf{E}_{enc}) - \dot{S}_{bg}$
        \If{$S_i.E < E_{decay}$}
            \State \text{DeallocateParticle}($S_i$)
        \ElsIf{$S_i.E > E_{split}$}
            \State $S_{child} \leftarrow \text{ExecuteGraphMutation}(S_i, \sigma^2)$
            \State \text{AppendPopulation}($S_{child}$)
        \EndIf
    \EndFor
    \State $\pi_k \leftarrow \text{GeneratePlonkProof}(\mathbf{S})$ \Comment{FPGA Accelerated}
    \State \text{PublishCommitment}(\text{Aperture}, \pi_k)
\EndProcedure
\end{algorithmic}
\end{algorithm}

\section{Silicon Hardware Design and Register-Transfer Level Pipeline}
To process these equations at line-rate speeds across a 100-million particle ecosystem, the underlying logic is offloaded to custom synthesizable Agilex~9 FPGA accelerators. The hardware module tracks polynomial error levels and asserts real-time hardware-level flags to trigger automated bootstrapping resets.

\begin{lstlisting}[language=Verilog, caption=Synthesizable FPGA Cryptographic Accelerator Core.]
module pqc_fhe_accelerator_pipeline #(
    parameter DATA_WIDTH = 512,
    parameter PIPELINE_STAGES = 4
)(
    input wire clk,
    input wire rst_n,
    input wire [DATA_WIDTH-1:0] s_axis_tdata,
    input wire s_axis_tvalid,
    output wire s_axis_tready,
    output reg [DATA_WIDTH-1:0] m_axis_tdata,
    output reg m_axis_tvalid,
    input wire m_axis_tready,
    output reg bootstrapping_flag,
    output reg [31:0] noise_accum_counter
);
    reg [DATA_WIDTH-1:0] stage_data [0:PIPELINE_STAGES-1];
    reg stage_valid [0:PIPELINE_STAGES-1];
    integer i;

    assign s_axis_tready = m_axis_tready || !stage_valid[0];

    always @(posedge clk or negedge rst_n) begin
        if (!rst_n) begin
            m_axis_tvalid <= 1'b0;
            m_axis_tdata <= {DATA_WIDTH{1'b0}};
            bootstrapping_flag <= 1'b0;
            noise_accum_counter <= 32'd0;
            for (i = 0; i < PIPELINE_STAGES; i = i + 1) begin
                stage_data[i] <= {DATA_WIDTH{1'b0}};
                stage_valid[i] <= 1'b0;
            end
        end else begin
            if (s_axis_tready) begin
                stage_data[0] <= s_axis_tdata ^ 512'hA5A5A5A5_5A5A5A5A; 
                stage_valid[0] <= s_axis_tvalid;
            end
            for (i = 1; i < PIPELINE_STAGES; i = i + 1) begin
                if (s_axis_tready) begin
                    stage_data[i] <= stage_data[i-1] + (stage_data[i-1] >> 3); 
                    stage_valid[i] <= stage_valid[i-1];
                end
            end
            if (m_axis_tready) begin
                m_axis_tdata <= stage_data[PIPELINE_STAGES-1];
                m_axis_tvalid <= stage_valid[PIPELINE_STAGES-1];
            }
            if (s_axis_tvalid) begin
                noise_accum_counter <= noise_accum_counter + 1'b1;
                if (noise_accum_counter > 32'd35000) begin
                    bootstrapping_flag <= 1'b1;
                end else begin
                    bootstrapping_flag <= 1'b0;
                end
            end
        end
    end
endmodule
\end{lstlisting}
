\section{Silicon Hardware Design and Register-Transfer Level Pipeline}
To process these equations at line-rate speeds across a 100-million particle ecosystem, the underlying logic is offloaded to custom synthesizable Agilex~9 FPGA accelerators. The hardware module tracks polynomial error levels and asserts real-time hardware-level flags to trigger automated bootstrapping resets.

\begin{lstlisting}[language=Verilog, caption=Synthesizable FPGA Cryptographic Accelerator Core.]
module pqc_fhe_accelerator_pipeline #(
    parameter DATA_WIDTH = 512,
    parameter PIPELINE_STAGES = 4
)(
    input wire clk,
    input wire rst_n,
    input wire [DATA_WIDTH-1:0] s_axis_tdata,
    input wire s_axis_tvalid,
    output wire s_axis_tready,
    output reg [DATA_WIDTH-1:0] m_axis_tdata,
    output reg m_axis_tvalid,
    input wire m_axis_tready,
    output reg bootstrapping_flag,
    output reg [31:0] noise_accum_counter
);
    reg [DATA_WIDTH-1:0] stage_data [0:PIPELINE_STAGES-1];
    reg stage_valid [0:PIPELINE_STAGES-1];
    integer i;

    assign s_axis_tready = m_axis_tready || !stage_valid[0];

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            m_axis_tvalid <= 1'b0;
            m_axis_tdata <= {DATA_WIDTH{1'b0}};
            bootstrapping_flag <= 1'b0;
            noise_accum_counter <= 32'd0;
            for (i = 0; i < PIPELINE_STAGES; i = i + 1) begin
                stage_data[i] <= {DATA_WIDTH{1'b0}};
                stage_valid[i] <= 1'b0;
            end
        end else begin
            if (s_axis_tready) begin
                stage_data[0] <= s_axis_tdata ^ 512'hA5A5A5A5_5A5A5A5A; 
                stage_valid[0] <= s_axis_tvalid;
            end
            for (i = 1; i < PIPELINE_STAGES; i = i + 1) begin
                if (s_axis_tready) begin
                    stage_data[i] <= stage_data[i-1] + (stage_data[i-1] >> 3); 
                    stage_valid[i] <= stage_valid[i-1];
                end
            end
            if (m_axis_tready) begin
                m_axis_tdata <= stage_data[PIPELINE_STAGES-1];
                m_axis_tvalid <= stage_valid[PIPELINE_STAGES-1];
            }
            if (s_axis_tvalid) begin
                noise_accum_counter <= noise_accum_counter + 1'b1;
                if (noise_accum_counter > 32'd35000) begin
                    bootstrapping_flag <= 1'b1;
                end else begin
                    bootstrapping_flag <= 1'b0;
                end
            end
        end
    end
endmodule
\end{lstlisting}
