\chapter{Astrophysical Boundary Coupling}
%===========================================================

\section{Tensor Fields}

Let
\[
\mathbf{B} : \Omega_{\mathrm{astro}} \times [0,\infty) \to \mathbb{R}^3,
\qquad
\mathbf{H} : \Omega_{\mathrm{astro}} \times [0,\infty) \to \mathbb{R}^{3\times 3}.
\]

Assume boundedness:
\[
\|\mathbf{B}\|\le M_B, \qquad \|\mathbf{H}\|\le M_H.
\]

\section{Coupling Kernel}

\begin{axiom}[Kernel Regularity]
$K(y,x)$ measurable, bounded, and
\[
\int_{\Omega_{\mathrm{astro}}} |K(y,x)|\,dx < \infty.
\]
\end{axiom}

\section{Forcing Operator}

\[
\mathcal{F}_{\mathrm{astro}}(y,t)
=
\int_{\Omega_{\mathrm{astro}}}
K(y,x)\,
\frac{\mathbf{B}(x,t)\cdot\mathbf{H}(x,t)}{\rho(x,t)}\,dx.
\]

\begin{lemma}[Boundedness]
\[
\|\mathcal{F}_{\mathrm{astro}}(t)\|
\le
C_K M_B M_H.
\]
\end{lemma}

\section{Coupled CMD Equation}

\[
\frac{\partial q}{\partial t}
=
\mathcal{A}(q,p)
+
\mathcal{F}_{\mathrm{astro}}(t).
\]

\begin{theorem}[Well‑Posedness]
The CMD–astrophysical coupled system admits a unique global solution.
\end{theorem}

\begin{proof}
$\mathcal{F}_{\mathrm{astro}}$ bounded.  
$\mathcal{A}$ dissipative.  
Apply semigroup theory.
\end{proof}

\section{Conclusion}

Astrophysical forcing enters CMD through a bounded operator preserving
Hamiltonian and Lyapunov structure.

