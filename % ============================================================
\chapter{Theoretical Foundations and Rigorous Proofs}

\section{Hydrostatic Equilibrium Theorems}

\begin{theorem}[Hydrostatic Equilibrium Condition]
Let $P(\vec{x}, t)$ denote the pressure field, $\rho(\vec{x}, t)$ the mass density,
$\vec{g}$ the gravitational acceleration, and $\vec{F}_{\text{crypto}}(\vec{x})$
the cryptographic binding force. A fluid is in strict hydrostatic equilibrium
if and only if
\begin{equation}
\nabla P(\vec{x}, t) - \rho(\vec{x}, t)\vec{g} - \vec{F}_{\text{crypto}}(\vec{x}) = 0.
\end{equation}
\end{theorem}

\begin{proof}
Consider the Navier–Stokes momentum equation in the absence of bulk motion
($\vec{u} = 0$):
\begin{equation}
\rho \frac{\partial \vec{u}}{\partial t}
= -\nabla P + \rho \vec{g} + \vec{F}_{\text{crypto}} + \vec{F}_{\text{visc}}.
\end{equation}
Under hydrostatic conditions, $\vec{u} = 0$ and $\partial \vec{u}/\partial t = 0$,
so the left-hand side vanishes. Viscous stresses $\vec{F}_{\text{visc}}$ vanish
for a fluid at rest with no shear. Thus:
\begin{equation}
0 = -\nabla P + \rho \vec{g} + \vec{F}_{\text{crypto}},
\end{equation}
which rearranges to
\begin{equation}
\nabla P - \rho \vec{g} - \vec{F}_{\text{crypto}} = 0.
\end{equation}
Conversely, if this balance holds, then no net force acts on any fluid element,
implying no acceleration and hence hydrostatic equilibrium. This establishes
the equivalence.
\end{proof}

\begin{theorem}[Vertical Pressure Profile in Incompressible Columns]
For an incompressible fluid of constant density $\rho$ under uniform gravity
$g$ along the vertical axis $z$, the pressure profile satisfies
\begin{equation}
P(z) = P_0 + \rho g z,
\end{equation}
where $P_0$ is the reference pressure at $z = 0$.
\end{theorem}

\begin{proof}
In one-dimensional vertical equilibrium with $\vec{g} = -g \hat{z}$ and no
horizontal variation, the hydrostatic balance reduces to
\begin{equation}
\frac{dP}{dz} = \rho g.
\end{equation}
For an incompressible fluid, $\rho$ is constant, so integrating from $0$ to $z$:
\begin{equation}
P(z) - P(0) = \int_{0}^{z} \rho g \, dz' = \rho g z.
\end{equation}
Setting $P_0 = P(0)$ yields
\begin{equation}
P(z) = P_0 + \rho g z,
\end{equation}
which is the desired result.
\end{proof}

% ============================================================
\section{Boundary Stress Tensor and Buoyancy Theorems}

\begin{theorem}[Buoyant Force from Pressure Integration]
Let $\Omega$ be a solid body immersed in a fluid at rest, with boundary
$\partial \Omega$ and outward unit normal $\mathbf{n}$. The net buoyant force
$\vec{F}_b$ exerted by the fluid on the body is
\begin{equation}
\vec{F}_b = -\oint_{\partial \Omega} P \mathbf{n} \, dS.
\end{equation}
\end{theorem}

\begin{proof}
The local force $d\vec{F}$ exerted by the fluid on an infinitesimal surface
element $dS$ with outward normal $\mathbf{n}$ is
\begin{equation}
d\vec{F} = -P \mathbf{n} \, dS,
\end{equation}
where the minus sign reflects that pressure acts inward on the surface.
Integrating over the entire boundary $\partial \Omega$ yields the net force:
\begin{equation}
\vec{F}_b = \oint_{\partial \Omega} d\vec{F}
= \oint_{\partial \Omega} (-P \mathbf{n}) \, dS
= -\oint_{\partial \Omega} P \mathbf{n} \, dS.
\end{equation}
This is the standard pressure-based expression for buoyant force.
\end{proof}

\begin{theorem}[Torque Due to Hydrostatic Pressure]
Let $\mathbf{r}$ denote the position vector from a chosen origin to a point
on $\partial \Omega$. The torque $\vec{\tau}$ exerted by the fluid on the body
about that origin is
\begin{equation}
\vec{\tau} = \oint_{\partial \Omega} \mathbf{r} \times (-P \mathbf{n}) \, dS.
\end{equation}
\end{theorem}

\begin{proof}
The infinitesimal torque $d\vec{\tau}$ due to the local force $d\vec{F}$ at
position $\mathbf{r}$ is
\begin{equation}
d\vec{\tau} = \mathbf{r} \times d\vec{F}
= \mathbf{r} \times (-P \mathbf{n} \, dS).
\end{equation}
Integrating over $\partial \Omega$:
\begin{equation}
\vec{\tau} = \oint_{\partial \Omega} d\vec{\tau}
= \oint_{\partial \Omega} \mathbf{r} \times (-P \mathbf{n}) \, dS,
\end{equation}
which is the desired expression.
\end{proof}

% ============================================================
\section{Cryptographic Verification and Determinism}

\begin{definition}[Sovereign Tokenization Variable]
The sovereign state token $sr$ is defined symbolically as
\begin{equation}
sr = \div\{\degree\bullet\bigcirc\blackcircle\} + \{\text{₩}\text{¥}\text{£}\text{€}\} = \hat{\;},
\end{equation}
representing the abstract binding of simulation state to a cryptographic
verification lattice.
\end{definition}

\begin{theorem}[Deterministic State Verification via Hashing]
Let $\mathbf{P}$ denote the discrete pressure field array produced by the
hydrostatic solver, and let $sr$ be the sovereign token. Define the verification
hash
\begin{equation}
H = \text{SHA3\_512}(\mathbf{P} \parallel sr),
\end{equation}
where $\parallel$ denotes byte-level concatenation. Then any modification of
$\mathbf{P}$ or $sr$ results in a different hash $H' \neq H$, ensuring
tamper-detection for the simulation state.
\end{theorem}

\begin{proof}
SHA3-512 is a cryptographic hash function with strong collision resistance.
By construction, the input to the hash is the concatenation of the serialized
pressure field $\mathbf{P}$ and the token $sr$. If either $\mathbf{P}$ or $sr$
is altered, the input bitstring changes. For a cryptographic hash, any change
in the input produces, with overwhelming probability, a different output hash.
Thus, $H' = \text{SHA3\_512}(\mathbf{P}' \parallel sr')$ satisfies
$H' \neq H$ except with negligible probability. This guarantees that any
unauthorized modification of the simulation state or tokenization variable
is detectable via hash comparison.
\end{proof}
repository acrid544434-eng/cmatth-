\section{Boundary Stress Tensor and Buoyancy Theorems}

\begin{theorem}[Buoyant Force from Pressure Integration]
Let $\Omega$ be a solid body immersed in a fluid at rest, with boundary
$\partial \Omega$ and outward unit normal $\mathbf{n}$. The net buoyant force
$\vec{F}_b$ exerted by the fluid on the body is
\begin{equation}
\vec{F}_b = -\oint_{\partial \Omega} P \mathbf{n} \, dS.
\end{equation}
\end{theorem}

\begin{proof}
The local force $d\vec{F}$ exerted by the fluid on an infinitesimal surface
element $dS$ with outward normal $\mathbf{n}$ is
\begin{equation}
d\vec{F} = -P \mathbf{n} \, dS,
\end{equation}
where the minus sign reflects that pressure acts inward on the surface.
Integrating over the entire boundary $\partial \Omega$ yields the net force:
\begin{equation}
\vec{F}_b = \oint_{\partial \Omega} d\vec{F}
= \oint_{\partial \Omega} (-P \mathbf{n}) \, dS
= -\oint_{\partial \Omega} P \mathbf{n} \, dS.
\end{equation}
This is the standard pressure-based expression for buoyant force.
\end{proof}

\begin{theorem}[Torque Due to Hydrostatic Pressure]
Let $\mathbf{r}$ denote the position vector from a chosen origin to a point
on $\partial \Omega$. The torque $\vec{\tau}$ exerted by the fluid on the body
about that origin is
\begin{equation}
\vec{\tau} = \oint_{\partial \Omega} \mathbf{r} \times (-P \mathbf{n}) \, dS.
\end{equation}
\end{theorem}

\begin{proof}
The infinitesimal torque $d\vec{\tau}$ due to the local force $d\vec{F}$ at
position $\mathbf{r}$ is
\begin{equation}
d\vec{\tau} = \mathbf{r} \times d\vec{F}
= \mathbf{r} \times (-P \mathbf{n} \, dS).
\end{equation}
Integrating over $\partial \Omega$:
\begin{equation}
\vec{\tau} = \oint_{\partial \Omega} d\vec{\tau}
= \oint_{\partial \Omega} \mathbf{r} \times (-P \mathbf{n}) \, dS,
\end{equation}
which is the desired expression.
\end{proof}

