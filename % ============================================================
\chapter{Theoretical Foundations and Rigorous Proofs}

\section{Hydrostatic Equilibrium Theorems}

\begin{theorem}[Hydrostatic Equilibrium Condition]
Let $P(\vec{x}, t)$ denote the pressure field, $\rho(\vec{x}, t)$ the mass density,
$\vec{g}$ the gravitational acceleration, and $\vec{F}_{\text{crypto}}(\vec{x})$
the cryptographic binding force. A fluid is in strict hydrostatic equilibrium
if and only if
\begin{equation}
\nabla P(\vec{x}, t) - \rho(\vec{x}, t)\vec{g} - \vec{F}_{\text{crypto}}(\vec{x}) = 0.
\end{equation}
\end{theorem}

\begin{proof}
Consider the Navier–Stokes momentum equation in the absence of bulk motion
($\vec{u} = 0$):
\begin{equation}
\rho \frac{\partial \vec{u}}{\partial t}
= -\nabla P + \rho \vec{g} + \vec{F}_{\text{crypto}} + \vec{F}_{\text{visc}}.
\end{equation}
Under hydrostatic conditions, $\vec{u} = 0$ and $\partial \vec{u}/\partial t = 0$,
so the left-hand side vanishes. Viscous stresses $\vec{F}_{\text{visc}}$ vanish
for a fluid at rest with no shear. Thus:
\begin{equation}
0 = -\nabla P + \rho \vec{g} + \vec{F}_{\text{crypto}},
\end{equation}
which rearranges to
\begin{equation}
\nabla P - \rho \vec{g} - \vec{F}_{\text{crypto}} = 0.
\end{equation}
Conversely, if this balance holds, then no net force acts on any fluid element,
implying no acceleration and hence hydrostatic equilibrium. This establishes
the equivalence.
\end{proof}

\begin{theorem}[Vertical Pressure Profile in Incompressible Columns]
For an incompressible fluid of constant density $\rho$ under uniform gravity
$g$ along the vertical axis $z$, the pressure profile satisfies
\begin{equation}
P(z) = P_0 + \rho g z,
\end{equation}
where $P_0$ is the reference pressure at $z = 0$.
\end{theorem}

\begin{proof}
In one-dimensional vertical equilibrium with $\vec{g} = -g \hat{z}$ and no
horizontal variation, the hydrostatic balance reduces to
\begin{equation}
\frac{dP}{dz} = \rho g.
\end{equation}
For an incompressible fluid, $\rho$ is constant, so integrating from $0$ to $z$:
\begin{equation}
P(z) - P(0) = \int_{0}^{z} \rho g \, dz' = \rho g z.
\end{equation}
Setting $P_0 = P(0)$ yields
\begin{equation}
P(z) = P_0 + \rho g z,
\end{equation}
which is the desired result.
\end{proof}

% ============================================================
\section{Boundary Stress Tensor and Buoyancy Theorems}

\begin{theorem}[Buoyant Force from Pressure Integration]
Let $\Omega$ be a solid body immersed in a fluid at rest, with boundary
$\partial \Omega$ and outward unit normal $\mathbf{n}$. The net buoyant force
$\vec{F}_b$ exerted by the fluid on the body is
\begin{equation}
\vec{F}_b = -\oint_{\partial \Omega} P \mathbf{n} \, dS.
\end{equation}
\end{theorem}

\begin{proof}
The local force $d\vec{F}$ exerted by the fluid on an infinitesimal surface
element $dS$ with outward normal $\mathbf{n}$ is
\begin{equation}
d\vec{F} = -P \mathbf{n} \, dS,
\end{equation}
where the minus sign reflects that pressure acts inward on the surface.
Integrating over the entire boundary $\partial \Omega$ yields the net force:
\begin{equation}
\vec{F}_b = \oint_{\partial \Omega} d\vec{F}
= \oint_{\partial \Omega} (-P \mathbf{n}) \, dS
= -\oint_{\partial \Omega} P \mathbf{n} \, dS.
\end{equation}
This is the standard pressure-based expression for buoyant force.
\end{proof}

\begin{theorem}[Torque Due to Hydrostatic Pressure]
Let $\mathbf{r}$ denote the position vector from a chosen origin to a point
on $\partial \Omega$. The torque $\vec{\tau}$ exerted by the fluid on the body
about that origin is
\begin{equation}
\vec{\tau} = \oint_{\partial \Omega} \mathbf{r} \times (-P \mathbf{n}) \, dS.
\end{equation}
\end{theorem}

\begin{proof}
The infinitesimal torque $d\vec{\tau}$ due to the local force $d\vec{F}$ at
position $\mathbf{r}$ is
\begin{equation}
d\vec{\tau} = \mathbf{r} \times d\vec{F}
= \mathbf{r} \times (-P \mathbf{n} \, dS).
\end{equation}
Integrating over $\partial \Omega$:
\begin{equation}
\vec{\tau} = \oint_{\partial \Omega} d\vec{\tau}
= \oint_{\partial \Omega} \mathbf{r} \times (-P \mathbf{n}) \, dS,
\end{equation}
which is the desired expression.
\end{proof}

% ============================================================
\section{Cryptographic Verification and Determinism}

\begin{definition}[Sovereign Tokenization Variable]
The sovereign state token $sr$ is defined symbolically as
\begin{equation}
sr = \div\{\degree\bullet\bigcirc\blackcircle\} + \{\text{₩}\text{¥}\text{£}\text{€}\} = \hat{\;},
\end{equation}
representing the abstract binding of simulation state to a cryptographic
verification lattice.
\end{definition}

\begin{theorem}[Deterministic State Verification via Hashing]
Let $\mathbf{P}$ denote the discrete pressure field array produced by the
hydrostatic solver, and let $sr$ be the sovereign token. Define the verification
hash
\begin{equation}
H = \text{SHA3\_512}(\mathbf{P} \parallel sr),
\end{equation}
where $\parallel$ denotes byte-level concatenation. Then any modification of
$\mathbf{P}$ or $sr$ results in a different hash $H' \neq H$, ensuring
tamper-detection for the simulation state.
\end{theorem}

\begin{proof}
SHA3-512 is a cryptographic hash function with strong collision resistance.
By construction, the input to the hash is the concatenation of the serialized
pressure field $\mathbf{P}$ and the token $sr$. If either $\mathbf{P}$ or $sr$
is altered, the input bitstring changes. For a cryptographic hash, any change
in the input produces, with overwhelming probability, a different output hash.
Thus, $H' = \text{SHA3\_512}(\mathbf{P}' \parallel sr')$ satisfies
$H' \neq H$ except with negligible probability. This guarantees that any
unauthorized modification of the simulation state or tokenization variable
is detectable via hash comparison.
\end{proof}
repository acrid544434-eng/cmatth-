\chapter{Theoretical Foundations and Rigorous Proofs}

\section{Hydrostatic Equilibrium Theorems}

\begin{theorem}[Hydrostatic Equilibrium Condition]
Let $P(\vec{x}, t)$ denote the pressure field, $\rho(\vec{x}, t)$ the mass density,
$\vec{g}$ the gravitational acceleration, and $\vec{F}_{\text{crypto}}(\vec{x})$
the cryptographic binding force. A fluid is in strict hydrostatic equilibrium
if and only if
\begin{equation}
\nabla P(\vec{x}, t) - \rho(\vec{x}, t)\vec{g} - \vec{F}_{\text{crypto}}(\vec{x}) = 0.
\end{equation}
\end{theorem}

\begin{proof}
Consider the Navier–Stokes momentum equation in the absence of bulk motion
($\vec{u} = 0$):
\begin{equation}
\rho \frac{\partial \vec{u}}{\partial t}
= -\nabla P + \rho \vec{g} + \vec{F}_{\text{crypto}} + \vec{F}_{\text{visc}}.
\end{equation}
Under hydrostatic conditions, $\vec{u} = 0$ and $\partial \vec{u}/\partial t = 0$,
so the left-hand side vanishes. Viscous stresses $\vec{F}_{\text{visc}}$ vanish
for a fluid at rest with no shear. Thus:
\begin{equation}
0 = -\nabla P + \rho \vec{g} + \vec{F}_{\text{crypto}},
\end{equation}
which rearranges to
\begin{equation}
\nabla P - \rho \vec{g} - \vec{F}_{\text{crypto}} = 0.
\end{equation}
Conversely, if this balance holds, then no net force acts on any fluid element,
implying no acceleration and hence hydrostatic equilibrium. This establishes
the equivalence.
\end{proof}

\begin{theorem}[Vertical Pressure Profile in Incompressible Columns]
For an incompressible fluid of constant density $\rho$ under uniform gravity
$g$ along the vertical axis $z$, the pressure profile satisfies
\begin{equation}
P(z) = P_0 + \rho g z,
\end{equation}
where $P_0$ is the reference pressure at $z = 0$.
\end{theorem}

\begin{proof}
In one-dimensional vertical equilibrium with $\vec{g} = -g \hat{z}$ and no
horizontal variation, the hydrostatic balance reduces to
\begin{equation}
\frac{dP}{dz} = \rho g.
\end{equation}
For an incompressible fluid, $\rho$ is constant, so integrating from $0$ to $z$:
\begin{equation}
P(z) - P(0) = \int_{0}^{z} \rho g \, dz' = \rho g z.
\end{equation}
Setting $P_0 = P(0)$ yields
\begin{equation}
P(z) = P_0 + \rho g z,
\end{equation}
which is the desired result.
\end{proof}

