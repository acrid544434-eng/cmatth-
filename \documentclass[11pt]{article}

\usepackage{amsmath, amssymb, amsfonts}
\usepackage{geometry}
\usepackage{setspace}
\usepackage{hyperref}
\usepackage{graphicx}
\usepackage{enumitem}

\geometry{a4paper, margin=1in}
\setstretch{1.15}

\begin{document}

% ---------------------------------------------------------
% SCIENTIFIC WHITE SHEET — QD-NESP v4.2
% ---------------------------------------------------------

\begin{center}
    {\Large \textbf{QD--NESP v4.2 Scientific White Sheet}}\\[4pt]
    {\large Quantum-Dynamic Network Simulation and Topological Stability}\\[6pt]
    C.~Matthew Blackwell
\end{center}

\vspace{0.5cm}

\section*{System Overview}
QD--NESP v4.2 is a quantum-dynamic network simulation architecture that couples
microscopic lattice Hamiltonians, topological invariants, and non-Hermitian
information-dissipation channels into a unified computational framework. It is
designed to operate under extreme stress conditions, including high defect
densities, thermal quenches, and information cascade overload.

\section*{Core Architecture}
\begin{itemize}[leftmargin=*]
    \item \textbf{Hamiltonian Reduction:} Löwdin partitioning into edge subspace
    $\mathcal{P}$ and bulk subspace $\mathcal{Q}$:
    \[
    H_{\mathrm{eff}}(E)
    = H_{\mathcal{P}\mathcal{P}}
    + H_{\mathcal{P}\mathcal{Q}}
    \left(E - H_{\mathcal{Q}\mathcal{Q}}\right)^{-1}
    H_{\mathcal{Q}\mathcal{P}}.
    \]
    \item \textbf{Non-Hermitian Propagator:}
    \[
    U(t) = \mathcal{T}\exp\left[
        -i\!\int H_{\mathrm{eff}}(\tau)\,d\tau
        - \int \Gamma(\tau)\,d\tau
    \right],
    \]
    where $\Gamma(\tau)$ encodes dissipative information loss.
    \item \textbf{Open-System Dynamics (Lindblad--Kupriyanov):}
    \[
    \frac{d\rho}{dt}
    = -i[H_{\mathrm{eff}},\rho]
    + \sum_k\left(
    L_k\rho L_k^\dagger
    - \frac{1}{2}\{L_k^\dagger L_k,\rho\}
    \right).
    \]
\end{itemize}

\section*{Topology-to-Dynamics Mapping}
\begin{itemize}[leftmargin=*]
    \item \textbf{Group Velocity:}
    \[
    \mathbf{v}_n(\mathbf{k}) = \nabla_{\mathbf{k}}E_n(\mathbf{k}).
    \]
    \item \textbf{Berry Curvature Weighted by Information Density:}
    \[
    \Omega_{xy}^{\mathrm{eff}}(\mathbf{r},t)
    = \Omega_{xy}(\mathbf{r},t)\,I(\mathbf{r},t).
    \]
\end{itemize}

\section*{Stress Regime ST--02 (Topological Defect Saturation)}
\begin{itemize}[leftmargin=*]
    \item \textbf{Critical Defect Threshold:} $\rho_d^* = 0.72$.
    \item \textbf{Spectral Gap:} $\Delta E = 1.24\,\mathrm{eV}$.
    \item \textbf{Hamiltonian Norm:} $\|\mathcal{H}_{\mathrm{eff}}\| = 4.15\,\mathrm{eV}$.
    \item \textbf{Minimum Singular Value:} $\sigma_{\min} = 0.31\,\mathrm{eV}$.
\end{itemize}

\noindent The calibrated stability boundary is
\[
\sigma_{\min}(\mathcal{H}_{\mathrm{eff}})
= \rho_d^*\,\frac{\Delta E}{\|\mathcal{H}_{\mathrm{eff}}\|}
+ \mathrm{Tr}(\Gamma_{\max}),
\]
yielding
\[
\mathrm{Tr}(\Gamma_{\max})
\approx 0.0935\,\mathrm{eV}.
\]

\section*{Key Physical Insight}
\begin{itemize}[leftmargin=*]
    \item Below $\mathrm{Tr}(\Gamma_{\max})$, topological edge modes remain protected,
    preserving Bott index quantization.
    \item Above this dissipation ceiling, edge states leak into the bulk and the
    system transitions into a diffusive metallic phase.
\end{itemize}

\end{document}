\section*{System Overview}
QD--NESP v4.2 is a quantum-dynamic network simulation architecture that couples
microscopic lattice Hamiltonians, topological invariants, and non-Hermitian
information-dissipation channels into a unified computational framework. It is
designed to operate under extreme stress conditions, including high defect
densities, thermal quenches, and information cascade overload.

\section*{Core Architecture}
\begin{itemize}[leftmargin=*]
    \item \textbf{Hamiltonian Reduction:} Löwdin partitioning into edge subspace
    $\mathcal{P}$ and bulk subspace $\mathcal{Q}$:
    \[
    H_{\mathrm{eff}}(E)
    = H_{\mathcal{P}\mathcal{P}}
    + H_{\mathcal{P}\mathcal{Q}}
    \left(E - H_{\mathcal{Q}\mathcal{Q}}\right)^{-1}
    H_{\mathcal{Q}\mathcal{P}}.
    \]
    \item \textbf{Non-Hermitian Propagator:}
    \[
    U(t) = \mathcal{T}\exp\left[
        -i\!\int H_{\mathrm{eff}}(\tau)\,d\tau
        - \int \Gamma(\tau)\,d\tau
    \right],
    \]
    where $\Gamma(\tau)$ encodes dissipative information loss.
    \item \textbf{Open-System Dynamics (Lindblad--Kupriyanov):}
    \[
    \frac{d\rho}{dt}
    = -i[H_{\mathrm{eff}},\rho]
    + \sum_k\left(
    L_k\rho L_k^\dagger
    - \frac{1}{2}\{L_k^\dagger L_k,\rho\}
    \right).
    \]
\end{itemize}

\section*{Topology-to-Dynamics Mapping}
