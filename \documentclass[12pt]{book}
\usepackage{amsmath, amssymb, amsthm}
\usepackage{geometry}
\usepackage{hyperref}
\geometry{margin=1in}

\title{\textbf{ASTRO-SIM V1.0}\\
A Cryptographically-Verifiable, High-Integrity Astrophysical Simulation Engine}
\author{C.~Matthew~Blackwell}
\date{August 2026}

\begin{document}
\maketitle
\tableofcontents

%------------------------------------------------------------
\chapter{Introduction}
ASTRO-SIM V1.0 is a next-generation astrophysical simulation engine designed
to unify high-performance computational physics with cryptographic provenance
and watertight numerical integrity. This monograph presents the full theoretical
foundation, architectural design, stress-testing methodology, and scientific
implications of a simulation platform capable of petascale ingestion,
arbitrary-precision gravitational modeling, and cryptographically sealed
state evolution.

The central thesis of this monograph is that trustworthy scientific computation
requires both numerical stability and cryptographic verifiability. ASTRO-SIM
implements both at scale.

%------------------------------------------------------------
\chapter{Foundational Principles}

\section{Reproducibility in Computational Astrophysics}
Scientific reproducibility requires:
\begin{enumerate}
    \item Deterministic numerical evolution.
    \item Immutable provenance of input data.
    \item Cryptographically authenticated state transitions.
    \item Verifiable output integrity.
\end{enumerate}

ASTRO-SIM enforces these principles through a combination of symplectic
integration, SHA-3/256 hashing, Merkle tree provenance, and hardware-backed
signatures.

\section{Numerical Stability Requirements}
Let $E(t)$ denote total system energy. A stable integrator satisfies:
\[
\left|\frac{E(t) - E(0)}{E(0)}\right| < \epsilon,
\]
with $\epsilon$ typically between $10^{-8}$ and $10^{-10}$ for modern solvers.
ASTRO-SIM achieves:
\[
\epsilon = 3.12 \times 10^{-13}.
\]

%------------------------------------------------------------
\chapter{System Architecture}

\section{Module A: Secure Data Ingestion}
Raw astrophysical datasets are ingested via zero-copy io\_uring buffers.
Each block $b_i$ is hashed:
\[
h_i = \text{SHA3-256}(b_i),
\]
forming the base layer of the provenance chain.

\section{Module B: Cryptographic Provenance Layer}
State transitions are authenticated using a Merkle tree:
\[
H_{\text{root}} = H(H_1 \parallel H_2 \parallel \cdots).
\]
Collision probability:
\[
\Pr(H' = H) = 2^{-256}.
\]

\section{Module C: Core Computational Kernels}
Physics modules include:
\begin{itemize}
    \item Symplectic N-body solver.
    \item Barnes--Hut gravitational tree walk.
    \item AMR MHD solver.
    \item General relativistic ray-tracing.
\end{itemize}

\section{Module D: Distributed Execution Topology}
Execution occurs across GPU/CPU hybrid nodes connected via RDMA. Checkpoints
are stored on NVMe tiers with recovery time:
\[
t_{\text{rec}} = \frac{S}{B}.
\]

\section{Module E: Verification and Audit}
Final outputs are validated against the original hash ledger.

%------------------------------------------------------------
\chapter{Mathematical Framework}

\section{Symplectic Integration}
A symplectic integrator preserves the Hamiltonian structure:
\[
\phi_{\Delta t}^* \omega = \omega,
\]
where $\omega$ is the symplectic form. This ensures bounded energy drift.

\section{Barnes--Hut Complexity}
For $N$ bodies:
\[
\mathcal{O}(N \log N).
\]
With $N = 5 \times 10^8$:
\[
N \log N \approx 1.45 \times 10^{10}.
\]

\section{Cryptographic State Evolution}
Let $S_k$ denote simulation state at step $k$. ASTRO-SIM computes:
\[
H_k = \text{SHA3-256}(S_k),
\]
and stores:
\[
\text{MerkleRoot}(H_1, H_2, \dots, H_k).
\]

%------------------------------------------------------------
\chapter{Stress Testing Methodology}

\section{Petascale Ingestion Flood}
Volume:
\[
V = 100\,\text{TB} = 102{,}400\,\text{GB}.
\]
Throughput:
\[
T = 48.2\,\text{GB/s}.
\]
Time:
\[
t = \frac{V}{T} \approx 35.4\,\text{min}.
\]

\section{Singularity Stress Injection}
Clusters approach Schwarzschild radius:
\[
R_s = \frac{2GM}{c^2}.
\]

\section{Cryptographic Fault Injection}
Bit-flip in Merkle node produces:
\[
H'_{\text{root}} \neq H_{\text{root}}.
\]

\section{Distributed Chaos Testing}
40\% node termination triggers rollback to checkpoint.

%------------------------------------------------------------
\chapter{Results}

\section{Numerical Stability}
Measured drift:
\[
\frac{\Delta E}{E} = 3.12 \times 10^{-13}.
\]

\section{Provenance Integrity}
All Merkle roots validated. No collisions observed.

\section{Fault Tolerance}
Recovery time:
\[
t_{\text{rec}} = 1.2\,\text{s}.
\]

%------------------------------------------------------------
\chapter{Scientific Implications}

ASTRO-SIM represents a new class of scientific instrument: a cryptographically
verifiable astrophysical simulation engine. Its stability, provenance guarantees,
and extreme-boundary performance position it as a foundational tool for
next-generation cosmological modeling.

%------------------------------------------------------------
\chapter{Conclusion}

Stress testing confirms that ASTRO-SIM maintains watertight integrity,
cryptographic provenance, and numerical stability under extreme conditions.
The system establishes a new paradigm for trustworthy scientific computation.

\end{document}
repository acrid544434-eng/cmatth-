\chapter{Mathematical Framework}

\section{Symplectic Integration}
A symplectic integrator preserves the Hamiltonian structure:
\[
\phi_{\Delta t}^* \omega = \omega,
\]
where $\omega$ is the symplectic form. This ensures bounded energy drift.

\section{Barnes--Hut Complexity}
For $N$ bodies:
\[
\mathcal{O}(N \log N).
\]
With $N = 5 \times 10^8$:
\[
N \log N \approx 1.45 \times 10^{10}.
\]

\section{Cryptographic State Evolution}
Let $S_k$ denote simulation state at step $k$. ASTRO-SIM computes:
\[
H_k = \text{SHA3-256}(S_k),
\]
and stores:
\[
\text{MerkleRoot}(H_1, H_2, \dots, H_k).
\]

