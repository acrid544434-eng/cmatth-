# control/colorlog.py

from typing import Dict, Any
from control.telemetry_server import TelemetryServer
from engine.schema import SchemaError


# Color protocol for dashboard rendering
COLOR_MAP = {
    "info": "cyan",
    "success": "green",
    "warning": "yellow",
    "error": "red",
    "critical": "magenta",
}


def build_log_event(
    message: str,
    level: str = "info",
    context: Dict[str, Any] | None = None,
) -> Dict[str, Any]:
    """
    Build a colorized log packet for the telemetry dashboard.
    """
    if level not in COLOR_MAP:
        level = "info"

    return {
        "event": "log",
        "level": level,
        "color": COLOR_MAP[level],
        "message": message,
        "context": context or {},
    }


class ColorLogger:
    """
    Sends colorized log packets to the telemetry server.
    """

    def __init__(self, telemetry: TelemetryServer):
        self.telemetry = telemetry

    def info(self, msg: str, **ctx):
        self.telemetry.broadcast(build_log_event(msg, "info", ctx))

    def success(self, msg: str, **ctx):
        self.telemetry.broadcast(build_log_event(msg, "success", ctx))

    def warning(self, msg: str, **ctx):
        self.telemetry.broadcast(build_log_event(msg, "warning", ctx))

    def error(self, msg: str, **ctx):
        self.telemetry.broadcast(build_log_event(msg, "error", ctx))

    def critical(self, msg: str, **ctx):
        self.telemetry.broadcast(build_log_event(msg, "critical", ctx))

    def validation_error(self, exc: SchemaError, **ctx):
        """
        Specialized hook for schema validation failures.
        """
        self.error(f"Validation failed: {exc}", **ctx)

🚀 How to integrate into your evolution loop

Inside evolve_population_parallel, after creating your telemetry server:

from control.colorlog import ColorLogger

telemetry = TelemetryServer(port=5055)
telemetry.start()

log = ColorLogger(telemetry)

Now you can emit colorized events anywhere:

Generation updates

log.info("Generation completed", generation=gen, best=population[0].fitness)

Successful checkpoint

log.success("Checkpoint saved", path=checkpoint_path)

Schema validation failure

