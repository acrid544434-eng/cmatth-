\chapter{Stability Theorems}

\section{Deterministic Output Invariance}

\begin{theorem}
Let the input state be defined by $(\bm{x}_0, n_{\text{eff}}, \sigma)$ and assume:
\begin{enumerate}
    \item All ray queues are compacted via atomic prefix-sum sorting.
    \item GPU and CPU paths agree within $|\Delta| < 10^{-7}$.
\end{enumerate}
Then the frame buffer output $F$ is bitwise deterministic.
\end{theorem}

\begin{proof}
Atomic compaction removes nondeterministic race conditions. The differential 
bound prevents divergent numerical evolution. Therefore the mapping from 
$(\bm{x}_0, n_{\text{eff}}, \sigma)$ to $F$ is unique.
\end{proof}

\section{Bounded Numerical Stability}

\begin{theorem}
If the Cash--Karp embedded pair enforces $\tau \le \epsilon = 10^{-6}$ and 
the Unified Stress Scalar satisfies $S < 1.0$, then:
\[
\|\Phi_{\text{num}} - \Phi_{\text{true}}\| \le C \epsilon.
\]
\end{theorem}

\begin{proof}
RK4 global error is bounded by a constant multiple of local error. The condition 
$S < 1.0$ ensures the solver remains within its stability envelope.
\end{proof}

