\section{Core Equations}

\subsection{Anomaly Tensor Update}
\[
A_{t+1} = H(A_t, X_{\text{clean}}) + R(A_t),
\]
where:
\begin{itemize}
    \item $H$ = heuristic exploration operator,
    \item $R$ = anomaly reflection operator.
\end{itemize}

\subsection{Manifold Optimization}
\[
\theta_{t+1} = \exp_{\theta_t}\big(-\eta \nabla_{\mathcal{M}} L(\theta_t)\big),
\]
with:
\begin{itemize}
    \item $\exp_{\theta_t}$ = exponential map on $\mathcal{M}$,
    \item $\nabla_{\mathcal{M}}$ = Riemannian gradient.
\end{itemize}

