\section{Definitions}

\begin{definition}[Anomaly Tensor]
$A(t)$ encodes deviations from expected curvature, entropy flow, or topological
structure.
\end{definition}

\begin{definition}[Heuristic Exploration Operator]
$H$ explores anomaly space using manifold-aware heuristics.
\end{definition}

\begin{definition}[Reflection Operator]
$R$ reflects anomaly behavior back into the intelligence loop for autonomous
self-correction.
\end{definition}

\begin{definition}[Parameter Manifold]
$\mathcal{M}$ is the geometric space on which SAIE-X performs optimization.
\end{definition}

