=
\left( \mathbf{I} - \frac{i\Delta t}{2}\mathbf{H}_{\text{eff}} \right)^{-1}
\left( \mathbf{I} + \frac{i\Delta t}{2}\mathbf{H}_{\text{eff}} \right)
\]

