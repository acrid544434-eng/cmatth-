\section{Spectral Stability Analysis}
\subsection{Gershgorin Bound}
\[
\lambda_{\max}(\mathbf{K}) 
\le 
\mathcal{V}_{\mathcal{X}_6}
\left( 1 + 4\pi^2\sigma^4\rho_{\text{grid}} \right)
\]

\subsection{Effective Hamiltonian Envelope}
\[
\lambda_{\max}(\mathbf{H}_{\text{eff}})
\le
\lambda_{\max}(\mathbf{H}_0)
+
\lambda_{\max}(\mathbf{S}^{\text{firewall}})
+
\lambda \lambda_{\max}(\mathbf{K})
\]

\section{Cayley Time Evolution Operator}
