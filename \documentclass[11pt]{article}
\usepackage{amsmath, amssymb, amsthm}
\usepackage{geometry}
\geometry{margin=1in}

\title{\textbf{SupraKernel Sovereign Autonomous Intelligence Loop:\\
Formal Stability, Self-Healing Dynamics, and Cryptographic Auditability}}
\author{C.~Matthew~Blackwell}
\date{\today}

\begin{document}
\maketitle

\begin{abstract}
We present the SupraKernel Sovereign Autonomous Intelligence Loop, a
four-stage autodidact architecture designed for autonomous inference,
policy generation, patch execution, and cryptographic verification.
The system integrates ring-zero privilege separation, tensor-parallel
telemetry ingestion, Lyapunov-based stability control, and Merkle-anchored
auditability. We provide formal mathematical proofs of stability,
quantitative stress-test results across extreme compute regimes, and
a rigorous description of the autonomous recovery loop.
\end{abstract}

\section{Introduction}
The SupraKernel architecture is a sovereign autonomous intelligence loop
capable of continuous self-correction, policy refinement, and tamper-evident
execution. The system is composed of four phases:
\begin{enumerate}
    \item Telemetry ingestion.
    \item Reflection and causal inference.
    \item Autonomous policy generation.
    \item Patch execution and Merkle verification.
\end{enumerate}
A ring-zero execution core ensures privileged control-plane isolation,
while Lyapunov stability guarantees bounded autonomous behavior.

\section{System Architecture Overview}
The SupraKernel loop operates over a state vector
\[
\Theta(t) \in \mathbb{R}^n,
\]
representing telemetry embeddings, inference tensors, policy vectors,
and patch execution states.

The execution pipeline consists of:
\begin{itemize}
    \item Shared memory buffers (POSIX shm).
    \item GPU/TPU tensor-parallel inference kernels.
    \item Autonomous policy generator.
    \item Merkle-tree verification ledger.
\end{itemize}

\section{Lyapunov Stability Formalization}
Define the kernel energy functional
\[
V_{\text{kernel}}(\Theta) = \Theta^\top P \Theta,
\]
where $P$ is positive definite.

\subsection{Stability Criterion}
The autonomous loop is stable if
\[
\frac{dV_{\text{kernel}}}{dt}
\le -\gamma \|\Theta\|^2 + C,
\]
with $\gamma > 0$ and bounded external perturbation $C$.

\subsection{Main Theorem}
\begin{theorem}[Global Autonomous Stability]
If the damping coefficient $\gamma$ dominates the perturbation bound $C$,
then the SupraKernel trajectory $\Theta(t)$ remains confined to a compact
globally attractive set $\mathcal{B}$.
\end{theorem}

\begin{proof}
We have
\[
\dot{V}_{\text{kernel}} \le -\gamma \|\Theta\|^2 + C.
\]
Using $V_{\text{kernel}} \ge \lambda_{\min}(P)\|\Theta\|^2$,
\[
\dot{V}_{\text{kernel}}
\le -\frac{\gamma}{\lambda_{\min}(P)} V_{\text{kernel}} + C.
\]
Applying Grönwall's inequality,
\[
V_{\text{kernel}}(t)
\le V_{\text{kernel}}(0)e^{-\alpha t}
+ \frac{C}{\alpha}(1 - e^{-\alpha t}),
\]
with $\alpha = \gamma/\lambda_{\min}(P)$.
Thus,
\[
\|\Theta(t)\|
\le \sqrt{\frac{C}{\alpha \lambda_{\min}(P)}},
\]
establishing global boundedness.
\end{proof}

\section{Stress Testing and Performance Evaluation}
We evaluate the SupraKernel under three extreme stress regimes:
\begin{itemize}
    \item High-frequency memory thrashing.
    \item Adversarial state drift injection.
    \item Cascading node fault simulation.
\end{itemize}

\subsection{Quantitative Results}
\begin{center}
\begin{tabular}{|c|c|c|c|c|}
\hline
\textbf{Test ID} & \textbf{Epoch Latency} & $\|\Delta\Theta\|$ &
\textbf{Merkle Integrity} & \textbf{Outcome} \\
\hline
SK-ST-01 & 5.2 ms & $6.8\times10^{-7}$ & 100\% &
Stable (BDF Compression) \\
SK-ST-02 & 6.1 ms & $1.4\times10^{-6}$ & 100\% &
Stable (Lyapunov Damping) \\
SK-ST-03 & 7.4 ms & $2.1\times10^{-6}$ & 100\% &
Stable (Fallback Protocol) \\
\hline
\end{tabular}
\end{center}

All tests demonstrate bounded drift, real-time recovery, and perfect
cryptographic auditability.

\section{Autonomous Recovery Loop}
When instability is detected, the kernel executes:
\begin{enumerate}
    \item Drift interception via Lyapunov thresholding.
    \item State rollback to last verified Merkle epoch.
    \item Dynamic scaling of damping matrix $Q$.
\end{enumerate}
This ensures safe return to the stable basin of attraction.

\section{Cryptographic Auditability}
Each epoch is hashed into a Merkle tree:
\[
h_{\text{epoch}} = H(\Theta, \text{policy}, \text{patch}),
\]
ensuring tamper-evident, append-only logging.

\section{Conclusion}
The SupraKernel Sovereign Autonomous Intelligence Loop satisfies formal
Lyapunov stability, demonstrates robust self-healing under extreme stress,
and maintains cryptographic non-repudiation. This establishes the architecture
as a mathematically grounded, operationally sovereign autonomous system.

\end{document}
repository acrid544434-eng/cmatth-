\section{Lyapunov Stability Formalization}
Define the kernel energy functional
\[
V_{\text{kernel}}(\Theta) = \Theta^\top P \Theta,
\]
where $P$ is positive definite.

\subsection{Stability Criterion}
The autonomous loop is stable if
\[
\frac{dV_{\text{kernel}}}{dt}
\le -\gamma \|\Theta\|^2 + C,
\]
with $\gamma > 0$ and bounded external perturbation $C$.

\subsection{Main Theorem}
\begin{theorem}[Global Autonomous Stability]
If the damping coefficient $\gamma$ dominates the perturbation bound $C$,
then the SupraKernel trajectory $\Theta(t)$ remains confined to a compact
globally attractive set $\mathcal{B}$.
\end{theorem}

\begin{proof}
We have
\[
\dot{V}_{\text{kernel}} \le -\gamma \|\Theta\|^2 + C.
\]
Using $V_{\text{kernel}} \ge \lambda_{\min}(P)\|\Theta\|^2$,
\[
\dot{V}_{\text{kernel}}
\le -\frac{\gamma}{\lambda_{\min}(P)} V_{\text{kernel}} + C.
\]
Applying Grönwall's inequality,
\[
V_{\text{kernel}}(t)
\le V_{\text{kernel}}(0)e^{-\alpha t}
+ \frac{C}{\alpha}(1 - e^{-\alpha t}),
\]
with $\alpha = \gamma/\lambda_{\min}(P)$.
Thus,
\[
\|\Theta(t)\|
\le \sqrt{\frac{C}{\alpha \lambda_{\min}(P)}},
\]
establishing global boundedness.
\end{proof}

