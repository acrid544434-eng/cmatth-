\subsection{Hamiltonian Gradient}
\[
\nabla H = \left(
\frac{\partial H}{\partial q_{bio}},
\frac{\partial H}{\partial p_{bio}},
\frac{\partial H}{\partial q_{astro}},
\frac{\partial H}{\partial p_{astro}}
\right).
\]

\subsection{Divergence Sampling}
Chaotic trajectories sampled at discrete time steps $\Delta t$:
\[
\{x(t_0), x(t_1), \dots, x(t_n)\}.
