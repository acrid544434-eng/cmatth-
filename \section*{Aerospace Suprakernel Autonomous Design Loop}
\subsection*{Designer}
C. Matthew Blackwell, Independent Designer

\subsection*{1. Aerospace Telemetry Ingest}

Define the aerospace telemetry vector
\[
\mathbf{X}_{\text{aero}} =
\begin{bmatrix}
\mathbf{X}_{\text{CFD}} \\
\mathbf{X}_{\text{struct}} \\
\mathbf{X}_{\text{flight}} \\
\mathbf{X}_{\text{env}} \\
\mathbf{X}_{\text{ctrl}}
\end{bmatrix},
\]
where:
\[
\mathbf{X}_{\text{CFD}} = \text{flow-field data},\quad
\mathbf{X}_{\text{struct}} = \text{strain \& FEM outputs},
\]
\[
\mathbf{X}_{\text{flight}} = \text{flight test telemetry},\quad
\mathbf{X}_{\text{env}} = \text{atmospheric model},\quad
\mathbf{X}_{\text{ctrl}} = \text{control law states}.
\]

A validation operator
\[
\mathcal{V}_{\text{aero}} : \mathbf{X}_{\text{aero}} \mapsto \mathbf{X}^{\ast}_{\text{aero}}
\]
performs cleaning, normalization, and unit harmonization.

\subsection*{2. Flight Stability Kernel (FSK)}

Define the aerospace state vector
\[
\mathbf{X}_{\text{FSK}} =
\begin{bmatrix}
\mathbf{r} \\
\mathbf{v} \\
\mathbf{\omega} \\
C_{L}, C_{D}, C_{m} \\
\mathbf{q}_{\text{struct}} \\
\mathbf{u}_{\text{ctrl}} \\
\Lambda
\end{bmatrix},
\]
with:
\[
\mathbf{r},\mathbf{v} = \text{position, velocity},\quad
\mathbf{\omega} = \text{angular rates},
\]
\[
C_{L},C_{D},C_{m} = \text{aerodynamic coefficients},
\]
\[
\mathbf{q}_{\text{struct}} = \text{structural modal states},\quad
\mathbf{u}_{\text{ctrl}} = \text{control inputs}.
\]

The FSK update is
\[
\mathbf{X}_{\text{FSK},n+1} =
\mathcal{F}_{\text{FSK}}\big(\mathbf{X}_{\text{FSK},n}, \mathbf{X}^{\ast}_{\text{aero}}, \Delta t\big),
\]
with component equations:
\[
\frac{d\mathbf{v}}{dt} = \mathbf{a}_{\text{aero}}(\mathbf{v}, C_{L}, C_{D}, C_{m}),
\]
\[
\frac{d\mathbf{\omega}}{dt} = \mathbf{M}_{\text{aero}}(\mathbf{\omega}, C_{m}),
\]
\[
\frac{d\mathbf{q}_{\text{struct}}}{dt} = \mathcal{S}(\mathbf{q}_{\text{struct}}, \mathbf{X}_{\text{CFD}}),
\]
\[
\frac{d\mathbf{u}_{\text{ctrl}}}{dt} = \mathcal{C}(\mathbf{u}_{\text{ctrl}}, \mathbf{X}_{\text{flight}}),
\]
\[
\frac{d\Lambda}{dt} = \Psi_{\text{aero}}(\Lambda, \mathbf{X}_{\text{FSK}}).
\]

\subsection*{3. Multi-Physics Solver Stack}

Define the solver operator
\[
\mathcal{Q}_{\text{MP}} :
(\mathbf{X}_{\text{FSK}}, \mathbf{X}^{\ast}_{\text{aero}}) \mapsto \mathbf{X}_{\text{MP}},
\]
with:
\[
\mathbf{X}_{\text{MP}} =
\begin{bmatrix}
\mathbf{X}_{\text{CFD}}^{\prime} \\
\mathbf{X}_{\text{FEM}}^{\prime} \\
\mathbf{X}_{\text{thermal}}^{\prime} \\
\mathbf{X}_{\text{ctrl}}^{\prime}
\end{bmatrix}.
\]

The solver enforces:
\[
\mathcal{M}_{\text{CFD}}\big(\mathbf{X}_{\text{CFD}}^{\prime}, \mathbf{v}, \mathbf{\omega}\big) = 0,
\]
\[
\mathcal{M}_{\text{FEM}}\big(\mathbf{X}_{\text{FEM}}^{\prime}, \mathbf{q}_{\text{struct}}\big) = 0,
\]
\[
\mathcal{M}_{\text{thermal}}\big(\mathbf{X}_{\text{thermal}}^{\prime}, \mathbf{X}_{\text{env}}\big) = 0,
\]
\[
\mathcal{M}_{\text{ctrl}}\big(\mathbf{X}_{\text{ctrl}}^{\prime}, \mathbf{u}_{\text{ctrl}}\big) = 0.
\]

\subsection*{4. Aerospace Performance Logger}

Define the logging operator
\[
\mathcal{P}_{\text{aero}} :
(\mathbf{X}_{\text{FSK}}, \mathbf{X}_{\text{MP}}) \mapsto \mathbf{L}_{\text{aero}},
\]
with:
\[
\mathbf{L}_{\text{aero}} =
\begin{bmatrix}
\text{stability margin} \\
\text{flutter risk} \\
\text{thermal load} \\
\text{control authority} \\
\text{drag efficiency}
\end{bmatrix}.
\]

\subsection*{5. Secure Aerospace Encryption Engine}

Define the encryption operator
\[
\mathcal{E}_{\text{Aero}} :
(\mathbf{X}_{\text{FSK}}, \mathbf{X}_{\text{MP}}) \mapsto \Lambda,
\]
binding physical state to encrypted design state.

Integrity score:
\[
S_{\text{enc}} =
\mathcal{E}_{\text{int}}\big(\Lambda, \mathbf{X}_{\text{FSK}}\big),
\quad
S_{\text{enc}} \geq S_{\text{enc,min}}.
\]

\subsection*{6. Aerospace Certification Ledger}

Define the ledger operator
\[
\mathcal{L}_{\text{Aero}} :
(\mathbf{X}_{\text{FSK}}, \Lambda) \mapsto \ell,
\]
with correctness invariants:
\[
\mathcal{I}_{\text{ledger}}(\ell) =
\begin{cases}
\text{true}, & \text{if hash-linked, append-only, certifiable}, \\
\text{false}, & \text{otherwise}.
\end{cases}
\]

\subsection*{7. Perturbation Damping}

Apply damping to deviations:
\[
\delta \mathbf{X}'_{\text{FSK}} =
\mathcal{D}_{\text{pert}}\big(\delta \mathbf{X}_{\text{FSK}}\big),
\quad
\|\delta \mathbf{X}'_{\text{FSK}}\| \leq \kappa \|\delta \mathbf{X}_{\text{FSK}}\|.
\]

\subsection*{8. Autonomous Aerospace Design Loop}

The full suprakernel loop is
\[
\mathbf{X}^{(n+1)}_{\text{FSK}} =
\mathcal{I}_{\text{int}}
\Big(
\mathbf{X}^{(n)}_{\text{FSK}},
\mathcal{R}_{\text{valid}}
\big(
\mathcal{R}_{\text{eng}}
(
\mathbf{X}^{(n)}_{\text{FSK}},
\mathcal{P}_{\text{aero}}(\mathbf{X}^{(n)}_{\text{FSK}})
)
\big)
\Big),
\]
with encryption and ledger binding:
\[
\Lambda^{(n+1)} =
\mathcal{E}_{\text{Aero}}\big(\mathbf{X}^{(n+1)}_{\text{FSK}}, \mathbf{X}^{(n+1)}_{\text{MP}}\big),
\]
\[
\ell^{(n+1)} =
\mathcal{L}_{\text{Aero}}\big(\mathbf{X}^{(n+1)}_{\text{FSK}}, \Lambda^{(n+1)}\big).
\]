\subsection*{2. Flight Stability Kernel (FSK)}

Define the aerospace state vector
\[
\mathbf{X}_{\text{FSK}} =
\begin{bmatrix}
\mathbf{r} \\
\mathbf{v} \\
\mathbf{\omega} \\
C_{L}, C_{D}, C_{m} \\
\mathbf{q}_{\text{struct}} \\
\mathbf{u}_{\text{ctrl}} \\
\Lambda
\end{bmatrix},
\]
with:
\[
\mathbf{r},\mathbf{v} = \text{position, velocity},\quad
\mathbf{\omega} = \text{angular rates},
\]
\[
C_{L},C_{D},C_{m} = \text{aerodynamic coefficients},
\]
\[
\mathbf{q}_{\text{struct}} = \text{structural modal states},\quad
\mathbf{u}_{\text{ctrl}} = \text{control inputs}.
\]

The FSK update is
\[
\mathbf{X}_{\text{FSK},n+1} =
\mathcal{F}_{\text{FSK}}\big(\mathbf{X}_{\text{FSK},n}, \mathbf{X}^{\ast}_{\text{aero}}, \Delta t\big),
\]
with component equations:
\[
\frac{d\mathbf{v}}{dt} = \mathbf{a}_{\text{aero}}(\mathbf{v}, C_{L}, C_{D}, C_{m}),
\]
\[
\frac{d\mathbf{\omega}}{dt} = \mathbf{M}_{\text{aero}}(\mathbf{\omega}, C_{m}),
\]
\[
\frac{d\mathbf{q}_{\text{struct}}}{dt} = \mathcal{S}(\mathbf{q}_{\text{struct}}, \mathbf{X}_{\text{CFD}}),
\]
\[
\frac{d\mathbf{u}_{\text{ctrl}}}{dt} = \mathcal{C}(\mathbf{u}_{\text{ctrl}}, \mathbf{X}_{\text{flight}}),
\]
\[
\frac{d\Lambda}{dt} = \Psi_{\text{aero}}(\Lambda, \mathbf{X}_{\text{FSK}}).
\]

\subsection*{3. Multi-Physics Solver Stack}

Define the solver operator
\[
\mathcal{Q}_{\text{MP}} :
(\mathbf{X}_{\text{FSK}}, \mathbf{X}^{\ast}_{\text{aero}}) \mapsto \mathbf{X}_{\text{MP}},
\]
with:
\[
\mathbf{X}_{\text{MP}} =
\begin{bmatrix}
\mathbf{X}_{\text{CFD}}^{\prime} \\
\mathbf{X}_{\text{FEM}}^{\prime} \\
\mathbf{X}_{\text{thermal}}^{\prime} \\
\mathbf{X}_{\text{ctrl}}^{\prime}
\end{bmatrix}.
\]

The solver enforces:
\[
\mathcal{M}_{\text{CFD}}\big(\mathbf{X}_{\text{CFD}}^{\prime}, \mathbf{v}, \mathbf{\omega}\big) = 0,
\]
\[
\mathcal{M}_{\text{FEM}}\big(\mathbf{X}_{\text{FEM}}^{\prime}, \mathbf{q}_{\text{struct}}\big) = 0,
\]
\[
\mathcal{M}_{\text{thermal}}\big(\mathbf{X}_{\text{thermal}}^{\prime}, \mathbf{X}_{\text{env}}\big) = 0,
\]
\[
\mathcal{M}_{\text{ctrl}}\big(\mathbf{X}_{\text{ctrl}}^{\prime}, \mathbf{u}_{\text{ctrl}}\big) = 0.
\]

