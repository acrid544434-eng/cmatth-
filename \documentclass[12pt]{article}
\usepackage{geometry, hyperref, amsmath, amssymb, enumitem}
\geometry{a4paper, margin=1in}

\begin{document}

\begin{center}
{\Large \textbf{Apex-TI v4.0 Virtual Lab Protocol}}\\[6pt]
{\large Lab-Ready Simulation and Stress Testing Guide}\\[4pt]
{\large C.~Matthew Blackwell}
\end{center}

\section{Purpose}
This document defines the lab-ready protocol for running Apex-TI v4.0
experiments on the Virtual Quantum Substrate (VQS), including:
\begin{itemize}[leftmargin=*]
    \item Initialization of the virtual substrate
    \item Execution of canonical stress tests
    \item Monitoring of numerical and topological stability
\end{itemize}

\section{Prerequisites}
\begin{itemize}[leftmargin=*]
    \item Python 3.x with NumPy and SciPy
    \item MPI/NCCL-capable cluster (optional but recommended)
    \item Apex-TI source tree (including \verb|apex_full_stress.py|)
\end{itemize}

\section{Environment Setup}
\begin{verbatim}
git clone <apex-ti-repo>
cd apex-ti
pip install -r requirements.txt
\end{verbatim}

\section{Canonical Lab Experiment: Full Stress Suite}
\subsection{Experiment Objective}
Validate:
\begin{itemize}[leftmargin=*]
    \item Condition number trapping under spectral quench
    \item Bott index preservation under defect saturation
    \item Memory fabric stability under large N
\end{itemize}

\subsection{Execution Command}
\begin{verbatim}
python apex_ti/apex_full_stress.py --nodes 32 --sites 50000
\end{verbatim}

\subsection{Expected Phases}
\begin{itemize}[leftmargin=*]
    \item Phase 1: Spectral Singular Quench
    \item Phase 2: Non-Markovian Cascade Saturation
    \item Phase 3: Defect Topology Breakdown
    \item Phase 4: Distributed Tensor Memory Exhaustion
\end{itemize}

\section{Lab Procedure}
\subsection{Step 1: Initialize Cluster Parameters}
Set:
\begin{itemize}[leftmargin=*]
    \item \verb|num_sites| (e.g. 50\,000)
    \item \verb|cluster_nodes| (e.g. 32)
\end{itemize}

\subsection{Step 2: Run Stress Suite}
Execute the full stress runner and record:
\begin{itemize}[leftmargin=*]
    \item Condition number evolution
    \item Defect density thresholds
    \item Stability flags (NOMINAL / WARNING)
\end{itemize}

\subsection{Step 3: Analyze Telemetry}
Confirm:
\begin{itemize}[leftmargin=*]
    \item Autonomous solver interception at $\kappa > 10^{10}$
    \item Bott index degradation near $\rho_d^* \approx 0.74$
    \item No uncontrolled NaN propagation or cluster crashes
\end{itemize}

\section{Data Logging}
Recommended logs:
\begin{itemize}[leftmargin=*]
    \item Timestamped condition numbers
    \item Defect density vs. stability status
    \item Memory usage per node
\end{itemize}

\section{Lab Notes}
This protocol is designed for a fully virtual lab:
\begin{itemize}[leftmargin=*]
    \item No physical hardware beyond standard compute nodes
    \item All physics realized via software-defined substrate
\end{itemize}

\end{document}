\section{Prerequisites}
\begin{itemize}[leftmargin=*]
    \item Python 3.x with NumPy and SciPy
    \item MPI/NCCL-capable cluster (optional but recommended)
    \item Apex-TI source tree (including \verb|apex_full_stress.py|)
