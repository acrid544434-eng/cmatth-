\section{Distributed Execution: Formal Guarantees}

\subsection{Definition}
Let $S_k$ be distributed across nodes $n_1, \dots, n_m$.
Let $C_j$ be stored on NVMe tier.

\subsection{Lemma}
Recovery time:
\[
t_{\text{rec}} = \frac{S}{B},
\]
where $S$ is checkpoint size and $B$ NVMe throughput.

\subsection{ASTRO-SIM Result}
\[
t_{\text{rec}} = 1.2\,\text{s}.
\]

