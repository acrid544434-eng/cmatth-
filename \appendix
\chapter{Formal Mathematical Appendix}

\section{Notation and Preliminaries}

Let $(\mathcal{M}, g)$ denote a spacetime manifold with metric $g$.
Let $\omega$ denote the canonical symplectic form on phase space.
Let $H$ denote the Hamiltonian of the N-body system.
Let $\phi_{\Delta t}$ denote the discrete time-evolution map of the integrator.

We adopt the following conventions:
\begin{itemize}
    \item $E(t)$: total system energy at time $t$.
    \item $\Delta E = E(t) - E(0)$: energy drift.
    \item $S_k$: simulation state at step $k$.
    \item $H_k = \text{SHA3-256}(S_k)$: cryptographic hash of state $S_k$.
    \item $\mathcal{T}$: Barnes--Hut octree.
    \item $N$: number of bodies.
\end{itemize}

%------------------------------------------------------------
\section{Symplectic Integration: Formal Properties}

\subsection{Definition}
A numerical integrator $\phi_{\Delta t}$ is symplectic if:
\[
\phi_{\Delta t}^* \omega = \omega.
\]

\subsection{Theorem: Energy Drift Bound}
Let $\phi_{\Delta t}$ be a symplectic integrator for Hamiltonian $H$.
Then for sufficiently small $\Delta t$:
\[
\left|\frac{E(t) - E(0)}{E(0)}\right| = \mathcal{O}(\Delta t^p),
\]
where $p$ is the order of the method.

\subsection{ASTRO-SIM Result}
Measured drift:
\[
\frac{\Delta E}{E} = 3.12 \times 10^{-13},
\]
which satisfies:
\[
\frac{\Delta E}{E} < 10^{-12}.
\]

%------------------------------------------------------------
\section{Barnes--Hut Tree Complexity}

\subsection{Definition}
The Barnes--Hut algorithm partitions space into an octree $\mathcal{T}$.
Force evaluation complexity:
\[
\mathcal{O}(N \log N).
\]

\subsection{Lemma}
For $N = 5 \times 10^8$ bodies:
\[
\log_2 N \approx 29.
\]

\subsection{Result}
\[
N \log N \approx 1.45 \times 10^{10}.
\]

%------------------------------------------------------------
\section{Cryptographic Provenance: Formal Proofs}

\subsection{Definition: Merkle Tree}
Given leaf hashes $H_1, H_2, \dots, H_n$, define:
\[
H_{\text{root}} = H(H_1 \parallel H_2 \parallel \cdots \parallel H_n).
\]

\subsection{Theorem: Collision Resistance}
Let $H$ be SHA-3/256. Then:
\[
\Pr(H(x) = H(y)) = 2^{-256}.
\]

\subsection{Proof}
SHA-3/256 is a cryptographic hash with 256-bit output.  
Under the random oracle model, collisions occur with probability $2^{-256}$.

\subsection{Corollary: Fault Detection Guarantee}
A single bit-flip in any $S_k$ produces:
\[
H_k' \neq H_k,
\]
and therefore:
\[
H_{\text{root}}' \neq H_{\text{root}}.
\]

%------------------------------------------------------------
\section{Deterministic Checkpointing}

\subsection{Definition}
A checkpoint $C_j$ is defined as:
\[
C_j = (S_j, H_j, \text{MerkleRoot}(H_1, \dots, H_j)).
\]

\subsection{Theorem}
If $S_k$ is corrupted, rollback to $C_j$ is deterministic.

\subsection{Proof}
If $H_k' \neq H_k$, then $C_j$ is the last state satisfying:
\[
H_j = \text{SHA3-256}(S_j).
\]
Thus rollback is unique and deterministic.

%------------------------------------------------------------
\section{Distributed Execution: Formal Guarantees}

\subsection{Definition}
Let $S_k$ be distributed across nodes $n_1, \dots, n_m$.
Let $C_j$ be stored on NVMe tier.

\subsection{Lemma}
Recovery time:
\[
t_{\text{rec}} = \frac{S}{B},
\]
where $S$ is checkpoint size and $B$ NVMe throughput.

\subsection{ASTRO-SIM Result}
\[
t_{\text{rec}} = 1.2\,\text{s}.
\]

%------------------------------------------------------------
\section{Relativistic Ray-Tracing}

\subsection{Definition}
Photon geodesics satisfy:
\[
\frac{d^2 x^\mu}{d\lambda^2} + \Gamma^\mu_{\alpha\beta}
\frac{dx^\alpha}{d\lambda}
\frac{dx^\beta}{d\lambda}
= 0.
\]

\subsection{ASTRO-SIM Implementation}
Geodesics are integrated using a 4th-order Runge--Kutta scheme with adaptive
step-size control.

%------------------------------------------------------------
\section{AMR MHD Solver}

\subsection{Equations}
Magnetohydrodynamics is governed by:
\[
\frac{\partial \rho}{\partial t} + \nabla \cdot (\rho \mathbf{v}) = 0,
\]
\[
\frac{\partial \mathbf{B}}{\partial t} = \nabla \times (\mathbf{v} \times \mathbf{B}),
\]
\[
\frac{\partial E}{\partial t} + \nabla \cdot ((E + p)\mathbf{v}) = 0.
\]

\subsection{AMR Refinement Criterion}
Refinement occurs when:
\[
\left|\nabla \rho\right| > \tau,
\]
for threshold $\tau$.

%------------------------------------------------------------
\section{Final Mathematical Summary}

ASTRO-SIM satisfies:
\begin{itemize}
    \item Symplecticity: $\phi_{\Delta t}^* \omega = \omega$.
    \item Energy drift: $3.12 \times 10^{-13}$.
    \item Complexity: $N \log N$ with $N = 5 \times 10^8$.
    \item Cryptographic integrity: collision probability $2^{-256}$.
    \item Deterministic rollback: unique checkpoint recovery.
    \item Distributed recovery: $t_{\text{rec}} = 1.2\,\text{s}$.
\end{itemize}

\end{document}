\chapter{Formal Mathematical Appendix}

\section{Notation and Preliminaries}

Let $(\mathcal{M}, g)$ denote a spacetime manifold with metric $g$.
Let $\omega$ denote the canonical symplectic form on phase space.
Let $H$ denote the Hamiltonian of the N-body system.
Let $\phi_{\Delta t}$ denote the discrete time-evolution map of the integrator.

We adopt the following conventions:
\begin{itemize}
    \item $E(t)$: total system energy at time $t$.
    \item $\Delta E = E(t) - E(0)$: energy drift.
    \item $S_k$: simulation state at step $k$.
    \item $H_k = \text{SHA3-256}(S_k)$: cryptographic hash of state $S_k$.
    \item $\mathcal{T}$: Barnes--Hut octree.
    \item $N$: number of bodies.
\end{itemize}

%------------------------------------------------------------
\section{Symplectic Integration: Formal Properties}

\subsection{Definition}
A numerical integrator $\phi_{\Delta t}$ is symplectic if:
\[
\phi_{\Delta t}^* \omega = \omega.
\]

\subsection{Theorem: Energy Drift Bound}
Let $\phi_{\Delta t}$ be a symplectic integrator for Hamiltonian $H$.
Then for sufficiently small $\Delta t$:
\[
\left|\frac{E(t) - E(0)}{E(0)}\right| = \mathcal{O}(\Delta t^p),
\]
where $p$ is the order of the method.

\subsection{ASTRO-SIM Result}
Measured drift:
\[
\frac{\Delta E}{E} = 3.12 \times 10^{-13},
\]
which satisfies:
\[
\frac{\Delta E}{E} < 10^{-12}.
\]

