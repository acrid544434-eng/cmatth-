\section{Cryptographic Provenance: Formal Proofs}

\subsection{Definition: Merkle Tree}
Given leaf hashes $H_1, H_2, \dots, H_n$, define:
\[
H_{\text{root}} = H(H_1 \parallel H_2 \parallel \cdots \parallel H_n).
\]

\subsection{Theorem: Collision Resistance}
Let $H$ be SHA-3/256. Then:
\[
\Pr(H(x) = H(y)) = 2^{-256}.
\]

\subsection{Proof}
SHA-3/256 is a cryptographic hash with 256-bit output.  
Under the random oracle model, collisions occur with probability $2^{-256}$.

\subsection{Corollary: Fault Detection Guarantee}
A single bit-flip in any $S_k$ produces:
\[
H_k' \neq H_k,
\]
and therefore:
\[
H_{\text{root}}' \neq H_{\text{root}}.
\]

%------------------------------------------------------------
\section{Deterministic Checkpointing}

\subsection{Definition}
A checkpoint $C_j$ is defined as:
\[
C_j = (S_j, H_j, \text{MerkleRoot}(H_1, \dots, H_j)).
\]

\subsection{Theorem}
If $S_k$ is corrupted, rollback to $C_j$ is deterministic.

\subsection{Proof}
If $H_k' \neq H_k$, then $C_j$ is the last state satisfying:
\[
H_j = \text{SHA3-256}(S_j).
\]
Thus rollback is unique and deterministic.

