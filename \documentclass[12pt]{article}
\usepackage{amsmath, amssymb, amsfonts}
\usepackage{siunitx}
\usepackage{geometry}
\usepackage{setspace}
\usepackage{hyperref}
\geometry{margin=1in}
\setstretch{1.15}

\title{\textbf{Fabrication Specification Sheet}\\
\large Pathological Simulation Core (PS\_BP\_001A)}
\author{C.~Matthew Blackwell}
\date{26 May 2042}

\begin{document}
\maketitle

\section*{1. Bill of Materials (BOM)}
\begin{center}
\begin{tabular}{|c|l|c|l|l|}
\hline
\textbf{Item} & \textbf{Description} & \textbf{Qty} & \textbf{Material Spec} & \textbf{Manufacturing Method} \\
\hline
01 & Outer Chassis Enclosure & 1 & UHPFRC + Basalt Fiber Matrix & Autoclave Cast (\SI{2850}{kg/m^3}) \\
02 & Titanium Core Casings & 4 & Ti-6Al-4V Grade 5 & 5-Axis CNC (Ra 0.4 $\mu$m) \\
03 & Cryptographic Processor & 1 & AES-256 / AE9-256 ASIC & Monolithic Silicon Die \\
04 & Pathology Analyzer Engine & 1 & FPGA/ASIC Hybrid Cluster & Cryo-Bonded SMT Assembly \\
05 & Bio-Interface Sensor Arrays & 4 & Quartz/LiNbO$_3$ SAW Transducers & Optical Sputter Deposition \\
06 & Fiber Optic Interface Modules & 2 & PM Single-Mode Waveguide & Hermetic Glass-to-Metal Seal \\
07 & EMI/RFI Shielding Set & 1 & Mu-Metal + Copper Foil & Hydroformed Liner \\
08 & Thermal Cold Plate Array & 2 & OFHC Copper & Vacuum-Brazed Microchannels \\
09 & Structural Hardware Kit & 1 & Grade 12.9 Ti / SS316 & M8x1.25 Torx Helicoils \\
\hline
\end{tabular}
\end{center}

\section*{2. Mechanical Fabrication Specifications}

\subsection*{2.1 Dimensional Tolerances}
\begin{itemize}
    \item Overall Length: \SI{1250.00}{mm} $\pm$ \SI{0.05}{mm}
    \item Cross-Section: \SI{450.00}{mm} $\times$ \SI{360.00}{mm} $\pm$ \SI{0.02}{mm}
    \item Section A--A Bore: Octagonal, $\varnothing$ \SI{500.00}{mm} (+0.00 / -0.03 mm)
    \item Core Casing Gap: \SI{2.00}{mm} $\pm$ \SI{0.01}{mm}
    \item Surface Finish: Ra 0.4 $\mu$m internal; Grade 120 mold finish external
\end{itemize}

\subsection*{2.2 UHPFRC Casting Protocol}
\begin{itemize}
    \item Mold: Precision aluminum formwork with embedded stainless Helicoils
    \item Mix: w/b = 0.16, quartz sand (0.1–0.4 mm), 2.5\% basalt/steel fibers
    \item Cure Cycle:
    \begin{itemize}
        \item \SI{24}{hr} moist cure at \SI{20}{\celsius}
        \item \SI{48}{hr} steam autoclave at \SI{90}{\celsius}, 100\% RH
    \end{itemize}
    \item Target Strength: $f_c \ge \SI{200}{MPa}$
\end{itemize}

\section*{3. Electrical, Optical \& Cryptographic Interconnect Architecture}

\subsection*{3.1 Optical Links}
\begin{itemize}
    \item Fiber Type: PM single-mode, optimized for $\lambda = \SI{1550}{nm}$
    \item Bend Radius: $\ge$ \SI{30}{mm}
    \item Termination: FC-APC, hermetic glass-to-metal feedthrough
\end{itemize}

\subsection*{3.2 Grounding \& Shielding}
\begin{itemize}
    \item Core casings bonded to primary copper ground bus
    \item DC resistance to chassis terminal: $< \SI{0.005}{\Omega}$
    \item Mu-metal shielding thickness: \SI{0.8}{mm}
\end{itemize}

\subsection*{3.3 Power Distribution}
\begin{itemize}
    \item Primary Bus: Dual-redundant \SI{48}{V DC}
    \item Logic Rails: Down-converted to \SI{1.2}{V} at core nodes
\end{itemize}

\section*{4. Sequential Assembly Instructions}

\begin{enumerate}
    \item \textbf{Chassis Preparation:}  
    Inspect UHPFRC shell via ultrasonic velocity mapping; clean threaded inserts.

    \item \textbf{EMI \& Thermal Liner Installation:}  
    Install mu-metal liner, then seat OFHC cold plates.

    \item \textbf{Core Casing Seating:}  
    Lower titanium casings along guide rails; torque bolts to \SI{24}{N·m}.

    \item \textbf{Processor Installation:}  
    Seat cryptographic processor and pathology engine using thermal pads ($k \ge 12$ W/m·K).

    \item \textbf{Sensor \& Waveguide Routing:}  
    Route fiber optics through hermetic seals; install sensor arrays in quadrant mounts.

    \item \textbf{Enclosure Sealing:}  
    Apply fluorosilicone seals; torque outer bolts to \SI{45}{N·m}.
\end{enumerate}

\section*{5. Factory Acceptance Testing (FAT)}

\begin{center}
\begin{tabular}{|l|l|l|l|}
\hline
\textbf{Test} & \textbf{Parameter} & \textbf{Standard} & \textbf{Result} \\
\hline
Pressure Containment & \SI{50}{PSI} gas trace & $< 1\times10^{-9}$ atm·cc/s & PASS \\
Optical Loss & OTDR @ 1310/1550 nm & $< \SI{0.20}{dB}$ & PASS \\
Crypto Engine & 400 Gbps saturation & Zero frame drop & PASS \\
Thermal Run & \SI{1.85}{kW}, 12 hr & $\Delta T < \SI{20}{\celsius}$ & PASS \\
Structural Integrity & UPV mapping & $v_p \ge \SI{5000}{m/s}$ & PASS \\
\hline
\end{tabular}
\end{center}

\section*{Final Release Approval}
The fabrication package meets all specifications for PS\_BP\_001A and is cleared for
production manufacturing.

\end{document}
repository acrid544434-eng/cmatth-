\section*{2. Mechanical Fabrication Specifications}

\subsection*{2.1 Dimensional Tolerances}
\begin{itemize}
    \item Overall Length: \SI{1250.00}{mm} $\pm$ \SI{0.05}{mm}
    \item Cross-Section: \SI{450.00}{mm} $\times$ \SI{360.00}{mm} $\pm$ \SI{0.02}{mm}
    \item Section A--A Bore: Octagonal, $\varnothing$ \SI{500.00}{mm} (+0.00 / -0.03 mm)
    \item Core Casing Gap: \SI{2.00}{mm} $\pm$ \SI{0.01}{mm}
    \item Surface Finish: Ra 0.4 $\mu$m internal; Grade 120 mold finish external
\end{itemize}

\subsection*{2.2 UHPFRC Casting Protocol}
\begin{itemize}
    \item Mold: Precision aluminum formwork with embedded stainless Helicoils
    \item Mix: w/b = 0.16, quartz sand (0.1–0.4 mm), 2.5\% basalt/steel fibers
    \item Cure Cycle:
    \begin{itemize}
        \item \SI{24}{hr} moist cure at \SI{20}{\celsius}
        \item \SI{48}{hr} steam autoclave at \SI{90}{\celsius}, 100\% RH
    \end{itemize}
    \item Target Strength: $f_c \ge \SI{200}{MPa}$
\end{itemize}

\section*{3. Electrical, Optical \& Cryptographic Interconnect Architecture}

\subsection*{3.1 Optical Links}
\begin{itemize}
    \item Fiber Type: PM single-mode, optimized for $\lambda = \SI{1550}{nm}$
    \item Bend Radius: $\ge$ \SI{30}{mm}
    \item Termination: FC-APC, hermetic glass-to-metal feedthrough
\end{itemize}

\subsection*{3.2 Grounding \& Shielding}
\begin{itemize}
    \item Core casings bonded to primary copper ground bus
    \item DC resistance to chassis terminal: $< \SI{0.005}{\Omega}$
    \item Mu-metal shielding thickness: \SI{0.8}{mm}
\end{itemize}

\subsection*{3.3 Power Distribution}
\begin{itemize}
    \item Primary Bus: Dual-redundant \SI{48}{V DC}
    \item Logic Rails: Down-converted to \SI{1.2}{V} at core nodes
\end{itemize}

\section*{4. Sequential Assembly Instructions}

\begin{enumerate}
    \item \textbf{Chassis Preparation:}  
    Inspect UHPFRC shell via ultrasonic velocity mapping; clean threaded inserts.

    \item \textbf{EMI \& Thermal Liner Installation:}  
    Install mu-metal liner, then seat OFHC cold plates.

    \item \textbf{Core Casing Seating:}  
    Lower titanium casings along guide rails; torque bolts to \SI{24}{N·m}.

    \item \textbf{Processor Installation:}  
    Seat cryptographic processor and pathology engine using thermal pads ($k \ge 12$ W/m·K).

    \item \textbf{Sensor \& Waveguide Routing:}  
    Route fiber optics through hermetic seals; install sensor arrays in quadrant mounts.

    \item \textbf{Enclosure Sealing:}  
    Apply fluorosilicone seals; torque outer bolts to \SI{45}{N·m}.
\end{enumerate}

