\chapter{PDE Solver Architecture: WENO-5 and TVD-RK3}

\section{Total Variation and Stability}
For a 1D discretization $\mathbf{U}_i$, the total variation is
\begin{equation}
    \operatorname{TV}(\mathbf{U}) = \sum_i \big\|\mathbf{U}_{i+1} - \mathbf{U}_i\big\|.
\end{equation}
A WENO-5 reconstruction operator $\mathcal{R}_{\text{WENO}}$ is designed to satisfy
\begin{equation}
    \operatorname{TV}\big(\mathcal{R}_{\text{WENO}}(\mathbf{U}^n)\big)
    \le \operatorname{TV}(\mathbf{U}^n),
\end{equation}
and the TVD-RK3 update enforces
\begin{equation}
    \operatorname{TV}(\mathbf{U}^{n+1}) \le \operatorname{TV}(\mathbf{U}^n).
\end{equation}

\section{Temporal Integration Error Bounds}
For the semi-discrete system
\begin{equation}
    \frac{d\mathbf{U}}{dt} = \mathcal{L}(\mathbf{U}),
\end{equation}
the third-order Runge--Kutta scheme yields
\begin{equation}
    \big\|\mathbf{U}(t_n) - \mathbf{U}^n\big\|_2 \le C\Delta t^3,
\end{equation}
for some constant $C$ independent of $\Delta t$. Thus the density field
$\rho(\mathbf{r},t)$ remains free of artificial energy growth, and
\begin{equation}
    n(\mathbf{r},t) = 1 + K\rho(\mathbf{r},t)
\end{equation}
inherits this stability.

