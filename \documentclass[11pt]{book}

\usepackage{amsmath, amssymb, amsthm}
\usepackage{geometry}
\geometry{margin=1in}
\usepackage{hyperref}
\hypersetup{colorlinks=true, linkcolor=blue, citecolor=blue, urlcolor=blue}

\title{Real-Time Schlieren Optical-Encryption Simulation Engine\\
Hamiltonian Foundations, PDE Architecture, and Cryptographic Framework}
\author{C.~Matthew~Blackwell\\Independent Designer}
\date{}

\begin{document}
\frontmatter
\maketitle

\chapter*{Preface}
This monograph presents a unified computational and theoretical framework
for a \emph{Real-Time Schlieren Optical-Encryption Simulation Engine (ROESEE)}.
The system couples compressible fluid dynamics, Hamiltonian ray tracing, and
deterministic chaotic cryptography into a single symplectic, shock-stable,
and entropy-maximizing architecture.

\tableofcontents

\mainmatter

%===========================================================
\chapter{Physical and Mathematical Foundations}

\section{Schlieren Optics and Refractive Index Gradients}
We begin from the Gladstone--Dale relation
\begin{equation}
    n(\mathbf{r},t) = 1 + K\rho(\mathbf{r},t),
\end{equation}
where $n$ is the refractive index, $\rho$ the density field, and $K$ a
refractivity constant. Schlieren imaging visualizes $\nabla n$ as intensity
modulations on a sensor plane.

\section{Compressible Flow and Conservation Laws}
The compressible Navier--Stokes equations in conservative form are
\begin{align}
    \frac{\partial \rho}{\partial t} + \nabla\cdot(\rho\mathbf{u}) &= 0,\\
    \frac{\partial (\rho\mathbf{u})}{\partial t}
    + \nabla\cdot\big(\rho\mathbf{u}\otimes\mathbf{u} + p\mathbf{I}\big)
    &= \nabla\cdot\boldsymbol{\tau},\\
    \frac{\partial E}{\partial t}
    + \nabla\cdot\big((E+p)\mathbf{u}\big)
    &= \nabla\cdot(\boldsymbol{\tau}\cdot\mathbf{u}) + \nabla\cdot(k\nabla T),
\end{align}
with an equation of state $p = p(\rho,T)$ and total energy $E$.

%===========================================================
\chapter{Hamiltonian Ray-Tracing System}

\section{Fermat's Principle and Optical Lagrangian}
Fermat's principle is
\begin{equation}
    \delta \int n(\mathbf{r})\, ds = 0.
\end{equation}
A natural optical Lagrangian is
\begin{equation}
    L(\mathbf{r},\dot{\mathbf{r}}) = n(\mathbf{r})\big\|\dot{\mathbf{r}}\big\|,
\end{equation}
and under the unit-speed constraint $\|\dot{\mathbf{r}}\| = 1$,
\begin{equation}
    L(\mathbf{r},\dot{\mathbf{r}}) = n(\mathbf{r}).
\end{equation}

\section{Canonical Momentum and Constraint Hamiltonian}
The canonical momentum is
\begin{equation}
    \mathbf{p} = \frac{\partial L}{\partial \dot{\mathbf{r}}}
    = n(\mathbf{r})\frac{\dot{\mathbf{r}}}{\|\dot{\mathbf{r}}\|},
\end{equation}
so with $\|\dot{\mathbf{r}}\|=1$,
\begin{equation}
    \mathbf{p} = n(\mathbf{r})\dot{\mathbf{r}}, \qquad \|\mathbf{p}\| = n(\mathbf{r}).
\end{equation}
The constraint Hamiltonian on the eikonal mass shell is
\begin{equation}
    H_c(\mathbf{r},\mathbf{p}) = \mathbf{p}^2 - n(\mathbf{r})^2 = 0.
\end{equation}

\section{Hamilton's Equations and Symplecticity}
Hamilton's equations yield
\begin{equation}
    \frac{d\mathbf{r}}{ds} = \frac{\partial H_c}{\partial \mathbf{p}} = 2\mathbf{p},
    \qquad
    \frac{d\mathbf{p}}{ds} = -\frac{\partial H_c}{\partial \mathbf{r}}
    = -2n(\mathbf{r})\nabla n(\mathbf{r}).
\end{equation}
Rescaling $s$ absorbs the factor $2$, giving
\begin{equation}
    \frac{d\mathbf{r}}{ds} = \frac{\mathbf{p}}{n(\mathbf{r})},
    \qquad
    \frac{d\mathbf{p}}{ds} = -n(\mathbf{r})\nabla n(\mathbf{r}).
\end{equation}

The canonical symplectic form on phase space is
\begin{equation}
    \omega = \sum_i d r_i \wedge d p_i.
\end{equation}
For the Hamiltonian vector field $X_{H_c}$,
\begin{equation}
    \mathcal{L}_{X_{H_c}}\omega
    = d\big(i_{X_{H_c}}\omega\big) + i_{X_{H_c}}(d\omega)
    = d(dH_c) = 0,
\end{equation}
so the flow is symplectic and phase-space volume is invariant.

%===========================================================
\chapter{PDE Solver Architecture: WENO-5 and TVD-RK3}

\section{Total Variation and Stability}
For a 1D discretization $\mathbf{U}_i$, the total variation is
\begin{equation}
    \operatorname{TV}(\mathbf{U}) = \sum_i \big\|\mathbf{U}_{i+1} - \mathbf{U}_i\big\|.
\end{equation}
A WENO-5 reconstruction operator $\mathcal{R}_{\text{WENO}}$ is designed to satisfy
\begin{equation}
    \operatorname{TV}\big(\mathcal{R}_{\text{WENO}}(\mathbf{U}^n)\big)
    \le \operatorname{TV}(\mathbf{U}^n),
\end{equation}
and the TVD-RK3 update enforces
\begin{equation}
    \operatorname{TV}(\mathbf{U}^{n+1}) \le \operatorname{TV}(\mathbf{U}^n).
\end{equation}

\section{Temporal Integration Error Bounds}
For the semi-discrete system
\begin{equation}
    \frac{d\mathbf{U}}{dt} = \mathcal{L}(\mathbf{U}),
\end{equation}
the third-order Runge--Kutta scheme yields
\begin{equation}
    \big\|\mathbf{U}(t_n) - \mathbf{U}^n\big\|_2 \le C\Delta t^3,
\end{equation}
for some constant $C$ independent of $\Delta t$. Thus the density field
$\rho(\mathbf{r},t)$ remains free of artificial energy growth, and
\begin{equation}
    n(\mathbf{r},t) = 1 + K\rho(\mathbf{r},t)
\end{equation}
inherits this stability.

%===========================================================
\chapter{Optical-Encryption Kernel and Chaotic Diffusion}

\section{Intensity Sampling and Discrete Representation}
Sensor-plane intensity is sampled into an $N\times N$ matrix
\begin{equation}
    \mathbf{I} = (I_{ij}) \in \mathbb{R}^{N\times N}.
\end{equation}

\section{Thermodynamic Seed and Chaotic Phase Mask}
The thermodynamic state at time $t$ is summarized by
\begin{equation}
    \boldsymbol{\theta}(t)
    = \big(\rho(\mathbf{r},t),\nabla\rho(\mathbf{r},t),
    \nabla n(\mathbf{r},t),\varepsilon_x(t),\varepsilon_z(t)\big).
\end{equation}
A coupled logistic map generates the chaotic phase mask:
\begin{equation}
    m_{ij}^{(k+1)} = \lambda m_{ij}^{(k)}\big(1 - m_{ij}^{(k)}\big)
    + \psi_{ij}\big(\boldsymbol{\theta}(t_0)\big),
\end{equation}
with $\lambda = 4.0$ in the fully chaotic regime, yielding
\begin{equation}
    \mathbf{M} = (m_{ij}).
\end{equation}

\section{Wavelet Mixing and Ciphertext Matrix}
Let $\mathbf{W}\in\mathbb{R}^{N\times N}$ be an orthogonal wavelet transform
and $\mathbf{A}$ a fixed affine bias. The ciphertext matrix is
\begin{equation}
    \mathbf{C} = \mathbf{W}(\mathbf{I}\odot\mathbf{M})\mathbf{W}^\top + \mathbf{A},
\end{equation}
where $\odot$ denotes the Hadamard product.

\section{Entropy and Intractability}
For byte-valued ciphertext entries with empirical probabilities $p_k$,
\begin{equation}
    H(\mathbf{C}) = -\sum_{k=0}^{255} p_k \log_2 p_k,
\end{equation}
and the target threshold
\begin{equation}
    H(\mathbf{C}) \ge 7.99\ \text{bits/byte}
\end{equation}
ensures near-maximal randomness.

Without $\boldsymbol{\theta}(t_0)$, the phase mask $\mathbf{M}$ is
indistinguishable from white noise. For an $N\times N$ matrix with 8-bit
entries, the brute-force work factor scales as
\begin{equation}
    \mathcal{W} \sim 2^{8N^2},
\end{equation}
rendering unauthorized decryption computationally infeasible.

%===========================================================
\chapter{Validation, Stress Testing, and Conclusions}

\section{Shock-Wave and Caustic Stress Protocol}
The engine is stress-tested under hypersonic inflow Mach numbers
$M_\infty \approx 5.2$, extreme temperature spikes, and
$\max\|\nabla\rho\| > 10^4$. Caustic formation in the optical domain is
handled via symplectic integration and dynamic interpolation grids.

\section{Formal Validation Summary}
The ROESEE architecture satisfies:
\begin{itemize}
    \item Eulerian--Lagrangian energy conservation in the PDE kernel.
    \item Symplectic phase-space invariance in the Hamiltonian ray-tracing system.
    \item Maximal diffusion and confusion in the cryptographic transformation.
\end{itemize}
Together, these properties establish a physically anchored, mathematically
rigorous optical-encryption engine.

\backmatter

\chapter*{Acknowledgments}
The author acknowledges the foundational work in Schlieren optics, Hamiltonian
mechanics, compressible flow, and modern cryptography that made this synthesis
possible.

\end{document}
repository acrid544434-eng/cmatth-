\chapter{Optical-Encryption Kernel and Chaotic Diffusion}

\section{Intensity Sampling and Discrete Representation}
Sensor-plane intensity is sampled into an $N\times N$ matrix
\begin{equation}
    \mathbf{I} = (I_{ij}) \in \mathbb{R}^{N\times N}.
\end{equation}

\section{Thermodynamic Seed and Chaotic Phase Mask}
The thermodynamic state at time $t$ is summarized by
\begin{equation}
    \boldsymbol{\theta}(t)
    = \big(\rho(\mathbf{r},t),\nabla\rho(\mathbf{r},t),
    \nabla n(\mathbf{r},t),\varepsilon_x(t),\varepsilon_z(t)\big).
\end{equation}
A coupled logistic map generates the chaotic phase mask:
\begin{equation}
    m_{ij}^{(k+1)} = \lambda m_{ij}^{(k)}\big(1 - m_{ij}^{(k)}\big)
    + \psi_{ij}\big(\boldsymbol{\theta}(t_0)\big),
\end{equation}
with $\lambda = 4.0$ in the fully chaotic regime, yielding
\begin{equation}
    \mathbf{M} = (m_{ij}).
\end{equation}

\section{Wavelet Mixing and Ciphertext Matrix}
Let $\mathbf{W}\in\mathbb{R}^{N\times N}$ be an orthogonal wavelet transform
and $\mathbf{A}$ a fixed affine bias. The ciphertext matrix is
\begin{equation}
    \mathbf{C} = \mathbf{W}(\mathbf{I}\odot\mathbf{M})\mathbf{W}^\top + \mathbf{A},
\end{equation}
where $\odot$ denotes the Hadamard product.

\section{Entropy and Intractability}
For byte-valued ciphertext entries with empirical probabilities $p_k$,
\begin{equation}
    H(\mathbf{C}) = -\sum_{k=0}^{255} p_k \log_2 p_k,
\end{equation}
and the target threshold
\begin{equation}
    H(\mathbf{C}) \ge 7.99\ \text{bits/byte}
\end{equation}
ensures near-maximal randomness.

Without $\boldsymbol{\theta}(t_0)$, the phase mask $\mathbf{M}$ is
indistinguishable from white noise. For an $N\times N$ matrix with 8-bit
entries, the brute-force work factor scales as
\begin{equation}
    \mathcal{W} \sim 2^{8N^2},
\end{equation}
rendering unauthorized decryption computationally infeasible.

