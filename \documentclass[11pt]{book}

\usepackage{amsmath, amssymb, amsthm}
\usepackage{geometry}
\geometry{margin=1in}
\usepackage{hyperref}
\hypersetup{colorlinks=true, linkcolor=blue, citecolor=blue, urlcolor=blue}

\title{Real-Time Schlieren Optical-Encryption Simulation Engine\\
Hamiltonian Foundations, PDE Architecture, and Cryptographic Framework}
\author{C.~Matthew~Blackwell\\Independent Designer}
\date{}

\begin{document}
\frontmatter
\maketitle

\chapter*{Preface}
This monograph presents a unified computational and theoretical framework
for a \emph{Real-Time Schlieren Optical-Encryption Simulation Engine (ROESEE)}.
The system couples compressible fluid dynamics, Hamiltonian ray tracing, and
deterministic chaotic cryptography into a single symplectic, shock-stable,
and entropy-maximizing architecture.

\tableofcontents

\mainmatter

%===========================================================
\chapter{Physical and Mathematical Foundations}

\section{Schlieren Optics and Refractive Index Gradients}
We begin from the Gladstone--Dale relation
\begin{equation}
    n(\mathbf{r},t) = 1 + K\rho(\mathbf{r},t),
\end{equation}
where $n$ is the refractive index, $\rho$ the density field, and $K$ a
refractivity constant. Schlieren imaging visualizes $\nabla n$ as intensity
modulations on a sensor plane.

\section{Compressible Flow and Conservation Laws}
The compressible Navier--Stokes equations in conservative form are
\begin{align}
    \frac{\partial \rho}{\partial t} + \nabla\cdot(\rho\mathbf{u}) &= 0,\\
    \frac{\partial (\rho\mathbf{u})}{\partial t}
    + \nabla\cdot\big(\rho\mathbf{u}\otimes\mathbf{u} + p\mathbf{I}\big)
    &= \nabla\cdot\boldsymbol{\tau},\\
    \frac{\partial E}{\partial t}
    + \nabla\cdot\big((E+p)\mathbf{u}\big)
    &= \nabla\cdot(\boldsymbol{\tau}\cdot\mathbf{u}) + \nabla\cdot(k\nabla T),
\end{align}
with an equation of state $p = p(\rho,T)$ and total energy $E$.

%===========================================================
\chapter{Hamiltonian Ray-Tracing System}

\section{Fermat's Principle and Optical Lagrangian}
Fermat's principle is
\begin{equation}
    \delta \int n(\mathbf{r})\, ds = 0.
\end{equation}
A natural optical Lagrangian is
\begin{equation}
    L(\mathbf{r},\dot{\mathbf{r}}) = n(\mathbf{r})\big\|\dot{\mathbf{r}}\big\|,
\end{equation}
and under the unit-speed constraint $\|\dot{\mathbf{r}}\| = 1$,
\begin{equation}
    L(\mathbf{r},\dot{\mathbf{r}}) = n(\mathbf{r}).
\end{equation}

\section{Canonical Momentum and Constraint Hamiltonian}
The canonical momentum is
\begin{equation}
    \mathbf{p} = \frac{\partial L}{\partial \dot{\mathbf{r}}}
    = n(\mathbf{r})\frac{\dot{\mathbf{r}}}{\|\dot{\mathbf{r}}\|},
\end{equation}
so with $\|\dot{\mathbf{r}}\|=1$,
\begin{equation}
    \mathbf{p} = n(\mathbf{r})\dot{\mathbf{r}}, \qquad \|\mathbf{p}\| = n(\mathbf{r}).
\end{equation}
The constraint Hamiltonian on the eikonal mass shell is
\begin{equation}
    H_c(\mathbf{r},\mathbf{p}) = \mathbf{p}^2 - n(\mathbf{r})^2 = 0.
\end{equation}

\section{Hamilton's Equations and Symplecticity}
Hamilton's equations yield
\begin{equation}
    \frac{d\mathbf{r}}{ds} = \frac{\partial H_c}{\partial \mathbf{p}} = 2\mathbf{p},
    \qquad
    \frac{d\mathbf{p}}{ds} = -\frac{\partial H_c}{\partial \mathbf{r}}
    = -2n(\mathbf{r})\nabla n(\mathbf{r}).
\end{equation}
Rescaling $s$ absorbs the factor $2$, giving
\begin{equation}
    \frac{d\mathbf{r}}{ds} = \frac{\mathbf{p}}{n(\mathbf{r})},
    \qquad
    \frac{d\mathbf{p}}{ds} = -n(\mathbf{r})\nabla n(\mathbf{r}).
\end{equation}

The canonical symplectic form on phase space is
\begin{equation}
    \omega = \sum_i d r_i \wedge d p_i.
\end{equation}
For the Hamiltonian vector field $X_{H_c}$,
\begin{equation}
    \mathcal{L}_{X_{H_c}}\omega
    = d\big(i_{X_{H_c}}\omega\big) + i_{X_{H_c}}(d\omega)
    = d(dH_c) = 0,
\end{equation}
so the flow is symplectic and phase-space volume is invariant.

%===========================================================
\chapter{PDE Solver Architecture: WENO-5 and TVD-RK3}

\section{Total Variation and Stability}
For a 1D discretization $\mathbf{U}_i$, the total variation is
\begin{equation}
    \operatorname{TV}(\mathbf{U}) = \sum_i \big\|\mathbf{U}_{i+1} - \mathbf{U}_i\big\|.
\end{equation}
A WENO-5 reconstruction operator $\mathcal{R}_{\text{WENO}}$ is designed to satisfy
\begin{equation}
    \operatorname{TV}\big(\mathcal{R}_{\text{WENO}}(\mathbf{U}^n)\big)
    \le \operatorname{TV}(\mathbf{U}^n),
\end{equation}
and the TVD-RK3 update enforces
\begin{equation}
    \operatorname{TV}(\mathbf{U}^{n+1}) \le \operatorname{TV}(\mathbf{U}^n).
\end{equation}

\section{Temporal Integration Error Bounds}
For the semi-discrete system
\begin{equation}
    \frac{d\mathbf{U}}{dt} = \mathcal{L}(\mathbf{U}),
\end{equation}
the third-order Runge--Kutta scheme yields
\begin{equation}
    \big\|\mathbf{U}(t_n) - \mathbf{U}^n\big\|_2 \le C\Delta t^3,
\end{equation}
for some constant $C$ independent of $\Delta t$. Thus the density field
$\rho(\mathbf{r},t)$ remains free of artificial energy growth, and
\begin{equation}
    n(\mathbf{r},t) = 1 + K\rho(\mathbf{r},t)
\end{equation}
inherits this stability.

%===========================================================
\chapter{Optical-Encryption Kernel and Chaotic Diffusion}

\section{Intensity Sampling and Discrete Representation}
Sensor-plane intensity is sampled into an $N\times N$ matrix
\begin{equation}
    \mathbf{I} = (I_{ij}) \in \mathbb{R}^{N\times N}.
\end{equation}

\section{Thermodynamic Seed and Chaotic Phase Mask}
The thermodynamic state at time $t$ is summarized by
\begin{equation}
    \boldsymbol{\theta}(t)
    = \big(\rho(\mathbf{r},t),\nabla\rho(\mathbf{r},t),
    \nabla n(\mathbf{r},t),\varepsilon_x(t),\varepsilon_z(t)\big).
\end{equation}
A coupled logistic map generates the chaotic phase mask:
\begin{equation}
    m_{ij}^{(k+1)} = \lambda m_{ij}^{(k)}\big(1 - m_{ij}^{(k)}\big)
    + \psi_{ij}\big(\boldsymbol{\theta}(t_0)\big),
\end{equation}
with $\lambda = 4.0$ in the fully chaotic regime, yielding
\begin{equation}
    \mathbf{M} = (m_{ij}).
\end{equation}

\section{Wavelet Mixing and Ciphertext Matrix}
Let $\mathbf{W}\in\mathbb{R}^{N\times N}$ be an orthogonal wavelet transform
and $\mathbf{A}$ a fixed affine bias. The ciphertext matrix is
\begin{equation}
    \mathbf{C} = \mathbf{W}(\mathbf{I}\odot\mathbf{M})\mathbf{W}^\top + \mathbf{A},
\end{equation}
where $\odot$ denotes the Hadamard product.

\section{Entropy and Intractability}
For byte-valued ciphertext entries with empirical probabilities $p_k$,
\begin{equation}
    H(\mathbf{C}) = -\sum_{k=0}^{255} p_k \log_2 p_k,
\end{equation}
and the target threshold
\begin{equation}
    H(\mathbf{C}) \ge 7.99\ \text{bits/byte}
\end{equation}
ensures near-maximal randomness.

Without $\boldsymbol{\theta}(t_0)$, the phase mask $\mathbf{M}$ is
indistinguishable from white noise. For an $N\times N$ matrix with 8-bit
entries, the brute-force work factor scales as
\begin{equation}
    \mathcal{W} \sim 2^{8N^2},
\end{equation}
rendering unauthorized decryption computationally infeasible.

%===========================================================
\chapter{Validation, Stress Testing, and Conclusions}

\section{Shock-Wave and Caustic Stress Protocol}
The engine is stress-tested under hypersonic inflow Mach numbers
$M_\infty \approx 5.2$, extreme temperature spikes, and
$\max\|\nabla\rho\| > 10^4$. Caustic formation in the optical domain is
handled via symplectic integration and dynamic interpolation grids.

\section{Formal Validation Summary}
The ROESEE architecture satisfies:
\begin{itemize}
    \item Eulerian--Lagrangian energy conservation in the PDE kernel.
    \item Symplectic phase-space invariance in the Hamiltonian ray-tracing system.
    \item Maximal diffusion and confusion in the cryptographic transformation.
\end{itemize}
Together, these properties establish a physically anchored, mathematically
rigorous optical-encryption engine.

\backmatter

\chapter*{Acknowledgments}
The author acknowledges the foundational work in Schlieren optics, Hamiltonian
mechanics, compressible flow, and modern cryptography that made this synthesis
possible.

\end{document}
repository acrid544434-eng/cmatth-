\chapter{Hamiltonian Ray-Tracing System}

\section{Fermat's Principle and Optical Lagrangian}
Fermat's principle is
\begin{equation}
    \delta \int n(\mathbf{r})\, ds = 0.
\end{equation}
A natural optical Lagrangian is
\begin{equation}
    L(\mathbf{r},\dot{\mathbf{r}}) = n(\mathbf{r})\big\|\dot{\mathbf{r}}\big\|,
\end{equation}
and under the unit-speed constraint $\|\dot{\mathbf{r}}\| = 1$,
\begin{equation}
    L(\mathbf{r},\dot{\mathbf{r}}) = n(\mathbf{r}).
\end{equation}

\section{Canonical Momentum and Constraint Hamiltonian}
The canonical momentum is
\begin{equation}
    \mathbf{p} = \frac{\partial L}{\partial \dot{\mathbf{r}}}
    = n(\mathbf{r})\frac{\dot{\mathbf{r}}}{\|\dot{\mathbf{r}}\|},
\end{equation}
so with $\|\dot{\mathbf{r}}\|=1$,
\begin{equation}
    \mathbf{p} = n(\mathbf{r})\dot{\mathbf{r}}, \qquad \|\mathbf{p}\| = n(\mathbf{r}).
\end{equation}
The constraint Hamiltonian on the eikonal mass shell is
\begin{equation}
    H_c(\mathbf{r},\mathbf{p}) = \mathbf{p}^2 - n(\mathbf{r})^2 = 0.
\end{equation}

\section{Hamilton's Equations and Symplecticity}
Hamilton's equations yield
\begin{equation}
    \frac{d\mathbf{r}}{ds} = \frac{\partial H_c}{\partial \mathbf{p}} = 2\mathbf{p},
    \qquad
    \frac{d\mathbf{p}}{ds} = -\frac{\partial H_c}{\partial \mathbf{r}}
    = -2n(\mathbf{r})\nabla n(\mathbf{r}).
\end{equation}
Rescaling $s$ absorbs the factor $2$, giving
\begin{equation}
    \frac{d\mathbf{r}}{ds} = \frac{\mathbf{p}}{n(\mathbf{r})},
    \qquad
    \frac{d\mathbf{p}}{ds} = -n(\mathbf{r})\nabla n(\mathbf{r}).
\end{equation}

The canonical symplectic form on phase space is
\begin{equation}
    \omega = \sum_i d r_i \wedge d p_i.
\end{equation}
For the Hamiltonian vector field $X_{H_c}$,
\begin{equation}
    \mathcal{L}_{X_{H_c}}\omega
    = d\big(i_{X_{H_c}}\omega\big) + i_{X_{H_c}}(d\omega)
    = d(dH_c) = 0,
\end{equation}
so the flow is symplectic and phase-space volume is invariant.

