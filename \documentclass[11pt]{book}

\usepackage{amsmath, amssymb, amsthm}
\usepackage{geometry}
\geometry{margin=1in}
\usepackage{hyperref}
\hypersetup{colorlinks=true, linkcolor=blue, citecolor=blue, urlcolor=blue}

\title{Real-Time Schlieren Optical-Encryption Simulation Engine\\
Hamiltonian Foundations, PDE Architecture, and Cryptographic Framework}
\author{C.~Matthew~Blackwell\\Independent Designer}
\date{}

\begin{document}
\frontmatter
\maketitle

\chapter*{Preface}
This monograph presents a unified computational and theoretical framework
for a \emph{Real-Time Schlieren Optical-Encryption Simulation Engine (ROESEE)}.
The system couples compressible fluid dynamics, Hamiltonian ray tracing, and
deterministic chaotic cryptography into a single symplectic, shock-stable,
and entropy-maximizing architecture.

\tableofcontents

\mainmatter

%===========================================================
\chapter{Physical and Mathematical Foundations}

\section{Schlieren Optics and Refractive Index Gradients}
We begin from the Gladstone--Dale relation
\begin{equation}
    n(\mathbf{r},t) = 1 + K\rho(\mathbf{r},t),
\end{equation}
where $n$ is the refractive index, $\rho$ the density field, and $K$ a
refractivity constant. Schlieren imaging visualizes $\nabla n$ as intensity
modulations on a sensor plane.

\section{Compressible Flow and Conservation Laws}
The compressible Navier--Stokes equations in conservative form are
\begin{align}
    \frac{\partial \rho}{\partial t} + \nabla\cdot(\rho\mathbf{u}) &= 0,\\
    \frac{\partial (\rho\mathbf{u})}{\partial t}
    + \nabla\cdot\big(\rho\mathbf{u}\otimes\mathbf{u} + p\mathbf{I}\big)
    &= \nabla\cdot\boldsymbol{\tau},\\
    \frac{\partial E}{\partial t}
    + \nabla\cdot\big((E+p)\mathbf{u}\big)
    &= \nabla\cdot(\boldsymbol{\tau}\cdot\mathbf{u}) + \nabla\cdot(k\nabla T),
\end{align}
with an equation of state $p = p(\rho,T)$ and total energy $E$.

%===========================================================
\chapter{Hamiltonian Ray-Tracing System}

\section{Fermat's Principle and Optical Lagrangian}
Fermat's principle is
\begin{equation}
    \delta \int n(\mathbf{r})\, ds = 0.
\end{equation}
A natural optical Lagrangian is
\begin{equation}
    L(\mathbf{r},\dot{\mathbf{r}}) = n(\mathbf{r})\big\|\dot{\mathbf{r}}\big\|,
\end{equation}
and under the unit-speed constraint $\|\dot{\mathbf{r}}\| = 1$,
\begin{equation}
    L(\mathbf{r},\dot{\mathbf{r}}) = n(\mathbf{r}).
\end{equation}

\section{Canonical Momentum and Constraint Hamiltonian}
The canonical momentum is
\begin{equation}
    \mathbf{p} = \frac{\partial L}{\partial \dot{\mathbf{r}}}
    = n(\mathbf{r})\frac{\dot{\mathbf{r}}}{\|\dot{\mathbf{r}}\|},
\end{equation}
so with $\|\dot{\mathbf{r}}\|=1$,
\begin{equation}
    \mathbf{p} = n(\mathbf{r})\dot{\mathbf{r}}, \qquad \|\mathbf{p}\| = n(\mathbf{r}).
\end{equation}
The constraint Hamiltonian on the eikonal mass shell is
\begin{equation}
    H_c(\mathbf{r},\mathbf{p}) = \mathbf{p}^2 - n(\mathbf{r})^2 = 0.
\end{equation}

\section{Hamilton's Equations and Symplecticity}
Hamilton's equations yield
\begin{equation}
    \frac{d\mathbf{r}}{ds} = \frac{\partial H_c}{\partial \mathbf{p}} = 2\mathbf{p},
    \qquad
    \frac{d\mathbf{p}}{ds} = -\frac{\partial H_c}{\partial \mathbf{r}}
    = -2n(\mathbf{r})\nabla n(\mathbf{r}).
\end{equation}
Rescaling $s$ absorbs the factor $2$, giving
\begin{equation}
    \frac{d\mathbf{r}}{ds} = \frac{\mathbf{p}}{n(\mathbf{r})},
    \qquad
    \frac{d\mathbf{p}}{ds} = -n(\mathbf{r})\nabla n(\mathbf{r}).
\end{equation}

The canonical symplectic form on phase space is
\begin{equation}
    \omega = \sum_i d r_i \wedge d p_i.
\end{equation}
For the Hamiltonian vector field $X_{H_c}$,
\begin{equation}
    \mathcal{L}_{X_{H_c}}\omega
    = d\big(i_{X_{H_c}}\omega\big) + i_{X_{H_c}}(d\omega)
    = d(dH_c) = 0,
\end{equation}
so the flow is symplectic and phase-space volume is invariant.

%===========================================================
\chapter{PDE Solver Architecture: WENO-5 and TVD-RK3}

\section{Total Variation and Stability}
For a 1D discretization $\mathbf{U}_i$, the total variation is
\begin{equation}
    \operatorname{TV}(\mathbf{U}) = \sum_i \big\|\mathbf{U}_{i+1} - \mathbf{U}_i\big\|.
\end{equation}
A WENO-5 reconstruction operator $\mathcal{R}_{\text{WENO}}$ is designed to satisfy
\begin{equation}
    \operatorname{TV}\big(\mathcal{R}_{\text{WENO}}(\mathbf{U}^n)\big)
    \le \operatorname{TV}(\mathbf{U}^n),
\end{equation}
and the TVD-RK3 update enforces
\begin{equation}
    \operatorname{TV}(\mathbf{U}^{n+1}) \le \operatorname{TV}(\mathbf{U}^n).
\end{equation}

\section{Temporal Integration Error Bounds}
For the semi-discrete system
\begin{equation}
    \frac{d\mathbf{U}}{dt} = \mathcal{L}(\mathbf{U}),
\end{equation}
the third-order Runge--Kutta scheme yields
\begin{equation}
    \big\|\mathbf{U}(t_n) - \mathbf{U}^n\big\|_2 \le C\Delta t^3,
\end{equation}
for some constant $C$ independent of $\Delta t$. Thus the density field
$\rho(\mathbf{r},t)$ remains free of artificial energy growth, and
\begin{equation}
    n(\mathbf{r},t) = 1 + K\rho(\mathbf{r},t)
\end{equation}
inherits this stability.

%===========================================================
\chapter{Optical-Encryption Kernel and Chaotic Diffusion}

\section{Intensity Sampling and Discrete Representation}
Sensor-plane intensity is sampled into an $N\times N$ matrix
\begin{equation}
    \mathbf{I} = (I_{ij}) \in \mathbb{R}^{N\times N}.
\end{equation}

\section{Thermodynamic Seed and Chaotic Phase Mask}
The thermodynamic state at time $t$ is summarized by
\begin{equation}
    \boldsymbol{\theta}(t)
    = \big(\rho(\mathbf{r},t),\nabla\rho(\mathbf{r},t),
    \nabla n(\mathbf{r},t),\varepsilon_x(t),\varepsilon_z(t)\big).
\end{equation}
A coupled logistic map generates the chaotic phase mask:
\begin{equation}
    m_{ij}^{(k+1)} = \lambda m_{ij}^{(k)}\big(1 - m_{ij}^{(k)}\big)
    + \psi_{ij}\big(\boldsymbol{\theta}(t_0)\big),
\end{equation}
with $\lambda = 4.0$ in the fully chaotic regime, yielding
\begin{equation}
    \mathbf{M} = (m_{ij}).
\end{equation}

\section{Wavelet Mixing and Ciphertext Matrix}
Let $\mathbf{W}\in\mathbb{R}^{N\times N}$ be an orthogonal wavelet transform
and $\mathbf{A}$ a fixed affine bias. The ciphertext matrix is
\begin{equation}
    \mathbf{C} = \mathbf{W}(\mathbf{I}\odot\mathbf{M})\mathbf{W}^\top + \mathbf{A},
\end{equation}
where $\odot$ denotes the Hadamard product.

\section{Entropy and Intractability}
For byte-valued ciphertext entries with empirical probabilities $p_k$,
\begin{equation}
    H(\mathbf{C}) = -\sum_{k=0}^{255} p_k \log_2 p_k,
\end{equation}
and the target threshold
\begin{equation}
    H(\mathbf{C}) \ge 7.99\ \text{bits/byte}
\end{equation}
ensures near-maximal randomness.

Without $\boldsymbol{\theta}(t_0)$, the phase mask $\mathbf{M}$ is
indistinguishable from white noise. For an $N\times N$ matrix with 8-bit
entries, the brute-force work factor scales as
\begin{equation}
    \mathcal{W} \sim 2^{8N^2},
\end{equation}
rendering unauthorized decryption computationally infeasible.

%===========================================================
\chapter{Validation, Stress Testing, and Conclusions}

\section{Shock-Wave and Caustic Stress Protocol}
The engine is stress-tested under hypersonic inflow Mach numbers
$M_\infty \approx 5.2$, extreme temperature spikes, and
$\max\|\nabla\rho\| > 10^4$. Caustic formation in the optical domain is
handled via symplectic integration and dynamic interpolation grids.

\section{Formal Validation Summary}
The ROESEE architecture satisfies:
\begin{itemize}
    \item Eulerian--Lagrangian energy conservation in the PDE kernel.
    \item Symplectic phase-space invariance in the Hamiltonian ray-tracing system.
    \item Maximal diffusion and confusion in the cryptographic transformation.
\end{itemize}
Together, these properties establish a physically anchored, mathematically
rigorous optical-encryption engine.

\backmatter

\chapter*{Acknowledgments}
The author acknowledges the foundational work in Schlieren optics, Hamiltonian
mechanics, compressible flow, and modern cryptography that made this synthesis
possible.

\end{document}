\chapter{Physical and Mathematical Foundations}

\section{Schlieren Optics and Refractive Index Gradients}
We begin from the Gladstone--Dale relation
\begin{equation}
    n(\mathbf{r},t) = 1 + K\rho(\mathbf{r},t),
\end{equation}
where $n$ is the refractive index, $\rho$ the density field, and $K$ a
refractivity constant. Schlieren imaging visualizes $\nabla n$ as intensity
modulations on a sensor plane.

\section{Compressible Flow and Conservation Laws}
The compressible Navier--Stokes equations in conservative form are
\begin{align}
    \frac{\partial \rho}{\partial t} + \nabla\cdot(\rho\mathbf{u}) &= 0,\\
    \frac{\partial (\rho\mathbf{u})}{\partial t}
    + \nabla\cdot\big(\rho\mathbf{u}\otimes\mathbf{u} + p\mathbf{I}\big)
    &= \nabla\cdot\boldsymbol{\tau},\\
    \frac{\partial E}{\partial t}
    + \nabla\cdot\big((E+p)\mathbf{u}\big)
    &= \nabla\cdot(\boldsymbol{\tau}\cdot\mathbf{u}) + \nabla\cdot(k\nabla T),
\end{align}
with an equation of state $p = p(\rho,T)$ and total energy $E$.

