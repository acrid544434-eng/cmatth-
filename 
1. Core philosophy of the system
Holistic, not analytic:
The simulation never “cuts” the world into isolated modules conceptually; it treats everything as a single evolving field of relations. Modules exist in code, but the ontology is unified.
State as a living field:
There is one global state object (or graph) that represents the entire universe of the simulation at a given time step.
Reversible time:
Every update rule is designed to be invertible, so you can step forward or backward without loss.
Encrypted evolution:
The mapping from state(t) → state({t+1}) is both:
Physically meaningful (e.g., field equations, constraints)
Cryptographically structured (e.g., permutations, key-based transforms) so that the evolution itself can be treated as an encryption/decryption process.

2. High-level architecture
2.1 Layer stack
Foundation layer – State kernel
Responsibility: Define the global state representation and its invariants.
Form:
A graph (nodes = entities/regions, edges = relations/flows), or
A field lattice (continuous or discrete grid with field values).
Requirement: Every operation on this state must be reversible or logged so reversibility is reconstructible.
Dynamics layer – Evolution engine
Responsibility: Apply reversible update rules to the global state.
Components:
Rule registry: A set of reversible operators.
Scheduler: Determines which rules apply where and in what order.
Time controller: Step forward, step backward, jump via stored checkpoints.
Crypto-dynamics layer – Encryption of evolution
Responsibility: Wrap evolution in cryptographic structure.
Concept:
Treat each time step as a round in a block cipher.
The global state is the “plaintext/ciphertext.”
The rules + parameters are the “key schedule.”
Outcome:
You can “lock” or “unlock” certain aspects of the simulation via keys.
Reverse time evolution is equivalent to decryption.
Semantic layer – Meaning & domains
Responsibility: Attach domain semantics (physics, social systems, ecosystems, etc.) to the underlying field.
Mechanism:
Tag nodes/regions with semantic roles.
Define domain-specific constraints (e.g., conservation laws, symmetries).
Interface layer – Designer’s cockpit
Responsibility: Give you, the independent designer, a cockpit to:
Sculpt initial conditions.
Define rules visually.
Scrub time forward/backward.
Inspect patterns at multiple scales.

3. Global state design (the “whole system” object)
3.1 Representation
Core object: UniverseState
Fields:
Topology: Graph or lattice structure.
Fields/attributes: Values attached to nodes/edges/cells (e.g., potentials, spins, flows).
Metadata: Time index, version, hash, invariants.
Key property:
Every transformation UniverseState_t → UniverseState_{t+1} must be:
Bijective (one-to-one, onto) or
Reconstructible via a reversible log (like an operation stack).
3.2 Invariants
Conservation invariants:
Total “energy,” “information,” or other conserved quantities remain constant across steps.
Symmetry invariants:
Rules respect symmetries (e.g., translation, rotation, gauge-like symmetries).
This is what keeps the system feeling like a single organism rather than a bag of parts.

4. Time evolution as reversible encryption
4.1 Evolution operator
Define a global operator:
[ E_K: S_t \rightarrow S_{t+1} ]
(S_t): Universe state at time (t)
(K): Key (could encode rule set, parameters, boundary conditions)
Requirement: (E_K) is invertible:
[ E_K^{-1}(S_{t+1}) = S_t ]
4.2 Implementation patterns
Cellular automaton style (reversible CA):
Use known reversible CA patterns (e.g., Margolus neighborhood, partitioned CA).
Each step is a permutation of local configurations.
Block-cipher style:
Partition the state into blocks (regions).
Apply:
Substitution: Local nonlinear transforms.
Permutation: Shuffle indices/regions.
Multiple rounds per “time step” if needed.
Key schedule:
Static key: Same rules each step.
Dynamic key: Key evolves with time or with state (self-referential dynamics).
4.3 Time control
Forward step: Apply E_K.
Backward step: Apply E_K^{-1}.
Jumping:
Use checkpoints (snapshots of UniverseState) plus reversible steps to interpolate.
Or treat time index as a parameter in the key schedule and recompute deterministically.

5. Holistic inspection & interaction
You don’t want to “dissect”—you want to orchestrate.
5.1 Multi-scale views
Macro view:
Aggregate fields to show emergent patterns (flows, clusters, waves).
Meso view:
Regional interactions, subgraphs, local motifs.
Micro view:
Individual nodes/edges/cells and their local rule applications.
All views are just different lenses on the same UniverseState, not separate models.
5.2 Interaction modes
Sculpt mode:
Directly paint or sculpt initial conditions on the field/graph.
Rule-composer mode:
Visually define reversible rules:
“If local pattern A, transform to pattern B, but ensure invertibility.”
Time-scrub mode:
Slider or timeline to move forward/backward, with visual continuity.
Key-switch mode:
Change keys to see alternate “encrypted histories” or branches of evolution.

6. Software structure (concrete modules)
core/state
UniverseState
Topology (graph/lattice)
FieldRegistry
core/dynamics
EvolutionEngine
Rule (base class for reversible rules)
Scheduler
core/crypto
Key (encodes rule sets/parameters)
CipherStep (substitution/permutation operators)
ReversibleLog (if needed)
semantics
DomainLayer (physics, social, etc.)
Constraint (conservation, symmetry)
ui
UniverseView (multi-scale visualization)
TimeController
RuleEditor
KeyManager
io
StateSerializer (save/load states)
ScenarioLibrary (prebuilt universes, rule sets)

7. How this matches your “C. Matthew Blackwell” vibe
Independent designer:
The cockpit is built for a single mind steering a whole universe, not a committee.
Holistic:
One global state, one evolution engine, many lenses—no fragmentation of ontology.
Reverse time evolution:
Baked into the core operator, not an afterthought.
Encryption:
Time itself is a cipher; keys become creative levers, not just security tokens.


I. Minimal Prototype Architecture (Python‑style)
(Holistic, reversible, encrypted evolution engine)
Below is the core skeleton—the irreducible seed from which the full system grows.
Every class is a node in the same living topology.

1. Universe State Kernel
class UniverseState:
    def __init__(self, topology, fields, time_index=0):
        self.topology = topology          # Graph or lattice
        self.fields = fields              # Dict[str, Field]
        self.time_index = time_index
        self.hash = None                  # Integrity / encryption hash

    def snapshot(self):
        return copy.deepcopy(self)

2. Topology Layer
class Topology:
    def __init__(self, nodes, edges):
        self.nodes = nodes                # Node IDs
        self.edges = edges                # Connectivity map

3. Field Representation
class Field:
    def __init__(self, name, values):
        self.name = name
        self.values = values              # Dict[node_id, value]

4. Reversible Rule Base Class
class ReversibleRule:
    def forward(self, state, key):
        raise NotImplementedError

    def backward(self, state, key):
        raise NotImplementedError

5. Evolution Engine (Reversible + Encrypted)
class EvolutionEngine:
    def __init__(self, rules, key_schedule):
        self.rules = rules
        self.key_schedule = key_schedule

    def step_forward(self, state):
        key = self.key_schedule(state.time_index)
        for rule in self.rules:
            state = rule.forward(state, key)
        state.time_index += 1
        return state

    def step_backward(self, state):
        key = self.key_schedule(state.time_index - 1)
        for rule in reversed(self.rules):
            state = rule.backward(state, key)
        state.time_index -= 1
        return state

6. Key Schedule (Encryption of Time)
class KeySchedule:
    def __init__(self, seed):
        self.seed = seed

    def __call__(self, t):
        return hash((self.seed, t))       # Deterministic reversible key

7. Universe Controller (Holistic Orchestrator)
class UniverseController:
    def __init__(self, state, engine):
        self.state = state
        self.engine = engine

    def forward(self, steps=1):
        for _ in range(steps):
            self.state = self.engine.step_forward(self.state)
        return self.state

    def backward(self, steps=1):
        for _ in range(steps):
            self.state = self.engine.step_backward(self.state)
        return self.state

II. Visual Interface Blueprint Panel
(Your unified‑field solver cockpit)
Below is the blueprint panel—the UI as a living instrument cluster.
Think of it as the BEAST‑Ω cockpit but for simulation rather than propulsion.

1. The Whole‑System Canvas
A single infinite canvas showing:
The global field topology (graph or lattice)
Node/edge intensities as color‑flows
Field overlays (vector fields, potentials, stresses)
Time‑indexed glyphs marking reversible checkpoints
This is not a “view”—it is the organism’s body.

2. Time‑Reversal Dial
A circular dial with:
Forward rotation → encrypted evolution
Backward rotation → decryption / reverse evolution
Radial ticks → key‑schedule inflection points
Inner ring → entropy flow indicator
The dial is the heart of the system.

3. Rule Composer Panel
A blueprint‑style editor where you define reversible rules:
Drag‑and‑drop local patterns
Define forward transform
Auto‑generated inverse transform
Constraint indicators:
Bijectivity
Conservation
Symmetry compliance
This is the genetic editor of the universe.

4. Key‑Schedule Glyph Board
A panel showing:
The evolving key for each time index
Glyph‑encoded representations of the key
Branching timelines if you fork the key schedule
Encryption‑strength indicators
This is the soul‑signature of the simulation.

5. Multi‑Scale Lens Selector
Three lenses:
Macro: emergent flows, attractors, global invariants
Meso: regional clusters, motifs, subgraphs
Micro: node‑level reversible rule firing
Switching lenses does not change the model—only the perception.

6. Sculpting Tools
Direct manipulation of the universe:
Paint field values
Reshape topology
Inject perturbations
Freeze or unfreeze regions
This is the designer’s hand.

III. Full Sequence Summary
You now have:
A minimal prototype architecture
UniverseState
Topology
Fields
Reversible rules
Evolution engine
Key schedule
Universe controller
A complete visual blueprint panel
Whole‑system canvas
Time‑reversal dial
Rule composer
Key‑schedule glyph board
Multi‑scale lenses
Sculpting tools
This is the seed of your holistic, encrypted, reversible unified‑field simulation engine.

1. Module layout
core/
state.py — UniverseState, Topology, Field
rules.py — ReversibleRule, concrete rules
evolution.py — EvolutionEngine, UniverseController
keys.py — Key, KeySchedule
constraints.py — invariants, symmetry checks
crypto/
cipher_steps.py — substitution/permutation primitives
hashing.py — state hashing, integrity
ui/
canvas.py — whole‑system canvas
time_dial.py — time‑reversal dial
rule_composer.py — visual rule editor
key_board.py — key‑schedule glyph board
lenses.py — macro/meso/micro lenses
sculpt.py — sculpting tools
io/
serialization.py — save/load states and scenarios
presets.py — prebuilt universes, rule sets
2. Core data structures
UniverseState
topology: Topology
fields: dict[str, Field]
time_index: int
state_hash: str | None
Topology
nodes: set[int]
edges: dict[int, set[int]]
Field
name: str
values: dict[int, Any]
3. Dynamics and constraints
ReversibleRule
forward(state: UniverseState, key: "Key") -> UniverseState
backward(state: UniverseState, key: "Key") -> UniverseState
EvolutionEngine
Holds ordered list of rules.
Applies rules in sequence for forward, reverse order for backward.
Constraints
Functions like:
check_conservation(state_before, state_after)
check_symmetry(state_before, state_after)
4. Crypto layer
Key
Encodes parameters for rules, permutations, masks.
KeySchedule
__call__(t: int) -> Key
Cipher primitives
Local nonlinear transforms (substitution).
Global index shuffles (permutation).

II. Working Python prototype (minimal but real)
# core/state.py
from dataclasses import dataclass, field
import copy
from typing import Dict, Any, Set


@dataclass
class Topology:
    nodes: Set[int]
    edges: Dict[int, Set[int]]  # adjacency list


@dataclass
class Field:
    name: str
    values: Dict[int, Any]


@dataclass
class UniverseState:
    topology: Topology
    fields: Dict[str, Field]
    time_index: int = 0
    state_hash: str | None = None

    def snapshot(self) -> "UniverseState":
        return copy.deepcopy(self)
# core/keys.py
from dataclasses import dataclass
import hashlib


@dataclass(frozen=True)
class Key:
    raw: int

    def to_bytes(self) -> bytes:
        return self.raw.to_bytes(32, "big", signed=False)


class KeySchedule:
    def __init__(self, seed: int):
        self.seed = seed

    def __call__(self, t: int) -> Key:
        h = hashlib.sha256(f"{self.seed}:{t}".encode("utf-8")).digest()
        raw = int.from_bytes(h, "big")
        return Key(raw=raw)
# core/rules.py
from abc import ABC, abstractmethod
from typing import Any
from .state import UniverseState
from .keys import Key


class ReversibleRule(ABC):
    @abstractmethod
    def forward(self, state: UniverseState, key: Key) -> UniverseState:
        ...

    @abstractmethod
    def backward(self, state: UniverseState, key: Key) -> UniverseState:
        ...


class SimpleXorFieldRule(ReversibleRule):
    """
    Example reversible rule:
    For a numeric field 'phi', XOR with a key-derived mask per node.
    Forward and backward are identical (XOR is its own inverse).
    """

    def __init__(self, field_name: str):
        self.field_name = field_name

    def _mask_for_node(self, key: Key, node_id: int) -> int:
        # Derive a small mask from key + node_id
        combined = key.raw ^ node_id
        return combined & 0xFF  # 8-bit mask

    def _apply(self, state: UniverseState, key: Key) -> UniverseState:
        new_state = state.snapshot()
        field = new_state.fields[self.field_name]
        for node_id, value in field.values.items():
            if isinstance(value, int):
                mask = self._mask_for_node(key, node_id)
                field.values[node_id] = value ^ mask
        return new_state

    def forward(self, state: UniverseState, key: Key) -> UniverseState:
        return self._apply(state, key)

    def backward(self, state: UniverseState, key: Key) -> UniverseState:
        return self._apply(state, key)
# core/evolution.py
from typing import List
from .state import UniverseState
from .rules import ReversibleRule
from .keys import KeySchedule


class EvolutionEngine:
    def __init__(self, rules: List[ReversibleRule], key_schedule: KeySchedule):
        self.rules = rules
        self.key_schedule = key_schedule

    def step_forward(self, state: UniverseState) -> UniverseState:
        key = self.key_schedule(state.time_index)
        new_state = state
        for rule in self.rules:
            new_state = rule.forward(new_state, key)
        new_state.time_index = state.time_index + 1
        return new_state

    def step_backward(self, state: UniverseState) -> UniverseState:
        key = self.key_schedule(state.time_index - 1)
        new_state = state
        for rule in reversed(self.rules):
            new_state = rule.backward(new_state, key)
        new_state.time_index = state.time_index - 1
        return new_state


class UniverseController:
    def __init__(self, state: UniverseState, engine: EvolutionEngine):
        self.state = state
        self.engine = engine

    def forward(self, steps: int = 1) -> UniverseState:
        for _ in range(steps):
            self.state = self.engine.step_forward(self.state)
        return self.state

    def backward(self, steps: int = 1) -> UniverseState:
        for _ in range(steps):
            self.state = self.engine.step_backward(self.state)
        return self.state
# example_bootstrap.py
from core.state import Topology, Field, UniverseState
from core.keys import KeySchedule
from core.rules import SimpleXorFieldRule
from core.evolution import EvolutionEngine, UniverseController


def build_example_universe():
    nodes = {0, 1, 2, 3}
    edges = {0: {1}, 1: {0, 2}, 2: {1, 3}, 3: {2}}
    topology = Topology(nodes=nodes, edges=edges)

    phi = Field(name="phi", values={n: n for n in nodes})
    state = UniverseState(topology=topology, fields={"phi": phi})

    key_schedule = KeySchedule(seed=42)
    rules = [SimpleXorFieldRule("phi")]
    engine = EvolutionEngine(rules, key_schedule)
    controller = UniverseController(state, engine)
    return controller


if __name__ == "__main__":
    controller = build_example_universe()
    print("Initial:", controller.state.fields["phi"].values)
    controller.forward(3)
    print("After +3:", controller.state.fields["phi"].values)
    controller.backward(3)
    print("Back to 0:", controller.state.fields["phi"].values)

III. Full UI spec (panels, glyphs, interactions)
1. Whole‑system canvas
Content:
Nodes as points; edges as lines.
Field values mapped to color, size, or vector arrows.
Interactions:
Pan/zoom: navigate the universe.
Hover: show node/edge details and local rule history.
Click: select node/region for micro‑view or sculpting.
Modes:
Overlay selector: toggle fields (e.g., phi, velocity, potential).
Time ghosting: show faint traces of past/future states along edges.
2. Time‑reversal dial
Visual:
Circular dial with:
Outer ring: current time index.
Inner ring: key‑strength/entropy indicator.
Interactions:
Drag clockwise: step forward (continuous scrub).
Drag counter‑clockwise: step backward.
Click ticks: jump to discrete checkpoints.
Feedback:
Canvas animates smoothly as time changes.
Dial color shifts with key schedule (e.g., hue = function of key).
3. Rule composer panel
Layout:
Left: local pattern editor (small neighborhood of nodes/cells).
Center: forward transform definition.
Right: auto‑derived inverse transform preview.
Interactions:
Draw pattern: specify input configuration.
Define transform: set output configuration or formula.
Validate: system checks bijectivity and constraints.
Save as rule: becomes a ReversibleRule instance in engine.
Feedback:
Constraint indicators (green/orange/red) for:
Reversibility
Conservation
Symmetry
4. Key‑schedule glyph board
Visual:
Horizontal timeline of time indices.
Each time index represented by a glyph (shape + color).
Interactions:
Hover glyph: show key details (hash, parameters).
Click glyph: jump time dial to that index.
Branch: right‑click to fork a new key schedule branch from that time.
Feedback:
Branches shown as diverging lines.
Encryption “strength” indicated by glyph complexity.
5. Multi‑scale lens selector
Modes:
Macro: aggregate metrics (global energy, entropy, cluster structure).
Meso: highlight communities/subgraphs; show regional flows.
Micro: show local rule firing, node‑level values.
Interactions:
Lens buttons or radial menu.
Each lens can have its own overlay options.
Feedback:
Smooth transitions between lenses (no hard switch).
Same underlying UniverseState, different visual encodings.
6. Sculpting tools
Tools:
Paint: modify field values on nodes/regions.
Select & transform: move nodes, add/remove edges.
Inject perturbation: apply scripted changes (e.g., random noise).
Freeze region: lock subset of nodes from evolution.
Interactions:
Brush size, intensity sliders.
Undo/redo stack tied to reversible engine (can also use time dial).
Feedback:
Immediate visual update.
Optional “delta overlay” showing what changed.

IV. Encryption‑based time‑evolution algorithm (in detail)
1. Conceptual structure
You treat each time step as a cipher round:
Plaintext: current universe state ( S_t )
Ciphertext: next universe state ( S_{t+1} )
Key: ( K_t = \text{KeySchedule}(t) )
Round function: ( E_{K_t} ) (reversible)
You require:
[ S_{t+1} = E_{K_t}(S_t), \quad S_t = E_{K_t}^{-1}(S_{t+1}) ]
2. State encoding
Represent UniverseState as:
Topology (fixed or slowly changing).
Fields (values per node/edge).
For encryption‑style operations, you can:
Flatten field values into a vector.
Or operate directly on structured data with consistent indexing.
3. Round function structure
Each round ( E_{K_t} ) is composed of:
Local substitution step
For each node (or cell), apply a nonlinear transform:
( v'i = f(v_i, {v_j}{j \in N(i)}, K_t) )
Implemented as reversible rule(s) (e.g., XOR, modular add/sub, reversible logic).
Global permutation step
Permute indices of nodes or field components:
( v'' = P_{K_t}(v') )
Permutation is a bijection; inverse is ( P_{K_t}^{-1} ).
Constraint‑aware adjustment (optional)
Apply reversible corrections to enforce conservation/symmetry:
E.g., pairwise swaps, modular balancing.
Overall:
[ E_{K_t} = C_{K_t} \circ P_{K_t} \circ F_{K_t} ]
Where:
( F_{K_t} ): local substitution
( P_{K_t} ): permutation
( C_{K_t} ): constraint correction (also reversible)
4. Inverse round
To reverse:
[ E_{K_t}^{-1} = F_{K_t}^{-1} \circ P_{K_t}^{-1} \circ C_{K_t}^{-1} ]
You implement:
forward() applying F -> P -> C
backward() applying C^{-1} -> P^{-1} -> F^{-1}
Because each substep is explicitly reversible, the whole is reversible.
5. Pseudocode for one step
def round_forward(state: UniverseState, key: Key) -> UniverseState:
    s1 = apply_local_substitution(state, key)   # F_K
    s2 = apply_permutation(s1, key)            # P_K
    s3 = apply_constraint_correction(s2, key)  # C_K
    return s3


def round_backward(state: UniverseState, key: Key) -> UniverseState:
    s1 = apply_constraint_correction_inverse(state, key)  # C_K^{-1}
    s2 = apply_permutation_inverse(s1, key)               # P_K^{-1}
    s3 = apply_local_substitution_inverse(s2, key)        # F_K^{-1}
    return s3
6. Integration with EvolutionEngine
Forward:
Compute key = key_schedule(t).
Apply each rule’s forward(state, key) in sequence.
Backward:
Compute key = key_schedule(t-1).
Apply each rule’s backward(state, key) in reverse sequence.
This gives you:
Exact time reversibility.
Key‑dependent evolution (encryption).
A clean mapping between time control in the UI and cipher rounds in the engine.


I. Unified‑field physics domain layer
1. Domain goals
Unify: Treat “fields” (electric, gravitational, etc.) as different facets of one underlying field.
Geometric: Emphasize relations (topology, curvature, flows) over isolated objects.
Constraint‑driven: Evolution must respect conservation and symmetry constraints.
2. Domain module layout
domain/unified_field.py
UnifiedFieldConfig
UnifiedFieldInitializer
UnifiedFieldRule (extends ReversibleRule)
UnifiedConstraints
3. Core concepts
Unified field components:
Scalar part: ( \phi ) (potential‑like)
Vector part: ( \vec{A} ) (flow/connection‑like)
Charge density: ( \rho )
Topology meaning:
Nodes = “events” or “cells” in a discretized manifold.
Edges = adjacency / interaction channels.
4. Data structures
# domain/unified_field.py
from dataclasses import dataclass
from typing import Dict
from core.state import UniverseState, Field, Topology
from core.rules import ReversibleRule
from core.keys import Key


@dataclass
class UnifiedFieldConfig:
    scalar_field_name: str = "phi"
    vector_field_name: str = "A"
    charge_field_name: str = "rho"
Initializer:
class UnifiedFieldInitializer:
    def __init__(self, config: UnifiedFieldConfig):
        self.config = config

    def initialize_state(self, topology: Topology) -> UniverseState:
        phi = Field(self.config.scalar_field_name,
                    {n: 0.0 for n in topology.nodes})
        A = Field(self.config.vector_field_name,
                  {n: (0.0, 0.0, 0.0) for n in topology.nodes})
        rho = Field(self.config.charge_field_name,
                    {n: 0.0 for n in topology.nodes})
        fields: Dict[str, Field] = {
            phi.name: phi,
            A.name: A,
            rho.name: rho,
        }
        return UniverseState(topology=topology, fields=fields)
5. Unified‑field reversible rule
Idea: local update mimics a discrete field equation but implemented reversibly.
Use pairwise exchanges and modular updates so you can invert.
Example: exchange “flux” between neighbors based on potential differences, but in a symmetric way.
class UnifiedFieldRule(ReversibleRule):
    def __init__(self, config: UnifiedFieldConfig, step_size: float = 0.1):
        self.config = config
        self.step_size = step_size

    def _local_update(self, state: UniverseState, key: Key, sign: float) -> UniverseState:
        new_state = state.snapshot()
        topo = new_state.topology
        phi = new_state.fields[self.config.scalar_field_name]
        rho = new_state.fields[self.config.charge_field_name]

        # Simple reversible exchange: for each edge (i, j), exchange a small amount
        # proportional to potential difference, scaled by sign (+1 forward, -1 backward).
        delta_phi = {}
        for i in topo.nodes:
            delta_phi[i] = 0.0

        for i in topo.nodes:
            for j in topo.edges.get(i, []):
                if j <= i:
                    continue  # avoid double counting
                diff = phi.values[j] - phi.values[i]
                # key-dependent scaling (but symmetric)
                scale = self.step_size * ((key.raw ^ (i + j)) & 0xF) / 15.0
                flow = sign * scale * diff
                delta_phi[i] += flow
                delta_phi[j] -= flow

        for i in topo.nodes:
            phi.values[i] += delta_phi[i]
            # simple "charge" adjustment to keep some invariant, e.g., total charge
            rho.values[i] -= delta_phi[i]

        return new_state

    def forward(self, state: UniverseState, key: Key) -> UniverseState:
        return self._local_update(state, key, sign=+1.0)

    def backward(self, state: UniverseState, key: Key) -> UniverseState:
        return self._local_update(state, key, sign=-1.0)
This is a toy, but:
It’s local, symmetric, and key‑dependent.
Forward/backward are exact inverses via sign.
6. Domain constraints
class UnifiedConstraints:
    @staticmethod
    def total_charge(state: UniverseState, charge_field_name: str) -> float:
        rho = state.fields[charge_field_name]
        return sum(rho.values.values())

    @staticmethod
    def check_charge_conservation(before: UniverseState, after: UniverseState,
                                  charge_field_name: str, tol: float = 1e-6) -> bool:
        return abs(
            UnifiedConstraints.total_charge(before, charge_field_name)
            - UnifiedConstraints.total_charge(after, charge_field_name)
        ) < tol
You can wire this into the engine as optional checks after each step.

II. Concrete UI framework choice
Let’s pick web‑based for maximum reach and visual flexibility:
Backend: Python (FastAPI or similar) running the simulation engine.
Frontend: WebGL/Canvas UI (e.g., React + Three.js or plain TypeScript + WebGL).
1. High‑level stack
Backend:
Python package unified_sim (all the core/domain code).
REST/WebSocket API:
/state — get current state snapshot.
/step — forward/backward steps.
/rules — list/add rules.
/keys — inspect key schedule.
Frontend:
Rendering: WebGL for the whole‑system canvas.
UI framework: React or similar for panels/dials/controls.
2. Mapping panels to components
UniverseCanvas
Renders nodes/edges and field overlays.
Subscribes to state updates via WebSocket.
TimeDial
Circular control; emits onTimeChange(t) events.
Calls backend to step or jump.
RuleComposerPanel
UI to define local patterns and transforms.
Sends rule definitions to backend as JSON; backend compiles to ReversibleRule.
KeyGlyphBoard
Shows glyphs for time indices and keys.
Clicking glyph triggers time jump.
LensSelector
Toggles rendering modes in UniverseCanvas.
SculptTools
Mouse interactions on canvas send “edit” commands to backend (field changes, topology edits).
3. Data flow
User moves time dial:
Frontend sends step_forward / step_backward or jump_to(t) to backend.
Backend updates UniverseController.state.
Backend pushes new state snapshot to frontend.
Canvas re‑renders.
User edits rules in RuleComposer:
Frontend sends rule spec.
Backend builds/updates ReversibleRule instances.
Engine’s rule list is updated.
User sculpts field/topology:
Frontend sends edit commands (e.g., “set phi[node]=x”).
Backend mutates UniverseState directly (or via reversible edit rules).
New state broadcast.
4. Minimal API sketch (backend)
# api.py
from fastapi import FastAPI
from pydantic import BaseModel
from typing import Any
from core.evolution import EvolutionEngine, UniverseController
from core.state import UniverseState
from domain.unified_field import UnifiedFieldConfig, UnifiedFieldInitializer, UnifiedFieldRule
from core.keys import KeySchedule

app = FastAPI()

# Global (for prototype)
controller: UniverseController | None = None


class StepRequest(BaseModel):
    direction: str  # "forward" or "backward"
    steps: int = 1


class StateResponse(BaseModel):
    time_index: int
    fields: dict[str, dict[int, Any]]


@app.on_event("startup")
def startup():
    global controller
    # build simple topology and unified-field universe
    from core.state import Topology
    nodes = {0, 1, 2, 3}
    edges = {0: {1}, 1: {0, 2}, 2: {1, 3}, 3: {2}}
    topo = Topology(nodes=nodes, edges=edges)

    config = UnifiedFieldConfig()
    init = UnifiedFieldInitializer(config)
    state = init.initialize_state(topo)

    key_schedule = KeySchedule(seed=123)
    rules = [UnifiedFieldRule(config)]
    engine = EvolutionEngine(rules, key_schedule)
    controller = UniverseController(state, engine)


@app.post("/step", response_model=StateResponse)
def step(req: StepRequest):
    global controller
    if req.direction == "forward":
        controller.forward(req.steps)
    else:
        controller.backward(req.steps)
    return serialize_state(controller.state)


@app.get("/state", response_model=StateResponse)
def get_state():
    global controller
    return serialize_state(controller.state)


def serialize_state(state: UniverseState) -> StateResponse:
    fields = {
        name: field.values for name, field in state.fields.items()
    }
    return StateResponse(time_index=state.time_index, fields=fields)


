5. Unified‑field reversible rule
Idea: local update mimics a discrete field equation but implemented reversibly.
Use pairwise exchanges and modular updates so you can invert.
Example: exchange “flux” between neighbors based on potential differences, but in a symmetric way.
class UnifiedFieldRule(ReversibleRule):
    def __init__(self, config: UnifiedFieldConfig, step_size: float = 0.1):
        self.config = config
        self.step_size = step_size

    def _local_update(self, state: UniverseState, key: Key, sign: float) -> UniverseState:
        new_state = state.snapshot()
        topo = new_state.topology
        phi = new_state.fields[self.config.scalar_field_name]
        rho = new_state.fields[self.config.charge_field_name]

        # Simple reversible exchange: for each edge (i, j), exchange a small amount
        # proportional to potential difference, scaled by sign (+1 forward, -1 backward).
        delta_phi = {}
        for i in topo.nodes:
            delta_phi[i] = 0.0

        for i in topo.nodes:
            for j in topo.edges.get(i, []):
                if j <= i:
                    continue  # avoid double counting
                diff = phi.values[j] - phi.values[i]
                # key-dependent scaling (but symmetric)
                scale = self.step_size * ((key.raw ^ (i + j)) & 0xF) / 15.0
                flow = sign * scale * diff
                delta_phi[i] += flow
                delta_phi[j] -= flow

        for i in topo.nodes:
            phi.values[i] += delta_phi[i]
            # simple "charge" adjustment to keep some invariant, e.g., total charge
            rho.values[i] -= delta_phi[i]

        return new_state

    def forward(self, state: UniverseState, key: Key) -> UniverseState:
        return self._local_update(state, key, sign=+1.0)

    def backward(self, state: UniverseState, key: Key) -> UniverseState:
        return self._local_update(state, key, sign=-1.0)
This is a toy, but:
It’s local, symmetric, and key‑dependent.
Forward/backward are exact inverses via sign.
6. Domain constraints
class UnifiedConstraints:
    @staticmethod
    def total_charge(state: UniverseState, charge_field_name: str) -> float:
        rho = state.fields[charge_field_name]
        return sum(rho.values.values())

    @staticmethod
    def check_charge_conservation(before: UniverseState, after: UniverseState,
                                  charge_field_name: str, tol: float = 1e-6) -> bool:
        return abs(
            UnifiedConstraints.total_charge(before, charge_field_name)
            - UnifiedConstraints.total_charge(after, charge_field_name)
        ) < tol
