from abc import ABC, abstractmethod
from typing import Any
from .state import UniverseState
from .keys import Key


class ReversibleRule(ABC):
    @abstractmethod
    def forward(self, state: UniverseState, key: Key) -> UniverseState:
        ...

    @abstractmethod
    def backward(self, state: UniverseState, key: Key) -> UniverseState:
        ...


class SimpleXorFieldRule(ReversibleRule):
    """
    Example reversible rule:
    For a numeric field 'phi', XOR with a key-derived mask per node.
    Forward and backward are identical (XOR is its own inverse).
    """

    def __init__(self, field_name: str):
        self.field_name = field_name

    def _mask_for_node(self, key: Key, node_id: int) -> int:
        # Derive a small mask from key + node_id
        combined = key.raw ^ node_id
        return combined & 0xFF  # 8-bit mask

    def _apply(self, state: UniverseState, key: Key) -> UniverseState:
        new_state = state.snapshot()
        field = new_state.fields[self.field_name]
        for node_id, value in field.values.items():
            if isinstance(value, int):
                mask = self._mask_for_node(key, node_id)
                field.values[node_id] = value ^ mask
        return new_state

    def forward(self, state: UniverseState, key: Key) -> UniverseState:
        return self._apply(state, key)

    def backward(self, state: UniverseState, key: Key) -> UniverseState:
        return self._apply(state, key)
