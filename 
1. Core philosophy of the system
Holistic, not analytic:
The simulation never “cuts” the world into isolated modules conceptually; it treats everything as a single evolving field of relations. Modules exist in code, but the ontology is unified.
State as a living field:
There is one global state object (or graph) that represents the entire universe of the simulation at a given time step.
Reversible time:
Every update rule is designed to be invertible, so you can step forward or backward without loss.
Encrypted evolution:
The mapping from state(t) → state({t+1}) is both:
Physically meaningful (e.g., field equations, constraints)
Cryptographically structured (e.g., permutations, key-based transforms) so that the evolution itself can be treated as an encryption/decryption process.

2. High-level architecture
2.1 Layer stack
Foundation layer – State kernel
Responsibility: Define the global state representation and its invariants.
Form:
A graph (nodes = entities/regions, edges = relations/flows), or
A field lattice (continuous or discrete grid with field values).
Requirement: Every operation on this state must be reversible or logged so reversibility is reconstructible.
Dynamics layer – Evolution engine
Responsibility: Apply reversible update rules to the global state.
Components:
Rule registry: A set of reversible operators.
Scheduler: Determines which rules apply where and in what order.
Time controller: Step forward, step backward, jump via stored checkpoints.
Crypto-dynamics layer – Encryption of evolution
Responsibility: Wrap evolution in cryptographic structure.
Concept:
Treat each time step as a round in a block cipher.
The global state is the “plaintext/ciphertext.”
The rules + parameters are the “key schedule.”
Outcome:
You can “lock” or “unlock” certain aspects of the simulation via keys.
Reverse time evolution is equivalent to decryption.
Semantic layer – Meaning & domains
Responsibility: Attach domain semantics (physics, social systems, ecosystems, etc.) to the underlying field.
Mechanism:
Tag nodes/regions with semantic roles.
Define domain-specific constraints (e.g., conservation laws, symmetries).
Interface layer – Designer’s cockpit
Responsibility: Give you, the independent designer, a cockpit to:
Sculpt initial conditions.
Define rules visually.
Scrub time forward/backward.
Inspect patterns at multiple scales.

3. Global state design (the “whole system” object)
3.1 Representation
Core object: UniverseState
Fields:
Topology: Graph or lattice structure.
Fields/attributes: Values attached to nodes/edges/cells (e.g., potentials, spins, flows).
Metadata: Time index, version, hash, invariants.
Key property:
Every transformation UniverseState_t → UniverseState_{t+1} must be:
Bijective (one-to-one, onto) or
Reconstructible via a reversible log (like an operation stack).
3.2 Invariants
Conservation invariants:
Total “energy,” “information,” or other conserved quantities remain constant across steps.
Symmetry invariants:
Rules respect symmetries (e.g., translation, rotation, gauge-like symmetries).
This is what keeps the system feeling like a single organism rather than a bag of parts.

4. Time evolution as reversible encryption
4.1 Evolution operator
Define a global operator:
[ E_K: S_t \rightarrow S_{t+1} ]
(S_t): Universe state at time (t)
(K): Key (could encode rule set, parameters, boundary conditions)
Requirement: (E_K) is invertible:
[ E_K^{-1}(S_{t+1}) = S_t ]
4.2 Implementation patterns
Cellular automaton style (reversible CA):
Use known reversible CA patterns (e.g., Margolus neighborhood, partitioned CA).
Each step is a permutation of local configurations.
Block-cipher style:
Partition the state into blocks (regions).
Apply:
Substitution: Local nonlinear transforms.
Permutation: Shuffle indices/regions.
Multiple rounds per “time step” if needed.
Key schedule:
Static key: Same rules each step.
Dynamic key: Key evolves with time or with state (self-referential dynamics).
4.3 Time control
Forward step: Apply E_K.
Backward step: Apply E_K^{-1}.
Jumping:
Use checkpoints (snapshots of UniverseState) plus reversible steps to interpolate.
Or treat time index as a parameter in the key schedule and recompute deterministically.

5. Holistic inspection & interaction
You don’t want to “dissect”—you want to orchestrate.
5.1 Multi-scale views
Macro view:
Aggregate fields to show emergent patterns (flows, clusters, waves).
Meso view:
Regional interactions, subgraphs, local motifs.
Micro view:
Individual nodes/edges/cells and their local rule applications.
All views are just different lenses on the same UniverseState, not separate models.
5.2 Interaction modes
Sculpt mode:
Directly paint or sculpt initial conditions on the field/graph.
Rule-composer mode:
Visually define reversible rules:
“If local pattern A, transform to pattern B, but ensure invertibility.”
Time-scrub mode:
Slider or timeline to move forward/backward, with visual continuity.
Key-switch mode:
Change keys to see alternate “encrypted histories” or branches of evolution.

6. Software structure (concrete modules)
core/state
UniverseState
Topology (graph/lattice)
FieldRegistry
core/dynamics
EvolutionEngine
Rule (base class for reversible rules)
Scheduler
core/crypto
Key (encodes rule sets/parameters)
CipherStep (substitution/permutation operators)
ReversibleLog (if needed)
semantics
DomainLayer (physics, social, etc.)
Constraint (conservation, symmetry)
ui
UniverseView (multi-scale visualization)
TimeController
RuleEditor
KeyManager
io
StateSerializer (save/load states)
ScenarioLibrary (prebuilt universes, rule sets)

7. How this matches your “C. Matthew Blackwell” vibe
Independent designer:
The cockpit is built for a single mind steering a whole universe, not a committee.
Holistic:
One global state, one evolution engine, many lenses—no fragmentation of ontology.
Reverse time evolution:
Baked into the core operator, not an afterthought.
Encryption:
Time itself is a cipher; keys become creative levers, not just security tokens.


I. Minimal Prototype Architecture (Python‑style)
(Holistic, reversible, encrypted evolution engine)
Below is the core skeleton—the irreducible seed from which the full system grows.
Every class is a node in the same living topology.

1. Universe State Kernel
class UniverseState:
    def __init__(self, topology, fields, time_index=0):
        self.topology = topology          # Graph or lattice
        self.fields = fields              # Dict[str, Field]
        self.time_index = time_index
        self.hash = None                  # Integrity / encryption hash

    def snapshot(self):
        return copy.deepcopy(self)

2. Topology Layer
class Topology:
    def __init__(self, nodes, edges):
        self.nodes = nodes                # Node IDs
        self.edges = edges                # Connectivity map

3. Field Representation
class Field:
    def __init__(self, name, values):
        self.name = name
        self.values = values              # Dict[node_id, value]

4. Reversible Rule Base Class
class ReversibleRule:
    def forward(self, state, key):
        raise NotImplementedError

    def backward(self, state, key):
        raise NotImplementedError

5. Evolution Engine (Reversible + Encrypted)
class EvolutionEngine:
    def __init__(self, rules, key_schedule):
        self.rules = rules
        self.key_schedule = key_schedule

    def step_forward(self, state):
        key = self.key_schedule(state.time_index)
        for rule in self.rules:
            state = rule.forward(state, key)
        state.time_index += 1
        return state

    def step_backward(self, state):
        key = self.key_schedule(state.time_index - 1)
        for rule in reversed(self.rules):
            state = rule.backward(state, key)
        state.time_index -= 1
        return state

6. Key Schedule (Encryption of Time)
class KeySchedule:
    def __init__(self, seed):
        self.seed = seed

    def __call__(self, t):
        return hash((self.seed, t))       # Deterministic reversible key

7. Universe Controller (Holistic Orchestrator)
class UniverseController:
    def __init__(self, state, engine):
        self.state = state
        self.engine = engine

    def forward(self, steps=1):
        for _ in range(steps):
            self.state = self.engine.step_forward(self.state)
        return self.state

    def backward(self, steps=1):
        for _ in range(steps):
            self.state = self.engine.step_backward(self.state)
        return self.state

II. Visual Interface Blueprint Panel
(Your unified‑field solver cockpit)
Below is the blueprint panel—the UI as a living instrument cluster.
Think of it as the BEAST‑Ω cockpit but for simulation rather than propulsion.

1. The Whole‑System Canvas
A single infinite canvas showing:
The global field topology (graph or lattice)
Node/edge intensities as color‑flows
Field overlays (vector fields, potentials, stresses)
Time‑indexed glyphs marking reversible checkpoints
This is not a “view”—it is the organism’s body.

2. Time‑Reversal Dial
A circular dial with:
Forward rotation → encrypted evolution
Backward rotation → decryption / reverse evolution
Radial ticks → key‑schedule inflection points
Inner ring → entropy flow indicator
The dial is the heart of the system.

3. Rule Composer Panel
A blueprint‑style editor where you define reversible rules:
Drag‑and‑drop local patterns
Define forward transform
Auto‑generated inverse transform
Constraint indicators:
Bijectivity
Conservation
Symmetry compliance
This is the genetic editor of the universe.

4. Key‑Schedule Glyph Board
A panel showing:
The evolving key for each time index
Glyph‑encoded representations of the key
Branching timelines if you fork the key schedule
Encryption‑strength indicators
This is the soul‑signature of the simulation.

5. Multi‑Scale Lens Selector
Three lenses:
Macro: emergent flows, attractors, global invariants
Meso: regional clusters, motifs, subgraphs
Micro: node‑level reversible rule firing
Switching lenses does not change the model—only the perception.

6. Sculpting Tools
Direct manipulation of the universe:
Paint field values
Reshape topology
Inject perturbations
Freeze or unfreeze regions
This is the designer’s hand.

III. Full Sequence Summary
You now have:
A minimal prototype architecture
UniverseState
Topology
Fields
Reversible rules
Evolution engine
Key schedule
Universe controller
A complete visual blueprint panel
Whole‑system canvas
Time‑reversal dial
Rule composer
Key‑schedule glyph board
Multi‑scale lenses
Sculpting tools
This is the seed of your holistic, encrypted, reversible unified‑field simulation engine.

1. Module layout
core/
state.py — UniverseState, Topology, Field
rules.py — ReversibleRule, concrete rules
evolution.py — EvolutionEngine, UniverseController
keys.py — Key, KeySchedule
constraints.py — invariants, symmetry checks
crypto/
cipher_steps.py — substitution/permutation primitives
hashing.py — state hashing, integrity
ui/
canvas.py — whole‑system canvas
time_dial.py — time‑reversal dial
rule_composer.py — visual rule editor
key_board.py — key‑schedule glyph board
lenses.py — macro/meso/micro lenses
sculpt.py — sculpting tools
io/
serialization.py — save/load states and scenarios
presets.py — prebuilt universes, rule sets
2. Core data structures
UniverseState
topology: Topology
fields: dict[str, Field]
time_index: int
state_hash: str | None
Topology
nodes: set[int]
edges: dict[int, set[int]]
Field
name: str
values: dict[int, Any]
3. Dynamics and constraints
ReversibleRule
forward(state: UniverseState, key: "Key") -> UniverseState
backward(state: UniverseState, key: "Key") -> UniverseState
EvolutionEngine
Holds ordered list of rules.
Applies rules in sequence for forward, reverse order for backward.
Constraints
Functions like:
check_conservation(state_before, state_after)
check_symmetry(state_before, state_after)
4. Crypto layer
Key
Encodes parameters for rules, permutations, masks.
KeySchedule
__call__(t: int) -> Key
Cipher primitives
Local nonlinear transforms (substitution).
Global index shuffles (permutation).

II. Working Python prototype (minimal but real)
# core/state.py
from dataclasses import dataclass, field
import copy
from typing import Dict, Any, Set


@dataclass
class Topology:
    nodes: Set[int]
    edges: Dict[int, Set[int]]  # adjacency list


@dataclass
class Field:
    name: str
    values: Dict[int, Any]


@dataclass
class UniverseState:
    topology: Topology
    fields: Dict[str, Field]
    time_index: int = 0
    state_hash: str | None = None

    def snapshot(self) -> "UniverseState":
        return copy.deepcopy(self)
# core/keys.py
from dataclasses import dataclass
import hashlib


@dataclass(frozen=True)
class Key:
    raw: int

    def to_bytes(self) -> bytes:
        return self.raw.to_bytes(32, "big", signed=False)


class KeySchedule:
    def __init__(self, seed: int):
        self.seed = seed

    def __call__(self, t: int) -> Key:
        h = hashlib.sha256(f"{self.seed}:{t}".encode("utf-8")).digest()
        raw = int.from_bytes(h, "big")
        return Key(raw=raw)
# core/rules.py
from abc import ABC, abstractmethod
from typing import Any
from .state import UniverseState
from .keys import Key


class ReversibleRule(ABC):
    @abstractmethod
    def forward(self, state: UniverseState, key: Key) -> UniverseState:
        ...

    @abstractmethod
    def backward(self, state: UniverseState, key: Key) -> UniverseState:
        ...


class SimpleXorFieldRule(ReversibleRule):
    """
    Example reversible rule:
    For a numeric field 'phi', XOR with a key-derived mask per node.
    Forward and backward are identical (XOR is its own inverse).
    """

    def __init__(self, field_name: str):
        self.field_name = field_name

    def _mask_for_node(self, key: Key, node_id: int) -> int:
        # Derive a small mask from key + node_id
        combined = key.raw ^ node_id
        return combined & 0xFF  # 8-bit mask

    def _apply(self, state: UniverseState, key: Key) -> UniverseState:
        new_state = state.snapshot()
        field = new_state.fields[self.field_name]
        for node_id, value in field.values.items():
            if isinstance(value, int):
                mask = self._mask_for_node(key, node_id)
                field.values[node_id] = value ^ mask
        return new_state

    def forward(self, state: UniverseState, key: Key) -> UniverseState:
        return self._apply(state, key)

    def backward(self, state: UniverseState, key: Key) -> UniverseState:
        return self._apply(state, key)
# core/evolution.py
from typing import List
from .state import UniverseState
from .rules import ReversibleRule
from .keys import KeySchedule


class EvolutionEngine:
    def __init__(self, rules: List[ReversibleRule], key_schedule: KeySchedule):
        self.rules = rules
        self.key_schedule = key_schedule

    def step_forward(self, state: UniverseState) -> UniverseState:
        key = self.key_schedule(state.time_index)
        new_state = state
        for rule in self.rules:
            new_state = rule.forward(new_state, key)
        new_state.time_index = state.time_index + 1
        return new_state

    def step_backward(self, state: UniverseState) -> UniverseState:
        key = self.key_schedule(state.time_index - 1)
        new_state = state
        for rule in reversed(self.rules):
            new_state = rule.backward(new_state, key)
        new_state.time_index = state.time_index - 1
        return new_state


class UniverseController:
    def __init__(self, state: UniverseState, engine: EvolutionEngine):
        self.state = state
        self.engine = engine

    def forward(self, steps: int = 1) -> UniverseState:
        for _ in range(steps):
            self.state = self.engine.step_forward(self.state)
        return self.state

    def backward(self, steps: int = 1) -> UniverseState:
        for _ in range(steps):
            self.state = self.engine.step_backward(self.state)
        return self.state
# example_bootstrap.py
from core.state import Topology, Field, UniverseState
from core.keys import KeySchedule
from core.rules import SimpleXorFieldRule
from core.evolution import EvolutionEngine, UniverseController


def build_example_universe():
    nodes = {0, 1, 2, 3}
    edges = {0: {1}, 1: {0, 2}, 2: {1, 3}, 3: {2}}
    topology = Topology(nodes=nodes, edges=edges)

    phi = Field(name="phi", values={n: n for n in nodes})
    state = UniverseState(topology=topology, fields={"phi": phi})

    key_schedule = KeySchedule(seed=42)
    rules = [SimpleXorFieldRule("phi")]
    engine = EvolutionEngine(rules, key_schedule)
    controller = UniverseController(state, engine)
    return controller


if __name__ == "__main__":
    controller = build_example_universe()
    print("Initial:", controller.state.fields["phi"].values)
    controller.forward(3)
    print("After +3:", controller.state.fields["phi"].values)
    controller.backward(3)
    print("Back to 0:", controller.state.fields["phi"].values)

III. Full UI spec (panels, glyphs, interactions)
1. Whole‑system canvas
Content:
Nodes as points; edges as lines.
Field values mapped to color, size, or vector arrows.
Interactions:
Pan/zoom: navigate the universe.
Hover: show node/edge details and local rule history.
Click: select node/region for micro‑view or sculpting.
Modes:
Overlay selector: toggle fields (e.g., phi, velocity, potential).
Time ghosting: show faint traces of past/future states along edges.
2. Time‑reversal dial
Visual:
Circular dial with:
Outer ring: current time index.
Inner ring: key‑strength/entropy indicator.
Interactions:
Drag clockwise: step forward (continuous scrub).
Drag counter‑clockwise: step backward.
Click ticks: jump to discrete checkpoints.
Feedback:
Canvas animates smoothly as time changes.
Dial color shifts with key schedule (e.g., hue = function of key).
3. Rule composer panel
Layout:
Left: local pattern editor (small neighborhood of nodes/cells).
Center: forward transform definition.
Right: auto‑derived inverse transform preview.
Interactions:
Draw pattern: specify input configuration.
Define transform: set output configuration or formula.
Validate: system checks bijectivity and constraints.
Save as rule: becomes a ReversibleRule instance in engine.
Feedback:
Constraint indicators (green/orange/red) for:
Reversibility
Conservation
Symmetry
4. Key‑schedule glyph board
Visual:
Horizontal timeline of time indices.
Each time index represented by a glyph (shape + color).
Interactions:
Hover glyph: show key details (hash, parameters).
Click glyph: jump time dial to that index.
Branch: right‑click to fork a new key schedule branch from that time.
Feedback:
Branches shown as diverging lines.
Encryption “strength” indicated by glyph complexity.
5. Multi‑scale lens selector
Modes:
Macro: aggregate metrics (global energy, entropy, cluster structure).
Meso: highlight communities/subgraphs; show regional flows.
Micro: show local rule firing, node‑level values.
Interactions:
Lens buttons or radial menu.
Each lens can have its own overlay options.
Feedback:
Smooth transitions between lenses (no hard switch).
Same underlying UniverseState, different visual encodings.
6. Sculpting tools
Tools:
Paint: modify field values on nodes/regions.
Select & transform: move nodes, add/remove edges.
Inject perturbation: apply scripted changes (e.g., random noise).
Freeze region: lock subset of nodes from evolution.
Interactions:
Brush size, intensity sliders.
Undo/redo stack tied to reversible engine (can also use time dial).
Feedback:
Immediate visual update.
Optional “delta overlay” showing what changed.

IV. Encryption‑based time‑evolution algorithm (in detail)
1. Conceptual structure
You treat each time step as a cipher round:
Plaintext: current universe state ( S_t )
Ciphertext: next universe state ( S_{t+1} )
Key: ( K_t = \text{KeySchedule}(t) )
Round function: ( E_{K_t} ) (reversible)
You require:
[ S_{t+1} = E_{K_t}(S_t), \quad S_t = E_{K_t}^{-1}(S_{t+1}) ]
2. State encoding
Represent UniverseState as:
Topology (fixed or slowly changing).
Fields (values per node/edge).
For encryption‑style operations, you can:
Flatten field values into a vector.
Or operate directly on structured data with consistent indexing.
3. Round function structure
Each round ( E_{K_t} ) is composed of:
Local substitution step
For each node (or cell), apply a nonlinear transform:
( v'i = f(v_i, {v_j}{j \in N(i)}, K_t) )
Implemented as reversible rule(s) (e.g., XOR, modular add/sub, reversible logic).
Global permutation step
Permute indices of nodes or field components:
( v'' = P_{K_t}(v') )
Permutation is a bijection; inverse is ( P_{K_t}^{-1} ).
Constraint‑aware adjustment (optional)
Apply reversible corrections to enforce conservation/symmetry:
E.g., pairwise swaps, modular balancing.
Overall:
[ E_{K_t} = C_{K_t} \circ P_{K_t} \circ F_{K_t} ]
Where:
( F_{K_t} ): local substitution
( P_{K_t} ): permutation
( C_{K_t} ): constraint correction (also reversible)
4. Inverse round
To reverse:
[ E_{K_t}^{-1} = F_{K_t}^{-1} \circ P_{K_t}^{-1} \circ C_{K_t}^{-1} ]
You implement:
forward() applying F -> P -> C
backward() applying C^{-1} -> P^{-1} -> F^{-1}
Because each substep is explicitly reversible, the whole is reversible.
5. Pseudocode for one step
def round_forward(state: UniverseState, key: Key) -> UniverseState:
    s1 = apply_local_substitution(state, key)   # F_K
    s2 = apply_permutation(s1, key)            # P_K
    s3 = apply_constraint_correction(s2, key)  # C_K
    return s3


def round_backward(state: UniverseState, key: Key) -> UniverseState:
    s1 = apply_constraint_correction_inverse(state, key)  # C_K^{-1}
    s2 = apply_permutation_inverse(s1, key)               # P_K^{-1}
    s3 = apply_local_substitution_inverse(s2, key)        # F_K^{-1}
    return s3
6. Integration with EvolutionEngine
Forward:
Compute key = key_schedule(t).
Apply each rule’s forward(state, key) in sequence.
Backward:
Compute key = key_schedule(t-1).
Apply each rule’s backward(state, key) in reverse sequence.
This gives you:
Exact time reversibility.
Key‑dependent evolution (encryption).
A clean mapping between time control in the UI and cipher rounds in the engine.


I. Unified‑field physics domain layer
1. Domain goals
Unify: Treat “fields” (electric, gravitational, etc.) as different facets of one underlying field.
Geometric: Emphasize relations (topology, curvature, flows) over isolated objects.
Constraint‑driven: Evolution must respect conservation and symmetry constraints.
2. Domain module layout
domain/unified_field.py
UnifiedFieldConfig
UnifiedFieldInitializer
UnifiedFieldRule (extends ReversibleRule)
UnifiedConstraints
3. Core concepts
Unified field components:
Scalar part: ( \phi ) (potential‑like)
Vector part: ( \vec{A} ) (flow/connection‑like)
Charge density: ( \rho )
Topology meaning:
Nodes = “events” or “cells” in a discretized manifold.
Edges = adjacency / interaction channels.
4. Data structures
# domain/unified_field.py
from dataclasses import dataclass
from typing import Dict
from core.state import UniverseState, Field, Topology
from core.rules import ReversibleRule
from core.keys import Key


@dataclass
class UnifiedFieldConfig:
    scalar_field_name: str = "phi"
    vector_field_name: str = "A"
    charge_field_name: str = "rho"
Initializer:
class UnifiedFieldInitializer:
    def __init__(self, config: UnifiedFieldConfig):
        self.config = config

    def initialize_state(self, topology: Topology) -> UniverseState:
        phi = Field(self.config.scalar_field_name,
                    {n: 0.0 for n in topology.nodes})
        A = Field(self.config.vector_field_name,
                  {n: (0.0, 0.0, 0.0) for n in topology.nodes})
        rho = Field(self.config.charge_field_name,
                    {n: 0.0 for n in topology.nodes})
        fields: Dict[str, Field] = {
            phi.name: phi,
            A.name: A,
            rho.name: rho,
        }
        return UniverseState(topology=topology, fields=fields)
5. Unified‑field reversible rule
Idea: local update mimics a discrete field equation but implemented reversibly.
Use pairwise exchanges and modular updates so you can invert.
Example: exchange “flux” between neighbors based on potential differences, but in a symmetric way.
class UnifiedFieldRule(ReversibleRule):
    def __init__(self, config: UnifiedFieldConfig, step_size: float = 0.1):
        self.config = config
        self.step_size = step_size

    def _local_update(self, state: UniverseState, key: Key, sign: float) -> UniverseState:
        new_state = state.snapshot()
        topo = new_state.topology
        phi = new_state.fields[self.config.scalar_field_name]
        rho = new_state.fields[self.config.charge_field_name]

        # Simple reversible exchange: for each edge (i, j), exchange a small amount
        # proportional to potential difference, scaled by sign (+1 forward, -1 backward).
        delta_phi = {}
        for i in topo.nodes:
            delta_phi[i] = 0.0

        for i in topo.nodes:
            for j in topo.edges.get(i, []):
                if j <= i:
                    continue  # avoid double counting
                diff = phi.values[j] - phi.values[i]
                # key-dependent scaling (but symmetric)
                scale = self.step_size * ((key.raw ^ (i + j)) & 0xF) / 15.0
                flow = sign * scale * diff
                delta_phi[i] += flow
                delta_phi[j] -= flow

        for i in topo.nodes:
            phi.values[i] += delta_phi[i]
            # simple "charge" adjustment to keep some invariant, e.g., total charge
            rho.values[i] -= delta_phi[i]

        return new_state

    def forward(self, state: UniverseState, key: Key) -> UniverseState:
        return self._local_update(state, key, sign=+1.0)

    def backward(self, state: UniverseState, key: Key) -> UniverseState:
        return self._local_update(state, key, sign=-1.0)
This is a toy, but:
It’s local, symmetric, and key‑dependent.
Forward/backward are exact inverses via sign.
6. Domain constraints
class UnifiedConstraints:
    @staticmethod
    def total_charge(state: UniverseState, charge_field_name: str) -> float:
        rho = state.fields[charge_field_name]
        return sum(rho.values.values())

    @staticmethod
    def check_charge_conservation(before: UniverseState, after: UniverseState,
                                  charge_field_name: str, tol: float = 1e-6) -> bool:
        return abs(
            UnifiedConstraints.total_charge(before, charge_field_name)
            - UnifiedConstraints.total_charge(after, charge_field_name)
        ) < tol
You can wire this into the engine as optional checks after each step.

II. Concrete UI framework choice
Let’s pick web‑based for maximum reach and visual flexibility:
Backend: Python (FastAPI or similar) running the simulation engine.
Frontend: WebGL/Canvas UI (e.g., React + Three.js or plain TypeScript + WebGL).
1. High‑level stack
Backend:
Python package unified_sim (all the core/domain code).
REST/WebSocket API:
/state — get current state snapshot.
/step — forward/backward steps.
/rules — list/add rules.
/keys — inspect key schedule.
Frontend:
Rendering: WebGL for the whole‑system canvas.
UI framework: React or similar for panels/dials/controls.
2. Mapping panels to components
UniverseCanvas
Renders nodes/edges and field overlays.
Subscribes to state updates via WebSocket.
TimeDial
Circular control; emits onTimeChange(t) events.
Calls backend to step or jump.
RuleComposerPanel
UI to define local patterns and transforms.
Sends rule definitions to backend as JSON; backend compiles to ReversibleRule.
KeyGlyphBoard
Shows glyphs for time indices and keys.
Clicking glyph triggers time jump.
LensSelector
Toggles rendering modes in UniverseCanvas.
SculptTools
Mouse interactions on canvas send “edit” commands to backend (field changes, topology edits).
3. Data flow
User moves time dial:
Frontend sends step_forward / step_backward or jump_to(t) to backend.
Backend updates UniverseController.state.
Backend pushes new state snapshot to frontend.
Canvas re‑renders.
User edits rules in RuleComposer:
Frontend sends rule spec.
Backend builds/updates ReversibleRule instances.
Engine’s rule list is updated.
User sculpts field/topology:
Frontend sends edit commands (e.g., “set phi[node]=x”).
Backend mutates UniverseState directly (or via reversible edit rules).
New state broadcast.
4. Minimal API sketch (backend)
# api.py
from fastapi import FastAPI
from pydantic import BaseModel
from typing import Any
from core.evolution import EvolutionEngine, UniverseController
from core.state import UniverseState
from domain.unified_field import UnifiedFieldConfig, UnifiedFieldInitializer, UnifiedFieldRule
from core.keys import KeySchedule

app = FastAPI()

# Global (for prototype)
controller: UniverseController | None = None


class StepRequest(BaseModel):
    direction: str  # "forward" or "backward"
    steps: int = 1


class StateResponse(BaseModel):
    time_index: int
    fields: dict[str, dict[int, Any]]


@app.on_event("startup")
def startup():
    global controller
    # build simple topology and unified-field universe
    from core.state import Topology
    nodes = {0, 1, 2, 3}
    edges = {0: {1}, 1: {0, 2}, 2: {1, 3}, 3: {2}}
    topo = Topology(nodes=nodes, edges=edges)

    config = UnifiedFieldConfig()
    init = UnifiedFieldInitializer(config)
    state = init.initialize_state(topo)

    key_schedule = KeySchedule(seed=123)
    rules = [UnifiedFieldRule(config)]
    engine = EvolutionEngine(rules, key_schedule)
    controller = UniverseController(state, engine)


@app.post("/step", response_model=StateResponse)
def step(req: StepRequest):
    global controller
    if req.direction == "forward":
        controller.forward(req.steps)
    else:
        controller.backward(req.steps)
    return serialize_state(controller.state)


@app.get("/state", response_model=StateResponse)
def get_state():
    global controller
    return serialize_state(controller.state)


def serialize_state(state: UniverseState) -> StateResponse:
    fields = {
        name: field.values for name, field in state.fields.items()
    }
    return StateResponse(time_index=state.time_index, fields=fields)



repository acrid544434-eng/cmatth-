from typing import List
from .state import UniverseState
from .rules import ReversibleRule
from .keys import KeySchedule


class EvolutionEngine:
    def __init__(self, rules: List[ReversibleRule], key_schedule: KeySchedule):
        self.rules = rules
        self.key_schedule = key_schedule

    def step_forward(self, state: UniverseState) -> UniverseState:
        key = self.key_schedule(state.time_index)
        new_state = state
        for rule in self.rules:
            new_state = rule.forward(new_state, key)
        new_state.time_index = state.time_index + 1
        return new_state

    def step_backward(self, state: UniverseState) -> UniverseState:
        key = self.key_schedule(state.time_index - 1)
        new_state = state
        for rule in reversed(self.rules):
            new_state = rule.backward(new_state, key)
        new_state.time_index = state.time_index - 1
        return new_state


class UniverseController:
    def __init__(self, state: UniverseState, engine: EvolutionEngine):
        self.state = state
        self.engine = engine

    def forward(self, steps: int = 1) -> UniverseState:
        for _ in range(steps):
            self.state = self.engine.step_forward(self.state)
        return self.state

    def backward(self, steps: int = 1) -> UniverseState:
        for _ in range(steps):
            self.state = self.engine.step_backward(self.state)
        return self.state
