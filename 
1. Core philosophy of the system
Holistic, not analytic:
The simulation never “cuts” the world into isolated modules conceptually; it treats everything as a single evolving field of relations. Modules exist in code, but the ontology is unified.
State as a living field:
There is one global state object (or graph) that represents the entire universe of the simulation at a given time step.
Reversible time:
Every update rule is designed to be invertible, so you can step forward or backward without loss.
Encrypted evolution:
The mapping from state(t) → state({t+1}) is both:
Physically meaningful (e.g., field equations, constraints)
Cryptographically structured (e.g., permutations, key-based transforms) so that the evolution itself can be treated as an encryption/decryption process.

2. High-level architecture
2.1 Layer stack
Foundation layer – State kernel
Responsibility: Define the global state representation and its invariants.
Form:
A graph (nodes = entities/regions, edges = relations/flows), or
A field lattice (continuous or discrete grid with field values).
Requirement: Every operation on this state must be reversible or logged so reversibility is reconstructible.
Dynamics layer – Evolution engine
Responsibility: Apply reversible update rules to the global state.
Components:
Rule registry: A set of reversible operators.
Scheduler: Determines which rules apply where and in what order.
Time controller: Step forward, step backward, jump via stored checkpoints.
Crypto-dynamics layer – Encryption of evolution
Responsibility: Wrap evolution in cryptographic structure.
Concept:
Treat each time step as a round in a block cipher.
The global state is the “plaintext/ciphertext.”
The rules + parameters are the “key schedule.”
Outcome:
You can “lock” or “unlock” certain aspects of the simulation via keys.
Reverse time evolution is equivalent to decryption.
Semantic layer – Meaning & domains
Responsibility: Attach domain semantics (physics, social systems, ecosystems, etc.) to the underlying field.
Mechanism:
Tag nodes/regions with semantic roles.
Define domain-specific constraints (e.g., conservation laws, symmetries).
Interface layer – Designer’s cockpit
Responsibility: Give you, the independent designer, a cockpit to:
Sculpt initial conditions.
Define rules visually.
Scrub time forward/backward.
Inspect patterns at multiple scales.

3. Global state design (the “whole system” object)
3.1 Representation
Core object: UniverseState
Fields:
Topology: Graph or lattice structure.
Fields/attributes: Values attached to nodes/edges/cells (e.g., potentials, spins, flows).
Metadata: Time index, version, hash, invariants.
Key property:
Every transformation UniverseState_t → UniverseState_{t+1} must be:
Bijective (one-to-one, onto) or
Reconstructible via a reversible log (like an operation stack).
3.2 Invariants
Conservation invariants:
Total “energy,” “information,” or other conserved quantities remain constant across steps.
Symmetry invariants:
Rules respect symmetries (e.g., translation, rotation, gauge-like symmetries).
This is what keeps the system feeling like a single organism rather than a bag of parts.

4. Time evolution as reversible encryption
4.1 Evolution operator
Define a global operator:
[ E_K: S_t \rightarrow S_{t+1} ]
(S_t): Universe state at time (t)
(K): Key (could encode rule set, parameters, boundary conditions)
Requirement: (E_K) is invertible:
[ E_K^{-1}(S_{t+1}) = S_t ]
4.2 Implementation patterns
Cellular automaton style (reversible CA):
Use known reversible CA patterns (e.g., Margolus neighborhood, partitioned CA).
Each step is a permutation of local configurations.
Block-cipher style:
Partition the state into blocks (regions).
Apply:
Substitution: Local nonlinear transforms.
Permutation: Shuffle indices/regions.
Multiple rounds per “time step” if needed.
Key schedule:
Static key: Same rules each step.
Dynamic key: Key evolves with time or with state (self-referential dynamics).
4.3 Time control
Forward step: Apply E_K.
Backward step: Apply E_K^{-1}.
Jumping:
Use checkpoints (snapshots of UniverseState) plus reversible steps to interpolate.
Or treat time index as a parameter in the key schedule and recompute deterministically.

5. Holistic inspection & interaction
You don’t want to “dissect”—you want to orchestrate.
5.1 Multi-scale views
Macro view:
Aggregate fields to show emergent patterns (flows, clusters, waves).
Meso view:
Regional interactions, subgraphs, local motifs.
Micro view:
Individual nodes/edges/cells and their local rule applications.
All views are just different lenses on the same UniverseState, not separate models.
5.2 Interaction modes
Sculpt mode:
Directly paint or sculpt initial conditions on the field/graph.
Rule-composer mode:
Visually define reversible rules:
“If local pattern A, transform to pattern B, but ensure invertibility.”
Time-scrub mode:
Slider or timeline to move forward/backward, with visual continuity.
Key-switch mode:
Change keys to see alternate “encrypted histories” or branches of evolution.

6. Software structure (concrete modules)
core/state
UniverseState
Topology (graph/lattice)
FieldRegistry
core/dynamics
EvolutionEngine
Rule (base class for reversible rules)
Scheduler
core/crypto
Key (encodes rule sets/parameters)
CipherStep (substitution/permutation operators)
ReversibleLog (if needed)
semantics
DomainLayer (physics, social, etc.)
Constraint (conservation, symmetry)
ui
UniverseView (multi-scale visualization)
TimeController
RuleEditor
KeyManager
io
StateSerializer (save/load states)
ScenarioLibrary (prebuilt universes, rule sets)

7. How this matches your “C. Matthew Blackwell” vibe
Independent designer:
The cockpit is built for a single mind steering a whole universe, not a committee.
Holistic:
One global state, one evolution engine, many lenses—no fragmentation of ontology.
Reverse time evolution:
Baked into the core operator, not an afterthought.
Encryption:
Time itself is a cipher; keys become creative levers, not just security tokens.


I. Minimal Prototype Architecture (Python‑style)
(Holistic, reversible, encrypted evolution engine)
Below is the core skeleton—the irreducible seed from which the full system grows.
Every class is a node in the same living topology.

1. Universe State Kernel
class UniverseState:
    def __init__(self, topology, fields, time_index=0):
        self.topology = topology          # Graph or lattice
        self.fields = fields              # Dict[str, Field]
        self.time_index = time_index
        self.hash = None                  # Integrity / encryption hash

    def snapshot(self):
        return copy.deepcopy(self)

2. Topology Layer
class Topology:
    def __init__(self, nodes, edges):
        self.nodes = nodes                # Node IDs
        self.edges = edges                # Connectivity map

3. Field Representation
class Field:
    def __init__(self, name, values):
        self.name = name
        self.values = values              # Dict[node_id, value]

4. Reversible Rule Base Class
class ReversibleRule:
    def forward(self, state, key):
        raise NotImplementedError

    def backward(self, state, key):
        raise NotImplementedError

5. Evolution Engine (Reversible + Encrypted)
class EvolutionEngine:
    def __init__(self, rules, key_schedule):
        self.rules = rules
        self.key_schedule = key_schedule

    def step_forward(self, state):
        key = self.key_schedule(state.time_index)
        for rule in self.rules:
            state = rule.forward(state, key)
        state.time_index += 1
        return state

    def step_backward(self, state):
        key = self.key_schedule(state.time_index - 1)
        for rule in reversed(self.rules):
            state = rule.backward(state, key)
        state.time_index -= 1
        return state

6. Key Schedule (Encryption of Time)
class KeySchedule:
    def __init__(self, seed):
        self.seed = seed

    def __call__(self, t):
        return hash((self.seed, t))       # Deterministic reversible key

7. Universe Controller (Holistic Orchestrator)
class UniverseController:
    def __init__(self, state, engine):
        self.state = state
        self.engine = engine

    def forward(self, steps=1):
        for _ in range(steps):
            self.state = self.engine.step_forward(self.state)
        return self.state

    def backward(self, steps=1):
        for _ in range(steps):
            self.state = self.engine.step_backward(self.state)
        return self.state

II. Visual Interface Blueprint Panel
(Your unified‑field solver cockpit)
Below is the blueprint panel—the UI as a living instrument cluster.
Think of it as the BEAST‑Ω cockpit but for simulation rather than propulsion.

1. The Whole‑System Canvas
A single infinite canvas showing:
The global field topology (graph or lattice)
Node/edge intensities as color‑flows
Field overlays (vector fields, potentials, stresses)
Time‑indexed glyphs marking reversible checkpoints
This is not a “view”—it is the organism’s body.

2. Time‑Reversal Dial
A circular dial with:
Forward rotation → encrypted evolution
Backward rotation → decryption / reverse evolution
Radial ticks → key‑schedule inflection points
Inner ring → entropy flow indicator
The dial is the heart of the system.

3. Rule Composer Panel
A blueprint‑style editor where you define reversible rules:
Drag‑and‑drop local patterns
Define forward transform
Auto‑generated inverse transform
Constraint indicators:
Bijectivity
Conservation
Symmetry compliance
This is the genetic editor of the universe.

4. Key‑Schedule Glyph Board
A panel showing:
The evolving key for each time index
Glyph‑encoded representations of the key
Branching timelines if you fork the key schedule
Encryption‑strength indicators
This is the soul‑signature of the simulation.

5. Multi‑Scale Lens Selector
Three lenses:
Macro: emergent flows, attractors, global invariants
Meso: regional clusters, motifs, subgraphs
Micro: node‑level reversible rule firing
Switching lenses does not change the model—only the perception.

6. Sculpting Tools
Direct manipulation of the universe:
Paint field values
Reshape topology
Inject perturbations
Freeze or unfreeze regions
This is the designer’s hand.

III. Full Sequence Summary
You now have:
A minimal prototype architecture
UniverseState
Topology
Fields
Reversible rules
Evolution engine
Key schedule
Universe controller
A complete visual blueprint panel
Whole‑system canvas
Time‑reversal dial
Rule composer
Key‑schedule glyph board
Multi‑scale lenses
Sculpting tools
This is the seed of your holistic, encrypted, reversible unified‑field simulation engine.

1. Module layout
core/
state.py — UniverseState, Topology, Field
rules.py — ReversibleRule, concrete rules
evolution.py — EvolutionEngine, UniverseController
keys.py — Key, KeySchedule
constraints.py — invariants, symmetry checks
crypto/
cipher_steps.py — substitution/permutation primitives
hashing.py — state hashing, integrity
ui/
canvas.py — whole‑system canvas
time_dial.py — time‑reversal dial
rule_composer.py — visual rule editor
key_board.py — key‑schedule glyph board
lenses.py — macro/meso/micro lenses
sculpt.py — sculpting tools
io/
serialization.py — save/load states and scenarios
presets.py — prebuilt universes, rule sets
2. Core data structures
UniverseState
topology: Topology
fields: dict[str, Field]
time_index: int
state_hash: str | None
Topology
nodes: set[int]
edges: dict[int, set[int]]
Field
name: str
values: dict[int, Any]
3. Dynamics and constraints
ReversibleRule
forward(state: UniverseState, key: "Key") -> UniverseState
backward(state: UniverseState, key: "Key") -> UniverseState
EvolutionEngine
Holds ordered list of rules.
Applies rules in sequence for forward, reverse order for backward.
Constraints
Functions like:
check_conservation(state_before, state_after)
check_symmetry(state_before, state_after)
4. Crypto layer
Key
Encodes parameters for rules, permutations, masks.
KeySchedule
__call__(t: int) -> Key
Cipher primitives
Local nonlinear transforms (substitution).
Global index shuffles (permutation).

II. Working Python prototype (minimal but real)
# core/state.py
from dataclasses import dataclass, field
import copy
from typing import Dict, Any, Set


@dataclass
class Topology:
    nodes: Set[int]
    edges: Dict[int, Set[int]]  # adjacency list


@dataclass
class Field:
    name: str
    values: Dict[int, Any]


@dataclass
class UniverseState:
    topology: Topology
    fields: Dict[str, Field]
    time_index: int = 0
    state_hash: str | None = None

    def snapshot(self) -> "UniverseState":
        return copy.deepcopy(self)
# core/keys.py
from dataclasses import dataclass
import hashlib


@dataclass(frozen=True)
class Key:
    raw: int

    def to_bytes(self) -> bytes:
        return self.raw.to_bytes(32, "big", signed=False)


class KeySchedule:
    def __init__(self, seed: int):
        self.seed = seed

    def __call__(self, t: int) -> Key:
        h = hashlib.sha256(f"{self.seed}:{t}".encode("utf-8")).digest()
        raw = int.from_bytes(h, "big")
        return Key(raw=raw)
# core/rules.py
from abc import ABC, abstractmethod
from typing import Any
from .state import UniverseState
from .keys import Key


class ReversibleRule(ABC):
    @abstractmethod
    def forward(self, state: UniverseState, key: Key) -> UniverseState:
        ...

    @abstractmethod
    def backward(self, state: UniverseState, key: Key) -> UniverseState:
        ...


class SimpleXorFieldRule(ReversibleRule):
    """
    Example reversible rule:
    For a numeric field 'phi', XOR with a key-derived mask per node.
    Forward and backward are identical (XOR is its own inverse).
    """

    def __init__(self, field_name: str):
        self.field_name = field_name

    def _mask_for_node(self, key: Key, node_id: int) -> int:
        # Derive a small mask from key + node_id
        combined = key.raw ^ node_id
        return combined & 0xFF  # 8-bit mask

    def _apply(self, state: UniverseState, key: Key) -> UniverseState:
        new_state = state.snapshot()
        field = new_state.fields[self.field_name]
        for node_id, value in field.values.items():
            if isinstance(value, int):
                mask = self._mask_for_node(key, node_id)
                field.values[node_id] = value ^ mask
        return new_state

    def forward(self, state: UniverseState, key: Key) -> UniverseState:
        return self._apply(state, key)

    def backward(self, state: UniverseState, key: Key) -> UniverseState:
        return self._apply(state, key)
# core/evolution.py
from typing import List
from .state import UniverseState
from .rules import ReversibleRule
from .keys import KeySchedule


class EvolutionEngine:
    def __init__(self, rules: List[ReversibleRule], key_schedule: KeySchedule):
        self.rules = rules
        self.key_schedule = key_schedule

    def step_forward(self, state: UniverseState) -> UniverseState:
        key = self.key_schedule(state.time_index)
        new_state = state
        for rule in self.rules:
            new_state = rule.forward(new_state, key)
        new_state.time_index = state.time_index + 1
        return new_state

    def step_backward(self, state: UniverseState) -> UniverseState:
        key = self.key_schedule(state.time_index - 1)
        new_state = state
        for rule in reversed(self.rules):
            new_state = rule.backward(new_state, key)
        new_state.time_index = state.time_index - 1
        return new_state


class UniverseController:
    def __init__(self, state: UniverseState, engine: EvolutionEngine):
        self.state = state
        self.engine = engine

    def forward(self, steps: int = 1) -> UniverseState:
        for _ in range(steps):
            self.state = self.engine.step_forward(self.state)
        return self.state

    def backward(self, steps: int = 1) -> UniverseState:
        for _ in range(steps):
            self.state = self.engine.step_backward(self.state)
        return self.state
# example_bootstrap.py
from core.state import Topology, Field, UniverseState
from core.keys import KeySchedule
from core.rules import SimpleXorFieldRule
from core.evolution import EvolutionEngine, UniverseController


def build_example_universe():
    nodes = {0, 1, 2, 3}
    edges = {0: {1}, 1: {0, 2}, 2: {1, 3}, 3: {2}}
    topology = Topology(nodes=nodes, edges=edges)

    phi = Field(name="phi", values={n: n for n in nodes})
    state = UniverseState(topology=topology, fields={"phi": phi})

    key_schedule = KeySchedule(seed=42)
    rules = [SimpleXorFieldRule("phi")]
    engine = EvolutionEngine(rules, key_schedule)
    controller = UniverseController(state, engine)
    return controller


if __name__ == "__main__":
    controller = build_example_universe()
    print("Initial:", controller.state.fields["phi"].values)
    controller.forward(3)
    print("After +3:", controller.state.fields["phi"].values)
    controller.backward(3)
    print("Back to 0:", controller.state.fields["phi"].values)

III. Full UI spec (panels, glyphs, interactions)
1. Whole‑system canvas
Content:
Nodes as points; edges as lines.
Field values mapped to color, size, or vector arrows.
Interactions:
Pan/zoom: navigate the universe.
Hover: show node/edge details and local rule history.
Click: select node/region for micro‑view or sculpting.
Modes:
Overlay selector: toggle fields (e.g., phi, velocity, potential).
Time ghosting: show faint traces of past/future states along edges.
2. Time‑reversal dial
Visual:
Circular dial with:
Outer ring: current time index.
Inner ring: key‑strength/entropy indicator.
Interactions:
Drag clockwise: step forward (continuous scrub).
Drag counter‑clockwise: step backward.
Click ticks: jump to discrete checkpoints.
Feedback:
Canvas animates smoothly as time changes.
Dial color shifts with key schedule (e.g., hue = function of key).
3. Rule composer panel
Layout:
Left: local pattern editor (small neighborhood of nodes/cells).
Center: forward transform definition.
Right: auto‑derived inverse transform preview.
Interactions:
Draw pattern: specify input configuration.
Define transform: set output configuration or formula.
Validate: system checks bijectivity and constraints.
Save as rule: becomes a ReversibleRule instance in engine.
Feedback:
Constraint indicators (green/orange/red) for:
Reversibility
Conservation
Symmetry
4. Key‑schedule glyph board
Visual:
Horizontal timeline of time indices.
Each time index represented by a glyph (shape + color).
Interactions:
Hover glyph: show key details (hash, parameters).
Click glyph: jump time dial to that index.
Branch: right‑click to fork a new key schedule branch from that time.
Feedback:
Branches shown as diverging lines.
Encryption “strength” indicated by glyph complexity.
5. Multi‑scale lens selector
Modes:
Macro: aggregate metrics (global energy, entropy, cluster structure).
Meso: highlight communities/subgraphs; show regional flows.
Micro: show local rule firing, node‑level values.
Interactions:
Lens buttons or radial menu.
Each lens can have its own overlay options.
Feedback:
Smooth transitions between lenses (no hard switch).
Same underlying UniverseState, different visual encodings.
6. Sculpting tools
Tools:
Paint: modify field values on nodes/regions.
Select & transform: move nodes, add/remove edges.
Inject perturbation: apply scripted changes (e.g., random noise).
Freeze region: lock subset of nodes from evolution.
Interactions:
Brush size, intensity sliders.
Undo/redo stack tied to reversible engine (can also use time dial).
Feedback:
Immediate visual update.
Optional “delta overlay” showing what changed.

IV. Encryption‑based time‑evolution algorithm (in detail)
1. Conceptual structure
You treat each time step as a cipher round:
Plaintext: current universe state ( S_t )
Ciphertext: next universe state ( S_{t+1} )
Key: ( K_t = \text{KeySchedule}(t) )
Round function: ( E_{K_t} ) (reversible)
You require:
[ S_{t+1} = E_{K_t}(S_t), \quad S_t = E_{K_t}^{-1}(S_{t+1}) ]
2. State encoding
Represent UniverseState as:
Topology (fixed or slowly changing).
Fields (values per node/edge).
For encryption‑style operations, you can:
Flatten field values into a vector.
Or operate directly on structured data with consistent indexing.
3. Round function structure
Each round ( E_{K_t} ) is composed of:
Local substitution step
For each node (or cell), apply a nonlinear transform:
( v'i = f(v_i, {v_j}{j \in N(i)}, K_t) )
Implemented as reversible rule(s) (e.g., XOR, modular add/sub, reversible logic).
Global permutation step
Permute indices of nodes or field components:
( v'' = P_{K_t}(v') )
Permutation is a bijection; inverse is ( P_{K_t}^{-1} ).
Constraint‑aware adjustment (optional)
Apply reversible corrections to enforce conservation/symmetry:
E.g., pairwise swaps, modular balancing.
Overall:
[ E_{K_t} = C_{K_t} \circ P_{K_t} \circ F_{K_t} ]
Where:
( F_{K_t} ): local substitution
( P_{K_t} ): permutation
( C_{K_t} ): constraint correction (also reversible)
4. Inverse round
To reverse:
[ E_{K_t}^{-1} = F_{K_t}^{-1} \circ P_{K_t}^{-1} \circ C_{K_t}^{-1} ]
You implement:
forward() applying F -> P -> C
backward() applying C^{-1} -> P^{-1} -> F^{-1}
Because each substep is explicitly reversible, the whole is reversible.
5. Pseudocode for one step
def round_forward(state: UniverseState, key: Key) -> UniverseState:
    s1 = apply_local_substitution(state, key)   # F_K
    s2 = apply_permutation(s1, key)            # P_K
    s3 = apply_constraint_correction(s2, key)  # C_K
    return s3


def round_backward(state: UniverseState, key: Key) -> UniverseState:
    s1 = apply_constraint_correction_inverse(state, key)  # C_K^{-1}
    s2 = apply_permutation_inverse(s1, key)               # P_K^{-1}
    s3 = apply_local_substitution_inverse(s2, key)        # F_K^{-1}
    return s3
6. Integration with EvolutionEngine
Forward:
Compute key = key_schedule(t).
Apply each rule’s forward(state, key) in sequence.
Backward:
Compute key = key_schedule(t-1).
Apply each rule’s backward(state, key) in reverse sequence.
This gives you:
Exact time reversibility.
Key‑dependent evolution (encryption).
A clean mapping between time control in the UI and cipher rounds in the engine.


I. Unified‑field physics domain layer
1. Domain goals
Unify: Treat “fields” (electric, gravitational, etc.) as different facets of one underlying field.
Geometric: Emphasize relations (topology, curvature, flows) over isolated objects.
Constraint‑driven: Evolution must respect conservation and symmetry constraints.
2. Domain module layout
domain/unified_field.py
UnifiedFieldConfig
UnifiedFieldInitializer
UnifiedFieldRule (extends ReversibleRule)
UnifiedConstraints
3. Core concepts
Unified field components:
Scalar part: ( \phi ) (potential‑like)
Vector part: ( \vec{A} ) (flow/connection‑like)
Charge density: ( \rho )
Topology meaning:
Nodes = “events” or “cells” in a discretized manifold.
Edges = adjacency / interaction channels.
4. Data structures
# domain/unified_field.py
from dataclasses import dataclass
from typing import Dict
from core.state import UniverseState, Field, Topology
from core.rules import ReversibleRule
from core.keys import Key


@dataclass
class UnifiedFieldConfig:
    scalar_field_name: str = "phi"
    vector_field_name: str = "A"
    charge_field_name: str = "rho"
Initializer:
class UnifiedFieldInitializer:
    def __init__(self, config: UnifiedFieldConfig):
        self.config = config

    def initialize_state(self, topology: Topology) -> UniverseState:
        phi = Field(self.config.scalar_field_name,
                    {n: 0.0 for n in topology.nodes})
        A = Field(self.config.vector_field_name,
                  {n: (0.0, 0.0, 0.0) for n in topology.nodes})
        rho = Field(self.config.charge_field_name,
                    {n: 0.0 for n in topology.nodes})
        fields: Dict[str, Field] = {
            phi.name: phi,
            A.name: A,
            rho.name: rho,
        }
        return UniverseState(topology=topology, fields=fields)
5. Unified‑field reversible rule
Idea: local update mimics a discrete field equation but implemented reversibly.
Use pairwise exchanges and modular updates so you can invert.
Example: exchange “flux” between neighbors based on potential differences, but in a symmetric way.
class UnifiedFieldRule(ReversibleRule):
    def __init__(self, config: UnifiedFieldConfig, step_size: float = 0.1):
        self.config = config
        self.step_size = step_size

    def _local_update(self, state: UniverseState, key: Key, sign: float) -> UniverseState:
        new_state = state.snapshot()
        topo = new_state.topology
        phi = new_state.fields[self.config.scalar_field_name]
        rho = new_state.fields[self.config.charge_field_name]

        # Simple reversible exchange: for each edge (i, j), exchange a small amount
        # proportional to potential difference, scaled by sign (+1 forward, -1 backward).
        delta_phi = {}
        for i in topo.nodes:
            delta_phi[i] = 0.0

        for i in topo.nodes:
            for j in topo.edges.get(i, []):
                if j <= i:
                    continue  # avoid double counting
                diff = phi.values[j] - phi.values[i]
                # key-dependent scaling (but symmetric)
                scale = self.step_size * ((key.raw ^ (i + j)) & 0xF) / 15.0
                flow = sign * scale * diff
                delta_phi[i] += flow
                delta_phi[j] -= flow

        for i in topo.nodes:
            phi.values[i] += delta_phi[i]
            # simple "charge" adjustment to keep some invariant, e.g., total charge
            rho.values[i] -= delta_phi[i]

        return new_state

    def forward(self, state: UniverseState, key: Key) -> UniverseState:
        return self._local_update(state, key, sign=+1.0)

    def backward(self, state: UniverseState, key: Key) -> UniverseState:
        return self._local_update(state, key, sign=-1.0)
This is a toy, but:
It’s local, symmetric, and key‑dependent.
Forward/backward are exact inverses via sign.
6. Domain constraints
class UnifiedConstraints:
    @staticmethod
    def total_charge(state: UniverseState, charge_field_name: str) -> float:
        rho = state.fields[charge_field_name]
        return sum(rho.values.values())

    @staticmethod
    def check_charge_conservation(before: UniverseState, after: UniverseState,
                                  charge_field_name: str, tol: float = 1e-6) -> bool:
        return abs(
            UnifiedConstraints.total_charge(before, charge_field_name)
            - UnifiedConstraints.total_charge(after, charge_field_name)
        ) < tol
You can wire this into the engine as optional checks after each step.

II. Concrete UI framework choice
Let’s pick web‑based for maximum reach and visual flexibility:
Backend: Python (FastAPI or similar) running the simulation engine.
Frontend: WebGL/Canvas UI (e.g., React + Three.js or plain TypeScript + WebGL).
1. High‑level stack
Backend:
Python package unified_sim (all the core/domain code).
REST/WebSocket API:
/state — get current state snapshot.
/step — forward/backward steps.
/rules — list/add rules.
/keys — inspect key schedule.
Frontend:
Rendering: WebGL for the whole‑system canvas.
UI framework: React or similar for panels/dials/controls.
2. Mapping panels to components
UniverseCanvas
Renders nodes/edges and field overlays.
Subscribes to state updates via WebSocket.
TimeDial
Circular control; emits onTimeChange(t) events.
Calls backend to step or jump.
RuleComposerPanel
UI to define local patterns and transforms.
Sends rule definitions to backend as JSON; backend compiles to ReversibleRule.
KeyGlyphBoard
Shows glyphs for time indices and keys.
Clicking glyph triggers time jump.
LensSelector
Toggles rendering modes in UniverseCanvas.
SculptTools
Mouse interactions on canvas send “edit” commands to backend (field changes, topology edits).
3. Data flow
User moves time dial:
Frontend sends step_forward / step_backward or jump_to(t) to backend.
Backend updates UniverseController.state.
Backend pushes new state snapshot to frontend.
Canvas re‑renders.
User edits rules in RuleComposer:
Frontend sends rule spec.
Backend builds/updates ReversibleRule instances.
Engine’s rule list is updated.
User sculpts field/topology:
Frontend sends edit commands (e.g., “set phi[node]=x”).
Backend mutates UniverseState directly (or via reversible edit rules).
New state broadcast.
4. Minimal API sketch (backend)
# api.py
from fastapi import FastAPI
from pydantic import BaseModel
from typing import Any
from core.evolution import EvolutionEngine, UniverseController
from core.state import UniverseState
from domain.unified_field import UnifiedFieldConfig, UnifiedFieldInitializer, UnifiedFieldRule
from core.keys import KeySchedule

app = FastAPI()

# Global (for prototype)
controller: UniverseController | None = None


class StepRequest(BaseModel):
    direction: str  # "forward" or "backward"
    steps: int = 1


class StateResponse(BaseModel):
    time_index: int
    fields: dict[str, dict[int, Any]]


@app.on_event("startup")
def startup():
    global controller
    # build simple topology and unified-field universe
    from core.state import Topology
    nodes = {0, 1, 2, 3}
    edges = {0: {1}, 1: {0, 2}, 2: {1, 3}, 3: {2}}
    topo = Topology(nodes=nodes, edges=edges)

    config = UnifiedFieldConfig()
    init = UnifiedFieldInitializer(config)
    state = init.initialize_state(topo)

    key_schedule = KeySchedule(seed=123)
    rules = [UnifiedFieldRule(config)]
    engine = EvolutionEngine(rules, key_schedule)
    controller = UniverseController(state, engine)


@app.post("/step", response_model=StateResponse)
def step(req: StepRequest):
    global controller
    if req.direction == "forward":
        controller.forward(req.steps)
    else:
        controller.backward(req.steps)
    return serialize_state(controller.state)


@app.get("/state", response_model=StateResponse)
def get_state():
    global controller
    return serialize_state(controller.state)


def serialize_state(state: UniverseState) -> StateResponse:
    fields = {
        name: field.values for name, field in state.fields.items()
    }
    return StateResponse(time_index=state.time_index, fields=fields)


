from dataclasses import dataclass
import hashlib


@dataclass(frozen=True)
class Key:
    raw: int

    def to_bytes(self) -> bytes:
        return self.raw.to_bytes(32, "big", signed=False)


class KeySchedule:
    def __init__(self, seed: int):
        self.seed = seed

    def __call__(self, t: int) -> Key:
        h = hashlib.sha256(f"{self.seed}:{t}".encode("utf-8")).digest()
        raw = int.from_bytes(h, "big")
        return Key(raw=raw)
