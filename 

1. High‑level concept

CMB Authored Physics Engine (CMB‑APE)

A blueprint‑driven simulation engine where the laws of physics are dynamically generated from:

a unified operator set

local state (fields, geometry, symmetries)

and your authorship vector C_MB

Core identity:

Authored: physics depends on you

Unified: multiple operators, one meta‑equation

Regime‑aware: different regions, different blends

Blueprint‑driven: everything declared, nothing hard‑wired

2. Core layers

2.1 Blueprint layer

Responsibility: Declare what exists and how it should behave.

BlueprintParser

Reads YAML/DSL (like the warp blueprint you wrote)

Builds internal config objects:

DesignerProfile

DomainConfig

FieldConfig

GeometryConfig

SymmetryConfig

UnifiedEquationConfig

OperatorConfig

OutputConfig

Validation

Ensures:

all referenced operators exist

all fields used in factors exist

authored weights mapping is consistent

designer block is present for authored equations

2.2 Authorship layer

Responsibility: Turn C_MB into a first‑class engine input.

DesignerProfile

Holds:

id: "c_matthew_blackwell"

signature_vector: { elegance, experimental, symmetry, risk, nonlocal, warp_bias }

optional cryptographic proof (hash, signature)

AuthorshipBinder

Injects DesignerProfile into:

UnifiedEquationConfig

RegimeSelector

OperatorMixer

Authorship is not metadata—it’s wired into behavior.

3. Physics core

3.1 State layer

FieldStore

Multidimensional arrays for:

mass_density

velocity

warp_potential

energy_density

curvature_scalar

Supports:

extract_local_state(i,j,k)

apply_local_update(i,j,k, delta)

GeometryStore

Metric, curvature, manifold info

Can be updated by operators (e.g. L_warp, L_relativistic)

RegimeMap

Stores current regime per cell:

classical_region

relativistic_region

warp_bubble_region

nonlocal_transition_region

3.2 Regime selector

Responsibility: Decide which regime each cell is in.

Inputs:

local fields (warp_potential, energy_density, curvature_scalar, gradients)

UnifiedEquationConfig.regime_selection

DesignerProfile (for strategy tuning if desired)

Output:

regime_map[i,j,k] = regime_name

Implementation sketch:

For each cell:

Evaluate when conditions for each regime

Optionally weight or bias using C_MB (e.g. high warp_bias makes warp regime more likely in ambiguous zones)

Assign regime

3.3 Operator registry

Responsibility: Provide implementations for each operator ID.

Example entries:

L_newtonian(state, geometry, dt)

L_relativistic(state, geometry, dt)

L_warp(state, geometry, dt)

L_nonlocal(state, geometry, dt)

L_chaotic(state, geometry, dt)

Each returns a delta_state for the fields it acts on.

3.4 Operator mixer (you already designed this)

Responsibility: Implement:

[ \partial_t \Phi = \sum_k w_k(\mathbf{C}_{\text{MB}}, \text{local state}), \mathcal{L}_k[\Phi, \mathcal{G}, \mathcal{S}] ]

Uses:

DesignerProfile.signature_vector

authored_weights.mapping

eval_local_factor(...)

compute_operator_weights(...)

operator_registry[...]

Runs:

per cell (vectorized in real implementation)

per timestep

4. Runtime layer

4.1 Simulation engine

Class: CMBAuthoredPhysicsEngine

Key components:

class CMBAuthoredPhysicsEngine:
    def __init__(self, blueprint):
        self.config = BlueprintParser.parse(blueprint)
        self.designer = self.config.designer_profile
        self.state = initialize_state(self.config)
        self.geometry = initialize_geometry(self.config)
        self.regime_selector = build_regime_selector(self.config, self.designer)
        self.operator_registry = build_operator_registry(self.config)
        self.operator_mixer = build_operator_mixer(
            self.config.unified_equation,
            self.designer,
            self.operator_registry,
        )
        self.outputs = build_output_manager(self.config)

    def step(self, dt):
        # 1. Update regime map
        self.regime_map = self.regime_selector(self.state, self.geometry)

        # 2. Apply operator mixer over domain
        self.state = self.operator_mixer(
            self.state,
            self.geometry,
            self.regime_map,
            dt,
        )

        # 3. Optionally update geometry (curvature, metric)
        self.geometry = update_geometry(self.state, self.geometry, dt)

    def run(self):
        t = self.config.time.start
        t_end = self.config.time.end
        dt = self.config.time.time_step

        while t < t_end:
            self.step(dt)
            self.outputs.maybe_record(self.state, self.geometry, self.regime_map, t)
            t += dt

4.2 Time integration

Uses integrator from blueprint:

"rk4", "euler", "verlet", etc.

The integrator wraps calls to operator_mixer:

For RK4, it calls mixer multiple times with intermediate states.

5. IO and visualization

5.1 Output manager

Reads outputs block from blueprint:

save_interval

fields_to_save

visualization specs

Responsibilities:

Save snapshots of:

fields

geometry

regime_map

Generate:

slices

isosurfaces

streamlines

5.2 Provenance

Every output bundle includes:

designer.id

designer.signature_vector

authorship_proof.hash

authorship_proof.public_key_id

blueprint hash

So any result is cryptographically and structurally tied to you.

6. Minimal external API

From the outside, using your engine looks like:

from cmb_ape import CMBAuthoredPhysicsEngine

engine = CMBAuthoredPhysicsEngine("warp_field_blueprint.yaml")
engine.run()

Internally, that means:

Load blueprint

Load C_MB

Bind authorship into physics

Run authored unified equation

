4. Runtime layer

4.1 Simulation engine

Class: CMBAuthoredPhysicsEngine

Key components:

class CMBAuthoredPhysicsEngine:
    def __init__(self, blueprint):
        self.config = BlueprintParser.parse(blueprint)
        self.designer = self.config.designer_profile
        self.state = initialize_state(self.config)
        self.geometry = initialize_geometry(self.config)
        self.regime_selector = build_regime_selector(self.config, self.designer)
        self.operator_registry = build_operator_registry(self.config)
        self.operator_mixer = build_operator_mixer(
            self.config.unified_equation,
            self.designer,
            self.operator_registry,
        )
        self.outputs = build_output_manager(self.config)

    def step(self, dt):
        # 1. Update regime map
        self.regime_map = self.regime_selector(self.state, self.geometry)

        # 2. Apply operator mixer over domain
        self.state = self.operator_mixer(
            self.state,
            self.geometry,
            self.regime_map,
            dt,
        )

        # 3. Optionally update geometry (curvature, metric)
        self.geometry = update_geometry(self.state, self.geometry, dt)

    def run(self):
        t = self.config.time.start
        t_end = self.config.time.end
        dt = self.config.time.time_step

        while t < t_end:
            self.step(dt)
            self.outputs.maybe_record(self.state, self.geometry, self.regime_map, t)
            t += dt

