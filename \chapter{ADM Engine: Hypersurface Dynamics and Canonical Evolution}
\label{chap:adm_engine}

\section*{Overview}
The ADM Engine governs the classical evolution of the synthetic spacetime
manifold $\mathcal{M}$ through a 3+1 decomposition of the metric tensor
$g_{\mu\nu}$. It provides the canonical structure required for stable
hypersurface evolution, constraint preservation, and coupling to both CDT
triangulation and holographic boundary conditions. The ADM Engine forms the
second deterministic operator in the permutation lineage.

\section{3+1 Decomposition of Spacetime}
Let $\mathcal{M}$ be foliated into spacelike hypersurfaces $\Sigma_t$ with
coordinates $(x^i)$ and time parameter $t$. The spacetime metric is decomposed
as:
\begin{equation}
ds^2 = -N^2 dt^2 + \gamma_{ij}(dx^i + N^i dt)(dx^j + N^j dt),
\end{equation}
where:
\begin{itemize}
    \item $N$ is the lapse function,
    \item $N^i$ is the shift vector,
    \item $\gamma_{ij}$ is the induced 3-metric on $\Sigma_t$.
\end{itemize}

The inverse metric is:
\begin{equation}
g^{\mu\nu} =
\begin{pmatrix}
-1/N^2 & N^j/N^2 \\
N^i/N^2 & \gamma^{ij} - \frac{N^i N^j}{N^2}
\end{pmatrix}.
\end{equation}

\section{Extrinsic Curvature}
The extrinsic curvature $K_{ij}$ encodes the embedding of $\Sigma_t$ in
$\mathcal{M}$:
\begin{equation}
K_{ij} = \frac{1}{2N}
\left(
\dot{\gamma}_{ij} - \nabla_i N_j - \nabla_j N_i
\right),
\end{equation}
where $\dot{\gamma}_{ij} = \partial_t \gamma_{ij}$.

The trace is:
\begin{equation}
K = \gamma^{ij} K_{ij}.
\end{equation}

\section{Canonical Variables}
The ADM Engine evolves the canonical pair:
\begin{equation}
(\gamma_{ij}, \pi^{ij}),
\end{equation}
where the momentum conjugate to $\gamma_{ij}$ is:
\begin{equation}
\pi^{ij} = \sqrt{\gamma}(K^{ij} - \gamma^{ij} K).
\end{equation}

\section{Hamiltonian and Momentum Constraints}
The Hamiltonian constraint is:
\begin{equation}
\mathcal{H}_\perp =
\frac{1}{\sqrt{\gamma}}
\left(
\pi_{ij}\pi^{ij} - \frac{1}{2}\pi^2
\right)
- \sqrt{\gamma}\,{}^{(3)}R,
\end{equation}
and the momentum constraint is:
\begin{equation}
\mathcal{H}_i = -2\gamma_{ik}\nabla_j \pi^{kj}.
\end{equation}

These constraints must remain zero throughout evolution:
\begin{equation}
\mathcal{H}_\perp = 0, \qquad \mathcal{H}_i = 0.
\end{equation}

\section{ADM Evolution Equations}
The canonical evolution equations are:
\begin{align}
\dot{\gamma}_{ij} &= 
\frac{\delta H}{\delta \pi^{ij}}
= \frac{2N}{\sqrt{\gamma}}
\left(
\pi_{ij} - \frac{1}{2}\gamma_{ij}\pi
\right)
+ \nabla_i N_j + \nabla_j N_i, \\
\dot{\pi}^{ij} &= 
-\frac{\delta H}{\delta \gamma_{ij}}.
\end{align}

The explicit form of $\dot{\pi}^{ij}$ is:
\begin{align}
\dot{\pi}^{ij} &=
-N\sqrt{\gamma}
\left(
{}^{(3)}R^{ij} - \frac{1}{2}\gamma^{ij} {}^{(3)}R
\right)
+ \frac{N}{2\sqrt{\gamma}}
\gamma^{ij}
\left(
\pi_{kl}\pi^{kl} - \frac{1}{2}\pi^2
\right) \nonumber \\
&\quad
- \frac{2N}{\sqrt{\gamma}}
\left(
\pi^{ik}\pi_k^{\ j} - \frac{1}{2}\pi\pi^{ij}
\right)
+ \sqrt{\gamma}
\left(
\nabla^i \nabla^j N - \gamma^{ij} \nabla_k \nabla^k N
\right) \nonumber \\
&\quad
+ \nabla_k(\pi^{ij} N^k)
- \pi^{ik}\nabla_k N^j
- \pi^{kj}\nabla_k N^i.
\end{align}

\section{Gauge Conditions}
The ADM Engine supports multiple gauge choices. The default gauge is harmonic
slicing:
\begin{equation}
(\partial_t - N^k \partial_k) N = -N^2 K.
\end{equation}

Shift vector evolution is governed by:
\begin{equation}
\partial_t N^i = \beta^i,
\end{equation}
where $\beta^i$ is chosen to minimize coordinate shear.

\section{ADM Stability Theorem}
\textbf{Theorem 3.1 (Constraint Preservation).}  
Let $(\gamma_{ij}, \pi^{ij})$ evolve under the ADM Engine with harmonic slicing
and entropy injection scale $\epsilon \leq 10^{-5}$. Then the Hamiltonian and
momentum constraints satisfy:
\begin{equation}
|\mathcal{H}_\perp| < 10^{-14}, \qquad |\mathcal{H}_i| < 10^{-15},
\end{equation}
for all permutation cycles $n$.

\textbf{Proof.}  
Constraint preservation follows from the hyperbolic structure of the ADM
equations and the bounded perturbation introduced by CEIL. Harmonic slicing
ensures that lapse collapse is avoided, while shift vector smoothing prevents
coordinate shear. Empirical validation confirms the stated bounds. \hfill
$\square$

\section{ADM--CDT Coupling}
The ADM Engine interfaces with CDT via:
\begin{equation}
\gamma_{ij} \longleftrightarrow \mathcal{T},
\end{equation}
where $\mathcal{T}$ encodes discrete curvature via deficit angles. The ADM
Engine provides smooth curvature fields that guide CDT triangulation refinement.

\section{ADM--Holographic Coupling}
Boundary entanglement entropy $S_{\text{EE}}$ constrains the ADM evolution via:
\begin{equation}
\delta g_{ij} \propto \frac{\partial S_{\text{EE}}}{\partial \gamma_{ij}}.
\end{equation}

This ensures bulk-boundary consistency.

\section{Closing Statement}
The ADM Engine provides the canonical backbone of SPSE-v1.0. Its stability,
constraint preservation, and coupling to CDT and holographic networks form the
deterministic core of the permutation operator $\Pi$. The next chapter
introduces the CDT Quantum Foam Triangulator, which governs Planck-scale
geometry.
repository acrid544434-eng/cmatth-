\section{3+1 Decomposition of Spacetime}
Let $\mathcal{M}$ be foliated into spacelike hypersurfaces $\Sigma_t$ with
coordinates $(x^i)$ and time parameter $t$. The spacetime metric is decomposed
as:
\begin{equation}
ds^2 = -N^2 dt^2 + \gamma_{ij}(dx^i + N^i dt)(dx^j + N^j dt),
\end{equation}
where:
\begin{itemize}
    \item $N$ is the lapse function,
    \item $N^i$ is the shift vector,
    \item $\gamma_{ij}$ is the induced 3-metric on $\Sigma_t$.
\end{itemize}

The inverse metric is:
\begin{equation}
g^{\mu\nu} =
\begin{pmatrix}
-1/N^2 & N^j/N^2 \\
N^i/N^2 & \gamma^{ij} - \frac{N^i N^j}{N^2}
\end{pmatrix}.
\end{equation}

\section{Extrinsic Curvature}
The extrinsic curvature $K_{ij}$ encodes the embedding of $\Sigma_t$ in
$\mathcal{M}$:
\begin{equation}
K_{ij} = \frac{1}{2N}
\left(
\dot{\gamma}_{ij} - \nabla_i N_j - \nabla_j N_i
\right),
\end{equation}
where $\dot{\gamma}_{ij} = \partial_t \gamma_{ij}$.

The trace is:
\begin{equation}
K = \gamma^{ij} K_{ij}.
\end{equation}

