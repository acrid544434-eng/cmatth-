\begin{equation}
\pi^{ij} = \sqrt{\gamma}(K^{ij} - \gamma^{ij} K).
\end{equation}

\section{Hamiltonian and Momentum Constraints}
The Hamiltonian constraint is:
\begin{equation}
\mathcal{H}_\perp =
\frac{1}{\sqrt{\gamma}}
\left(
\pi_{ij}\pi^{ij} - \frac{1}{2}\pi^2
\right)
- \sqrt{\gamma}\,{}^{(3)}R,
\end{equation}
and the momentum constraint is:
\begin{equation}
\mathcal{H}_i = -2\gamma_{ik}\nabla_j \pi^{kj}.
\end{equation}

These constraints must remain zero throughout evolution:
\begin{equation}
\mathcal{H}_\perp = 0, \qquad \mathcal{H}_i = 0.
\end{equation}

\section{ADM Evolution Equations}
