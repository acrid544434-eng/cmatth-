\section{Variational Derivation}

\begin{definition}[Total Action]
\[
\mathcal{S}_{\text{total}}
= \int_{\mathcal{M}}
\left[
\Ktensor (\partial_\mu \PsiField)(\partial_\nu \PsiField^\dagger)
- \Potential(\PsiField)
+ \Flux \partial_\mu \PsiField
+ \LambdaReg |\PsiField|^2
\right]
\sqrt{|g|}\, d^4x.
\]
\end{definition}

\begin{lemma}[Euler--Lagrange Equation]
\[
\frac{\delta \mathcal{S}_{\text{total}}}{\delta \PsiField^\dagger} = 0.
\]
\end{lemma}

\begin{theorem}[Master Evolution Equation]
\[
\nabla_\mu(\Ktensor \partial_\nu \PsiField)
+ \Potential'(\PsiField)
= \Flux \partial_\mu \PsiField
+ \LambdaReg \PsiField.
\]
\end{theorem}

\begin{proof}
Direct variation of the action with respect to $\PsiField^\dagger$,
followed by integration by parts and application of boundary
conditions.
\end{proof}

