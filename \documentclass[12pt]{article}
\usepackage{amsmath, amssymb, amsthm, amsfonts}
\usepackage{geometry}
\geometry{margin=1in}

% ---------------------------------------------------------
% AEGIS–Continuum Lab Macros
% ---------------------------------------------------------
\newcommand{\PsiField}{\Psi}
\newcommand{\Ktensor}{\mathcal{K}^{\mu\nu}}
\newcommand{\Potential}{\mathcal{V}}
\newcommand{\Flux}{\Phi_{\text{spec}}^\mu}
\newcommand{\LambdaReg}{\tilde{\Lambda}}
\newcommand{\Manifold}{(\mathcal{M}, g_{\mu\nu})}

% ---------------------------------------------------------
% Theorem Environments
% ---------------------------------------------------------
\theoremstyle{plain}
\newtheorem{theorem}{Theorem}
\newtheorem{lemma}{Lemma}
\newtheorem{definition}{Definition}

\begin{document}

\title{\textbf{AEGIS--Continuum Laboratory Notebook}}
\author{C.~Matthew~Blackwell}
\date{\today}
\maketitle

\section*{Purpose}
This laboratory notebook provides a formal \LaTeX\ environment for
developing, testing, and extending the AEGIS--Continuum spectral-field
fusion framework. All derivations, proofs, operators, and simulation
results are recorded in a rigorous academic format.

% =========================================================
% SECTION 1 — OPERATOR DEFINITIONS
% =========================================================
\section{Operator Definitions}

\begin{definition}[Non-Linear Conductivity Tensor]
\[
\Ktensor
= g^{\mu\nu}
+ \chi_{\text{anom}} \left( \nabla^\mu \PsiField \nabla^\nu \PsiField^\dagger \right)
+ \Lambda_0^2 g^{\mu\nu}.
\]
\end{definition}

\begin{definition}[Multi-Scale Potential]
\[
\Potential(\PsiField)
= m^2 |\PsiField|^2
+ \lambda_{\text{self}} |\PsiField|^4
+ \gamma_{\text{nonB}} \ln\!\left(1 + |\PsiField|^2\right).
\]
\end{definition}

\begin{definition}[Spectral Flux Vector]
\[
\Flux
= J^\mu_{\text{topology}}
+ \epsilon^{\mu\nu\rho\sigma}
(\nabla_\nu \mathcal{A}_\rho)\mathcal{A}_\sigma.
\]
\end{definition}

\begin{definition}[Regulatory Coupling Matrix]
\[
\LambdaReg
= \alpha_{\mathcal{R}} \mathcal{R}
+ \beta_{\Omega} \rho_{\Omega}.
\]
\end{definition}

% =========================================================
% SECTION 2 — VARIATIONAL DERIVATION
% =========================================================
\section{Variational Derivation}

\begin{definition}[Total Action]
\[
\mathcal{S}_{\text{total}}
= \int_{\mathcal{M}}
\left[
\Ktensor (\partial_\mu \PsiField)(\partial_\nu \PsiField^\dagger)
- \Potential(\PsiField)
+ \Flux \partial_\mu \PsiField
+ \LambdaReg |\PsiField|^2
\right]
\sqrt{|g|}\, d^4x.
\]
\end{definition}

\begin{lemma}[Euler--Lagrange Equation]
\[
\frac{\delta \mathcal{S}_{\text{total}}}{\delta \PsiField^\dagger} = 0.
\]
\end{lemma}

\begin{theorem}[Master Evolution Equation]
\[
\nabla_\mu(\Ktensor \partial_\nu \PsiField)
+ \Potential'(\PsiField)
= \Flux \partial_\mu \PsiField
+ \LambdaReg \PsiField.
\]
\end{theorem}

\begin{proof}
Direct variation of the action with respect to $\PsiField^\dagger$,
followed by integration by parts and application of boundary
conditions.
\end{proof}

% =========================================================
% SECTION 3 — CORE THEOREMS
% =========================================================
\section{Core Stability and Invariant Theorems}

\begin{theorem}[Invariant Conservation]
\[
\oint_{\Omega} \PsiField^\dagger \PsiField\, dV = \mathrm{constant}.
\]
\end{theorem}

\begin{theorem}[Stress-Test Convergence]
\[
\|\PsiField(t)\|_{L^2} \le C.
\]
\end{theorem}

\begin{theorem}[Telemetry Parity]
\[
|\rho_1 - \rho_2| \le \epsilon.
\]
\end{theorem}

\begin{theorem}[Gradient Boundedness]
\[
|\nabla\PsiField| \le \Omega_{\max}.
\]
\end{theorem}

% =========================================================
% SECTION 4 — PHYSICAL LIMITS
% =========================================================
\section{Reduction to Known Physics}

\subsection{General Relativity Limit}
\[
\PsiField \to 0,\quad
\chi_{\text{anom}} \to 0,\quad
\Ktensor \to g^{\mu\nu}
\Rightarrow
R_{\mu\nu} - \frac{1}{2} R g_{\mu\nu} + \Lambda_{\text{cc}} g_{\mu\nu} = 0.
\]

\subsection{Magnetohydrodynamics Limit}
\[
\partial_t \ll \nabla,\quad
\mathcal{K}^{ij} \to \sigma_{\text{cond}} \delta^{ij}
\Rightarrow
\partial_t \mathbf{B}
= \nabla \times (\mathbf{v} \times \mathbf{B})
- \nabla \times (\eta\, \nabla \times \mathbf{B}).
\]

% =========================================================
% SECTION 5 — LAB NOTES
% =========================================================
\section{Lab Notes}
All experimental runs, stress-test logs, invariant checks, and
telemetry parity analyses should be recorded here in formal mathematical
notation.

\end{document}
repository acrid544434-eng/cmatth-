\section{Operator Definitions}

\begin{definition}[Non-Linear Conductivity Tensor]
\[
\Ktensor
= g^{\mu\nu}
+ \chi_{\text{anom}} \left( \nabla^\mu \PsiField \nabla^\nu \PsiField^\dagger \right)
+ \Lambda_0^2 g^{\mu\nu}.
\]
\end{definition}

\begin{definition}[Multi-Scale Potential]
\[
\Potential(\PsiField)
= m^2 |\PsiField|^2
+ \lambda_{\text{self}} |\PsiField|^4
+ \gamma_{\text{nonB}} \ln\!\left(1 + |\PsiField|^2\right).
\]
\end{definition}

\begin{definition}[Spectral Flux Vector]
\[
\Flux
= J^\mu_{\text{topology}}
+ \epsilon^{\mu\nu\rho\sigma}
(\nabla_\nu \mathcal{A}_\rho)\mathcal{A}_\sigma.
\]
\end{definition}

\begin{definition}[Regulatory Coupling Matrix]
\[
\LambdaReg
= \alpha_{\mathcal{R}} \mathcal{R}
+ \beta_{\Omega} \rho_{\Omega}.
\]
\end{definition}

