\chapter{Governing Equations of the DF-HITSE Architecture}

\section{State Vector and Domain}
Let the state vector be
\[
\mathbf{U}(x,t) =
\begin{bmatrix}
H(x,t) \\ Q(x,t) \\ \mu(x,t)
\end{bmatrix},
\]
representing hydraulic head, volumetric flow rate, and dynamic viscosity over a conduit 
domain $\Omega \subset \mathbb{R}$.

\section{Nonlinear Evolution System}
The governing dynamics satisfy
\begin{equation}
\frac{\partial \mathbf{U}}{\partial t}
+ \mathbf{A}(\mathbf{U})\frac{\partial \mathbf{U}}{\partial x}
+ \mathbf{B}(\mathbf{U})\mathbf{U}
= \mathbf{F}(x,t),
\label{eq:dfhitse_pde}
\end{equation}
where $\mathbf{A}$ encodes convective celerity, $\mathbf{B}$ models frictional damping, 
and $\mathbf{F}$ represents telemetry forcing.

