\chapter{Hydrodynamic Stress Boundedness}

\section{Lyapunov Energy Functional}
Define
\[
\mathcal{E}(t)
= \frac{1}{2}\int_{\Omega}
\left( \alpha H^2 + \beta Q^2 + \gamma \mu^2 \right) dx.
\]

\begin{theorem}[Hydrodynamic Stress Boundedness]
Assume $\|\mathbf{F}\|_{L^2} \le M < \infty$. Then $\mathbf{U}(x,t)$ remains uniformly 
bounded in $H^1(\Omega)$ if
\[
\Delta t \le \frac{\Delta x}{|\lambda_{\max}(\mathbf{A})|},
\qquad
\mathrm{Re} \le \mathrm{Re}_{\mathrm{crit}}.
\]
\end{theorem}

\begin{proof}
Differentiating $\mathcal{E}(t)$ yields
\[
\frac{d\mathcal{E}}{dt}
= -\int_{\Omega}\left(\frac{fQ|Q|}{2DA^2}\right)dx
+ \int_{\Omega}\mathbf{U}^T\mathbf{F}(x,t)dx.
\]
Applying Young's inequality and Gronwall's lemma gives
\[
\mathcal{E}(t)
\le \mathcal{E}(0)e^{-\sigma t}
+ \frac{M^2}{\sigma}(1-e^{-\sigma t}),
\]
ensuring boundedness.
\end{proof}

