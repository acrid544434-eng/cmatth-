\chapter{Symplectic Integration}

\section{Störmer-Verlet Scheme}
\[
\begin{aligned}
p^{n+1/2} &= p^n - \frac{\Delta t}{2}\left[
\frac{\delta\mathcal{H}}{\delta q}(q^n)
+ \mathcal{R}(q^n,p^{n+1/2})p^{n+1/2}
- F(x,t_n)
\right], \\
q^{n+1} &= q^n + \Delta t\frac{\delta\mathcal{H}}{\delta p}(p^{n+1/2}), \\
p^{n+1} &= p^{n+1/2} - \frac{\Delta t}{2}\left[
\frac{\delta\mathcal{H}}{\delta q}(q^{n+1})
+ \mathcal{R}(q^{n+1},p^{n+1/2})p^{n+1/2}
- F(x,t_{n+1})
\right].
\end{aligned}
\]

\begin{theorem}[Symplectic Invariance]
For $\mathcal{R}=0$ and $F=0$, the integrator preserves $\omega = dq \wedge dp$ and
\[
\det\left(
\frac{\partial(q^{n+1},p^{n+1})}{\partial(q^n,p^n)}
\right)=1.
\]
\end{theorem}

