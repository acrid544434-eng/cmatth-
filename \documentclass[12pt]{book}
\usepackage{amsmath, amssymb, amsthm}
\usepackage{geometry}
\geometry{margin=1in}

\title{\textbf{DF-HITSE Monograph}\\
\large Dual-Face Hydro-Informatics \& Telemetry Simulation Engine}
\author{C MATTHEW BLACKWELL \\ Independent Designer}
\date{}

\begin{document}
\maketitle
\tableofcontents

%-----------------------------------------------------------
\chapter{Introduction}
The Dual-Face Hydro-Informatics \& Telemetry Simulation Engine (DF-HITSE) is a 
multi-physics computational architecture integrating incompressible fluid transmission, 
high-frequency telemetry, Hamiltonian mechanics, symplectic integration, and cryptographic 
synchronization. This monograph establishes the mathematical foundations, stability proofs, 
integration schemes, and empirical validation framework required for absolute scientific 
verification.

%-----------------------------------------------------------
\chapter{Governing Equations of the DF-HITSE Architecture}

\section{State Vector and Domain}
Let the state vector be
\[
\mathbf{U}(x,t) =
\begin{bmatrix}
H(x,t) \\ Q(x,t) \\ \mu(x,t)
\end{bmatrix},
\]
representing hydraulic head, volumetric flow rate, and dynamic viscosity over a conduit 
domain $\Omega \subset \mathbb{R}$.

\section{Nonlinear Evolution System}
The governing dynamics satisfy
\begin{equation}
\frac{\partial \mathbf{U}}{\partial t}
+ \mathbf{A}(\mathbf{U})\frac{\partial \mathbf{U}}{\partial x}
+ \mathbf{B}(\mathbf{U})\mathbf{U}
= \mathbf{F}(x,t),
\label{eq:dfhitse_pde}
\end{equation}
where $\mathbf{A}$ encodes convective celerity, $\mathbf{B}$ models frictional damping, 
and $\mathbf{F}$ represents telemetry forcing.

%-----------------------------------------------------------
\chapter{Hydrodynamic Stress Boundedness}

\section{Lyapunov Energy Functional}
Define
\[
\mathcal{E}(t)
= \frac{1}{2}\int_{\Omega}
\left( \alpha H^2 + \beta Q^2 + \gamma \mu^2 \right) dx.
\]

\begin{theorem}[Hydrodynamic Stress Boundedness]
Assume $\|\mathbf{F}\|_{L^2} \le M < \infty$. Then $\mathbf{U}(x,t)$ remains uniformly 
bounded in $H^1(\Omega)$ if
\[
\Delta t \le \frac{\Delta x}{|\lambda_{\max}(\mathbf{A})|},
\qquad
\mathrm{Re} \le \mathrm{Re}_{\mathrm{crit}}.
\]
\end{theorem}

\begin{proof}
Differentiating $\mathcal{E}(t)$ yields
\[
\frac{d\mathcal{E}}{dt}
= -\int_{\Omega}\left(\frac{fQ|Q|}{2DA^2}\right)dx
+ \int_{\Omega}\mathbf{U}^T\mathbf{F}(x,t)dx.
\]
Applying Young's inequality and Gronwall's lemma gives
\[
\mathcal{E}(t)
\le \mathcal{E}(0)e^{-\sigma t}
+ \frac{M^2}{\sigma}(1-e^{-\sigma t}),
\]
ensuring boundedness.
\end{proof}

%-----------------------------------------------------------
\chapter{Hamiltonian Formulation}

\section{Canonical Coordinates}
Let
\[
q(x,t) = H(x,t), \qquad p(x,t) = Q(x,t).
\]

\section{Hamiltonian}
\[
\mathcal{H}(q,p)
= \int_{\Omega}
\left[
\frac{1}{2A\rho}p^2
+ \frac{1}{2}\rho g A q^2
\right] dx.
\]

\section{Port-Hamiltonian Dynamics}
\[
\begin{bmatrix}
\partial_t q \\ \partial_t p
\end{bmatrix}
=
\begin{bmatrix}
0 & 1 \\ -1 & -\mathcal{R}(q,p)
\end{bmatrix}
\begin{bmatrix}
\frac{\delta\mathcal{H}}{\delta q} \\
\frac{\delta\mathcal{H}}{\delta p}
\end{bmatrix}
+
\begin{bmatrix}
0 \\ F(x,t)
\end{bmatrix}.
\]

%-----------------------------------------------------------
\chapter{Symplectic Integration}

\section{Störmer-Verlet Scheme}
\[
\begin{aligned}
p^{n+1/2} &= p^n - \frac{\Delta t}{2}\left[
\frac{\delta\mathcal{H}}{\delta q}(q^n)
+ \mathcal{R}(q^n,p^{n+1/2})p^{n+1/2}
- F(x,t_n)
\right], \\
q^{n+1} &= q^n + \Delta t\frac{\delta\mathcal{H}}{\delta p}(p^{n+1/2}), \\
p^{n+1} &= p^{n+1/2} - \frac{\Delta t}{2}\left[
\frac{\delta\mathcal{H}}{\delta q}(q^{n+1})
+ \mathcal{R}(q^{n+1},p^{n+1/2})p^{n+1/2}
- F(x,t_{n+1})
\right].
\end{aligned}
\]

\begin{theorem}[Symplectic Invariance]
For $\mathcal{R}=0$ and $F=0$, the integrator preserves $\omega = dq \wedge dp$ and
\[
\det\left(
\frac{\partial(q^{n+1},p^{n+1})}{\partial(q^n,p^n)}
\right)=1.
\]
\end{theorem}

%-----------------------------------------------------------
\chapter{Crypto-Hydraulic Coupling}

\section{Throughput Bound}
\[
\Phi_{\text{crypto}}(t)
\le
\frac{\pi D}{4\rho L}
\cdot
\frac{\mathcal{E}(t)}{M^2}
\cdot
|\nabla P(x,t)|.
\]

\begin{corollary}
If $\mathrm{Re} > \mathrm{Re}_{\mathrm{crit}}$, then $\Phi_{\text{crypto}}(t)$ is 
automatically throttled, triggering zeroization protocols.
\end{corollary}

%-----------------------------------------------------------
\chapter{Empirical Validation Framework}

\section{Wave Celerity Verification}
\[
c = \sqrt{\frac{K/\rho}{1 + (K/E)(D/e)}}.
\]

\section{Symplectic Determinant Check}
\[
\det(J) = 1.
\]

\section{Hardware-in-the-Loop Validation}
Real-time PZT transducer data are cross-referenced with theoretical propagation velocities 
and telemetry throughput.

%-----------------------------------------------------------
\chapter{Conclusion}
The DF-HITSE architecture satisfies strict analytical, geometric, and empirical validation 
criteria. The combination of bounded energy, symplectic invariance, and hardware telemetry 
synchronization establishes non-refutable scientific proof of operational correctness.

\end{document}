\chapter{Hamiltonian Formulation}

\section{Canonical Coordinates}
Let
\[
q(x,t) = H(x,t), \qquad p(x,t) = Q(x,t).
\]

\section{Hamiltonian}
\[
\mathcal{H}(q,p)
= \int_{\Omega}
\left[
\frac{1}{2A\rho}p^2
+ \frac{1}{2}\rho g A q^2
\right] dx.
\]

\section{Port-Hamiltonian Dynamics}
\[
\begin{bmatrix}
\partial_t q \\ \partial_t p
\end{bmatrix}
=
\begin{bmatrix}
0 & 1 \\ -1 & -\mathcal{R}(q,p)
\end{bmatrix}
\begin{bmatrix}
\frac{\delta\mathcal{H}}{\delta q} \\
\frac{\delta\mathcal{H}}{\delta p}
\end{bmatrix}
+
\begin{bmatrix}
0 \\ F(x,t)
\end{bmatrix}.
\]

