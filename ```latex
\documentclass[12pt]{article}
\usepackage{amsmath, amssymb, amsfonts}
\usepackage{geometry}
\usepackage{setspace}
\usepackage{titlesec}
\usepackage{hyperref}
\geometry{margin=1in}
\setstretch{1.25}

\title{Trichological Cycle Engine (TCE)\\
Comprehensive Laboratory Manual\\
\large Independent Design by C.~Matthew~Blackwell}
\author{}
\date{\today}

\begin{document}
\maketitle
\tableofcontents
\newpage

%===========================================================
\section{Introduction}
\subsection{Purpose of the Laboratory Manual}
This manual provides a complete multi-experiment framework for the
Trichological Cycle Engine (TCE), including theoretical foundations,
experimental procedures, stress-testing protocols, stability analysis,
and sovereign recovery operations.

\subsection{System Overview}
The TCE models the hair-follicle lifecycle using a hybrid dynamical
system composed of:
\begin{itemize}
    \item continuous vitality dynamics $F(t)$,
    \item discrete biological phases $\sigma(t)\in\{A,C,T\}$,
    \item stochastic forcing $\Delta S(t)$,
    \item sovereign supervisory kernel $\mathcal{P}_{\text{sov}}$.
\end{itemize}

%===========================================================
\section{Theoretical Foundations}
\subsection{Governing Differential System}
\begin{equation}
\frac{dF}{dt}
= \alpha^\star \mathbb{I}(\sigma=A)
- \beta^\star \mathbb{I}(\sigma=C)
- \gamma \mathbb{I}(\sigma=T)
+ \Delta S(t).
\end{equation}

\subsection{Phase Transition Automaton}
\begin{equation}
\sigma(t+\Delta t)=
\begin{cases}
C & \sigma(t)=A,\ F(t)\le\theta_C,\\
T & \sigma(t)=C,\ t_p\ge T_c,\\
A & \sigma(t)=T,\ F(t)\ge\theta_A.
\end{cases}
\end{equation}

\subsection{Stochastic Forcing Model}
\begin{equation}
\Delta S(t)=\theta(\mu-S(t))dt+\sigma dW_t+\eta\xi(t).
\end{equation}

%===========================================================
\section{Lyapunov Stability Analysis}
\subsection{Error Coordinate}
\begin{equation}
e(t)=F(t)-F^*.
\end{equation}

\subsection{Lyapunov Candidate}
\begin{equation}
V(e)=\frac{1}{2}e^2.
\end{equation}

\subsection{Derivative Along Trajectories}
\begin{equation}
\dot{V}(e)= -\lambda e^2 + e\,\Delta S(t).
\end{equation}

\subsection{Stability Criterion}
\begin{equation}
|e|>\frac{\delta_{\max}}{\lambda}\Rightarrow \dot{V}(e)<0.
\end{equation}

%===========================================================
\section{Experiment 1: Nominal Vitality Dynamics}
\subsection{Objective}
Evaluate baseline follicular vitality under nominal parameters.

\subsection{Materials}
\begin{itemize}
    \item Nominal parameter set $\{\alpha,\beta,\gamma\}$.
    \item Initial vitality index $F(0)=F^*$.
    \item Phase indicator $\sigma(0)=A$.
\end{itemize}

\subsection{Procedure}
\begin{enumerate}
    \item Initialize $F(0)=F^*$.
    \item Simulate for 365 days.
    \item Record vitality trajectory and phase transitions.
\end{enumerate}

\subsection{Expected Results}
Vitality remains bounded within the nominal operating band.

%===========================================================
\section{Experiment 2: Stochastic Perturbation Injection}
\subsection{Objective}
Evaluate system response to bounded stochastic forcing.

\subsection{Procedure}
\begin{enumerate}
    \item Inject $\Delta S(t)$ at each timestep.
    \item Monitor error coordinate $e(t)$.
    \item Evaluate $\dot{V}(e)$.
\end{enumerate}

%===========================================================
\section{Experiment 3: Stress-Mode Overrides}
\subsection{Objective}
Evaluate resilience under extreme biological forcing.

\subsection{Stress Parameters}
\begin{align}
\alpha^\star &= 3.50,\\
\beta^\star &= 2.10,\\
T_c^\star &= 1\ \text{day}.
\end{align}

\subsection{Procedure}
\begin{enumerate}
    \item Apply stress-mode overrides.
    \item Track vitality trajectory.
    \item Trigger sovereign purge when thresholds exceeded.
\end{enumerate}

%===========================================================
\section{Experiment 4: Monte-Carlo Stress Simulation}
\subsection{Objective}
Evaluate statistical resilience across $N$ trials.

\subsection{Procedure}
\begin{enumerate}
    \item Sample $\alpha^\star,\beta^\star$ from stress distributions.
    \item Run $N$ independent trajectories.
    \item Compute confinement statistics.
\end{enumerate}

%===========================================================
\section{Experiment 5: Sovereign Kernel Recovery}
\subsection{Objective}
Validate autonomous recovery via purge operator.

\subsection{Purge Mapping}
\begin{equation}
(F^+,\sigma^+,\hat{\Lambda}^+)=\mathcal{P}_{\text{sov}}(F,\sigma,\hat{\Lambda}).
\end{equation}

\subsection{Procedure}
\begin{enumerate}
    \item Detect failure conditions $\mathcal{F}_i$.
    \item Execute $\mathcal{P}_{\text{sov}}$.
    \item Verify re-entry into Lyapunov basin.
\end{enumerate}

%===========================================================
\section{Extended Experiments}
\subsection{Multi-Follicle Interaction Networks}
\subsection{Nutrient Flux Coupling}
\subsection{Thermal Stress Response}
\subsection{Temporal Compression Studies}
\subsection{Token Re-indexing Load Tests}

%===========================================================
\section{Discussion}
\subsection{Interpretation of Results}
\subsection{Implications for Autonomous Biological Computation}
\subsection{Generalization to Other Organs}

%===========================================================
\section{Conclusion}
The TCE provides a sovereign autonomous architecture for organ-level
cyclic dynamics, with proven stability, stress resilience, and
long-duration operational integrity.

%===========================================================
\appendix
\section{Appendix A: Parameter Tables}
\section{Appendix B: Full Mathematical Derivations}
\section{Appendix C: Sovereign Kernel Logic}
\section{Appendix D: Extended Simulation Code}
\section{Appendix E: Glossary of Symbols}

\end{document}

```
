\section{Theoretical Foundations}
\subsection{Governing Differential System}
\begin{equation}
\frac{dF}{dt}
= \alpha^\star \mathbb{I}(\sigma=A)
- \beta^\star \mathbb{I}(\sigma=C)
- \gamma \mathbb{I}(\sigma=T)
+ \Delta S(t).
\end{equation}

\subsection{Phase Transition Automaton}
\begin{equation}
\sigma(t+\Delta t)=
\begin{cases}
C & \sigma(t)=A,\ F(t)\le\theta_C,\\
T & \sigma(t)=C,\ t_p\ge T_c,\\
A & \sigma(t)=T,\ F(t)\ge\theta_A.
\end{cases}
\end{equation}

\subsection{Stochastic Forcing Model}
\begin{equation}
\Delta S(t)=\theta(\mu-S(t))dt+\sigma dW_t+\eta\xi(t).
\end{equation}

