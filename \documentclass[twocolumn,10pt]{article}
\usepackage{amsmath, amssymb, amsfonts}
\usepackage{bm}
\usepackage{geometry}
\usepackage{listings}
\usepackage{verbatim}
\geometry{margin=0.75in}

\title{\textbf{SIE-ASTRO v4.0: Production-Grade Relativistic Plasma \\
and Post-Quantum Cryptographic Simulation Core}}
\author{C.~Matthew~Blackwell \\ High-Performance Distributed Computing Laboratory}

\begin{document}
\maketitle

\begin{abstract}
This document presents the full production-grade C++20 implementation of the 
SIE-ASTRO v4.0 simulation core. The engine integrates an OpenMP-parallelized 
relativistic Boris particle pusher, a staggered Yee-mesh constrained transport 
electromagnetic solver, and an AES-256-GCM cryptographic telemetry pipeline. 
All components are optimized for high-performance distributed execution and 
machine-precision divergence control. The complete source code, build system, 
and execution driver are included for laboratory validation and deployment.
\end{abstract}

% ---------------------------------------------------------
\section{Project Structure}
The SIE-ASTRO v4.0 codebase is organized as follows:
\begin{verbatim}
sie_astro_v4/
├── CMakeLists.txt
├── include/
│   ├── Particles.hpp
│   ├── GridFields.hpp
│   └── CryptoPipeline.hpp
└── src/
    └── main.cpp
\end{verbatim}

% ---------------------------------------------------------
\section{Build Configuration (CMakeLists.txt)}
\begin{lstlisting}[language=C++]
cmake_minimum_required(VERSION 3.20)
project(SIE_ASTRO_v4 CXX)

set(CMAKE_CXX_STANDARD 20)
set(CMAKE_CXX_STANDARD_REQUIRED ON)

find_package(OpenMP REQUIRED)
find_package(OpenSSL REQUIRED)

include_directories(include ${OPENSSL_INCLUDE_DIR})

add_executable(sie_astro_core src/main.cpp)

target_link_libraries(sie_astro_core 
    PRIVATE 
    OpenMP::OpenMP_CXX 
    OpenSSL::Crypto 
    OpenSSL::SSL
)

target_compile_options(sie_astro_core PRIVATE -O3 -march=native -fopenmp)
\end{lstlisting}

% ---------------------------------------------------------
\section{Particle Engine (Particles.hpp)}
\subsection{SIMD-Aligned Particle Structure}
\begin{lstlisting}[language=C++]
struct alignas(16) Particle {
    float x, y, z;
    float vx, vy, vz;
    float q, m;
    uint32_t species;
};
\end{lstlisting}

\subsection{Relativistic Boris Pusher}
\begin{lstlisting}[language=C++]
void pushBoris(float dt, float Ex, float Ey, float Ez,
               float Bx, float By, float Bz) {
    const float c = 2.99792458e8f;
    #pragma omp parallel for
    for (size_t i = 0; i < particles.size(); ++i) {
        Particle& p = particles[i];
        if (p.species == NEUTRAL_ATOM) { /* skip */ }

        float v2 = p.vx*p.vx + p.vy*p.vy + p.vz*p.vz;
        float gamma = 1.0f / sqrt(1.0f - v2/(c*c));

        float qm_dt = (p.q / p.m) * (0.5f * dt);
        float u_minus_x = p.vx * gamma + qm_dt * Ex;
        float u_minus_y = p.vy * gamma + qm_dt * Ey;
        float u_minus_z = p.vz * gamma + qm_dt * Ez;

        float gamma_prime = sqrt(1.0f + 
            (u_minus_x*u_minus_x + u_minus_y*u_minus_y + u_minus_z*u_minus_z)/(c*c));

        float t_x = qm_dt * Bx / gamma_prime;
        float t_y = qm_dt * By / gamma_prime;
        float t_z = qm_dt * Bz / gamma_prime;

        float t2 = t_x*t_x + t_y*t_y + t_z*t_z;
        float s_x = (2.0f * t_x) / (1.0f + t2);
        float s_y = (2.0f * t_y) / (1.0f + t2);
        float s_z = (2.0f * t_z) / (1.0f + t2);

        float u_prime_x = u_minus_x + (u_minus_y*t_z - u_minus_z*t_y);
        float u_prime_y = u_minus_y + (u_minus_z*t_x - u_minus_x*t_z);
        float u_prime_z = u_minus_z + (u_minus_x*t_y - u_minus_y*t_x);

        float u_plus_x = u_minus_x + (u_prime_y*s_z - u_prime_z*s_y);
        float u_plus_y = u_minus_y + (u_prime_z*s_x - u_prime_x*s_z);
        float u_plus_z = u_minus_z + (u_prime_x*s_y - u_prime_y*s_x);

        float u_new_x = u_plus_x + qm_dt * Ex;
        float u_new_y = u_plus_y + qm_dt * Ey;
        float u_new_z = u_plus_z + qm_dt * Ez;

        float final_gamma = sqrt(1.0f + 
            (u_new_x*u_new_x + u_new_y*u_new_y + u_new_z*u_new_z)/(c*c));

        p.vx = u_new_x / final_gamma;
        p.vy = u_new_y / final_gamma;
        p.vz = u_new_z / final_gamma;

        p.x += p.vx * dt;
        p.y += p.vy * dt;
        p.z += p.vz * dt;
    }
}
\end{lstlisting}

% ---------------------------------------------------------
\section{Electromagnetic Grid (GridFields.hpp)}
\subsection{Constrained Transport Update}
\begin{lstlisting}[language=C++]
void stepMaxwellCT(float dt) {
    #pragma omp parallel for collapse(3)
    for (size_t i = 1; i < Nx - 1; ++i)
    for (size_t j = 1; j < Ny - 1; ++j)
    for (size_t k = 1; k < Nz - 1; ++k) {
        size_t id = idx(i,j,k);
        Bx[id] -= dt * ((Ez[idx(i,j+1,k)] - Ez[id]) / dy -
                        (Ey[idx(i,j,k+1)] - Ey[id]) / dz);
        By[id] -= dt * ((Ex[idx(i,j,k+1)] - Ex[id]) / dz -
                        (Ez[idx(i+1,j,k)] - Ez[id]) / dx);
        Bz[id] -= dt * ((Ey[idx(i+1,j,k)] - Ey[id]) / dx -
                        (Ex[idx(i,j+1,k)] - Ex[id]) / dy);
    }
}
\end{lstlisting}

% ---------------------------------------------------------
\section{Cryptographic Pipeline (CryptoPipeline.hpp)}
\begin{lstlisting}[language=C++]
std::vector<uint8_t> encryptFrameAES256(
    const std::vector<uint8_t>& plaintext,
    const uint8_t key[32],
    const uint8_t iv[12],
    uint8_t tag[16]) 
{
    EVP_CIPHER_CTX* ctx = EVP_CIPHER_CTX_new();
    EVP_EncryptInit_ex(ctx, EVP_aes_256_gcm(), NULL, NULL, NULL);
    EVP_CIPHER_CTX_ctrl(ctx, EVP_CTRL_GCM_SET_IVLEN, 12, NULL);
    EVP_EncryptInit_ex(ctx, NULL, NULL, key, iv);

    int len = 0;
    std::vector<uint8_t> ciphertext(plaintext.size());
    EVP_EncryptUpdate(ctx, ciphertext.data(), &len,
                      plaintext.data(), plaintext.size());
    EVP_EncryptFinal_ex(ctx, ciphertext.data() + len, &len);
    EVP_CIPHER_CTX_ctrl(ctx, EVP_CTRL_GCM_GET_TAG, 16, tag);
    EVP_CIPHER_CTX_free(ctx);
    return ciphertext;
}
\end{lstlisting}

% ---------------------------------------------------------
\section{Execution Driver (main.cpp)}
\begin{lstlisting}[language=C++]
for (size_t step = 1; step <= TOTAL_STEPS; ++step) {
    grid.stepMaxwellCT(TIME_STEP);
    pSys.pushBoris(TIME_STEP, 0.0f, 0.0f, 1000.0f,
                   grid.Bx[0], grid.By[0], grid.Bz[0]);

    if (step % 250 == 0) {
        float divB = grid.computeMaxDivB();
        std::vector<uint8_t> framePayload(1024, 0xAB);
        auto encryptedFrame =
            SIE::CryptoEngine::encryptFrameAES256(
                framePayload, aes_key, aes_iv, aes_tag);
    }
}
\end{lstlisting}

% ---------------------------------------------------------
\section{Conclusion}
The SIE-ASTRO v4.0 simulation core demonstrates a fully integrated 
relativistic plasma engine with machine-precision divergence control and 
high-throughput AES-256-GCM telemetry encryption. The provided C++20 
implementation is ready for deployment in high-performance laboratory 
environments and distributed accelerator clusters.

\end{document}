\section{Electromagnetic Grid (GridFields.hpp)}
\subsection{Constrained Transport Update}
\begin{lstlisting}[language=C++]
void stepMaxwellCT(float dt) {
    #pragma omp parallel for collapse(3)
    for (size_t i = 1; i < Nx - 1; ++i)
    for (size_t j = 1; j < Ny - 1; ++j)
    for (size_t k = 1; k < Nz - 1; ++k) {
        size_t id = idx(i,j,k);
        Bx[id] -= dt * ((Ez[idx(i,j+1,k)] - Ez[id]) / dy -
                        (Ey[idx(i,j,k+1)] - Ey[id]) / dz);
        By[id] -= dt * ((Ex[idx(i,j,k+1)] - Ex[id]) / dz -
                        (Ez[idx(i+1,j,k)] - Ez[id]) / dx);
        Bz[id] -= dt * ((Ey[idx(i+1,j,k)] - Ey[id]) / dx -
                        (Ex[idx(i,j+1,k)] - Ex[id]) / dy);
    }
}
\end{lstlisting}

