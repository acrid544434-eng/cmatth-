\subsection{Relativistic Boris Pusher}
\begin{lstlisting}[language=C++]
void pushBoris(float dt, float Ex, float Ey, float Ez,
               float Bx, float By, float Bz) {
    const float c = 2.99792458e8f;
    #pragma omp parallel for
    for (size_t i = 0; i < particles.size(); ++i) {
        Particle& p = particles[i];
        if (p.species == NEUTRAL_ATOM) { /* skip */ }

        float v2 = p.vx*p.vx + p.vy*p.vy + p.vz*p.vz;
        float gamma = 1.0f / sqrt(1.0f - v2/(c*c));

        float qm_dt = (p.q / p.m) * (0.5f * dt);
        float u_minus_x = p.vx * gamma + qm_dt * Ex;
        float u_minus_y = p.vy * gamma + qm_dt * Ey;
        float u_minus_z = p.vz * gamma + qm_dt * Ez;

        float gamma_prime = sqrt(1.0f + 
            (u_minus_x*u_minus_x + u_minus_y*u_minus_y + u_minus_z*u_minus_z)/(c*c));

        float t_x = qm_dt * Bx / gamma_prime;
        float t_y = qm_dt * By / gamma_prime;
        float t_z = qm_dt * Bz / gamma_prime;

        float t2 = t_x*t_x + t_y*t_y + t_z*t_z;
        float s_x = (2.0f * t_x) / (1.0f + t2);
        float s_y = (2.0f * t_y) / (1.0f + t2);
        float s_z = (2.0f * t_z) / (1.0f + t2);

        float u_prime_x = u_minus_x + (u_minus_y*t_z - u_minus_z*t_y);
        float u_prime_y = u_minus_y + (u_minus_z*t_x - u_minus_x*t_z);
        float u_prime_z = u_minus_z + (u_minus_x*t_y - u_minus_y*t_x);

        float u_plus_x = u_minus_x + (u_prime_y*s_z - u_prime_z*s_y);
        float u_plus_y = u_minus_y + (u_prime_z*s_x - u_prime_x*s_z);
        float u_plus_z = u_minus_z + (u_prime_x*s_y - u_prime_y*s_x);

        float u_new_x = u_plus_x + qm_dt * Ex;
        float u_new_y = u_plus_y + qm_dt * Ey;
        float u_new_z = u_plus_z + qm_dt * Ez;

        float final_gamma = sqrt(1.0f + 
            (u_new_x*u_new_x + u_new_y*u_new_y + u_new_z*u_new_z)/(c*c));

        p.vx = u_new_x / final_gamma;
        p.vy = u_new_y / final_gamma;
        p.vz = u_new_z / final_gamma;

        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.z += p.vz * dt;
    }
}
\end{lstlisting}

