\chapter{PDE Solver: WENO-5 and TVD-RK3}

\section{Shock-Stable Conservation Laws}

\begin{definition}[Total Variation]
For a discrete field $\mathbf{U}_i$, the total variation is
\begin{equation}
    \operatorname{TV}(\mathbf{U}) = \sum_i \|\mathbf{U}_{i+1} - \mathbf{U}_i\|.
\end{equation}
\end{definition}

\begin{lemma}[WENO-5 TVD Property]
The fifth-order WENO reconstruction operator satisfies
\begin{equation}
    \operatorname{TV}\big(\mathcal{R}_{\text{WENO}}(\mathbf{U}^n)\big)
    \le \operatorname{TV}(\mathbf{U}^n).
\end{equation}
\end{lemma}

\begin{proof}
WENO-5 weights are constructed from smoothness indicators that suppress
oscillations near discontinuities. The convex combination of stencils ensures
monotonicity, yielding the TVD bound.
\end{proof}

\begin{theorem}[TVD-RK3 Stability]
The third-order TVD Runge--Kutta scheme satisfies
\begin{equation}
    \operatorname{TV}(\mathbf{U}^{n+1}) \le \operatorname{TV}(\mathbf{U}^n).
\end{equation}
\end{theorem}

\begin{proof}
Each RK substep is a convex combination of forward Euler steps, each of which is
TVD under the WENO flux. Convexity preserves the inequality.
\end{proof}

\begin{corollary}[Energy Conservation]
The density field $\rho(\mathbf{r},t)$ remains free of artificial numerical
energy growth, and the refractive index field
$n(\mathbf{r},t) = 1 + K\rho(\mathbf{r},t)$ inherits this stability.
\end{corollary}

