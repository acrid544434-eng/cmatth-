\chapter{Hamiltonian Ray-Tracing System}

\section{Constraint Hamiltonian}

\begin{definition}[Eikonal Mass-Shell Constraint]
The optical Hamiltonian governing ray propagation through a refractive index
field $n(\mathbf{r})$ is defined by
\begin{equation}
    H_c(\mathbf{r},\mathbf{p}) = \mathbf{p}^2 - n(\mathbf{r})^2 = 0.
\end{equation}
\end{definition}

\begin{lemma}[Canonical Momentum]
Under the unit-speed constraint $\|\dot{\mathbf{r}}\| = 1$, the canonical
momentum satisfies
\begin{equation}
    \mathbf{p} = n(\mathbf{r})\dot{\mathbf{r}}, \qquad \|\mathbf{p}\| = n(\mathbf{r}).
\end{equation}
\end{lemma}

\begin{proof}
The optical Lagrangian is $L = n(\mathbf{r})\|\dot{\mathbf{r}}\|$. Differentiating
with respect to $\dot{\mathbf{r}}$ yields
$\mathbf{p} = n(\mathbf{r})\dot{\mathbf{r}}/\|\dot{\mathbf{r}}\|$. Under the
unit-speed constraint, the result follows.
\end{proof}

\begin{theorem}[Hamiltonian Ray Equations]
Ray trajectories satisfy the Hamiltonian system
\begin{equation}
    \frac{d\mathbf{r}}{ds} = \frac{\mathbf{p}}{n(\mathbf{r})},
    \qquad
    \frac{d\mathbf{p}}{ds} = -n(\mathbf{r})\nabla n(\mathbf{r}).
\end{equation}
\end{theorem}

\begin{proof}
Hamilton's equations applied to $H_c$ give
$\dot{\mathbf{r}} = \partial H_c/\partial\mathbf{p} = 2\mathbf{p}$ and
$\dot{\mathbf{p}} = -\partial H_c/\partial\mathbf{r} = -2n\nabla n$. Rescaling
$s$ absorbs the factor $2$, yielding the stated system.
\end{proof}

\begin{theorem}[Symplectic Invariance]
The Hamiltonian flow generated by $H_c$ preserves the canonical symplectic form
\begin{equation}
    \omega = \sum_i d r_i \wedge d p_i.
\end{equation}
\end{theorem}

\begin{proof}
By Cartan's identity,
$\mathcal{L}_{X_{H_c}}\omega = d(i_{X_{H_c}}\omega) + i_{X_{H_c}}(d\omega)$.
Since $\omega$ is closed, $d\omega = 0$, and
$i_{X_{H_c}}\omega = dH_c$, we obtain
$\mathcal{L}_{X_{H_c}}\omega = d(dH_c) = 0$. Thus the flow is symplectic.
\end{proof}

\begin{corollary}[Liouville's Theorem]
The phase-space volume element $\omega^{\wedge d}$ is invariant under ray
propagation through any refractive index field $n(\mathbf{r})$.
\end{corollary}

