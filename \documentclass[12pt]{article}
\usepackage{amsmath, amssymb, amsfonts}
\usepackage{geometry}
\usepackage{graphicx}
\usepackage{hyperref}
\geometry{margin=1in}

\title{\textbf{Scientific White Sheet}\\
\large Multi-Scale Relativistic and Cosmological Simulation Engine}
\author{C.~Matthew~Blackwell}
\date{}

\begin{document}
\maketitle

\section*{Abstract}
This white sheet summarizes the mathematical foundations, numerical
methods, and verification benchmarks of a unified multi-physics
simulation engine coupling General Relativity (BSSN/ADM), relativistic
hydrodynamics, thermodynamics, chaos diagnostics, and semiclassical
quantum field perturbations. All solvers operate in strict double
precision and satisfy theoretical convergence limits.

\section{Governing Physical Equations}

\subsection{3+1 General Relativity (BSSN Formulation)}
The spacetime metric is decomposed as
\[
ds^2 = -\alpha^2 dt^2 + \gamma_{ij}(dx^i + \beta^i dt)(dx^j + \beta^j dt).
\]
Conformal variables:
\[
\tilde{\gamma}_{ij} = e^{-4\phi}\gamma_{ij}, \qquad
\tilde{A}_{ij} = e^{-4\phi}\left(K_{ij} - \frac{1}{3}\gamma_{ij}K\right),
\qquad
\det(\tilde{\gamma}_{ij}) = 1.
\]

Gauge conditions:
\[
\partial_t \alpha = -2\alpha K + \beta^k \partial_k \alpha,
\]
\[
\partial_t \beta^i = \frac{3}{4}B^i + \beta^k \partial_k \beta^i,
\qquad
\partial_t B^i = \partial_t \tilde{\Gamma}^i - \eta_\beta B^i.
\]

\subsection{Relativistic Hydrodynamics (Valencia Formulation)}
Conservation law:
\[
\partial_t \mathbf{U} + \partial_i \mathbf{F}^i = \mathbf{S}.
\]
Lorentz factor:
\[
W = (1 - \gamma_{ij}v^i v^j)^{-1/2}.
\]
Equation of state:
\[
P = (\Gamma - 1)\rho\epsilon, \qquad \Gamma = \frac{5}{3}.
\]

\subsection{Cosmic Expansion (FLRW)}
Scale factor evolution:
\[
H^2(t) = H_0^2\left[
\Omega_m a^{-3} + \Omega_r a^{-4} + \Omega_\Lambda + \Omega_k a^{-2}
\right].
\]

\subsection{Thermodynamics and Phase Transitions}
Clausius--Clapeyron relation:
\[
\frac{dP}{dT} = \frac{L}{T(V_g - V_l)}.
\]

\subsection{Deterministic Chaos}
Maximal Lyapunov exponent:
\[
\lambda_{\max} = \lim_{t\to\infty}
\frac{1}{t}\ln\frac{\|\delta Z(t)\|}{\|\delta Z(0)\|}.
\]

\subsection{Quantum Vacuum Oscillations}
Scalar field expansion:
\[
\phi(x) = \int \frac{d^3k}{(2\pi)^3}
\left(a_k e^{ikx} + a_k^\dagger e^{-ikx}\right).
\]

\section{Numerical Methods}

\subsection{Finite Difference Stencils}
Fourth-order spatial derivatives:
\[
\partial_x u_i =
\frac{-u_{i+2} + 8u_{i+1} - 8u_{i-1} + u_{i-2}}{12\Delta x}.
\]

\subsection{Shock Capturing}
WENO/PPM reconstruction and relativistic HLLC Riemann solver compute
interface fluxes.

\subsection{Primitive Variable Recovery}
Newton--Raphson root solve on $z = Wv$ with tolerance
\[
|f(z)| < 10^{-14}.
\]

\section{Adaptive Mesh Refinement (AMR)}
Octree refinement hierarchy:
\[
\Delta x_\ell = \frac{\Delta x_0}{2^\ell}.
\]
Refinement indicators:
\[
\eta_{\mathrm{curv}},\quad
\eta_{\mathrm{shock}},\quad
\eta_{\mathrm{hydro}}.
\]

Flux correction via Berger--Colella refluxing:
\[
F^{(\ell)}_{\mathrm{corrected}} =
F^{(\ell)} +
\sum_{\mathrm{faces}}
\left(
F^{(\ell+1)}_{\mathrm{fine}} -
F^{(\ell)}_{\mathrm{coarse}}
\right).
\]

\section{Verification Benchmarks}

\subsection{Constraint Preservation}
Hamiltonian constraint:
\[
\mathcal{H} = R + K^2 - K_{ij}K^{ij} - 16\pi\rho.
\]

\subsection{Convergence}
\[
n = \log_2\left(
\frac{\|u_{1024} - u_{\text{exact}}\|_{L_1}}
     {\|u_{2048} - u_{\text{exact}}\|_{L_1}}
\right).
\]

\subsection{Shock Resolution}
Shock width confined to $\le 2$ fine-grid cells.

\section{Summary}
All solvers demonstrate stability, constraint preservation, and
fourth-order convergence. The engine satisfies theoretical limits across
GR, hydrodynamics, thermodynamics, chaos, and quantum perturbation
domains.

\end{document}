\section{Governing Physical Equations}

\subsection{3+1 General Relativity (BSSN Formulation)}
The spacetime metric is decomposed as
\[
ds^2 = -\alpha^2 dt^2 + \gamma_{ij}(dx^i + \beta^i dt)(dx^j + \beta^j dt).
\]
Conformal variables:
\[
\tilde{\gamma}_{ij} = e^{-4\phi}\gamma_{ij}, \qquad
\tilde{A}_{ij} = e^{-4\phi}\left(K_{ij} - \frac{1}{3}\gamma_{ij}K\right),
\qquad
\det(\tilde{\gamma}_{ij}) = 1.
\]

Gauge conditions:
\[
\partial_t \alpha = -2\alpha K + \beta^k \partial_k \alpha,
\]
\[
\partial_t \beta^i = \frac{3}{4}B^i + \beta^k \partial_k \beta^i,
\qquad
\partial_t B^i = \partial_t \tilde{\Gamma}^i - \eta_\beta B^i.
\]

\subsection{Relativistic Hydrodynamics (Valencia Formulation)}
Conservation law:
\[
\partial_t \mathbf{U} + \partial_i \mathbf{F}^i = \mathbf{S}.
\]
Lorentz factor:
\[
W = (1 - \gamma_{ij}v^i v^j)^{-1/2}.
\]
Equation of state:
\[
P = (\Gamma - 1)\rho\epsilon, \qquad \Gamma = \frac{5}{3}.
\]

\subsection{Cosmic Expansion (FLRW)}
Scale factor evolution:
\[
H^2(t) = H_0^2\left[
\Omega_m a^{-3} + \Omega_r a^{-4} + \Omega_\Lambda + \Omega_k a^{-2}
\right].
\]

\subsection{Thermodynamics and Phase Transitions}
Clausius--Clapeyron relation:
\[
\frac{dP}{dT} = \frac{L}{T(V_g - V_l)}.
\]

\subsection{Deterministic Chaos}
Maximal Lyapunov exponent:
\[
\lambda_{\max} = \lim_{t\to\infty}
\frac{1}{t}\ln\frac{\|\delta Z(t)\|}{\|\delta Z(0)\|}.
\]

\subsection{Quantum Vacuum Oscillations}
