update_protocol:
  description: >
    How to update the registry when a registered blueprint changes.
  steps:
    - "1. Modify the blueprint file intentionally."
    - "2. Recompute sha256 checksum of the file."
    - "3. Replace the corresponding checksum.value in this registry."
    - "4. Optionally bump the blueprint version field."
    - "5. Commit blueprint + registry changes together."

validation_integration:
  used_by:
    - "ghost-blueprint-validator.yaml"
  behavior:
    - "If file is in registry: checksum must match for full authenticity."
    - "If file is not in registry: validator may still check structure and identity, but mark checksum_status='unknown'."

notes:
  - "This registry is local to this repo; a remote or distributed registry is possible but out of scope here."
  - "Registry entries are part of the Blackwell identity encoding story: they prove authorship and intentional evolution."