  scope:
    includes:
      - "*.yaml"
      - "*.md"
    purpose:
      - "authenticity verification"
      - "drift detection"
      - "provenance tracking"
  notes:
    - "Checksums here are canonical for this repository state."
    - "Any change to a registered file requires a registry update."
    - "This is architectural provenance, not cryptographic security."

