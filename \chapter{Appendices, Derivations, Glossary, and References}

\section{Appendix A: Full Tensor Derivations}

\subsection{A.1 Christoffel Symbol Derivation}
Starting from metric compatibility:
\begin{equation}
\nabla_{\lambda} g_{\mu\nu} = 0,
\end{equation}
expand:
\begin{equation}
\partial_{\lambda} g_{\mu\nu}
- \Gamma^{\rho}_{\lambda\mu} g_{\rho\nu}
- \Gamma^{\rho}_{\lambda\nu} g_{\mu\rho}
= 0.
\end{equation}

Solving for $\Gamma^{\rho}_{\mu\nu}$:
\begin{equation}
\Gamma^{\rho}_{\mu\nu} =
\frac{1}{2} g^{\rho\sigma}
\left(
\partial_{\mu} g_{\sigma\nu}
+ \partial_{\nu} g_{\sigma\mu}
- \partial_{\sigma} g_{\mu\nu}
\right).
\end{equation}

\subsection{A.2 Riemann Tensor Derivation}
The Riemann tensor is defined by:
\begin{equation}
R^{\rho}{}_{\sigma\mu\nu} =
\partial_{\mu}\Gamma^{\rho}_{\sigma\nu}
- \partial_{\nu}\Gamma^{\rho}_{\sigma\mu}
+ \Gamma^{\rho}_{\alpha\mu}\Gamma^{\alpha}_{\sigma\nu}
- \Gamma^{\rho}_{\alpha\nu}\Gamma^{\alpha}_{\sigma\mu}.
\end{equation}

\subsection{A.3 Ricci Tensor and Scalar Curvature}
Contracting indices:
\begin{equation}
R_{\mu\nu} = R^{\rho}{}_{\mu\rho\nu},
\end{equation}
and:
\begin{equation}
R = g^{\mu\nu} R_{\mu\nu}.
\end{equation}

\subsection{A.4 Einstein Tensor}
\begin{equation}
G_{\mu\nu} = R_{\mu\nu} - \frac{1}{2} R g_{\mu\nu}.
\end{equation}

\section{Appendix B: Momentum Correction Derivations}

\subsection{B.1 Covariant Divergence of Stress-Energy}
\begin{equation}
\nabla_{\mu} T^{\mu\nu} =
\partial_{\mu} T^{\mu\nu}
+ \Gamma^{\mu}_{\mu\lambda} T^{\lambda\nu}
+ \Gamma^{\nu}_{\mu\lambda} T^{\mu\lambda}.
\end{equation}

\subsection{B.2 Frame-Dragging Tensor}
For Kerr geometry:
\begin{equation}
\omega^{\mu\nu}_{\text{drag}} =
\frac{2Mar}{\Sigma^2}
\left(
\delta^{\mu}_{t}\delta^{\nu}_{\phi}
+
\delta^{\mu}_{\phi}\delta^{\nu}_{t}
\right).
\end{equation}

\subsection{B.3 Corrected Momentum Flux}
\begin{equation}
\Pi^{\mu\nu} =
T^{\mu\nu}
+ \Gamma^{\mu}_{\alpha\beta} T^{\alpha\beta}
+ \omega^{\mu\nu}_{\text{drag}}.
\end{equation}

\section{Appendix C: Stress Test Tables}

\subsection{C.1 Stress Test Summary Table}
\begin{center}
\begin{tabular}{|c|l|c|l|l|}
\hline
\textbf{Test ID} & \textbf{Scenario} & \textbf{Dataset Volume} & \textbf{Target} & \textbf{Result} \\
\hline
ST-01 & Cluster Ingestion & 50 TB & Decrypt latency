\chapter{Appendices, Derivations, Glossary, and References}

\section{Appendix A: Full Tensor Derivations}

\subsection{A.1 Christoffel Symbol Derivation}
Starting from metric compatibility:
\begin{equation}
\nabla_{\lambda} g_{\mu\nu} = 0,
\end{equation}
expand:
\begin{equation}
\partial_{\lambda} g_{\mu\nu}
- \Gamma^{\rho}_{\lambda\mu} g_{\rho\nu}
- \Gamma^{\rho}_{\lambda\nu} g_{\mu\rho}
= 0.
\end{equation}

Solving for $\Gamma^{\rho}_{\mu\nu}$:
\begin{equation}
\Gamma^{\rho}_{\mu\nu} =
\frac{1}{2} g^{\rho\sigma}
\left(
\partial_{\mu} g_{\sigma\nu}
+ \partial_{\nu} g_{\sigma\mu}
- \partial_{\sigma} g_{\mu\nu}
\right).
\end{equation}

\subsection{A.2 Riemann Tensor Derivation}
The Riemann tensor is defined by:
\begin{equation}
R^{\rho}{}_{\sigma\mu\nu} =
\partial_{\mu}\Gamma^{\rho}_{\sigma\nu}
- \partial_{\nu}\Gamma^{\rho}_{\sigma\mu}
+ \Gamma^{\rho}_{\alpha\mu}\Gamma^{\alpha}_{\sigma\nu}
- \Gamma^{\rho}_{\alpha\nu}\Gamma^{\alpha}_{\sigma\mu}.
\end{equation}

\subsection{A.3 Ricci Tensor and Scalar Curvature}
Contracting indices:
\begin{equation}
R_{\mu\nu} = R^{\rho}{}_{\mu\rho\nu},
\end{equation}
and:
\begin{equation}
R = g^{\mu\nu} R_{\mu\nu}.
\end{equation}

\subsection{A.4 Einstein Tensor}
\begin{equation}
G_{\mu\nu} = R_{\mu\nu} - \frac{1}{2} R g_{\mu\nu}.
\end{equation}

\section{Appendix B: Momentum Correction Derivations}

\subsection{B.1 Covariant Divergence of Stress-Energy}
\begin{equation}
\nabla_{\mu} T^{\mu\nu} =
\partial_{\mu} T^{\mu\nu}
+ \Gamma^{\mu}_{\mu\lambda} T^{\lambda\nu}
+ \Gamma^{\nu}_{\mu\lambda} T^{\mu\lambda}.
\end{equation}

\subsection{B.2 Frame-Dragging Tensor}
For Kerr geometry:
\begin{equation}
\omega^{\mu\nu}_{\text{drag}} =
\frac{2Mar}{\Sigma^2}
\left(
\delta^{\mu}_{t}\delta^{\nu}_{\phi}
+
\delta^{\mu}_{\phi}\delta^{\nu}_{t}
\right).
\end{equation}

\subsection{B.3 Corrected Momentum Flux}
\begin{equation}
\Pi^{\mu\nu} =
T^{\mu\nu}
+ \Gamma^{\mu}_{\alpha\beta} T^{\alpha\beta}
+ \omega^{\mu\nu}_{\text{drag}}.
\end{equation}

