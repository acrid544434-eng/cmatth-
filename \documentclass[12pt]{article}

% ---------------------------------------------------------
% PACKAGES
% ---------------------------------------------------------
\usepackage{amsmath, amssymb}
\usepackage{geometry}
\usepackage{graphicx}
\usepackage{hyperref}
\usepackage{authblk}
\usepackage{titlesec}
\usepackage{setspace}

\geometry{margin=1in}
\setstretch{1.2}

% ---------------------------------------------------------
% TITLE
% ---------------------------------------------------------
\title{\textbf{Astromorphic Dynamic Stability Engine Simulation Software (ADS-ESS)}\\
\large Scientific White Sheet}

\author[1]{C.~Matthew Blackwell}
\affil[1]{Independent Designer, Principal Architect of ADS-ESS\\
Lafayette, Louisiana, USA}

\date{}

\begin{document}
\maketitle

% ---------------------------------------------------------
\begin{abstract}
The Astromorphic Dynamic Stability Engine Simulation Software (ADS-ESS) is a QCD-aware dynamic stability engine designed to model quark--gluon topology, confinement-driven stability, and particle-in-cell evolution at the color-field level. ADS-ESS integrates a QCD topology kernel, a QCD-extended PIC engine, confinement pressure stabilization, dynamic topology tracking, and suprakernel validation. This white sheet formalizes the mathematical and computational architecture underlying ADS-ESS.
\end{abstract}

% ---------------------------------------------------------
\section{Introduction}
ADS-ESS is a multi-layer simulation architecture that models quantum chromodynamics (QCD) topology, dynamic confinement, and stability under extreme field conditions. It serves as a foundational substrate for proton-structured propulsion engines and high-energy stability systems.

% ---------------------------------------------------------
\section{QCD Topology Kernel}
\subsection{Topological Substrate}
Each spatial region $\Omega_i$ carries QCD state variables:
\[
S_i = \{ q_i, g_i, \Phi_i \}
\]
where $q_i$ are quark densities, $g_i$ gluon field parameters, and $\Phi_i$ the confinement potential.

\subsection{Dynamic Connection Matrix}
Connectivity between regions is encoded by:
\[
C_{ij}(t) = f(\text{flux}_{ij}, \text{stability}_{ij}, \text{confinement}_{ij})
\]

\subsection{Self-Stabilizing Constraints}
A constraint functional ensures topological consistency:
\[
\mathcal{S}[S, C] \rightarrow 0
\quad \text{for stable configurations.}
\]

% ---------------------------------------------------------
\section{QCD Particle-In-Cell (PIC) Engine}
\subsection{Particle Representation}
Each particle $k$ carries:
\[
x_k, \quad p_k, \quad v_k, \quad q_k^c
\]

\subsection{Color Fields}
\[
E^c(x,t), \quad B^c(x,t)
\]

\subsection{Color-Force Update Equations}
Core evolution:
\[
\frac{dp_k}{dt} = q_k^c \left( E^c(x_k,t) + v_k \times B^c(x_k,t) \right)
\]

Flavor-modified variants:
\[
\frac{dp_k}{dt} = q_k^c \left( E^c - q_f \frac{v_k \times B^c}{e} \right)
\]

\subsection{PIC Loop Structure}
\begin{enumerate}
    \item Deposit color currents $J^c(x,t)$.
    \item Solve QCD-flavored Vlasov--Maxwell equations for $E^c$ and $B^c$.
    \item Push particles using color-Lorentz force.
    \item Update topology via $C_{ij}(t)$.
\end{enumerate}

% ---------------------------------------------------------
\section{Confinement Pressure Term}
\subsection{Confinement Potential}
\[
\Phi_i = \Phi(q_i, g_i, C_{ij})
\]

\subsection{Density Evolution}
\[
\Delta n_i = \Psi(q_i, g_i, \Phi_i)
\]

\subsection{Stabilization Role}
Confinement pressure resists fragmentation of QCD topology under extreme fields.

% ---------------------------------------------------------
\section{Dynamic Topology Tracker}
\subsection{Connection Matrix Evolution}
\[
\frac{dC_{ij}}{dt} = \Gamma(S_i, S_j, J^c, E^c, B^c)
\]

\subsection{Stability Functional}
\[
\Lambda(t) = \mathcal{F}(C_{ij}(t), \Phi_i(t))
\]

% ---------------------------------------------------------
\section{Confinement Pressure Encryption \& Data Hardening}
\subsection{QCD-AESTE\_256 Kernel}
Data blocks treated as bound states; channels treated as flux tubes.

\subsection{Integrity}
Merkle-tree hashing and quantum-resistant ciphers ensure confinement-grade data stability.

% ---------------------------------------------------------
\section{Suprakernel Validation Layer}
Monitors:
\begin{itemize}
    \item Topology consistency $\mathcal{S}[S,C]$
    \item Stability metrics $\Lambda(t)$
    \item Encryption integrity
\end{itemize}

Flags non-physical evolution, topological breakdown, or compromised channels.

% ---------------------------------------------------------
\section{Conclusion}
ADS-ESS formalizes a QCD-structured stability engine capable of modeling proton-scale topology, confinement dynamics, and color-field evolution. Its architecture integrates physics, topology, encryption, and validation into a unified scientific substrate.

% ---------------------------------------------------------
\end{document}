\section{QCD Particle-In-Cell (PIC) Engine}
\subsection{Particle Representation}
Each particle $k$ carries:
\[
x_k, \quad p_k, \quad v_k, \quad q_k^c
\]

\subsection{Color Fields}
\[
E^c(x,t), \quad B^c(x,t)
\]

\subsection{Color-Force Update Equations}
Core evolution:
\[
\frac{dp_k}{dt} = q_k^c \left( E^c(x_k,t) + v_k \times B^c(x_k,t) \right)
\]

Flavor-modified variants:
\[
\frac{dp_k}{dt} = q_k^c \left( E^c - q_f \frac{v_k \times B^c}{e} \right)
\]

\subsection{PIC Loop Structure}
\begin{enumerate}
    \item Deposit color currents $J^c(x,t)$.
    \item Solve QCD-flavored Vlasov--Maxwell equations for $E^c$ and $B^c$.
    \item Push particles using color-Lorentz force.
    \item Update topology via $C_{ij}(t)$.
\end{enumerate}

