\chapter{Constraint Propagation in Canonical Gravity}

\section{Introduction}
The ADM, York, and Conformal Thin-Sandwich (CTS) formalisms impose constraint equations 
on the initial data of general relativity. These constraints must remain satisfied 
throughout evolution. This chapter develops the full mathematical structure of 
constraint propagation, including evolution equations for the Hamiltonian and momentum 
constraints, stability criteria, and the UKG-SE enforcement mechanism.

\section{ADM Constraint Definitions}

\subsection{Hamiltonian Constraint}
\begin{equation}
\mathcal{H} =
R^{(3)} + K^2 - K_{ij} K^{ij}
- 16\pi G \rho.
\end{equation}

\subsection{Momentum Constraint}
\begin{equation}
\mathcal{M}^i =
D_j (K^{ij} - h^{ij} K)
- 8\pi G S^i.
\end{equation}

Constraint propagation requires:
\begin{equation}
\partial_t \mathcal{H} = 0, \qquad
\partial_t \mathcal{M}^i = 0.
\end{equation}

\section{Constraint Propagation Equations}

\subsection{Evolution of the Hamiltonian Constraint}
Using the ADM evolution equations:
\begin{equation}
\dot{h}_{ij} = 2\alpha K_{ij} + D_i \beta_j + D_j \beta_i,
\end{equation}
\begin{equation}
\dot{K}_{ij} =
-\nabla_i \nabla_j \alpha
+ \alpha (R_{ij} - 2K_{ik} K^k{}_j + K K_{ij})
+ \mathcal{L}_{\beta} K_{ij},
\end{equation}
one obtains:
\begin{align}
\partial_t \mathcal{H}
&=
2\alpha D_i \mathcal{M}^i
+ \beta^i D_i \mathcal{H}
- \alpha K \mathcal{H}
+ \alpha (D_i K) \mathcal{M}^i.
\end{align}

\subsection{Evolution of the Momentum Constraint}
Similarly:
\begin{align}
\partial_t \mathcal{M}^i
&=
\alpha D^i \mathcal{H}
+ \beta^j D_j \mathcal{M}^i
- \mathcal{M}^j D_j \beta^i
- \alpha K \mathcal{M}^i.
\end{align}

\section{Constraint Propagation Structure}

\subsection{Hyperbolic–Elliptic Coupling}
The propagation equations form a coupled system:
\begin{equation}
\partial_t
\begin{pmatrix}
\mathcal{H} \\
\mathcal{M}^i
\end{pmatrix}
=
\mathcal{A}
\begin{pmatrix}
\mathcal{H} \\
\mathcal{M}^i
\end{pmatrix},
\end{equation}
where $\mathcal{A}$ contains:
\begin{itemize}
    \item lapse $\alpha$,
    \item shift $\beta^i$,
    \item extrinsic curvature $K_{ij}$,
    \item spatial derivatives $D_i$.
\end{itemize}

\subsection{Stability Condition}
Constraint stability requires:
\begin{equation}
\text{Re}(\lambda_{\mathcal{A}}) \le 0,
\end{equation}
where $\lambda_{\mathcal{A}}$ are eigenvalues of $\mathcal{A}$.

\section{York Decomposition and Constraint Propagation}

\subsection{Hamiltonian Constraint in York Form}
\begin{equation}
\tilde{D}^2 \psi
- \frac{1}{8} \tilde{R} \psi
+ \frac{1}{8} \psi^{-7}
\tilde{A}_{ij} \tilde{A}^{ij}
+ \frac{1}{12} K^2 \psi^5
= -2\pi G \psi^5 \rho.
\end{equation}

\subsection{Momentum Constraint in York Form}
\begin{equation}
\tilde{D}_j (\tilde{L} W)^{ij}
= \frac{2}{3} \psi^6 \tilde{D}^i K
+ 8\pi G \psi^{10} S^i.
\end{equation}

York decomposition ensures:
\begin{equation}
\partial_t \mathcal{H} = 0, \qquad
\partial_t \mathcal{M}^i = 0,
\end{equation}
provided $\psi$, $W^i$, and $K$ satisfy the elliptic equations.

\section{CTS Constraint Propagation}

\subsection{CTS Hamiltonian Constraint}
\begin{equation}
\tilde{D}^2 \psi
- \frac{1}{8} \tilde{R} \psi
+ \frac{1}{8} \psi^{-7}
\tilde{A}_{ij} \tilde{A}^{ij}
+ \frac{1}{12} K^2 \psi^5
= -2\pi G \psi^5 \rho.
\end{equation}

\subsection{CTS Momentum Constraint}
\begin{equation}
\tilde{D}_j
\left[
\frac{1}{2\tilde{\alpha}}
\left(
\dot{\tilde{h}}^{ij}
- (\tilde{L} \beta)^{ij}
\right)
\right]
=
\frac{2}{3} \psi^6 \tilde{D}^i K
+ 8\pi G \psi^{10} S^i.
\end{equation}

\subsection{CTS Lapse Equation}
\begin{equation}
\tilde{D}^2 \tilde{\alpha}
- \tilde{\alpha}
\left(
\tilde{A}_{ij} \tilde{A}^{ij}
+ \frac{1}{3} K^2
\right)
=
\psi^6 \partial_t K.
\end{equation}

CTS ensures constraint propagation by solving all three elliptic equations simultaneously.

\section{Constraint Propagation in Kerr Geometry}

\subsection{Frame-Dragging Contribution}
The Kerr shift vector:
\begin{equation}
\beta^{\phi} = -\frac{2Mar}{\Sigma(r^2 + a^2)},
\end{equation}
introduces rotational coupling in constraint propagation.

\subsection{Stability Condition}
Constraint stability requires:
\begin{equation}
\partial_t \mathcal{H} \rightarrow 0, \qquad
\partial_t \mathcal{M}^i \rightarrow 0,
\end{equation}
even under:
\begin{equation}
a = 0.99M.
\end{equation}

\section{UKG-SE Constraint Enforcement}

\subsection{Residual-Based Correction}
UKG-SE enforces:
\begin{equation}
\mathcal{H} < 10^{-12}, \qquad
\mathcal{M}^i < 10^{-12},
\end{equation}
using:
\begin{equation}
\Theta^{ij}_{\text{momentum}}
=
\Gamma^{i}_{\alpha\beta} T^{\alpha\beta}
+ \omega^{ij}_{\text{drag}}.
\end{equation}

\subsection{Constraint Feedback Loop}
The solver pipeline:
\begin{equation}
\text{ADM} \rightarrow \text{York} \rightarrow \text{CTS} \rightarrow \text{Residual Engine}
\end{equation}
ensures constraint propagation across all modules.

