\section{Governing Equations}

\subsection{3+1 General Relativity (BSSN)}
The metric decomposition is
\[
ds^2 = -\alpha^2 dt^2 + \gamma_{ij}(dx^i + \beta^i dt)(dx^j + \beta^j dt).
\]
Conformal variables:
\[
\tilde{\gamma}_{ij} = e^{-4\phi}\gamma_{ij}, \qquad
\tilde{A}_{ij} = e^{-4\phi}\left(K_{ij} - \frac{1}{3}\gamma_{ij}K\right).
\]
Gauge conditions:
\[
\partial_t \alpha = -2\alpha K + \beta^k \partial_k \alpha,
\]
\[
\partial_t \beta^i = \frac{3}{4}B^i + \beta^k \partial_k \beta^i,
\qquad
\partial_t B^i = \partial_t \tilde{\Gamma}^i - \eta_\beta B^i.
\]

\subsection{Relativistic Hydrodynamics}
