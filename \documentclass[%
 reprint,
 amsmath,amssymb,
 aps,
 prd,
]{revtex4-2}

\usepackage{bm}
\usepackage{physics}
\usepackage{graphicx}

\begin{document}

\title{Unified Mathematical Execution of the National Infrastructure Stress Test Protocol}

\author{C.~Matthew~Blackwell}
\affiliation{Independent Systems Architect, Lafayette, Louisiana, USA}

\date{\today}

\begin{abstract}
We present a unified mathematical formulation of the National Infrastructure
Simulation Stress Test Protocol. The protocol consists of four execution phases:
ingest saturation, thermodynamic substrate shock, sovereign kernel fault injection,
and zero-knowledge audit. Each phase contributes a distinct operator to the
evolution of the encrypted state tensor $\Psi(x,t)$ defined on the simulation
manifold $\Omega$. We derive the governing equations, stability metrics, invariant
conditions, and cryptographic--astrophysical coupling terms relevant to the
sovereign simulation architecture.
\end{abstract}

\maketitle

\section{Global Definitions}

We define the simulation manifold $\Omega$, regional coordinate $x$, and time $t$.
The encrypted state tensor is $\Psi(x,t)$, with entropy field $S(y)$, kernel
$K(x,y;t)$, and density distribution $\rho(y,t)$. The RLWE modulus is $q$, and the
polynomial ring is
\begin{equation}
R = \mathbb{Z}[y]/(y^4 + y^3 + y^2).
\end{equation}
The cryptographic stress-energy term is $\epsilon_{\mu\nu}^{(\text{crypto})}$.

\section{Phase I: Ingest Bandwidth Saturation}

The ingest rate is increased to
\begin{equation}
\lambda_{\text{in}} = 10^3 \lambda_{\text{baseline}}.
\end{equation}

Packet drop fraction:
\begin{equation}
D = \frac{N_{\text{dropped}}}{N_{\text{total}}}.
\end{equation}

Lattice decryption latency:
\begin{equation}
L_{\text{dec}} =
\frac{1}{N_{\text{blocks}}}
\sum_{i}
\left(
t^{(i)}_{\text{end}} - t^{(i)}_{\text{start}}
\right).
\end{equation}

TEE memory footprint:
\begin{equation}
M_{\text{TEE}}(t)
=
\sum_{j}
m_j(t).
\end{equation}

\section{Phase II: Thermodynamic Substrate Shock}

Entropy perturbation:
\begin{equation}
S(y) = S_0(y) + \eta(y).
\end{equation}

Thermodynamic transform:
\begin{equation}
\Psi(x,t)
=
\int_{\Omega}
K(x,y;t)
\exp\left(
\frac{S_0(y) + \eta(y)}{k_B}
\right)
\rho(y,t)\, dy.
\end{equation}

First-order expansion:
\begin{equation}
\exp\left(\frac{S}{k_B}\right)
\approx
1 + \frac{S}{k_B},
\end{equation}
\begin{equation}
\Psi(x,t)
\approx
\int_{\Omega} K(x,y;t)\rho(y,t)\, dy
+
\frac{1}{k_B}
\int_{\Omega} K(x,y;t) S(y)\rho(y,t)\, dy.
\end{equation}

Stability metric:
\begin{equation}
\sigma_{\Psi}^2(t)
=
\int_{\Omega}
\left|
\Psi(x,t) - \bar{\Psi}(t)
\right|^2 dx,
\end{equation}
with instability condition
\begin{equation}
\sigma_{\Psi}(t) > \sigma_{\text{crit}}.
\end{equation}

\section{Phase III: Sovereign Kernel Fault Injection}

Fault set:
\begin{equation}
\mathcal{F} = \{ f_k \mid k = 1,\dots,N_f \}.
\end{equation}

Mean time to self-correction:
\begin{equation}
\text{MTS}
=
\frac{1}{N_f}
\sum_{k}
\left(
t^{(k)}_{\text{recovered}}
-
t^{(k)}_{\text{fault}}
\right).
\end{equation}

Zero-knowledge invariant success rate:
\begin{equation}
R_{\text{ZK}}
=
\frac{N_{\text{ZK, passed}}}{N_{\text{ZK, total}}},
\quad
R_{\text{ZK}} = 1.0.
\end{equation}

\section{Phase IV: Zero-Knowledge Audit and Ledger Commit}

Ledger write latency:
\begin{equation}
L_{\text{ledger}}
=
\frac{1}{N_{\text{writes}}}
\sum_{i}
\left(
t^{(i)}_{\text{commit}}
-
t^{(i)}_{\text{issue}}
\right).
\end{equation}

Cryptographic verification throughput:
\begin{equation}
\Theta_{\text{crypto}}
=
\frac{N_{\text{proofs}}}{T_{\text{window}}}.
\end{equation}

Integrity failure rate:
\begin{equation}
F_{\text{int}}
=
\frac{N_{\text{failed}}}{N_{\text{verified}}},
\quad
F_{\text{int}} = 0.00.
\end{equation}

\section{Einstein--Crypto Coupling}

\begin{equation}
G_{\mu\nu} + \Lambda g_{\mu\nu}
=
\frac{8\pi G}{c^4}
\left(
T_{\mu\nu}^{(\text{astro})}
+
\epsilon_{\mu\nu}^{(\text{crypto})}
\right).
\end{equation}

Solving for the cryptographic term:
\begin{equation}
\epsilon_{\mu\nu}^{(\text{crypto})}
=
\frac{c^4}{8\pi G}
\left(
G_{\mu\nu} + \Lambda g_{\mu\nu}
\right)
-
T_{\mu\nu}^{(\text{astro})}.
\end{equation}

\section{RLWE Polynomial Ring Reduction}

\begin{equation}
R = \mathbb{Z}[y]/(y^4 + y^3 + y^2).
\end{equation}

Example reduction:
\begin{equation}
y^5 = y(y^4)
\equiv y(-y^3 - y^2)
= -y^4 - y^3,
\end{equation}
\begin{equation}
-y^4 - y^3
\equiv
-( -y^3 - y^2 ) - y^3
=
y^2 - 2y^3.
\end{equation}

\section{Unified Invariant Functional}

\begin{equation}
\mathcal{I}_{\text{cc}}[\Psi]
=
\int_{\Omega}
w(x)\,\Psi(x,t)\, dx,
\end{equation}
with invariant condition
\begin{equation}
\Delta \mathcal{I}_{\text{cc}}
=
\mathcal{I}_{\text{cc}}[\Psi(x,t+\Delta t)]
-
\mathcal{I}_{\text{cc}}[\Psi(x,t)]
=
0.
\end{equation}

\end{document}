\section{Global Definitions}

We define the simulation manifold $\Omega$, regional coordinate $x$, and time $t$.
The encrypted state tensor is $\Psi(x,t)$, with entropy field $S(y)$, kernel
$K(x,y;t)$, and density distribution $\rho(y,t)$. The RLWE modulus is $q$, and the
polynomial ring is
\begin{equation}
R = \mathbb{Z}[y]/(y^4 + y^3 + y^2).
\end{equation}
The cryptographic stress-energy term is $\epsilon_{\mu\nu}^{(\text{crypto})}$.

\section{Phase I: Ingest Bandwidth Saturation}

The ingest rate is increased to
\begin{equation}
\lambda_{\text{in}} = 10^3 \lambda_{\text{baseline}}.
\end{equation}

Packet drop fraction:
\begin{equation}
D = \frac{N_{\text{dropped}}}{N_{\text{total}}}.
\end{equation}

Lattice decryption latency:
\begin{equation}
L_{\text{dec}} =
\frac{1}{N_{\text{blocks}}}
\sum_{i}
\left(
t^{(i)}_{\text{end}} - t^{(i)}_{\text{start}}
\right).
\end{equation}

TEE memory footprint:
\begin{equation}
M_{\text{TEE}}(t)
=
\sum_{j}
m_j(t).
\end{equation}

\section{Phase II: Thermodynamic Substrate Shock}

Entropy perturbation:
\begin{equation}
S(y) = S_0(y) + \eta(y).
\end{equation}

Thermodynamic transform:
\begin{equation}
\Psi(x,t)
=
\int_{\Omega}
K(x,y;t)
\exp\left(
\frac{S_0(y) + \eta(y)}{k_B}
\right)
\rho(y,t)\, dy.
\end{equation}

First-order expansion:
\begin{equation}
\exp\left(\frac{S}{k_B}\right)
\approx
1 + \frac{S}{k_B},
\end{equation}
\begin{equation}
\Psi(x,t)
\approx
\int_{\Omega} K(x,y;t)\rho(y,t)\, dy
+
\frac{1}{k_B}
\int_{\Omega} K(x,y;t) S(y)\rho(y,t)\, dy.
\end{equation}

Stability metric:
\begin{equation}
\sigma_{\Psi}^2(t)
=
\int_{\Omega}
\left|
\Psi(x,t) - \bar{\Psi}(t)
\right|^2 dx,
\end{equation}
with instability condition
\begin{equation}
\sigma_{\Psi}(t) > \sigma_{\text{crit}}.
\end{equation}

