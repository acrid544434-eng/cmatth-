\section{Einstein--Crypto Coupling}

\begin{equation}
G_{\mu\nu} + \Lambda g_{\mu\nu}
=
\frac{8\pi G}{c^4}
\left(
T_{\mu\nu}^{(\text{astro})}
+
\epsilon_{\mu\nu}^{(\text{crypto})}
