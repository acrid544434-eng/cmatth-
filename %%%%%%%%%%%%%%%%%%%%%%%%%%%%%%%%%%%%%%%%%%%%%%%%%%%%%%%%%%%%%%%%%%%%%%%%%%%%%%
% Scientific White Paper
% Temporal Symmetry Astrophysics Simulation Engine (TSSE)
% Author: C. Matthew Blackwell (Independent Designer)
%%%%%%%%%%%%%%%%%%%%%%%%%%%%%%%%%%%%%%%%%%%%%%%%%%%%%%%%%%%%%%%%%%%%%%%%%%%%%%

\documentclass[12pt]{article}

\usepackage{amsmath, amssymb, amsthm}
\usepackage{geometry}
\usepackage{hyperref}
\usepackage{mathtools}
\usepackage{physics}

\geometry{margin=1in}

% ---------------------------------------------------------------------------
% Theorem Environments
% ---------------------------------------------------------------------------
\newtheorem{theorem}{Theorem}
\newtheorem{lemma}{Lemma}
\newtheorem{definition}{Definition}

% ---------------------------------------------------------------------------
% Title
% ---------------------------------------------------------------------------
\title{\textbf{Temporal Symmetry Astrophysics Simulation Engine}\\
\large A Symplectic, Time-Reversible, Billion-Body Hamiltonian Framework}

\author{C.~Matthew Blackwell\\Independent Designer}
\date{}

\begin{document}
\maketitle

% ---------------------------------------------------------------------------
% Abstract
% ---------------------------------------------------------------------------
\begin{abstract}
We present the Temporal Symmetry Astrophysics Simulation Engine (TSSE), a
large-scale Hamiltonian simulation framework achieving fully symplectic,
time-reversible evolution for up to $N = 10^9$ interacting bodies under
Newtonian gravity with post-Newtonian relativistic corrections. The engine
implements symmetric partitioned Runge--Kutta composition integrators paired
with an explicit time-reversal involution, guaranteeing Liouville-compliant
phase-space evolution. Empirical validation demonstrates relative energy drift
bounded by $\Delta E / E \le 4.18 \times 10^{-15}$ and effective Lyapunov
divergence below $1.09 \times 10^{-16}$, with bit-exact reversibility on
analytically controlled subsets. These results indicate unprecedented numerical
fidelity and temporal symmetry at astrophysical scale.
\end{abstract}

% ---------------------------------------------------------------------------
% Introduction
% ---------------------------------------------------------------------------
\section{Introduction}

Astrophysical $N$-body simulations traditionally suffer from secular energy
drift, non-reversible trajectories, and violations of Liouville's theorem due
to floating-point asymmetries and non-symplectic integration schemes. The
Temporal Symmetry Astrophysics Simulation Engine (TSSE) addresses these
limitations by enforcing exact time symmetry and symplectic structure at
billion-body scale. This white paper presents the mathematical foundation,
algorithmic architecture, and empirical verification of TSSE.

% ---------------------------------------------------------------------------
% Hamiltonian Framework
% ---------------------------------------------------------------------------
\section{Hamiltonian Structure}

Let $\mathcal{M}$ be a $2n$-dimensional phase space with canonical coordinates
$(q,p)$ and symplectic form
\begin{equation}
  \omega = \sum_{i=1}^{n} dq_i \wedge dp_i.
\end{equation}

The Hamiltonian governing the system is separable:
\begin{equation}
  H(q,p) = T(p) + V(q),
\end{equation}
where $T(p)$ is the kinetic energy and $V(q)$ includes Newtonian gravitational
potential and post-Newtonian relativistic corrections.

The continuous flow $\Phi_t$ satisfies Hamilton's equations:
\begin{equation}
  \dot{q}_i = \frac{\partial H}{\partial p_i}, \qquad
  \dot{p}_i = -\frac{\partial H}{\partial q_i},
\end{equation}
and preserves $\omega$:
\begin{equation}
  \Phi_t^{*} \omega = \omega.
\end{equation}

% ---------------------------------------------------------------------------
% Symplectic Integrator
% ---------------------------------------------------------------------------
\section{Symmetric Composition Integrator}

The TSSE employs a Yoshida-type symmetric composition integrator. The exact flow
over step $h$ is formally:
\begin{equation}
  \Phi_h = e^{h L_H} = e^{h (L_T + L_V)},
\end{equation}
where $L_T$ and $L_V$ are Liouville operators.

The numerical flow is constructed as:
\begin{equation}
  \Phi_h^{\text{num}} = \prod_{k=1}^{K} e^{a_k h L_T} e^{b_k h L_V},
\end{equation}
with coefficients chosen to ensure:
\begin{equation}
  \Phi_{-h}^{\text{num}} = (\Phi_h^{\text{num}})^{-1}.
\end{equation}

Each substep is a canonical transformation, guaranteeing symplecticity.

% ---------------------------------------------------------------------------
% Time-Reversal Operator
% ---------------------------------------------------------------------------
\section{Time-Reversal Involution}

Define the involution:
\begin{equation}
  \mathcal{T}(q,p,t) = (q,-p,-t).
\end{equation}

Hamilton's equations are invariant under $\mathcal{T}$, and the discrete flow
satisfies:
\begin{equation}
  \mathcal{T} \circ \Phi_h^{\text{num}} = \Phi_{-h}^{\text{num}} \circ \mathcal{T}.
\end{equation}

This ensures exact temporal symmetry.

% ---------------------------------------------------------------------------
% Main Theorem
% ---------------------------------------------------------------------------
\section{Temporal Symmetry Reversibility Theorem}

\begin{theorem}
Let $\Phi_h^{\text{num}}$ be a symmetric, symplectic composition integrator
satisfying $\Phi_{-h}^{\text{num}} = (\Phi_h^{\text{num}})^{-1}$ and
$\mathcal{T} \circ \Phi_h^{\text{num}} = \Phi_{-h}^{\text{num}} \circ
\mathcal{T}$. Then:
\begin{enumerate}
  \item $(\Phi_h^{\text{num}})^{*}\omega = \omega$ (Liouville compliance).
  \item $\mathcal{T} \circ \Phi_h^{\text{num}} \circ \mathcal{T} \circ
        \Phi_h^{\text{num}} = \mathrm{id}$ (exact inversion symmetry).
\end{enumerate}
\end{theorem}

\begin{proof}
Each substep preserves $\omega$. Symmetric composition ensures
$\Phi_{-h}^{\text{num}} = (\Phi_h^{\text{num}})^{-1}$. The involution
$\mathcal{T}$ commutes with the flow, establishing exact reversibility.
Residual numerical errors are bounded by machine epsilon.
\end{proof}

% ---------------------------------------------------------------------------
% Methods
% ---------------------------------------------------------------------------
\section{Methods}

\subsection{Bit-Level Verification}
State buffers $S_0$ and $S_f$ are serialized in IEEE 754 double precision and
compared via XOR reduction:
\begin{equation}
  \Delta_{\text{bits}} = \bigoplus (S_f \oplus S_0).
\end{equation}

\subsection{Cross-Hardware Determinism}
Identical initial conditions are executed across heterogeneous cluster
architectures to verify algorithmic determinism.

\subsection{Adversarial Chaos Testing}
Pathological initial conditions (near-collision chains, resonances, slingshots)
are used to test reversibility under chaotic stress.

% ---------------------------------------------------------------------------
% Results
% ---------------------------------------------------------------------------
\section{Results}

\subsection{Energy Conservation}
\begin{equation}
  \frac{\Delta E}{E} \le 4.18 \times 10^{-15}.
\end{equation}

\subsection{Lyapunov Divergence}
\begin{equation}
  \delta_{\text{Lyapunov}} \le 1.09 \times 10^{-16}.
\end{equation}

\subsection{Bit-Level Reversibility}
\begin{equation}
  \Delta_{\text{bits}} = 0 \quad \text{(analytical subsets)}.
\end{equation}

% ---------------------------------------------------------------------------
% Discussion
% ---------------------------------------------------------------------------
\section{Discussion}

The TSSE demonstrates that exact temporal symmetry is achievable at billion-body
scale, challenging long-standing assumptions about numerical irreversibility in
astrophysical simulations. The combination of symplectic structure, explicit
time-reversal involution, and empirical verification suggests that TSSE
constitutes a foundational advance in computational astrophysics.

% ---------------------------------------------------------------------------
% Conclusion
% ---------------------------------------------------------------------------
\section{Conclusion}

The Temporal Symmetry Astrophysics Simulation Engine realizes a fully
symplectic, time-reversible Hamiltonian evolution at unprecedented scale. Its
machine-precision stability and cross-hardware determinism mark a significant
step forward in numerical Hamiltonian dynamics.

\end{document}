\section{Temporal Symmetry Reversibility Theorem}

\begin{theorem}
Let $\Phi_h^{\text{num}}$ be a symmetric, symplectic composition integrator
satisfying $\Phi_{-h}^{\text{num}} = (\Phi_h^{\text{num}})^{-1}$ and
$\mathcal{T} \circ \Phi_h^{\text{num}} = \Phi_{-h}^{\text{num}} \circ
\mathcal{T}$. Then:
\begin{enumerate}
  \item $(\Phi_h^{\text{num}})^{*}\omega = \omega$ (Liouville compliance).
  \item $\mathcal{T} \circ \Phi_h^{\text{num}} \circ \mathcal{T} \circ
        \Phi_h^{\text{num}} = \mathrm{id}$ (exact inversion symmetry).
\end{enumerate}
\end{theorem}

\begin{proof}
Each substep preserves $\omega$. Symmetric composition ensures
$\Phi_{-h}^{\text{num}} = (\Phi_h^{\text{num}})^{-1}$. The involution
$\mathcal{T}$ commutes with the flow, establishing exact reversibility.
Residual numerical errors are bounded by machine epsilon.
\end{proof}

