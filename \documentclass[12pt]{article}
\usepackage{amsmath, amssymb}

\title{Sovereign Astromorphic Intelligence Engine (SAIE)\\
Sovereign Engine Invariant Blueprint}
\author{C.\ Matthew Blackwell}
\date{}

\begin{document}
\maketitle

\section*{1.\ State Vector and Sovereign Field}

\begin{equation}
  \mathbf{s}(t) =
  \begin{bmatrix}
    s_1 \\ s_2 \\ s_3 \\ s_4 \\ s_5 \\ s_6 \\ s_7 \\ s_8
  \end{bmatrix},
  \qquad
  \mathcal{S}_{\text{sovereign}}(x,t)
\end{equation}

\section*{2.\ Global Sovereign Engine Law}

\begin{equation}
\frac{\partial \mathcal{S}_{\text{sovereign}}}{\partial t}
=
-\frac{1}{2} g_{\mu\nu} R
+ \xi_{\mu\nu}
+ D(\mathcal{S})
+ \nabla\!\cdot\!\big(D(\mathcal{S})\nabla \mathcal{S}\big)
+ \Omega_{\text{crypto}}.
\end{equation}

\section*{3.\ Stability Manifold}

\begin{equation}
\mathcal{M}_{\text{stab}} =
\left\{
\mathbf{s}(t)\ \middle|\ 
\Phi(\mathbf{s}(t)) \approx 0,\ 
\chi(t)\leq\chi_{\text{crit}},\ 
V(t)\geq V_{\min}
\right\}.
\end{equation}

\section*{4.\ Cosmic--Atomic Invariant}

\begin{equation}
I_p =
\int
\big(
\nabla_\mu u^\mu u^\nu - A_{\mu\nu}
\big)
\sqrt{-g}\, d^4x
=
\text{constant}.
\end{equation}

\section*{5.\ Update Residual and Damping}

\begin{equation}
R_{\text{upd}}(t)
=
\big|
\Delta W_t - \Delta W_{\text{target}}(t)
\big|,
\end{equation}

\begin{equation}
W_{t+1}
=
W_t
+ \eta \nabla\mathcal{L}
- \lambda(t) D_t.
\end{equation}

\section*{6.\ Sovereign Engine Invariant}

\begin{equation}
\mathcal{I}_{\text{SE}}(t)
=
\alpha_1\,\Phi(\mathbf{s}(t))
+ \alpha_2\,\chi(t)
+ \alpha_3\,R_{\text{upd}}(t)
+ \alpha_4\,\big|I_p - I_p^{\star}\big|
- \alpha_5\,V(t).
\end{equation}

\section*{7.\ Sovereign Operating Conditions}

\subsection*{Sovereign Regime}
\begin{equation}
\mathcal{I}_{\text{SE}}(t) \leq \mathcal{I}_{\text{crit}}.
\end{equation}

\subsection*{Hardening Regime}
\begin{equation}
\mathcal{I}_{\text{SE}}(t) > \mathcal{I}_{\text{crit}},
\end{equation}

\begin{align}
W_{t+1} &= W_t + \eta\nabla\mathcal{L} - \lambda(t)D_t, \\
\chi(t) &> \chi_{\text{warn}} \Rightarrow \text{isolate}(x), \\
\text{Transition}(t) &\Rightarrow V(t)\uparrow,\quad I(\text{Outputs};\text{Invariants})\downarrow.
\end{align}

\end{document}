\section*{6.\ Sovereign Engine Invariant}

\begin{equation}
\mathcal{I}_{\text{SE}}(t)
=
\alpha_1\,\Phi(\mathbf{s}(t))
+ \alpha_2\,\chi(t)
+ \alpha_3\,R_{\text{upd}}(t)
+ \alpha_4\,\big|I_p - I_p^{\star}\big|
