\begin{equation}
\mathcal{M}_{\text{stab}} =
\left\{
\mathbf{s}(t)\ \middle|\ 
\Phi(\mathbf{s}(t)) \approx 0,\ 
\chi(t)\leq\chi_{\text{crit}},\ 
V(t)\geq V_{\min}
