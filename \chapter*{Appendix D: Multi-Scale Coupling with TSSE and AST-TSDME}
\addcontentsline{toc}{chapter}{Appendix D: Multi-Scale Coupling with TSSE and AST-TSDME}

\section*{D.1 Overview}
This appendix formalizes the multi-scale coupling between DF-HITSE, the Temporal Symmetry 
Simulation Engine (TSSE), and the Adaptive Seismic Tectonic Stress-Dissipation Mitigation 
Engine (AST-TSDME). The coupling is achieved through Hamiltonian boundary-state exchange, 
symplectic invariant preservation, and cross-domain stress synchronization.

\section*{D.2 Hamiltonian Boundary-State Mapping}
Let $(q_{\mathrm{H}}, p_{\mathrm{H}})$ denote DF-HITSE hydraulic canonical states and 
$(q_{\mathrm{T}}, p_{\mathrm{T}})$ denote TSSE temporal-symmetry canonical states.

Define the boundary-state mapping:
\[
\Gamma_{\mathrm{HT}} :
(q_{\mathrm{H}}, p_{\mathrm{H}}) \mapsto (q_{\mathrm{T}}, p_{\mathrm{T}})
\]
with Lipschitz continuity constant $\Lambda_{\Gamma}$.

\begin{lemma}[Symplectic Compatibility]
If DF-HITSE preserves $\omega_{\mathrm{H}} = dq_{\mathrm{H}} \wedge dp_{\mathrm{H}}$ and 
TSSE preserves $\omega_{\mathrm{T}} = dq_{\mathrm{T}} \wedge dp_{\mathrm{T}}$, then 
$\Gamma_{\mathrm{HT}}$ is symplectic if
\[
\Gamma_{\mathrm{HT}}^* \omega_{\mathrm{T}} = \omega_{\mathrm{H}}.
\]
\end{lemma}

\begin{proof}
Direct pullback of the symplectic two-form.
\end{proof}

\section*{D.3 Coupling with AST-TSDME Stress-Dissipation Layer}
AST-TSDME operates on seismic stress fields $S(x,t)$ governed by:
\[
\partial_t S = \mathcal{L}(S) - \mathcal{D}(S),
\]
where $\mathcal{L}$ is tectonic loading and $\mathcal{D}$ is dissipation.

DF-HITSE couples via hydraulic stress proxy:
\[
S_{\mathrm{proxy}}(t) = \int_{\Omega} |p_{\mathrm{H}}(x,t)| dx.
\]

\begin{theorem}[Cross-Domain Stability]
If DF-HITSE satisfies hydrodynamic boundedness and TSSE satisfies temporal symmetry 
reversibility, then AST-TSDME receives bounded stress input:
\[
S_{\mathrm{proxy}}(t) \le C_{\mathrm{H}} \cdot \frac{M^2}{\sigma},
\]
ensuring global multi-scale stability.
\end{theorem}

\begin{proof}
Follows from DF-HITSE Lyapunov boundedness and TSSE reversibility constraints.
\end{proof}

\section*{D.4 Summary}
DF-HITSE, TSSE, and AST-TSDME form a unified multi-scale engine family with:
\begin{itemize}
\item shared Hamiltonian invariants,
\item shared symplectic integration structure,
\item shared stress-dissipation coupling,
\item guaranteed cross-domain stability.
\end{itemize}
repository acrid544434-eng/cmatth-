\section*{D.1 Overview}
This appendix formalizes the multi-scale coupling between DF-HITSE, the Temporal Symmetry 
Simulation Engine (TSSE), and the Adaptive Seismic Tectonic Stress-Dissipation Mitigation 
Engine (AST-TSDME). The coupling is achieved through Hamiltonian boundary-state exchange, 
symplectic invariant preservation, and cross-domain stress synchronization.

\section*{D.2 Hamiltonian Boundary-State Mapping}
Let $(q_{\mathrm{H}}, p_{\mathrm{H}})$ denote DF-HITSE hydraulic canonical states and 
$(q_{\mathrm{T}}, p_{\mathrm{T}})$ denote TSSE temporal-symmetry canonical states.

Define the boundary-state mapping:
\[
\Gamma_{\mathrm{HT}} :
(q_{\mathrm{H}}, p_{\mathrm{H}}) \mapsto (q_{\mathrm{T}}, p_{\mathrm{T}})
\]
with Lipschitz continuity constant $\Lambda_{\Gamma}$.

\begin{lemma}[Symplectic Compatibility]
If DF-HITSE preserves $\omega_{\mathrm{H}} = dq_{\mathrm{H}} \wedge dp_{\mathrm{H}}$ and 
TSSE preserves $\omega_{\mathrm{T}} = dq_{\mathrm{T}} \wedge dp_{\mathrm{T}}$, then 
$\Gamma_{\mathrm{HT}}$ is symplectic if
\[
\Gamma_{\mathrm{HT}}^* \omega_{\mathrm{T}} = \omega_{\mathrm{H}}.
\]
\end{lemma}

\begin{proof}
Direct pullback of the symplectic two-form.
\end{proof}

\section*{D.3 Coupling with AST-TSDME Stress-Dissipation Layer}
AST-TSDME operates on seismic stress fields $S(x,t)$ governed by:
\[
\partial_t S = \mathcal{L}(S) - \mathcal{D}(S),
\]
where $\mathcal{L}$ is tectonic loading and $\mathcal{D}$ is dissipation.

DF-HITSE couples via hydraulic stress proxy:
\[
S_{\mathrm{proxy}}(t) = \int_{\Omega} |p_{\mathrm{H}}(x,t)| dx.
\]

\begin{theorem}[Cross-Domain Stability]
If DF-HITSE satisfies hydrodynamic boundedness and TSSE satisfies temporal symmetry 
reversibility, then AST-TSDME receives bounded stress input:
\[
S_{\mathrm{proxy}}(t) \le C_{\mathrm{H}} \cdot \frac{M^2}{\sigma},
\]
ensuring global multi-scale stability.
\end{theorem}

\begin{proof}
Follows from DF-HITSE Lyapunov boundedness and TSSE reversibility constraints.
\end{proof}

\section*{D.4 Summary}
DF-HITSE, TSSE, and AST-TSDME form a unified multi-scale engine family with:
\begin{itemize}
\item shared Hamiltonian invariants,
\item shared symplectic integration structure,
\item shared stress-dissipation coupling,
\item guaranteed cross-domain stability.
\end{itemize}