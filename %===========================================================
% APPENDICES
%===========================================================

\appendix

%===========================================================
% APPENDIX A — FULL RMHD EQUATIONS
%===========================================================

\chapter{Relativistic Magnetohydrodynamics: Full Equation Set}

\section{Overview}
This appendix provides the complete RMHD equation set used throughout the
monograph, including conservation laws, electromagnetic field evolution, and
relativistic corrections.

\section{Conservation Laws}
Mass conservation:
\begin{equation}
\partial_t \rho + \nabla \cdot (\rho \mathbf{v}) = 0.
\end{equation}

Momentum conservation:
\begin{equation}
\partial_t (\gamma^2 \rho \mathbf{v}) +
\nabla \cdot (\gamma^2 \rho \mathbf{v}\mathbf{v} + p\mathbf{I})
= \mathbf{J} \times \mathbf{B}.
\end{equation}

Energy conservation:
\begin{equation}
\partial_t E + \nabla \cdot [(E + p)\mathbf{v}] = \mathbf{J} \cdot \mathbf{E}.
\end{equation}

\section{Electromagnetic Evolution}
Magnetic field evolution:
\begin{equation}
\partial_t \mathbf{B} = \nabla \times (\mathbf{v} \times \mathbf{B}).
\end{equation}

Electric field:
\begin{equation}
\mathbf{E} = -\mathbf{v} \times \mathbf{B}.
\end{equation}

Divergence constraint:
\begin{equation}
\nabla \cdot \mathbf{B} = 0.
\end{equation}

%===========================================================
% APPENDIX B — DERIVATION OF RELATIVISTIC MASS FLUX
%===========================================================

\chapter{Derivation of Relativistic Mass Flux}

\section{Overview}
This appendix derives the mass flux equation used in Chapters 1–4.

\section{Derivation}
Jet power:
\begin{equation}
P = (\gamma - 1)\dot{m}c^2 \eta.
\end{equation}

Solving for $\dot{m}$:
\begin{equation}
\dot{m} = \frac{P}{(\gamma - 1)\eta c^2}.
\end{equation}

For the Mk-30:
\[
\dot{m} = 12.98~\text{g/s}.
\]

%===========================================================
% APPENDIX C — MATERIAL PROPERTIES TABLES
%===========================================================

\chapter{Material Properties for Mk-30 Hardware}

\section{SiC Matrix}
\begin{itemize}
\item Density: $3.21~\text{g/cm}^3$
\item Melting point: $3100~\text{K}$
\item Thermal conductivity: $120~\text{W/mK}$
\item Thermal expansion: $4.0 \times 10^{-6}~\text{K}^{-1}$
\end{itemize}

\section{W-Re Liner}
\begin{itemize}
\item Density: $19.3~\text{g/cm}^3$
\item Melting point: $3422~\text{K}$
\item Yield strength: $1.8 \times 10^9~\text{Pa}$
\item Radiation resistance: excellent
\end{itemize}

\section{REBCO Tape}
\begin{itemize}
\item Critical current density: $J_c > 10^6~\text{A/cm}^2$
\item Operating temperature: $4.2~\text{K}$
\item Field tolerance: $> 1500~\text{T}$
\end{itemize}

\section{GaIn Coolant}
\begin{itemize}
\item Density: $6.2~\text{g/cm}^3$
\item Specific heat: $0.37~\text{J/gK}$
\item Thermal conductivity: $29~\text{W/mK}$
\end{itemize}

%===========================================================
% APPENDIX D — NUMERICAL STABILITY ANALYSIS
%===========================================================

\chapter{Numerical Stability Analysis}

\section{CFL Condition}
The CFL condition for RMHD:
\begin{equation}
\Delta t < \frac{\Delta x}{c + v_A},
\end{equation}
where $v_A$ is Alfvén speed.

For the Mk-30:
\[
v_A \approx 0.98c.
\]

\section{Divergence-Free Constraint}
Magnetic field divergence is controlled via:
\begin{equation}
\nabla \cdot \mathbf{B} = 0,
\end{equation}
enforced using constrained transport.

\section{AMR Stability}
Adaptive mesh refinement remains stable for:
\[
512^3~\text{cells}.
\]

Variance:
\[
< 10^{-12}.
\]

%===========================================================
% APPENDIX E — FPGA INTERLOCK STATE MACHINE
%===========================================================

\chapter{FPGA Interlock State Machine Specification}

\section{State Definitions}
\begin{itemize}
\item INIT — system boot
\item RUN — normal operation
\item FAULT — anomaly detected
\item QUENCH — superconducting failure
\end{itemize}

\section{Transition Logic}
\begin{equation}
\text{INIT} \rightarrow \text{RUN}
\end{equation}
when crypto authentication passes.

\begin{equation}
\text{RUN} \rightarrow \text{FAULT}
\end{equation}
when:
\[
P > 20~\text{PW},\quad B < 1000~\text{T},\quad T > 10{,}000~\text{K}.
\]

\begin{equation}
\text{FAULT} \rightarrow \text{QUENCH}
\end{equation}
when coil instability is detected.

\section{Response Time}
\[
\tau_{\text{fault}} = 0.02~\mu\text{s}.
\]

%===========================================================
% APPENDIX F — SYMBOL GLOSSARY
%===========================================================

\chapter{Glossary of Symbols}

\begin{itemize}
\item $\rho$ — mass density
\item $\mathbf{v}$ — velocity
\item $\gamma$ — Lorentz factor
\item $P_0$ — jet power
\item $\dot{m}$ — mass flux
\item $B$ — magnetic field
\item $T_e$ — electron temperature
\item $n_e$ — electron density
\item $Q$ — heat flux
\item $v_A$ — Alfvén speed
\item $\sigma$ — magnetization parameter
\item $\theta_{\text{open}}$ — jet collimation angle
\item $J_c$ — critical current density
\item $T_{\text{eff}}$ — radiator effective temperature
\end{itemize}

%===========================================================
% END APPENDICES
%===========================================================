\chapter{Relativistic Magnetohydrodynamics: Full Equation Set}

\section{Overview}
This appendix provides the complete RMHD equation set used throughout the
monograph, including conservation laws, electromagnetic field evolution, and
relativistic corrections.

\section{Conservation Laws}
Mass conservation:
\begin{equation}
\partial_t \rho + \nabla \cdot (\rho \mathbf{v}) = 0.
\end{equation}

Momentum conservation:
\begin{equation}
\partial_t (\gamma^2 \rho \mathbf{v}) +
\nabla \cdot (\gamma^2 \rho \mathbf{v}\mathbf{v} + p\mathbf{I})
= \mathbf{J} \times \mathbf{B}.
\end{equation}

Energy conservation:
\begin{equation}
\partial_t E + \nabla \cdot [(E + p)\mathbf{v}] = \mathbf{J} \cdot \mathbf{E}.
\end{equation}

\section{Electromagnetic Evolution}
Magnetic field evolution:
\begin{equation}
\partial_t \mathbf{B} = \nabla \times (\mathbf{v} \times \mathbf{B}).
\end{equation}

Electric field:
\begin{equation}
\mathbf{E} = -\mathbf{v} \times \mathbf{B}.
\end{equation}

Divergence constraint:
\begin{equation}
\nabla \cdot \mathbf{B} = 0.
\end{equation}

