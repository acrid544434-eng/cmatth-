\chapter{FPGA Interlock State Machine Specification}

\section{State Definitions}
\begin{itemize}
\item INIT — system boot
\item RUN — normal operation
\item FAULT — anomaly detected
\item QUENCH — superconducting failure
\end{itemize}

\section{Transition Logic}
\begin{equation}
\text{INIT} \rightarrow \text{RUN}
\end{equation}
when crypto authentication passes.

\begin{equation}
\text{RUN} \rightarrow \text{FAULT}
\end{equation}
when:
\[
P > 20~\text{PW},\quad B < 1000~\text{T},\quad T > 10{,}000~\text{K}.
\]

\begin{equation}
\text{FAULT} \rightarrow \text{QUENCH}
\end{equation}
when coil instability is detected.

\section{Response Time}
\[
\tau_{\text{fault}} = 0.02~\mu\text{s}.
\]

