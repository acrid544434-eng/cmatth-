\section{Kernel Scheduling and Hierarchical Execution}

Define the kernel schedule:
\[
\Sigma_{\text{TSSE}} =
\left(
\mathcal{K}_{\text{TSSE-T}},
\mathcal{K}_{\text{TSSE-RPK}},
\mathcal{K}_{\text{TSSE-FK}},
\mathcal{K}_{\text{TSSE-SIK}},
\mathcal{K}_{\text{TSSE-VK}},
\mathcal{K}_{\text{TSSE-SK}},
\mathcal{K}_{\text{TSSE-CK}}
\right).
\]

\begin{definition}[TSSE Kernel Schedule]
The TSSE kernel schedule is the ordered list of kernels executed by
$\mathcal{E}_{\text{TSSE}}$.
\end{definition}

\begin{lemma}[Schedule Stability]
If each kernel is TSSE-admissible, then the schedule is stable under TSSE evolution.
\end{lemma}

\begin{proof}
Kernel admissibility ensures commutation with $\mathcal{U}(t)$, preserving order.
\end{proof}

\begin{theorem}[Hierarchical Kernel Execution]
TSSE kernels execute hierarchically and deterministically under the TSSE schedule.
\end{theorem}

\begin{proof}
Follows from deterministic execution and schedule stability.
\end{proof}

This theorem establishes hierarchical kernel execution.

