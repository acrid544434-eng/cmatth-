\section{Coupled GR--Hydrodynamic Benchmark Specification}
\label{sec:gr_hydro_benchmark}

\subsection{Problem Overview}
This benchmark evaluates the stability and convergence of a coupled
General Relativistic (GR) spacetime evolution and relativistic
hydrodynamic shock system. A high-enthalpy fluid slab is embedded in a
dynamically sliced spacetime governed by the BSSN formulation of the
Einstein Field Equations. The test stresses gauge stability, shock
capturing fidelity, and constraint preservation.

\subsection{3+1 BSSN Spacetime Evolution}
The spacetime metric is decomposed as
\[
ds^2 = -\alpha^2 dt^2 + \gamma_{ij}(dx^i + \beta^i dt)(dx^j + \beta^j dt),
\]
with conformal metric
\[
\tilde{\gamma}_{ij} = e^{-4\phi}\gamma_{ij}, \qquad \det(\tilde{\gamma}_{ij}) = 1,
\]
and trace-free extrinsic curvature
\[
\tilde{A}_{ij} = e^{-4\phi}\left(K_{ij} - \frac{1}{3}\gamma_{ij}K\right).
\]

Gauge conditions:
\[
\partial_t \alpha = -2\alpha K + \beta^k \partial_k \alpha,
\]
\[
\partial_t \beta^i = \frac{3}{4} B^i + \beta^k \partial_k \beta^i,
\qquad
\partial_t B^i = \partial_t \tilde{\Gamma}^i - \eta_\beta B^i + \beta^k \partial_k B^i,
\]
with damping parameter $\eta_\beta = 2.0/M$.

\subsection{Relativistic Hydrodynamics (Valencia Formulation)}
The conserved state vector $\mathbf{U}$ satisfies
\[
\partial_t \mathbf{U} + \partial_i \mathbf{F}^i = \mathbf{S},
\]
where the Lorentz factor is
\[
W = \left(1 - \gamma_{ij}v^i v^j\right)^{-1/2},
\]
and the specific enthalpy is
\[
h = 1 + \epsilon + \frac{P}{\rho}.
\]
An ideal-gas equation of state closes the system:
\[
P = (\Gamma - 1)\rho\epsilon, \qquad \Gamma = \frac{5}{3}.
\]

\subsection{Numerical Discretization}
Metric sector derivatives use 4th-order finite differences:
\[
\partial_x u_i = \frac{-u_{i+2} + 8u_{i+1} - 8u_{i-1} + u_{i-2}}{12\Delta x}.
\]

Hydrodynamic reconstruction uses 5th-order WENO or PPM. The HLLC
relativistic Riemann solver computes fluxes at cell interfaces
$(i+1/2)$.

Primitive variable recovery uses a Newton--Raphson root finder on
$z = Wv$ with tolerance
\[
|f(z)| < 10^{-14}.
\]

\subsection{Benchmark Configuration}
Spatial domain:
\[
x \in [-1,1], \qquad y,z \in [-0.1,0.1].
\]

Resolutions:
\[
N_x = 512,\; 1024,\; 2048,\; 4096.
\]

Courant condition:
\[
\Delta t = 0.25\,\frac{\Delta x}{c}.
\]

Initial states:
\[
(\rho_L, P_L) = (10.0, 13.33), \qquad
(\rho_R, P_R) = (1.0, 10^{-6}),
\]
with $\alpha = 1$, $\beta^i = 0$.

\subsection{Verification Metrics}
Hamiltonian constraint norm:
\[
\|\mathcal{H}\|_{L_2} =
\left\| R + K^2 - K_{ij}K^{ij} - 16\pi\rho \right\|_{L_2}.
\]

Convergence order:
\[
n = \log_2\left(
\frac{\|u_{1024} - u_{\text{exact}}\|_{L_1}}
     {\|u_{2048} - u_{\text{exact}}\|_{L_1}}
\right).
\]

