using Blackwell.OS.Core;

namespace Blackwell.OS.Visualization;

public static class TimelinePrinter
{
    public static void Print(List<OsState> history)
    {
        Console.WriteLine("\n=== OS TIMELINE ===");

        for (int i = 0; i < history.Count; i++)
        {
            var s = history[i];
            Console.WriteLine(
                $"Tick {i,2}: " +
                $"Pace={s.Creative.TargetPace:F2}, " +
                $"Beat={s.Creative.CutOnBeatProbability:F2}, " +
                $"Quality={s.Runtime.QualityLevel:F2}, " +
                $"Cache={s.Runtime.CacheAggressiveness:F2}"
            );
        }
    }
}