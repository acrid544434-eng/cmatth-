chaos/evolution-equations/equations.py

# Hyper-chaotic evolution equations
def evolve(x, y, z, w, a, b, c, r, j):
    dx = a * (y - x)
    dy = c * x - y - x * z
    dz = x * y - b * z
    dw = y**2 - r * j
    return dx, dy, dz, dw

