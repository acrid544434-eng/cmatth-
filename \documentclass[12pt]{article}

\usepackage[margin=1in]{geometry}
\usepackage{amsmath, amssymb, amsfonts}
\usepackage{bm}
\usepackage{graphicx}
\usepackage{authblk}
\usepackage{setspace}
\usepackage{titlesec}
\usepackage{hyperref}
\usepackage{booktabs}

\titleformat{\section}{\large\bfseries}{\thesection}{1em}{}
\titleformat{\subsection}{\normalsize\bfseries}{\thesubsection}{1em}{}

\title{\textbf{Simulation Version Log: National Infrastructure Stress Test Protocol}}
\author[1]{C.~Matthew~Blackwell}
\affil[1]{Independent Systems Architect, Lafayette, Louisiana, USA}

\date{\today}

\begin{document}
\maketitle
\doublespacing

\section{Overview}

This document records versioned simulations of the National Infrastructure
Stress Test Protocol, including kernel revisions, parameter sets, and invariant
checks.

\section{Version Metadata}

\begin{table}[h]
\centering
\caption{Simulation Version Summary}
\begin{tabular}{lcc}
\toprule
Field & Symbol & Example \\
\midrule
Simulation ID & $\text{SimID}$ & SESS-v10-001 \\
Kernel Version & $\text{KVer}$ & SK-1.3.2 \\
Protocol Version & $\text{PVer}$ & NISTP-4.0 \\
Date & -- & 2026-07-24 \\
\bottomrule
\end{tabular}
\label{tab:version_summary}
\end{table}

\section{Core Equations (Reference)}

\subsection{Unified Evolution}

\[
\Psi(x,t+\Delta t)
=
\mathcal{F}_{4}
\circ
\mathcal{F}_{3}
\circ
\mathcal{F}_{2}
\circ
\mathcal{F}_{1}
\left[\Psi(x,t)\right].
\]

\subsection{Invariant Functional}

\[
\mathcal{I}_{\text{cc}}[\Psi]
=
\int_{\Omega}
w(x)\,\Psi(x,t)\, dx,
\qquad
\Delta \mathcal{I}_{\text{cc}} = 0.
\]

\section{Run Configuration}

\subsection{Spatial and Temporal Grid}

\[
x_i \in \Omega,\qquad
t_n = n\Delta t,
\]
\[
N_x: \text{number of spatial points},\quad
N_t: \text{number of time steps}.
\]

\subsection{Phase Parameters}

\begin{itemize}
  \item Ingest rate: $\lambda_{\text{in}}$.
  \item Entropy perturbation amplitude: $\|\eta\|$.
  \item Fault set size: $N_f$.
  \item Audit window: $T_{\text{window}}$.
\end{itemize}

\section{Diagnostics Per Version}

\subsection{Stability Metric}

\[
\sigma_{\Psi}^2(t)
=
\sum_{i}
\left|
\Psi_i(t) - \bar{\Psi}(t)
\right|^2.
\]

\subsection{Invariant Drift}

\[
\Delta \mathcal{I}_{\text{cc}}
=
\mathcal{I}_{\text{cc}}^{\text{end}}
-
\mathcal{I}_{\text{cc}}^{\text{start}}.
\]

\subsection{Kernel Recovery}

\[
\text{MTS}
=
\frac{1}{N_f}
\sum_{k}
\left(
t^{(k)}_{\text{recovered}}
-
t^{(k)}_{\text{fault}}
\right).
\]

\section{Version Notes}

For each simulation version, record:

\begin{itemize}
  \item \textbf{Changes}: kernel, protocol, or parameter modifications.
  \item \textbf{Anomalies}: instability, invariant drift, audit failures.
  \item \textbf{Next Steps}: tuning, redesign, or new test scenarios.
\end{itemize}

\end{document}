\section{Core Equations (Reference)}

\subsection{Unified Evolution}

\[
\Psi(x,t+\Delta t)
=
\mathcal{F}_{4}
\circ
\mathcal{F}_{3}
\circ
\mathcal{F}_{2}
\circ
\mathcal{F}_{1}
\left[\Psi(x,t)\right].
\]

\subsection{Invariant Functional}

\[
\mathcal{I}_{\text{cc}}[\Psi]
=
\int_{\Omega}
w(x)\,\Psi(x,t)\, dx,
\qquad
\Delta \mathcal{I}_{\text{cc}} = 0.
\]

\section{Run Configuration}

\subsection{Spatial and Temporal Grid}

\[
x_i \in \Omega,\qquad
t_n = n\Delta t,
\]
\[
N_x: \text{number of spatial points},\quad
N_t: \text{number of time steps}.
\]

\subsection{Phase Parameters}

\begin{itemize}
  \item Ingest rate: $\lambda_{\text{in}}$.
  \item Entropy perturbation amplitude: $\|\eta\|$.
  \item Fault set size: $N_f$.
  \item Audit window: $T_{\text{window}}$.
\end{itemize}

\section{Diagnostics Per Version}

\subsection{Stability Metric}

\[
\sigma_{\Psi}^2(t)
=
\sum_{i}
\left|
\Psi_i(t) - \bar{\Psi}(t)
\right|^2.
\]

\subsection{Invariant Drift}

\[
\Delta \mathcal{I}_{\text{cc}}
=
\mathcal{I}_{\text{cc}}^{\text{end}}
-
\mathcal{I}_{\text{cc}}^{\text{start}}.
\]

\subsection{Kernel Recovery}

\[
\text{MTS}
=
\frac{1}{N_f}
\sum_{k}
\left(
t^{(k)}_{\text{recovered}}
-
t^{(k)}_{\text{fault}}
\right).
\]

\section{Version Notes}

