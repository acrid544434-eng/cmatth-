#include "organism_rules.h"
#include <math.h>

FieldPacket organism_evolve(FieldPacket f, double dt) {
    double lap = f.gradient[0] + f.gradient[1] + f.gradient[2];
    f.value += dt * (0.1 * lap + 0.01 * f.divergence);
    return f;
}

