#include "field_packet.h"
#include <string.h>

FieldPacket create_field_packet(double v, double grad[3], double div, double curl[3]) {
    FieldPacket f;
    f.value = v;
    memcpy(f.gradient, grad, sizeof(double)*3);
    f.divergence = div;
    memcpy(f.curl, curl, sizeof(double)*3);
    f.timestamp = 0;

    memset(f.signature, 0, 64);
    memset(f.provenance, 0, 32);

    return f;
}

/src/hash_H.c

#include "hash_H.h"
#include <openssl/sha.h>
#include <string.h>

FieldPacket apply_hash_H(FieldPacket f, EncryptionMode mode) {
    uint8_t buffer[256];
    memcpy(buffer, &f, sizeof(FieldPacket));

    uint8_t digest[64];
    SHA3_512(digest, buffer, sizeof(FieldPacket));

    FieldPacket out = f;

    double scale = 1e-6;

    for (int i = 0; i < 3; i++) {
        double h = (double)digest[i] / 255.0;
        if (mode == MODE_GRADIENT) out.gradient[i] += scale * h;
        if (mode == MODE_TOPOLOGY) out.curl[i]     += scale * h;
        if (mode == MODE_INERTIAL) out.value       += scale * h;
    }

    return out;
}

