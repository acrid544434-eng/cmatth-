import numpy as np
from .stencils import laplacian_3d

def evolve_matter(g, M, context):
    """
    Matter evolves under geometry influence.
    """
    matterstrength = context.get("matterresponse_strength", 0.5)
    geomcoupling = context.get("geomcoupling", 1.0)

    Mlap = laplacian3d(M)
    geomterm = geomcoupling * g[..., :1]  # geometry channel

    dMdt = matterstrength * (Mlap - geom_term)
    return dMdt
