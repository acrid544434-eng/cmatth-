

⭐ 1. Core Data Structures (Developer‑Ready Schemas)

These are the minimal, essential objects a developer would implement.

SystemState

Represents the full evolving state of the simulation at any timestep.

class SystemState:
    def __init__(self):
        self.temperature_field = {}        # region_id → float (K)
        self.stress_field = {}             # region_id → float (Pa)
        self.fatigue_cycles = {}           # region_id → float (0–1 normalized)
        self.power_levels = {}             # subsystem_id → float (W)
        self.plasma_params = {}            # region_id → {"density":..., "temp":..., "stability":...}
        self.environment = {"pressure": 0.0, "boundary_ok": True}
        self.time = 0.0

MaterialDefinition

Defines physical properties for each component.

class MaterialDefinition:
    def __init__(self, name, max_temp, yield_strength, fatigue_limit):
        self.name = name
        self.max_temp = max_temp
        self.yield_strength = yield_strength
        self.fatigue_limit = fatigue_limit

GeometryRegion

Defines a region of the system (wall, coil, chamber zone, etc.).

class GeometryRegion:
    def __init__(self, region_id, material, volume, surface_area):
        self.region_id = region_id
        self.material = material
        self.volume = volume
        self.surface_area = surface_area

PowerSubsystem

Tracks power generation and consumption.

class PowerSubsystem:
    def __init__(self, subsystem_id, max_draw, efficiency):
        self.subsystem_id = subsystem_id
        self.max_draw = max_draw
        self.efficiency = efficiency

ConstraintLimits

Defines all safety envelopes.

class ConstraintLimits:
    def __init__(self):
        self.max_temp = {}                 # region_id → K
        self.max_stress = {}               # region_id → Pa
        self.max_fatigue = {}              # region_id → 0–1
        self.max_power_draw = {}           # subsystem_id → W
        self.plasma_stability_threshold = 0.0
        self.min_pressure = 0.0            # vacuum boundary

SimulationConfig

Defines the scenario and runtime parameters.

class SimulationConfig:
    def __init__(self, geometry, materials, power_systems, plasma_regions, environment):
        self.geometry = geometry
        self.materials = materials
        self.power_systems = power_systems
        self.plasma_regions = plasma_regions
        self.environment = environment
        self.duration = 0.0
        self.dt = 0.0

