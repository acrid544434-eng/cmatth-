\section{Power Distribution \& Circuit Architecture}
% ============================================================

\subsection{Power Schematic}

\begin{itemize}
    \item 240V AC mains feed into a 10kW UPS.
    \item Primary DC busbar: $48\ \mathrm{V}$ at $100\ \mathrm{A}$.
    \item Buck regulators supply:
    \begin{itemize}
        \item $12\ \mathrm{V}$ rails for FPGA boards,
        \item $5\ \mathrm{V}$ rails for SDR receivers,
        \item Low-noise linear rails for cryogenic amplifiers.
    \end{itemize}
    \item Cryo-compressor powered directly from AC mains.
\end{itemize}

\subsection{Isolation Guidelines}

\begin{itemize}
    \item LDO regulators maintain SNR $> +65\ \mathrm{dB}$ for cryogenic amplifiers.
    \item Optocouplers isolate FPGA control signals from laser drivers.
    \item All RF paths use cryogenic coaxial cabling to minimize thermal noise.
\end{itemize}

% ============================================================
\section{Hardware Assembly \& Deployment Protocol}
% ============================================================

\subsection{Step 1: Vacuum Enclosure \& Magnetic Isolation}

\begin{itemize}
    \item Mount UHV chamber on pneumatic dampening legs.
    \item Evacuate to $10^{-9}\ \mathrm{Torr}$ using turbo pumps.
    \item Verify magnetic suppression $<0.1\ \mathrm{nT}$.
\end{itemize}

\subsection{Step 2: Sub-Kelvin Cryogenic Integration}

\begin{itemize}
    \item Install SNSPD arrays into cold stage.
    \item Cool to $T = 0.850\ \mathrm{K}$.
    \item Confirm dark count rate $\le 1.2 \times 10^{-3}\ \mathrm{Hz}$.
\end{itemize}

\subsection{Step 3: Laser Optical Bench Calibration}

\begin{itemize}
    \item Align $438\ \mathrm{THz}$ laser array through zero-expansion benches.
    \item Perform interferometric path delay zeroing.
    \item Maintain scanning variance $<0.001\ \mathrm{nm}$.
\end{itemize}

\subsection{Step 4: Astrophysical Telemetry Wiring}

\begin{itemize}
    \item Connect SDR receivers to FPGA boards via 100GbE fiber.
    \item Verify real-time pulsar/CMB key generation.
\end{itemize}

\subsection{Step 5: Full Hardware Integration Testing}

\begin{itemize}
    \item Execute continuous HITL loopback tests.
    \item Validate atomic scanner ingestion, QKD masking, and Q-LDPC output.
\end{itemize}

