import unittest
import cupy as cp
import numpy as np
from typing import Tuple

class TestAetherisGridRegression(unittest.TestCase):
    
    def setUp(self):
        # Enforce strict maximum divergence limits across scaling passes
        self.tolerance_divergence = 1e-6

    def run_grid_convergence_test(self, grid_shape: Tuple[int, int, int]) -> float:
        nx, ny, nz = grid_shape
        
        # Configure matching spatial domain deltas (proportional spatial scaling)
        domain_length = 2.0 * np.pi
        dx = domain_length / nx
        dy = domain_length / ny
        dz = domain_length / nz
        
        # Build spatial coordinates natively on the GPU
        x = cp.linspace(0, domain_length, nx, dtype=cp.float32)[:, cp.newaxis, cp.newaxis]
        y = cp.linspace(0, domain_length, ny, dtype=cp.float32)[cp.newaxis, :, cp.newaxis]
        z = cp.linspace(0, domain_length, nz, dtype=cp.float32)[cp.newaxis, \
            cp.newaxis, :]
        
        # Initialize an active, variable magnetic field configuration
        # Divergence-free analytical profile: B = [sin(y), sin(z), sin(x)]
        # True Del dot B = d(sin(y))/dx + d(sin(z))/dy + d(sin(x))/dz = 0 + 0 + 0 = 0
        B = cp.zeros((nx, ny, nz, 3), dtype=cp.float32)
        B[..., 0] = cp.sin(y)
        B[..., 1] = cp.sin(z)
        B[..., 2] = cp.sin(x)
        
        # Calculate true geometric 3D vector divergence: dBx/dx + dBy/dy + dBz/dz
        # Utilizes optimized second-order central difference operators
        dBx_dx = (cp.roll(B[..., 0], -1, axis=0) - cp.roll(B[..., 0], 1, \
            axis=0)) / (2.0 * dx)
        dBy_dy = (cp.roll(B[..., 1], -1, axis=1) - cp.roll(B[..., 1], 1, \
            axis=1)) / (2.0 * dy)
        dBz_dz = (cp.roll(B[..., 2], -1, axis=2) - cp.roll(B[..., 2], 1, \
            axis=2)) / (2.0 * dz)
        
        # Extract the maximum structural divergence deviation
        div_B_field = cp.abs(dBx_dx + dBy_dy + dBz_dz)
        max_div = float(cp.max(div_B_field))
        
        return max_div

    def test_grid_resolution_scaling(self):
        """
        Executes regression validation across coarse, medium, and fine grid configurations.
        """
        test_grids = [(128, 128, 32), (256, 256, 64), (512, 512, 128)]
        
        print("\n[AETHERIS-SOLAR] Starting multi-scale regression trials...")
        for grid in test_grids:
            with self.subTest(grid=grid):
                max_div = self.run_grid_convergence_test(grid)
                print(f"[AETHERIS-SOLAR] Mesh Profile: {str(grid):<15} | Max Observed Div: {max_div:.7e}")
                
                self.assertLessEqual(
                    max_div, 
                    self.tolerance_divergence, 
                    f"Regression failure on grid {grid}: Max divergence {max_div:.7e} exceeded threshold."
                )

if __name__ == "__main__":
    unittest.main()
