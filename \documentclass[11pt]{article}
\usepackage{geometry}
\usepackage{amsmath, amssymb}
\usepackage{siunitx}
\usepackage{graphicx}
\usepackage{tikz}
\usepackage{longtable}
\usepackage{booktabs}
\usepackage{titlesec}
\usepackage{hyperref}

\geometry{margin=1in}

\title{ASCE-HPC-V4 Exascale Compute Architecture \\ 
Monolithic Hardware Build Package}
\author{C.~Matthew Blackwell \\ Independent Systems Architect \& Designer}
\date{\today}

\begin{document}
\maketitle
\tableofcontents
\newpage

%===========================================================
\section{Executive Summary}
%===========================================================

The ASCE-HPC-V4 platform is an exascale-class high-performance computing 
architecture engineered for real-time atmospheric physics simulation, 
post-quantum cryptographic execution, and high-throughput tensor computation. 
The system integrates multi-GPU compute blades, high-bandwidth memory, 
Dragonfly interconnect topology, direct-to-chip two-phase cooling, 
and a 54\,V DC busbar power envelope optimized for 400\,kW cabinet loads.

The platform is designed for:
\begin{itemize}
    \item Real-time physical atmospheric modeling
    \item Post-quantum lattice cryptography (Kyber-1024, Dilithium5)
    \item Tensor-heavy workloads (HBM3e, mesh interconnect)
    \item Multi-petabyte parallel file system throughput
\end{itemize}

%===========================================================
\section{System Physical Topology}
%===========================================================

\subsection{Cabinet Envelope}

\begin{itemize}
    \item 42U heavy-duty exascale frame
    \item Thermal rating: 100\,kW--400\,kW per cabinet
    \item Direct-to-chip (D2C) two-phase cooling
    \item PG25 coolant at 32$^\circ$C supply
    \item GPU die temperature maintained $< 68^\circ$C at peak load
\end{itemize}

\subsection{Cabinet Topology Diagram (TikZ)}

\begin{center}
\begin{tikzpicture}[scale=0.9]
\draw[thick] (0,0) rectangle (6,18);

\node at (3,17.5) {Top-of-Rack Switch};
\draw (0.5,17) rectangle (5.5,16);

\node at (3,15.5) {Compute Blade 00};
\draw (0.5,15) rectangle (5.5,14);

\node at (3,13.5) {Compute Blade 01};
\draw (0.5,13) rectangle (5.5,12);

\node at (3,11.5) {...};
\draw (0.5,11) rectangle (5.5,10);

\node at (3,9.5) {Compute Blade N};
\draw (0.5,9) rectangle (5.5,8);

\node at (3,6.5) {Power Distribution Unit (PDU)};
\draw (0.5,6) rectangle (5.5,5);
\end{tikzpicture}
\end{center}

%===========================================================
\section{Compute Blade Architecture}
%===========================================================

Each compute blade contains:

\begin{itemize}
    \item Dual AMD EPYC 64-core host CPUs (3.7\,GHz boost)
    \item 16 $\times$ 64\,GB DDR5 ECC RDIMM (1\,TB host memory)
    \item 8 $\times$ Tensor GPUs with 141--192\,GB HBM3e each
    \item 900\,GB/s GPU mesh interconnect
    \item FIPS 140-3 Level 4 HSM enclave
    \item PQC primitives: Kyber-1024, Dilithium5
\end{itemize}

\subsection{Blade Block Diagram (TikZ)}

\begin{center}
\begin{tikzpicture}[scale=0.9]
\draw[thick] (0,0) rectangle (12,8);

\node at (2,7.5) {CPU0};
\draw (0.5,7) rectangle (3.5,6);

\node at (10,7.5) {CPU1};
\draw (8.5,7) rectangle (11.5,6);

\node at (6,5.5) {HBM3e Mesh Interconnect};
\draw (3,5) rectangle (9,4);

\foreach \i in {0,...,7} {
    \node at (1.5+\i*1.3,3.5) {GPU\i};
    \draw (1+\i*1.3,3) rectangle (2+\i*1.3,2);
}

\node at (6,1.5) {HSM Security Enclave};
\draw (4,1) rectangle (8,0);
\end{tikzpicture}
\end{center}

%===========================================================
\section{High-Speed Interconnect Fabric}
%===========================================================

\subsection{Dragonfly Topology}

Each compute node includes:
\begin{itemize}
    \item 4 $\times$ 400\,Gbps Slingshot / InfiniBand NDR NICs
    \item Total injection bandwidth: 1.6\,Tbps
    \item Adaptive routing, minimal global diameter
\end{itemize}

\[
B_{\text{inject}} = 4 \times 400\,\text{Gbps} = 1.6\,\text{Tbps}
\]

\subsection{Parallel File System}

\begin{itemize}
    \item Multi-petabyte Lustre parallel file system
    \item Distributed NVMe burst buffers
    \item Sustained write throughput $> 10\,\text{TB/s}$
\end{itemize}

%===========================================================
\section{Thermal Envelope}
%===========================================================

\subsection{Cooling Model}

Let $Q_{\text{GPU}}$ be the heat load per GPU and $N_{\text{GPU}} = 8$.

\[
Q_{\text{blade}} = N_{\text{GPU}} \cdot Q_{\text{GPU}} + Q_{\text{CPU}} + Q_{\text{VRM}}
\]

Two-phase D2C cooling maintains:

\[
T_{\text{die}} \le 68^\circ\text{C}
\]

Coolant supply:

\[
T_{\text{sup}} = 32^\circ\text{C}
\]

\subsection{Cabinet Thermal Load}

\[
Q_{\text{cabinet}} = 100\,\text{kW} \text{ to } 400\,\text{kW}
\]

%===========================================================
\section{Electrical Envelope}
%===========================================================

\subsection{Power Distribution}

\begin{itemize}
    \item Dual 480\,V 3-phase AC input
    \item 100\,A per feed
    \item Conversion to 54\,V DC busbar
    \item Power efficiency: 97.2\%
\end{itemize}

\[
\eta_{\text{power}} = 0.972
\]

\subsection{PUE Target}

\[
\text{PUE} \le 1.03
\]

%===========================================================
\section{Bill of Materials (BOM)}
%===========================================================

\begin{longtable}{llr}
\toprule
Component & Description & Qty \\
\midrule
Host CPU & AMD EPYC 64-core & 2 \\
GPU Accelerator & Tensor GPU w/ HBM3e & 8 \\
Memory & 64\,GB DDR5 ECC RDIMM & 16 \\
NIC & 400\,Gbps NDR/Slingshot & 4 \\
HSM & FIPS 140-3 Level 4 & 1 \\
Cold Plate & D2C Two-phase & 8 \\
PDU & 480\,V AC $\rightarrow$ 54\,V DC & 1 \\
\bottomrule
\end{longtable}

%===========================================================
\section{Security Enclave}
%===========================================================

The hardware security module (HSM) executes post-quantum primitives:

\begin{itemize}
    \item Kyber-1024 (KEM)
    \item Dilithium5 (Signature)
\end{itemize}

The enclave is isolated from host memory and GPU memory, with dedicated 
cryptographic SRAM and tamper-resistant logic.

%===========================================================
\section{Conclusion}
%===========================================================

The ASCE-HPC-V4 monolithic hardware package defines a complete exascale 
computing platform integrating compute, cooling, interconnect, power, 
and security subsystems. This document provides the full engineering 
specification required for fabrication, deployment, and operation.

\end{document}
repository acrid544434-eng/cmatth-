\section{Electrical Envelope}
%===========================================================

\subsection{Power Distribution}

\begin{itemize}
    \item Dual 480\,V 3-phase AC input
    \item 100\,A per feed
    \item Conversion to 54\,V DC busbar
    \item Power efficiency: 97.2\%
\end{itemize}

\[
\eta_{\text{power}} = 0.972
\]

\subsection{PUE Target}

\[
\text{PUE} \le 1.03
\]

