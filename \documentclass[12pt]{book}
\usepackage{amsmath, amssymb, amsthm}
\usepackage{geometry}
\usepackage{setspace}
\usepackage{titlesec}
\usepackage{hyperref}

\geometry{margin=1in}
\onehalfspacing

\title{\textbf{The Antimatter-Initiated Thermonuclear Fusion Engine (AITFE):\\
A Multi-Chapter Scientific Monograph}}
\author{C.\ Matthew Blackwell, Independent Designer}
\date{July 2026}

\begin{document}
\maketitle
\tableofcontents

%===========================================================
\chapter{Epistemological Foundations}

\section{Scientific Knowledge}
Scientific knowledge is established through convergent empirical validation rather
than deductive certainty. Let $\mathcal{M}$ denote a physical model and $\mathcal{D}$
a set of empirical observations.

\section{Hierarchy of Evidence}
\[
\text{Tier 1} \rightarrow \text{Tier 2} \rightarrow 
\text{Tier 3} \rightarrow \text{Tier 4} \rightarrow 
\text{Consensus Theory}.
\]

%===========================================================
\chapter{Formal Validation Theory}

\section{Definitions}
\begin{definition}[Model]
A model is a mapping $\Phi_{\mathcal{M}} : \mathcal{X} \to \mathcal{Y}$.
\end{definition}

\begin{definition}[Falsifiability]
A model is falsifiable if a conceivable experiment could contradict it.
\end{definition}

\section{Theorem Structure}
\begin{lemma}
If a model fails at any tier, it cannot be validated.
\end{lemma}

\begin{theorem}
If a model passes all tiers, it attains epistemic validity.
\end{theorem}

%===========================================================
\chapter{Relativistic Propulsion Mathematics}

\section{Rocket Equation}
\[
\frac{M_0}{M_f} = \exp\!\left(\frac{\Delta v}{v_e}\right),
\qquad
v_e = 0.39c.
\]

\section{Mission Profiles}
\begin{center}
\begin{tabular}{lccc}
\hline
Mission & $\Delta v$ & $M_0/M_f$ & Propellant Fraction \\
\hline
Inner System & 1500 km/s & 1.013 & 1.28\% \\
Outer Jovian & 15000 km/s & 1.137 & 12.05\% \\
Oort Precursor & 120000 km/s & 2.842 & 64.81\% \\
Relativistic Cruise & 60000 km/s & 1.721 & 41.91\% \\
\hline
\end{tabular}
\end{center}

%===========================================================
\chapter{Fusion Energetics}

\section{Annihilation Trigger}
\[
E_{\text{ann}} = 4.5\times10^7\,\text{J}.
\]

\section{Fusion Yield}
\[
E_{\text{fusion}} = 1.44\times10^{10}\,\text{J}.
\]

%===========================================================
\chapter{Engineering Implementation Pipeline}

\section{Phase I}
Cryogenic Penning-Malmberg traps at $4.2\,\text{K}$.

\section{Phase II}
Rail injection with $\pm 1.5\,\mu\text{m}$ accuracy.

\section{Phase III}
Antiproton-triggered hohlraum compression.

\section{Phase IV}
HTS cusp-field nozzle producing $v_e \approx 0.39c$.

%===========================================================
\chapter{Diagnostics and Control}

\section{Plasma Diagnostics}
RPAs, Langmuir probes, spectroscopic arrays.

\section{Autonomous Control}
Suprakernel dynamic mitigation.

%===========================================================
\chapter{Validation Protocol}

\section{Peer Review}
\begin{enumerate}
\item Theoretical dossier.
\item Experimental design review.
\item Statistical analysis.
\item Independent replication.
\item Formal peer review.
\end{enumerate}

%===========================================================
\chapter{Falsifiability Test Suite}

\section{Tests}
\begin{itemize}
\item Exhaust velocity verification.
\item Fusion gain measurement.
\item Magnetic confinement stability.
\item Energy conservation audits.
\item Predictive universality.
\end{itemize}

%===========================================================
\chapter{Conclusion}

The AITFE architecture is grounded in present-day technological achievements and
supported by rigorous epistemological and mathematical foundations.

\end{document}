\chapter{Formal Validation Theory}

\section{Definitions}
\begin{definition}[Model]
A model is a mapping $\Phi_{\mathcal{M}} : \mathcal{X} \to \mathcal{Y}$.
\end{definition}

\begin{definition}[Falsifiability]
A model is falsifiable if a conceivable experiment could contradict it.
\end{definition}

\section{Theorem Structure}
\begin{lemma}
If a model fails at any tier, it cannot be validated.
\end{lemma}

\begin{theorem}
If a model passes all tiers, it attains epistemic validity.
\end{theorem}

