\section{Mathematical Foundation}

Let the global state-space be:
\begin{equation}
  \bm{X}(t) \in \mathbb{R}^n,
\end{equation}
with evolution governed by:
\begin{equation}
  \frac{d\bm{X}}{dt} = \bm{F}(\bm{X}(t), t).
\end{equation}

Define the unified invariant set:
\begin{equation}
  \mathcal{R}_{\text{sovereign}}
  =
  \mathcal{R}_{\text{hemo}}
  \land
  \mathcal{R}_{\text{astro}}
  \land
  \mathcal{R}_{\text{aux}}.
\end{equation}

Stability is evaluated using a Lyapunov functional:
\begin{equation}
  V(\bm{X})
  =
  \frac{1}{2}
  \left\lVert \bm{X}(t) - \bm{X}^\ast \right\rVert^2,
\end{equation}
with convergence condition:
\begin{equation}
  \frac{dV}{dt} < 0
  \quad\forall\ \bm{X} \neq \bm{X}^\ast.
\end{equation}

