\chapter{York Decomposition and Constraint Solving}

\section{Introduction}
The York decomposition provides a powerful method for solving the ADM constraint 
equations by decomposing the spatial metric and extrinsic curvature into conformal 
and transverse–traceless components. This chapter develops the full York formalism 
required for UKG-SE v2.0, including conformal rescaling, TT decomposition, vector 
potentials, and the elliptic equations governing constraint solutions.

\section{Conformal Decomposition of the Spatial Metric}

\subsection{Metric Rescaling}
Let $h_{ij}$ be the spatial metric on $\Sigma_t$. York introduces a conformal 
rescaling:
\begin{equation}
h_{ij} = \psi^4 \tilde{h}_{ij},
\end{equation}
where:
\begin{itemize}
    \item $\psi$ is the conformal factor,
    \item $\tilde{h}_{ij}$ is the conformal metric.
\end{itemize}

\subsection{Determinant Condition}
Choose:
\begin{equation}
\det(\tilde{h}_{ij}) = 1,
\end{equation}
so that:
\begin{equation}
\det(h_{ij}) = \psi^{12}.
\end{equation}

\section{Extrinsic Curvature Decomposition}

\subsection{Trace and Trace-Free Parts}
Decompose:
\begin{equation}
K_{ij} = A_{ij} + \frac{1}{3} h_{ij} K,
\end{equation}
where:
\begin{itemize}
    \item $K$ is the trace,
    \item $A_{ij}$ is the trace-free part.
\end{itemize}

\subsection{Conformal Rescaling of $A_{ij}$}
Define:
\begin{equation}
A^{ij} = \psi^{-10} \tilde{A}^{ij}.
\end{equation}

\section{Transverse–Traceless (TT) Decomposition}

\subsection{TT Decomposition of $\tilde{A}^{ij}$}
York decomposes:
\begin{equation}
\tilde{A}^{ij} =
\tilde{A}^{ij}_{\text{TT}}
+ (\tilde{L} W)^{ij},
\end{equation}
where:
\begin{itemize}
    \item $\tilde{A}^{ij}_{\text{TT}}$ is transverse–traceless,
    \item $W^i$ is a vector potential,
    \item $(\tilde{L} W)^{ij}$ is the longitudinal part.
\end{itemize}

\subsection{Longitudinal Operator}
The longitudinal operator is:
\begin{equation}
(\tilde{L} W)^{ij} =
\tilde{D}^i W^j
+ \tilde{D}^j W^i
- \frac{2}{3} \tilde{h}^{ij} \tilde{D}_k W^k,
\end{equation}
where $\tilde{D}_i$ is the covariant derivative compatible with $\tilde{h}_{ij}$.

\section{Hamiltonian Constraint in York Form}

\subsection{Original Hamiltonian Constraint}
\begin{equation}
R^{(3)} + K^2 - K_{ij} K^{ij} = 16\pi G \rho.
\end{equation}

\subsection{Conformal Transformation}
Under conformal rescaling:
\begin{equation}
R^{(3)} = \psi^{-4} \tilde{R}
- 8 \psi^{-5} \tilde{D}^2 \psi.
\end{equation}

\subsection{York Hamiltonian Constraint}
The Hamiltonian constraint becomes:
\begin{equation}
\tilde{D}^2 \psi
- \frac{1}{8} \tilde{R} \psi
+ \frac{1}{8} \psi^{-7}
\tilde{A}_{ij} \tilde{A}^{ij}
+ \frac{1}{12} K^2 \psi^5
= -2\pi G \psi^5 \rho.
\end{equation}

This is an elliptic equation for $\psi$.

\section{Momentum Constraint in York Form}

\subsection{Original Momentum Constraint}
\begin{equation}
D_j (K^{ij} - h^{ij} K) = 8\pi G S^i.
\end{equation}

\subsection{Conformal Transformation}
The momentum constraint becomes:
\begin{equation}
\tilde{D}_j (\tilde{L} W)^{ij}
= \frac{2}{3} \psi^6 \tilde{D}^i K
+ 8\pi G \psi^{10} S^i.
\end{equation}

This is an elliptic equation for $W^i$.

\section{York Gauge Choices}

\subsection{Constant Mean Curvature (CMC)}
York often chooses:
\begin{equation}
K = \text{constant}.
\end{equation}

This simplifies the momentum constraint.

\subsection{Conformal Transverse–Traceless (CTT)}
Choose:
\begin{equation}
\tilde{A}^{ij}_{\text{TT}} = 0.
\end{equation}

This reduces the Hamiltonian constraint to:
\begin{equation}
\tilde{D}^2 \psi
- \frac{1}{8} \tilde{R} \psi
+ \frac{1}{8} \psi^{-7}
(\tilde{L} W)_{ij} (\tilde{L} W)^{ij}
+ \frac{1}{12} K^2 \psi^5
= -2\pi G \psi^5 \rho.
\end{equation}

\section{York Decomposition in Kerr Geometry}

\subsection{Conformal Kerr Metric}
Define:
\begin{equation}
\tilde{h}_{ij} = \psi^{-4} h_{ij}^{\text{Kerr}}.
\end{equation}

\subsection{Extrinsic Curvature}
The Kerr extrinsic curvature contains rotational contributions:
\begin{equation}
K_{r\phi} \neq 0, \qquad
K_{\theta\phi} \neq 0.
\end{equation}

These feed into:
\begin{equation}
\tilde{A}^{ij} = \psi^{10} A^{ij}.
\end{equation}

\section{Constraint Solving in UKG-SE}

\subsection{York Solver Pipeline}
UKG-SE solves:
\begin{enumerate}
    \item Momentum constraint for $W^i$,
    \item Hamiltonian constraint for $\psi$,
    \item Reconstruction of $h_{ij}$ and $K_{ij}$.
\end{enumerate}

\subsection{Constraint Stability}
UKG-SE enforces:
\begin{equation}
\mathcal{H} < 10^{-12}, \qquad
\mathcal{M}^i < 10^{-12}.
\end{equation}

\section{Conclusion}
This chapter develops the York conformal decomposition required for solving the ADM 
constraints in UKG-SE v2.0. The York method provides a robust and mathematically 
rigorous framework for generating initial data in curved and rotating geometries, 
including high-spin Kerr systems.