\section{Invariant Preservation Theorem}

\begin{theorem}[\textbf{Sovereign Invariant Preservation}]
Let $\mathcal{K}$ be the Sovereign Multi-Domain Coupling Operator and 
$\mathcal{I}_{\text{unified}}$ the global invariant. 
If each subsystem operator $\mathcal{K}_k$ preserves its respective 
invariant $\mathcal{I}_k$, then the unified operator preserves the 
global invariant:

\begin{equation}
\mathcal{K}(\mathcal{I}_{\text{unified}}) = \mathcal{I}_{\text{unified}}.
\end{equation}
\end{theorem}

\begin{proof}
The unified operator is a direct sum of subsystem operators:

\begin{equation}
\mathcal{K}
=
\bigoplus_k \mathcal{K}_k.
\end{equation}

Since each $\mathcal{K}_k$ preserves $\mathcal{I}_k$, the direct sum 
preserves the sum of invariants. Therefore:

\begin{equation}
\frac{d}{dt}
\left(
\sum_k \mathcal{I}_k
\right)
=
\sum_k
\frac{d\mathcal{I}_k}{dt}
=
0.
\end{equation}

Thus $\mathcal{I}_{\text{unified}}$ is conserved.
\end{proof}

