\[
F_{\mathrm{net}}
= F_{\mathrm{shortwave}} + F_{\mathrm{longwave}} + F_{\mathrm{excess}}.
\]

\subsubsection{Atmospheric Domination Invariant}
\[
D_{\mathrm{dominate}}
= 0.9999998\left(\frac{1}{R_t}\right)
\left(\frac{\partial \gamma}{\partial t}
+ E_k(v_h + v_{wx})\right).
\]

\subsection{Closed-Loop Control Layer}
Control vectors $u_{\mathrm{control}}$ are applied across:
\begin{itemize}
    \item stratospheric aerosol injection (SAI),
    \item predictive weather steering,
    \item radiative flux modulation,
    \item boundary-layer energy redistribution.
\end{itemize}

