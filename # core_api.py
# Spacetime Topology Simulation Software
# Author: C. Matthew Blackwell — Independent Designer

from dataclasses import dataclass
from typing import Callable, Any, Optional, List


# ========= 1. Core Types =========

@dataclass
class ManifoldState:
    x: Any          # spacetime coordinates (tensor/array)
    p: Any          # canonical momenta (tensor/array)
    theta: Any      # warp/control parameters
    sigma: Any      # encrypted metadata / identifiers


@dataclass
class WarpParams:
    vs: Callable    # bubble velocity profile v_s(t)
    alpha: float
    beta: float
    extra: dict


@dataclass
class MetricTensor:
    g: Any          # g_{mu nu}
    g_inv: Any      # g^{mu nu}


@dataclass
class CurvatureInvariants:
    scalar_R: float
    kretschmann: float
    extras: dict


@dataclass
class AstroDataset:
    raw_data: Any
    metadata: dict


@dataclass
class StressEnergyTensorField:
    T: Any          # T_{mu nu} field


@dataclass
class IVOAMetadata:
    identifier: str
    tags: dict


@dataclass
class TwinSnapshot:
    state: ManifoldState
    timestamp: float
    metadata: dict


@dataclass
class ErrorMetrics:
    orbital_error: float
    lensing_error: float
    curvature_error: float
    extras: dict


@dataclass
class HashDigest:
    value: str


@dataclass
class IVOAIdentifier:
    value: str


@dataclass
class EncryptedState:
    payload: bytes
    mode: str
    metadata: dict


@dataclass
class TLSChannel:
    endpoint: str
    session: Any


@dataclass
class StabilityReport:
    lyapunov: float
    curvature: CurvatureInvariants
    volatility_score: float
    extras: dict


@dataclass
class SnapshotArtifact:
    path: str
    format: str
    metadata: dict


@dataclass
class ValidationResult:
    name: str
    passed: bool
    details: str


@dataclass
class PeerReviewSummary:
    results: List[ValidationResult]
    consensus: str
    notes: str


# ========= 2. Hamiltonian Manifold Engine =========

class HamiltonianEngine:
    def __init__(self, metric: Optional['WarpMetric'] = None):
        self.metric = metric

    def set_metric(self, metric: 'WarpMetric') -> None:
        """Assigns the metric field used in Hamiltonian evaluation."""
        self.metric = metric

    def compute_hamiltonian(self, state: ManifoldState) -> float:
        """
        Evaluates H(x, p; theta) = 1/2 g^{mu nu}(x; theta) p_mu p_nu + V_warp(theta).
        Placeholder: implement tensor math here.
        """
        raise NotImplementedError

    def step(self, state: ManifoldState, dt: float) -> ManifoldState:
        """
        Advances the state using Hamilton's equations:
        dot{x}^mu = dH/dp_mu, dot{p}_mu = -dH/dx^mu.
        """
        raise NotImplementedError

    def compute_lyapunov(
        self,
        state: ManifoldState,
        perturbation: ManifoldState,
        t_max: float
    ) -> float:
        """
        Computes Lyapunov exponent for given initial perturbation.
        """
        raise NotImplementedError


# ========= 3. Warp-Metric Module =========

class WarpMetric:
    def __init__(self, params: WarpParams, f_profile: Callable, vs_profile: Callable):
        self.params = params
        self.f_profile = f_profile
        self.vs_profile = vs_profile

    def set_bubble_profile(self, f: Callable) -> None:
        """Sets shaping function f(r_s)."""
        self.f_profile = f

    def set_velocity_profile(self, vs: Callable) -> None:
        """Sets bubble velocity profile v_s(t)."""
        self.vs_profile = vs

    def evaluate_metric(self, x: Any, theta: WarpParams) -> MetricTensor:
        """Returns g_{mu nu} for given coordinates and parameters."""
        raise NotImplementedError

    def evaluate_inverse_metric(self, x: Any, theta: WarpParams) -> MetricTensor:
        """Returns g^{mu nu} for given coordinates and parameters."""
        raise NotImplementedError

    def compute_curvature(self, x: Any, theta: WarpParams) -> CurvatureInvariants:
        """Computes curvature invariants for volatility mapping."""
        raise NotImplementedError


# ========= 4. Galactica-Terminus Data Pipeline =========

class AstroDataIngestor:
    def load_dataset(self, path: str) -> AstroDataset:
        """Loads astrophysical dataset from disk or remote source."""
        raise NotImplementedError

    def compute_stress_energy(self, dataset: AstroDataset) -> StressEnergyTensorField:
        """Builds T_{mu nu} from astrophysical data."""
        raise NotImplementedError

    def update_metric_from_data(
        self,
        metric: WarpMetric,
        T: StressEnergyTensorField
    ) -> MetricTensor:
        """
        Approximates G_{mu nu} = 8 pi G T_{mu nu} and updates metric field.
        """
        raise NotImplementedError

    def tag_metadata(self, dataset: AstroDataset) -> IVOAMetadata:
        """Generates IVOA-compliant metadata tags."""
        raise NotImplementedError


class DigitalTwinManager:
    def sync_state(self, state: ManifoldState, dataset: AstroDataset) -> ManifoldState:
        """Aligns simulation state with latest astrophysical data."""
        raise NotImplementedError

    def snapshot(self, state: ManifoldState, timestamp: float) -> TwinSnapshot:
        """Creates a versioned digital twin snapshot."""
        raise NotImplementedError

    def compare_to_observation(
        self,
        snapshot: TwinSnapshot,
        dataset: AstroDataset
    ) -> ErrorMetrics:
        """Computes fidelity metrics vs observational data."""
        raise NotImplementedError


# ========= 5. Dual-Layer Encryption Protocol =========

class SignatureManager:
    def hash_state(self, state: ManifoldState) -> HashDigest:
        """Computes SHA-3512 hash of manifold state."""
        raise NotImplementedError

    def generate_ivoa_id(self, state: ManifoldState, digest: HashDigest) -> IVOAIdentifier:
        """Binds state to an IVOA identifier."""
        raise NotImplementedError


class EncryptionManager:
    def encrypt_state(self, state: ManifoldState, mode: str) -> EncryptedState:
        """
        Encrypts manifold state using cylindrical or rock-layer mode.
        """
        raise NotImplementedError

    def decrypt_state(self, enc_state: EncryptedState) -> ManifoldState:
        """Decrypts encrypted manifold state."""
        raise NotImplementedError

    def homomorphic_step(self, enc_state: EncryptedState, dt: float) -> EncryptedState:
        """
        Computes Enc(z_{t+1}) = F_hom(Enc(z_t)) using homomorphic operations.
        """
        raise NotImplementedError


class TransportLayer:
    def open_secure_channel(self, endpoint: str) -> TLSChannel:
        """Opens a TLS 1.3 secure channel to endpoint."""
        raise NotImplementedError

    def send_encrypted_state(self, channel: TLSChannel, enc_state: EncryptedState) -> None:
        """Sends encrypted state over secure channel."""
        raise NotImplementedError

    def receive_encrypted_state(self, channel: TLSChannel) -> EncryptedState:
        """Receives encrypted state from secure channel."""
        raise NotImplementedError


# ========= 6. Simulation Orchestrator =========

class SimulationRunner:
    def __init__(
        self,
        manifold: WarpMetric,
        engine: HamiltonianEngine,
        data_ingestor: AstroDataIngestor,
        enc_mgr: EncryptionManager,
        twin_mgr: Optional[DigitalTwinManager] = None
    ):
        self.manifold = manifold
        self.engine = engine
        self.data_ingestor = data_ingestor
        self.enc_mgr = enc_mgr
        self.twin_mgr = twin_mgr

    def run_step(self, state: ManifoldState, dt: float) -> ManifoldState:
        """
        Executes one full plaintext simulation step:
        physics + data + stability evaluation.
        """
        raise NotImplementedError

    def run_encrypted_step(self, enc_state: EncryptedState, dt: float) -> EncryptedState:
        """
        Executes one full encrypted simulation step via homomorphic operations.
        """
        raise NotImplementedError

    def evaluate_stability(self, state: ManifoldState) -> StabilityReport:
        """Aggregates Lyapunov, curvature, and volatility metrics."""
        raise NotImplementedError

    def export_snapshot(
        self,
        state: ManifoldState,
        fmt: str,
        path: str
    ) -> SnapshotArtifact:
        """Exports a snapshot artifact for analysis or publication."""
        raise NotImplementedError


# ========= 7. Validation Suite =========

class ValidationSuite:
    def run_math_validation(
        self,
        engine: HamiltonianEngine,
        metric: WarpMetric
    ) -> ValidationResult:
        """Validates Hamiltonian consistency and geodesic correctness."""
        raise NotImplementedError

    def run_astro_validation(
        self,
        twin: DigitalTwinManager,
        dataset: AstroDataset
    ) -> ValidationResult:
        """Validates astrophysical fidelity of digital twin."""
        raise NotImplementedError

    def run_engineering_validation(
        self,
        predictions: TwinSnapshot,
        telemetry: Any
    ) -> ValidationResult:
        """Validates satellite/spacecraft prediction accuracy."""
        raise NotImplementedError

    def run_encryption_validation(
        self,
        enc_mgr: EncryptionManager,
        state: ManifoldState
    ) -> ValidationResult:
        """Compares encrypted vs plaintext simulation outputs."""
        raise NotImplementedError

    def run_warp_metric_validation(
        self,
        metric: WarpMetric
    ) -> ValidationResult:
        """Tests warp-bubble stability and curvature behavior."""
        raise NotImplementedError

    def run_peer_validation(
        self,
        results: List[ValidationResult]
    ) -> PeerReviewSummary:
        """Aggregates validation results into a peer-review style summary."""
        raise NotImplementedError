from dataclasses import dataclass
from typing import Callable, Any, Optional, List


# ========= 1. Core Types =========

@dataclass
class ManifoldState:
    x: Any          # spacetime coordinates (tensor/array)
    p: Any          # canonical momenta (tensor/array)
    theta: Any      # warp/control parameters
    sigma: Any      # encrypted metadata / identifiers


@dataclass
class WarpParams:
    vs: Callable    # bubble velocity profile v_s(t)
    alpha: float
    beta: float
    extra: dict


@dataclass
class MetricTensor:
    g: Any          # g_{mu nu}
    g_inv: Any      # g^{mu nu}


@dataclass
class CurvatureInvariants:
    scalar_R: float
    kretschmann: float
    extras: dict


@dataclass
class AstroDataset:
    raw_data: Any
    metadata: dict


@dataclass
class StressEnergyTensorField:
    T: Any          # T_{mu nu} field


@dataclass
class IVOAMetadata:
    identifier: str
    tags: dict


@dataclass
class TwinSnapshot:
    state: ManifoldState
    timestamp: float
    metadata: dict


@dataclass
class ErrorMetrics:
    orbital_error: float
    lensing_error: float
    curvature_error: float
    extras: dict


@dataclass
class HashDigest:
    value: str


@dataclass
class IVOAIdentifier:
    value: str


@dataclass
class EncryptedState:
    payload: bytes
    mode: str
    metadata: dict


@dataclass
class TLSChannel:
    endpoint: str
    session: Any


@dataclass
class StabilityReport:
    lyapunov: float
    curvature: CurvatureInvariants
    volatility_score: float
    extras: dict


@dataclass
class SnapshotArtifact:
    path: str
    format: str
    metadata: dict


@dataclass
class ValidationResult:
    name: str
    passed: bool
    details: str


@dataclass
class PeerReviewSummary:
    results: List[ValidationResult]
    consensus: str
    notes: str


