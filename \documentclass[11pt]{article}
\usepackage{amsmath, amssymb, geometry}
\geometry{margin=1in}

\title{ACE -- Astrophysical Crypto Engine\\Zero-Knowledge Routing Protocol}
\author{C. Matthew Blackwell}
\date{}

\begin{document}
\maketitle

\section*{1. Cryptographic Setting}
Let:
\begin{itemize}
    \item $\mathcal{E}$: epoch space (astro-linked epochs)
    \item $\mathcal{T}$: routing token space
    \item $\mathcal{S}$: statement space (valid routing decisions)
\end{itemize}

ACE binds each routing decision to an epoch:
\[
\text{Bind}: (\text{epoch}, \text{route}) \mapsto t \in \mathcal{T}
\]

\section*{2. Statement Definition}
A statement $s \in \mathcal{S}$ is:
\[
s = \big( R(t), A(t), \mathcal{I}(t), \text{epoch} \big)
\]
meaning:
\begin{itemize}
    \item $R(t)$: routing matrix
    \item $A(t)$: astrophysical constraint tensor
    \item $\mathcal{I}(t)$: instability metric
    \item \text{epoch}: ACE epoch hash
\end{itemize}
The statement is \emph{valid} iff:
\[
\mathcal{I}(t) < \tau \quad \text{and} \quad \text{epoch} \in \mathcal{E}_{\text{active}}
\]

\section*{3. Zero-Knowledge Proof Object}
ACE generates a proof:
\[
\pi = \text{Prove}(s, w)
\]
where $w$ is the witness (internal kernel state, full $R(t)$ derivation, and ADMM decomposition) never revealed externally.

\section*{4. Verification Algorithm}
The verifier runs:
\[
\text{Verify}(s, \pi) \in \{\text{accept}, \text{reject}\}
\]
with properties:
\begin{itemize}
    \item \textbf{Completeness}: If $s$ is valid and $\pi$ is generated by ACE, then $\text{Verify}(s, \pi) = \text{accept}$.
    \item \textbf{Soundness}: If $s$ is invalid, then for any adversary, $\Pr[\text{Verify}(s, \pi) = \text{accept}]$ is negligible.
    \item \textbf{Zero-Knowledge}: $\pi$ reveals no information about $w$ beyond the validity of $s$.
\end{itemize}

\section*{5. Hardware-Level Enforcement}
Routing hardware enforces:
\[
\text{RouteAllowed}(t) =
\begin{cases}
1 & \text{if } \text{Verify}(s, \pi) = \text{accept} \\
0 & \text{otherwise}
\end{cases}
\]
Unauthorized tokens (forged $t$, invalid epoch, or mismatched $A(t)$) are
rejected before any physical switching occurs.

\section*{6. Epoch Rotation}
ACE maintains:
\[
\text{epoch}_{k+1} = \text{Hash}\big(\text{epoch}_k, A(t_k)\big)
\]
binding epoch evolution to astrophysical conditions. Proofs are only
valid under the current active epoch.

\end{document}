\section*{1. Cryptographic Setting}
Let:
\begin{itemize}
    \item $\mathcal{E}$: epoch space (astro-linked epochs)
    \item $\mathcal{T}$: routing token space
    \item $\mathcal{S}$: statement space (valid routing decisions)
\end{itemize}

ACE binds each routing decision to an epoch:
\[
\text{Bind}: (\text{epoch}, \text{route}) \mapsto t \in \mathcal{T}
\]

\section*{2. Statement Definition}
A statement $s \in \mathcal{S}$ is:
\[
s = \big( R(t), A(t), \mathcal{I}(t), \text{epoch} \big)
\]
meaning:
\begin{itemize}
    \item $R(t)$: routing matrix
    \item $A(t)$: astrophysical constraint tensor
    \item $\mathcal{I}(t)$: instability metric
    \item \text{epoch}: ACE epoch hash
\end{itemize}
The statement is \emph{valid} iff:
\[
\mathcal{I}(t) < \tau \quad \text{and} \quad \text{epoch} \in \mathcal{E}_{\text{active}}
\]

\section*{3. Zero-Knowledge Proof Object}
ACE generates a proof:
\[
\pi = \text{Prove}(s, w)
\]
where $w$ is the witness (internal kernel state, full $R(t)$ derivation, and ADMM decomposition) never revealed externally.

\section*{4. Verification Algorithm}
The verifier runs:
\[
\text{Verify}(s, \pi) \in \{\text{accept}, \text{reject}\}
\]
with properties:
\begin{itemize}
    \item \textbf{Completeness}: If $s$ is valid and $\pi$ is generated by ACE, then $\text{Verify}(s, \pi) = \text{accept}$.
    \item \textbf{Soundness}: If $s$ is invalid, then for any adversary, $\Pr[\text{Verify}(s, \pi) = \text{accept}]$ is negligible.
    \item \textbf{Zero-Knowledge}: $\pi$ reveals no information about $w$ beyond the validity of $s$.
\end{itemize}

\section*{5. Hardware-Level Enforcement}
Routing hardware enforces:
\[
\text{RouteAllowed}(t) =
\begin{cases}
1 & \text{if } \text{Verify}(s, \pi) = \text{accept} \\
0 & \text{otherwise}
\end{cases}
\]
Unauthorized tokens (forged $t$, invalid epoch, or mismatched $A(t)$) are
rejected before any physical switching occurs.

\section*{6. Epoch Rotation}
ACE maintains:
\[
\text{epoch}_{k+1} = \text{Hash}\big(\text{epoch}_k, A(t_k)\big)
\]
binding epoch evolution to astrophysical conditions. Proofs are only
valid under the current active epoch.

