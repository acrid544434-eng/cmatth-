\section{TSSE Relativistic Propulsion Theorems}

\begin{theorem}[Relativistic Temporal Symmetry Preservation]
Any TSSE-admissible relativistic propulsion system preserves temporal symmetry:
\[
\mathcal{T}\mathcal{U}(t) = \mathcal{U}(t)\mathcal{T}.
\]
\end{theorem}

\begin{proof}
Direct consequence of Axiom 1 and the relativistic Hamiltonian commutation relation.
\end{proof}

\begin{theorem}[Relativistic Phase-Space Conservation]
If $\mathcal{U}(t)$ is symplectic, then:
\[
\det(D\mathcal{U}(t)) = 1.
\]
\end{theorem}

\begin{proof}
Symplectic matrices have unit determinant. Relativistic corrections do not alter
symplecticity.
\end{proof}

\begin{theorem}[Relativistic Structural Stability]
If $\mathcal{S}$ is a TSSE structural manifold, then relativistic exhaust dynamics
cannot eject the system from $\mathcal{S}$.
\end{theorem}

\begin{proof}
Follows from manifold closure and symplectic invariance.
\end{proof}

