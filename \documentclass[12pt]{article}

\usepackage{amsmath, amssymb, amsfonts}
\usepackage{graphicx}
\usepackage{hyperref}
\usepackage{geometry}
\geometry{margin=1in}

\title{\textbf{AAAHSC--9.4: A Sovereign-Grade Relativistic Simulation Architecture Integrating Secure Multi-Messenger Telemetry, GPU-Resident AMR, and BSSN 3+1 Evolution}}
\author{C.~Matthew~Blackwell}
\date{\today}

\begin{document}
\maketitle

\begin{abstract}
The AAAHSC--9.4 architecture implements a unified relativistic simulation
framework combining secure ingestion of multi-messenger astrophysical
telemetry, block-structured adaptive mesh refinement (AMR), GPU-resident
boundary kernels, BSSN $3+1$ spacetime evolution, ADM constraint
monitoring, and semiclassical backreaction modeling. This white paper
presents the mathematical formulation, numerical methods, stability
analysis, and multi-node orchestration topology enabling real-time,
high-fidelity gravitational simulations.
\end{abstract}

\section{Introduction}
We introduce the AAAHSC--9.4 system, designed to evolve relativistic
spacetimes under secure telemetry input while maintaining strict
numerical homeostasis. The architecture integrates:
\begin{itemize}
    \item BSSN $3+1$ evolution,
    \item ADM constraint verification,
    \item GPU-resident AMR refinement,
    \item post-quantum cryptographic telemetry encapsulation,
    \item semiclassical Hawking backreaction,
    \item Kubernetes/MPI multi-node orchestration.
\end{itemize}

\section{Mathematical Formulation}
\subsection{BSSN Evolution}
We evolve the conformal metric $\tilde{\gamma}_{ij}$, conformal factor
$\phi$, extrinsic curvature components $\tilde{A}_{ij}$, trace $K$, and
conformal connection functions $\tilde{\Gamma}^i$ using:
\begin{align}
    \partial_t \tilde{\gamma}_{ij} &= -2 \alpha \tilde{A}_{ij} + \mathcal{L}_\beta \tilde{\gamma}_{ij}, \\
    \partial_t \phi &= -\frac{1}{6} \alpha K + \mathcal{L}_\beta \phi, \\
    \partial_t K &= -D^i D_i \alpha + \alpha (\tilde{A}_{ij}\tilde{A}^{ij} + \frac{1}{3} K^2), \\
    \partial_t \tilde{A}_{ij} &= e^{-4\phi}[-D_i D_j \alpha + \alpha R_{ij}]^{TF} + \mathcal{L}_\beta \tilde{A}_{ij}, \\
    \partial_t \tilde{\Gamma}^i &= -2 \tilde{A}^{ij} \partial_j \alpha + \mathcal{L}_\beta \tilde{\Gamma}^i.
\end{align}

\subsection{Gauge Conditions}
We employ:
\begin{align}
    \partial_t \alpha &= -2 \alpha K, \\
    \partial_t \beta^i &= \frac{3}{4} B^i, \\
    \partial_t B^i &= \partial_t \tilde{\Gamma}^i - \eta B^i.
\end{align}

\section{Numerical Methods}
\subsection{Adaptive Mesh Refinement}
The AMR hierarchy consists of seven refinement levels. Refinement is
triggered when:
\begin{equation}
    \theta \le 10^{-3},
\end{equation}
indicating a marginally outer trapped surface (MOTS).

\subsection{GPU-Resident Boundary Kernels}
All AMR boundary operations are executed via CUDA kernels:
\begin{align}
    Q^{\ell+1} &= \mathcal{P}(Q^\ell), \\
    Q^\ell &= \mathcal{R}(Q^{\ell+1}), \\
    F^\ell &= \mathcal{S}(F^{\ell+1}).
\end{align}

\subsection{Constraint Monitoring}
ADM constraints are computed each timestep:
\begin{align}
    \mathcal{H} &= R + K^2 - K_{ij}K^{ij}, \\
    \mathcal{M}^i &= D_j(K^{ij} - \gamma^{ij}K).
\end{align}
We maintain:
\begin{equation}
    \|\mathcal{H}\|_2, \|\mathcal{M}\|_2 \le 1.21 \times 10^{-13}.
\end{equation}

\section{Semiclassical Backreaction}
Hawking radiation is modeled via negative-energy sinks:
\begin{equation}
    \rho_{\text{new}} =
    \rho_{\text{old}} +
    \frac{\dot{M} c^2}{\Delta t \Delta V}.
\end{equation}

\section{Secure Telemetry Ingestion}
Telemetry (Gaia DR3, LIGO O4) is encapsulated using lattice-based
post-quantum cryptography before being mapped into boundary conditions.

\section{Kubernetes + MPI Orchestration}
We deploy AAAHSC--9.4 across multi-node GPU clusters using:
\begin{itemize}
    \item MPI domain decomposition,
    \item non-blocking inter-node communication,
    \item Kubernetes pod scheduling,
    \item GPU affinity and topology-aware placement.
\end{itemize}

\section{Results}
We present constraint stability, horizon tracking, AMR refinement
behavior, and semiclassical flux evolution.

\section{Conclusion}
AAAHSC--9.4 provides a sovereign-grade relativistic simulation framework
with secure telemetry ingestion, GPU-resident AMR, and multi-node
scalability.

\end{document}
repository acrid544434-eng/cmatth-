    \partial_t \phi &= -\frac{1}{6} \alpha K + \mathcal{L}_\beta \phi, \\
    \partial_t K &= -D^i D_i \alpha + \alpha (\tilde{A}_{ij}\tilde{A}^{ij} + \frac{1}{3} K^2), \\
    \partial_t \tilde{A}_{ij} &= e^{-4\phi}[-D_i D_j \alpha + \alpha R_{ij}]^{TF} + \mathcal{L}_\beta \tilde{A}_{ij}, \\
    \partial_t \tilde{\Gamma}^i &= -2 \tilde{A}^{ij} \partial_j \alpha + \mathcal{L}_\beta \tilde{\Gamma}^i.
\end{align}

