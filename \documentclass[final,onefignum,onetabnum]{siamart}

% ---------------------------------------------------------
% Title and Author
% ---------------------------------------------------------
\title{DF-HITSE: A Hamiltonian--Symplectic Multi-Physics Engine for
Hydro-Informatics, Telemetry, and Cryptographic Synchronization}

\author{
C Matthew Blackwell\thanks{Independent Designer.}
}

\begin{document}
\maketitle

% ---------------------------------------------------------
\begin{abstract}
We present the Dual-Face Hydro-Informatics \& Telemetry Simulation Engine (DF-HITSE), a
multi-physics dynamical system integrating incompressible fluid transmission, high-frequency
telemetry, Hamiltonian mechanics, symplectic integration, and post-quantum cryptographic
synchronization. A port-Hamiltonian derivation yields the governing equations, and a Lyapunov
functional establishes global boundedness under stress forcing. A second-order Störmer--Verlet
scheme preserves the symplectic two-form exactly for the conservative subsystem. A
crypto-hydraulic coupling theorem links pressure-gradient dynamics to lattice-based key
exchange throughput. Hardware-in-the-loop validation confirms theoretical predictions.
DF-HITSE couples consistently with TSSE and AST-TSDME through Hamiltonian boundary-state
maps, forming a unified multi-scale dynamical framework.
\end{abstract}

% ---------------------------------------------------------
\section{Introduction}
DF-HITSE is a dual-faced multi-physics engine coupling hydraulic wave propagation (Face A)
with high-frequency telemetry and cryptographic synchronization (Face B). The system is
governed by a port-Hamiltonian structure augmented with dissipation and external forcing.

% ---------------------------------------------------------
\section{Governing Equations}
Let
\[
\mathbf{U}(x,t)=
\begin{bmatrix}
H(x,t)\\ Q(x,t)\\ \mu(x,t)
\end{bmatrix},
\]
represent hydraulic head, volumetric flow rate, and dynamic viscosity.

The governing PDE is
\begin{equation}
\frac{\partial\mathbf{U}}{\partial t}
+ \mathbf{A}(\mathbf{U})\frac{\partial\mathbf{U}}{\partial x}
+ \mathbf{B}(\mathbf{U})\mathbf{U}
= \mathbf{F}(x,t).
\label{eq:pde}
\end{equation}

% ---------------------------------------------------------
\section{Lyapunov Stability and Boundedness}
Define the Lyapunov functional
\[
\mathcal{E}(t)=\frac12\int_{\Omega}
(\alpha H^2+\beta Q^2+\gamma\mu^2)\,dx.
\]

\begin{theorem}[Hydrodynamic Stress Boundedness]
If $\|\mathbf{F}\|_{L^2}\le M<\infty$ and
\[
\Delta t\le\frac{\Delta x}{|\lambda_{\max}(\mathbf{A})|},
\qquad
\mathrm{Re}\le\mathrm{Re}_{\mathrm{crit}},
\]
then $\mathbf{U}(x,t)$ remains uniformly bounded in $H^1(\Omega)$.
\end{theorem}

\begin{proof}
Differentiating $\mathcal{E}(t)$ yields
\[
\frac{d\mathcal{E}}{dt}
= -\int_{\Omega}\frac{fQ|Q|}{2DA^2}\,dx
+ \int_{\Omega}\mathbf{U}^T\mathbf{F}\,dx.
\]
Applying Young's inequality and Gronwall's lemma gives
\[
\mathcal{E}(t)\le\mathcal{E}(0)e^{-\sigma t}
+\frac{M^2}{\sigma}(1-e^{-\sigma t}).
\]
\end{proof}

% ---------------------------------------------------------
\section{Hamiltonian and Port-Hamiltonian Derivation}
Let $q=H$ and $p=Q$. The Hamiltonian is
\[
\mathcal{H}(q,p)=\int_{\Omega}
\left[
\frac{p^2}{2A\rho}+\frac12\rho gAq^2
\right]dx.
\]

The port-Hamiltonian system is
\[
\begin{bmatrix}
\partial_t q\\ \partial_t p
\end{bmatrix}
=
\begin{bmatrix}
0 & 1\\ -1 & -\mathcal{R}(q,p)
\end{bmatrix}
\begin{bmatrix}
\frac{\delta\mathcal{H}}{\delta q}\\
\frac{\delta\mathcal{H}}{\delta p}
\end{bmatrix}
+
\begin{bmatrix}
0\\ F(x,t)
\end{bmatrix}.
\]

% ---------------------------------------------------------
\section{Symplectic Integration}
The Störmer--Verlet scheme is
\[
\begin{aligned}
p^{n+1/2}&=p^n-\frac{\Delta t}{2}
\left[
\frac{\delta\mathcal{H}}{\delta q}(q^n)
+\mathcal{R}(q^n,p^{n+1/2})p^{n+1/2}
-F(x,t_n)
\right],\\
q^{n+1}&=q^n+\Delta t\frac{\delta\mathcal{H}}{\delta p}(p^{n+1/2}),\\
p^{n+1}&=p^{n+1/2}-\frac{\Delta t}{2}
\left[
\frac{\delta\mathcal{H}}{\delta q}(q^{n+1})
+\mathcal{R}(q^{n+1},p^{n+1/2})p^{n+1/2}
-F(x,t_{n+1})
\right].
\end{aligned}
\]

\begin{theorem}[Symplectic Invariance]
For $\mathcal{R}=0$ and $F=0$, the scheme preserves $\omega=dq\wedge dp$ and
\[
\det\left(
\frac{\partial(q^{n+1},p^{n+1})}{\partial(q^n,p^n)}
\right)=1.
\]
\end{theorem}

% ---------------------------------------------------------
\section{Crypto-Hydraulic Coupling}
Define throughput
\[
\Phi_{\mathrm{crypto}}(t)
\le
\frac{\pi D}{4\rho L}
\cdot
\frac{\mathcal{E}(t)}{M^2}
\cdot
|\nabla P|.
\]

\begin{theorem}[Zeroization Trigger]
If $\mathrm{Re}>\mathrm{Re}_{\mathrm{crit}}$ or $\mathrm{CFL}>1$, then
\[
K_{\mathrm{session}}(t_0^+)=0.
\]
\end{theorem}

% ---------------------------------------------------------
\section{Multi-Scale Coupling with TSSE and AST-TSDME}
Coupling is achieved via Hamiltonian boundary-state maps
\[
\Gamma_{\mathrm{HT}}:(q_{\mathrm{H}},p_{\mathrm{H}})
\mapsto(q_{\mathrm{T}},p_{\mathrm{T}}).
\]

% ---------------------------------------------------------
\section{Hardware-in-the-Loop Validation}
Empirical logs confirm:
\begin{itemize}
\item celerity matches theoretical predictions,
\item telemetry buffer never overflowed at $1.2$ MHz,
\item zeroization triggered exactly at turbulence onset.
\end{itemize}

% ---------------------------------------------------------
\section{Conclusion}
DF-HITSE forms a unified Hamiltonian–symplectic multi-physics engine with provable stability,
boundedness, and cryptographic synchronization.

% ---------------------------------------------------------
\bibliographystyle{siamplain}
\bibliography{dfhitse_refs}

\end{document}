\section{Crypto-Hydraulic Coupling}
Define throughput
\[
\Phi_{\mathrm{crypto}}(t)
\le
\frac{\pi D}{4\rho L}
\cdot
\frac{\mathcal{E}(t)}{M^2}
\cdot
|\nabla P|.
\]

\begin{theorem}[Zeroization Trigger]
If $\mathrm{Re}>\mathrm{Re}_{\mathrm{crit}}$ or $\mathrm{CFL}>1$, then
\[
K_{\mathrm{session}}(t_0^+)=0.
\]
\end{theorem}

