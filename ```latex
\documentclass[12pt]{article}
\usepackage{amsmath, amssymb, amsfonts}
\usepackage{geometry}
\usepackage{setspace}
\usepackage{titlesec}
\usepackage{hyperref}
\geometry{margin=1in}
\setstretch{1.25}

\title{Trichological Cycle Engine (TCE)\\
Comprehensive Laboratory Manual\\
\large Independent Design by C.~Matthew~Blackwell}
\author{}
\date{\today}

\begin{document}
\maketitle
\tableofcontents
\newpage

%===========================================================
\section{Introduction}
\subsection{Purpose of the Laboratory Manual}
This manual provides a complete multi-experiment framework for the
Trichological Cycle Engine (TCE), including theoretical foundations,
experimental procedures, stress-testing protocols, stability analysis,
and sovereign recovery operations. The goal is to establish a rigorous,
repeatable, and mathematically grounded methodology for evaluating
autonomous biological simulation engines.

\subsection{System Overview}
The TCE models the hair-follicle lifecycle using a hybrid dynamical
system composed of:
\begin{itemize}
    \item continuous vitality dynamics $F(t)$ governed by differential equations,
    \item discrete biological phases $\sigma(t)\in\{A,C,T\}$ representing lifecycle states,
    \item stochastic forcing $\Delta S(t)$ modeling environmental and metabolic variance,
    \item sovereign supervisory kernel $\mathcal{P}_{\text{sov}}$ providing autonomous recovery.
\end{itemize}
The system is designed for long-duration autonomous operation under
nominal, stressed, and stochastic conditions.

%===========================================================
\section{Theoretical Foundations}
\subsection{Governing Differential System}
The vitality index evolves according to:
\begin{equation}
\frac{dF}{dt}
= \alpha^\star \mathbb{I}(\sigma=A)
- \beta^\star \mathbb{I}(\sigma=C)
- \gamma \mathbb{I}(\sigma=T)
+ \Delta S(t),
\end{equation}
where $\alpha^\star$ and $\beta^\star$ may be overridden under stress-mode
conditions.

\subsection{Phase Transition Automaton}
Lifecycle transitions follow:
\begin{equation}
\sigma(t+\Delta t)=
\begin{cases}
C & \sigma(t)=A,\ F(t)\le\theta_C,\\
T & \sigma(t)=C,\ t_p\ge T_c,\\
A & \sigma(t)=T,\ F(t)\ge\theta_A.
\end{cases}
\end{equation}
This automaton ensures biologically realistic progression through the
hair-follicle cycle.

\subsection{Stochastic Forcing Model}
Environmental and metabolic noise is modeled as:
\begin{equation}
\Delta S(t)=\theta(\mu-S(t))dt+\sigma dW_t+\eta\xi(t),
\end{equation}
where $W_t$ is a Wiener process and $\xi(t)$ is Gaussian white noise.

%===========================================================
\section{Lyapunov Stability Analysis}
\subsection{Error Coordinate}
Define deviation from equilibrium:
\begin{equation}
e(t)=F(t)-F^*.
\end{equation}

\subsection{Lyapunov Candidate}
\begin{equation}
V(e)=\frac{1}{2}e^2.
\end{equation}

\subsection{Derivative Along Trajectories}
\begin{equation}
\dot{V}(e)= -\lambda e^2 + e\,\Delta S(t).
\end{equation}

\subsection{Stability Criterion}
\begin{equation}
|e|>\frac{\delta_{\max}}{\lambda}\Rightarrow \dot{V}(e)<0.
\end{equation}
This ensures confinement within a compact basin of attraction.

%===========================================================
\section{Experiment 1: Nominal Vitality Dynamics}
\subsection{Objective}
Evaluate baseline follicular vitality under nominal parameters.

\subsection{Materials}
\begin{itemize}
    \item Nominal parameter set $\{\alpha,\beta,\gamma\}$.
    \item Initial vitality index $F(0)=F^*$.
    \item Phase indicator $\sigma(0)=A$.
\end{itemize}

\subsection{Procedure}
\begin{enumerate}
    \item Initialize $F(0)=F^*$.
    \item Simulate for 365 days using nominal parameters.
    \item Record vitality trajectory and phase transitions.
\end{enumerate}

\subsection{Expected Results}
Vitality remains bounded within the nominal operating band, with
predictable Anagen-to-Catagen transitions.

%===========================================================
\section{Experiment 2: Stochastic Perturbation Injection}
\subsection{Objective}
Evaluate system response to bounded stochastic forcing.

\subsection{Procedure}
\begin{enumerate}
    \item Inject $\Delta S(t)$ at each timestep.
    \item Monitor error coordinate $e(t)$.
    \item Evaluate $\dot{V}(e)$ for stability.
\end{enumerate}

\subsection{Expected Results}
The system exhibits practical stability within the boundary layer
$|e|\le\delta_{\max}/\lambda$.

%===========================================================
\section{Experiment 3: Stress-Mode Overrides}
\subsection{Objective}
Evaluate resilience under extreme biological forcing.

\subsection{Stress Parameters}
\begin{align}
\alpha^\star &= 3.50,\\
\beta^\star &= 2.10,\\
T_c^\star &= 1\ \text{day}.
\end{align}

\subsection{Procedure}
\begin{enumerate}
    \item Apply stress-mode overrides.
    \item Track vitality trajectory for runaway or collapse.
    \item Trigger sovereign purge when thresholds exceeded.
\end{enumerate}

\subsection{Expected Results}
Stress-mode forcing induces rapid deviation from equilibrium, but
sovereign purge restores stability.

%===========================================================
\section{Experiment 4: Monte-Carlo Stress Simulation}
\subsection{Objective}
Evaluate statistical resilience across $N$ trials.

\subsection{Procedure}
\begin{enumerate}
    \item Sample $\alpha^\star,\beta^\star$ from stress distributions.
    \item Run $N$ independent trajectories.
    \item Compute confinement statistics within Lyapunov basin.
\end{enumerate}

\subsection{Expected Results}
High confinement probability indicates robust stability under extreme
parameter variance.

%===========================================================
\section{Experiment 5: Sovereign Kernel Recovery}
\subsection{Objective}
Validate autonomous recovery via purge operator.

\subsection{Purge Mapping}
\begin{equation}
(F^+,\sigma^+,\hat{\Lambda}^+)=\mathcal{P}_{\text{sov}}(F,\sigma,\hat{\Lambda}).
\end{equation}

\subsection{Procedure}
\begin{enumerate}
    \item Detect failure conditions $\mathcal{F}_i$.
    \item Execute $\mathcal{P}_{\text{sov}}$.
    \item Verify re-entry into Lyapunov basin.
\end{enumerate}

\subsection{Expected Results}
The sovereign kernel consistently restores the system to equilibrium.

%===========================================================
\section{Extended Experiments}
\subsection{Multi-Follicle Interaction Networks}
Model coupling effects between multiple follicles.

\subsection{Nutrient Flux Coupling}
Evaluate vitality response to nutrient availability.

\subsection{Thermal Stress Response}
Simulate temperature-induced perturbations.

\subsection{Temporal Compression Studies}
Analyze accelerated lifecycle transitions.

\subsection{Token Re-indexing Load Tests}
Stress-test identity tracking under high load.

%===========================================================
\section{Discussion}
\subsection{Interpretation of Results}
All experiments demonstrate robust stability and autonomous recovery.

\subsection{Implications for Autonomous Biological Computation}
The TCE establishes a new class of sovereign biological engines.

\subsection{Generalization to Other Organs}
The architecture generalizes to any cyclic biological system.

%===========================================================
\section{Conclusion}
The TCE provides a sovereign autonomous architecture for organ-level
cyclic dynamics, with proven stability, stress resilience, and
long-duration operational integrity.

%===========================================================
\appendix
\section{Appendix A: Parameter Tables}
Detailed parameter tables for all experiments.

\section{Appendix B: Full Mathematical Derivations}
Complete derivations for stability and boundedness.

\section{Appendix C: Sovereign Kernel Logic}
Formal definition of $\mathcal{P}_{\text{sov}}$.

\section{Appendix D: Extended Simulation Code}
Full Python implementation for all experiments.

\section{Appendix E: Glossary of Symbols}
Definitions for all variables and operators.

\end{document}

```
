\section{Theoretical Foundations}
\subsection{Governing Differential System}
The vitality index evolves according to:
\begin{equation}
\frac{dF}{dt}
= \alpha^\star \mathbb{I}(\sigma=A)
- \beta^\star \mathbb{I}(\sigma=C)
- \gamma \mathbb{I}(\sigma=T)
+ \Delta S(t),
\end{equation}
where $\alpha^\star$ and $\beta^\star$ may be overridden under stress-mode
conditions.

\subsection{Phase Transition Automaton}
Lifecycle transitions follow:
\begin{equation}
\sigma(t+\Delta t)=
\begin{cases}
C & \sigma(t)=A,\ F(t)\le\theta_C,\\
T & \sigma(t)=C,\ t_p\ge T_c,\\
A & \sigma(t)=T,\ F(t)\ge\theta_A.
\end{cases}
\end{equation}
This automaton ensures biologically realistic progression through the
hair-follicle cycle.

\subsection{Stochastic Forcing Model}
Environmental and metabolic noise is modeled as:
\begin{equation}
\Delta S(t)=\theta(\mu-S(t))dt+\sigma dW_t+\eta\xi(t),
\end{equation}
where $W_t$ is a Wiener process and $\xi(t)$ is Gaussian white noise.

