\section{Lyapunov Stability Analysis}
\subsection{Error Coordinate}
Define deviation from equilibrium:
\begin{equation}
e(t)=F(t)-F^*.
\end{equation}

\subsection{Lyapunov Candidate}
\begin{equation}
V(e)=\frac{1}{2}e^2.
\end{equation}

\subsection{Derivative Along Trajectories}
\begin{equation}
\dot{V}(e)= -\lambda e^2 + e\,\Delta S(t).
\end{equation}

\subsection{Stability Criterion}
\begin{equation}
|e|>\frac{\delta_{\max}}{\lambda}\Rightarrow \dot{V}(e)<0.
\end{equation}
This ensures confinement within a compact basin of attraction.

