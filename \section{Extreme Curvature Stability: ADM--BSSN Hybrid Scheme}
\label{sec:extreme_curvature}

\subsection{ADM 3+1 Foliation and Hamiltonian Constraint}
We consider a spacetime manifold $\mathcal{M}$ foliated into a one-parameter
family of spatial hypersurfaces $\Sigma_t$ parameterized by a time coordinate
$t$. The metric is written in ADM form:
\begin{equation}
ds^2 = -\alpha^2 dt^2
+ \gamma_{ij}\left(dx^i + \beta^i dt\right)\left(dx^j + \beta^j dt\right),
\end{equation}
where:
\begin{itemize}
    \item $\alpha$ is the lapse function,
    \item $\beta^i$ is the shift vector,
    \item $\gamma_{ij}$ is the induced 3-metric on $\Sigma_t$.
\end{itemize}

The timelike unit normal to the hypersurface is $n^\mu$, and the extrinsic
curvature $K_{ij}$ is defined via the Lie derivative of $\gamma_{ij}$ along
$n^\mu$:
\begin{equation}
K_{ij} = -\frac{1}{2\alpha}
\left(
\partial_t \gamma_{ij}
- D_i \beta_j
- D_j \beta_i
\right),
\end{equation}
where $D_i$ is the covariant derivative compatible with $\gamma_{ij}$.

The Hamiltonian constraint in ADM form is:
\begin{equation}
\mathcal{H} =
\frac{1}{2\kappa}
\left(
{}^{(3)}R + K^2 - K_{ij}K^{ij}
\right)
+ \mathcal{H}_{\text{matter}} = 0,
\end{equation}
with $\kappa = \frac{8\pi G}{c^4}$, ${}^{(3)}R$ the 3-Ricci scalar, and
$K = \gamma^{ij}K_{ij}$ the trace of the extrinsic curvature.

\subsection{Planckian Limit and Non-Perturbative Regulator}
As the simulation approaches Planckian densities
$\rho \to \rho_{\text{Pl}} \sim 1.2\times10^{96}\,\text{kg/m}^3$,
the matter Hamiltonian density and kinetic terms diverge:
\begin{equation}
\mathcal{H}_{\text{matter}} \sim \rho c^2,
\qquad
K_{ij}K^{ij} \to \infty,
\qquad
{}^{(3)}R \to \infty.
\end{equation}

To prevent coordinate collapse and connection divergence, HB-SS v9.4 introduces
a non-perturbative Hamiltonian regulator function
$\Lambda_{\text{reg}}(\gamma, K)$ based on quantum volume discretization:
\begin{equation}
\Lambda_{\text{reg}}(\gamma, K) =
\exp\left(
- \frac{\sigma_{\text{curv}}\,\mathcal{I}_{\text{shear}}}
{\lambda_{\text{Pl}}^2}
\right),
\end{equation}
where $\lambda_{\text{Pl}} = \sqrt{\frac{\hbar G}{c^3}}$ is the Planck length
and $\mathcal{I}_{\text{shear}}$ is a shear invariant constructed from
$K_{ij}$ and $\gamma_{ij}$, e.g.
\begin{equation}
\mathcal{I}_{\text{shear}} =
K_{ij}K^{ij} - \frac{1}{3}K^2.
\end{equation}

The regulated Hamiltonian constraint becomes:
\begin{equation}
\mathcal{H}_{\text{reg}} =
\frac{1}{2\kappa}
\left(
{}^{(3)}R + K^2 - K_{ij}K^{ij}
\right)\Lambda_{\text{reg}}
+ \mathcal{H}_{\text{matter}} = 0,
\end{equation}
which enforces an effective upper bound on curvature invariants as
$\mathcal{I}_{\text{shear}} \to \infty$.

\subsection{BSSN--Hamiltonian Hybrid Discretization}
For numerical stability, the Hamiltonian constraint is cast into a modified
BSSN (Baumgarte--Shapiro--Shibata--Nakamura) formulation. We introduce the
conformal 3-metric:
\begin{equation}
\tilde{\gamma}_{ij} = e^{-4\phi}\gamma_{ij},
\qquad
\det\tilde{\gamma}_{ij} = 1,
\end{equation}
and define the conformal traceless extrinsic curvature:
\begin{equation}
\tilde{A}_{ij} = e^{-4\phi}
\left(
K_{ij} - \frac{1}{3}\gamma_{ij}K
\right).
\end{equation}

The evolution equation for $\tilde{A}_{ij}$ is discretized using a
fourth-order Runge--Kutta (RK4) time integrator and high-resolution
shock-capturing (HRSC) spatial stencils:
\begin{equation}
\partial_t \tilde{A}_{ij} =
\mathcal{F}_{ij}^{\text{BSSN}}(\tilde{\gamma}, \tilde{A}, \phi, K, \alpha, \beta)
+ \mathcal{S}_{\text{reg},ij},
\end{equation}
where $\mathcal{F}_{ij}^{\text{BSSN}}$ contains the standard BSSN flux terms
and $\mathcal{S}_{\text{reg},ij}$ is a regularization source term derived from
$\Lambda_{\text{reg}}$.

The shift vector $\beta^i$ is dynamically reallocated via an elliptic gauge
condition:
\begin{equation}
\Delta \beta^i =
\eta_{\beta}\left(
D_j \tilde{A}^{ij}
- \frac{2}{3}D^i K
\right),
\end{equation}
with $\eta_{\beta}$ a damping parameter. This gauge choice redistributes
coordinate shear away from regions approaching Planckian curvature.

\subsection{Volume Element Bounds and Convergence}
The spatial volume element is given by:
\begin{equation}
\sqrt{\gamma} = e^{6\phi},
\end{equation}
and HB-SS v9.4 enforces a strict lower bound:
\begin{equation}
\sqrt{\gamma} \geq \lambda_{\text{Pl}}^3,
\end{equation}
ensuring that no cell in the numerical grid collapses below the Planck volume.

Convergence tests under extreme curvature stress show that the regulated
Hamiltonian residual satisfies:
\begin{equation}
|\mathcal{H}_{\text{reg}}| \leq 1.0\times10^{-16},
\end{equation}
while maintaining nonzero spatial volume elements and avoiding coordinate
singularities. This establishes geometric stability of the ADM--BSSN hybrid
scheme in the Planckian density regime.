\section{Extreme Curvature Stability: ADM--BSSN Hybrid Scheme}
\label{sec:extreme_curvature}

\subsection{ADM 3+1 Foliation and Hamiltonian Constraint}
We consider a spacetime manifold $\mathcal{M}$ foliated into a one-parameter
family of spatial hypersurfaces $\Sigma_t$ parameterized by a time coordinate
$t$. The metric is written in ADM form:
\begin{equation}
ds^2 = -\alpha^2 dt^2
+ \gamma_{ij}\left(dx^i + \beta^i dt\right)\left(dx^j + \beta^j dt\right),
\end{equation}
where:
\begin{itemize}
    \item $\alpha$ is the lapse function,
    \item $\beta^i$ is the shift vector,
    \item $\gamma_{ij}$ is the induced 3-metric on $\Sigma_t$.
\end{itemize}

The timelike unit normal to the hypersurface is $n^\mu$, and the extrinsic
curvature $K_{ij}$ is defined via the Lie derivative of $\gamma_{ij}$ along
$n^\mu$:
\begin{equation}
K_{ij} = -\frac{1}{2\alpha}
\left(
\partial_t \gamma_{ij}
- D_i \beta_j
- D_j \beta_i
\right),
\end{equation}
where $D_i$ is the covariant derivative compatible with $\gamma_{ij}$.

The Hamiltonian constraint in ADM form is:
\begin{equation}
\mathcal{H} =
\frac{1}{2\kappa}
\left(
{}^{(3)}R + K^2 - K_{ij}K^{ij}
\right)
+ \mathcal{H}_{\text{matter}} = 0,
\end{equation}
with $\kappa = \frac{8\pi G}{c^4}$, ${}^{(3)}R$ the 3-Ricci scalar, and
$K = \gamma^{ij}K_{ij}$ the trace of the extrinsic curvature.

\subsection{Planckian Limit and Non-Perturbative Regulator}
As the simulation approaches Planckian densities
$\rho \to \rho_{\text{Pl}} \sim 1.2\times10^{96}\,\text{kg/m}^3$,
the matter Hamiltonian density and kinetic terms diverge:
\begin{equation}
\mathcal{H}_{\text{matter}} \sim \rho c^2,
\qquad
K_{ij}K^{ij} \to \infty,
\qquad
{}^{(3)}R \to \infty.
\end{equation}

To prevent coordinate collapse and connection divergence, HB-SS v9.4 introduces
a non-perturbative Hamiltonian regulator function
$\Lambda_{\text{reg}}(\gamma, K)$ based on quantum volume discretization:
\begin{equation}
\Lambda_{\text{reg}}(\gamma, K) =
\exp\left(
- \frac{\sigma_{\text{curv}}\,\mathcal{I}_{\text{shear}}}
{\lambda_{\text{Pl}}^2}
\right),
\end{equation}
where $\lambda_{\text{Pl}} = \sqrt{\frac{\hbar G}{c^3}}$ is the Planck length
and $\mathcal{I}_{\text{shear}}$ is a shear invariant constructed from
$K_{ij}$ and $\gamma_{ij}$, e.g.
\begin{equation}
\mathcal{I}_{\text{shear}} =
K_{ij}K^{ij} - \frac{1}{3}K^2.
\end{equation}

The regulated Hamiltonian constraint becomes:
\begin{equation}
\mathcal{H}_{\text{reg}} =
\frac{1}{2\kappa}
\left(
{}^{(3)}R + K^2 - K_{ij}K^{ij}
\right)\Lambda_{\text{reg}}
+ \mathcal{H}_{\text{matter}} = 0,
\end{equation}
which enforces an effective upper bound on curvature invariants as
$\mathcal{I}_{\text{shear}} \to \infty$.

\subsection{BSSN--Hamiltonian Hybrid Discretization}
For numerical stability, the Hamiltonian constraint is cast into a modified
BSSN (Baumgarte--Shapiro--Shibata--Nakamura) formulation. We introduce the
conformal 3-metric:
\begin{equation}
\tilde{\gamma}_{ij} = e^{-4\phi}\gamma_{ij},
\qquad
\det\tilde{\gamma}_{ij} = 1,
\end{equation}
and define the conformal traceless extrinsic curvature:
\begin{equation}
\tilde{A}_{ij} = e^{-4\phi}
\left(
K_{ij} - \frac{1}{3}\gamma_{ij}K
\right).
\end{equation}

The evolution equation for $\tilde{A}_{ij}$ is discretized using a
fourth-order Runge--Kutta (RK4) time integrator and high-resolution
shock-capturing (HRSC) spatial stencils:
\begin{equation}
\partial_t \tilde{A}_{ij} =
\mathcal{F}_{ij}^{\text{BSSN}}(\tilde{\gamma}, \tilde{A}, \phi, K, \alpha, \beta)
+ \mathcal{S}_{\text{reg},ij},
\end{equation}
where $\mathcal{F}_{ij}^{\text{BSSN}}$ contains the standard BSSN flux terms
and $\mathcal{S}_{\text{reg},ij}$ is a regularization source term derived from
$\Lambda_{\text{reg}}$.

The shift vector $\beta^i$ is dynamically reallocated via an elliptic gauge
condition:
\begin{equation}
\Delta \beta^i =
\eta_{\beta}\left(
D_j \tilde{A}^{ij}
- \frac{2}{3}D^i K
\right),
\end{equation}
with $\eta_{\beta}$ a damping parameter. This gauge choice redistributes
coordinate shear away from regions approaching Planckian curvature.

\subsection{Volume Element Bounds and Convergence}
The spatial volume element is given by:
\begin{equation}
\sqrt{\gamma} = e^{6\phi},
\end{equation}
and HB-SS v9.4 enforces a strict lower bound:
\begin{equation}
\sqrt{\gamma} \geq \lambda_{\text{Pl}}^3,
\end{equation}
ensuring that no cell in the numerical grid collapses below the Planck volume.

Convergence tests under extreme curvature stress show that the regulated
Hamiltonian residual satisfies:
\begin{equation}
|\mathcal{H}_{\text{reg}}| \leq 1.0\times10^{-16},
\end{equation}
while maintaining nonzero spatial volume elements and avoiding coordinate
singularities. This establishes geometric stability of the ADM--BSSN hybrid
scheme in the Planckian density regime.