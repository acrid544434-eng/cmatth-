\section*{1. Test Configuration}

We define a time-resolved simulation of the First Atoms Engine (FAE) over a
finite window:
\begin{equation}
    t \in [0, T], \quad T = 10{,}000 \ \text{s}, \quad \Delta t = 1 \ \text{s}
\end{equation}

The simulation evolves the following state sets:
\begin{itemize}
    \item Environmental state: $\text{EnvState}(t)$
    \item Anchor state: $\text{AnchorState}(t)$
    \item Field state: $\text{FieldState}(t)$
    \item Entropy state: $\text{EntropyState}(t)$
    \item Drift state: $\text{DriftState}(t)$
\end{itemize}

\section*{2. Initial Conditions}

\subsection*{2.1 Environment}
\begin{equation}
    \mathcal{C}(0) = \mathcal{C}_{0}, \quad
    \mathcal{S}(0,\lambda) = \mathcal{S}_{0}(\lambda), \quad
    Z_{env} = Z_{0}
\end{equation}
We assume a high-activity astrophysical environment with rich spectral density
and heavy atomic composition.

\subsection*{2.2 Anchor}
\begin{equation}
    \mathbf{F}_{Pt/U}(0) = \mathbf{F}_{0}, \quad
    \mathbf{M}_{conf}(0) = \mathbf{M}_{0}, \quad
    \Psi_{core}(0) = \Psi_{0}
\end{equation}
The Pt/U fusion anchor is assumed to be stable but capable of producing
intermittent energy spikes.

\section*{3. Simulation Loop}

For each timestep $t_{n} = n \Delta t$, $n = 0, 1, \dots, N$:

\subsection*{3.1 Environment and Anchor Update}
Update:
\begin{equation}
    \text{EnvState}(t_{n}) \rightarrow \text{EnvState}(t_{n+1})
\end{equation}
\begin{equation}
    \text{AnchorState}(t_{n}) \rightarrow \text{AnchorState}(t_{n+1})
\end{equation}
according to prescribed evolution laws (e.g., external telemetry changes,
fusion dynamics).

\subsection*{3.2 Field Construction}
Compute:
\begin{equation}
    \Phi_{A,ext}(t_{n}, \mathbf{x}) = f\big(\mathcal{C}(t_{n}), \mathcal{S}(t_{n},\lambda), Z_{env}, \mathbf{x}\big)
\end{equation}
\begin{equation}
    \Phi_{A,int}(t_{n}, \mathbf{x}) = g\big(\mathbf{F}_{Pt/U}(t_{n}), \mathbf{M}_{conf}(t_{n}), \Psi_{core}(t_{n}), \mathbf{x}\big)
\end{equation}

\subsection*{3.3 Gradient Solver}
\begin{equation}
    \nabla \Phi_{A}(t_{n}, \mathbf{x}) = \Phi_{A,ext}(t_{n}, \mathbf{x}) - \Phi_{A,int}(t_{n}, \mathbf{x})
\end{equation}
Refine using supporting physics models (MHD, Coulomb modulation, atomic flux
coupling).

\subsection*{3.4 Entropy Reinforcement}
Detect fusion spikes:
\begin{equation}
    E_{spike}(t_{n}) = \mathcal{D}_{E}\big(\mathbf{F}_{Pt/U}(t_{n})\big)
\end{equation}
Compute entropy:
\begin{equation}
    S_{A}(t_{n}) = k_{S} \cdot E_{spike}(t_{n})
\end{equation}
Reinforce gradient:
\begin{equation}
    \nabla \Phi_{A}^{*}(t_{n}, \mathbf{x}) =
    \nabla \Phi_{A}(t_{n}, \mathbf{x}) \cdot \big(1 + \alpha_{S} S_{A}(t_{n})\big)
\end{equation}

\subsection*{3.5 Drift Evaluation}
Compute drift velocity:
\begin{equation}
    v_{eff}(t_{n}, \mathbf{x}) =
    k_{A} \cdot \left|\nabla \Phi_{A}^{*}(t_{n}, \mathbf{x})\right| \cdot S_{A}(t_{n})
\end{equation}
Apply relativistic constraint:
\begin{equation}
    v_{eff}(t_{n}, \mathbf{x}) < c
\end{equation}
Compute acceleration:
\begin{equation}
    a_{eff}(t_{n}, \mathbf{x}) =
    \frac{v_{eff}(t_{n}, \mathbf{x}) - v_{eff}(t_{n-1}, \mathbf{x})}{\Delta t}
\end{equation}

\subsection*{3.6 Logging}
Store:
\begin{equation}
    \big\{\Phi_{A,ext}, \Phi_{A,int}, \nabla \Phi_{A}, \nabla \Phi_{A}^{*},
    S_{A}, v_{eff}, a_{eff}\big\}_{t_{n}}
\end{equation}
for analysis and visualization.

\section*{4. Qualitative Outcome}

Under strong, coherent gradients and sustained entropy reinforcement, the
simulation is expected to show:
\begin{itemize}
    \item Initial low drift velocities (Bands I--II),
    \item Progressive increase in $|\nabla \Phi_{A}^{*}|$ and $S_{A}$,
    \item Climb of $v_{eff}(t)$ toward a relativistic fraction of $c$,
    \item Tapering acceleration as $v_{eff}$ approaches its relativistic ceiling.
\end{itemize}

\section*{5. Purpose}

This LaTeX simulation test defines a full time-stepped procedure for evaluating
the conceptual behavior of the First Atoms Engine. It does not claim physical
realizability, but provides a structured framework for numerical experiments on
atomic-gradient propulsion.

