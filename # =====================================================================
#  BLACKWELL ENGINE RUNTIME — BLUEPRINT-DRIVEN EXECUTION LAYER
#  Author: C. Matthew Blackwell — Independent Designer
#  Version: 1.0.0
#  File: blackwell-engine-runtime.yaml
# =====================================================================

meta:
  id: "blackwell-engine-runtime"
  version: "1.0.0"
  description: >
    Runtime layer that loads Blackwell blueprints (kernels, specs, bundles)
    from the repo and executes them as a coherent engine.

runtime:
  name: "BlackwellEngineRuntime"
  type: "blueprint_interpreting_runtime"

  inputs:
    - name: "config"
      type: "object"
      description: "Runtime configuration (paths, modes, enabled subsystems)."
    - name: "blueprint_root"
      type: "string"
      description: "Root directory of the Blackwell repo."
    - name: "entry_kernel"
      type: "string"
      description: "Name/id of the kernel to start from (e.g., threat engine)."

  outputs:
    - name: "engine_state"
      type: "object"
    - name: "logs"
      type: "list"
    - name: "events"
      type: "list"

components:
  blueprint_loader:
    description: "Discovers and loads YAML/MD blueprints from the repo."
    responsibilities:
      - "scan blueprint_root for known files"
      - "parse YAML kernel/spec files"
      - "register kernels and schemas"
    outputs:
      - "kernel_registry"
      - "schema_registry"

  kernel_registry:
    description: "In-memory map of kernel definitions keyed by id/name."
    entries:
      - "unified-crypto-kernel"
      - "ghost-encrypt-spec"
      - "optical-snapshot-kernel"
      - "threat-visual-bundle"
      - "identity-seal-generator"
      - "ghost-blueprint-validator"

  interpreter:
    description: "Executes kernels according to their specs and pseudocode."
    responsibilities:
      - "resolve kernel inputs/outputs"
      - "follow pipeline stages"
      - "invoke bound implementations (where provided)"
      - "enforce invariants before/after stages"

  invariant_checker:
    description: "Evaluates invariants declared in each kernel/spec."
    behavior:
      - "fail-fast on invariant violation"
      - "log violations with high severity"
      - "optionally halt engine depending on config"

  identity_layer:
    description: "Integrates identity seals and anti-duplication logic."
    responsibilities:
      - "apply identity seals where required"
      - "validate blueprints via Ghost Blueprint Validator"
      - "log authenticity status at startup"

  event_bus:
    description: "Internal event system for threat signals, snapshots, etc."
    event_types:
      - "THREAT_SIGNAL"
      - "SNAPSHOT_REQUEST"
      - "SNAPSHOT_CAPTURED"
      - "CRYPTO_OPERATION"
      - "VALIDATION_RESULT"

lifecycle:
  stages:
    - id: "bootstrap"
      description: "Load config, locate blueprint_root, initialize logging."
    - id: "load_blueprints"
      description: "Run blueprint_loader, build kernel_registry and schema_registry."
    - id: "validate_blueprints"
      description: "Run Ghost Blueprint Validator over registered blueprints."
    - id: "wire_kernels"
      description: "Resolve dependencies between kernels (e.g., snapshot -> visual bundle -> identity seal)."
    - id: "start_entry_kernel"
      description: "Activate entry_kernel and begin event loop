meta:
  id: "blackwell-engine-runtime"
  version: "1.0.0"
  description: >
    Runtime layer that loads Blackwell blueprints (kernels, specs, bundles)
    from the repo and executes them as a coherent engine.

runtime:
  name: "BlackwellEngineRuntime"
  type: "blueprint_interpreting_runtime"

  inputs:
    - name: "config"
      type: "object"
      description: "Runtime configuration (paths, modes, enabled subsystems)."
    - name: "blueprint_root"
      type: "string"
      description: "Root directory of the Blackwell repo."
    - name: "entry_kernel"
      type: "string"
      description: "Name/id of the kernel to start from (e.g., threat engine)."

  outputs:
    - name: "engine_state"
      type: "object"
    - name: "logs"
      type: "list"
    - name: "events"
      type: "list"

components:
  blueprint_loader:
    description: "Discovers and loads YAML/MD blueprints from the repo."
    responsibilities:
      - "scan blueprint_root for known files"
      - "parse YAML kernel/spec files"
      - "register kernels and schemas"
    outputs:
      - "kernel_registry"
      - "schema_registry"

  kernel_registry:
    description: "In-memory map of kernel definitions keyed by id/name."
    entries:
      - "unified-crypto-kernel"
      - "ghost-encrypt-spec"
      - "optical-snapshot-kernel"
      - "threat-visual-bundle"
      - "identity-seal-generator"
      - "ghost-blueprint-validator"

  interpreter:
    description: "Executes kernels according to their specs and pseudocode."
    responsibilities:
      - "resolve kernel inputs/outputs"
      - "follow pipeline stages"
      - "invoke bound implementations (where provided)"
      - "enforce invariants before/after stages"

  invariant_checker:
    description: "Evaluates invariants declared in each kernel/spec."
    behavior:
      - "fail-fast on invariant violation"
      - "log violations with high severity"
      - "optionally halt engine depending on config"

  identity_layer:
    description: "Integrates identity seals and anti-duplication logic."
    responsibilities:
      - "apply identity seals where required"
      - "validate blueprints via Ghost Blueprint Validator"
      - "log authenticity status at startup"

  event_bus:
    description: "Internal event system for threat signals, snapshots, etc."
    event_types:
      - "THREAT_SIGNAL"
      - "SNAPSHOT_REQUEST"
      - "SNAPSHOT_CAPTURED"
      - "CRYPTO_OPERATION"
      - "VALIDATION_RESULT"

lifecycle:
  stages:
    - id: "bootstrap"
      description: "Load config, locate blueprint_root, initialize logging."
    - id: "load_blueprints"
      description: "Run blueprint_loader, build kernel_registry and schema_registry."
    - id: "validate_blueprints"
      description: "Run Ghost Blueprint Validator over registered blueprints."
    - id: "wire_kernels"
      description: "Resolve dependencies between kernels (e.g., snapshot -> visual bundle -> identity seal)."
    - id: "start_entry_kernel"
      description: "Activate entry_kernel and begin event loop