\section*{Scientific White Sheet: Suprakernel Simulation}

\subsection*{1. Global Simulation State}

Let the suprakernel simulation state at iteration $n$ be
\[
\mathbf{X}_{\text{SIM}}^{(n)} =
\begin{bmatrix}
\mathbf{X}_{\text{flight}}^{(n)} \\
\mathbf{X}_{\text{struct}}^{(n)} \\
\mathbf{X}_{\text{thermal}}^{(n)} \\
\mathbf{X}_{\text{prop}}^{(n)} \\
\mathbf{X}_{\text{ctrl}}^{(n)}
\end{bmatrix}.
\]

The core simulation update operator:
\[
\mathbf{X}_{\text{SIM}}^{(n+1)} =
\mathcal{F}_{\text{SIM}}\big(\mathbf{X}_{\text{SIM}}^{(n)}, \Delta t\big).
\]

\subsection*{2. Perturbation-Damped Evolution}

Let $\delta \mathbf{X}_{\text{SIM}}^{(n)}$ be a perturbation at step $n$.
The damping operator $\mathcal{D}_{\text{pert}}$ enforces
\[
\delta \mathbf{X}'_{\text{SIM}}^{(n)} =
\mathcal{D}_{\text{pert}}\big(\delta \mathbf{X}_{\text{SIM}}^{(n)}\big),
\]
with
\[
\big\|\delta \mathbf{X}'_{\text{SIM}}^{(n)}\big\|
\leq
\kappa \big\|\delta \mathbf{X}_{\text{SIM}}^{(n)}\big\|,
\quad 0 < \kappa < 1.
\]

The effective update becomes
\[
\mathbf{X}_{\text{SIM}}^{(n+1)} =
\mathcal{F}_{\text{SIM}}\big(\mathbf{X}_{\text{SIM}}^{(n)}, \Delta t\big)
+
\delta \mathbf{X}'_{\text{SIM}}^{(n)}.
\]

\subsection*{3. Encrypted Simulation State}

Define the encrypted simulation state:
\[
\Lambda^{(n+1)} =
\mathcal{E}_{\text{SIM}}\big(\mathbf{X}_{\text{SIM}}^{(n+1)}, k_{\text{sec}}\big),
\]
where $\mathcal{E}_{\text{SIM}}$ is the encryption operator and
$k_{\text{sec}}$ is the secret key (or key vector).

\subsection*{4. Ledger-Bound Simulation History}

Each iteration produces a ledger entry
\[
\ell^{(n+1)} =
\mathcal{L}_{\text{SIM}}\big(\mathbf{X}_{\text{SIM}}^{(n+1)}, \Lambda^{(n+1)}\big),
\]
with hash chaining:
\[
H^{(n+1)} =
\text{Hash}\big(\ell^{(n+1)} \,\|\, H^{(n)}\big),
\quad
H^{(0)} = \text{Hash}\big(\ell^{(0)}\big).
\]

Ledger integrity condition:
\[
\mathcal{I}_{\text{ledger}}(\ell^{(n+1)}, H^{(n+1)}) = \text{true}.
\]

\subsection*{5. Constraint Envelope}

The encrypted simulation must satisfy
\[
\mathcal{C}_{\text{SIM}} :
\begin{cases}
\mathbf{X}_{\text{SIM}}^{(n+1)} \in \mathcal{C}_{\text{phys}}, \\
\Lambda^{(n+1)} = \mathcal{E}_{\text{SIM}}(\mathbf{X}_{\text{SIM}}^{(n+1)}, k_{\text{sec}}), \\
\mathcal{I}_{\text{ledger}}(\ell^{(n+1)}, H^{(n+1)}) = \text{true},
\end{cases}
\]
where $\mathcal{C}_{\text{phys}}$ encodes flight, structural, thermal,
propulsion, and control constraints.

