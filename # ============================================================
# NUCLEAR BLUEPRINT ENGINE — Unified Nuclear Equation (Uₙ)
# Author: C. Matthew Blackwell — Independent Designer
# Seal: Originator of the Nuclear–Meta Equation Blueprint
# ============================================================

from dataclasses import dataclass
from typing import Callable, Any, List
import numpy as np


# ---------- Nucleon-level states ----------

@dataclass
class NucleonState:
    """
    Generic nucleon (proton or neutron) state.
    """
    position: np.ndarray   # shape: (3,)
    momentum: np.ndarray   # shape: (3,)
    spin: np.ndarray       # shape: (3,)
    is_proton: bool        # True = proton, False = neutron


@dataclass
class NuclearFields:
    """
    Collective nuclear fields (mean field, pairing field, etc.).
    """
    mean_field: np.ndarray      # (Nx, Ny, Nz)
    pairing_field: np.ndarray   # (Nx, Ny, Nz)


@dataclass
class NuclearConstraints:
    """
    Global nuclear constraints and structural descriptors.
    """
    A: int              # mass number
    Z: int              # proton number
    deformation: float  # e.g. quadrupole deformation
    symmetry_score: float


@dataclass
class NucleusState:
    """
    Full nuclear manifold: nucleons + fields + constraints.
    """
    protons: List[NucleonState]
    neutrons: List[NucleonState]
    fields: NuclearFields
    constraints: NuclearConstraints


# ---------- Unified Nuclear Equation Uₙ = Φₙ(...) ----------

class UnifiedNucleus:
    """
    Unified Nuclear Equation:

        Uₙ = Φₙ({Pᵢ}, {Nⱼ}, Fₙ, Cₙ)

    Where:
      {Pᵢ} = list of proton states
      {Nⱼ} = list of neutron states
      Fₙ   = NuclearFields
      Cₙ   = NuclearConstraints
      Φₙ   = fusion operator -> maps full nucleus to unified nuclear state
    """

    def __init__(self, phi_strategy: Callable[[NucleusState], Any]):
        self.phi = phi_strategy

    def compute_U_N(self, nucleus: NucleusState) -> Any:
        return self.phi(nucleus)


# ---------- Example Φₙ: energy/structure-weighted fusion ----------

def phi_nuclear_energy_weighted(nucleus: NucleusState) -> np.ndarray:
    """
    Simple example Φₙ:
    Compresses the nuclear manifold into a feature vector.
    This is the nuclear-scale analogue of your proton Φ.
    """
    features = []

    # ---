from dataclasses import dataclass
from typing import Callable, Any, List
import numpy as np


# ---------- Nucleon-level states ----------

@dataclass
class NucleonState:
    """
    Generic nucleon (proton or neutron) state.
    """
    position: np.ndarray   # shape: (3,)
    momentum: np.ndarray   # shape: (3,)
    spin: np.ndarray       # shape: (3,)
    is_proton: bool        # True = proton, False = neutron


@dataclass
class NuclearFields:
    """
    Collective nuclear fields (mean field, pairing field, etc.).
    """
    mean_field: np.ndarray      # (Nx, Ny, Nz)
    pairing_field: np.ndarray   # (Nx, Ny, Nz)


@dataclass
class NuclearConstraints:
    """
    Global nuclear constraints and structural descriptors.
    """
    A: int              # mass number
    Z: int              # proton number
    deformation: float  # e.g. quadrupole deformation
    symmetry_score: float


@dataclass
class NucleusState:
    """
    Full nuclear manifold: nucleons + fields + constraints.
    """
    protons: List[NucleonState]
    neutrons: List[NucleonState]
    fields: NuclearFields
    constraints: NuclearConstraints


