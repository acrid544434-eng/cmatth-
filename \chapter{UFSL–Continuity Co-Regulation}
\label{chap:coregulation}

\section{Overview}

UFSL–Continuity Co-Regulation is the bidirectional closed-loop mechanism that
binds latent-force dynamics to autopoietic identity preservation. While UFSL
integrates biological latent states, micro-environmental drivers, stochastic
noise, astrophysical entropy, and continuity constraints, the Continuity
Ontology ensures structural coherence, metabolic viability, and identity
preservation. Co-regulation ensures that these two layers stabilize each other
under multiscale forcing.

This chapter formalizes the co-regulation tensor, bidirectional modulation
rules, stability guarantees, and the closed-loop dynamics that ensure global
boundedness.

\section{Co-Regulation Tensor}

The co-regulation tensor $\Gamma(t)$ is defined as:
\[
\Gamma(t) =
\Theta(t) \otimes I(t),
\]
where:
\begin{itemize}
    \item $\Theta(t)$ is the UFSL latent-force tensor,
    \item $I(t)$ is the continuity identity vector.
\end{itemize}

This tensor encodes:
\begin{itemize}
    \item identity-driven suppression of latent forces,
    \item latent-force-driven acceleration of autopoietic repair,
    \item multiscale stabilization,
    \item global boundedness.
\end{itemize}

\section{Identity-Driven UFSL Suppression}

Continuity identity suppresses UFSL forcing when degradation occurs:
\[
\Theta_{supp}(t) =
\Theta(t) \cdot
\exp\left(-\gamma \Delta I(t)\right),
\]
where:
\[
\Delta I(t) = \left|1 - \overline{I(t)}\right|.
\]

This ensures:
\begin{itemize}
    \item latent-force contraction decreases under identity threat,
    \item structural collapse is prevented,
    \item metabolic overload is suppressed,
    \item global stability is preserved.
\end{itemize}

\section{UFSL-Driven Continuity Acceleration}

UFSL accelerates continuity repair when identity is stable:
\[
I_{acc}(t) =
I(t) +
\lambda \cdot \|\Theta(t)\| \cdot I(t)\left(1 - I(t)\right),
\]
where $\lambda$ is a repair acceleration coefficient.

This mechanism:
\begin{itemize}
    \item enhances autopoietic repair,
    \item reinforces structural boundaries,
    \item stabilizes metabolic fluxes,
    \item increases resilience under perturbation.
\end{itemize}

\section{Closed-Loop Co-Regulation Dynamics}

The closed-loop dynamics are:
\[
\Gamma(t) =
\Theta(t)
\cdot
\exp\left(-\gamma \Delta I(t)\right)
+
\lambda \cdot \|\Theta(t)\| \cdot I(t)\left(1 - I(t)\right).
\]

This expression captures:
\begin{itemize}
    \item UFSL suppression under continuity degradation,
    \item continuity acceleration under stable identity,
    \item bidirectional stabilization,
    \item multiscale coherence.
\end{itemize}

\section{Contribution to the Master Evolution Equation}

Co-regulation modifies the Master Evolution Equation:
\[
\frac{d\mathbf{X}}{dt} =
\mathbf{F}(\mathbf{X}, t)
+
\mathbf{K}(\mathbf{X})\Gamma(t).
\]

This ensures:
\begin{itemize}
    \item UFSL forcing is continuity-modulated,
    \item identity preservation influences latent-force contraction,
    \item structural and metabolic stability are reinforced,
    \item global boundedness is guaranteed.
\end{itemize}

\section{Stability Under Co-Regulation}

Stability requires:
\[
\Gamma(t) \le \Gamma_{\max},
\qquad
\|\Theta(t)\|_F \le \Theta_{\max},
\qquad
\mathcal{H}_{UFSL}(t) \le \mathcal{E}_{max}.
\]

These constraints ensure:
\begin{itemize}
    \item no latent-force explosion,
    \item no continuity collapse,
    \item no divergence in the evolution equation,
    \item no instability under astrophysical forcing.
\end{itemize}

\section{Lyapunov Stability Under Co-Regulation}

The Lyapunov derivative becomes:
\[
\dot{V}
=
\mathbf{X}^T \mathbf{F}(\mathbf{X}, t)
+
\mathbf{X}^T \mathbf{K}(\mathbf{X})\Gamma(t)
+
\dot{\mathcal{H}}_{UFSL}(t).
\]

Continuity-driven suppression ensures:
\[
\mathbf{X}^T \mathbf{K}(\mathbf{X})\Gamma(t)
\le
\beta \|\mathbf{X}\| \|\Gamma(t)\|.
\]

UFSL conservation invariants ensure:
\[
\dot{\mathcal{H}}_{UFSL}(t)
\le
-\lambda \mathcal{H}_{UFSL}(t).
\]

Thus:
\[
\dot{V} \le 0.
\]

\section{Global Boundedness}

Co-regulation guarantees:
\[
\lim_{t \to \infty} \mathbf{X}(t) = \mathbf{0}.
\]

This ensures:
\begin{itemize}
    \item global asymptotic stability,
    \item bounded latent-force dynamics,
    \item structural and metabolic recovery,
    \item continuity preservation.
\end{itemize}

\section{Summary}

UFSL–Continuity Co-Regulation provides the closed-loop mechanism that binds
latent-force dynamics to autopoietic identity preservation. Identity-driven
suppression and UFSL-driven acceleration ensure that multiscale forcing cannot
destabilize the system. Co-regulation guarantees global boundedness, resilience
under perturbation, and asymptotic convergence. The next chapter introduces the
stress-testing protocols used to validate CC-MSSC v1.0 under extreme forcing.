    \item global boundedness is guaranteed.
\end{itemize}

\section{Stability Under Co-Regulation}

Stability requires:
\[
\Gamma(t) \le \Gamma_{\max},
\qquad
\|\Theta(t)\|_F \le \Theta_{\max},
\qquad
\mathcal{H}_{UFSL}(t) \le \mathcal{E}_{max}.
\]

These constraints ensure:
\begin{itemize}
    \item no latent-force explosion,
    \item no continuity collapse,
    \item no divergence in the evolution equation,
    \item no instability under astrophysical forcing.
\end{itemize}

\section{Lyapunov Stability Under Co-Regulation}

The Lyapunov derivative becomes:
\[
\dot{V}
=
\mathbf{X}^T \mathbf{F}(\mathbf{X}, t)
+
\mathbf{X}^T \mathbf{K}(\mathbf{X})\Gamma(t)
+
\dot{\mathcal{H}}_{UFSL}(t).
\]

Continuity-driven suppression ensures:
\[
\mathbf{X}^T \mathbf{K}(\mathbf{X})\Gamma(t)
\le
\beta \|\mathbf{X}\| \|\Gamma(t)\|.
\]

UFSL conservation invariants ensure:
\[
\dot{\mathcal{H}}_{UFSL}(t)
\le
-\lambda \mathcal{H}_{UFSL}(t).
\]

Thus:
\[
\dot{V} \le 0.
\]

\section{Global Boundedness}

Co-regulation guarantees:
\[
\lim_{t \to \infty} \mathbf{X}(t) = \mathbf{0}.
\]

This ensures:
\begin{itemize}
    \item global asymptotic stability,
    \item bounded latent-force dynamics,
    \item structural and metabolic recovery,
    \item continuity preservation.
\end{itemize}

