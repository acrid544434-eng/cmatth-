3.1 Law glyph

LawGlyph:
  id: Hash
  version: Int
  payload: EncodedLawExpression
  invariants:
    - InvariantRef
  anti_invariants:
    - InvariantRef
  scope:
    - "field"
    - "organism"
    - "timeline"
  meta_tags:
    - "warp"
    - "gravity"
    - "energy-density"
  signature: DesignerSignature

3.2 Capsule

Capsule:
  id: Hash
  type: ["ANCHOR", "EXPERIMENTAL", "DEPRECATED"]
  contents:
    laws: [LawGlyphRef]
    parameters: KeyValueMap
    notes: Text
  encryption:
    cipher_suite: String
    key_id: KeyID
    ciphertext: Bytes
  integrity_hash: Hash
  signature: DesignerSignature

3.3 Meta‑kernel state

MetaKernelState:
  active_lawset: [LawGlyphRef]
  candidate_pool: [LawGlyphRef]
