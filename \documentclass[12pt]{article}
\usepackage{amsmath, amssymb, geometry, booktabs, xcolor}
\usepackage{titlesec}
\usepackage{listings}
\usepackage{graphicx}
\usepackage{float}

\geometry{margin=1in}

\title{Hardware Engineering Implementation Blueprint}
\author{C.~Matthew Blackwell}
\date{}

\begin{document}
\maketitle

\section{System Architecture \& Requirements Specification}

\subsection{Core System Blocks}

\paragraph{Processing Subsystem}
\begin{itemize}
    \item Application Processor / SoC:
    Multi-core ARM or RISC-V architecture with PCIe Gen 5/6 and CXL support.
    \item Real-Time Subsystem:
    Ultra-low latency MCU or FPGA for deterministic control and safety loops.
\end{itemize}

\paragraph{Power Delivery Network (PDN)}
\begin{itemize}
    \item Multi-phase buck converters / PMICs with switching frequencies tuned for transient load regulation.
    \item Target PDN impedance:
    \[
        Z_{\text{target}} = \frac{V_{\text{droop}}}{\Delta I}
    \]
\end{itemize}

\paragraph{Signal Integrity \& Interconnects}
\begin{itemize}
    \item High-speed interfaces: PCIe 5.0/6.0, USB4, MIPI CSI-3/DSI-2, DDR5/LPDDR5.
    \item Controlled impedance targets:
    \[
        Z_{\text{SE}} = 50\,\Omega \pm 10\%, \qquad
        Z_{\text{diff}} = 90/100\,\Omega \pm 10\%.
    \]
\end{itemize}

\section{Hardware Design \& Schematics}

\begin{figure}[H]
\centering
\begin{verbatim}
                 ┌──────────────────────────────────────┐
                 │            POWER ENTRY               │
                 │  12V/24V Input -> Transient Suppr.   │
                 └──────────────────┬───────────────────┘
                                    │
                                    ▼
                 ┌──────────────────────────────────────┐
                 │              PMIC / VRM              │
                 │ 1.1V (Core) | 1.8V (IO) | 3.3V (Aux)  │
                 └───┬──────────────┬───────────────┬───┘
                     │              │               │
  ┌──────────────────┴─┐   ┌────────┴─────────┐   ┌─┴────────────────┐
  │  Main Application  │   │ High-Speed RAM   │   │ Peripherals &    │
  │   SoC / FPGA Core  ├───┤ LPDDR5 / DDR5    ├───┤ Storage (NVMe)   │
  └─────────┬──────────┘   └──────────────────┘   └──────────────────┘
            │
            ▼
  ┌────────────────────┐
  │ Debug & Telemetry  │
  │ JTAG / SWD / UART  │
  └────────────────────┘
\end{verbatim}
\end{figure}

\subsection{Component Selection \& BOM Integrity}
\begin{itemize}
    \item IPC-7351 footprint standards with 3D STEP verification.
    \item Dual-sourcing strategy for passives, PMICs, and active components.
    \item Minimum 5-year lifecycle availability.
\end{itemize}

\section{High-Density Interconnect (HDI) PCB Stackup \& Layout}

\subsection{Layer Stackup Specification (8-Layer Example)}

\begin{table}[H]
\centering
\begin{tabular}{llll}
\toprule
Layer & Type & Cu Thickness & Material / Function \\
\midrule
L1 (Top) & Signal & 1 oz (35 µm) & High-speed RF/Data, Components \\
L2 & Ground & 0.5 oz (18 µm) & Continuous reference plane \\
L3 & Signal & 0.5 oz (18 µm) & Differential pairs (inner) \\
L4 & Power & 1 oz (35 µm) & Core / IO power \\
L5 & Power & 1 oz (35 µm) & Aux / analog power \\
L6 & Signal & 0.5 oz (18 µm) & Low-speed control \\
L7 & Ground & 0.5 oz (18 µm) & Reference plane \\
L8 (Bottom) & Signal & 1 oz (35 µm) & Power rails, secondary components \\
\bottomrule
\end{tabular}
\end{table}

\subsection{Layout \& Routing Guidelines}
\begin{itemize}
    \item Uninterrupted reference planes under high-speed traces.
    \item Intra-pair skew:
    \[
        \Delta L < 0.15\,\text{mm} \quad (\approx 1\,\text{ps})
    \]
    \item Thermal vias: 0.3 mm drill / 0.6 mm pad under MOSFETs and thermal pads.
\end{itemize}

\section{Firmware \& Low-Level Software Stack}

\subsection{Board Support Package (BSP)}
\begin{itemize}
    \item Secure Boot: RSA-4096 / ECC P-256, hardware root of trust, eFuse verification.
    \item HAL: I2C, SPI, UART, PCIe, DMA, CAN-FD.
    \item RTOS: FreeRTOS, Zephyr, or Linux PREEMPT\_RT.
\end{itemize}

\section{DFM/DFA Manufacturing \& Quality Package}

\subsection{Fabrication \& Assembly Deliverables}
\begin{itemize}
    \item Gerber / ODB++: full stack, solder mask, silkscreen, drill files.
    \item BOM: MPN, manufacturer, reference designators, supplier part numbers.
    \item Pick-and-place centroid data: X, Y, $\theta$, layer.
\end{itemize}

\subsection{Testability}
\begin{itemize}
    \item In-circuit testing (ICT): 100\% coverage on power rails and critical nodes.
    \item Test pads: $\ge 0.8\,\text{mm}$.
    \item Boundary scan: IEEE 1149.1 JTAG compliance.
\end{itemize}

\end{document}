\subsection{Layout \& Routing Guidelines}
\begin{itemize}
    \item Uninterrupted reference planes under high-speed traces.
    \item Intra-pair skew:
    \[
        \Delta L < 0.15\,\text{mm} \quad (\approx 1\,\text{ps})
    \]
    \item Thermal vias: 0.3 mm drill / 0.6 mm pad under MOSFETs and thermal pads.
\end{itemize}

\section{Firmware \& Low-Level Software Stack}

\subsection{Board Support Package (BSP)}
\begin{itemize}
    \item Secure Boot: RSA-4096 / ECC P-256, hardware root of trust, eFuse verification.
    \item HAL: I2C, SPI, UART, PCIe, DMA, CAN-FD.
    \item RTOS: FreeRTOS, Zephyr, or Linux PREEMPT\_RT.
\end{itemize}

