\section{System Architecture \& Requirements Specification}

\subsection{Core System Blocks}

\paragraph{Processing Subsystem}
\begin{itemize}
    \item Application Processor / SoC:
    Multi-core ARM or RISC-V architecture with PCIe Gen 5/6 and CXL support.
    \item Real-Time Subsystem:
    Ultra-low latency MCU or FPGA for deterministic control and safety loops.
\end{itemize}

\paragraph{Power Delivery Network (PDN)}
\begin{itemize}
    \item Multi-phase buck converters / PMICs with switching frequencies tuned for transient load regulation.
    \item Target PDN impedance:
    \[
        Z_{\text{target}} = \frac{V_{\text{droop}}}{\Delta I}
    \]
\end{itemize}

\paragraph{Signal Integrity \& Interconnects}
\begin{itemize}
    \item High-speed interfaces: PCIe 5.0/6.0, USB4, MIPI CSI-3/DSI-2, DDR5/LPDDR5.
    \item Controlled impedance targets:
    \[
        Z_{\text{SE}} = 50\,\Omega \pm 10\%, \qquad
        Z_{\text{diff}} = 90/100\,\Omega \pm 10\%.
    \]
\end{itemize}

