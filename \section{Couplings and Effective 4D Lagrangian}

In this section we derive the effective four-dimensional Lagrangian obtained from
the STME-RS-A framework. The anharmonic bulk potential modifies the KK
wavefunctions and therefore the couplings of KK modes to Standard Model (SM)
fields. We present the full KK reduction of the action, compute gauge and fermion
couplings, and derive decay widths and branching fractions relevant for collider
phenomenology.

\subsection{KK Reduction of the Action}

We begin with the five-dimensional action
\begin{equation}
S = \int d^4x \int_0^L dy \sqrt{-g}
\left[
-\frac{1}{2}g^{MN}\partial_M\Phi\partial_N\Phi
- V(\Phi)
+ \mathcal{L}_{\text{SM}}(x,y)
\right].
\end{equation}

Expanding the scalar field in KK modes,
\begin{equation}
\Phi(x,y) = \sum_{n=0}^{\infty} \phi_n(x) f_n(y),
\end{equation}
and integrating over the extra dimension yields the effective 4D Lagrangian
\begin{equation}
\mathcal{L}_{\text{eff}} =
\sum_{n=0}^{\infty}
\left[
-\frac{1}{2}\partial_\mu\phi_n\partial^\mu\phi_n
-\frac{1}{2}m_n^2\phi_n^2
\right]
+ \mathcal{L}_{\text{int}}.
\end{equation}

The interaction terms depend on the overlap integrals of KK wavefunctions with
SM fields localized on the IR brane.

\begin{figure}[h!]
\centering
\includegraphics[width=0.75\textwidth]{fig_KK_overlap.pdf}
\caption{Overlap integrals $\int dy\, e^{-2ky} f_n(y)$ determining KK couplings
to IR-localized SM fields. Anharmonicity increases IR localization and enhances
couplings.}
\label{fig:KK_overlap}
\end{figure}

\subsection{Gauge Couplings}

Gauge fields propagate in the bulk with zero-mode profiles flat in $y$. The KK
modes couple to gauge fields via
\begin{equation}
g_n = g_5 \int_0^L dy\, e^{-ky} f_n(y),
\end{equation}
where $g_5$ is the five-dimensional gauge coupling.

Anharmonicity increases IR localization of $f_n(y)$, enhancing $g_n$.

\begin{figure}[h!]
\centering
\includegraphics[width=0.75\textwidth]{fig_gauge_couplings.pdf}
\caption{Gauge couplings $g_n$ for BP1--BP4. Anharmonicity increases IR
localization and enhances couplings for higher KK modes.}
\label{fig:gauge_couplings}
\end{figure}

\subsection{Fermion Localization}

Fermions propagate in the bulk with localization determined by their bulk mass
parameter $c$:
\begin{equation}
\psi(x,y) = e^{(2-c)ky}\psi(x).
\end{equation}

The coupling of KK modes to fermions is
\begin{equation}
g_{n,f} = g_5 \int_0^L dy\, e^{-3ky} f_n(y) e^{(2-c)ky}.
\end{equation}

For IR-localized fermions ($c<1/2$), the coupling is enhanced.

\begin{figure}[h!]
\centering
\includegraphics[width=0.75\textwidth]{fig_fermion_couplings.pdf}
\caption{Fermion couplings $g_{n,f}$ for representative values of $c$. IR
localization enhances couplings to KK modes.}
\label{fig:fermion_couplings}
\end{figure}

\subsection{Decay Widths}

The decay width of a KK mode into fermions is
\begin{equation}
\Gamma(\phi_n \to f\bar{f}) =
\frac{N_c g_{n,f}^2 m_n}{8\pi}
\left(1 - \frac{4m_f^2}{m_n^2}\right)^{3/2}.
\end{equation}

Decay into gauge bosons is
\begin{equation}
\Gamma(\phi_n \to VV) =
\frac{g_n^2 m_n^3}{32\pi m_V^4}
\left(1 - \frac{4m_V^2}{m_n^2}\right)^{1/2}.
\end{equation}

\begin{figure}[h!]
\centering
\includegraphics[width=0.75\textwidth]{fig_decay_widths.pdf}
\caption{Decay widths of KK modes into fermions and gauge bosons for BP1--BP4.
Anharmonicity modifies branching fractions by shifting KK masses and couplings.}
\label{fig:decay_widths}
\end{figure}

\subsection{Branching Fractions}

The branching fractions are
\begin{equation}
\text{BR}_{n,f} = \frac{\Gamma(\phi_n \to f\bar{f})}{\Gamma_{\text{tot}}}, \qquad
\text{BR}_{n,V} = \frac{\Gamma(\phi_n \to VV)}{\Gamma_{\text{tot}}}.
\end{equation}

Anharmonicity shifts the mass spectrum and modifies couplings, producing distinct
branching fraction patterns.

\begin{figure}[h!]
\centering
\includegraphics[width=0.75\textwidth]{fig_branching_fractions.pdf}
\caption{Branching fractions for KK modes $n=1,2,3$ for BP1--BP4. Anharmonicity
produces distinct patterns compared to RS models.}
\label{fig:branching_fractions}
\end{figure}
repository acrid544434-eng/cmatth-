\caption{Fermion couplings $g_{n,f}$ for representative values of $c$. IR
localization enhances couplings to KK modes.}
\label{fig:fermion_couplings}
\end{figure}

\subsection{Decay Widths}

The decay width of a KK mode into fermions is
\begin{equation}
\Gamma(\phi_n \to f\bar{f}) =
\frac{N_c g_{n,f}^2 m_n}{8\pi}
\left(1 - \frac{4m_f^2}{m_n^2}\right)^{3/2}.
\end{equation}

Decay into gauge bosons is
\begin{equation}
\Gamma(\phi_n \to VV) =
\frac{g_n^2 m_n^3}{32\pi m_V^4}
\left(1 - \frac{4m_V^2}{m_n^2}\right)^{1/2}.
\end{equation}

\begin{figure}[h!]
\centering
\includegraphics[width=0.75\textwidth]{fig_decay_widths.pdf}
\caption{Decay widths of KK modes into fermions and gauge bosons for BP1--BP4.
Anharmonicity modifies branching fractions by shifting KK masses and couplings.}
\label{fig:decay_widths}
\end{figure}

\subsection{Branching Fractions}

The branching fractions are
\begin{equation}
\text{BR}_{n,f} = \frac{\Gamma(\phi_n \to f\bar{f})}{\Gamma_{\text{tot}}}, \qquad
\text{BR}_{n,V} = \frac{\Gamma(\phi_n \to VV)}{\Gamma_{\text{tot}}}.
\end{equation}

Anharmonicity shifts the mass spectrum and modifies couplings, producing distinct
branching fraction patterns.

