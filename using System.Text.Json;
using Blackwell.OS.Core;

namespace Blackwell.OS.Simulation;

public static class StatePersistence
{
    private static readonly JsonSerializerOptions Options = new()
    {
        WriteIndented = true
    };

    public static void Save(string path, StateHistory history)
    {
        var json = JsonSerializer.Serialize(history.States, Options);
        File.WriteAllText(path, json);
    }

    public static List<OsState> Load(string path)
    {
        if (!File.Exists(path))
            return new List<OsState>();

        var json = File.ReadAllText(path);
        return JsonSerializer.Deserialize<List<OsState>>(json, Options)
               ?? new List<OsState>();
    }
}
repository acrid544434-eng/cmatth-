using System.Text.Json;
using Blackwell.OS.Core;

namespace Blackwell.OS.Simulation;

public static class StatePersistence
{
    private static readonly JsonSerializerOptions Options = new()
    {
        WriteIndented = true
    };

    public static void Save(string path, StateHistory history)
    {
        var json = JsonSerializer.Serialize(history.States, Options);
        File.WriteAllText(path, json);
    }

    public static List<OsState> Load(string path)
    {
        if (!File.Exists(path))
            return new List<OsState>();

        var json = File.ReadAllText(path);
        return JsonSerializer.Deserialize<List<OsState>>(json, Options)
               ?? new List<OsState>();
    }
}