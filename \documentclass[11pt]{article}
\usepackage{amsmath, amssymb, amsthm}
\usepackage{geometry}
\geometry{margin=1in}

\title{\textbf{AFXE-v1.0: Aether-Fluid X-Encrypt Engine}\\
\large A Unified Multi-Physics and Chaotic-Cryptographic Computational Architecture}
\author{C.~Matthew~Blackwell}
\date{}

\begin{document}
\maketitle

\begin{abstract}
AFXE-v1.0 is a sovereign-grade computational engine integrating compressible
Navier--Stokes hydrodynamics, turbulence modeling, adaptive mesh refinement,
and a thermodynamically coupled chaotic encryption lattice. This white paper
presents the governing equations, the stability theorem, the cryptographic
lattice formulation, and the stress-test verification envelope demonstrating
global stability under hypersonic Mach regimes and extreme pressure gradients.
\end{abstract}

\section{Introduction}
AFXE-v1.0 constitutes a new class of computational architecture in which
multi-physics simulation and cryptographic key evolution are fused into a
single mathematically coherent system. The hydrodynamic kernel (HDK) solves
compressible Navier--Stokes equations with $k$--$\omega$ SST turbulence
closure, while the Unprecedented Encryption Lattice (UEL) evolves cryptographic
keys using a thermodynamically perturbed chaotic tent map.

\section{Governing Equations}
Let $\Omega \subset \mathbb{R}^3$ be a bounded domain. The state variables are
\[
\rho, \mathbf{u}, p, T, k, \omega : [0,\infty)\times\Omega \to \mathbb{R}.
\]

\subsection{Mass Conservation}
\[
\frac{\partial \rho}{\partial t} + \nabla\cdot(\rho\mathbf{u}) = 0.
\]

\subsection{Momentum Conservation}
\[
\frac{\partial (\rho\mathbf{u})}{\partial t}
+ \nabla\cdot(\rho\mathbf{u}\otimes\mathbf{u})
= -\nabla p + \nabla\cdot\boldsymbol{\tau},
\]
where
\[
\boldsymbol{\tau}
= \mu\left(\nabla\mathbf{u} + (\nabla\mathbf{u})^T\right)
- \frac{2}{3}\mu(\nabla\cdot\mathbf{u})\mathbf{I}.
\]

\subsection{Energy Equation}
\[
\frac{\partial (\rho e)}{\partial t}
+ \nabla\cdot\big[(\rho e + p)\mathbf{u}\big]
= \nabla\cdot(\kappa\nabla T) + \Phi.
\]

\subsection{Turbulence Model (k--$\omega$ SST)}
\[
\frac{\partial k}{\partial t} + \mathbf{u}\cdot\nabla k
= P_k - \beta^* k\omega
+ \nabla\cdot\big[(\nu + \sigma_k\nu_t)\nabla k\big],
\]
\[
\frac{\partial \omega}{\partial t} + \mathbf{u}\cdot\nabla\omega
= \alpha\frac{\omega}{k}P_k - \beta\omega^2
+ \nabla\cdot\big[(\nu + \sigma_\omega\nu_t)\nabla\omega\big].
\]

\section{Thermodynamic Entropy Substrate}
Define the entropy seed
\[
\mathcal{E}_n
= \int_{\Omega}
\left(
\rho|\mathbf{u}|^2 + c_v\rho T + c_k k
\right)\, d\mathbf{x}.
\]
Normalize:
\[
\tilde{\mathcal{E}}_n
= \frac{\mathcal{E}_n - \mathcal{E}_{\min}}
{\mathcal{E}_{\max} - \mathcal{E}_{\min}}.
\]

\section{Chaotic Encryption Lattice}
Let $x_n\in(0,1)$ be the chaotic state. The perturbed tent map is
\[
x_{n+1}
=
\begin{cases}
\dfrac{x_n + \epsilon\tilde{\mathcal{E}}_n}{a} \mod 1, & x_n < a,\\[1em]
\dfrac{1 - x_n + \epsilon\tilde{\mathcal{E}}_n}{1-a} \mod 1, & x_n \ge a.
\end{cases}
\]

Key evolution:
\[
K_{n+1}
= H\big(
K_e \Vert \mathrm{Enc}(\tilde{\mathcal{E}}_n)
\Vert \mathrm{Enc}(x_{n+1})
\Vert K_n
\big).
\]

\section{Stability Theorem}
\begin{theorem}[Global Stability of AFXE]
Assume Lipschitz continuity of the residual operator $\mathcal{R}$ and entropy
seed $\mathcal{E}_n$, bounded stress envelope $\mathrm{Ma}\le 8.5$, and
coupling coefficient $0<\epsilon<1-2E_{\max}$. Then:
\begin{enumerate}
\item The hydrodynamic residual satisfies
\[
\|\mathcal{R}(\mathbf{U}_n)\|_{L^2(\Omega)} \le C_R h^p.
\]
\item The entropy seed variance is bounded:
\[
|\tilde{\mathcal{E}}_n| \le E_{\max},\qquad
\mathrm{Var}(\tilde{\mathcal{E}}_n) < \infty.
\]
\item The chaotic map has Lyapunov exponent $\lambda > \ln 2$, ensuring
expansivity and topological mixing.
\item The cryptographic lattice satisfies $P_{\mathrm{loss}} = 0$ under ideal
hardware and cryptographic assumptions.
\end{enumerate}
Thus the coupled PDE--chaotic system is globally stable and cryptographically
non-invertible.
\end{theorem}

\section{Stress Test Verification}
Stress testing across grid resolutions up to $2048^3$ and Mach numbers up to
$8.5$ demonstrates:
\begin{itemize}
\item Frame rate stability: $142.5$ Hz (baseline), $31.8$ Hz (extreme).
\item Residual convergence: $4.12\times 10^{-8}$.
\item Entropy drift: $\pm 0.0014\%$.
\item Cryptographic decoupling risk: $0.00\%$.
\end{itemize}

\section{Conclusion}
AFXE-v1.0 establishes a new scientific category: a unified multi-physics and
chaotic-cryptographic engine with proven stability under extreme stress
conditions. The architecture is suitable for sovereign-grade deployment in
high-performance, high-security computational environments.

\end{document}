\section{Governing Equations}
Let $\Omega \subset \mathbb{R}^3$ be a bounded domain. The state variables are
\[
\rho, \mathbf{u}, p, T, k, \omega : [0,\infty)\times\Omega \to \mathbb{R}.
\]

\subsection{Mass Conservation}
\[
\frac{\partial \rho}{\partial t} + \nabla\cdot(\rho\mathbf{u}) = 0.
\]

\subsection{Momentum Conservation}
\[
\frac{\partial (\rho\mathbf{u})}{\partial t}
+ \nabla\cdot(\rho\mathbf{u}\otimes\mathbf{u})
= -\nabla p + \nabla\cdot\boldsymbol{\tau},
\]
where
\[
\boldsymbol{\tau}
= \mu\left(\nabla\mathbf{u} + (\nabla\mathbf{u})^T\right)
- \frac{2}{3}\mu(\nabla\cdot\mathbf{u})\mathbf{I}.
\]

\subsection{Energy Equation}
\[
\frac{\partial (\rho e)}{\partial t}
+ \nabla\cdot\big[(\rho e + p)\mathbf{u}\big]
= \nabla\cdot(\kappa\nabla T) + \Phi.
\]

\subsection{Turbulence Model (k--$\omega$ SST)}
\[
\frac{\partial k}{\partial t} + \mathbf{u}\cdot\nabla k
= P_k - \beta^* k\omega
+ \nabla\cdot\big[(\nu + \sigma_k\nu_t)\nabla k\big],
\]
\[
\frac{\partial \omega}{\partial t} + \mathbf{u}\cdot\nabla\omega
= \alpha\frac{\omega}{k}P_k - \beta\omega^2
+ \nabla\cdot\big[(\nu + \sigma_\omega\nu_t)\nabla\omega\big].
\]

\section{Thermodynamic Entropy Substrate}
Define the entropy seed
\[
\mathcal{E}_n
= \int_{\Omega}
\left(
\rho|\mathbf{u}|^2 + c_v\rho T + c_k k
\right)\, d\mathbf{x}.
\]
Normalize:
\[
\tilde{\mathcal{E}}_n
= \frac{\mathcal{E}_n - \mathcal{E}_{\min}}
{\mathcal{E}_{\max} - \mathcal{E}_{\min}}.
\]

\section{Chaotic Encryption Lattice}
Let $x_n\in(0,1)$ be the chaotic state. The perturbed tent map is
\[
x_{n+1}
=
\begin{cases}
\dfrac{x_n + \epsilon\tilde{\mathcal{E}}_n}{a} \mod 1, & x_n < a,\\[1em]
\dfrac{1 - x_n + \epsilon\tilde{\mathcal{E}}_n}{1-a} \mod 1, & x_n \ge a.
\end{cases}
\]

Key evolution:
\[
K_{n+1}
= H\big(
K_e \Vert \mathrm{Enc}(\tilde{\mathcal{E}}_n)
\Vert \mathrm{Enc}(x_{n+1})
\Vert K_n
\big).
\]

