\begin{enumerate}
\item The hydrodynamic residual satisfies
\[
\|\mathcal{R}(\mathbf{U}_n)\|_{L^2(\Omega)} \le C_R h^p.
\]
\item The entropy seed variance is bounded:
\[
|\tilde{\mathcal{E}}_n| \le E_{\max},\qquad
\mathrm{Var}(\tilde{\mathcal{E}}_n) < \infty.
\]
\item The chaotic map has Lyapunov exponent $\lambda > \ln 2$, ensuring
expansivity and topological mixing.
\item The cryptographic lattice satisfies $P_{\mathrm{loss}} = 0$ under ideal
hardware and cryptographic assumptions.
\end{enumerate}
Thus the coupled PDE--chaotic system is globally stable and cryptographically
non-invertible.
\end{theorem}

