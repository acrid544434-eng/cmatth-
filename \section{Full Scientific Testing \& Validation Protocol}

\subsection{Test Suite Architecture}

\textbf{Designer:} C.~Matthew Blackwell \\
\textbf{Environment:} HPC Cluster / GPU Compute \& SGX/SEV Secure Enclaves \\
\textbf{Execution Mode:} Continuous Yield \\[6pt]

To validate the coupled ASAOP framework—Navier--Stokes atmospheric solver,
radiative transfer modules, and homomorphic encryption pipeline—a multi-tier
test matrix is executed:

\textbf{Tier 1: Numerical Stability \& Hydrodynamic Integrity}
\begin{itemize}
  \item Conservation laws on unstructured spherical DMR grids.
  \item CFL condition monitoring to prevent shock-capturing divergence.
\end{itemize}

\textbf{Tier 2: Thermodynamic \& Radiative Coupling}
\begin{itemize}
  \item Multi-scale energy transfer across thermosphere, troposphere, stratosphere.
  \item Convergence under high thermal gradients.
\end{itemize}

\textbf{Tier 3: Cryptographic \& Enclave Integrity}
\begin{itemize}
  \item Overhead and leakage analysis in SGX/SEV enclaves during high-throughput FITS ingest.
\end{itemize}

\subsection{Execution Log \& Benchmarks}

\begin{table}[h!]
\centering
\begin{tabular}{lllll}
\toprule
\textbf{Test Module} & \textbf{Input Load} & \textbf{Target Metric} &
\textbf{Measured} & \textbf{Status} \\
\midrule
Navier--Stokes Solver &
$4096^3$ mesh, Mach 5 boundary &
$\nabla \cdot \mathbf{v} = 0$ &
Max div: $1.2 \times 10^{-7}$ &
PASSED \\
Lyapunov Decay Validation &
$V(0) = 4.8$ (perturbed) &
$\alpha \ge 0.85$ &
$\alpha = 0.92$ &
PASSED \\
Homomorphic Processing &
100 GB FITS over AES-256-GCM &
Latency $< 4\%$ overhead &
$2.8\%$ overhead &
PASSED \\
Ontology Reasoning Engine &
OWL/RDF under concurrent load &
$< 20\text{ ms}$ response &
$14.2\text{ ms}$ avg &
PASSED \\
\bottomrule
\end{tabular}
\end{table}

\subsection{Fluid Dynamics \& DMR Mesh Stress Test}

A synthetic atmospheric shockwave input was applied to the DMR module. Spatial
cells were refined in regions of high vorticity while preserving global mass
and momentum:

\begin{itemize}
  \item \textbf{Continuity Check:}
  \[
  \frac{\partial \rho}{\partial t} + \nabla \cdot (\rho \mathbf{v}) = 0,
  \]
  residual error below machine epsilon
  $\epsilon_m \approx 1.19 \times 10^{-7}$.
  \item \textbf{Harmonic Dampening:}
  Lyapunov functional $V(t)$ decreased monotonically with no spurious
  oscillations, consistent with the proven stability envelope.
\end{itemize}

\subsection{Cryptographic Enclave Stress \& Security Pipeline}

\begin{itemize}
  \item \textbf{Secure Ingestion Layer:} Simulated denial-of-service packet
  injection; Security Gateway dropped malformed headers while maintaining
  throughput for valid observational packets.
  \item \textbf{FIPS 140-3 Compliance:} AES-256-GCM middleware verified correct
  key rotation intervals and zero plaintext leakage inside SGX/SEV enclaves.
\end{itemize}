\end{itemize}

\textbf{Tier 2: Thermodynamic \& Radiative Coupling}
\begin{itemize}
  \item Multi-scale energy transfer across thermosphere, troposphere, stratosphere.
  \item Convergence under high thermal gradients.
\end{itemize}

\textbf{Tier 3: Cryptographic \& Enclave Integrity}
\begin{itemize}
  \item Overhead and leakage analysis in SGX/SEV enclaves during high-throughput FITS ingest.
\end{itemize}

