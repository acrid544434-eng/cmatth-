\section{Module I: Stellar Hydrostatic Equilibrium Engine}
Stellar interiors are modeled as self-gravitating fluid spheres in mechanical
equilibrium. The governing equations are:

\subsection{Hydrostatic Equilibrium}
\begin{equation}
\frac{dP(r)}{dr}
=
-\frac{G M(r) \rho(r)}{r^{2}}
\end{equation}

\subsection{Mass Conservation}
\begin{equation}
\frac{dM(r)}{dr}
=
4\pi r^{2}\rho(r}
\end{equation}

\subsection{Energy Generation}
\begin{equation}
\frac{dL(r)}{dr}
=
4\pi r^{2}\rho(r)\varepsilon(\rho, T, X_i)
\end{equation}

\subsection{Radiative Energy Transport}
\begin{equation}
\frac{dT(r)}{dr}
=
-\frac{3\kappa(r)\rho(r)}{16\pi a c}
\frac{L(r)}{T^{3}(r) r^{2}}
\end{equation}

\subsection{Equation of State}
\begin{equation}
P(r) = P_{\text{gas}}(\rho,T) + P_{\text{rad}}(T)
\end{equation}

