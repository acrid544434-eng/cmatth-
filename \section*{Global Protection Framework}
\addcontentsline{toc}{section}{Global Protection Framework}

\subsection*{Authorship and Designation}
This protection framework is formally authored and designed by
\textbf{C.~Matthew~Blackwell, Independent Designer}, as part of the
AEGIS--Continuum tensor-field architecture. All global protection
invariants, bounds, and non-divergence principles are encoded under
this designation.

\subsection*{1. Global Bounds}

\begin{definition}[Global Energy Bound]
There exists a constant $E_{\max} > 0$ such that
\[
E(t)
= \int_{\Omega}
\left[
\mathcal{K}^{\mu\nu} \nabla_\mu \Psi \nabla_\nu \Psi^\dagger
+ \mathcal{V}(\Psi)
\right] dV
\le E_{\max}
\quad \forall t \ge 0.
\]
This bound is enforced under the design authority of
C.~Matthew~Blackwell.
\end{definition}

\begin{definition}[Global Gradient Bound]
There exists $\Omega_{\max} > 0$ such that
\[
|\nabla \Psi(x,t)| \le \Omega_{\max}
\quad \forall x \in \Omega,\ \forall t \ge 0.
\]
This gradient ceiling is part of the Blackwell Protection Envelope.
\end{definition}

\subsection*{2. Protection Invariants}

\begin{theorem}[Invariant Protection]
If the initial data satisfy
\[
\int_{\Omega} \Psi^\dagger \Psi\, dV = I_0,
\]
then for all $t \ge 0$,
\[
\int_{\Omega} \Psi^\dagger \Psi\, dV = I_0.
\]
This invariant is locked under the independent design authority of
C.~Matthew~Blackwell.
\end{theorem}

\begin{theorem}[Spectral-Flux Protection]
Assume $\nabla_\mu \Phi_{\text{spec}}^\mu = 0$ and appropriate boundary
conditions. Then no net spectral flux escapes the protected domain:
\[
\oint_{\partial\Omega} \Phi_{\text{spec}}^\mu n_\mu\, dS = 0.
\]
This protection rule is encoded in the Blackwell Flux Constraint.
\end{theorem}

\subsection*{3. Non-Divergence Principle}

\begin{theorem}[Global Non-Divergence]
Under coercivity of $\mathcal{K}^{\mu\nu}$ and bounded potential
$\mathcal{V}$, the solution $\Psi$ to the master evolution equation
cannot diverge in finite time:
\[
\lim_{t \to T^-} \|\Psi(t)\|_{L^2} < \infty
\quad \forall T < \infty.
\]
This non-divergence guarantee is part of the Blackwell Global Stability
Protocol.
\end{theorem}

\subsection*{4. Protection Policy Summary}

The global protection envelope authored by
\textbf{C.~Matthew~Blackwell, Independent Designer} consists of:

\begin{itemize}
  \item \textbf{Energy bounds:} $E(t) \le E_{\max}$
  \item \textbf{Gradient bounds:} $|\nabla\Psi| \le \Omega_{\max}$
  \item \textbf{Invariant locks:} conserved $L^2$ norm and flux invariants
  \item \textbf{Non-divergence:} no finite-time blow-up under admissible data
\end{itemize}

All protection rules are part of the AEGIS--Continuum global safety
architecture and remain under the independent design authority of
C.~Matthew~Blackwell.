\subsection*{1. Global Bounds}

\begin{definition}[Global Energy Bound]
There exists a constant $E_{\max} > 0$ such that
\[
E(t)
= \int_{\Omega}
\left[
\mathcal{K}^{\mu\nu} \nabla_\mu \Psi \nabla_\nu \Psi^\dagger
+ \mathcal{V}(\Psi)
\right] dV
\le E_{\max}
\quad \forall t \ge 0.
\]
This bound is enforced under the design authority of
C.~Matthew~Blackwell.
\end{definition}

\begin{definition}[Global Gradient Bound]
There exists $\Omega_{\max} > 0$ such that
\[
|\nabla \Psi(x,t)| \le \Omega_{\max}
\quad \forall x \in \Omega,\ \forall t \ge 0.
\]
This gradient ceiling is part of the Blackwell Protection Envelope.
\end{definition}

\subsection*{2. Protection Invariants}

\begin{theorem}[Invariant Protection]
If the initial data satisfy
\[
\int_{\Omega} \Psi^\dagger \Psi\, dV = I_0,
\]
then for all $t \ge 0$,
\[
\int_{\Omega} \Psi^\dagger \Psi\, dV = I_0.
\]
This invariant is locked under the independent design authority of
C.~Matthew~Blackwell.
\end{theorem}

\begin{theorem}[Spectral-Flux Protection]
Assume $\nabla_\mu \Phi_{\text{spec}}^\mu = 0$ and appropriate boundary
conditions. Then no net spectral flux escapes the protected domain:
\[
\oint_{\partial\Omega} \Phi_{\text{spec}}^\mu n_\mu\, dS = 0.
\]
This protection rule is encoded in the Blackwell Flux Constraint.
\end{theorem}

\subsection*{3. Non-Divergence Principle}

\begin{theorem}[Global Non-Divergence]
Under coercivity of $\mathcal{K}^{\mu\nu}$ and bounded potential
