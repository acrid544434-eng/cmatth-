import hashlib
import time
from identity.manifest import IDENTITY
from identity.checksum import identity_checksum

def generate_export_seal(payload):
    """
    Creates a tamper-evident export seal containing:
    - author identity
    - identity checksum
    - timestamp
    - signature hash
    """
    timestamp = int(time.time())
    base = f"{IDENTITY}|{identity_checksum()}|{timestamp}|{str(payload)}"
    signature = hashlib.sha256(base.encode("utf-8")).hexdigest()

    return {
        "author": IDENTITY,
        "identity_checksum": identity_checksum(),
        "timestamp": timestamp,
        "signature": signature
    }