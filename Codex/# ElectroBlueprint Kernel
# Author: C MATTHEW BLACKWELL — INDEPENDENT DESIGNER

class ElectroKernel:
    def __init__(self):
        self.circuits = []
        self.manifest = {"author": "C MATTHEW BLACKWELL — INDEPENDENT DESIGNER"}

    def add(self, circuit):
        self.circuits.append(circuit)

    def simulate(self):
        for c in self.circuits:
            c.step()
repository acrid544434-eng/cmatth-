class ElectroKernel:
    def __init__(self):
        self.circuits = []
        self.manifest = {"author": "C MATTHEW BLACKWELL — INDEPENDENT DESIGNER"}

    def add(self, circuit):
        self.circuits.append(circuit)

    def simulate(self):
        for c in self.circuits:
            c.step()