\chapter{Assembly Instructions}

\section{Assembly Flow}
\begin{enumerate}
    \item PCB fabrication (HDI, microvias, ENIG)
    \item SMT placement (0402 minimum)
    \item Reflow soldering (lead-free)
    \item Chassis machining (CNC)
    \item Thermal assembly bonding
    \item System integration
    \item Electrical validation
    \item Cryptographic provisioning
\end{enumerate}

