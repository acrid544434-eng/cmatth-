\begin{abstract}
This manufacturing specification defines all fabrication requirements, machining
tolerances, assembly workflows, and quality-control checkpoints required to
produce the near-term ENERGIZE hardware platform using 2026 commercial and
industrial technologies. All subsystems are manufacturable using existing
cryogenic, optical, semiconductor, and RF fabrication processes.
\end{abstract}

% ============================================================
\section{Manufacturing Overview}
% ============================================================

The ENERGIZE platform consists of:

\begin{itemize}
    \item NV-center atomic scanning optics,
    \item Sub-Kelvin SNSPD detection hardware,
    \item Astrophysical QKD ingestion modem,
    \item FPGA tensor acceleration core,
    \item UHV vacuum and mu-metal shielding.
\end{itemize}

All components are compatible with standard 2026 industrial fabrication.

% ============================================================
\section{Subsystem Manufacturing Requirements}
% ============================================================

\subsection{NV-Center Atomic State Scanner}

\textbf{Fabrication Requirements}
\begin{itemize}
    \item CVD diamond substrate, nitrogen concentration $<1\ \mathrm{ppm}$.
    \item NV implantation: $10\ \mathrm{keV}$ N$^+$ beam, $5\times10^{11}$ ions/cm$^2$.
    \item Vacuum anneal at $800^\circ$C for 2 hours.
    \item Waveguide machining tolerance: $50\ \mathrm{nm}$.
\end{itemize}

\textbf{Assembly Requirements}
\begin{itemize}
    \item Fiber alignment tolerance: $<0.5\ \mu\mathrm{m}$.
    \item SC/APC injection port, $0.2\ \mathrm{dB}$ insertion loss.
\end{itemize}

\textbf{Quality Control}
\begin{itemize}
    \item ODMR linewidth: $<1.2\ \mathrm{MHz}$.
    \item Spin coherence time: $>600\ \mu\mathrm{s}$.
\end{itemize}

% ------------------------------------------------------------
\subsection{Sub-Kelvin SNSPD Detection Stage}

\textbf{Fabrication Requirements}
\begin{itemize}
    \item NbTiN nanowire deposition: $8\ \mathrm{nm}$ thickness, $\pm0.2\ \mathrm{nm}$.
    \item Meander width: $70\ \mathrm{nm}$, $\pm3\ \mathrm{nm}$.
    \item Sapphire substrate with $300\ \mathrm{nm}$ SiO$_2$.
    \item OFHC copper cryogenic mount.
\end{itemize}

\textbf{Assembly Requirements}
\begin{itemize}
    \item $25\ \mu\mathrm{m}$ gold wirebonding.
    \item Cryo-RF coaxial routing via SMA connectors.
\end{itemize}

\textbf{Quality Control}
\begin{itemize}
    \item Timing jitter: $<12.4\ \mathrm{ps}$.
    \item Dark count rate: $<1.2\times10^{-3}\ \mathrm{Hz}$.
    \item SDE: $>98.4\%$.
\end{itemize}

% ------------------------------------------------------------
\subsection{Femtosecond Laser Array (438 THz)}

\textbf{Fabrication Requirements}
\begin{itemize}
    \item Ti:Sapphire crystal, $0.1\%$ doping.
    \item GDD mirror set: $<20\ \mathrm{fs}^2$.
    \item Pulse width: $<120\ \mathrm{fs}$.
\end{itemize}

\textbf{Assembly Requirements}
\begin{itemize}
    \item Zero-expansion optical bench, drift $<0.1\ \mu\mathrm{m}$.
    \item SC/APC fiber coupling, $<0.3\ \mathrm{dB}$ loss.
\end{itemize}

\textbf{Quality Control}
\begin{itemize}
    \item Beam pointing stability: $<0.5\ \mu\mathrm{rad}$.
    \item Pulse energy variance: $<0.2\%$.
\end{itemize}

% ------------------------------------------------------------
\subsection{FPGA Tensor Acceleration Core}

\textbf{Fabrication Requirements}
\begin{itemize}
    \item Xilinx UltraScale+ PCIe Gen5 x16.
    \item QSFP-DD optical cages.
    \item DDR5 ECC memory, $128\ \mathrm{GB}$.
\end{itemize}

\textbf{Assembly Requirements}
\begin{itemize}
    \item Vapor-chamber heatsink.
    \item $12\ \mathrm{V}$ rail at $30\ \mathrm{A}$.
\end{itemize}

\textbf{Quality Control}
\begin{itemize}
    \item Q-LDPC throughput: $\ge10.4\ \mathrm{Gbps}$.
    \item PCIe BER: $<10^{-15}$.
\end{itemize}

% ------------------------------------------------------------
\subsection{Mu-Metal Shielded UHV Chamber}

\textbf{Fabrication Requirements}
\begin{itemize}
    \item Dual-layer mu-metal, $1.5\ \mathrm{mm}$ sheets.
    \item Aluminum inner shell, 6061-T6, $5\ \mathrm{mm}$ thickness.
    \item Vacuum rating: $10^{-9}\ \mathrm{Torr}$.
\end{itemize}

\textbf{Assembly Requirements}
\begin{itemize}
    \item ISO-K flanges, ConFlat gaskets.
    \item Turbo pump: $300\ \mathrm{L/s}$.
\end{itemize}

\textbf{Quality Control}
\begin{itemize}
    \item Magnetic suppression: $<0.1\ \mathrm{nT}$.
    \item Leak rate: $<1\times10^{-10}\ \mathrm{Torr\cdot L/s}$.
\end{itemize}

% ============================================================
\section{Manufacturing Workflow}
% ============================================================

\subsection{Step 1: Optical \& Cryogenic Fabrication}
\begin{itemize}
    \item Machine NV-center substrates.
    \item Deposit NbTiN nanowires.
    \item Assemble cryogenic mounts.
    \item Validate ODMR and SNSPD metrics.
\end{itemize}

\subsection{Step 2: UHV Chamber Construction}
\begin{itemize}
    \item Weld aluminum shell.
    \item Install mu-metal shielding.
    \item Mount pneumatic dampening legs.
    \item Perform helium leak test.
\end{itemize}

\subsection{Step 3: Laser Bench Installation}
\begin{itemize}
    \item Mount femtosecond laser array.
    \item Align beam paths.
    \item Zero interferometric delay.
\end{itemize}

\subsection{Step 4: FPGA Core Installation}
\begin{itemize}
    \item Mount PCIe boards.
    \item Install QSFP-DD cages.
    \item Validate Q-LDPC throughput.
\end{itemize}

\subsection{Step 5: QKD Modem Integration}
\begin{itemize}
    \item Connect SDR receivers.
    \item Validate pulsar/CMB ingestion.
\end{itemize}

\subsection{Step 6: Full HITL Integration}
\begin{itemize}
    \item Connect all subsystems.
    \item Run atomic ingestion loop.
    \item Validate encrypted tensor output.
\end{itemize}

