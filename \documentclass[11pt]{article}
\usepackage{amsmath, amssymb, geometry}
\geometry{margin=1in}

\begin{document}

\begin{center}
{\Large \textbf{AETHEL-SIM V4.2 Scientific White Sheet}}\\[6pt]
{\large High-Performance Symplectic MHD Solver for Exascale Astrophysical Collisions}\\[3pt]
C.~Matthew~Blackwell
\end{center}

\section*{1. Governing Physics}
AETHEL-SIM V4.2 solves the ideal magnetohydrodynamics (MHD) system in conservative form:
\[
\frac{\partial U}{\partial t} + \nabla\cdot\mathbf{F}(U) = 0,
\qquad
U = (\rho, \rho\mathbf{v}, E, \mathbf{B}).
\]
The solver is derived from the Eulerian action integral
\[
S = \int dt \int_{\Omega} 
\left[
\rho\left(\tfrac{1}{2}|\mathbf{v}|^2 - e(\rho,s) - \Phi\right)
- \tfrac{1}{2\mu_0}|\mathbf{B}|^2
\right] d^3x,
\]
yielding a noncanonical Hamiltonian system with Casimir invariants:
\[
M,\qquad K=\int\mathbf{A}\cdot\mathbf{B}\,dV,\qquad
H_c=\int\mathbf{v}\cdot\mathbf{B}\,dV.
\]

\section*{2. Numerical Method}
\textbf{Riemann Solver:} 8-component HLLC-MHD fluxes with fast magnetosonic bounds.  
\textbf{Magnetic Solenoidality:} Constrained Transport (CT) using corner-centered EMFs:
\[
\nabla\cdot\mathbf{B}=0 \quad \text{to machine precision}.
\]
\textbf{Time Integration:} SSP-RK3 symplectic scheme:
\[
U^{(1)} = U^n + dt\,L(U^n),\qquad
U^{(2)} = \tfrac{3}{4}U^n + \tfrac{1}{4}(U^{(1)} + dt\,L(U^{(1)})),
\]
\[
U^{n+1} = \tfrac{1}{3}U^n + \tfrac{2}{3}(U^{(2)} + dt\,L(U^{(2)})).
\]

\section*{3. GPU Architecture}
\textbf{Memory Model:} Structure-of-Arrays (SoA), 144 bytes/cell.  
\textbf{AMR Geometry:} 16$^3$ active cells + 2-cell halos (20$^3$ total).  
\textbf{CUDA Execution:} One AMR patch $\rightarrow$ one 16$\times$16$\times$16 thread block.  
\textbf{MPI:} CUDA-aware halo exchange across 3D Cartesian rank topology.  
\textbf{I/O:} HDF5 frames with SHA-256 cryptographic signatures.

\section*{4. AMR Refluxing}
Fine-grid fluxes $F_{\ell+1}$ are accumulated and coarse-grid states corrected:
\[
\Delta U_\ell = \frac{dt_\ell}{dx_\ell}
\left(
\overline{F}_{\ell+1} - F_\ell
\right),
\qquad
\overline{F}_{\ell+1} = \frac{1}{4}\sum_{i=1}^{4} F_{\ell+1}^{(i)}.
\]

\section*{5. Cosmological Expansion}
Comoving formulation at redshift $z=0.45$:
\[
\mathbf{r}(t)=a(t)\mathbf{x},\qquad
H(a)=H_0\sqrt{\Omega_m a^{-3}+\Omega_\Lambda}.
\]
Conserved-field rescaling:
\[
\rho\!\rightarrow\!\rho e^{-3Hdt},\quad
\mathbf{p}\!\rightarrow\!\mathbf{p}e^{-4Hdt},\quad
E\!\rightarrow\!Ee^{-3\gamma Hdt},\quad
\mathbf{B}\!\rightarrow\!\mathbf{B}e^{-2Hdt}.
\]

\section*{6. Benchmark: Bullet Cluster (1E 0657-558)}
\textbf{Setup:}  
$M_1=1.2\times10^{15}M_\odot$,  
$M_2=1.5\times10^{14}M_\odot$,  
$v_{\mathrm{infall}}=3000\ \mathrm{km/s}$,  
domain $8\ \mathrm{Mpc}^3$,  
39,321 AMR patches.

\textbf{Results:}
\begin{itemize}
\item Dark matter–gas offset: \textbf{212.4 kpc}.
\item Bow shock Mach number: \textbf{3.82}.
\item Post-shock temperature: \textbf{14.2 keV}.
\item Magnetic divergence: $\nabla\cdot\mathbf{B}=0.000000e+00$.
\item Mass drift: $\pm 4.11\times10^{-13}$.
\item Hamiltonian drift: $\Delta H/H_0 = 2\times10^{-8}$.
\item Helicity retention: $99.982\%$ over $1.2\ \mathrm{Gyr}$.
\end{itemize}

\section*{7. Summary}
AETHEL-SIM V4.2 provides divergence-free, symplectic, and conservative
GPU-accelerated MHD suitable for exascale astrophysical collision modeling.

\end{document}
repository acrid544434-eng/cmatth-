\section*{1. Governing Physics}
AETHEL-SIM V4.2 solves the ideal magnetohydrodynamics (MHD) system in conservative form:
\[
\frac{\partial U}{\partial t} + \nabla\cdot\mathbf{F}(U) = 0,
\qquad
U = (\rho, \rho\mathbf{v}, E, \mathbf{B}).
\]
The solver is derived from the Eulerian action integral
\[
S = \int dt \int_{\Omega} 
\left[
\rho\left(\tfrac{1}{2}|\mathbf{v}|^2 - e(\rho,s) - \Phi\right)
- \tfrac{1}{2\mu_0}|\mathbf{B}|^2
\right] d^3x,
\]
yielding a noncanonical Hamiltonian system with Casimir invariants:
\[
M,\qquad K=\int\mathbf{A}\cdot\mathbf{B}\,dV,\qquad
H_c=\int\mathbf{v}\cdot\mathbf{B}\,dV.
\]

\section*{2. Numerical Method}
\textbf{Riemann Solver:} 8-component HLLC-MHD fluxes with fast magnetosonic bounds.  
\textbf{Magnetic Solenoidality:} Constrained Transport (CT) using corner-centered EMFs:
\[
\nabla\cdot\mathbf{B}=0 \quad \text{to machine precision}.
\]
\textbf{Time Integration:} SSP-RK3 symplectic scheme:
\[
U^{(1)} = U^n + dt\,L(U^n),\qquad
U^{(2)} = \tfrac{3}{4}U^n + \tfrac{1}{4}(U^{(1)} + dt\,L(U^{(1)})),
\]
\[
U^{n+1} = \tfrac{1}{3}U^n + \tfrac{2}{3}(U^{(2)} + dt\,L(U^{(2)})).
\]

\section*{3. GPU Architecture}
\textbf{Memory Model:} Structure-of-Arrays (SoA), 144 bytes/cell.  
\textbf{AMR Geometry:} 16$^3$ active cells + 2-cell halos (20$^3$ total).  
\textbf{CUDA Execution:} One AMR patch $\rightarrow$ one 16$\times$16$\times$16 thread block.  
\textbf{MPI:} CUDA-aware halo exchange across 3D Cartesian rank topology.  
\textbf{I/O:} HDF5 frames with SHA-256 cryptographic signatures.

\section*{4. AMR Refluxing}
Fine-grid fluxes $F_{\ell+1}$ are accumulated and coarse-grid states corrected:
\[
\Delta U_\ell = \frac{dt_\ell}{dx_\ell}
\left(
\overline{F}_{\ell+1} - F_\ell
\right),
\qquad
\overline{F}_{\ell+1} = \frac{1}{4}\sum_{i=1}^{4} F_{\ell+1}^{(i)}.
\]

\section*{5. Cosmological Expansion}
Comoving formulation at redshift $z=0.45$:
\[
\mathbf{r}(t)=a(t)\mathbf{x},\qquad
H(a)=H_0\sqrt{\Omega_m a^{-3}+\Omega_\Lambda}.
\]
Conserved-field rescaling:
\[
\rho\!\rightarrow\!\rho e^{-3Hdt},\quad
\mathbf{p}\!\rightarrow\!\mathbf{p}e^{-4Hdt},\quad
E\!\rightarrow\!Ee^{-3\gamma Hdt},\quad
\mathbf{B}\!\rightarrow\!\mathbf{B}e^{-2Hdt}.
\]

