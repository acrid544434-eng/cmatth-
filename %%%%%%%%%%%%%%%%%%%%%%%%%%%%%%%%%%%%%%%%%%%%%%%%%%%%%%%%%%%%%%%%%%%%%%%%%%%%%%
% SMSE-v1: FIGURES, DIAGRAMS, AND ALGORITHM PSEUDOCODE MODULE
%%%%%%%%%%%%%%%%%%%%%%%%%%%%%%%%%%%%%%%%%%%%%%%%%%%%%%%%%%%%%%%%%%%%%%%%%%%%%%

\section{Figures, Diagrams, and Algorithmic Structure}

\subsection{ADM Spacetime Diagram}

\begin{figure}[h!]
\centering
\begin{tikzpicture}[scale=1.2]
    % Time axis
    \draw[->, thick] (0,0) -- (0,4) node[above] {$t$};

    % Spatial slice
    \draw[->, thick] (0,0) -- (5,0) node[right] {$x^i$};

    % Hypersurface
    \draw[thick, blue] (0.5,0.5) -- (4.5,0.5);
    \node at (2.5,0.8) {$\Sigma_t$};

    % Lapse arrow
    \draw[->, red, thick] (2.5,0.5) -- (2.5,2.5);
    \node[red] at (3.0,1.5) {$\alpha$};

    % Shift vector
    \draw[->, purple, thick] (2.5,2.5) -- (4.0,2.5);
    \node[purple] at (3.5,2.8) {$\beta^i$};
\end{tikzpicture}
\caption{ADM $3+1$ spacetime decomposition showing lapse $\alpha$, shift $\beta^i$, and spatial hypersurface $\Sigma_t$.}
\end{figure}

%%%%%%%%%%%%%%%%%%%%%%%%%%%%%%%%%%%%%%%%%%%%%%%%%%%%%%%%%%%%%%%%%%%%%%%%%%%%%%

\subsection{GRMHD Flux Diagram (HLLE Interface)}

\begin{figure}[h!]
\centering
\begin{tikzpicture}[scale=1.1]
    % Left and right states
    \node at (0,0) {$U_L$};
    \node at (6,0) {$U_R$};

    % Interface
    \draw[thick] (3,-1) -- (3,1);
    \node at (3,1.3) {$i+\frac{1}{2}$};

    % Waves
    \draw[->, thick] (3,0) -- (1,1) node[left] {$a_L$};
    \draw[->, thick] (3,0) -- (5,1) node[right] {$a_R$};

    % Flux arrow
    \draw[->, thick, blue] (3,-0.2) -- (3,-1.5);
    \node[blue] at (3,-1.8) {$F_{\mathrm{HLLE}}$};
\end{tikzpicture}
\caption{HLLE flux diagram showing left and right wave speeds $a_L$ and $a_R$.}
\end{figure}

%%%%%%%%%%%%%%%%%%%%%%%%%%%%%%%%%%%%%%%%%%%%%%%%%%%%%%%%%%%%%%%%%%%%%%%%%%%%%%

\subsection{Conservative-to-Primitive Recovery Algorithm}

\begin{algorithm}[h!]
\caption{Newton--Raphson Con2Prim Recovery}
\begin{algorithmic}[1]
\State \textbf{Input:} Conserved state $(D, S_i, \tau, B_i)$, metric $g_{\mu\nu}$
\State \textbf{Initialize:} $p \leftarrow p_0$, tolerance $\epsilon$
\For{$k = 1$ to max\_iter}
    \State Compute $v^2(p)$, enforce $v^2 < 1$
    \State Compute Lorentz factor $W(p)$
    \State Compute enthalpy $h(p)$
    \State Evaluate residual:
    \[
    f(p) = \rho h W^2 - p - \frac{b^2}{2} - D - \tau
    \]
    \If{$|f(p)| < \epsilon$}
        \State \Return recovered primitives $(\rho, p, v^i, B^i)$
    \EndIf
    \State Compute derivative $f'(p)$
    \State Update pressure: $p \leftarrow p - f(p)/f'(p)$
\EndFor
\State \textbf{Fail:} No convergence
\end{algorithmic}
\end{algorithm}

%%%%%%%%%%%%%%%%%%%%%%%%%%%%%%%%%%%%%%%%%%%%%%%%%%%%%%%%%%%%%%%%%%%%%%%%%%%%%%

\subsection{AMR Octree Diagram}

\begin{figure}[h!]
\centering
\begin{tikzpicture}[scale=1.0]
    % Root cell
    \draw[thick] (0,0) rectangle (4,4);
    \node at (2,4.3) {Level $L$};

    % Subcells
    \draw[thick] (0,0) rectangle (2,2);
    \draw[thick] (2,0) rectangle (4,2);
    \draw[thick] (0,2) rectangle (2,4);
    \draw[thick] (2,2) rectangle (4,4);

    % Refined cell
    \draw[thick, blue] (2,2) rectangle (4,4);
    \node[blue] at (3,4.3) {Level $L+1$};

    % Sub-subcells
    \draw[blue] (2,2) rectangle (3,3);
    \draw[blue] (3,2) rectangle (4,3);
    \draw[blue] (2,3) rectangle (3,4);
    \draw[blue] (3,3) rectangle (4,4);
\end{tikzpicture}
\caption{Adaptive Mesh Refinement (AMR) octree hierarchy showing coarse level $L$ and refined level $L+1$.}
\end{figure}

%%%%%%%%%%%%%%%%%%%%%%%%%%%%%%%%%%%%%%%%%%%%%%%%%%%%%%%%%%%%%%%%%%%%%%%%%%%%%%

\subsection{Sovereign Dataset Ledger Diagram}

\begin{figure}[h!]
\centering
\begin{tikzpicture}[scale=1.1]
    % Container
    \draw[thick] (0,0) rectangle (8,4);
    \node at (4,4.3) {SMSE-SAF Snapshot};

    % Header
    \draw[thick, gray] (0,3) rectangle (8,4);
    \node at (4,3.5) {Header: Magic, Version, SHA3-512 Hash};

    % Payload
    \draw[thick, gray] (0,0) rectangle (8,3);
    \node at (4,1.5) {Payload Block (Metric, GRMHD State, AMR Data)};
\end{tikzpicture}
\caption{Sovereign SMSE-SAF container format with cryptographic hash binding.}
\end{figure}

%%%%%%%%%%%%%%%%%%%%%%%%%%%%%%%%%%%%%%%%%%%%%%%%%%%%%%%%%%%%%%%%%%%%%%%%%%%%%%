\subsection{Conservative-to-Primitive Recovery Algorithm}

\begin{algorithm}[h!]
\caption{Newton--Raphson Con2Prim Recovery}
\begin{algorithmic}[1]
\State \textbf{Input:} Conserved state $(D, S_i, \tau, B_i)$, metric $g_{\mu\nu}$
\State \textbf{Initialize:} $p \leftarrow p_0$, tolerance $\epsilon$
\For{$k = 1$ to max\_iter}
    \State Compute $v^2(p)$, enforce $v^2 < 1$
    \State Compute Lorentz factor $W(p)$
    \State Compute enthalpy $h(p)$
    \State Evaluate residual:
    \[
    f(p) = \rho h W^2 - p - \frac{b^2}{2} - D - \tau
    \]
    \If{$|f(p)| < \epsilon$}
        \State \Return recovered primitives $(\rho, p, v^i, B^i)$
    \EndIf
    \State Compute derivative $f'(p)$
    \State Update pressure: $p \leftarrow p - f(p)/f'(p)$
\EndFor
\State \textbf{Fail:} No convergence
\end{algorithmic}
\end{algorithm}

