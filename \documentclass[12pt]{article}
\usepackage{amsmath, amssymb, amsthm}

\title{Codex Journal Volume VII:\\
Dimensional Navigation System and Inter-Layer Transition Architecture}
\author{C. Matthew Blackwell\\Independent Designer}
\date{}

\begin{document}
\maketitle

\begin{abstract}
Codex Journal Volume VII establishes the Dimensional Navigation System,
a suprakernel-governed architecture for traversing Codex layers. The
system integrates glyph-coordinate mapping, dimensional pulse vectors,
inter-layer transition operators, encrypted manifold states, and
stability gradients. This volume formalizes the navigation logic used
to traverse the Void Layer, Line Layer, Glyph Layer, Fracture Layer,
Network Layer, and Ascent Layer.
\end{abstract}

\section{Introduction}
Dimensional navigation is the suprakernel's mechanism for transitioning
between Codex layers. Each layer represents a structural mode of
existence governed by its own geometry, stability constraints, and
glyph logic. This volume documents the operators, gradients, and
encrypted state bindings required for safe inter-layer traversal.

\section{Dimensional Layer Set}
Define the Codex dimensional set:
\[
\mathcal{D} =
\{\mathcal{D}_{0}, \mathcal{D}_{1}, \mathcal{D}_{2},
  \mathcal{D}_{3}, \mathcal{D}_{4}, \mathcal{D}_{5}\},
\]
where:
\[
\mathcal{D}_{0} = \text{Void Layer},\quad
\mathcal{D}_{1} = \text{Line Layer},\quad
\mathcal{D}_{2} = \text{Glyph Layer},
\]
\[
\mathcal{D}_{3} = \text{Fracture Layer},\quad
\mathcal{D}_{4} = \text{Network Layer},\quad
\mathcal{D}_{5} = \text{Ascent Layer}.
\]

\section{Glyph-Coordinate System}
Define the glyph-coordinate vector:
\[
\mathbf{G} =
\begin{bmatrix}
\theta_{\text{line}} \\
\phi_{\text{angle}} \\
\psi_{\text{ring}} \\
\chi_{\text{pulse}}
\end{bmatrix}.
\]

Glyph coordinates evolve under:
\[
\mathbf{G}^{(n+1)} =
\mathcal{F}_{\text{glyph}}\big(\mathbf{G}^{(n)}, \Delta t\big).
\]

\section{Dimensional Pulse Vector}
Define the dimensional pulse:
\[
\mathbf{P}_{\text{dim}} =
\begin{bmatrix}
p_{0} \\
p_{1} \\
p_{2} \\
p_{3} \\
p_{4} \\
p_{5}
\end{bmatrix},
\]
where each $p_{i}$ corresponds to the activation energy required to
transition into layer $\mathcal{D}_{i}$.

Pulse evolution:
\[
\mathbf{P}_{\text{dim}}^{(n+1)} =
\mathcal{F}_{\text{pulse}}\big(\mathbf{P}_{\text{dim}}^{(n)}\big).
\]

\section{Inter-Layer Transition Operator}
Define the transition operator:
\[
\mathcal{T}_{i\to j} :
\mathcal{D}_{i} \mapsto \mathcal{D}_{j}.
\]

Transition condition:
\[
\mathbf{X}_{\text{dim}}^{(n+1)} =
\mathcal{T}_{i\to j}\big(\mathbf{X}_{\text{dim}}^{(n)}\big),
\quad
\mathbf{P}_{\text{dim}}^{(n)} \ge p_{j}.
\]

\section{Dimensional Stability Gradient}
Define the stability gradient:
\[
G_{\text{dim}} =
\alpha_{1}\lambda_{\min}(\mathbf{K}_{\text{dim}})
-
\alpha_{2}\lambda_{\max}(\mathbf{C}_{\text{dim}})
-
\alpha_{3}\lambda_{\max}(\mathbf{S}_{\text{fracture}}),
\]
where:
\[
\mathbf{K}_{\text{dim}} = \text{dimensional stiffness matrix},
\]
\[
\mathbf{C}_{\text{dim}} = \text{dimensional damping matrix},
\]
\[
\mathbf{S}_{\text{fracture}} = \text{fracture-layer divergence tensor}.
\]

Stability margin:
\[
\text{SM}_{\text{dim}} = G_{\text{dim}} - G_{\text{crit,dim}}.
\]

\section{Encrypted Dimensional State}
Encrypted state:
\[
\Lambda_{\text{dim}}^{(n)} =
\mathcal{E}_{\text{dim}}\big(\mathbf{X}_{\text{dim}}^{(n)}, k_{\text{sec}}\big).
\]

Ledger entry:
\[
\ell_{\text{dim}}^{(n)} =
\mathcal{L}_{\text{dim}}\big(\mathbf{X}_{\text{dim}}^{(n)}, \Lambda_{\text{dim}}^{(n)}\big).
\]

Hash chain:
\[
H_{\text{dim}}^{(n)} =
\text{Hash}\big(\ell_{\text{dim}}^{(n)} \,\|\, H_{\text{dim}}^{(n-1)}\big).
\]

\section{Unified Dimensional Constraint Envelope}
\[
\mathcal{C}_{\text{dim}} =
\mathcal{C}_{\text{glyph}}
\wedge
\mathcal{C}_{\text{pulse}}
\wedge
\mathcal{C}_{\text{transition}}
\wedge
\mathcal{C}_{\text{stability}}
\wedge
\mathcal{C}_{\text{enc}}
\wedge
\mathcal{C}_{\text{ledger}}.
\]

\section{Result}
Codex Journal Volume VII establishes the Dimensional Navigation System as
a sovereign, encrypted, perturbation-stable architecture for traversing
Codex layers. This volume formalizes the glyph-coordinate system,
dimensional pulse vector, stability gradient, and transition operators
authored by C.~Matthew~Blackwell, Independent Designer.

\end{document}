\section{Introduction}
Dimensional navigation is the suprakernel's mechanism for transitioning
between Codex layers. Each layer represents a structural mode of
existence governed by its own geometry, stability constraints, and
glyph logic. This volume documents the operators, gradients, and
encrypted state bindings required for safe inter-layer traversal.

\section{Dimensional Layer Set}
Define the Codex dimensional set:
\[
\mathcal{D} =
\{\mathcal{D}_{0}, \mathcal{D}_{1}, \mathcal{D}_{2},
  \mathcal{D}_{3}, \mathcal{D}_{4}, \mathcal{D}_{5}\},
\]
where:
\[
\mathcal{D}_{0} = \text{Void Layer},\quad
\mathcal{D}_{1} = \text{Line Layer},\quad
\mathcal{D}_{2} = \text{Glyph Layer},
\]
\[
\mathcal{D}_{3} = \text{Fracture Layer},\quad
\mathcal{D}_{4} = \text{Network Layer},\quad
\mathcal{D}_{5} = \text{Ascent Layer}.
\]

\section{Glyph-Coordinate System}
Define the glyph-coordinate vector:
\[
\mathbf{G} =
\begin{bmatrix}
\theta_{\text{line}} \\
\phi_{\text{angle}} \\
\psi_{\text{ring}} \\
\chi_{\text{pulse}}
\end{bmatrix}.
\]

Glyph coordinates evolve under:
\[
\mathbf{G}^{(n+1)} =
\mathcal{F}_{\text{glyph}}\big(\mathbf{G}^{(n)}, \Delta t\big).
\]

\section{Dimensional Pulse Vector}
Define the dimensional pulse:
\[
\mathbf{P}_{\text{dim}} =
\begin{bmatrix}
p_{0} \\
p_{1} \\
p_{2} \\
p_{3} \\
p_{4} \\
p_{5}
\end{bmatrix},
\]
where each $p_{i}$ corresponds to the activation energy required to
transition into layer $\mathcal{D}_{i}$.

Pulse evolution:
\[
\mathbf{P}_{\text{dim}}^{(n+1)} =
\mathcal{F}_{\text{pulse}}\big(\mathbf{P}_{\text{dim}}^{(n)}\big).
\]

\section{Inter-Layer Transition Operator}
Define the transition operator:
\[
\mathcal{T}_{i\to j} :
\mathcal{D}_{i} \mapsto \mathcal{D}_{j}.
\]

Transition condition:
\[
\mathbf{X}_{\text{dim}}^{(n+1)} =
\mathcal{T}_{i\to j}\big(\mathbf{X}_{\text{dim}}^{(n)}\big),
\quad
\mathbf{P}_{\text{dim}}^{(n)} \ge p_{j}.
\]

\section{Dimensional Stability Gradient}
Define the stability gradient:
\[
G_{\text{dim}} =
\alpha_{1}\lambda_{\min}(\mathbf{K}_{\text{dim}})
-
\alpha_{2}\lambda_{\max}(\mathbf{C}_{\text{dim}})
-
\alpha_{3}\lambda_{\max}(\mathbf{S}_{\text{fracture}}),
\]
where:
\[
\mathbf{K}_{\text{dim}} = \text{dimensional stiffness matrix},
\]
\[
\mathbf{C}_{\text{dim}} = \text{dimensional damping matrix},
\]
\[
\mathbf{S}_{\text{fracture}} = \text{fracture-layer divergence tensor}.
\]

Stability margin:
\[
\text{SM}_{\text{dim}} = G_{\text{dim}} - G_{\text{crit,dim}}.
\]

