__global__ void sccv_kerr_cartan_raymarch_kernel(
    const double2* d_eht_vis,
    float4* d_frame,
    double mass_M, double spin_a,
    double torsion_alpha,
    int width, int height)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int idy = blockIdx.y * blockDim.y + threadIdx.y;
    if (idx >= width || idy >= height) return;

    double3 ray_pos = make_double3(0.0, 1000.0 * mass_M, 0.0);
    double3 ray_dir = sccv_compute_pixel_direction(idx, idy, width, height);

    double tau = 0.0;
    while (sccv_in_bounds(ray_pos, mass_M) && tau < 10000.0) {
        sccv_rk4_step_kerr_torsion(&ray_pos, &ray_dir,
            mass_M, spin_a, torsion_alpha, 0.01);

        if (sccv_crosses_horizon(ray_pos, mass_M, spin_a)) {
            d_frame[idy * width + idx] = make_float4(0,0,0,1);
            return;
        }
        tau += 0.01;
    }
}
\end{verbatim}

