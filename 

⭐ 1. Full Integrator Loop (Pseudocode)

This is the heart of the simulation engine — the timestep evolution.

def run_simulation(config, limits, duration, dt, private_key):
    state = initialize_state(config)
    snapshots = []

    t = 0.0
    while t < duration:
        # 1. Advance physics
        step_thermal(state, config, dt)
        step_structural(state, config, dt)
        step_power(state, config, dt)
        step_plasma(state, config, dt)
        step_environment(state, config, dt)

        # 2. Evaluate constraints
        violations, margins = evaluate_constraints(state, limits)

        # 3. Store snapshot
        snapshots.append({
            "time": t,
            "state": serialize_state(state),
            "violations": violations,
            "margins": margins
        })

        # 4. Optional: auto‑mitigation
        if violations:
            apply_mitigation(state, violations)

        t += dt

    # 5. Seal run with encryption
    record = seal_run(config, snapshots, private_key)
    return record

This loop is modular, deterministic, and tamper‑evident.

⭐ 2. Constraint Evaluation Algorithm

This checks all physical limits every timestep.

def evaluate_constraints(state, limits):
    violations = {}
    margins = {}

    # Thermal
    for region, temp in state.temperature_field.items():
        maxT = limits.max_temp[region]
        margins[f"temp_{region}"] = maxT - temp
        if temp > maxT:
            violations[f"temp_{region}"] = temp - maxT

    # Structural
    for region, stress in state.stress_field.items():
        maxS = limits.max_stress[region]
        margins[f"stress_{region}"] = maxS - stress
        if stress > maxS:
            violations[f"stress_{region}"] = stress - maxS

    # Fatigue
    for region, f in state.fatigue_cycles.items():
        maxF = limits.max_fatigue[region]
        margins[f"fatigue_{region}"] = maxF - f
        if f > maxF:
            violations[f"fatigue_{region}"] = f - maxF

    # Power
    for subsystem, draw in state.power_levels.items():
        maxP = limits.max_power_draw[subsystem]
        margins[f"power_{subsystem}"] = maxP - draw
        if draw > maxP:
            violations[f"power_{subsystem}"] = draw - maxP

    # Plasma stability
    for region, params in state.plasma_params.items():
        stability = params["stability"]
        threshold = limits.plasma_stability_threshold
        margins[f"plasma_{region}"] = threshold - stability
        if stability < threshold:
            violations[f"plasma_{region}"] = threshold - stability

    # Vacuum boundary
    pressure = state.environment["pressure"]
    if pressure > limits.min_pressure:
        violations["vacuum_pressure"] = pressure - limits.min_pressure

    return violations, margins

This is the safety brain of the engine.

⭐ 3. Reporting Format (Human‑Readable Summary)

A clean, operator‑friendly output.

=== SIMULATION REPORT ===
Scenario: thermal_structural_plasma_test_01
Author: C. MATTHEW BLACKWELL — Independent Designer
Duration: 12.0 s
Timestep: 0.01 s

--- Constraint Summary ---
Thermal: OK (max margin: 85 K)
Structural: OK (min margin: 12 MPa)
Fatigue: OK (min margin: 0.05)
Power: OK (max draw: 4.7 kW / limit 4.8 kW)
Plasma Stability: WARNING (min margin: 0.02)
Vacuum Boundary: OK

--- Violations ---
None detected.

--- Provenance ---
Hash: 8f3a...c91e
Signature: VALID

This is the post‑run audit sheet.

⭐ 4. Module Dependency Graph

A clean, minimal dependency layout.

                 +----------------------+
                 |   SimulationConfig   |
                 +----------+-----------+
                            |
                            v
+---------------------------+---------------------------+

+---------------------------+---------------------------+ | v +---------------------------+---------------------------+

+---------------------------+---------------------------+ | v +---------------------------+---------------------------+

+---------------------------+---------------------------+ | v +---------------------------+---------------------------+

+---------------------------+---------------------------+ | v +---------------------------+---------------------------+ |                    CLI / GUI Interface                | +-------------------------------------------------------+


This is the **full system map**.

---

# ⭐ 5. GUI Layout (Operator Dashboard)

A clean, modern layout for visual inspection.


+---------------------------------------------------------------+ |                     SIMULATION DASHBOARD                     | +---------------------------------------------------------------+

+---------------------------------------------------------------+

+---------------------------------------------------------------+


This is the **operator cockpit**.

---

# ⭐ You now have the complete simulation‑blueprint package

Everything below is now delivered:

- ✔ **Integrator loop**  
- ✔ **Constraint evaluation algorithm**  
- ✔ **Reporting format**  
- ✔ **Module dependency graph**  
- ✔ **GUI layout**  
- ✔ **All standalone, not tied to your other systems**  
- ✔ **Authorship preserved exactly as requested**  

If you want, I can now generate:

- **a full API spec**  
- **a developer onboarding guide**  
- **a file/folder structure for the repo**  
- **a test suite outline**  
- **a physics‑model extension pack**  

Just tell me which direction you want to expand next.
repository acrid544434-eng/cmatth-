This is the heart of the simulation engine — the timestep evolution.

def run_simulation(config, limits, duration, dt, private_key):
    state = initialize_state(config)
    snapshots = []

    t = 0.0
    while t < duration:
        # 1. Advance physics
        step_thermal(state, config, dt)
        step_structural(state, config, dt)
        step_power(state, config, dt)
        step_plasma(state, config, dt)
        step_environment(state, config, dt)

        # 2. Evaluate constraints
        violations, margins = evaluate_constraints(state, limits)

        # 3. Store snapshot
        snapshots.append({
            "time": t,
            "state": serialize_state(state),
            "violations": violations,
            "margins": margins
        })

        # 4. Optional: auto‑mitigation
        if violations:
            apply_mitigation(state, violations)

        t += dt

    # 5. Seal run with encryption
    record = seal_run(config, snapshots, private_key)
    return record

This loop is modular, deterministic, and tamper‑evident.

⭐ 2. Constraint Evaluation Algorithm

This checks all physical limits every timestep.

def evaluate_constraints(state, limits):
    violations = {}
    margins = {}

    # Thermal
    for region, temp in state.temperature_field.items():
        maxT = limits.max_temp[region]
        margins[f"temp_{region}"] = maxT - temp
        if temp > maxT:
            violations[f"temp_{region}"] = temp - maxT

    # Structural
    for region, stress in state.stress_field.items():
        maxS = limits.max_stress[region]
        margins[f"stress_{region}"] = maxS - stress
        if stress > maxS:
            violations[f"stress_{region}"] = stress - maxS

    # Fatigue
    for region, f in state.fatigue_cycles.items():
        maxF = limits.max_fatigue[region]
        margins[f"fatigue_{region}"] = maxF - f
        if f > maxF:
            violations[f"fatigue_{region}"] = f - maxF

    # Power
    for subsystem, draw in state.power_levels.items():
        maxP = limits.max_power_draw[subsystem]
        margins[f"power_{subsystem}"] = maxP - draw
        if draw > maxP:
            violations[f"power_{subsystem}"] = draw - maxP

    # Plasma stability
    for region, params in state.plasma_params.items():
        stability = params["stability"]
        threshold = limits.plasma_stability_threshold
        margins[f"plasma_{region}"] = threshold - stability
        if stability < threshold:
            violations[f"plasma_{region}"] = threshold - stability

    # Vacuum boundary
    pressure = state.environment["pressure"]
    if pressure > limits.min_pressure:
        violations["vacuum_pressure"] = pressure - limits.min_pressure

    return violations, margins

This is the safety brain of the engine.

