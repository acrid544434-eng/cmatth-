\section{Canonical Quantum Gravity Preliminaries}

\subsection{ADM Decomposition}
We begin with the ADM decomposition of spacetime into spatial hypersurfaces $\Sigma_t$ with metric
$h_{ij}$ and lapse $N$, shift $N^i$:
\[
ds^2 = -N^2 dt^2 + h_{ij} (dx^i + N^i dt)(dx^j + N^j dt).
\]

The Einstein--Hilbert action with cosmological constant $\Lambda$ and matter fields $\phi$ is:
\[
S = \frac{1}{16\pi G} \int d^4x \sqrt{-g} (R - 2\Lambda) + S_{\text{matter}}[g_{\mu\nu}, \phi].
\]

\subsection{Canonical Momenta}
The canonical momentum conjugate to $h_{ij}$ is:
\[
\pi^{ij} = \frac{\partial \mathcal{L}}{\partial \dot{h}_{ij}}
= \frac{\sqrt{h}}{16\pi G} (K^{ij} - h^{ij} K),
\]
where $K_{ij}$ is the extrinsic curvature:
\[
K_{ij} = \frac{1}{2N} \left(
\dot{h}_{ij} - \nabla_i N_j - \nabla_j N_i
\right).
\]

\section{Hamiltonian Constraint}

\subsection{Classical Hamiltonian}
The Hamiltonian density can be written as:
\[
\mathcal{H} = N \mathcal{H}_\perp + N_i \mathcal{H}^i,
\]
where $\mathcal{H}_\perp$ is the Hamiltonian (scalar) constraint and $\mathcal{H}^i$ is the momentum
(vector) constraint.

The scalar constraint is:
\[
\mathcal{H}_\perp =
\frac{16\pi G}{\sqrt{h}} G_{ijkl} \pi^{ij} \pi^{kl}
- \frac{\sqrt{h}}{16\pi G} (R^{(3)} - 2\Lambda)
+ \mathcal{H}_{\text{matter}},
\]
where $R^{(3)}$ is the Ricci scalar of $h_{ij}$ and $G_{ijkl}$ is the DeWitt supermetric:
\[
G_{ijkl} =
\frac{1}{2} (h_{ik} h_{jl} + h_{il} h_{jk} - h_{ij} h_{kl}).
\]

\section{Quantization Procedure}

\subsection{Canonical Quantization}
We promote $h_{ij}$ and $\pi^{ij}$ to operators:
\[
\hat{h}_{ij}(x), \qquad
\hat{\pi}^{ij}(x) = -i \hbar \frac{\delta}{\delta h_{ij}(x)}.
\]

The wave functional of the universe is:
\[
\Psi[h_{ij}, \phi],
\]
defined over superspace (the space of all 3-metrics and matter configurations).

\subsection{Operator Form of the Constraint}
The Hamiltonian constraint becomes an operator equation:
\[
\hat{\mathcal{H}}_\perp \Psi[h_{ij}, \phi] = 0.
\]

Explicitly:
\[
\left[
-16\pi G \, \frac{1}{\sqrt{h}} G_{ijkl}
\frac{\delta^2}{\delta h_{ij} \delta h_{kl}}
+ \frac{\sqrt{h}}{16\pi G} (R^{(3)} - 2\Lambda)
+ \hat{\mathcal{H}}_{\text{matter}}
\right] \Psi[h_{ij}, \phi] = 0.
\]

This is the Wheeler--DeWitt equation in functional form.

\section{Timelessness and Emergent Time}

\subsection{Absence of External Time Parameter}
The Wheeler--DeWitt equation:
\[
\hat{\mathcal{H}} \Psi = 0
\]
contains no explicit time parameter $t$. The universe is described by a static wave functional over
superspace, leading to the ``problem of time'' in canonical quantum gravity.

\subsection{Page--Wootters Construction}
In the emergent time interpretation, we partition degrees of freedom into ``clock'' and ``system'':
\[
\Psi[h_{ij}, \phi] \rightarrow \Psi_{\text{clock, sys}}.
\]

Time is defined relationally via:
\[
t = \langle \Psi | \hat{T} | \Psi \rangle,
\]
where $\hat{T}$ is a clock operator constructed from entangled subsystems.

