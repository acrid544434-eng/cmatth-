\chapter{Hamiltonian Ray-Tracing Foundations}

\section{Constraint Hamiltonian}
Ray propagation follows Fermat's principle, yielding
\begin{equation}
    H_c(\mathbf{r},\mathbf{p}) = \mathbf{p}^2 - n(\mathbf{r})^2 = 0.
\end{equation}

\section{Canonical Momentum}
The optical Lagrangian is
\begin{equation}
    L = n(\mathbf{r})\|\dot{\mathbf{r}}\|,
\end{equation}
and under $\|\dot{\mathbf{r}}\|=1$,
\begin{equation}
    \mathbf{p} = n(\mathbf{r})\dot{\mathbf{r}}.
\end{equation}

\section{Hamilton's Equations}
\begin{equation}
    \frac{d\mathbf{r}}{ds} = \frac{\mathbf{p}}{n(\mathbf{r})},
    \qquad
    \frac{d\mathbf{p}}{ds} = -n(\mathbf{r})\nabla n(\mathbf{r}).
\end{equation}

\section{Symplectic Invariance}
The canonical symplectic form is
\begin{equation}
    \omega = \sum_i dr_i \wedge dp_i.
\end{equation}
Cartan's identity yields
\begin{equation}
    \mathcal{L}_{X_{H_c}}\omega = 0,
\end{equation}
proving phase-space volume preservation.

