from dataclasses import dataclass
from typing import Callable, Any
import numpy as np


# ---------- Proton manifold components ----------

@dataclass
class QuarkState:
    positions: np.ndarray   # shape: (3, 3) -> 3 quarks, 3D position
    momenta: np.ndarray     # shape: (3, 3) -> 3 quarks, 3D momentum
    colors: np.ndarray      # shape: (3,)   -> encoded color charges


@dataclass
class GluonField:
    field_values: np.ndarray  # e.g., (Nx, Ny, Nz)
    grid: np.ndarray          # coordinates or indices


@dataclass
class EffectiveFields:
    confinement_potential: np.ndarray  # same grid as field_values
    energy_density: np.ndarray         # same grid as field_values


@dataclass
class Constraints:
    color_neutrality: float
    baryon_number: float
    symmetry_score: float


# ---------- Unified Proton Equation U(P) = Φ(Q, G, F, C) ----------

class UnifiedProton:
    """
    Unified Proton Equation:
        U(P) = Φ(Q, G, F, C)

    Where:
      Q = QuarkState
      G = GluonField
      F = EffectiveFields
      C = Constraints
      Φ = fusion operator -> maps (Q, G, F, C) to a unified state
    """

    def __init__(self, phi_strategy: Callable[[QuarkState, GluonField, EffectiveFields, Constraints], Any]):
        self.phi = phi_strategy

    def compute_U(
        self,
        quark_state: QuarkState,
        gluon_field: GluonField,
        eff_fields: EffectiveFields,
        constraints: Constraints,
    ) -> Any:
        return self.phi(quark_state, gluon_field, eff_fields, constraints)


# ---------- Example fusion operator Φ ----------

def phi_energy_weighted(
    quark_state: QuarkState,
    gluon_field: GluonField,
    eff_fields: EffectiveFields,
    constraints: Constraints,
) -> np.ndarray:
    """
    Simple example Φ:
    Compresses proton manifold into a single feature vector.
    This is where your 'proton blueprint style' lives.
    """
    features = []

    # Quark positions & momenta
    features.extend(quark_state.positions.flatten())
    features.extend(quark_state.momenta.flatten())

    # Gluon field aggregates
    fv = gluon_field.field_values
    features.append(fv.mean())
    features.append(fv.var())

    # Effective fields aggregates
    features.append(eff_fields.confinement_potential.mean())
    features.append(eff_fields.energy_density.mean())

    # Constraints
    features.append(constraints.color_neutrality)
    features.append(constraints.baryon_number)
    features.append(constraints.symmetry_score)

    return np.array(features, dtype=float)


# ---------- Minimal usage example ----------

if __name__ == "__main__":
    # Dummy proton manifold
    Q = QuarkState(
        positions=np.random.randn(3, 3),
        momenta=np.random.randn(3, 3),
        colors=np.array([1, 0, -1], dtype=float),
    )

    grid = np.mgrid[0:4, 0:4, 0:4]
    G = GluonField(
        field_values=np.random.rand(4, 4, 4),
        grid=grid,
    )

    F = EffectiveFields(
        confinement_potential=np.random.rand(4, 4, 4),
        energy_density=np.random.rand(4, 4, 4),
    )

    C = Constraints(
        color_neutrality=0.0,
        baryon_number=1.0,
        symmetry_score=0.95,
    )

    unified = UnifiedProton(phi_strategy=phi_energy_weighted)
    U = unified.compute_U(Q, G, F, C)

    print("Unified proton state shape:", U.shape)