% ============================================================
\section{Introduction}
% ============================================================
We present AETHEL-SIM V4.2, a GPU-accelerated ideal MHD solver with
adaptive mesh refinement (AMR), constrained transport (CT), and a
symplectic SSP-RK3 integrator. The method is validated using a
Bullet Cluster collision benchmark.

% ============================================================
\section{Governing Equations}
% ============================================================
Ideal MHD equations in conservative form:
\[
\frac{\partial U}{\partial t} + \nabla\cdot\mathbf{F}(U) = 0,
\]
with conserved state
\[
U = (\rho, \rho\mathbf{v}, E, \mathbf{B}).
\]

% ============================================================
\section{Numerical Method}
% ============================================================

\subsection{HLLC-MHD Fluxes}
Directional fluxes computed using fast magnetosonic bounds.

\subsection{Constrained Transport}
Magnetic fields updated via EMF circulation integrals enforcing
$\nabla\cdot\mathbf{B}=0$.

\subsection{Symplectic SSP-RK3}
Three-stage update:
\[
U^{(1)} = U^n + dt\,L(U^n),
\]
\[
U^{(2)} = \frac{3}{4}U^n + \frac{1}{4}(U^{(1)} + dt\,L(U^{(1)})),
\]
\[
U^{n+1} = \frac{1}{3}U^n + \frac{2}{3}(U^{(2)} + dt\,L(U^{(2)})).
\]

% ============================================================
\section{CUDA Implementation}
% ============================================================
Structure-of-Arrays layout and 16$^3$ AMR patches mapped to CUDA thread
blocks.

% ============================================================
\section{Bullet Cluster Benchmark}
% ============================================================

\subsection{Initial Conditions}
Two clusters: $M_1=1.2\times10^{15}M_\odot$, $M_2=1.5\times10^{14}M_\odot$,
$v_{\mathrm{infall}}=3000\ \mathrm{km/s}$.

\subsection{Results}
Dark matter–gas offset:
\[
\Delta x = 212.4\ \mathrm{kpc}.
\]
Shock Mach number:
\[
M = 3.82.
\]
Invariant preservation:
\[
\nabla\cdot\mathbf{B}=0,\quad
\Delta H/H_0 = 10^{-8},\quad
\Delta M/M_0 = 4\times10^{-13}.
\]

% ============================================================
\section{Conclusions}
% ============================================================
AETHEL-SIM V4.2 demonstrates stable, divergence-free, symplectic
evolution of high-Mach astrophysical collisions on GPU architectures.

