{
  "c_layer": {
    "version": "1.1.0",

    "author": {
      "name": "C. Matthew Blackwell",
      "role": "Independent designer",
      "origin": "Lafayette, LA, United States",
      "signature": "cmb::independent-designer::c-layer"
    },

    "phenomenology_field": {
      "module": "phenomenology_field",
      "id": "phenomenology::field::v1",

      "channels": [
        "internal_state",
        "external_environment",
        "memory_trace",
        "simulation_meta"
      ],

      "state": {
        "compression_gradient": 0.0,
        "prediction_delta": 0.0,
        "resonance_level": 0.0,
        "signal_contrast_internal": 0.0,
        "signal_contrast_external": 0.0
      },

      "update_rule": {
        "tick_hz": 60,
        "equation": "state_next = state + Δ(compression, prediction, resonance, contrast)",
        "stability_bias": 0.92,
        "plasticity_bias": 0.08
      }
    },

    "self_model_loop": {
      "module": "self_model_loop",
      "id": "self-model::loop::v1",

      "parameters": {
        "prediction_horizon_steps": 1,
        "update_rate_hz": 60,
        "stability_bias": 0.85,
        "plasticity_bias": 0.15
      },

      "cycle": {
        "steps": [
          "observe_phenomenology",
          "predict_next_state",
          "compare_predicted_actual",
          "update_internal_model",
          "re-emit_phenomenology"
        ]
      },

      "state": {
        "model_confidence": 0.0,
        "prediction_error": 0.0,
        "adaptation_rate": 0.0
      }
    }
  }
}