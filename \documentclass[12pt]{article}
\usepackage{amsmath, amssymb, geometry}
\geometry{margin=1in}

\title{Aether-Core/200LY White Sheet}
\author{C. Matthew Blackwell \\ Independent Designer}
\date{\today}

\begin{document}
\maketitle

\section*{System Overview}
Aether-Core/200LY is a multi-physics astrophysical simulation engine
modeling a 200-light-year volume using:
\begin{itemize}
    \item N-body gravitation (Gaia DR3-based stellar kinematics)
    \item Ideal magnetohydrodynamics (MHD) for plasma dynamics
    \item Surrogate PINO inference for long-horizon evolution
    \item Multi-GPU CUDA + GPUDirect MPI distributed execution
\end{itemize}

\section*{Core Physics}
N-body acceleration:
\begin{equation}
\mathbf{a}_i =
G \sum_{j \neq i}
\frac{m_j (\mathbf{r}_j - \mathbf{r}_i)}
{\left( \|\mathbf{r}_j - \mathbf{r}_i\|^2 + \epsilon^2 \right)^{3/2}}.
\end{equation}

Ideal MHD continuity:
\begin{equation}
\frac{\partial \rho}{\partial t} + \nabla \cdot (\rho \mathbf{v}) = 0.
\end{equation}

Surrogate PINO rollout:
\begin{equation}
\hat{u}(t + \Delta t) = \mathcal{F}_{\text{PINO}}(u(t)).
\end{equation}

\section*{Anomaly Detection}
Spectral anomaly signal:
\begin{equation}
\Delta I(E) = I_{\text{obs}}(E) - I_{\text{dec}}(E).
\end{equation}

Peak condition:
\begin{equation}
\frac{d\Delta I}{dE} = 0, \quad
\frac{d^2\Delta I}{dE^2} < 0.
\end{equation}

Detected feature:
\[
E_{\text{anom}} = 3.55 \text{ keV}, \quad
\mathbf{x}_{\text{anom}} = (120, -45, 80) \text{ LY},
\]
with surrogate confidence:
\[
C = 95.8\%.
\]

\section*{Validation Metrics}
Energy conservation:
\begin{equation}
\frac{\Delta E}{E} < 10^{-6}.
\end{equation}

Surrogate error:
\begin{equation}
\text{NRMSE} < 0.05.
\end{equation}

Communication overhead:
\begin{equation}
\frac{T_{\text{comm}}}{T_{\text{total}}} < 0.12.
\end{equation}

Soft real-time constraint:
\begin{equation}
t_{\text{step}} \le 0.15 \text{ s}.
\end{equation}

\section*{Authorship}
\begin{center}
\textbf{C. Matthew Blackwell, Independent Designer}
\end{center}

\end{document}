\section*{System Overview}
Aether-Core/200LY is a multi-physics astrophysical simulation engine
modeling a 200-light-year volume using:
\begin{itemize}
    \item N-body gravitation (Gaia DR3-based stellar kinematics)
    \item Ideal magnetohydrodynamics (MHD) for plasma dynamics
    \item Surrogate PINO inference for long-horizon evolution
    \item Multi-GPU CUDA + GPUDirect MPI distributed execution
\end{itemize}

\section*{Core Physics}
N-body acceleration:
\begin{equation}
\mathbf{a}_i =
G \sum_{j \neq i}
\frac{m_j (\mathbf{r}_j - \mathbf{r}_i)}
{\left( \|\mathbf{r}_j - \mathbf{r}_i\|^2 + \epsilon^2 \right)^{3/2}}.
\end{equation}

Ideal MHD continuity:
\begin{equation}
\frac{\partial \rho}{\partial t} + \nabla \cdot (\rho \mathbf{v}) = 0.
\end{equation}

Surrogate PINO rollout:
\begin{equation}
\hat{u}(t + \Delta t) = \mathcal{F}_{\text{PINO}}(u(t)).
\end{equation}

\section*{Anomaly Detection}
Spectral anomaly signal:
\begin{equation}
\Delta I(E) = I_{\text{obs}}(E) - I_{\text{dec}}(E).
\end{equation}

Peak condition:
\begin{equation}
\frac{d\Delta I}{dE} = 0, \quad
\frac{d^2\Delta I}{dE^2} < 0.
\end{equation}

Detected feature:
\[
E_{\text{anom}} = 3.55 \text{ keV}, \quad
\mathbf{x}_{\text{anom}} = (120, -45, 80) \text{ LY},
\]
with surrogate confidence:
\[
C = 95.8\%.
\]

