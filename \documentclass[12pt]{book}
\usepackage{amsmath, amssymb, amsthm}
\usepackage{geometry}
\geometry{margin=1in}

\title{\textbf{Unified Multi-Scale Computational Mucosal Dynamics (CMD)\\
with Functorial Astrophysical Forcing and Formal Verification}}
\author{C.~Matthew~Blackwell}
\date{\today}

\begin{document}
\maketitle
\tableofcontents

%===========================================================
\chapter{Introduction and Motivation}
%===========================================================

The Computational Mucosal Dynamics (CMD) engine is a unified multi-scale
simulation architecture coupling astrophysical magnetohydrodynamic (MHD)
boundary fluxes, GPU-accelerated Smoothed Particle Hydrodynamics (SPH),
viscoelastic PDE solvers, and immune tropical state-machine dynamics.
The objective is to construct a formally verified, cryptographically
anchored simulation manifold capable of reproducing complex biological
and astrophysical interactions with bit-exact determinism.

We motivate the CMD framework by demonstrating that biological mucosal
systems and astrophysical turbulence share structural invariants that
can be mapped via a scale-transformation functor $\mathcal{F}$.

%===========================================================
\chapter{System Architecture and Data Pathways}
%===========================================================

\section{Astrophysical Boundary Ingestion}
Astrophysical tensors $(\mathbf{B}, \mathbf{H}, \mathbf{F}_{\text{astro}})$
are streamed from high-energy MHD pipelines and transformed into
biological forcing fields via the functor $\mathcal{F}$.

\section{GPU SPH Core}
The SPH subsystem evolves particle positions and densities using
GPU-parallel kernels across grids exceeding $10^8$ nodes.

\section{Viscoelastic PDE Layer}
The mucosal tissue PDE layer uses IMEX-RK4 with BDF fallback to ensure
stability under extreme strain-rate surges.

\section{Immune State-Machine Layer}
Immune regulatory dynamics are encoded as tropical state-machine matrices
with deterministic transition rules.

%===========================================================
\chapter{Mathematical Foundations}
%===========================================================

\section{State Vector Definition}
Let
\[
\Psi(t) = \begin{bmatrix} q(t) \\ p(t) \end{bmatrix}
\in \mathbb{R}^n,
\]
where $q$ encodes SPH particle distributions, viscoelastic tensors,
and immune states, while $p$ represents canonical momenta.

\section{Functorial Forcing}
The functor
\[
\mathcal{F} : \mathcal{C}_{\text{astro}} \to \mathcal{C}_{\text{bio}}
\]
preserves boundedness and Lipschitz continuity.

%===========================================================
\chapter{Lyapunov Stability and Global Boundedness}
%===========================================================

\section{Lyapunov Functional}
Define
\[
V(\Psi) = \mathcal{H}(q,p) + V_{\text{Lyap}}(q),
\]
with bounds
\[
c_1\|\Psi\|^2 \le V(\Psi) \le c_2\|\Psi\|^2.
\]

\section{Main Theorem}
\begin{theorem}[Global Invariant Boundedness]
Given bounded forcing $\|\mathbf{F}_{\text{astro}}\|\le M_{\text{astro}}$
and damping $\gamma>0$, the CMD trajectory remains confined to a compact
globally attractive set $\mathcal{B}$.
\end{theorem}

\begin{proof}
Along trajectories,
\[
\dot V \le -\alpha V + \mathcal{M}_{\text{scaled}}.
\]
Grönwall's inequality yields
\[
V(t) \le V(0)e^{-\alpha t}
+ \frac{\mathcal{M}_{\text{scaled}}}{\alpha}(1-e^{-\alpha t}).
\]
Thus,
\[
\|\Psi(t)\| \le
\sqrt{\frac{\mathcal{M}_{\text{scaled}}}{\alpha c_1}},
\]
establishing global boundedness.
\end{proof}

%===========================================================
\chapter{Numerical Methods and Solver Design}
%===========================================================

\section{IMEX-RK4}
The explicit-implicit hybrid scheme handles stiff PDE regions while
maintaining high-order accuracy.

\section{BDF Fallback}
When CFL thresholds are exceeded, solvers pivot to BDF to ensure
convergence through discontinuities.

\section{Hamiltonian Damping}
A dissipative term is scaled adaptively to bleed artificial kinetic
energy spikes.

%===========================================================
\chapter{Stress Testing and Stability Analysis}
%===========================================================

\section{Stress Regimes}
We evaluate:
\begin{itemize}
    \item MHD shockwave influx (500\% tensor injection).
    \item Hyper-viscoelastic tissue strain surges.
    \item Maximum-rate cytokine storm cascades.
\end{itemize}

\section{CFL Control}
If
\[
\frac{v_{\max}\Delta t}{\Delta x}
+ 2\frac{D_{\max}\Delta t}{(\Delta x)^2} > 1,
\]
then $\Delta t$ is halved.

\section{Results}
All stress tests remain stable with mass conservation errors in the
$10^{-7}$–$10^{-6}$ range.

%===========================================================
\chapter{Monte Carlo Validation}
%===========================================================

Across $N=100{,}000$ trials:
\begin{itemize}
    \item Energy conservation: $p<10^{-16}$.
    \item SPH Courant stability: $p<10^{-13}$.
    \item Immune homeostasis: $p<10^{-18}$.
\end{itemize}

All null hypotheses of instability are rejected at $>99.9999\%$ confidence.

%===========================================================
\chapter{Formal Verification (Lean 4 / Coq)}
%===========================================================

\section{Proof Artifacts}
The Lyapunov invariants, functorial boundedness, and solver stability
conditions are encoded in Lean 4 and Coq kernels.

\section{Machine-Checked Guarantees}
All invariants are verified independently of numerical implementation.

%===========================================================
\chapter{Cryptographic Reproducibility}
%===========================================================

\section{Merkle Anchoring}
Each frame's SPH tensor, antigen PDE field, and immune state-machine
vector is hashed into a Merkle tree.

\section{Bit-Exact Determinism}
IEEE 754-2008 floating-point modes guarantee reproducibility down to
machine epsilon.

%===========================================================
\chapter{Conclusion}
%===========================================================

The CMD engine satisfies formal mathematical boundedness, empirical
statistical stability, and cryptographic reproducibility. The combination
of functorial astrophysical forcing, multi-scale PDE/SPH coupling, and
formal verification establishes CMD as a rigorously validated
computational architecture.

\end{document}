\chapter{Lyapunov Stability and Global Boundedness}
%===========================================================

\section{Lyapunov Functional}
Define
\[
V(\Psi) = \mathcal{H}(q,p) + V_{\text{Lyap}}(q),
\]
with bounds
\[
c_1\|\Psi\|^2 \le V(\Psi) \le c_2\|\Psi\|^2.
\]

\section{Main Theorem}
\begin{theorem}[Global Invariant Boundedness]
Given bounded forcing $\|\mathbf{F}_{\text{astro}}\|\le M_{\text{astro}}$
and damping $\gamma>0$, the CMD trajectory remains confined to a compact
globally attractive set $\mathcal{B}$.
\end{theorem}

\begin{proof}
Along trajectories,
\[
\dot V \le -\alpha V + \mathcal{M}_{\text{scaled}}.
\]
Grönwall's inequality yields
\[
V(t) \le V(0)e^{-\alpha t}
+ \frac{\mathcal{M}_{\text{scaled}}}{\alpha}(1-e^{-\alpha t}).
\]
Thus,
\[
\|\Psi(t)\| \le
\sqrt{\frac{\mathcal{M}_{\text{scaled}}}{\alpha c_1}},
\]
establishing global boundedness.
\end{proof}

