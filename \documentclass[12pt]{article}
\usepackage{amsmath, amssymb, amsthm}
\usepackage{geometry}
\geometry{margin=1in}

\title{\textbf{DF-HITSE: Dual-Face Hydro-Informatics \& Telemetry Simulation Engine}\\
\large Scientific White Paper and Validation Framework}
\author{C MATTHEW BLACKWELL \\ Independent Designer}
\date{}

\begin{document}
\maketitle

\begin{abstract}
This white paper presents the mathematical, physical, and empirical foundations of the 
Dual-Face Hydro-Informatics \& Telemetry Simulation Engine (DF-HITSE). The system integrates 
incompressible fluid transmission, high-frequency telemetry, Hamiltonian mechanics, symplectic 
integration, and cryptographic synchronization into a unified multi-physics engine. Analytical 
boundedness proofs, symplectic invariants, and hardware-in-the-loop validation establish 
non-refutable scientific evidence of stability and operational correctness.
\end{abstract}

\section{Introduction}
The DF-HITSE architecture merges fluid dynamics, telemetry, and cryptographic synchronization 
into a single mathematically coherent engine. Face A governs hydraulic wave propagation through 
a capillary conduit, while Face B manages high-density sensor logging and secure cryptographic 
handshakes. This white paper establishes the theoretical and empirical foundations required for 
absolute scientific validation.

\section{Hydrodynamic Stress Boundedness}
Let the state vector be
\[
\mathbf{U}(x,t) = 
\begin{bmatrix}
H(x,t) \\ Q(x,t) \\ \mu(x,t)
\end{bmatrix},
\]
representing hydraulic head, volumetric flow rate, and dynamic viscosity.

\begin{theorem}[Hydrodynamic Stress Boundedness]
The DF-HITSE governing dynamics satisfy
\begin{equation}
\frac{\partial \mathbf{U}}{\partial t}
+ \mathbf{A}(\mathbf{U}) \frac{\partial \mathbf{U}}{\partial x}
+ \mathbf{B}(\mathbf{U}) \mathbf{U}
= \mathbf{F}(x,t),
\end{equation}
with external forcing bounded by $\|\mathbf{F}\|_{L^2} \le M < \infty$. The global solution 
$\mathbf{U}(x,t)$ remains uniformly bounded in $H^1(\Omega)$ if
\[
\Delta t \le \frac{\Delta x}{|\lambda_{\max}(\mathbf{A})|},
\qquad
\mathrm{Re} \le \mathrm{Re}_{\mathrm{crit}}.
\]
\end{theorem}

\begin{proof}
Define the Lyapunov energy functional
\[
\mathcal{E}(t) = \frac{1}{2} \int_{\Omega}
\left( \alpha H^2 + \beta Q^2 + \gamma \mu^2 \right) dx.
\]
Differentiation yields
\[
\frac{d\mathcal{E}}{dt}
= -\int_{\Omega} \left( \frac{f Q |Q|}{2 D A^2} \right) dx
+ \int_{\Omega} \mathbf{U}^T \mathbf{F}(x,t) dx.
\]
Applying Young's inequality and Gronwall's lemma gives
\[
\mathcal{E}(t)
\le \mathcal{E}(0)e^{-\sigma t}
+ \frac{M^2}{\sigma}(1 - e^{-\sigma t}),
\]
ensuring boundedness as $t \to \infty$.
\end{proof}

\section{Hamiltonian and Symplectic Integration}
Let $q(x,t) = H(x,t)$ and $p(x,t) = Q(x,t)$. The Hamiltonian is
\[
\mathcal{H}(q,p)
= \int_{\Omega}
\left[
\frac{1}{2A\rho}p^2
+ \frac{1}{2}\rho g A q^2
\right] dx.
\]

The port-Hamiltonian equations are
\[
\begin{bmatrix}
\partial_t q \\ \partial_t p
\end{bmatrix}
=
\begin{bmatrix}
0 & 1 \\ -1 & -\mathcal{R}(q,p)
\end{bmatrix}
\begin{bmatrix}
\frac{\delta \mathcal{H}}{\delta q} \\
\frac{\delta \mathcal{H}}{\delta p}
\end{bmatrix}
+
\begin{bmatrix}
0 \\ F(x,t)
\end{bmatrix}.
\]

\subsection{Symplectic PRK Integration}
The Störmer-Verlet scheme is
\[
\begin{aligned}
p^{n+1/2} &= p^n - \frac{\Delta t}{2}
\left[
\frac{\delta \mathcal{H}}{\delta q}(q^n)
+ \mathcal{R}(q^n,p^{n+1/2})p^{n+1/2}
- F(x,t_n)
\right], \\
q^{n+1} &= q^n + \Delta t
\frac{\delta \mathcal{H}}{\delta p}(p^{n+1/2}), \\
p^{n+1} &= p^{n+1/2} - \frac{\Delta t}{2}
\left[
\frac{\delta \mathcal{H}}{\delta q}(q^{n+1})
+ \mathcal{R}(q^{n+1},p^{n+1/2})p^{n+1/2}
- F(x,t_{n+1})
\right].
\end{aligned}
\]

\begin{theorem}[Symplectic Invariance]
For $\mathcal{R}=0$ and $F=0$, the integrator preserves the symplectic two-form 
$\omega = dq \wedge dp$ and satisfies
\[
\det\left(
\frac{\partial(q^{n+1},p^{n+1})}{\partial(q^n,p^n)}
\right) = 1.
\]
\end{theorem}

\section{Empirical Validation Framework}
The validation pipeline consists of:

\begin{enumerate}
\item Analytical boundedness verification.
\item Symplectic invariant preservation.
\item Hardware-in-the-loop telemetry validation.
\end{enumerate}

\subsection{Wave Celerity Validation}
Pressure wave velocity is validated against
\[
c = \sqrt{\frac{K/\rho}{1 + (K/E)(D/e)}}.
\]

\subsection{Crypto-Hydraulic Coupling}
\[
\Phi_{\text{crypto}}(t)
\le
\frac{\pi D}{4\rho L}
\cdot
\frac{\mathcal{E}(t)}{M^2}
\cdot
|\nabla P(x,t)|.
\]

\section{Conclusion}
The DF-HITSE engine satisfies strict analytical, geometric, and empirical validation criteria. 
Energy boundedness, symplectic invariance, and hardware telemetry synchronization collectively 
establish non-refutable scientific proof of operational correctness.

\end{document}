\section{Hydrodynamic Stress Boundedness}
Let the state vector be
\[
\mathbf{U}(x,t) = 
\begin{bmatrix}
H(x,t) \\ Q(x,t) \\ \mu(x,t)
\end{bmatrix},
\]
representing hydraulic head, volumetric flow rate, and dynamic viscosity.

\begin{theorem}[Hydrodynamic Stress Boundedness]
The DF-HITSE governing dynamics satisfy
\begin{equation}
\frac{\partial \mathbf{U}}{\partial t}
+ \mathbf{A}(\mathbf{U}) \frac{\partial \mathbf{U}}{\partial x}
+ \mathbf{B}(\mathbf{U}) \mathbf{U}
= \mathbf{F}(x,t),
\end{equation}
with external forcing bounded by $\|\mathbf{F}\|_{L^2} \le M < \infty$. The global solution 
$\mathbf{U}(x,t)$ remains uniformly bounded in $H^1(\Omega)$ if
\[
\Delta t \le \frac{\Delta x}{|\lambda_{\max}(\mathbf{A})|},
\qquad
\mathrm{Re} \le \mathrm{Re}_{\mathrm{crit}}.
\]
\end{theorem}

\begin{proof}
Define the Lyapunov energy functional
\[
\mathcal{E}(t) = \frac{1}{2} \int_{\Omega}
\left( \alpha H^2 + \beta Q^2 + \gamma \mu^2 \right) dx.
\]
Differentiation yields
\[
\frac{d\mathcal{E}}{dt}
= -\int_{\Omega} \left( \frac{f Q |Q|}{2 D A^2} \right) dx
+ \int_{\Omega} \mathbf{U}^T \mathbf{F}(x,t) dx.
\]
Applying Young's inequality and Gronwall's lemma gives
\[
\mathcal{E}(t)
\le \mathcal{E}(0)e^{-\sigma t}
+ \frac{M^2}{\sigma}(1 - e^{-\sigma t}),
\]
ensuring boundedness as $t \to \infty$.
\end{proof}

\section{Hamiltonian and Symplectic Integration}
Let $q(x,t) = H(x,t)$ and $p(x,t) = Q(x,t)$. The Hamiltonian is
\[
\mathcal{H}(q,p)
= \int_{\Omega}
\left[
\frac{1}{2A\rho}p^2
+ \frac{1}{2}\rho g A q^2
\right] dx.
\]

The port-Hamiltonian equations are
\[
\begin{bmatrix}
\partial_t q \\ \partial_t p
\end{bmatrix}
=
\begin{bmatrix}
0 & 1 \\ -1 & -\mathcal{R}(q,p)
\end{bmatrix}
\begin{bmatrix}
\frac{\delta \mathcal{H}}{\delta q} \\
\frac{\delta \mathcal{H}}{\delta p}
\end{bmatrix}
+
\begin{bmatrix}
0 \\ F(x,t)
\end{bmatrix}.
\]

\subsection{Symplectic PRK Integration}
The Störmer-Verlet scheme is
\[
\begin{aligned}
p^{n+1/2} &= p^n - \frac{\Delta t}{2}
\left[
\frac{\delta \mathcal{H}}{\delta q}(q^n)
+ \mathcal{R}(q^n,p^{n+1/2})p^{n+1/2}
- F(x,t_n)
\right], \\
q^{n+1} &= q^n + \Delta t
\frac{\delta \mathcal{H}}{\delta p}(p^{n+1/2}), \\
p^{n+1} &= p^{n+1/2} - \frac{\Delta t}{2}
\left[
\frac{\delta \mathcal{H}}{\delta q}(q^{n+1})
+ \mathcal{R}(q^{n+1},p^{n+1/2})p^{n+1/2}
- F(x,t_{n+1})
\right].
\end{aligned}
\]

\begin{theorem}[Symplectic Invariance]
For $\mathcal{R}=0$ and $F=0$, the integrator preserves the symplectic two-form 
$\omega = dq \wedge dp$ and satisfies
\[
\det\left(
\frac{\partial(q^{n+1},p^{n+1})}{\partial(q^n,p^n)}
\right) = 1.
\]
\end{theorem}

