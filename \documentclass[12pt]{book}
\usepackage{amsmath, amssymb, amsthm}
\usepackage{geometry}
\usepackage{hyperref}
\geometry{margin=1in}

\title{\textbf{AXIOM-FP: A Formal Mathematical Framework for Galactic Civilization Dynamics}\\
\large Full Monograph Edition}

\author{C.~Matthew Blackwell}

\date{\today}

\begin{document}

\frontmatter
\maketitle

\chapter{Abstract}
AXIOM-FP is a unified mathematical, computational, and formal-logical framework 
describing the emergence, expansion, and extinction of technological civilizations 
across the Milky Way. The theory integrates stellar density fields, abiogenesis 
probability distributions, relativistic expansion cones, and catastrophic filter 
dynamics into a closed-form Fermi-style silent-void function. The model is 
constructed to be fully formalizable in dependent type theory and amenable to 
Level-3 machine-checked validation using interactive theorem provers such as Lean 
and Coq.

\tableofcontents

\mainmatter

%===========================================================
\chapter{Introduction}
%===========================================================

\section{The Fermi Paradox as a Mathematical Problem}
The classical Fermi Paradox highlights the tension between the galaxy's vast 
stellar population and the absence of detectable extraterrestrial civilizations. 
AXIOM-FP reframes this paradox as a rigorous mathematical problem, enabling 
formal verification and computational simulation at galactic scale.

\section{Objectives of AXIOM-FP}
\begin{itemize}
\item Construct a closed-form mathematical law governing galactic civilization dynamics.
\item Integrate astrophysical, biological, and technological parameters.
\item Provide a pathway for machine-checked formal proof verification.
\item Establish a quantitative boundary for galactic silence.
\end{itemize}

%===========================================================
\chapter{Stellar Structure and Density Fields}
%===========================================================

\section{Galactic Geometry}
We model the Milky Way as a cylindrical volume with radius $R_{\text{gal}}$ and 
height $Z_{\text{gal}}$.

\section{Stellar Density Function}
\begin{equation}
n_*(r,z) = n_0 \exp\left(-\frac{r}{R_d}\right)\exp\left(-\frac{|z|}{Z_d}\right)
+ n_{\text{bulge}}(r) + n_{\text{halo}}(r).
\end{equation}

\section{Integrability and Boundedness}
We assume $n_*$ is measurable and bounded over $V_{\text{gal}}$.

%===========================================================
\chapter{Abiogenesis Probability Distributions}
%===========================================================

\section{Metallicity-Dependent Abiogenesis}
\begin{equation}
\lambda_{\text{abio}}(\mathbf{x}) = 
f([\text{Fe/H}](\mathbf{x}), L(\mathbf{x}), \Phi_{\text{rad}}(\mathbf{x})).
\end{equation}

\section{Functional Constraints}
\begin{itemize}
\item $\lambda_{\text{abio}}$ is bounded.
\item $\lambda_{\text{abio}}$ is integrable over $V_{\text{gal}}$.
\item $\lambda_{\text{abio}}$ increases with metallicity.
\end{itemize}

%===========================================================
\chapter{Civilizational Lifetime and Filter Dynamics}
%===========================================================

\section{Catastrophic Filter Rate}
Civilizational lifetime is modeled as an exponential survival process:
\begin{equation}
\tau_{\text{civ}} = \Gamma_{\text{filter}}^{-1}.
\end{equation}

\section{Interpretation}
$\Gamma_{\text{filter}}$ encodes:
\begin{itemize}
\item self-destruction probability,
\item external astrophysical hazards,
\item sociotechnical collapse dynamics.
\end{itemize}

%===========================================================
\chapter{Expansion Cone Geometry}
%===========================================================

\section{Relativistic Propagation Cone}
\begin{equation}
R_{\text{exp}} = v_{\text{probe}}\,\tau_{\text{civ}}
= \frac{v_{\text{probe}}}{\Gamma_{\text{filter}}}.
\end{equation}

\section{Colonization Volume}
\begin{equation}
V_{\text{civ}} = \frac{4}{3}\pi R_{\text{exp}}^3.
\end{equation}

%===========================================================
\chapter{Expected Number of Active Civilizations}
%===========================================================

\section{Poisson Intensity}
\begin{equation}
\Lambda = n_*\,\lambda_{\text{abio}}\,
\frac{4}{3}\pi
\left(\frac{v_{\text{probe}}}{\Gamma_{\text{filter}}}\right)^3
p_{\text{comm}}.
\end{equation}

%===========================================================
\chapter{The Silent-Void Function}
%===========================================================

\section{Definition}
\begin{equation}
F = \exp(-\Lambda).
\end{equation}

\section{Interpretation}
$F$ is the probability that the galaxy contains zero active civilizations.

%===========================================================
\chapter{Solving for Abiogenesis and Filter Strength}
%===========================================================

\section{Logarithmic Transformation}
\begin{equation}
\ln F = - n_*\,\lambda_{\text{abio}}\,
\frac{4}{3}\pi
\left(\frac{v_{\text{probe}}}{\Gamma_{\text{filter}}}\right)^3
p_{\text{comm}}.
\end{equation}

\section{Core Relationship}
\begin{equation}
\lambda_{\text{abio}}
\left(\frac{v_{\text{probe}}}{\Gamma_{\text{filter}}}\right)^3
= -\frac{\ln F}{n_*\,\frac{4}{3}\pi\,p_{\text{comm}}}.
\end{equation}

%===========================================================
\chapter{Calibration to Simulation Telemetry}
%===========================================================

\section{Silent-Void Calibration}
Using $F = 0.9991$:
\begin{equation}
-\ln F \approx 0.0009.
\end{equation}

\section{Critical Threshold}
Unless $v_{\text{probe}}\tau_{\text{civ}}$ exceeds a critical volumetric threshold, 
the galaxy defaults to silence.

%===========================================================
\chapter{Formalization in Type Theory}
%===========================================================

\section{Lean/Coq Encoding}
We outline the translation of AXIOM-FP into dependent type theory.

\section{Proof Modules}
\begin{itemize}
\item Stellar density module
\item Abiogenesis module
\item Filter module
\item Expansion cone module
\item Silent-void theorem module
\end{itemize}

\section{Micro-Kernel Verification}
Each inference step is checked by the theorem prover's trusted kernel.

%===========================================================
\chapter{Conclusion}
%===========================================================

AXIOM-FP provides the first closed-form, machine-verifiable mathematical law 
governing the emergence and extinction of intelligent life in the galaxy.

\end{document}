\chapter{Civilizational Lifetime and Filter Dynamics}
%===========================================================

\section{Catastrophic Filter Rate}
Civilizational lifetime is modeled as an exponential survival process:
\begin{equation}
\tau_{\text{civ}} = \Gamma_{\text{filter}}^{-1}.
\end{equation}

\section{Interpretation}
$\Gamma_{\text{filter}}$ encodes:
\begin{itemize}
\item self-destruction probability,
\item external astrophysical hazards,
\item sociotechnical collapse dynamics.
\end{itemize}

