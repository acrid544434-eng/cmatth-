\chapter{Stellar Structure and Density Fields}
%===========================================================

\section{Galactic Geometry}
We model the Milky Way as a cylindrical volume with radius $R_{\text{gal}}$ and 
height $Z_{\text{gal}}$.

\section{Stellar Density Function}
\begin{equation}
n_*(r,z) = n_0 \exp\left(-\frac{r}{R_d}\right)\exp\left(-\frac{|z|}{Z_d}\right)
+ n_{\text{bulge}}(r) + n_{\text{halo}}(r).
\end{equation}

\section{Integrability and Boundedness}
We assume $n_*$ is measurable and bounded over $V_{\text{gal}}$.

