\chapter{The Silent-Void Function}
%===========================================================

\section{Definition}
\begin{equation}
F = \exp(-\Lambda).
\end{equation}

\section{Interpretation}
$F$ is the probability that the galaxy contains zero active civilizations.

%===========================================================
\chapter{Solving for Abiogenesis and Filter Strength}
%===========================================================

\section{Logarithmic Transformation}
\begin{equation}
\ln F = - n_*\,\lambda_{\text{abio}}\,
\frac{4}{3}\pi
\left(\frac{v_{\text{probe}}}{\Gamma_{\text{filter}}}\right)^3
p_{\text{comm}}.
\end{equation}

\section{Core Relationship}
\begin{equation}
\lambda_{\text{abio}}
\left(\frac{v_{\text{probe}}}{\Gamma_{\text{filter}}}\right)^3
= -\frac{\ln F}{n_*\,\frac{4}{3}\pi\,p_{\text{comm}}}.
\end{equation}

