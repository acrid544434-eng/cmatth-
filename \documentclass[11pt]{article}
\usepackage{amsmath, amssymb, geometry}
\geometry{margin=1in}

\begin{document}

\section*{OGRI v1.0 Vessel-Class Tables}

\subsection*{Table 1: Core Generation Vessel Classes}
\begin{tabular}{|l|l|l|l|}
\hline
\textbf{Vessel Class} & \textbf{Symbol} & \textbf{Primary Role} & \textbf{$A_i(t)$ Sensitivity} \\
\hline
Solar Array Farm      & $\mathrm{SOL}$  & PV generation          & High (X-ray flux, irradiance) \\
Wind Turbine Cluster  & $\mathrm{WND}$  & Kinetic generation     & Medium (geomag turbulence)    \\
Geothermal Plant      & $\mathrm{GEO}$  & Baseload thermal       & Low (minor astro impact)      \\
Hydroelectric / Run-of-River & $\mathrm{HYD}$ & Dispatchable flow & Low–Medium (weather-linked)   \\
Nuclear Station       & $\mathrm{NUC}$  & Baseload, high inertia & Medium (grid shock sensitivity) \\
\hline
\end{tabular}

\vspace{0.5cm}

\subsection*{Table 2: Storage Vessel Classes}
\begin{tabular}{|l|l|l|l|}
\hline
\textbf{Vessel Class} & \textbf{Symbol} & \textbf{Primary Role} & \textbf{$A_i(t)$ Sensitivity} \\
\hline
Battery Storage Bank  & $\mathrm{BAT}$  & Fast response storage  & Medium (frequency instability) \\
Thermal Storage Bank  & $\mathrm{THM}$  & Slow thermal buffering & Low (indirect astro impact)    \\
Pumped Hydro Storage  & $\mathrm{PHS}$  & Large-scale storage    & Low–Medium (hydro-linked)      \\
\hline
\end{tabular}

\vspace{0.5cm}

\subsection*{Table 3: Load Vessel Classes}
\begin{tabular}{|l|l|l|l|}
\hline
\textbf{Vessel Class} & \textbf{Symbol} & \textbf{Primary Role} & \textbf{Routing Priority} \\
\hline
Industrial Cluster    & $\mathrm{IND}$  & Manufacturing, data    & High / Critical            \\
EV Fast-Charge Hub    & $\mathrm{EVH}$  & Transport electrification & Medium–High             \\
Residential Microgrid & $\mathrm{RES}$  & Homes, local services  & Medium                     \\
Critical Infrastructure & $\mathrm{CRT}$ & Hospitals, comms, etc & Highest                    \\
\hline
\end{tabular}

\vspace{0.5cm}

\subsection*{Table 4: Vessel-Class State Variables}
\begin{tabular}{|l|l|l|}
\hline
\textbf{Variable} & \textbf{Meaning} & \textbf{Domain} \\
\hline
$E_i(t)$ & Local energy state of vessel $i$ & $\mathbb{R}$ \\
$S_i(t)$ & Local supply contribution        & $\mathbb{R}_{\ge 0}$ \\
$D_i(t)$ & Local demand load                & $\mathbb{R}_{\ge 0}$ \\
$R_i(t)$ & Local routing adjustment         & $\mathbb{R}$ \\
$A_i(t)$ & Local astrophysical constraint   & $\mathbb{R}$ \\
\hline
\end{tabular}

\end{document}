\section*{OGRI v1.0 Vessel-Class Tables}

\subsection*{Table 1: Core Generation Vessel Classes}
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Vessel Class} & \textbf{Symbol} & \textbf{Primary Role} & \textbf{$A_i(t)$ Sensitivity} \\
\hline
Solar Array Farm      & $\mathrm{SOL}$  & PV generation          & High (X-ray flux, irradiance) \\
Wind Turbine Cluster  & $\mathrm{WND}$  & Kinetic generation     & Medium (geomag turbulence)    \\
Geothermal Plant      & $\mathrm{GEO}$  & Baseload thermal       & Low (minor astro impact)      \\
Hydroelectric / Run-of-River & $\mathrm{HYD}$ & Dispatchable flow & Low–Medium (weather-linked)   \\
Nuclear Station       & $\mathrm{NUC}$  & Baseload, high inertia & Medium (grid shock sensitivity) \\
\hline
\end{tabular}

\vspace{0.5cm}

\subsection*{Table 2: Storage Vessel Classes}
\begin{tabular}{|l|l|l|l|}
\hline
