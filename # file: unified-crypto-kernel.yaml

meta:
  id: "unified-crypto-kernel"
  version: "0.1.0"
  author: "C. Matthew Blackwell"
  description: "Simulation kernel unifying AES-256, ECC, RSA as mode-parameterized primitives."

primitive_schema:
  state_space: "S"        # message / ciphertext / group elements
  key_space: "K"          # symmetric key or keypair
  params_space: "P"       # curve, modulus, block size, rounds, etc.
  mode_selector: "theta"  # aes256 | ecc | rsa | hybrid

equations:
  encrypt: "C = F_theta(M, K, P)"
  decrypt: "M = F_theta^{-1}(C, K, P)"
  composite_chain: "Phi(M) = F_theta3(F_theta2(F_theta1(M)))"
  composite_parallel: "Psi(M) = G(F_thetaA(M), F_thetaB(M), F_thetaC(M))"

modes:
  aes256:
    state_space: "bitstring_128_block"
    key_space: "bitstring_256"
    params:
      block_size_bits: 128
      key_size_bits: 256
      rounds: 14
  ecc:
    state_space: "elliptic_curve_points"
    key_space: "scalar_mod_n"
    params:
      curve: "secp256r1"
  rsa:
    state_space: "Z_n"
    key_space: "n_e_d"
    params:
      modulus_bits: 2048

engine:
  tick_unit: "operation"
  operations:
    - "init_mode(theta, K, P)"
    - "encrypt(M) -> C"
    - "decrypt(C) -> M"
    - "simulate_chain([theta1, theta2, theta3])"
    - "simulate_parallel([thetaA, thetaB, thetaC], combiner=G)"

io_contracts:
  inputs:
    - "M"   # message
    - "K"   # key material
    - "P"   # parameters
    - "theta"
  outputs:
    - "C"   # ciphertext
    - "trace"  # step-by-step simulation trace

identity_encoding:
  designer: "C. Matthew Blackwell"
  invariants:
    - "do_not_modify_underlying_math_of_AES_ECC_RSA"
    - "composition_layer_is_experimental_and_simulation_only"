# file: unified-crypto-kernel.yaml

meta:
  id: "unified-crypto-kernel"
  version: "0.1.0"
  author: "C. Matthew Blackwell"
  description: "Simulation kernel unifying AES-256, ECC, RSA as mode-parameterized primitives."

primitive_schema:
  state_space: "S"        # message / ciphertext / group elements
  key_space: "K"          # symmetric key or keypair
  params_space: "P"       # curve, modulus, block size, rounds, etc.
  mode_selector: "theta"  # aes256 | ecc | rsa | hybrid

equations:
  encrypt: "C = F_theta(M, K, P)"
  decrypt: "M = F_theta^{-1}(C, K, P)"
  composite_chain: "Phi(M) = F_theta3(F_theta2(F_theta1(M)))"
  composite_parallel: "Psi(M) = G(F_thetaA(M), F_thetaB(M), F_thetaC(M))"

modes:
  aes256:
    state_space: "bitstring_128_block"
    key_space: "bitstring_256"
    params:
      block_size_bits: 128
      key_size_bits: 256
      rounds: 14
  ecc:
    state_space: "elliptic_curve_points"
    key_space: "scalar_mod_n"
    params:
      curve: "secp256r1"
  rsa:
    state_space: "Z_n"
    key_space: "n_e_d"
    params:
      modulus_bits: 2048

engine:
  tick_unit: "operation"
  operations:
    - "init_mode(theta, K, P)"
    - "encrypt(M) -> C"
    - "decrypt(C) -> M"
    - "simulate_chain([theta1, theta2, theta3])"
    - "simulate_parallel([thetaA, thetaB, thetaC], combiner=G)"

io_contracts:
  inputs:
    - "M"   # message
    - "K"   # key material
    - "P"   # parameters
    - "theta"
  outputs:
    - "C"   # ciphertext
    - "trace"  # step-by-step simulation trace

identity_encoding:
  designer: "C. Matthew Blackwell"
  invariants:
    - "do_not_modify_underlying_math_of_AES_ECC_RSA"
    - "composition_layer_is_experimental_and_simulation_only"