\section*{1. Purpose}
This document defines the lab-ready protocol for validating the UPAS-X engine under controlled conditions, including numerical accuracy, physical realism, performance, and reproducibility.

\section*{2. Hardware Configuration}
\begin{itemize}
    \item Nodes: 16 enterprise servers.
    \item GPUs: 128 NVIDIA H100 (80GB HBM3).
    \item CPUs: Dual AMD EPYC 9654 per node.
    \item Memory: 1.5 TB DDR5-4800 per node.
    \item Interconnect: NVSwitch + NVLink 4.0, HDR InfiniBand (400 Gb/s).
\end{itemize}

\section*{3. Core Simulation Settings}
\begin{itemize}
    \item Spatial nodes: up to $1.5 \times 10^{9}$.
    \item Integrator: 15th-order RKN symplectic.
    \item Hamiltonian drift target:
    \[
        \left| \frac{H(t) - H(0)}{H(0)} \right| < 10^{-10}.
    \]
    \item Frame-time target:
    \[
        T_{\text{frame}} \le 16.6 \text{ ms}.
    \]
\end{itemize}

\section*{4. Validation Tasks}

\subsection*{4.1 Numerical Benchmarks}
\begin{itemize}
    \item Run two-body and three-body analytic tests.
    \item Record Hamiltonian drift curves.
    \item Sample condition numbers:
    \[
        \kappa = \|A\| \cdot \|A^{-1}\|.
    \]
\end{itemize}

\subsection*{4.2 Eclipse and Ephemeris Tests}
\begin{itemize}
    \item Simulate historical eclipses (2017-08-21, 2024-04-08).
    \item Compare against NASA GSFC maps.
    \item Validate trajectories against JPL HORIZONS (DE440/DE441).
\end{itemize}

\subsection*{4.3 Flux and Limb-Darkening}
\begin{itemize}
    \item Use Gaia/Kepler limb-darkening coefficients.
    \item Measure radial flux profiles and HDR linearity.
\end{itemize}

\section*{5. Performance and Stress Tests}
\begin{itemize}
    \item Sweep source count: $1 \rightarrow 5 \times 10^{4}$.
    \item Sweep spatial nodes: $10^{6} \rightarrow 1.5 \times 10^{9}$.
    \item Record rays/sec and latency histograms.
    \item Monitor VRAM utilization and BVH traversal depth.
\end{itemize}

\section*{6. Failure-Mode Monitoring}
\begin{itemize}
    \item Condition number trip:
    \[
        \kappa > 10^{12} \Rightarrow \text{BVH fallback}.
    \]
    \item Cone aspect ratio trip:
    \[
        10^{-9} < \left| \frac{R_s - R_o}{l} \right| < 10^{6}.
    \]
    \item Flux gradient trip:
    \[
        \nabla \Phi > 10^{4} \Rightarrow \text{clamp + log}.
    \]
\end{itemize}

\section*{7. Reproducibility}
\begin{itemize}
    \item Lock SHA-256 seeds across MPI ranks.
    \item Archive JSON configuration manifests.
    \item Apply semantic versioning to all runs.
\end{itemize}

