\section{Extended Hamiltonian Dynamics}

\subsection{Classical Hamiltonian Structure}
A Hamiltonian system evolves on a symplectic manifold $(\mathcal{M},\omega)$ according to:
\begin{equation}
\dot{q}_i = \pdv{H}{p_i}, \qquad
\dot{p}_i = -\pdv{H}{q_i},
\end{equation}
with symplectic form:
\begin{equation}
\omega = \sum_i dq_i \wedge dp_i.
\end{equation}

\subsection{Autopoietic Perturbation Terms}
Autopoietic extensions introduce adaptive feedback:
\begin{equation}
\dot{q}_i = \pdv{H}{p_i} + \Phi_i(q,p,t), \qquad
\dot{p}_i = -\pdv{H}{q_i} + \Psi_i(q,p,t),
\end{equation}
where $\Phi_i$ and $\Psi_i$ encode self-modifying dynamical responses.

These terms violate Liouville conservation:
\begin{equation}
\nabla \cdot \mathbf{p} \neq 0,
\end{equation}
enabling metamorphic restructuring of the dynamical manifold.

\subsection{Autopoietic Hamiltonian}
The extended Hamiltonian is:
\begin{equation}
\hat{\mathcal{H}}_{\text{apo}} = \hat{T} + \hat{V} + \hat{\mathcal{A}},
\end{equation}
where $\hat{\mathcal{A}}$ encodes autopoietic feedback and ontological adaptation.

