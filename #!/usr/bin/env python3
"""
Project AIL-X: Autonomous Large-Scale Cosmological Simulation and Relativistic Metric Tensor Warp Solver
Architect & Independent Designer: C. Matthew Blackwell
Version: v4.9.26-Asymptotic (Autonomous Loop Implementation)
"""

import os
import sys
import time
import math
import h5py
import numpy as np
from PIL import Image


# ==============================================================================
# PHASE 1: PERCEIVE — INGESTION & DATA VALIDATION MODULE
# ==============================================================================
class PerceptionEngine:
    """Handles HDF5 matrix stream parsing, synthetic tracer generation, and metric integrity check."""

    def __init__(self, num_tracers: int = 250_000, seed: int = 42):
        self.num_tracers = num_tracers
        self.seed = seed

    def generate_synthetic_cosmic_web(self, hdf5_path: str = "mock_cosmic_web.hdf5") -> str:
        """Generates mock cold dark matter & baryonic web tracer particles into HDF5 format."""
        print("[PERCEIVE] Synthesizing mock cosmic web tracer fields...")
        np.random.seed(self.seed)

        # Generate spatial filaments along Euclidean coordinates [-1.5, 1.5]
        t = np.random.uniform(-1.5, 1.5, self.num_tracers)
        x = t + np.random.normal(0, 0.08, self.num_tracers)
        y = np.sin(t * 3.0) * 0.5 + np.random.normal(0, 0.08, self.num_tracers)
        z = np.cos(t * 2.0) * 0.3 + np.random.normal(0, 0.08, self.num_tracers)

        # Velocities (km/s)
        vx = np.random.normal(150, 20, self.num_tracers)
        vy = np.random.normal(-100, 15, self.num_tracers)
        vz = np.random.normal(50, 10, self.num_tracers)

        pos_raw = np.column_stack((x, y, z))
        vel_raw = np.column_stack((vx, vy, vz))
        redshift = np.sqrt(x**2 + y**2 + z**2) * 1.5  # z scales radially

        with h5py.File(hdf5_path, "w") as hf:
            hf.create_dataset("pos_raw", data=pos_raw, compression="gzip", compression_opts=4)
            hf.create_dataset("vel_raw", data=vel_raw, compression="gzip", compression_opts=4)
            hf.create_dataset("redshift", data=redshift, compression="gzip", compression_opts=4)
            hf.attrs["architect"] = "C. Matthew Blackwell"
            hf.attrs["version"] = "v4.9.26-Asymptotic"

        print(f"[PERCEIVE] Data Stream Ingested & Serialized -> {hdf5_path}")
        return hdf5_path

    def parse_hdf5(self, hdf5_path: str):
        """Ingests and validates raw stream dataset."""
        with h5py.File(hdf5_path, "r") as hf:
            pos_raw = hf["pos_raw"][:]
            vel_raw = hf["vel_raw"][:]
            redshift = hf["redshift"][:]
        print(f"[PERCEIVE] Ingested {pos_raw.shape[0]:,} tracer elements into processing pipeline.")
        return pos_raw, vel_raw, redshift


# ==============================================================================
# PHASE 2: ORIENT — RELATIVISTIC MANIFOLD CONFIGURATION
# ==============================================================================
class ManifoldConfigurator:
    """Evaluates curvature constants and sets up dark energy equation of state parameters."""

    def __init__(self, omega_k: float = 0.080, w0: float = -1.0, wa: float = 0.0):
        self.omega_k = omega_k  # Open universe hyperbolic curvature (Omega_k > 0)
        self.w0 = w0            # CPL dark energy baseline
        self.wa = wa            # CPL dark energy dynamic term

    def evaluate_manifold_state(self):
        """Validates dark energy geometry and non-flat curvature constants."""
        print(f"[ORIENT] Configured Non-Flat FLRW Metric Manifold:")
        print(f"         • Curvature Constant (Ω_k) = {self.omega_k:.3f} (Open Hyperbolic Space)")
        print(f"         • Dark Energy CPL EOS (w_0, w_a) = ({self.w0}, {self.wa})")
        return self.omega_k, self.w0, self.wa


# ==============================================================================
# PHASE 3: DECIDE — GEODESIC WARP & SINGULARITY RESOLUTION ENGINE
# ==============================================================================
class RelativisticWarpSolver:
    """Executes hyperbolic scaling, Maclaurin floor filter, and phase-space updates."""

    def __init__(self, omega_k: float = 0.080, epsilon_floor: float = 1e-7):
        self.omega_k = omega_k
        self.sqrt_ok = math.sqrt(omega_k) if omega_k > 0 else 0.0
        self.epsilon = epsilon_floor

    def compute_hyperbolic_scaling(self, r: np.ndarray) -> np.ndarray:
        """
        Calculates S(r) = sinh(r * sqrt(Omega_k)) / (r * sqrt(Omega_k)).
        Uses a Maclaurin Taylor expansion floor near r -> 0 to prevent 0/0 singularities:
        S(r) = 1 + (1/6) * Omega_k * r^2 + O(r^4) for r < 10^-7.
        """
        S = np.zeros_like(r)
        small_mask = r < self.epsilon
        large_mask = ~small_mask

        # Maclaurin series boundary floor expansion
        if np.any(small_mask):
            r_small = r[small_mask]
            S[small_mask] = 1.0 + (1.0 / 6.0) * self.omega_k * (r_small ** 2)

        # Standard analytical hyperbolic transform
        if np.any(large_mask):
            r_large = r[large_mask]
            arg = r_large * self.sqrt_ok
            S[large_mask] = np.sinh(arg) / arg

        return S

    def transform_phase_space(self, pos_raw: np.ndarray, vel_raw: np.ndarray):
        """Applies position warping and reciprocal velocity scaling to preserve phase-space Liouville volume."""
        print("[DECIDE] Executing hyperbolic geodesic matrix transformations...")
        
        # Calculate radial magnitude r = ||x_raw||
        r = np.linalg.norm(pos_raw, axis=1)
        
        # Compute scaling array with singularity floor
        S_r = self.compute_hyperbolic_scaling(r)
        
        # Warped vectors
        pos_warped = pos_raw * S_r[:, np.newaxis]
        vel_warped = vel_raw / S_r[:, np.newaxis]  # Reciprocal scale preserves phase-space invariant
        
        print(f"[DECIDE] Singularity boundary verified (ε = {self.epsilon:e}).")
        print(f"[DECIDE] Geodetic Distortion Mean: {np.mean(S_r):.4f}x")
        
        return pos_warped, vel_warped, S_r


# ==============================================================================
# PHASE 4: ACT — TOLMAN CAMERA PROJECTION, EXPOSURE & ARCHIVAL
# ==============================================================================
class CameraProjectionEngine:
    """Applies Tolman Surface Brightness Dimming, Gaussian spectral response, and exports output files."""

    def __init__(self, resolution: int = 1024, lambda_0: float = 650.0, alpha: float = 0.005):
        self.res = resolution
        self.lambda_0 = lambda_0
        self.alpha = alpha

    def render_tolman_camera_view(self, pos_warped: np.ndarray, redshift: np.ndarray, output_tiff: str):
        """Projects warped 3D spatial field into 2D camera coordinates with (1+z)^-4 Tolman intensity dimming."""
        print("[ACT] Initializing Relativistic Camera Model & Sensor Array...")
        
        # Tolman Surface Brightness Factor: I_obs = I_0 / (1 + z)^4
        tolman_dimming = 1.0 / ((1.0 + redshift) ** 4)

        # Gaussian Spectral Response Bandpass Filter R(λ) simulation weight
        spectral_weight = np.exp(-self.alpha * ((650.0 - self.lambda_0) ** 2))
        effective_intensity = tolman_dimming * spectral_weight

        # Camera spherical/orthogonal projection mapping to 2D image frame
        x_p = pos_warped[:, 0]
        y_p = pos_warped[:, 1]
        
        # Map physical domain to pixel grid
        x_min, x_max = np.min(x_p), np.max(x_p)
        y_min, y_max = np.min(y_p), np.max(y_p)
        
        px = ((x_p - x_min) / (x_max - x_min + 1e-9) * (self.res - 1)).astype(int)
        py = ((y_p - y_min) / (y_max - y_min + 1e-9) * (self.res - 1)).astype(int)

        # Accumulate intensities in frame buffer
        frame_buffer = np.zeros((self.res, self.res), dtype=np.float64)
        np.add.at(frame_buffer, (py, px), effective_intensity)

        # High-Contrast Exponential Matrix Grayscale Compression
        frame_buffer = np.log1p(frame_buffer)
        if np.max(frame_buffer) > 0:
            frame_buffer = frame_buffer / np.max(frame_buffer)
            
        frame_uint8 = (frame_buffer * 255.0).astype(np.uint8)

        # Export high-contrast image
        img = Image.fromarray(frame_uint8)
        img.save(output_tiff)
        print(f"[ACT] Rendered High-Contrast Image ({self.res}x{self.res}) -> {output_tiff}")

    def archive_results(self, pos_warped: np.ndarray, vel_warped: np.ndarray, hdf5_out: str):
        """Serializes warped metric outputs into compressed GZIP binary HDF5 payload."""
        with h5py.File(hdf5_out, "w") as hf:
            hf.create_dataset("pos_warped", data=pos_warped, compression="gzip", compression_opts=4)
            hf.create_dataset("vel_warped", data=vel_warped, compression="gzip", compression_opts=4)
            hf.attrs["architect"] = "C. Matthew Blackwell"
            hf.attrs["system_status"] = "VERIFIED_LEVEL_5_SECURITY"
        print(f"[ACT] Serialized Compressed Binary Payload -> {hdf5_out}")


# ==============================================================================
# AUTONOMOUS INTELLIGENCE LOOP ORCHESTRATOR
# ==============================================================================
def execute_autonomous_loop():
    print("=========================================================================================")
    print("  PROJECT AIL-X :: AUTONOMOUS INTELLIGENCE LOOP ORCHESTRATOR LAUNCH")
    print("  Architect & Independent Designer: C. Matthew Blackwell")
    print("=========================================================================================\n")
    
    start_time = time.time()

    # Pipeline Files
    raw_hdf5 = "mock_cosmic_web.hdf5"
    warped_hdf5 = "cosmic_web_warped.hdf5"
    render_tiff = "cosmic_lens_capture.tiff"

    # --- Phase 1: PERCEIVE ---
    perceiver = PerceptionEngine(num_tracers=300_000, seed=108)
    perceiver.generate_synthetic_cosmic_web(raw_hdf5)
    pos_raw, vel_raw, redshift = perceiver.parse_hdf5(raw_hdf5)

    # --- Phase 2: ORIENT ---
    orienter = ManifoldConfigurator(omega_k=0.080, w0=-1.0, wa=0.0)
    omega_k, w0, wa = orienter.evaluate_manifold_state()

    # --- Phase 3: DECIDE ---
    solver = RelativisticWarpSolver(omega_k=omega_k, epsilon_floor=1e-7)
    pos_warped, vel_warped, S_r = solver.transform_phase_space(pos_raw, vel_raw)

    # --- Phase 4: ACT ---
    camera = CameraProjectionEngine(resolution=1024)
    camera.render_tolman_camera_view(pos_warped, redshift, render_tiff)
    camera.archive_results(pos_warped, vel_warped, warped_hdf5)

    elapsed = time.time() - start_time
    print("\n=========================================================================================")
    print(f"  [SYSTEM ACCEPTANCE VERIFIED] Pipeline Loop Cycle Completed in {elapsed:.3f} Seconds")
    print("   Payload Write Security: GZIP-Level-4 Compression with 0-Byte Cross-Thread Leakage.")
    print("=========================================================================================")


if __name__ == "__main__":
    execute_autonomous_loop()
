class RelativisticWarpSolver:
    """Executes hyperbolic scaling, Maclaurin floor filter, and phase-space updates."""

    def __init__(self, omega_k: float = 0.080, epsilon_floor: float = 1e-7):
        self.omega_k = omega_k
        self.sqrt_ok = math.sqrt(omega_k) if omega_k > 0 else 0.0
        self.epsilon = epsilon_floor

    def compute_hyperbolic_scaling(self, r: np.ndarray) -> np.ndarray:
        """
        Calculates S(r) = sinh(r * sqrt(Omega_k)) / (r * sqrt(Omega_k)).
        Uses a Maclaurin Taylor expansion floor near r -> 0 to prevent 0/0 singularities:
        S(r) = 1 + (1/6) * Omega_k * r^2 + O(r^4) for r < 10^-7.
        """
        S = np.zeros_like(r)
        small_mask = r < self.epsilon
        large_mask = ~small_mask

        # Maclaurin series boundary floor expansion
        if np.any(small_mask):
            r_small = r[small_mask]
            S[small_mask] = 1.0 + (1.0 / 6.0) * self.omega_k * (r_small ** 2)

        # Standard analytical hyperbolic transform
        if np.any(large_mask):
            r_large = r[large_mask]
            arg = r_large * self.sqrt_ok
            S[large_mask] = np.sinh(arg) / arg

        return S

    def transform_phase_space(self, pos_raw: np.ndarray, vel_raw: np.ndarray):
        """Applies position warping and reciprocal velocity scaling to preserve phase-space Liouville volume."""
        print("[DECIDE] Executing hyperbolic geodesic matrix transformations...")
        
        # Calculate radial magnitude r = ||x_raw||
        r = np.linalg.norm(pos_raw, axis=1)
        
        # Compute scaling array with singularity floor
        S_r = self.compute_hyperbolic_scaling(r)
        
        # Warped vectors
        pos_warped = pos_raw * S_r[:, np.newaxis]
        vel_warped = vel_raw / S_r[:, np.newaxis]  # Reciprocal scale preserves phase-space invariant
        
        print(f"[DECIDE] Singularity boundary verified (ε = {self.epsilon:e}).")
        print(f"[DECIDE] Geodetic Distortion Mean: {np.mean(S_r):.4f}x")
        
        return pos_warped, vel_warped, S_r


