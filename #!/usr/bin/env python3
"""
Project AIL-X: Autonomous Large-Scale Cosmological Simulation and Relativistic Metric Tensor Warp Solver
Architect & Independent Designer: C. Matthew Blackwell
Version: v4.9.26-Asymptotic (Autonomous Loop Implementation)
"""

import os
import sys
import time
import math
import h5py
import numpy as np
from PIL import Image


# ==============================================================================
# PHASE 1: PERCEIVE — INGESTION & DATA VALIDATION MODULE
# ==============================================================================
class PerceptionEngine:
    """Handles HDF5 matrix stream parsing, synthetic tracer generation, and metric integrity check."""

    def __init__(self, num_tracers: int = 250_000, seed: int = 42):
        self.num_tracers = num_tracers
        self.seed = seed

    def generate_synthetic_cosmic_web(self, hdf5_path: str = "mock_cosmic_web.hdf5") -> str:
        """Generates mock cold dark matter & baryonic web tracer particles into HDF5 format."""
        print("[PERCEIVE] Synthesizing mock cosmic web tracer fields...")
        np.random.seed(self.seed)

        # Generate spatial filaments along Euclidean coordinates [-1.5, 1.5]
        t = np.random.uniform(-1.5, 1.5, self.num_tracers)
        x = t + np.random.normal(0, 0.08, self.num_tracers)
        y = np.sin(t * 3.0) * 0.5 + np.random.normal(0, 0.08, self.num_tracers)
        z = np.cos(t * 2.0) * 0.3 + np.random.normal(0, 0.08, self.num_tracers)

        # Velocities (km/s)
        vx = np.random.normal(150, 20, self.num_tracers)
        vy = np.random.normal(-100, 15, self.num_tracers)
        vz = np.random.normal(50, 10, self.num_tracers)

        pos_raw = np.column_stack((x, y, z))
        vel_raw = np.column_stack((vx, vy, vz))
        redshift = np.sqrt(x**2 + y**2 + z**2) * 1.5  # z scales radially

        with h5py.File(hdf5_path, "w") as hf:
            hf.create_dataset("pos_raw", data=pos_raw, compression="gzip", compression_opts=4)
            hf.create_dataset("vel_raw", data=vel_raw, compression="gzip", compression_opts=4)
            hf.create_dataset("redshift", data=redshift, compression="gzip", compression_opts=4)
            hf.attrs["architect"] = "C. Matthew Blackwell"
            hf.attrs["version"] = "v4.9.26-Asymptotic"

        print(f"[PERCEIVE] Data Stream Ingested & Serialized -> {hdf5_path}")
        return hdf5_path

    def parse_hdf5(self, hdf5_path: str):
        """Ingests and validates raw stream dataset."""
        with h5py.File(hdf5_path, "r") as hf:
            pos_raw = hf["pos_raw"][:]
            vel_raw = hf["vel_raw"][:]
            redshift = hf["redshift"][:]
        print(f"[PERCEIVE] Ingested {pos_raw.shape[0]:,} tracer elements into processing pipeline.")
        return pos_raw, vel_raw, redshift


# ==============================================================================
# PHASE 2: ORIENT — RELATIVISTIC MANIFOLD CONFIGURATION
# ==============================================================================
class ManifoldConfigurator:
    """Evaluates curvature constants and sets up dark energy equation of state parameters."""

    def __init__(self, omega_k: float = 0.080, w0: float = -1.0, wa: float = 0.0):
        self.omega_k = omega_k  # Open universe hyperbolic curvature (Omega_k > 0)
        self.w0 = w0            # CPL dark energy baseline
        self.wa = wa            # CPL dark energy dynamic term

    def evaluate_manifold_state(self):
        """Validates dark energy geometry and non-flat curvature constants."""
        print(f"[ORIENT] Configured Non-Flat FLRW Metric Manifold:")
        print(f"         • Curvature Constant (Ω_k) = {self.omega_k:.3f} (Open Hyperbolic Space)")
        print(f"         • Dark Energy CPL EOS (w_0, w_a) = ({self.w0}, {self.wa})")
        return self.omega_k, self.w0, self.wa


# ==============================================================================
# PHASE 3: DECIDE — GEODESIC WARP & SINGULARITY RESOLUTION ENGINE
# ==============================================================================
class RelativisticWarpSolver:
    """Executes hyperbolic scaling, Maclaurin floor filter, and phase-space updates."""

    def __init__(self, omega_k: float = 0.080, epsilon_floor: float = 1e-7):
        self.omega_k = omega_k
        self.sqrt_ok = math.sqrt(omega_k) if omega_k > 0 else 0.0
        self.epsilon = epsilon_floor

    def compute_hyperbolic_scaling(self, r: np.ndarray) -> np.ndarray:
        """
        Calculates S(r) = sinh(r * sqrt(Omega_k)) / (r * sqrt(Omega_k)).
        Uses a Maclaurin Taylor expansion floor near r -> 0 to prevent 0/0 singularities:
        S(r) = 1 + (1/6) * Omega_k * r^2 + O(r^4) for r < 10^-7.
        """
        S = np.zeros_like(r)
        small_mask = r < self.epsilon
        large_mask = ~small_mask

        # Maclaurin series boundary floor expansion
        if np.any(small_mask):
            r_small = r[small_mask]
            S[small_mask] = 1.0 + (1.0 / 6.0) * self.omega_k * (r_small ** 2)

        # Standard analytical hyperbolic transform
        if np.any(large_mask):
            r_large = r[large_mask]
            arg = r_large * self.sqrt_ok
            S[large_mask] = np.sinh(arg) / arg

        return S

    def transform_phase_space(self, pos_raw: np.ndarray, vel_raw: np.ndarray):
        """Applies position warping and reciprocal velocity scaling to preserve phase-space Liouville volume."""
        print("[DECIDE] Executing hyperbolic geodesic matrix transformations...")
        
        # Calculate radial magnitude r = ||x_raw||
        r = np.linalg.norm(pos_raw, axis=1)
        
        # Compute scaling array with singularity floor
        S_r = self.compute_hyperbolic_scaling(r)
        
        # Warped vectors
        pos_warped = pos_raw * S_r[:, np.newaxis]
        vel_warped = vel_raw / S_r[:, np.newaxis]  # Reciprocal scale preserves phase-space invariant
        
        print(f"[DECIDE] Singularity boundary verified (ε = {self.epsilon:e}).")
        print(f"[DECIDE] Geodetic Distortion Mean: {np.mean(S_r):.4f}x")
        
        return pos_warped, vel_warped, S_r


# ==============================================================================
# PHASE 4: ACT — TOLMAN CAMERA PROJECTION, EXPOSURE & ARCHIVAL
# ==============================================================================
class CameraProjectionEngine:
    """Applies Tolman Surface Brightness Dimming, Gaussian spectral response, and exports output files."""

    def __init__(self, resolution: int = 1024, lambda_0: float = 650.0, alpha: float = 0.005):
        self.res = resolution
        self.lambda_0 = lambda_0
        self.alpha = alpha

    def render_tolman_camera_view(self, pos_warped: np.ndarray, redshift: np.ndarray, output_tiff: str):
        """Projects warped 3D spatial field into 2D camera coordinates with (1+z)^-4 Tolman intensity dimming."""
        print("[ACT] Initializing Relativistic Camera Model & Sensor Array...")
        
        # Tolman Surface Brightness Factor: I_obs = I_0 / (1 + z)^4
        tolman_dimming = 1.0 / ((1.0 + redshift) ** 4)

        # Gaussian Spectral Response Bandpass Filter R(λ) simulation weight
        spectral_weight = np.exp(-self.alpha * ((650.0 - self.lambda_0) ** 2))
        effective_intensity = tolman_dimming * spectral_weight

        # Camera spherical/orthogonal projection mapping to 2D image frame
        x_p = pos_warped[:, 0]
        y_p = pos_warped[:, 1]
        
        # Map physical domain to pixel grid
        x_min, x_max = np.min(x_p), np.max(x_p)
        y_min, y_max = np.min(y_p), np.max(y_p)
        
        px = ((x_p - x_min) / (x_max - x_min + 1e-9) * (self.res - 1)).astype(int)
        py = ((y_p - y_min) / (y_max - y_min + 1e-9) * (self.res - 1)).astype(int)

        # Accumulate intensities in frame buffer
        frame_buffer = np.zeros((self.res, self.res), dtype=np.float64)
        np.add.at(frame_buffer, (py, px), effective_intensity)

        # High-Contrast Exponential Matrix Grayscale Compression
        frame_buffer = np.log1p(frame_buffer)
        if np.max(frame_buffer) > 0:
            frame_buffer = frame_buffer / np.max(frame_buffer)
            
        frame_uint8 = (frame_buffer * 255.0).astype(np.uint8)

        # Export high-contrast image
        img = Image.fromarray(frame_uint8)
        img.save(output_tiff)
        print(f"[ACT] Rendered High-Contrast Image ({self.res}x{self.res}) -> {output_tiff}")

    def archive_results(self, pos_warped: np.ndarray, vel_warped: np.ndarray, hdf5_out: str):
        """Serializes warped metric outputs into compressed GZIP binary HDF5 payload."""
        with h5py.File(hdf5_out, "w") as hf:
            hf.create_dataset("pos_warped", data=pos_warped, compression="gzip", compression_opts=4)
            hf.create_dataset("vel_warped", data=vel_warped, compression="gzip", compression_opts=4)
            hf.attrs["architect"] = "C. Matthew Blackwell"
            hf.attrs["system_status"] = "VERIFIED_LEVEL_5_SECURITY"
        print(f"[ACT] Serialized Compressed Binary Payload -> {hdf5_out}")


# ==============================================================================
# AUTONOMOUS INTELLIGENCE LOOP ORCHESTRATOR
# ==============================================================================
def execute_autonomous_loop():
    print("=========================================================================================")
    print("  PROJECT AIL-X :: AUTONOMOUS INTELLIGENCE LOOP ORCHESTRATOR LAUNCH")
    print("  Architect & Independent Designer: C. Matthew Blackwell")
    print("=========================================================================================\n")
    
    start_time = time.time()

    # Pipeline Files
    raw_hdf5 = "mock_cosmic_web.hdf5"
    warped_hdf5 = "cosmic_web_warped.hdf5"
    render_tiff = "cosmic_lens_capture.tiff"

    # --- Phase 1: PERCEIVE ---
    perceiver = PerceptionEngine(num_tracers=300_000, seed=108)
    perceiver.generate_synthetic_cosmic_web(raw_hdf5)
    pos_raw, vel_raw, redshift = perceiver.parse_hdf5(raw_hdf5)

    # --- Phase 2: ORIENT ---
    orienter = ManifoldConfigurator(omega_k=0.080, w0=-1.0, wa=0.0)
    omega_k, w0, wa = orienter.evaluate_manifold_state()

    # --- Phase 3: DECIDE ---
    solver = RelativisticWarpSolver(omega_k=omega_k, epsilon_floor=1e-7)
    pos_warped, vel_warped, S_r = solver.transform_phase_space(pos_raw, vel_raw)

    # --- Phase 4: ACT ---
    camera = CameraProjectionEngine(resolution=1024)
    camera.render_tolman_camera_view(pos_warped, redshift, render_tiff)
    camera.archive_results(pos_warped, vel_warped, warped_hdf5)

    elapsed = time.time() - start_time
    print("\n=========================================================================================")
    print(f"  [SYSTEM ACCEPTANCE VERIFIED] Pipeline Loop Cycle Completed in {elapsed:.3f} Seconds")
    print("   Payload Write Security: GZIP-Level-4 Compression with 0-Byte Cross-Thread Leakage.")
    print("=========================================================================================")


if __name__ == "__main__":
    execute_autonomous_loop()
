class CameraProjectionEngine:
    """Applies Tolman Surface Brightness Dimming, Gaussian spectral response, and exports output files."""

    def __init__(self, resolution: int = 1024, lambda_0: float = 650.0, alpha: float = 0.005):
        self.res = resolution
        self.lambda_0 = lambda_0
        self.alpha = alpha

    def render_tolman_camera_view(self, pos_warped: np.ndarray, redshift: np.ndarray, output_tiff: str):
        """Projects warped 3D spatial field into 2D camera coordinates with (1+z)^-4 Tolman intensity dimming."""
        print("[ACT] Initializing Relativistic Camera Model & Sensor Array...")
        
        # Tolman Surface Brightness Factor: I_obs = I_0 / (1 + z)^4
        tolman_dimming = 1.0 / ((1.0 + redshift) ** 4)

        # Gaussian Spectral Response Bandpass Filter R(λ) simulation weight
        spectral_weight = np.exp(-self.alpha * ((650.0 - self.lambda_0) ** 2))
        effective_intensity = tolman_dimming * spectral_weight

        # Camera spherical/orthogonal projection mapping to 2D image frame
        x_p = pos_warped[:, 0]
        y_p = pos_warped[:, 1]
        
        # Map physical domain to pixel grid
        x_min, x_max = np.min(x_p), np.max(x_p)
        y_min, y_max = np.min(y_p), np.max(y_p)
        
        px = ((x_p - x_min) / (x_max - x_min + 1e-9) * (self.res - 1)).astype(int)
        py = ((y_p - y_min) / (y_max - y_min + 1e-9) * (self.res - 1)).astype(int)

        # Accumulate intensities in frame buffer
        frame_buffer = np.zeros((self.res, self.res), dtype=np.float64)
        np.add.at(frame_buffer, (py, px), effective_intensity)

        # High-Contrast Exponential Matrix Grayscale Compression
        frame_buffer = np.log1p(frame_buffer)
        if np.max(frame_buffer) > 0:
            frame_buffer = frame_buffer / np.max(frame_buffer)
            
        frame_uint8 = (frame_buffer * 255.0).astype(np.uint8)

        # Export high-contrast image
        img = Image.fromarray(frame_uint8)
        img.save(output_tiff)
        print(f"[ACT] Rendered High-Contrast Image ({self.res}x{self.res}) -> {output_tiff}")

    def archive_results(self, pos_warped: np.ndarray, vel_warped: np.ndarray, hdf5_out: str):
        """Serializes warped metric outputs into compressed GZIP binary HDF5 payload."""
        with h5py.File(hdf5_out, "w") as hf:
