import numpy as np
import matplotlib.pyplot as plt

def plot_tolman_decay():
    z = np.linspace(0.0, 4.0, 500)
    
    # Tolman Intensity Law (1+z)^-4
    I_tolman = 1.0 / ((1.0 + z) ** 4)
    
    # Standard Euclidean Constant Intensity (no redshift surface dimming)
    I_euclidean = np.ones_like(z)

    plt.figure(figsize=(10, 6), dpi=120)
    plt.plot(z, I_tolman, color='#00E5FF', linewidth=2.5, label=r'Tolman Relativistic Dimming $I(z) \propto (1+z)^{-4}$')
    plt.plot(z, I_euclidean, color='#FF5252', linestyle='--', linewidth=1.5, label='Flat Euclidean Baseline (Unwarped)')

    plt.title('Project AIL-X: Relativistic Tolman Surface Brightness Dispersion Curve', fontsize=12, fontweight='bold')
    plt.xlabel('Lookback Redshift (z)', fontsize=11)
    plt.ylabel('Observed Relative Surface Brightness Intensity I_obs', fontsize=11)
    plt.yscale('log')
    plt.grid(True, which="both", ls="--", alpha=0.4)
    plt.legend(loc='upper right', frameon=True)
    
    plt.text(2.0, 1e-2, 'Architect: C. Matthew Blackwell\nSystem: AIL-X-v4.9.26', 
             bbox=dict(facecolor='black', alpha=0.7, edgecolor='#00E5FF'))

    output_plot = "tolman_dimming_profile.png"
    plt.savefig(output_plot, bbox_inches='tight')
    print(f"[DIAGNOSTIC] Generated Tolman Intensity Decay Profile Plot -> {output_plot}")

if __name__ == "__main__":
    plot_tolman_decay()
