import cupy as cp
class WENOSolver5:
    @staticmethod
    def reconstruct_axis_flux(f: cp.ndarray, axis: int) -> cp.ndarray:
        eps = 1e-6
        fm2 = cp.roll(f, 2, axis=axis); fm1 = cp.roll(f, 1, axis=axis); f0 = cp.roll(f, 0, axis=axis)
        fp1 = cp.roll(f, -1, axis=axis); fp2 = cp.roll(f, -2, axis=axis)
        v0 = (2.0 * fm2 - 7.0 * fm1 + 11.0 * f0) / 6.0
        v1 = (-1.0 * fm1 + 5.0 * f0 + 2.0 * fp1) / 6.0
        v2 = (2.0 * f0 + 5.0 * fp1 - 1.0 * fp2) / 6.0
        beta0 = (13.0/12.0)*(fm2 - 2.0*fm1 + f0)**2 + 0.25*(fm2 - 4.0*fm1 + 3.0*f0)**2
        beta1 = (13.0/12.0)*(fm1 - 2.0*f0 + fp1)**2 + 0.25*(fm1 - fp1)**2
        beta2 = (13.0/12.0)*(f0 - 2.0*fp1 + fp2)**2 + 0.25*(3.0*f0 - 4.0*fp1 + fp2)**2
        alpha0 = 0.1 / (eps + beta0)**2; alpha1 = 0.6 / (eps + beta1)**2; alpha2 = 0.3 / (eps + beta2)**2
        sum_a = alpha0 + alpha1 + alpha2
        return (alpha0/sum_a)*v0 + (alpha1/sum_a)*v1 + (alpha2/sum_a)*v2
EOF

