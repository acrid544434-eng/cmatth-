import cupy as cp
class TVDRK3Integrator:
    def __init__(self, config, state_shape: tuple):
        self.config = config
        self.U1 = cp.zeros(state_shape, dtype=cp.float32)
        self.U2 = cp.zeros(state_shape, dtype=cp.float32)
    def step_in_place(self, U: cp.ndarray, rhs_func, *args) -> cp.ndarray:
        dt = self.config.dt
        L = rhs_func(U, *args); cp.multiply(L, dt, out=self.U1); self.U1 += U
        L = rhs_func(self.U1, *args); cp.multiply(L, 0.25 * dt, out=self.U2); self.U2 += 0.75 * U; self.U2 += 0.25 * self.U1
        L = rhs_func(self.U2, *args); cp.multiply(L, (2.0/3.0)*dt, out=self.U1); self.U1 += (1.0/3.0)*U; self.U1 += (2.0/3.0)*self.U2
        return self.U1
EOF

