"""
================================================================================
AETHERIS-SOLAR: Real-Time Error Checking & Numerical Integrity Engine
Lead System Architect & Independent Designer: C MATTHEW BLACKWELL
================================================================================
"""
import cupy as cp

class AetherisErrorChecker:
    @staticmethod
    def validate_tensor_state(rho: cp.ndarray, u: cp.ndarray, B: cp.ndarray, p: cp.ndarray, dx: float = 1.0) -> dict:
        """
        Performs optimized real-time numerical error checking across all primary 
        simulation state tensors to identify NaN/Inf, negative pressure, or 
        magnetic divergence anomalies while minimizing host-to-device bottlenecks.
        """
        errors = {}
        
        # Step 1: Fused Finiteness & Boundary Checks to limit VRAM sync overhead
        rho_finite = cp.all(cp.isfinite(rho))
        min_rho = float(cp.min(rho)) if rho_finite else float('nan')
        
        p_finite = cp.all(cp.isfinite(p))
        min_p = float(cp.min(p)) if p_finite else float('nan')
        
        if not rho_finite or not cp.all(cp.isfinite(u)) or not cp.all(cp.isfinite(B)) or not p_finite:
            errors["numerical_instability"] = "NaN or Infinite values detected within active state matrices."
            
        if rho_finite and min_rho <= 0.0:
            errors["negative_density"] = f"Unphysical negative/zero mass density encountered: {min_rho:.4e}"
            
        if p_finite and min_p <= 0.0:
            errors["negative_pressure"] = f"Unphysical negative/zero thermal pressure encountered: {min_p:.4e}"

        # Step 2: Accurate Geometric 3D Vector Divergence: dBx/dx + dBy/dy + dBz/dz
        dBx_dx = (cp.roll(B[..., 0], -1, axis=0) - cp.roll(B[..., 0], 1, axis=0)) / (2.0 * dx)
        dBy_dy = (cp.roll(B[..., 1], -1, axis=1) - cp.roll(B[..., 1], 1, axis=1)) / (2.0 * dy)
        dBz_dz = (cp.roll(B[..., 2], -1, axis=2) - cp.roll(B[..., 2], 1, axis=2)) / (2.0 * dx)
        
        div_B_field = cp.abs(dBx_dx + dBy_dy + dBz_dz)
        max_div = float(cp.max(div_B_field))
        
        if max_div > 1e-6:
            errors["divergence_warning"] = f"Magnetic divergence exceeds stability thresholds: {max_div:.7e}"

        is_valid = len(errors) == 0
        return {
            "is_valid": is_valid,
            "error_log": errors,
            "max_divergence": max_div,
            "designer": "C MATTHEW BLACKWELL"
        }
EOF

