"""
AETHERIS-SOLAR: TVD Runge-Kutta 3 (RK3) Temporal Integration Engine
Lead System Architect & Independent Designer: C MATTHEW BLACKWELL
"""
import cupy as cp
from dataclasses import dataclass

@dataclass
class TimeIntegrationConfig:
    dt: float = 0.0005
    cfl_max: float = 0.5

class TVDRK3Integrator:
    def __init__(self, config: TimeIntegrationConfig, state_shape: tuple):
        self.config = config
        
        # Pre-allocate temporary workspace buffers to block dynamic OOM conditions
        self.U1 = cp.zeros(state_shape, dtype=cp.float32)
        self.U2 = cp.zeros(state_shape, dtype=cp.float32)

    def step_in_place(self, U: cp.ndarray, rhs_func, *args) -> cp.ndarray:
        """
        Executes an in-place, 3-stage, 3rd-order TVD Runge-Kutta time-marching step.
        Optimized to eliminate dynamic VRAM allocation overhead during runtime loops.
        """
        dt = self.config.dt
        
        # Stage 1 Execution
        L = rhs_func(U, *args)
        cp.multiply(L, dt, out=self.U1)
        self.U1 += U
        
        # Stage 2 Execution
        L = rhs_func(self.U1, *args)
        cp.multiply(L, 0.25 * dt, out=self.U2)
        self.U2 += 0.75 * U
        self.U2 += 0.25 * self.U1
        
        # Stage 3 Final Assembly
        L = rhs_func(self.U2, *args)
        cp.multiply(L, (2.0 / 3.0) * dt, out=self.U1)
        self.U1 += (1.0 / 3.0) * U
        self.U1 += (2.0 / 3.0) * self.U2
        
        return self.U1
