import numpy as np

def laplacian_3d(field):
    """
    Simple 3D Laplacian with periodic or zero-padding boundaries (your choice).
    field: (..., Nx, Ny, Nz, C) or (Nx, Ny, Nz, C)
    """
    f = field
    lap = (
        -6 * f
        + np.roll(f, 1, axis=0) + np.roll(f, -1, axis=0)
        + np.roll(f, 1, axis=1) + np.roll(f, -1, axis=1)
        + np.roll(f, 1, axis=2) + np.roll(f, -1, axis=2)
    )
    return lap
`

