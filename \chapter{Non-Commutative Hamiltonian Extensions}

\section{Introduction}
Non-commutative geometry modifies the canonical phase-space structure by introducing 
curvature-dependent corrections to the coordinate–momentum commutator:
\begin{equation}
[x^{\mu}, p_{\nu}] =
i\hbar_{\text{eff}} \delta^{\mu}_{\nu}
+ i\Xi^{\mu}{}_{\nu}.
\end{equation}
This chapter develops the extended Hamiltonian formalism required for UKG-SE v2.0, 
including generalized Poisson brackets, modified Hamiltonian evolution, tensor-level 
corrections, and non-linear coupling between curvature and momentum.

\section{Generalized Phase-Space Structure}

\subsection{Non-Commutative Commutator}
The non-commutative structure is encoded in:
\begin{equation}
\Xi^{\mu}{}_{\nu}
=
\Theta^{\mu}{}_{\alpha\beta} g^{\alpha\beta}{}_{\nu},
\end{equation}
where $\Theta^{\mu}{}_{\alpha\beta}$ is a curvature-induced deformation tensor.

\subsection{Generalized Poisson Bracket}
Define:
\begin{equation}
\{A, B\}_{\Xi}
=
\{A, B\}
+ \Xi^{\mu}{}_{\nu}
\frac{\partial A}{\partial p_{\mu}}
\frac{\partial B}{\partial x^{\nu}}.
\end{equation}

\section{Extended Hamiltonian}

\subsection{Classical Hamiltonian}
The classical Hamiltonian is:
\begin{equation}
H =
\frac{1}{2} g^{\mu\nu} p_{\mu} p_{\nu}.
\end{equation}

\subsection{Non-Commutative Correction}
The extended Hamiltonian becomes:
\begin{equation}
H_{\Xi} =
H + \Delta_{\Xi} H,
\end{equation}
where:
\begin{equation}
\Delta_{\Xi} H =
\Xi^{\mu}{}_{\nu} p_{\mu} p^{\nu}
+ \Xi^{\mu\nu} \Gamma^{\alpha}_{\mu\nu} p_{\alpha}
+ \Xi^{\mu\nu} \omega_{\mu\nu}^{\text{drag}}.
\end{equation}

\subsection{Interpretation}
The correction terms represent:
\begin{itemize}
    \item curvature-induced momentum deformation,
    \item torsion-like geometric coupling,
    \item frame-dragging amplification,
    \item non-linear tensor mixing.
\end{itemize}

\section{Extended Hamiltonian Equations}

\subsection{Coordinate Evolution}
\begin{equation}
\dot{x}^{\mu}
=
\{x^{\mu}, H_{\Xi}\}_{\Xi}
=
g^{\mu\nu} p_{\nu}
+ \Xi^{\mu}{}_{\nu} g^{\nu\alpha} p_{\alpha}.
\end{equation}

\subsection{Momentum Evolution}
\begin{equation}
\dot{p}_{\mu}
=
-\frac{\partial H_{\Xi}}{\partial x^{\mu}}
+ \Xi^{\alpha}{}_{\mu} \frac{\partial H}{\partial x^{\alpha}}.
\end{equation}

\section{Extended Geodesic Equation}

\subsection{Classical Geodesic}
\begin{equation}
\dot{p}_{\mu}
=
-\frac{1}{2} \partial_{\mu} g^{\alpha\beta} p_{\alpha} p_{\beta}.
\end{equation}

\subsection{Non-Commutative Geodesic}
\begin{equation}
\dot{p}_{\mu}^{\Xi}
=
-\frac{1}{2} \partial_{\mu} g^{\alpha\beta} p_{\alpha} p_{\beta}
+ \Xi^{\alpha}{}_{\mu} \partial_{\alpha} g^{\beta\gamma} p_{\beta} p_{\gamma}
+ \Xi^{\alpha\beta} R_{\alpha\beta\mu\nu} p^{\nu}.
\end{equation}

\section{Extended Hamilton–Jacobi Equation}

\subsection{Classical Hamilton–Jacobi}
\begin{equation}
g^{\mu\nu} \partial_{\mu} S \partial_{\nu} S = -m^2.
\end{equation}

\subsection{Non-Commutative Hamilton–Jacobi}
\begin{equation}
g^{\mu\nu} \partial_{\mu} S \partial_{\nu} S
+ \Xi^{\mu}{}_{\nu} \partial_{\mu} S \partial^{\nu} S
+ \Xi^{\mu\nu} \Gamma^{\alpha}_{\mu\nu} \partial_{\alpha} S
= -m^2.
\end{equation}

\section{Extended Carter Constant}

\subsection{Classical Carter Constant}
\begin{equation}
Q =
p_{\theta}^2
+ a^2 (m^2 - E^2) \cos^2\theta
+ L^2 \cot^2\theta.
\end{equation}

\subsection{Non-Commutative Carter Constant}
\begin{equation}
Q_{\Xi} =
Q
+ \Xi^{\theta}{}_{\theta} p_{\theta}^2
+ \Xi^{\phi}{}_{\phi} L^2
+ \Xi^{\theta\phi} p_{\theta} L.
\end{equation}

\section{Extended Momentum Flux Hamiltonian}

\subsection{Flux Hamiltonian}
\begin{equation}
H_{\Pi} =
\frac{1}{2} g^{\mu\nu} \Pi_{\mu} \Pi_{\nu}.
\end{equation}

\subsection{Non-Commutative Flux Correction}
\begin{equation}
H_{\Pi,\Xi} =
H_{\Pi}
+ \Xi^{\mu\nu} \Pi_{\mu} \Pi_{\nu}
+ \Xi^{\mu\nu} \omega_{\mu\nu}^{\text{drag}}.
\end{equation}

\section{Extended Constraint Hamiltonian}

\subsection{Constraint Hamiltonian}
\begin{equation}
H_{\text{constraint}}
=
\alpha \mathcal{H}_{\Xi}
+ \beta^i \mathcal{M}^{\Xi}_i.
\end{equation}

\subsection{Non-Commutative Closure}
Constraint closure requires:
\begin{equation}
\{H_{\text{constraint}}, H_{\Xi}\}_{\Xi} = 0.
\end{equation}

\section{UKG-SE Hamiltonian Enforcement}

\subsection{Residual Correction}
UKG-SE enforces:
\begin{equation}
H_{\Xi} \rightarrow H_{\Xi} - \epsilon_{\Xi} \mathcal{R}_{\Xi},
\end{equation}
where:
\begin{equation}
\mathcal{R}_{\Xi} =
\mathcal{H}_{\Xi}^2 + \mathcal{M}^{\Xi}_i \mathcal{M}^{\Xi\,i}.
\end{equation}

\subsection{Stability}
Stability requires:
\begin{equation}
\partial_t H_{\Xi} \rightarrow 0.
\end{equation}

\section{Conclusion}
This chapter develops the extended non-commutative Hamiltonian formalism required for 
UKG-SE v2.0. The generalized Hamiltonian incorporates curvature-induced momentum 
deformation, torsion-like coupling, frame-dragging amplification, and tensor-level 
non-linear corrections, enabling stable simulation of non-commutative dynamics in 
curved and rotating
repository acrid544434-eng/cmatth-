\section{Extended Constraint Hamiltonian}

\subsection{Constraint Hamiltonian}
\begin{equation}
H_{\text{constraint}}
=
\alpha \mathcal{H}_{\Xi}
+ \beta^i \mathcal{M}^{\Xi}_i.
\end{equation}

\subsection{Non-Commutative Closure}
Constraint closure requires:
\begin{equation}
\{H_{\text{constraint}}, H_{\Xi}\}_{\Xi} = 0.
\end{equation}

\section{UKG-SE Hamiltonian Enforcement}

\subsection{Residual Correction}
UKG-SE enforces:
\begin{equation}
H_{\Xi} \rightarrow H_{\Xi} - \epsilon_{\Xi} \mathcal{R}_{\Xi},
\end{equation}
where:
\begin{equation}
\mathcal{R}_{\Xi} =
\mathcal{H}_{\Xi}^2 + \mathcal{M}^{\Xi}_i \mathcal{M}^{\Xi\,i}.
\end{equation}

\subsection{Stability}
Stability requires:
\begin{equation}
\partial_t H_{\Xi} \rightarrow 0.
\end{equation}

