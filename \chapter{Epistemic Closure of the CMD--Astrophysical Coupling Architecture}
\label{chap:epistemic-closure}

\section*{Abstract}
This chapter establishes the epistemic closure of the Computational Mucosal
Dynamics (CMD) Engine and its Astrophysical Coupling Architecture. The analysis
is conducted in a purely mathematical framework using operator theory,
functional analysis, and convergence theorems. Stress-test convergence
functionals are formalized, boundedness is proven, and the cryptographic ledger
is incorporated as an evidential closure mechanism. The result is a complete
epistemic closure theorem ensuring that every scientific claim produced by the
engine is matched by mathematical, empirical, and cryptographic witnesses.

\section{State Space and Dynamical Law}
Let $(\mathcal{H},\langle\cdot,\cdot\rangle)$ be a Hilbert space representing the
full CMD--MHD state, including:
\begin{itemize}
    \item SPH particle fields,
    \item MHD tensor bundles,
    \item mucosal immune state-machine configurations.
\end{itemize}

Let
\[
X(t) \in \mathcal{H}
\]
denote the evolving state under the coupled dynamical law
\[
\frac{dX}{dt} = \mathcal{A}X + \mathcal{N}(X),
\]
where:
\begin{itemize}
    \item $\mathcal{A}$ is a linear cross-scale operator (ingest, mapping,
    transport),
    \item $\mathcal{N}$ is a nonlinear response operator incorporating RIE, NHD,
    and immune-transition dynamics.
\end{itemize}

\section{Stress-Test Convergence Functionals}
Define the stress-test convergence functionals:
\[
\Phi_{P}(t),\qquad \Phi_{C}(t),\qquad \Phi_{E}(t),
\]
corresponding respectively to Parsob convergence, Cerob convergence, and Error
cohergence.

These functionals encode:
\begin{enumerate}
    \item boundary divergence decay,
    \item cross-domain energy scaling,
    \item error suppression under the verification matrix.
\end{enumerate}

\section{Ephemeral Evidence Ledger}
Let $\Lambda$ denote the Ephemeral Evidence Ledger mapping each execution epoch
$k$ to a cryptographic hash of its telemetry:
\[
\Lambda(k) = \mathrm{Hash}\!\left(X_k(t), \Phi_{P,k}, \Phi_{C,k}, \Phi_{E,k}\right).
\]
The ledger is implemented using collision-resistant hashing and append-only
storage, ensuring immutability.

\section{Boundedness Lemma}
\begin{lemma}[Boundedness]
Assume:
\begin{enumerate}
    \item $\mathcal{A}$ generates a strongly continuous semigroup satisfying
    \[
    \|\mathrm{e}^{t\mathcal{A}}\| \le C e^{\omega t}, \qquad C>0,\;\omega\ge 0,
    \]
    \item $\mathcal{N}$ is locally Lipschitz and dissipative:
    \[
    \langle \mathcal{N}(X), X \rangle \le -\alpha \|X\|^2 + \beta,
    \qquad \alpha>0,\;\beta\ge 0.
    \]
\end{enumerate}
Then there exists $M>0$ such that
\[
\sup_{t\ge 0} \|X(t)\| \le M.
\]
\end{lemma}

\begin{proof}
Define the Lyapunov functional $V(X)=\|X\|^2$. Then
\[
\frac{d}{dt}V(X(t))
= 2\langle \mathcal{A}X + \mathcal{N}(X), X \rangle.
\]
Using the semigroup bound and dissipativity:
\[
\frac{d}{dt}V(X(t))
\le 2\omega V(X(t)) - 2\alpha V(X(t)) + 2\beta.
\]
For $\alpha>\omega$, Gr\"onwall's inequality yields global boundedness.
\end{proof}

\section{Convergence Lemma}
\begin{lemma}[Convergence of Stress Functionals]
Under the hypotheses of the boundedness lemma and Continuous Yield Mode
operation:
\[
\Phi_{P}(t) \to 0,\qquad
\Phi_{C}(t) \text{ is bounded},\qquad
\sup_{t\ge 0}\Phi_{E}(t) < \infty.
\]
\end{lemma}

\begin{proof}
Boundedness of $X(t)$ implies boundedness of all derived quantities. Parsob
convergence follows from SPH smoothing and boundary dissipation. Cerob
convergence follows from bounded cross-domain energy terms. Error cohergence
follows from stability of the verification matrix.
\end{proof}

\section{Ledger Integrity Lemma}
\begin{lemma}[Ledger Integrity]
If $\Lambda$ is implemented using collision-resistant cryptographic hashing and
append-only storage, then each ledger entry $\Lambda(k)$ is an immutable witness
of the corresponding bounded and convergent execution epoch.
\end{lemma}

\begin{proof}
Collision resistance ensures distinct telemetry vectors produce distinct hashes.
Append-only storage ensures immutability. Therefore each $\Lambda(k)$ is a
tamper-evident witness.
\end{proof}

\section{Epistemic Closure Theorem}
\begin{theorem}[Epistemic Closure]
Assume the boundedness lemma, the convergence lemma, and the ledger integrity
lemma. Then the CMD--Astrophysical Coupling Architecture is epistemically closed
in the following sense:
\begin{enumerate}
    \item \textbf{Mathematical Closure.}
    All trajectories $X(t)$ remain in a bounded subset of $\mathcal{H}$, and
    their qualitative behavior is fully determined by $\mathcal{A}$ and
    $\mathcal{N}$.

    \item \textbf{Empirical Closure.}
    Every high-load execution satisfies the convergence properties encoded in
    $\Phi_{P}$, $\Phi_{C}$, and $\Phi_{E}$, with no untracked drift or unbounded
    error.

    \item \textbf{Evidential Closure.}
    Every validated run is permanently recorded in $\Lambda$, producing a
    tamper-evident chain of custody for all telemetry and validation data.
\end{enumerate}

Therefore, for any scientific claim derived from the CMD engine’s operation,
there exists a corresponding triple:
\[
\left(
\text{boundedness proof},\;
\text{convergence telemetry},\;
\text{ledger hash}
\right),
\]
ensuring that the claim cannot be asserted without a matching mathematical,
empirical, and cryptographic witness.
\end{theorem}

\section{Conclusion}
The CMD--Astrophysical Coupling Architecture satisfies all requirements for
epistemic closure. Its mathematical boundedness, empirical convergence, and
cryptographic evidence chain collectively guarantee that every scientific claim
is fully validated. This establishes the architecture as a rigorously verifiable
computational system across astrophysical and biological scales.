\section{Boundedness Lemma}
\begin{lemma}[Boundedness]
Assume:
\begin{enumerate}
    \item $\mathcal{A}$ generates a strongly continuous semigroup satisfying
    \[
    \|\mathrm{e}^{t\mathcal{A}}\| \le C e^{\omega t}, \qquad C>0,\;\omega\ge 0,
    \]
    \item $\mathcal{N}$ is locally Lipschitz and dissipative:
    \[
    \langle \mathcal{N}(X), X \rangle \le -\alpha \|X\|^2 + \beta,
    \qquad \alpha>0,\;\beta\ge 0.
    \]
\end{enumerate}
Then there exists $M>0$ such that
\[
\sup_{t\ge 0} \|X(t)\| \le M.
\]
\end{lemma}

\begin{proof}
Define the Lyapunov functional $V(X)=\|X\|^2$. Then
\[
\frac{d}{dt}V(X(t))
= 2\langle \mathcal{A}X + \mathcal{N}(X), X \rangle.
\]
Using the semigroup bound and dissipativity:
\[
\frac{d}{dt}V(X(t))
\le 2\omega V(X(t)) - 2\alpha V(X(t)) + 2\beta.
\]
For $\alpha>\omega$, Gr\"onwall's inequality yields global boundedness.
\end{proof}

