\subsection*{1. Propulsion Core State Vector}

Define the propulsion state vector
\[
\mathbf{X}_{\text{prop}} =
\begin{bmatrix}
\omega_{\text{prop}} \\
P_{\text{boost}} \\
T_{\text{exhaust}} \\
\dot{m}_{\text{fuel}} \\
L_{\text{aero}}
\end{bmatrix},
\]
with:
\[
\omega_{\text{prop}} = \text{propeller angular velocity},\quad
P_{\text{boost}} = \text{supercharger boost pressure},
\]
\[
T_{\text{exhaust}} = \text{thermal exhaust load},\quad
\dot{m}_{\text{fuel}} = \text{fuel mass flow rate}.
\]

Propulsion dynamics:
\[
\frac{d\omega_{\text{prop}}}{dt}
=
\frac{dL_{\text{aero}}}{L_{\text{aero}}},
\]
\[
\frac{d(\omega_{\text{prop}} P_{\text{boost}})}{dt}
=
\Phi_{\text{MK22}}(\mathbf{X}_{\text{prop}}).
\]

\subsection*{2. Torque Margin Operator}

Define torque margin
\[
\tau_{\text{margin}} =
\tau_{\max} - \tau_{\text{load}},
\]
with suprakernel constraint
\[
\tau_{\min} \leq \tau_{\text{load}} \leq \tau_{\max}.
\]

Torque evolution:
\[
\frac{d\tau_{\text{load}}}{dt}
=
\Gamma_{\text{MK22}}(\omega_{\text{prop}}, P_{\text{boost}}, L_{\text{aero}}).
\]

\subsection*{3. Aerodynamic Control Surface Operator}

Define control surface state
\[
\mathbf{X}_{\text{ctrl}} =
\begin{bmatrix}
A_{\text{rudder}} \\
A_{\text{elevator}} \\
A_{\text{tail}}
\end{bmatrix},
\]
with aerodynamic load relations:
\[
L_{\text{aero,MK22}} = 
E\,\frac{d\omega_{e}}{dt},
\]
\[
L_{\text{aero,MK22}} =
A_{z} + \frac{\pi}{2} R_{\text{aero}}.
\]

Control authority constraint:
\[
\text{CM}_{\text{MK22}} \geq \text{CM}_{\min}.
\]

\subsection*{4. Aeroelastic Stability Gradient}

Define aeroelastic state
\[
\mathbf{X}_{\text{AE}} =
\begin{bmatrix}
\mathbf{q}_{\text{struct}} \\
\dot{\mathbf{q}}_{\text{struct}} \\
L_{\text{aero}} \\
\omega_{\text{prop}}
\end{bmatrix}.
\]

Stability gradient:
\[
G_{\text{AE}} =
\alpha_{1}\,\lambda_{\min}(\mathbf{K}_{\text{eff}})
-
\alpha_{2}\,\lambda_{\max}(\mathbf{C}_{\text{eff}})
-
\alpha_{3}\,\lambda_{\max}(\mathbf{A}_{\text{dyn}}).
\]

Stability margin:
\[
\text{SM}_{\text{AE}} = G_{\text{AE}} - G_{\text{crit}},
\quad
\text{SM}_{\text{AE}} \geq \text{SM}_{\text{AE,min}}.
\]

\subsection*{5. Aerospace Constraint Envelope}

The MK‑22 constraint envelope is
\[
\mathcal{C}_{\text{MK22}} =
\mathcal{C}_{\text{flight}}
\wedge
\mathcal{C}_{\text{struct}}
\wedge
\mathcal{C}_{\text{thermal}}
\wedge
\mathcal{C}_{\text{ctrl}}
\wedge
\mathcal{C}_{\text{enc}}
\wedge
\mathcal{C}_{\text{ledger}}.
\]

Flight constraints:
\[
V \leq V_{\max},\quad
M \leq M_{\max},\quad
n_{\text{load}} \leq n_{\text{load,max}}.
\]

Structural constraints:
\[
\sigma_{i} \leq \sigma_{i,\max},\quad
\epsilon_{i} \leq \epsilon_{i,\max}.
\]

Thermal constraints:
\[
T_{j} \leq T_{j,\max},\quad
q_{j} \leq q_{j,\max}.
\]

Control constraints:
\[
\|\mathbf{u}_{\text{ctrl}}\| \leq U_{\max}.
\]

Encryption constraints:
\[
S_{\text{enc}} \geq S_{\text{enc,min}}.
\]

Ledger constraints:
\[
\mathcal{I}_{\text{ledger}}(\ell) = \text{true}.
\]

