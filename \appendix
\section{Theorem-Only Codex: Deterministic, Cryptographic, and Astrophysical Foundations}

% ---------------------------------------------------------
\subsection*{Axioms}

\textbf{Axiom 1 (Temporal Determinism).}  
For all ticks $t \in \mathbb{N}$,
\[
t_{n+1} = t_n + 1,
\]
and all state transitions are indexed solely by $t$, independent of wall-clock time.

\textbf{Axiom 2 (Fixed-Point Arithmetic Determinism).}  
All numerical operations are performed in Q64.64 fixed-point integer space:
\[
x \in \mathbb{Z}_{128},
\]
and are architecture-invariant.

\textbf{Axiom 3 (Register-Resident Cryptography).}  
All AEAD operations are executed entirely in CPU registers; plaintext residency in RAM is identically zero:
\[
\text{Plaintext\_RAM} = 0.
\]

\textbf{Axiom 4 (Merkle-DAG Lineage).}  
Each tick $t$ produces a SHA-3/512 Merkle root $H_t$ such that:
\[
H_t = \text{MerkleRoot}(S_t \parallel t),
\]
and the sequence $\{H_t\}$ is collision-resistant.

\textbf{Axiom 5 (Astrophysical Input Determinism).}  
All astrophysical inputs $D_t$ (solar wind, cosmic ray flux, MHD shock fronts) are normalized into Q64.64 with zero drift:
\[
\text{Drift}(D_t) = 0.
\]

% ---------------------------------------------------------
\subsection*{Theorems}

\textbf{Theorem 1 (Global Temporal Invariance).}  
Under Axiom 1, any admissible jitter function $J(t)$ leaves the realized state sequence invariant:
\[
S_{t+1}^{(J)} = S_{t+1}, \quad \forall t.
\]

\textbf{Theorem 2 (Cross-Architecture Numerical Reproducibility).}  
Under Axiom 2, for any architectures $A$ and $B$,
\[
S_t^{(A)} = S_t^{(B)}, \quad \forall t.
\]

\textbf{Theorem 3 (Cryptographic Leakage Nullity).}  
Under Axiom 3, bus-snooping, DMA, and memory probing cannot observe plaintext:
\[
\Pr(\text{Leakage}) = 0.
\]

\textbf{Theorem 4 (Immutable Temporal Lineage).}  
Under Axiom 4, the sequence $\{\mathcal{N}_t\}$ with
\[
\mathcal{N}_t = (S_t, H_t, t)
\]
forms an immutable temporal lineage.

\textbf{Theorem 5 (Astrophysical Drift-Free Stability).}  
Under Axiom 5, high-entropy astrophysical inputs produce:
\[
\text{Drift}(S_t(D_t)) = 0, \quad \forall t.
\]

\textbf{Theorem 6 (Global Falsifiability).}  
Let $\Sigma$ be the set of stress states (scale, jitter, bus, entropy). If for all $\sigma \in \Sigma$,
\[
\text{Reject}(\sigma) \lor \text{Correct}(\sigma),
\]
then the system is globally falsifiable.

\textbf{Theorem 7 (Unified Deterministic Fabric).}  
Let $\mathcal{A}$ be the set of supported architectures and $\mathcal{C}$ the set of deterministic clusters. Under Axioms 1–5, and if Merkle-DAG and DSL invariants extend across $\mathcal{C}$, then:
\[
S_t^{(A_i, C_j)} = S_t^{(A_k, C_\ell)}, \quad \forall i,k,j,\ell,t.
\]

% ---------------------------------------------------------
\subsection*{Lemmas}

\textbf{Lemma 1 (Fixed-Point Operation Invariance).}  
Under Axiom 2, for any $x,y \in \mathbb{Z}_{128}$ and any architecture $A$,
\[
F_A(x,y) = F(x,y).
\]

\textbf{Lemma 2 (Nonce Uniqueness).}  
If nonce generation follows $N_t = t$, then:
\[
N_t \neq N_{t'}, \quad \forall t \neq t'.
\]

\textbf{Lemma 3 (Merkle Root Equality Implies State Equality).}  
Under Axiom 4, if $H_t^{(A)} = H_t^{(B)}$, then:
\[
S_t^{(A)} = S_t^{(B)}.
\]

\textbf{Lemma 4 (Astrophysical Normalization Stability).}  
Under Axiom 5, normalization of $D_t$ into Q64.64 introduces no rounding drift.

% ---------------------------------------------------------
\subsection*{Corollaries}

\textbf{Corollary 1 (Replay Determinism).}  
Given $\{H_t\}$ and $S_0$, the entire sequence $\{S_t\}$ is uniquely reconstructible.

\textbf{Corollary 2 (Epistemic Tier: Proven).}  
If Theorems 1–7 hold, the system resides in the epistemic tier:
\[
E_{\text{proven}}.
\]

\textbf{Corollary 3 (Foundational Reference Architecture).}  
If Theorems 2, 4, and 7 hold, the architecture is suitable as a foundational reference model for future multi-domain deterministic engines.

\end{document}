\subsection*{Lemmas}

\textbf{Lemma 1 (Fixed-Point Operation Invariance).}  
Under Axiom 2, for any $x,y \in \mathbb{Z}_{128}$ and any architecture $A$,
\[
F_A(x,y) = F(x,y).
\]

\textbf{Lemma 2 (Nonce Uniqueness).}  
If nonce generation follows $N_t = t$, then:
\[
N_t \neq N_{t'}, \quad \forall t \neq t'.
\]

\textbf{Lemma 3 (Merkle Root Equality Implies State Equality).}  
Under Axiom 4, if $H_t^{(A)} = H_t^{(B)}$, then:
\[
S_t^{(A)} = S_t^{(B)}.
\]

\textbf{Lemma 4 (Astrophysical Normalization Stability).}  
Under Axiom 5, normalization of $D_t$ into Q64.64 introduces no rounding drift.

