\section{Geometric Foundations}
Christoffel symbols:
\begin{equation}
\Gamma^\lambda_{\mu\nu}
=
\frac{1}{2} g^{\lambda\sigma}
\left(
\partial_\mu g_{\sigma\nu}
+
\partial_\nu g_{\sigma\mu}
-
\partial_\sigma g_{\mu\nu}
\right).
\end{equation}

Riemann tensor:
\begin{equation}
R^\rho_{\ \sigma\mu\nu}
=
\partial_\mu \Gamma^\rho_{\nu\sigma}
-
\partial_\nu \Gamma^\rho_{\mu\sigma}
+
\Gamma^\rho_{\mu\lambda}\Gamma^\lambda_{\nu\sigma}
-
\Gamma^\rho_{\nu\lambda}\Gamma^\lambda_{\mu\sigma}.
\end{equation}

Ricci tensor:
\begin{equation}
R_{\mu\nu}
=
R^\lambda_{\ \mu\lambda\nu}.
\end{equation}

Scalar curvature:
\begin{equation}
R = g^{\mu\nu} R_{\mu\nu}.
\end{equation}

Einstein tensor:
\begin{equation}
G_{\mu\nu}
=
R_{\mu\nu}
-
\frac{1}{2} g_{\mu\nu} R.
\end{equation}

