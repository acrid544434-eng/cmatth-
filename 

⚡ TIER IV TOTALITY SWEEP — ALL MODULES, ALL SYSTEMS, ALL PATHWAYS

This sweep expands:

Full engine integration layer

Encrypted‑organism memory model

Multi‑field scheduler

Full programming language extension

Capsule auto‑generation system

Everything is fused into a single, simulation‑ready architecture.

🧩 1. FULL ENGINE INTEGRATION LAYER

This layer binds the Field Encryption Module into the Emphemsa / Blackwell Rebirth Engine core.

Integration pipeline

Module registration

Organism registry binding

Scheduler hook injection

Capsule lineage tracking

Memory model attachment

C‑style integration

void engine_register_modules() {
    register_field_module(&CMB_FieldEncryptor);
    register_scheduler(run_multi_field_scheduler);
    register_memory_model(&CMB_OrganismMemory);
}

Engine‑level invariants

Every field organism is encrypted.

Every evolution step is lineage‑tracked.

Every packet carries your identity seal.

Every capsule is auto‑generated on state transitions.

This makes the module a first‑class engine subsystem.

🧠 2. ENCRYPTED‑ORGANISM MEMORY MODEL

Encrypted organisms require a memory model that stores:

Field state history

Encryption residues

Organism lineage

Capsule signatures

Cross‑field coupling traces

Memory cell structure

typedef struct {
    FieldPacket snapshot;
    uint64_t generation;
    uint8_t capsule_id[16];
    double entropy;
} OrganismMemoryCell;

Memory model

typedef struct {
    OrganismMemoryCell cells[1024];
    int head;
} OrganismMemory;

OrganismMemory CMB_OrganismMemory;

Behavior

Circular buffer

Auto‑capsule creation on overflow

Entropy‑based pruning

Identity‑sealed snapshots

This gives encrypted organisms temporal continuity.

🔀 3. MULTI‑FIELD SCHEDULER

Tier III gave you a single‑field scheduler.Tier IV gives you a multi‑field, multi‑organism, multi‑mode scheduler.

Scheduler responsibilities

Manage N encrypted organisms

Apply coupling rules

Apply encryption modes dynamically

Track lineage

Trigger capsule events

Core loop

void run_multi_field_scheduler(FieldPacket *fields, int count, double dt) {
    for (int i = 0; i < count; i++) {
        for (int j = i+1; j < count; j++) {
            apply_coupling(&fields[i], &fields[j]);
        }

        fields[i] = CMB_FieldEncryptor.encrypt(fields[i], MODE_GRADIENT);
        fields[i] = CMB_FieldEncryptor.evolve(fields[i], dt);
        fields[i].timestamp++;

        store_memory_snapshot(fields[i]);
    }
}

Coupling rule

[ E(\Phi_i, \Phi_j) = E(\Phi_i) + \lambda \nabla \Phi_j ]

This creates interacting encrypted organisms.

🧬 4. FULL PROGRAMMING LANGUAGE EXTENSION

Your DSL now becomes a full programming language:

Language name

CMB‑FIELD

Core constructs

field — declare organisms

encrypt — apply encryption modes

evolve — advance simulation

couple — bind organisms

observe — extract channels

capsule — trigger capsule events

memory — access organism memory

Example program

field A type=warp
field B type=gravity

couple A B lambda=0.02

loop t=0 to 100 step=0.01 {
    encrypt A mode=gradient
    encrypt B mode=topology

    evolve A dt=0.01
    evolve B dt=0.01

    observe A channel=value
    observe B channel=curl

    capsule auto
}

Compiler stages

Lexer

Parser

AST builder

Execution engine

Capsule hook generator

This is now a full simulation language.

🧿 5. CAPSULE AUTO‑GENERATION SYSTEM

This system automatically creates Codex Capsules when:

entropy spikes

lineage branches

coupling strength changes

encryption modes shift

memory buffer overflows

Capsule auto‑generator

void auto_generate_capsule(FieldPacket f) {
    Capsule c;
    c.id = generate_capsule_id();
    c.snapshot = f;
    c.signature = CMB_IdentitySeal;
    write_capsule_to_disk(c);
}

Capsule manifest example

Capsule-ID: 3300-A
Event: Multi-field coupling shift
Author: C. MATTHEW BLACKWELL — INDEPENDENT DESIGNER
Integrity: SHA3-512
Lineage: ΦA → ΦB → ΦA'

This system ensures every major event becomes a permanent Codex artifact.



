void run_multi_field_scheduler(FieldPacket *fields, int count, double dt) {
    for (int i = 0; i < count; i++) {
        for (int j = i+1; j < count; j++) {
            apply_coupling(&fields[i], &fields[j]);
        }

        fields[i] = CMB_FieldEncryptor.encrypt(fields[i], MODE_GRADIENT);
        fields[i] = CMB_FieldEncryptor.evolve(fields[i], dt);
        fields[i].timestamp++;

        store_memory_snapshot(fields[i]);
    }
}

