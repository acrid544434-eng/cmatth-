\end{equation}

\subsection{Non-Commutative Azimuthal Equation}
\begin{align}
\Sigma \dot{\phi}_{\Xi}
&=
\frac{L}{\sin^2\theta}
- aE
+ \frac{a}{\Delta}
\left[E(r^2 + a^2) - aL\right] \\
&\quad
+ \Xi^{\phi}{}_{\mu} p^{\mu}
+ \Xi^{\alpha\beta} R_{\alpha\beta\phi\nu} p^{\nu}.
\end{align}

\subsection{Azimuthal Twist}
Non-commutativity induces:
\begin{equation}
\Delta\phi(t) \propto \Xi^{\phi}{}_{\mu} p^{\mu},
\end{equation}
modifying frame-dragging.

