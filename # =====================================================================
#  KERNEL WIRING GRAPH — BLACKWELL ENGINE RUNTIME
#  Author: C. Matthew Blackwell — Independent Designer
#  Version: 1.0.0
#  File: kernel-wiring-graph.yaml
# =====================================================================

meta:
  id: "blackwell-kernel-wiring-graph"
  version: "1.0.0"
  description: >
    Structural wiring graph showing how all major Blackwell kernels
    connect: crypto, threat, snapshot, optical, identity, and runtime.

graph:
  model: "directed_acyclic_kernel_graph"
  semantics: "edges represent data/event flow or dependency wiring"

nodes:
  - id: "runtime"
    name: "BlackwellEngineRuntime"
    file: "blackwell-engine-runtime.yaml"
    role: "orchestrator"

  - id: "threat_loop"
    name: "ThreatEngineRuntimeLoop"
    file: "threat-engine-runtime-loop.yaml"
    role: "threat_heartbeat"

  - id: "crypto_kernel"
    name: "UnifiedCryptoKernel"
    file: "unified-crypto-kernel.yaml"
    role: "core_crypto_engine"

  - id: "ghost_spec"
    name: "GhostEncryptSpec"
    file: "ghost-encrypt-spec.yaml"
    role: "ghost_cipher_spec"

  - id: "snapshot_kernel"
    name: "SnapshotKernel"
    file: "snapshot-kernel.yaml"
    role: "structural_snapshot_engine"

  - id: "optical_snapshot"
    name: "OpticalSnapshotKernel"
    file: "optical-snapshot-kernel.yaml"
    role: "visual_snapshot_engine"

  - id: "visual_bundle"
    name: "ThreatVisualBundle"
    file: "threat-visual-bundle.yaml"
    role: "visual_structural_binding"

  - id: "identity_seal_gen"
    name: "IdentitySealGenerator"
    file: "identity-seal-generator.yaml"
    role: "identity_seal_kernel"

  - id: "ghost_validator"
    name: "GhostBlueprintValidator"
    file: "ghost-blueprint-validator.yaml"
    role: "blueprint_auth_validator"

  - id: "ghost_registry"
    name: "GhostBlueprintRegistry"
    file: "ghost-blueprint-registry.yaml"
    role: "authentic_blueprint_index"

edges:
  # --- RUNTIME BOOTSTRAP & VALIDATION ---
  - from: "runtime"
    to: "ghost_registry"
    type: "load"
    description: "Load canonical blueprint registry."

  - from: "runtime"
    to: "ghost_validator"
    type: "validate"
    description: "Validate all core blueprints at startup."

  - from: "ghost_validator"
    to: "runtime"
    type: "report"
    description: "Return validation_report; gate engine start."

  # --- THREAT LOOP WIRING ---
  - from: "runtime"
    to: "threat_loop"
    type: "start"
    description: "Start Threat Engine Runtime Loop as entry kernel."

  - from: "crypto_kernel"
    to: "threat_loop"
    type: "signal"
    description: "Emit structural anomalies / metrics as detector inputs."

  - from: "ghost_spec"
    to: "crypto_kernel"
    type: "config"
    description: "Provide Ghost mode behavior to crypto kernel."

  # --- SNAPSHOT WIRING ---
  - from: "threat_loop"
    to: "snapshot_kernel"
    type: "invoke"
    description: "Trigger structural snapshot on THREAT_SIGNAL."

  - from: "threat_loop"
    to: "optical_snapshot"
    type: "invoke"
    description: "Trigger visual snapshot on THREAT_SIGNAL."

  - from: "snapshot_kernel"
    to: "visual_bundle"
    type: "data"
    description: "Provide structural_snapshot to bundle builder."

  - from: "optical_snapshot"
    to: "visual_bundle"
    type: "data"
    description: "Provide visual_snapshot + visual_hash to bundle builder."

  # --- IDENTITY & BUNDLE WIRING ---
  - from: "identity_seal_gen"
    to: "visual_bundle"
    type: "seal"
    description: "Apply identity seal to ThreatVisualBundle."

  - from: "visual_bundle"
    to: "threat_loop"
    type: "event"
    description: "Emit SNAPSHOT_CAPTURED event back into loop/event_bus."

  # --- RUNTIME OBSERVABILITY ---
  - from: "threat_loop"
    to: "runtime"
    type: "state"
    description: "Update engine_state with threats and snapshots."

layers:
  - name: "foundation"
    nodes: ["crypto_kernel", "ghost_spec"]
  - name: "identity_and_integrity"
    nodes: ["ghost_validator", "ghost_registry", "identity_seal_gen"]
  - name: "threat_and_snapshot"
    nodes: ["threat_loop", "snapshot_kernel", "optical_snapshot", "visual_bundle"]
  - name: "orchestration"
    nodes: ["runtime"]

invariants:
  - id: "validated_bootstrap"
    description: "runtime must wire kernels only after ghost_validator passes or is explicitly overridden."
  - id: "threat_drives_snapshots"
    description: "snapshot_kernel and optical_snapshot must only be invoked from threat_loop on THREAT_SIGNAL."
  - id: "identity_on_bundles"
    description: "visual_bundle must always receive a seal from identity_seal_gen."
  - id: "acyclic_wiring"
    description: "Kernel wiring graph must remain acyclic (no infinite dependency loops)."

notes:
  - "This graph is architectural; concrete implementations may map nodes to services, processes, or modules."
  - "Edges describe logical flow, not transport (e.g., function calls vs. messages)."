meta:
  id: "blackwell-kernel-wiring-graph"
  version: "1.0.0"
  description: >
    Structural wiring graph showing how all major Blackwell kernels
    connect: crypto, threat, snapshot, optical, identity, and runtime.

graph:
  model: "directed_acyclic_kernel_graph"
  semantics: "edges represent data/event flow or dependency wiring"

nodes:
  - id: "runtime"
    name: "BlackwellEngineRuntime"
    file: "blackwell-engine-runtime.yaml"
    role: "orchestrator"

  - id: "threat_loop"
    name: "ThreatEngineRuntimeLoop"
    file: "threat-engine-runtime-loop.yaml"
    role: "threat_heartbeat"

  - id: "crypto_kernel"
    name: "UnifiedCryptoKernel"
    file: "unified-crypto-kernel.yaml"
    role: "core_crypto_engine"

  - id: "ghost_spec"
    name: "GhostEncryptSpec"
    file: "ghost-encrypt-spec.yaml"
    role: "ghost_cipher_spec"

  - id: "snapshot_kernel"
    name: "SnapshotKernel"
    file: "snapshot-kernel.yaml"
    role: "structural_snapshot_engine"

  - id: "optical_snapshot"
    name: "OpticalSnapshotKernel"
    file: "optical-snapshot-kernel.yaml"
    role: "visual_snapshot_engine"

  - id: "visual_bundle"
    name: "ThreatVisualBundle"
    file: "threat-visual-bundle.yaml"
    role: "visual_structural_binding"

  - id: "identity_seal_gen"
    name: "IdentitySealGenerator"
    file: "identity-seal-generator.yaml"
    role: "identity_seal_kernel"

  - id: "ghost_validator"
    name: "GhostBlueprintValidator"
    file: "ghost-blueprint-validator.yaml"
    role: "blueprint_auth_validator"

  - id: "ghost_registry"
    name: "GhostBlueprintRegistry"
    file: "ghost-blueprint-registry.yaml"
    role: "authentic_blueprint_index"

edges:
  # --- RUNTIME BOOTSTRAP & VALIDATION ---
  - from: "runtime"
    to: "ghost_registry"
    type: "load"
    description: "Load canonical blueprint registry."

  - from: "runtime"
    to: "ghost_validator"
    type: "validate"
    description: "Validate all core blueprints at startup."

  - from: "ghost_validator"
    to: "runtime"
    type: "report"
    description: "Return validation_report; gate engine start."

  # --- THREAT LOOP WIRING ---
  - from: "runtime"
    to: "threat_loop"
    type: "start"
    description: "Start Threat Engine Runtime Loop as entry kernel."

  - from: "crypto_kernel"
    to: "threat_loop"
    type: "signal"
    description: "Emit structural anomalies / metrics as detector inputs."

  - from: "ghost_spec"
    to: "crypto_kernel"
    type: "config"
    description: "Provide Ghost mode behavior to crypto kernel."

  # --- SNAPSHOT WIRING ---
  - from: "threat_loop"
    to: "snapshot_kernel"
    type: "invoke"
    description: "Trigger structural snapshot on THREAT_SIGNAL."

  - from: "threat_loop"
    to: "optical_snapshot"
    type: "invoke"
    description: "Trigger visual snapshot on THREAT_SIGNAL."

  - from: "snapshot_kernel"
    to: "visual_bundle"
    type: "data"
    description: "Provide structural_snapshot to bundle builder."

  - from: "optical_snapshot"
    to: "visual_bundle"
    type: "data"
    description: "Provide visual_snapshot + visual_hash to bundle builder."

  # --- IDENTITY & BUNDLE WIRING ---
  - from: "identity_seal_gen"
    to: "visual_bundle"
    type: "seal"
    description: "Apply identity seal to ThreatVisualBundle."

  - from: "visual_bundle"
    to: "threat_loop"
    type: "event"
    description: "Emit SNAPSHOT_CAPTURED event back into loop/event_bus."

  # --- RUNTIME OBSERVABILITY ---
  - from: "threat_loop"
    to: "runtime"
    type: "state"
    description: "Update engine_state with threats and snapshots."

layers:
  - name: "foundation"
    nodes: ["crypto_kernel", "ghost_spec"]
  - name: "identity_and_integrity"
    nodes: ["ghost_validator", "ghost_registry", "identity_seal_gen"]
  - name: "threat_and_snapshot"
    nodes: ["threat_loop", "snapshot_kernel", "optical_snapshot", "visual_bundle"]
  - name: "orchestration"
    nodes: ["runtime"]

invariants:
  - id: "validated_bootstrap"
    description: "runtime must wire kernels only after ghost_validator passes or is explicitly overridden."
  - id: "threat_drives_snapshots"
    description: "snapshot_kernel and optical_snapshot must only be invoked from threat_loop on THREAT_SIGNAL."
  - id: "identity_on_bundles"
    description: "visual_bundle must always receive a seal from identity_seal_gen."
  - id: "acyclic_wiring"
    description: "Kernel wiring graph must remain acyclic (no infinite dependency loops)."

notes:
  - "This graph is architectural; concrete implementations may map nodes to services, processes, or modules."
  - "Edges describe logical flow, not transport (e.g., function calls vs. messages)."