\section{Stress Vector Injection}

\subsection{Stress Vector Definition}
\[
S_1 = (\mathcal{C}_1=\text{Telemetry Flood},\;
\mathcal{M}_1=100\times X_{\text{nominal}},\;
\Sigma_1=\text{Ingestion Pipeline})
\]

\subsection{Stress Application}
Inject $100\times$ nominal telemetry load into:
\[
X(t) \rightarrow X'(t) = 100X(t).
\]

Expected subsystem behavior:
\begin{itemize}
    \item Throughput $\approx 482.1\,\text{TB/s}$,
    \item Fragmentation $\leq 1.2\%$,
    \item Packet loss $=0.00\%$.
\end{itemize}

