\section{Experimental Procedures}

\subsection{Procedure 1: Nominal Operation}
\begin{enumerate}
    \item Initialize telemetry streams.
    \item Activate Fourier and Poisson filters.
    \item Verify throughput $\geq 4.8\,\text{TB/s}$.
    \item Confirm $X_{\text{clean}}$ stability.
\end{enumerate}

\subsection{Procedure 2: Stress Operation}
\begin{enumerate}
    \item Inject stress vector $S_1$.
    \item Monitor throughput and fragmentation.
    \item Validate zero packet loss.
\end{enumerate}

\subsection{Procedure 3: Recovery}
\begin{enumerate}
    \item Reduce telemetry load to nominal.
    \item Confirm operator norm returns to baseline.
    \item Verify $X_{\text{clean}}$ consistency.
\end{enumerate}

