\section{Hydrodynamic \& MHD Action Integrals}
The Eulerian action integral is
\[
S = \int dt \int_{\Omega} \mathcal{L}(\rho, \mathbf{v}, \mathbf{B}, \Phi, s)\, d^3x,
\]
with ideal MHD Lagrangian density
\[
\mathcal{L} = \rho\left(\frac{1}{2}|\mathbf{v}|^2 - e(\rho,s) - \Phi\right)
- \frac{|\mathbf{B}|^2}{2\mu_0}.
\]

\section{Non-Canonical Hamiltonian Structure}
Define canonical momentum $\mathbf{p}=\rho\mathbf{v}$ and state vector
\[
\mathbf{w} = (\rho, \mathbf{p}, \mathbf{B}, s)^T.
\]
The Hamiltonian is
\[
H = \int_\Omega \left[
\frac{|\mathbf{p}|^2}{2\rho} + \rho e(\rho,s)
+ \frac{|\mathbf{B}|^2}{2\mu_0} + \rho\Phi
\right] d^3x.
\]

\section{Casimir Invariants}
\[
M = \int \rho\, d^3x,\qquad
K = \int \mathbf{A}\cdot\mathbf{B}\, d^3x,\qquad
H_c = \int \mathbf{v}\cdot\mathbf{B}\, d^3x.
\]

\section{Cosmological Coordinates}
Comoving formulation uses Hubble drag terms
\[
H(a) = H_0\sqrt{\Omega_m a^{-3} + \Omega_\Lambda}.
\]

