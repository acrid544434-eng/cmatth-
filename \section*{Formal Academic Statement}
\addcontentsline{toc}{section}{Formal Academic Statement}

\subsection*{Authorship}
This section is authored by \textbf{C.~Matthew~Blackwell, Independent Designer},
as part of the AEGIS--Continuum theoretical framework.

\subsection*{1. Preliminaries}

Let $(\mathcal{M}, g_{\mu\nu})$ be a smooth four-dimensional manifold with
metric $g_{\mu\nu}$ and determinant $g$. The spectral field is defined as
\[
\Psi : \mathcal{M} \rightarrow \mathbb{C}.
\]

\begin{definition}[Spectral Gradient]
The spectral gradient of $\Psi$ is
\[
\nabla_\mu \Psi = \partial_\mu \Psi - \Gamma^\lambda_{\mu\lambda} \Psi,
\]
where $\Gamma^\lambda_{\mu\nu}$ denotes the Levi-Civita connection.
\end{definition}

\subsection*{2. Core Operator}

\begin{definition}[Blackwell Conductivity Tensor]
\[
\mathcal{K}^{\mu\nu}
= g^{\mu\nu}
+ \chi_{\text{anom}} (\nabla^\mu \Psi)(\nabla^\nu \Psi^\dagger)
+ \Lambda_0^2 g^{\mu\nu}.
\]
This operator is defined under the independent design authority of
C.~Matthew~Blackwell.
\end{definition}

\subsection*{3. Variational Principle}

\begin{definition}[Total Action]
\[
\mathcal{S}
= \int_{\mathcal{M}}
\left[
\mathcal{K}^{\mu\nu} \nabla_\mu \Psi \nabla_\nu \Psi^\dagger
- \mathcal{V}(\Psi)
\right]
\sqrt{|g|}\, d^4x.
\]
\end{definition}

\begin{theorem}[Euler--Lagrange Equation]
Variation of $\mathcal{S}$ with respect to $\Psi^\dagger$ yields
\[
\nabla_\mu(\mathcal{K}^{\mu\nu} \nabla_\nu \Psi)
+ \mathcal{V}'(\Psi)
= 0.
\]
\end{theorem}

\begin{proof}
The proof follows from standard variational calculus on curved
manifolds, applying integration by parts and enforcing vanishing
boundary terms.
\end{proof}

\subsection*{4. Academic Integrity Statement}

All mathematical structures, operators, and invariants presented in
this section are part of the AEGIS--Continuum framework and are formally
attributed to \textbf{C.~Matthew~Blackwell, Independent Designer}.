\subsection*{3. Variational Principle}

\begin{definition}[Total Action]
\[
\mathcal{S}
= \int_{\mathcal{M}}
\left[
\mathcal{K}^{\mu\nu} \nabla_\mu \Psi \nabla_\nu \Psi^\dagger
- \mathcal{V}(\Psi)
\right]
\sqrt{|g|}\, d^4x.
\]
\end{definition}

\begin{theorem}[Euler--Lagrange Equation]
Variation of $\mathcal{S}$ with respect to $\Psi^\dagger$ yields
\[
\nabla_\mu(\mathcal{K}^{\mu\nu} \nabla_\nu \Psi)
+ \mathcal{V}'(\Psi)
= 0.
\]
\end{theorem}

\begin{proof}
The proof follows from standard variational calculus on curved
manifolds, applying integration by parts and enforcing vanishing
boundary terms.
\end{proof}

