\section{Hamiltonian and Symplectic Confinement Formalism}
\noindent
Charged particle dynamics in the ARC cusp field are governed by the
relativistic Hamiltonian:
\[
H(q,p) = \sqrt{m^{2}c^{4} + c^{2}\left(p - qA\right)^{2}} + q\phi.
\]

\begin{theorem}[Symplectic Volume Preservation]
For divergence-free magnetic fields satisfying $\nabla\cdot\mathbf{B}=0$,
the phase-space volume element
\[
\Omega = d^{3}q \wedge d^{3}p
\]
is preserved under Hamiltonian flow.
\end{theorem}

\begin{proof}
Liouville's theorem states that Hamiltonian evolution preserves the
symplectic form. Since cusp fields satisfy $\nabla\cdot\mathbf{B}=0$,
the canonical transformation generated by $H$ is volume-preserving.
Thus particle loss across magnetic mirrors is prevented.
\end{proof}

\section{Safety Formalism}
\noindent
Define the critical leakage flux threshold $\epsilon_{\text{crit}}$ governed
by He-3 cooling shunt capacity.

\begin{definition}[Bounded Storage]
A CASS subsystem is bounded if its leakage flux satisfies
\[
\epsilon < \epsilon_{\text{crit}}.
\]
\end{definition}

\begin{theorem}[Triple-Tier Quench Containment]
Let the containment system consist of:
\begin{enumerate}
    \item a primary $9\ \text{T}$ superconducting Penning--Malmberg trap,
    \item secondary $4\ \text{K}$ He-3 cryogenic shielding,
    \item tertiary Passive Annihilation Dump (PAD) of pyrolytic graphite and WC.
\end{enumerate}
Then any emergency quench results in non-destructive, spherically bounded
thermal dissipation.
\end{theorem}

\begin{proof}
The primary trap prevents wall contact; the secondary cryogenic layer
absorbs thermal perturbations; the PAD dissipates rest-mass energy through
high-thermal-capacity absorbers. The combined system ensures bounded
dissipation.
\end{proof}

