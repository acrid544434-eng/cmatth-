\subsection{Lyapunov Stability}
\begin{equation}
L(p) = \frac{1}{2}\|p - p^*\|^2 + U(p) +
\frac{1}{2}\gamma(t)\max(0,-J(p))^2.
\end{equation}

\subsection{Control Barrier Function}
\begin{equation}
\dot{h}(p) + \gamma_{\text{CBF}} h(p) \ge 0.
\end{equation}

