\section{Couplings and Effective 4D Lagrangian}

We derive the effective four-dimensional Lagrangian obtained from
the STME-RS-A framework. The anharmonic bulk potential modifies the KK
wavefunctions and therefore the couplings of KK modes to SM fields.

\subsection{KK Reduction of the Action}

The five-dimensional action is
\begin{equation}
S = \int d^4x \int_0^L dy \sqrt{-g}
\left[
-\frac{1}{2}g^{MN}\partialM\Phi\partialN\Phi
- V(\Phi)
+ \mathcal{L}_{\text{SM}}(x,y)
\right].
\end{equation}
Expanding
\begin{equation}
\Phi(x,y) = \sum{n=0}^{\infty} \phin(x) f_n(y),
\end{equation}
and integrating over $y$ yields
\begin{equation}
\mathcal{L}_{\text{eff}} =
\sum_{n=0}^{\infty}
\left[
-\frac{1}{2}\partial\mu\phin\partial^\mu\phi_n
-\frac{1}{2}mn^2\phin^2
\right]
+ \mathcal{L}_{\text{int}}.
\end{equation}

\subsection{Gauge and Fermion Couplings}

Gauge couplings:
\begin{equation}
gn = g5 \int0^L dy\, e^{-ky} fn(y).
\end{equation}
Fermion couplings (bulk mass parameter $c$):
\begin{equation}
g{n,f} = g5 \int0^L dy\, e^{-3ky} fn(y) e^{(2-c)ky}.
\end{equation}

\subsection{Decay Widths and Branching Fractions}

\begin{equation}
\Gamma(\phi_n \to f\bar{f}) =
\frac{Nc g{n,f}^2 m_n}{8\pi}
\left(1 - \frac{4mf^2}{mn^2}\right)^{3/2},
\end{equation}
\begin{equation}
\Gamma(\phi_n \to VV) =
\frac{gn^2 mn^3}{32\pi m_V^4}
\left(1 - \frac{4mV^2}{mn^2}\right)^{1/2},
\end{equation}
\begin{equation}
\text{BR}{n,f} = \frac{\Gamma(\phin \to f\bar{f})}{\Gamma_{\text{tot}}}, \qquad
\text{BR}{n,V} = \frac{\Gamma(\phin \to VV)}{\Gamma_{\text{tot}}}.
\end{equation}

