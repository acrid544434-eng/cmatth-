\nabla_\mu \left( \rho u^\mu \right) &= 0 \\
\nabla_\mu T^{\mu\nu} &= 0 \\
\nabla_\mu \left( *F^{\mu\nu} \right) &= 0
\end{align}
Where $T^{\mu\nu}$ represents the total energy-momentum tensor for a magnetofluid:
\begin{equation}
T^{\mu\nu} = \left( \rho h + b^2 \right) u^\mu u^\nu + \left( p + \frac{1}{2} b^2 \right) g^{\mu\nu} - b^\mu b^\nu
\end{equation}

