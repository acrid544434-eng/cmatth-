\section{Stress Test Results}

Peak chamber pressure:
\begin{equation}
P_c^{\text{peak}} = \SI{23.88}{MPa} < P_c^{\max}.
\end{equation}

Residual norm:
\begin{equation}
\mathcal{R} = 4.2\times 10^{-7},
\end{equation}
within the stability envelope.

Peak heat flux:
\begin{equation}
q''_{\text{peak}} = 0.88\,q''_{\max} = \SI{74.8}{MW/m^2}.
\end{equation}

Specific impulse:
\begin{equation}
I_{sp} = \SI{452.4}{s}.
\end{equation}

