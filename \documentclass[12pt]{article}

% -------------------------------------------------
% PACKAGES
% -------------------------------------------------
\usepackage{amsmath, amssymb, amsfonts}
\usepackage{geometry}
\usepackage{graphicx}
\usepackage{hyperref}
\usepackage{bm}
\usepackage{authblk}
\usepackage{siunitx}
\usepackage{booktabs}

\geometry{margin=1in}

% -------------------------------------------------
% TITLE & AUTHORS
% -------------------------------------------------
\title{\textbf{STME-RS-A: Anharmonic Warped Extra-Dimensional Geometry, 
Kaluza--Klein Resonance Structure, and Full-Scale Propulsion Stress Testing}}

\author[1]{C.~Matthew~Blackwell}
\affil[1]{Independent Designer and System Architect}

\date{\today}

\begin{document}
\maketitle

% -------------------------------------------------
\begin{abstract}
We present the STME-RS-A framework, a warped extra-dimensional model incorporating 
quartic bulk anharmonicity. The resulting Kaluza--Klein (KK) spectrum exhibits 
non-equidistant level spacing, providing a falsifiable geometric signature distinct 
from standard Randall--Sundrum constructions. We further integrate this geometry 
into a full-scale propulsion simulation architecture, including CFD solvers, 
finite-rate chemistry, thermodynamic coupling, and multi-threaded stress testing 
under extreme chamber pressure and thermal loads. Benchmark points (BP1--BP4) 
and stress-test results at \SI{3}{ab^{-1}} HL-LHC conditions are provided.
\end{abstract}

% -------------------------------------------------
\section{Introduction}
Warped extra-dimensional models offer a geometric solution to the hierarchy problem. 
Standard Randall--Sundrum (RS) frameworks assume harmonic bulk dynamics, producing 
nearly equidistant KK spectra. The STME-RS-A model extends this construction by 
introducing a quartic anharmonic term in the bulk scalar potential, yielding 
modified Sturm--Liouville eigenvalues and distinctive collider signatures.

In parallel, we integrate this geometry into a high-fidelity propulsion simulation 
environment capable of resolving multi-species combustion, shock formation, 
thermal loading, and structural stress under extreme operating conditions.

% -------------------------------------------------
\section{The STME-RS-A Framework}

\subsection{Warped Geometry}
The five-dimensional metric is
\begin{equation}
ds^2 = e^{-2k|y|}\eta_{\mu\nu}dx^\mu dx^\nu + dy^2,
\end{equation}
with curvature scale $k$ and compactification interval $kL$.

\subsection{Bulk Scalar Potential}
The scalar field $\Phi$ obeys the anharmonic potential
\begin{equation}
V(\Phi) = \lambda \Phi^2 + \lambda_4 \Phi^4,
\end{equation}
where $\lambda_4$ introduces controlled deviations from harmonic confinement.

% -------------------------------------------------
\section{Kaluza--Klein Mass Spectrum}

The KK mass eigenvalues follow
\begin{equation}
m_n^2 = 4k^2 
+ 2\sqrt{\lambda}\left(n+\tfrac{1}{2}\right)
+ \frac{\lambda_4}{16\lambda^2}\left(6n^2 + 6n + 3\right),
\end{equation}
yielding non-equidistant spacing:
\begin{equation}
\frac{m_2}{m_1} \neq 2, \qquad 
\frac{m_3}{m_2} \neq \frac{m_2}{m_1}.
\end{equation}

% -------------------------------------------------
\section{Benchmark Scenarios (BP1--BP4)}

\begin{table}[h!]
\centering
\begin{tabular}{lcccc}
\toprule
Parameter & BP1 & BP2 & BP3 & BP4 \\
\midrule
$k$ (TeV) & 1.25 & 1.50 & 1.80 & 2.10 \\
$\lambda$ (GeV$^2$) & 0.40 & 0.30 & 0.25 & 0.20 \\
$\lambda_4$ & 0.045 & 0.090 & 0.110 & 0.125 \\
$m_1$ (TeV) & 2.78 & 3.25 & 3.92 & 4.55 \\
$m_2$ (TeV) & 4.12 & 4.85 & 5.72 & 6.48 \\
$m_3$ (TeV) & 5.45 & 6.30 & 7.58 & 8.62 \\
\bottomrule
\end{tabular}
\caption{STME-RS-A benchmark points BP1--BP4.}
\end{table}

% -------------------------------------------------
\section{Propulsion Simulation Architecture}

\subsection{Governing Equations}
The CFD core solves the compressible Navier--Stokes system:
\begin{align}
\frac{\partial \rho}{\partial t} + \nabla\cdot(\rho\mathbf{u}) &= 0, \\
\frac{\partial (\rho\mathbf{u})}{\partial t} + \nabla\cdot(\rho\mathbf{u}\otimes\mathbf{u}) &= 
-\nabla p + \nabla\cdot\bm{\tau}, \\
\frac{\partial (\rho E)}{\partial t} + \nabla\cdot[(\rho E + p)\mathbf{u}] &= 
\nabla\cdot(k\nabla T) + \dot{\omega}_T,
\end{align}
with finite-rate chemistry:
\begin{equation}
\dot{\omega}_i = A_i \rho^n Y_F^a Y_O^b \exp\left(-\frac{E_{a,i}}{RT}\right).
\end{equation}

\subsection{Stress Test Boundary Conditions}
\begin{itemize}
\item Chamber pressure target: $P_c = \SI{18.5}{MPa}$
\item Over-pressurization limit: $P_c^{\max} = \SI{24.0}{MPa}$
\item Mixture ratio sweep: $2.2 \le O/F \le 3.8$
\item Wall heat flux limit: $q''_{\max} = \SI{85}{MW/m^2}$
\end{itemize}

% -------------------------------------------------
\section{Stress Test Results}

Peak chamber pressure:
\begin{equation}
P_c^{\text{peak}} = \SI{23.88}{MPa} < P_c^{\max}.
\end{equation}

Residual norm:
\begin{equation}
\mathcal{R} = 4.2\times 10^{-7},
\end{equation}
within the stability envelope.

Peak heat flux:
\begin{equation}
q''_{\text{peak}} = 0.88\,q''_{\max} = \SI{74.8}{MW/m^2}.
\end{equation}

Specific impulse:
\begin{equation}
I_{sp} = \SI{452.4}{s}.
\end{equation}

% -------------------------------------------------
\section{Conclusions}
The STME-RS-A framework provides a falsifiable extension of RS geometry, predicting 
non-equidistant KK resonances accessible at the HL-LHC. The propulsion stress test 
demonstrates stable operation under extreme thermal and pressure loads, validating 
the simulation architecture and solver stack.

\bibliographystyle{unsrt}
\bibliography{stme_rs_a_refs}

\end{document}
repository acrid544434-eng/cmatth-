\section{Propulsion Simulation Architecture}

\subsection{Governing Equations}
The CFD core solves the compressible Navier--Stokes system:
\begin{align}
\frac{\partial \rho}{\partial t} + \nabla\cdot(\rho\mathbf{u}) &= 0, \\
\frac{\partial (\rho\mathbf{u})}{\partial t} + \nabla\cdot(\rho\mathbf{u}\otimes\mathbf{u}) &= 
-\nabla p + \nabla\cdot\bm{\tau}, \\
\frac{\partial (\rho E)}{\partial t} + \nabla\cdot[(\rho E + p)\mathbf{u}] &= 
\nabla\cdot(k\nabla T) + \dot{\omega}_T,
\end{align}
with finite-rate chemistry:
\begin{equation}
\dot{\omega}_i = A_i \rho^n Y_F^a Y_O^b \exp\left(-\frac{E_{a,i}}{RT}\right).
\end{equation}

\subsection{Stress Test Boundary Conditions}
\begin{itemize}
\item Chamber pressure target: $P_c = \SI{18.5}{MPa}$
\item Over-pressurization limit: $P_c^{\max} = \SI{24.0}{MPa}$
\item Mixture ratio sweep: $2.2 \le O/F \le 3.8$
\item Wall heat flux limit: $q''_{\max} = \SI{85}{MW/m^2}$
\end{itemize}

