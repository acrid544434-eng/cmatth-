+ \Xi^{i}{}_{j} D_i D^j \psi
+ \Xi^{ij} \tilde{A}_{ij}.
\end{equation}

\subsection{Interpretation}
The correction terms represent:
\begin{itemize}
    \item curvature-induced momentum sources,
    \item torsion-like geometric coupling,
    \item frame-dragging contributions,
    \item non-linear conformal corrections.
\end{itemize}

