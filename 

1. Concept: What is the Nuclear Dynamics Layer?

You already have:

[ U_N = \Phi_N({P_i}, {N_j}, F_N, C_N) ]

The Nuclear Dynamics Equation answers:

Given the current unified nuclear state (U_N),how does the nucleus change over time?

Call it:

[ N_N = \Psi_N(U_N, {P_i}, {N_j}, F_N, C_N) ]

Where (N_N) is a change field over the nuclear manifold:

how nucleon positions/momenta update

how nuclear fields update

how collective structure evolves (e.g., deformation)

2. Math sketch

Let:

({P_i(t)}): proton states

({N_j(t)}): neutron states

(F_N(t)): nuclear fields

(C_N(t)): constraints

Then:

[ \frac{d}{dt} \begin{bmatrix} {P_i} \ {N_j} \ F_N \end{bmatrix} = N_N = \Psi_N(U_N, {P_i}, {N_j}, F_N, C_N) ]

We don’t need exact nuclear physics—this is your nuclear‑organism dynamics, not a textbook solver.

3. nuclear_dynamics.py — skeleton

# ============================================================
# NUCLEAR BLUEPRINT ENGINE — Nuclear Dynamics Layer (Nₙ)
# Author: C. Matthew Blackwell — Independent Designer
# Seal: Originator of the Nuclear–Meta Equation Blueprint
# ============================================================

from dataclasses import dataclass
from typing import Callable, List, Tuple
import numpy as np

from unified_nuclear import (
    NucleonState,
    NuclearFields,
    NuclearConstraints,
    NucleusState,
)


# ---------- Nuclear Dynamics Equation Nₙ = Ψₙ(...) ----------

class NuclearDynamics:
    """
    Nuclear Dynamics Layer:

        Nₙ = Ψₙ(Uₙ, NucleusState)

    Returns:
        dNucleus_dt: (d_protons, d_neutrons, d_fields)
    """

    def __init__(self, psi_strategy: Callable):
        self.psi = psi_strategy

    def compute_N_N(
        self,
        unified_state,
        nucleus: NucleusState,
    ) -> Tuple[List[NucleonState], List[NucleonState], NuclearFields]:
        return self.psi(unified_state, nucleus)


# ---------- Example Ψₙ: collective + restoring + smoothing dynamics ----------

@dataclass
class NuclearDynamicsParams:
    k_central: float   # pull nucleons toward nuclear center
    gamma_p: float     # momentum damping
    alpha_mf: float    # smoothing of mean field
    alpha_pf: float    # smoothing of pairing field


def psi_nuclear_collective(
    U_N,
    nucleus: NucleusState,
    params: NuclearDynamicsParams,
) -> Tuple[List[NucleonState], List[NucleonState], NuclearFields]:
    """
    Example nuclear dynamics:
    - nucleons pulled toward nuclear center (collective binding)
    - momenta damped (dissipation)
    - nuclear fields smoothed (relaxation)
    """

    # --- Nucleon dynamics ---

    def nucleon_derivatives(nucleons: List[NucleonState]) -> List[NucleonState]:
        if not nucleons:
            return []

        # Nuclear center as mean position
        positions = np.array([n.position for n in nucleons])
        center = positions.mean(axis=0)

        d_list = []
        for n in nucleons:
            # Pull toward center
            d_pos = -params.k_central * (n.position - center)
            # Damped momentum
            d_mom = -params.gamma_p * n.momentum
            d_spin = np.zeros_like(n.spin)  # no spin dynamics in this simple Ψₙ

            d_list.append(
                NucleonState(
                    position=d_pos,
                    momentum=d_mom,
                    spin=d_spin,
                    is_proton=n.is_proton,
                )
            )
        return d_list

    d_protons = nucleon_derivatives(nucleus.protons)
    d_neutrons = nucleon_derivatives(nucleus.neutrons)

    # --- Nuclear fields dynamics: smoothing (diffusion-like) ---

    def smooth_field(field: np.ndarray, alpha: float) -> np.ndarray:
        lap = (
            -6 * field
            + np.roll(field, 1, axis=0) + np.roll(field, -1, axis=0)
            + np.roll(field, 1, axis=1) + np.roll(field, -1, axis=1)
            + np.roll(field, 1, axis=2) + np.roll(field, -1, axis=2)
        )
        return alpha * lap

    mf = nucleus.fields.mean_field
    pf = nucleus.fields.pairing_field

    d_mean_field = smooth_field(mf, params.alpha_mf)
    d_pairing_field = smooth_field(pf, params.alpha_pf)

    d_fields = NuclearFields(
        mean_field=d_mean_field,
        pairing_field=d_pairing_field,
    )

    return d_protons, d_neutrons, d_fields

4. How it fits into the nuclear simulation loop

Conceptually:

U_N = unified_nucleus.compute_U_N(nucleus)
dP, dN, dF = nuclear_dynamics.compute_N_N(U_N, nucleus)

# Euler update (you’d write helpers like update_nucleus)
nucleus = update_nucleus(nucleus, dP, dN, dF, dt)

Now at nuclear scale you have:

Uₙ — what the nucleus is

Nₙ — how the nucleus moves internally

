from dataclasses import dataclass
from typing import Callable, List, Tuple
import numpy as np

from unified_nuclear import (
    NucleonState,
    NuclearFields,
    NuclearConstraints,
    NucleusState,
)


# ---------- Nuclear Dynamics Equation Nₙ = Ψₙ(...) ----------

class NuclearDynamics:
    """
    Nuclear Dynamics Layer:

        Nₙ = Ψₙ(Uₙ, NucleusState)

    Returns:
        dNucleus_dt: (d_protons, d_neutrons, d_fields)
    """

    def __init__(self, psi_strategy: Callable):
        self.psi = psi_strategy

    def compute_N_N(
        self,
        unified_state,
        nucleus: NucleusState,
    ) -> Tuple[List[NucleonState], List[NucleonState], NuclearFields]:
        return self.psi(unified_state, nucleus)


# ---------- Example Ψₙ: collective + restoring + smoothing dynamics ----------

@dataclass
class NuclearDynamicsParams:
    k_central: float   # pull nucleons toward nuclear center
    gamma_p: float     # momentum damping
    alpha_mf: float    # smoothing of mean field
    alpha_pf: float    # smoothing of pairing field


def psi_nuclear_collective(
    U_N,
    nucleus: NucleusState,
    params: NuclearDynamicsParams,
) -> Tuple[List[NucleonState], List[NucleonState], NuclearFields]:
    """
    Example nuclear dynamics:
    - nucleons pulled toward nuclear center (collective binding)
    - momenta damped (dissipation)
    - nuclear fields smoothed (relaxation)
    """

    # --- Nucleon dynamics ---

    def nucleon_derivatives(nucleons: List[NucleonState]) -> List[NucleonState]:
        if not nucleons:
            return []

        # Nuclear center as mean position
        positions = np.array([n.position for n in nucleons])
        center = positions.mean(axis=0)

        d_list = []
        for n in nucleons:
            # Pull toward center
            d_pos = -params.k_central * (n.position - center)
            # Damped momentum
            d_mom = -params.gamma_p * n.momentum
            d_spin = np.zeros_like(n.spin)  # no spin dynamics in this simple Ψₙ

            d_list.append(
                NucleonState(
                    position=d_pos,
                    momentum=d_mom,
                    spin=d_spin,
                    is_proton=n.is_proton,
                )
            )
        return d_list

    d_protons = nucleon_derivatives(nucleus.protons)
    d_neutrons = nucleon_derivatives(nucleus.neutrons)

    # --- Nuclear fields dynamics: smoothing (diffusion-like) ---

    def smooth_field(field: np.ndarray, alpha: float) -> np.ndarray:
        lap = (
            -6 * field
            + np.roll(field, 1, axis=0) + np.roll(field, -1, axis=0)
            + np.roll(field, 1, axis=1) + np.roll(field, -1, axis=1)
            + np.roll(field, 1, axis=2) + np.roll(field, -1, axis=2)
        )
        return alpha * lap

    mf = nucleus.fields.mean_field
    pf = nucleus.fields.pairing_field

    d_mean_field = smooth_field(mf, params.alpha_mf)
    d_pairing_field = smooth_field(pf, params.alpha_pf)

    d_fields = NuclearFields(
        mean_field=d_mean_field,
        pairing_field=d_pairing_field,
    )

    return d_protons, d_neutrons, d_fields

