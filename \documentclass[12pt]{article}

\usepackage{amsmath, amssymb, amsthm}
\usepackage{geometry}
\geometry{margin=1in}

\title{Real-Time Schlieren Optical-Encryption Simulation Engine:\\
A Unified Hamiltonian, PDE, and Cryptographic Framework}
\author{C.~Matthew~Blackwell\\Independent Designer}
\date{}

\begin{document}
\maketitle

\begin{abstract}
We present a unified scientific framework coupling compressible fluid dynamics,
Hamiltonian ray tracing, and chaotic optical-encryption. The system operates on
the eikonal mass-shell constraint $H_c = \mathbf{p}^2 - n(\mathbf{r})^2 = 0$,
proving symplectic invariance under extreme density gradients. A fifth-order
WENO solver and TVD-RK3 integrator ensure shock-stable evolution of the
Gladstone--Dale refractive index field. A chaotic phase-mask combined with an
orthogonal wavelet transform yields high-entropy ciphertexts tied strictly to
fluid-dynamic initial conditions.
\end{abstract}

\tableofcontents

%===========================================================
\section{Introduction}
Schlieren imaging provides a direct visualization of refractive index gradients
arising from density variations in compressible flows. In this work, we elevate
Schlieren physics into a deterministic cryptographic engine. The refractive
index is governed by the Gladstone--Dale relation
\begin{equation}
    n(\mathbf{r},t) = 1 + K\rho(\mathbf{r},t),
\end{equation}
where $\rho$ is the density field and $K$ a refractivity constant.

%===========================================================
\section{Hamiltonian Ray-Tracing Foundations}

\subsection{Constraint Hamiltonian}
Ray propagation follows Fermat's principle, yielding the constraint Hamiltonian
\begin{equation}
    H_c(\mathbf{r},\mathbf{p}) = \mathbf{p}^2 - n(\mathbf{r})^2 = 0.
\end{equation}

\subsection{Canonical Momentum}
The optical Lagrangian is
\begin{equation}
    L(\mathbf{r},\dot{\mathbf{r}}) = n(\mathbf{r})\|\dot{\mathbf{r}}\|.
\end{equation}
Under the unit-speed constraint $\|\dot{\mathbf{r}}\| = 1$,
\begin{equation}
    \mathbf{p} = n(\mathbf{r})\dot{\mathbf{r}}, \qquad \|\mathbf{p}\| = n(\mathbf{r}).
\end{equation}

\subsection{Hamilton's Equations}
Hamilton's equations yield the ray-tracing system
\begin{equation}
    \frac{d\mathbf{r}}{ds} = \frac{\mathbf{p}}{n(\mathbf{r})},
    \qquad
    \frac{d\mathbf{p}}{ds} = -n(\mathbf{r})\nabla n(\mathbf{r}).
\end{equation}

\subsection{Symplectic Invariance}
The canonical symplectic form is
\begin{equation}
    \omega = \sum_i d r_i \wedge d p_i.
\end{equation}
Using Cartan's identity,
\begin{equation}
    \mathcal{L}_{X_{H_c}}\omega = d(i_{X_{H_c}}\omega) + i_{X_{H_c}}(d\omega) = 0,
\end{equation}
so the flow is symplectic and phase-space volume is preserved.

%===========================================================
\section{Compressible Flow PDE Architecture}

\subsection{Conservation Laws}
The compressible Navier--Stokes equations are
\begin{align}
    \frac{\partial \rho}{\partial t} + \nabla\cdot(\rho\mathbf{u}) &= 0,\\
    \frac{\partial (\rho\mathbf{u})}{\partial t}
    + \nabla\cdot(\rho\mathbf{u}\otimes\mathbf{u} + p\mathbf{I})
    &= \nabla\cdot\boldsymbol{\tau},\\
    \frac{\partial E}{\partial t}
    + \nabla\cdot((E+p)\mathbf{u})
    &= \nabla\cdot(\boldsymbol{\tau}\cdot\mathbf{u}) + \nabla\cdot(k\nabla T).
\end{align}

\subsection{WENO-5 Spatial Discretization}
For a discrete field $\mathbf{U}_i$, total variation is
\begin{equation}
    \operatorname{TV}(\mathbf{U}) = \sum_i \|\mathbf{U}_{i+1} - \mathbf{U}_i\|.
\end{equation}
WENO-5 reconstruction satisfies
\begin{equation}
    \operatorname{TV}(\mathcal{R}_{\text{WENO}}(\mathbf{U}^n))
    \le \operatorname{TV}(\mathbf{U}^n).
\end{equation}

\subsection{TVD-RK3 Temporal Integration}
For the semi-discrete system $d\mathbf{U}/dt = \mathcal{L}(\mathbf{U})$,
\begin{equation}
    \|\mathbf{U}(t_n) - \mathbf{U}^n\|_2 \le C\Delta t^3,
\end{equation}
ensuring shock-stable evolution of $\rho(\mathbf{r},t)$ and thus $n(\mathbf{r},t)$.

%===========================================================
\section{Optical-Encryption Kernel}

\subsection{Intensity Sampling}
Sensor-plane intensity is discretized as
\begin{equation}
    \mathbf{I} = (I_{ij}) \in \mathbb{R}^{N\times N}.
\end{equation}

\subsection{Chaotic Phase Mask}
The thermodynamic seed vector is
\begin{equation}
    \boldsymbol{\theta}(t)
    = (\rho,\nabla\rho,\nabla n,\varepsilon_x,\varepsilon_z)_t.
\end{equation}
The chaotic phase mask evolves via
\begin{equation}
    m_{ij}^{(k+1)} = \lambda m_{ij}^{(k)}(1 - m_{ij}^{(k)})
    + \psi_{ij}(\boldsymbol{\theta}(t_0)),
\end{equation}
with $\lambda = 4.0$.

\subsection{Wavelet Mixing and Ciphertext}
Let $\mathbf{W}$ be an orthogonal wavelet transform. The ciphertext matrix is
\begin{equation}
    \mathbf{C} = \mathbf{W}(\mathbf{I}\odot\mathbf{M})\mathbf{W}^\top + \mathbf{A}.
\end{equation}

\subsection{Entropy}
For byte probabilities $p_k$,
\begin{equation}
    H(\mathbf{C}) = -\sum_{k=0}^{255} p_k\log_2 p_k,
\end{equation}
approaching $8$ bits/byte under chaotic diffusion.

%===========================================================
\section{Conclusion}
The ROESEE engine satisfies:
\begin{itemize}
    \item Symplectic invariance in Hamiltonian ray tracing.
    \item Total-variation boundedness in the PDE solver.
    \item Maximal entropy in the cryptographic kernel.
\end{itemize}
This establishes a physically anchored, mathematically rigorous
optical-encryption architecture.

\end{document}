\section{Hamiltonian Ray-Tracing Foundations}

\subsection{Constraint Hamiltonian}
Ray propagation follows Fermat's principle, yielding the constraint Hamiltonian
\begin{equation}
    H_c(\mathbf{r},\mathbf{p}) = \mathbf{p}^2 - n(\mathbf{r})^2 = 0.
\end{equation}

\subsection{Canonical Momentum}
The optical Lagrangian is
\begin{equation}
    L(\mathbf{r},\dot{\mathbf{r}}) = n(\mathbf{r})\|\dot{\mathbf{r}}\|.
\end{equation}
Under the unit-speed constraint $\|\dot{\mathbf{r}}\| = 1$,
\begin{equation}
    \mathbf{p} = n(\mathbf{r})\dot{\mathbf{r}}, \qquad \|\mathbf{p}\| = n(\mathbf{r}).
\end{equation}

\subsection{Hamilton's Equations}
Hamilton's equations yield the ray-tracing system
\begin{equation}
    \frac{d\mathbf{r}}{ds} = \frac{\mathbf{p}}{n(\mathbf{r})},
    \qquad
    \frac{d\mathbf{p}}{ds} = -n(\mathbf{r})\nabla n(\mathbf{r}).
\end{equation}

\subsection{Symplectic Invariance}
The canonical symplectic form is
\begin{equation}
    \omega = \sum_i d r_i \wedge d p_i.
\end{equation}
Using Cartan's identity,
\begin{equation}
    \mathcal{L}_{X_{H_c}}\omega = d(i_{X_{H_c}}\omega) + i_{X_{H_c}}(d\omega) = 0,
\end{equation}
so the flow is symplectic and phase-space volume is preserved.

