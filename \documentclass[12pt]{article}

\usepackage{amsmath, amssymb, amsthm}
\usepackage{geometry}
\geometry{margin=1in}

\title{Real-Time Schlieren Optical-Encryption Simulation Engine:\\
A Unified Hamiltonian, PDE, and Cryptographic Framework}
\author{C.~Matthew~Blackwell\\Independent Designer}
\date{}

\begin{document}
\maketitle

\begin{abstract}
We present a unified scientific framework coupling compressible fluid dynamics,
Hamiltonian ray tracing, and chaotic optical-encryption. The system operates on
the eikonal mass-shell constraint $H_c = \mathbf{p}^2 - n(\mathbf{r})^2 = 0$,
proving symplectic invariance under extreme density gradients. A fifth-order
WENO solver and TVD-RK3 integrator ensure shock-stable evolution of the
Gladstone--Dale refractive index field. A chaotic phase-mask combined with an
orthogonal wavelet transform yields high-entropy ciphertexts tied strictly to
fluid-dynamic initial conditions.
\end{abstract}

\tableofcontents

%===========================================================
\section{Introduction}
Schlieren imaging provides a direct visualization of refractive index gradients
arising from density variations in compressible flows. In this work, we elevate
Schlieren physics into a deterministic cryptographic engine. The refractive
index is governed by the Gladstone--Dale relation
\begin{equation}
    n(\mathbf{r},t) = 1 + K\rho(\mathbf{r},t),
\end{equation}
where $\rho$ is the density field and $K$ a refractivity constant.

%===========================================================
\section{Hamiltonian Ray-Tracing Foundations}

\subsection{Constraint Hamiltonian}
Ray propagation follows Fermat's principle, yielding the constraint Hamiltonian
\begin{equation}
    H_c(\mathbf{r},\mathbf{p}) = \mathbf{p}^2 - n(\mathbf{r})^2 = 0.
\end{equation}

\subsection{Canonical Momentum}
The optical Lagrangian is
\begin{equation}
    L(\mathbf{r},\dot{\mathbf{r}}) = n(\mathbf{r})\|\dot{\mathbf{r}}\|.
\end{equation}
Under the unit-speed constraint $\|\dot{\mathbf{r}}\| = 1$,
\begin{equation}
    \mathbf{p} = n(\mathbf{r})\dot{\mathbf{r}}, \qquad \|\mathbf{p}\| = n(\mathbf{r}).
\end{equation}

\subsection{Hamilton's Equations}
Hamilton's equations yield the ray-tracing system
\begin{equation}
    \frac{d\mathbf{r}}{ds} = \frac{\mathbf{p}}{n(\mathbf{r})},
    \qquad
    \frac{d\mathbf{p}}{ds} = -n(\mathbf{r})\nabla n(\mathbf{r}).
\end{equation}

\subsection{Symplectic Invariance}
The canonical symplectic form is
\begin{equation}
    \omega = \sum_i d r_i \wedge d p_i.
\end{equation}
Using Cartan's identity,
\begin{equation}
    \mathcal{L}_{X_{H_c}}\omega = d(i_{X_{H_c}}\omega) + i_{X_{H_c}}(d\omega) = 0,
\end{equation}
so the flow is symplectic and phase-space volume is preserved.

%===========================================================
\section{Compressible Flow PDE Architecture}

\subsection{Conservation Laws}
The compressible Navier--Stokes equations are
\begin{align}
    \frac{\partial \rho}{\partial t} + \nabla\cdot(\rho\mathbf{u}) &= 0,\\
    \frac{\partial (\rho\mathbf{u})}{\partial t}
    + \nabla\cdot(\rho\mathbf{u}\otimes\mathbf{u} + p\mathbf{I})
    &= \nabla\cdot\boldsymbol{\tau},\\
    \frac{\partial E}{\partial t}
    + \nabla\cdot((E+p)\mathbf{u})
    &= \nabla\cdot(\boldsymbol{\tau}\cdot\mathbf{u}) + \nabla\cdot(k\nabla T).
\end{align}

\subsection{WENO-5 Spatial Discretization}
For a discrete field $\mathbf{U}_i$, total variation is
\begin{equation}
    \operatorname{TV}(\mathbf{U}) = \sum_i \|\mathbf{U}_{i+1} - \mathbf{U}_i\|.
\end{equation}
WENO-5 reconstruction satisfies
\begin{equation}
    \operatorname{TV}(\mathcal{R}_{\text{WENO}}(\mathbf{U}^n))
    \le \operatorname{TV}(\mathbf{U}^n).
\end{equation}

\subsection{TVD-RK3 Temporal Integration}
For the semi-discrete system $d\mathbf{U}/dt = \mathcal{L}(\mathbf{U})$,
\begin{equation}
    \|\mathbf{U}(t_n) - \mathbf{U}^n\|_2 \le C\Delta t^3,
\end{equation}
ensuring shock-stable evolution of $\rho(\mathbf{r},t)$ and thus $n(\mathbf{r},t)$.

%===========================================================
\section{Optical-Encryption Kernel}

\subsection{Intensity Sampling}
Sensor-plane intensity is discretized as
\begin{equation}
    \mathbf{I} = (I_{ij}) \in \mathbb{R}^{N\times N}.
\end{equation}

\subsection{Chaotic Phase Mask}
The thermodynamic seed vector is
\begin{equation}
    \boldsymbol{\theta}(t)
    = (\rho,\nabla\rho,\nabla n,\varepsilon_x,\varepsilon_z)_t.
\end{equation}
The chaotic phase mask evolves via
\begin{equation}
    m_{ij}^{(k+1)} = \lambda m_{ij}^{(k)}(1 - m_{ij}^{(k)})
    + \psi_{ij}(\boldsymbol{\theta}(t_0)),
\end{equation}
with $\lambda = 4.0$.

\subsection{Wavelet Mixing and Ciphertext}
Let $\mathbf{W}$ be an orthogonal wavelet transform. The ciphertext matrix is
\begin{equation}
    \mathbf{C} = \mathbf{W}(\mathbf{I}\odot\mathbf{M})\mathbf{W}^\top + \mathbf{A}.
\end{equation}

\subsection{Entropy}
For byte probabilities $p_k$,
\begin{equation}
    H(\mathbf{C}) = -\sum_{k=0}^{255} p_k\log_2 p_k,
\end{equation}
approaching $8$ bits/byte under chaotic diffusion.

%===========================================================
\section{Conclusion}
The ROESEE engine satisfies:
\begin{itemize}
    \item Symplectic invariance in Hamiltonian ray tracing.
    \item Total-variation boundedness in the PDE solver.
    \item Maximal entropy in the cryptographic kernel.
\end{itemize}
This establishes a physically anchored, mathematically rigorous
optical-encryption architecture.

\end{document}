\section{Compressible Flow PDE Architecture}

\subsection{Conservation Laws}
The compressible Navier--Stokes equations are
\begin{align}
    \frac{\partial \rho}{\partial t} + \nabla\cdot(\rho\mathbf{u}) &= 0,\\
    \frac{\partial (\rho\mathbf{u})}{\partial t}
    + \nabla\cdot(\rho\mathbf{u}\otimes\mathbf{u} + p\mathbf{I})
    &= \nabla\cdot\boldsymbol{\tau},\\
    \frac{\partial E}{\partial t}
    + \nabla\cdot((E+p)\mathbf{u})
    &= \nabla\cdot(\boldsymbol{\tau}\cdot\mathbf{u}) + \nabla\cdot(k\nabla T).
\end{align}

\subsection{WENO-5 Spatial Discretization}
For a discrete field $\mathbf{U}_i$, total variation is
\begin{equation}
    \operatorname{TV}(\mathbf{U}) = \sum_i \|\mathbf{U}_{i+1} - \mathbf{U}_i\|.
\end{equation}
WENO-5 reconstruction satisfies
\begin{equation}
    \operatorname{TV}(\mathcal{R}_{\text{WENO}}(\mathbf{U}^n))
    \le \operatorname{TV}(\mathbf{U}^n).
\end{equation}

\subsection{TVD-RK3 Temporal Integration}
For the semi-discrete system $d\mathbf{U}/dt = \mathcal{L}(\mathbf{U})$,
\begin{equation}
    \|\mathbf{U}(t_n) - \mathbf{U}^n\|_2 \le C\Delta t^3,
\end{equation}
ensuring shock-stable evolution of $\rho(\mathbf{r},t)$ and thus $n(\mathbf{r},t)$.

