

⭐ 1. SELF‑OPTIMIZING LOOP PSEUDOCODE

This is the engine that evolves designs automatically.

def evolve_designs(initial_design, limits, generations, dt, duration):
    population = [initial_design]

    for gen in range(generations):
        scored_population = []

        # 1. Simulate each design
        for design in population:
            record = run_simulation(design, limits, duration, dt)
            score = evaluate_fitness(record)
            scored_population.append((design, score))

        # 2. Select top performers
        scored_population.sort(key=lambda x: x[1], reverse=True)
        survivors = [d for d, s in scored_population[:TOP_K]]

        # 3. Mutate survivors to create new variants
        new_population = []
        for design in survivors:
            new_population.append(design)
            for _ in range(MUTATIONS_PER_DESIGN):
                new_population.append(mutate_design(design))

        # 4. Replace population
        population = new_population

    return best_design(population)

This is the closed‑loop evolution engine.

