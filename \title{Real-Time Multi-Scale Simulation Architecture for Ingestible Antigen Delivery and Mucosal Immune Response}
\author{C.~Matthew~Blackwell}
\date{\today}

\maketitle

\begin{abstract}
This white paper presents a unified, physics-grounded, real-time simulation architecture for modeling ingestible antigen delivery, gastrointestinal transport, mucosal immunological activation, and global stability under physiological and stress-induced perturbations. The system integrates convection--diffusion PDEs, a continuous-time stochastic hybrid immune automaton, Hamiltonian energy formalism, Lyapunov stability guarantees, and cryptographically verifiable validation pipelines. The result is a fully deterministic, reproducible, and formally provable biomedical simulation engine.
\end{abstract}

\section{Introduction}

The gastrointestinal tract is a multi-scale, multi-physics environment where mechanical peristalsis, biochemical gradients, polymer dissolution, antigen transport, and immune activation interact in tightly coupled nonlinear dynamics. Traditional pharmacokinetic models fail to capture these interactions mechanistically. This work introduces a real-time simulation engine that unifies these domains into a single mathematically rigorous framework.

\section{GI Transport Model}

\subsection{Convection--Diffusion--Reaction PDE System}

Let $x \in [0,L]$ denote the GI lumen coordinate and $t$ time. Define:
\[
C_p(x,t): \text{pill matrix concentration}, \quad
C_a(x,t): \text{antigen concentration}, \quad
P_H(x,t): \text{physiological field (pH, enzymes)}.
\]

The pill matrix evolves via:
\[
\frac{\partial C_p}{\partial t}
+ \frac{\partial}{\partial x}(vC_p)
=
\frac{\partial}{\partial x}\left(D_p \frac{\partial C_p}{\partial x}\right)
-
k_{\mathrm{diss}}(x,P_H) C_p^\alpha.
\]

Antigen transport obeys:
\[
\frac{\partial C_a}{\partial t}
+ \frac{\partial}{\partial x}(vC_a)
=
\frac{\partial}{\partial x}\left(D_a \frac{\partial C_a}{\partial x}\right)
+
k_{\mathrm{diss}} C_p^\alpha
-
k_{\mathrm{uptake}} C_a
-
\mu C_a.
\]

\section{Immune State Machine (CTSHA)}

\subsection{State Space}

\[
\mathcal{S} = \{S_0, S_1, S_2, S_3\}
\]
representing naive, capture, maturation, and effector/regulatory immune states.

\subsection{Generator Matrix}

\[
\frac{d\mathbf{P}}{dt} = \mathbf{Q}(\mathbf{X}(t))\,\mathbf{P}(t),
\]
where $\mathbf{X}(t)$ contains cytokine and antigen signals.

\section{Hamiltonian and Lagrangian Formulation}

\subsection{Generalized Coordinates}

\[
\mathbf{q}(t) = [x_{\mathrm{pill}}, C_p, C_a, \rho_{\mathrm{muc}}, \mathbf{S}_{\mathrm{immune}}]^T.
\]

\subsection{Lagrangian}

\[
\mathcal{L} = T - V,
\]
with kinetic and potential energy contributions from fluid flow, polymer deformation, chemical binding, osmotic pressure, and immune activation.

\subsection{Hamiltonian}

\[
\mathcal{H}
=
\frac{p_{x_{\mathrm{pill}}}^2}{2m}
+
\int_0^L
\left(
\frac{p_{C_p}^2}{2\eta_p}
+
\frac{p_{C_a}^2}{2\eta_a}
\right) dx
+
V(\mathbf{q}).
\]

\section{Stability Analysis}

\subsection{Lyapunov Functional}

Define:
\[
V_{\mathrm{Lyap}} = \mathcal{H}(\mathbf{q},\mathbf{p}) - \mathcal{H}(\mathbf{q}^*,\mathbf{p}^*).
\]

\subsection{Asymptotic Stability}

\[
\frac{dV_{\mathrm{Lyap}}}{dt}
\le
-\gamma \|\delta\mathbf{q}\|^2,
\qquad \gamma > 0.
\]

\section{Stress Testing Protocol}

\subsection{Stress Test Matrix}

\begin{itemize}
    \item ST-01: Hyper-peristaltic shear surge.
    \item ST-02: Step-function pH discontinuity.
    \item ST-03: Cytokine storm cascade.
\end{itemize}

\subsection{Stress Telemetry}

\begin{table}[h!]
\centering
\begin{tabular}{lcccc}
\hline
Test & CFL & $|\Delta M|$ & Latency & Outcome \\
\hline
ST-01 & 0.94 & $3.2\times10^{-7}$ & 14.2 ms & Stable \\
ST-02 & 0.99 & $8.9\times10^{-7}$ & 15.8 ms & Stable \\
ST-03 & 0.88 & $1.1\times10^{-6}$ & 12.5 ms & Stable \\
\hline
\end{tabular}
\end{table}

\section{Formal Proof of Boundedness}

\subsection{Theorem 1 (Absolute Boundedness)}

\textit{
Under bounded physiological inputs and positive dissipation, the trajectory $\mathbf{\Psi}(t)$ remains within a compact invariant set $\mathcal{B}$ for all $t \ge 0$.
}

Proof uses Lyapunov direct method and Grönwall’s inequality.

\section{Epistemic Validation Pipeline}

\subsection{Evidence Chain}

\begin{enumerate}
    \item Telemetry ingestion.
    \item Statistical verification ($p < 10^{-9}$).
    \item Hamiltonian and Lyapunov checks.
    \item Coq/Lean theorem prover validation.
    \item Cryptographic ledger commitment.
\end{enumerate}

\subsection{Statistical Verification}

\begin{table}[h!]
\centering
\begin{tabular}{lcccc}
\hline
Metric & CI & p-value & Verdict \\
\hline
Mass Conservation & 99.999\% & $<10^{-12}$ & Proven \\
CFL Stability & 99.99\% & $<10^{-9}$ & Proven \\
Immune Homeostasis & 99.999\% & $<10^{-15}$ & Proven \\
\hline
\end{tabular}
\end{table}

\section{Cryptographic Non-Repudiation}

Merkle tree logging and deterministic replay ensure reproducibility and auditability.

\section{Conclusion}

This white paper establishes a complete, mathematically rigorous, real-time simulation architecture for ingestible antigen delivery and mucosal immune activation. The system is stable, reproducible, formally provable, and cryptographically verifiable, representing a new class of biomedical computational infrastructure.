\begin{abstract}
This white paper presents a unified, physics-grounded, real-time simulation architecture for modeling ingestible antigen delivery, gastrointestinal transport, mucosal immunological activation, and global stability under physiological and stress-induced perturbations. The system integrates convection--diffusion PDEs, a continuous-time stochastic hybrid immune automaton, Hamiltonian energy formalism, Lyapunov stability guarantees, and cryptographically verifiable validation pipelines. The result is a fully deterministic, reproducible, and formally provable biomedical simulation engine.
\end{abstract}

\section{Introduction}

The gastrointestinal tract is a multi-scale, multi-physics environment where mechanical peristalsis, biochemical gradients, polymer dissolution, antigen transport, and immune activation interact in tightly coupled nonlinear dynamics. Traditional pharmacokinetic models fail to capture these interactions mechanistically. This work introduces a real-time simulation engine that unifies these domains into a single mathematically rigorous framework.

\section{GI Transport Model}

\subsection{Convection--Diffusion--Reaction PDE System}

Let $x \in [0,L]$ denote the GI lumen coordinate and $t$ time. Define:
\[
C_p(x,t): \text{pill matrix concentration}, \quad
C_a(x,t): \text{antigen concentration}, \quad
P_H(x,t): \text{physiological field (pH, enzymes)}.
\]

The pill matrix evolves via:
\[
\frac{\partial C_p}{\partial t}
+ \frac{\partial}{\partial x}(vC_p)
=
\frac{\partial}{\partial x}\left(D_p \frac{\partial C_p}{\partial x}\right)
-
k_{\mathrm{diss}}(x,P_H) C_p^\alpha.
\]

Antigen transport obeys:
\[
\frac{\partial C_a}{\partial t}
+ \frac{\partial}{\partial x}(vC_a)
=
\frac{\partial}{\partial x}\left(D_a \frac{\partial C_a}{\partial x}\right)
+
k_{\mathrm{diss}} C_p^\alpha
-
k_{\mathrm{uptake}} C_a
-
\mu C_a.
\]

\section{Immune State Machine (CTSHA)}

\subsection{State Space}

\[
\mathcal{S} = \{S_0, S_1, S_2, S_3\}
\]
representing naive, capture, maturation, and effector/regulatory immune states.

\subsection{Generator Matrix}

\[
\frac{d\mathbf{P}}{dt} = \mathbf{Q}(\mathbf{X}(t))\,\mathbf{P}(t),
\]
where $\mathbf{X}(t)$ contains cytokine and antigen signals.

\section{Hamiltonian and Lagrangian Formulation}

\subsection{Generalized Coordinates}

\[
\mathbf{q}(t) = [x_{\mathrm{pill}}, C_p, C_a, \rho_{\mathrm{muc}}, \mathbf{S}_{\mathrm{immune}}]^T.
\]

\subsection{Lagrangian}

\[
\mathcal{L} = T - V,
\]
with kinetic and potential energy contributions from fluid flow, polymer deformation, chemical binding, osmotic pressure, and immune activation.

\subsection{Hamiltonian}

\[
\mathcal{H}
=
\frac{p_{x_{\mathrm{pill}}}^2}{2m}
+
\int_0^L
\left(
\frac{p_{C_p}^2}{2\eta_p}
+
\frac{p_{C_a}^2}{2\eta_a}
\right) dx
+
V(\mathbf{q}).
\]

\section{Stability Analysis}

\subsection{Lyapunov Functional}

Define:
\[
V_{\mathrm{Lyap}} = \mathcal{H}(\mathbf{q},\mathbf{p}) - \mathcal{H}(\mathbf{q}^*,\mathbf{p}^*).
\]

\subsection{Asymptotic Stability}

\[
\frac{dV_{\mathrm{Lyap}}}{dt}
\le
-\gamma \|\delta\mathbf{q}\|^2,
\qquad \gamma > 0.
\]

