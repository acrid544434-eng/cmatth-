\chapter{Foundations of Schlieren Optical Physics}

\section{Refractive Index Gradients}
The refractive index field is governed by the Gladstone--Dale relation
\begin{equation}
    n(\mathbf{r},t) = 1 + K\rho(\mathbf{r},t),
\end{equation}
where $\rho$ is the density field.

\section{Optical Deflection}
Density gradients produce ray deflection via
\begin{equation}
    \varepsilon_x = \frac{1}{n}\frac{\partial n}{\partial x},
    \qquad
    \varepsilon_z = \frac{1}{n}\frac{\partial n}{\partial z}.
\end{equation}

