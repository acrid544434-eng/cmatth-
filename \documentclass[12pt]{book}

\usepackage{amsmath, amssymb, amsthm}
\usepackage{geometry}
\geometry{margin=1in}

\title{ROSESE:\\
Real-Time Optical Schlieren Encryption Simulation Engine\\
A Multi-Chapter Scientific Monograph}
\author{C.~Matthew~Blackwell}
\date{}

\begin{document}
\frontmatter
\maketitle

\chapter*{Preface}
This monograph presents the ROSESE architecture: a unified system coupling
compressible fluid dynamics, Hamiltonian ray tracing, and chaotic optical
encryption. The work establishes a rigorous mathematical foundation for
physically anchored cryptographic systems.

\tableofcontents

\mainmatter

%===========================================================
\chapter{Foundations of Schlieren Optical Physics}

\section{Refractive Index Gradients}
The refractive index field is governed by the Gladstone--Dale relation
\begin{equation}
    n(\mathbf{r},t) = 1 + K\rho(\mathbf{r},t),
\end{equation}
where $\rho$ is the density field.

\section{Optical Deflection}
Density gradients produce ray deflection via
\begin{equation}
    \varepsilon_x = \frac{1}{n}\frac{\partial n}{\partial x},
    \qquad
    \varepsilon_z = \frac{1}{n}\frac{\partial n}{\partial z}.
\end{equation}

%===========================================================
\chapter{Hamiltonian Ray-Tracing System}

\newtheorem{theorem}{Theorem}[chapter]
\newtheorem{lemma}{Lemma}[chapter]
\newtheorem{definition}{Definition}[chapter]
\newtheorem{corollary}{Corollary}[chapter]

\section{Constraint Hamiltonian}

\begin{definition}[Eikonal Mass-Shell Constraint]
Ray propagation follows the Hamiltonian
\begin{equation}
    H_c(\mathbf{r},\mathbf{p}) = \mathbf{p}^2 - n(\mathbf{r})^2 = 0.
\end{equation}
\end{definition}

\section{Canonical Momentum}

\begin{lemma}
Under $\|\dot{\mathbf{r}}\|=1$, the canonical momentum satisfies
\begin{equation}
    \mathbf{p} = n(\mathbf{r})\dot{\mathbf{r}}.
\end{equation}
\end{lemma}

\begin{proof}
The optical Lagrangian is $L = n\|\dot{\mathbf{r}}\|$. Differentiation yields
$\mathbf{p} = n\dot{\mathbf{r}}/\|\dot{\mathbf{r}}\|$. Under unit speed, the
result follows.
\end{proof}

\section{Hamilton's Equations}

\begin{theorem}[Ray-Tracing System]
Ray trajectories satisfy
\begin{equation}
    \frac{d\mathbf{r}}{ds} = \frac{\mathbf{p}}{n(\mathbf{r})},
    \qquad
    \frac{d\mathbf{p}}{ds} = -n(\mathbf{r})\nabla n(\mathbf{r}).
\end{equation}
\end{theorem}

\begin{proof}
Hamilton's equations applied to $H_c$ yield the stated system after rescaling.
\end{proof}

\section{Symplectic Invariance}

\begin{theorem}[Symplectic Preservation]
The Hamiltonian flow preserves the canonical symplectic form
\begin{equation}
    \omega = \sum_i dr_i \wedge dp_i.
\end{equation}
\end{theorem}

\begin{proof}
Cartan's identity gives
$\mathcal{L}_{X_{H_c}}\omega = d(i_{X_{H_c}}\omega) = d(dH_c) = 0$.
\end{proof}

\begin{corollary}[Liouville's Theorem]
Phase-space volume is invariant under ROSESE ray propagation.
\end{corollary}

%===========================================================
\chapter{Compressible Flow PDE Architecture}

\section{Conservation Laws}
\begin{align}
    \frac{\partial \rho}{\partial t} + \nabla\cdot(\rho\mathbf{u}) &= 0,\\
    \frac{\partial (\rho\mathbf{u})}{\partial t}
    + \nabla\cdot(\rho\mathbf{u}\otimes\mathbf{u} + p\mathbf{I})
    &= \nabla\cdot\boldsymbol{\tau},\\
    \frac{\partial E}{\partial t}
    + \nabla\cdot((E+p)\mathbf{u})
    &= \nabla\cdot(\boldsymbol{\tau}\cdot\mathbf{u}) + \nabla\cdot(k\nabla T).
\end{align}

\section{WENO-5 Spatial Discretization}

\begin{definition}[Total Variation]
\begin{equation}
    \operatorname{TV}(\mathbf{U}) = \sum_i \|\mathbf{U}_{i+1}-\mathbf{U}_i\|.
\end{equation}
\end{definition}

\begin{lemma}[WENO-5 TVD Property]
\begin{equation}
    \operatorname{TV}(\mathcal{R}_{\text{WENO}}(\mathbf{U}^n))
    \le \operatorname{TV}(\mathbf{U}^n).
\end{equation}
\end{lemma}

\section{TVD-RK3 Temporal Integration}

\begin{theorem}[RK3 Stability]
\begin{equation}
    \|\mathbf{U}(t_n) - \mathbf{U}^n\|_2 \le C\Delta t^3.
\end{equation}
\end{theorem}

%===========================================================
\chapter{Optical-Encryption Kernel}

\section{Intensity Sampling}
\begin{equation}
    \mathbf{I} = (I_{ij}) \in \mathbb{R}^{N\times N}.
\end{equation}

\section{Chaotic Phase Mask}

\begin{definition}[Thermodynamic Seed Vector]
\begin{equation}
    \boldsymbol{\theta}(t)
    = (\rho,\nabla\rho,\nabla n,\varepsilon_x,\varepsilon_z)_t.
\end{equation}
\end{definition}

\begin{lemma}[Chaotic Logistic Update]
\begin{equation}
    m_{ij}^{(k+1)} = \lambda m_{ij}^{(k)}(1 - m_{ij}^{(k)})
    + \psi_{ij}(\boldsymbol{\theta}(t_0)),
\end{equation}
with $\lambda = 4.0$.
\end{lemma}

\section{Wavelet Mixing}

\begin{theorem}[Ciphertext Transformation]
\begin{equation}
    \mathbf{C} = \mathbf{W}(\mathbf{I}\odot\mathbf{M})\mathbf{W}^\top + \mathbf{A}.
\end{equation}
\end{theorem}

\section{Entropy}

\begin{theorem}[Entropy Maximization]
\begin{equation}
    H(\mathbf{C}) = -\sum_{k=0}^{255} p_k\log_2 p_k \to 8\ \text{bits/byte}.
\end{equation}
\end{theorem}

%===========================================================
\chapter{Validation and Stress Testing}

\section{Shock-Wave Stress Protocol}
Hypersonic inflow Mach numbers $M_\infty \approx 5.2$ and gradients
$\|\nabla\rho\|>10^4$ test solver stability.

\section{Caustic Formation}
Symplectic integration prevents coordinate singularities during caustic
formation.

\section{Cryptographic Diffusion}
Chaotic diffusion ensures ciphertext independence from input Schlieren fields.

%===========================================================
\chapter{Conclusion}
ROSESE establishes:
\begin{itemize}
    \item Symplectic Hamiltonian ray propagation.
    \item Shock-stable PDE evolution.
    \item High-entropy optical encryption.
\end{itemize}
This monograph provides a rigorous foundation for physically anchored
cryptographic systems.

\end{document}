\section{Constraint Hamiltonian}

\begin{definition}[Eikonal Mass-Shell Constraint]
Ray propagation follows the Hamiltonian
\begin{equation}
    H_c(\mathbf{r},\mathbf{p}) = \mathbf{p}^2 - n(\mathbf{r})^2 = 0.
\end{equation}
\end{definition}

\section{Canonical Momentum}

\begin{lemma}
Under $\|\dot{\mathbf{r}}\|=1$, the canonical momentum satisfies
\begin{equation}
    \mathbf{p} = n(\mathbf{r})\dot{\mathbf{r}}.
\end{equation}
\end{lemma}

\begin{proof}
The optical Lagrangian is $L = n\|\dot{\mathbf{r}}\|$. Differentiation yields
$\mathbf{p} = n\dot{\mathbf{r}}/\|\dot{\mathbf{r}}\|$. Under unit speed, the
result follows.
\end{proof}

\section{Hamilton's Equations}

\begin{theorem}[Ray-Tracing System]
Ray trajectories satisfy
\begin{equation}
    \frac{d\mathbf{r}}{ds} = \frac{\mathbf{p}}{n(\mathbf{r})},
    \qquad
    \frac{d\mathbf{p}}{ds} = -n(\mathbf{r})\nabla n(\mathbf{r}).
\end{equation}
\end{theorem}

\begin{proof}
Hamilton's equations applied to $H_c$ yield the stated system after rescaling.
\end{proof}

\section{Symplectic Invariance}

\begin{theorem}[Symplectic Preservation]
The Hamiltonian flow preserves the canonical symplectic form
\begin{equation}
    \omega = \sum_i dr_i \wedge dp_i.
\end{equation}
\end{theorem}

\begin{proof}
Cartan's identity gives
$\mathcal{L}_{X_{H_c}}\omega = d(i_{X_{H_c}}\omega) = d(dH_c) = 0$.
\end{proof}

\begin{corollary}[Liouville's Theorem]
Phase-space volume is invariant under ROSESE ray propagation.
\end{corollary}

