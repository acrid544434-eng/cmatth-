\section{Ledger Overview}
The proof ledger records all zero-knowledge continuity proofs generated during
state transitions.

\section{State Hash Chain}
Let $H_t$ denote the SHA3-512 hash of organism state $O(t)$:
\begin{equation}
    H_{t+1} = \text{SHA3-512}\big( H_t \Vert O(t+1) \big).
\end{equation}

\section{Proof Record Format}
Each ledger entry contains:
\begin{itemize}
    \item Previous state hash $H_t$
    \item Current state hash $H_{t+1}$
    \item Groth16 proof $\pi_t$
    \item Verification key identifier $\text{vk}$
\end{itemize}

\section{Verification Equation}
\begin{equation}
    V\big(
        \text{vk},\;
        H_t \Vert H_{t+1},\;
        \pi_t
    \big) = 1.
\end{equation}

