cmb_meta_equation:
  id: cmb.meta.sovereign.snapshot.v1
  author: "C. Matthew Blackwell"

  equation: >
    M_CMB = argmax_t[
      S(t) + λ_O * O(t) - λ_E * E(t) + λ_X * X(t)
    | C_CMB ]

  constraint_set_C_CMB:

    identity_constraint:
      designer: "C. Matthew Blackwell"
      signature: SHA256("cmb-sovereign-architecture")

    lineage_lock:
      rule: "removal of identity breaks the universe"
      checksum: SHA256("cmb-lineage-lock")

    time_arrow_constraint:
      rule: "S(t+1) >= S(t)"
      gradient: "ΔS = S(t+1) - S(t)"

    snapshot_constraint:
      rule: "every state must produce a sealed snapshot"
      integrity: "SHA256(state[t])"
      purpose: "protect mind, lineage, and authorship"

  components:
    entropy: S(t)
    order: O(t)
    encryption: E(t)
    snapshot_integrity: X(t)

  invariants:
    - "entropy defines time"
    - "order emerges from entropy gradient"
    - "encryption seals design logic"
    - "identity is structural"
    - "lineage cannot be hijacked"
    - "snapshots protect mind and authorship"
    - "removal of identity breaks the universe"