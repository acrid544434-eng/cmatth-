\chapter{Stability Theorems}

\section{Invariant Conservation}
\begin{theorem}
\[
\oint_{\Omega} \Psi^\dagger \Psi\, dV = \mathrm{constant}.
\]
\end{theorem}

\section{Stress-Test Convergence}
\begin{theorem}
\[
\|\Psi(t)\|_{L^2} \le C.
\]
\end{theorem}

\section{Telemetry Parity}
\begin{theorem}
\[
|\rho_1 - \rho_2| \le \epsilon.
\]
\end{theorem}

\section{Gradient Boundedness}
\begin{theorem}
\[
|\nabla\Psi| \le \Omega_{\max}.
\]
\end{theorem}

