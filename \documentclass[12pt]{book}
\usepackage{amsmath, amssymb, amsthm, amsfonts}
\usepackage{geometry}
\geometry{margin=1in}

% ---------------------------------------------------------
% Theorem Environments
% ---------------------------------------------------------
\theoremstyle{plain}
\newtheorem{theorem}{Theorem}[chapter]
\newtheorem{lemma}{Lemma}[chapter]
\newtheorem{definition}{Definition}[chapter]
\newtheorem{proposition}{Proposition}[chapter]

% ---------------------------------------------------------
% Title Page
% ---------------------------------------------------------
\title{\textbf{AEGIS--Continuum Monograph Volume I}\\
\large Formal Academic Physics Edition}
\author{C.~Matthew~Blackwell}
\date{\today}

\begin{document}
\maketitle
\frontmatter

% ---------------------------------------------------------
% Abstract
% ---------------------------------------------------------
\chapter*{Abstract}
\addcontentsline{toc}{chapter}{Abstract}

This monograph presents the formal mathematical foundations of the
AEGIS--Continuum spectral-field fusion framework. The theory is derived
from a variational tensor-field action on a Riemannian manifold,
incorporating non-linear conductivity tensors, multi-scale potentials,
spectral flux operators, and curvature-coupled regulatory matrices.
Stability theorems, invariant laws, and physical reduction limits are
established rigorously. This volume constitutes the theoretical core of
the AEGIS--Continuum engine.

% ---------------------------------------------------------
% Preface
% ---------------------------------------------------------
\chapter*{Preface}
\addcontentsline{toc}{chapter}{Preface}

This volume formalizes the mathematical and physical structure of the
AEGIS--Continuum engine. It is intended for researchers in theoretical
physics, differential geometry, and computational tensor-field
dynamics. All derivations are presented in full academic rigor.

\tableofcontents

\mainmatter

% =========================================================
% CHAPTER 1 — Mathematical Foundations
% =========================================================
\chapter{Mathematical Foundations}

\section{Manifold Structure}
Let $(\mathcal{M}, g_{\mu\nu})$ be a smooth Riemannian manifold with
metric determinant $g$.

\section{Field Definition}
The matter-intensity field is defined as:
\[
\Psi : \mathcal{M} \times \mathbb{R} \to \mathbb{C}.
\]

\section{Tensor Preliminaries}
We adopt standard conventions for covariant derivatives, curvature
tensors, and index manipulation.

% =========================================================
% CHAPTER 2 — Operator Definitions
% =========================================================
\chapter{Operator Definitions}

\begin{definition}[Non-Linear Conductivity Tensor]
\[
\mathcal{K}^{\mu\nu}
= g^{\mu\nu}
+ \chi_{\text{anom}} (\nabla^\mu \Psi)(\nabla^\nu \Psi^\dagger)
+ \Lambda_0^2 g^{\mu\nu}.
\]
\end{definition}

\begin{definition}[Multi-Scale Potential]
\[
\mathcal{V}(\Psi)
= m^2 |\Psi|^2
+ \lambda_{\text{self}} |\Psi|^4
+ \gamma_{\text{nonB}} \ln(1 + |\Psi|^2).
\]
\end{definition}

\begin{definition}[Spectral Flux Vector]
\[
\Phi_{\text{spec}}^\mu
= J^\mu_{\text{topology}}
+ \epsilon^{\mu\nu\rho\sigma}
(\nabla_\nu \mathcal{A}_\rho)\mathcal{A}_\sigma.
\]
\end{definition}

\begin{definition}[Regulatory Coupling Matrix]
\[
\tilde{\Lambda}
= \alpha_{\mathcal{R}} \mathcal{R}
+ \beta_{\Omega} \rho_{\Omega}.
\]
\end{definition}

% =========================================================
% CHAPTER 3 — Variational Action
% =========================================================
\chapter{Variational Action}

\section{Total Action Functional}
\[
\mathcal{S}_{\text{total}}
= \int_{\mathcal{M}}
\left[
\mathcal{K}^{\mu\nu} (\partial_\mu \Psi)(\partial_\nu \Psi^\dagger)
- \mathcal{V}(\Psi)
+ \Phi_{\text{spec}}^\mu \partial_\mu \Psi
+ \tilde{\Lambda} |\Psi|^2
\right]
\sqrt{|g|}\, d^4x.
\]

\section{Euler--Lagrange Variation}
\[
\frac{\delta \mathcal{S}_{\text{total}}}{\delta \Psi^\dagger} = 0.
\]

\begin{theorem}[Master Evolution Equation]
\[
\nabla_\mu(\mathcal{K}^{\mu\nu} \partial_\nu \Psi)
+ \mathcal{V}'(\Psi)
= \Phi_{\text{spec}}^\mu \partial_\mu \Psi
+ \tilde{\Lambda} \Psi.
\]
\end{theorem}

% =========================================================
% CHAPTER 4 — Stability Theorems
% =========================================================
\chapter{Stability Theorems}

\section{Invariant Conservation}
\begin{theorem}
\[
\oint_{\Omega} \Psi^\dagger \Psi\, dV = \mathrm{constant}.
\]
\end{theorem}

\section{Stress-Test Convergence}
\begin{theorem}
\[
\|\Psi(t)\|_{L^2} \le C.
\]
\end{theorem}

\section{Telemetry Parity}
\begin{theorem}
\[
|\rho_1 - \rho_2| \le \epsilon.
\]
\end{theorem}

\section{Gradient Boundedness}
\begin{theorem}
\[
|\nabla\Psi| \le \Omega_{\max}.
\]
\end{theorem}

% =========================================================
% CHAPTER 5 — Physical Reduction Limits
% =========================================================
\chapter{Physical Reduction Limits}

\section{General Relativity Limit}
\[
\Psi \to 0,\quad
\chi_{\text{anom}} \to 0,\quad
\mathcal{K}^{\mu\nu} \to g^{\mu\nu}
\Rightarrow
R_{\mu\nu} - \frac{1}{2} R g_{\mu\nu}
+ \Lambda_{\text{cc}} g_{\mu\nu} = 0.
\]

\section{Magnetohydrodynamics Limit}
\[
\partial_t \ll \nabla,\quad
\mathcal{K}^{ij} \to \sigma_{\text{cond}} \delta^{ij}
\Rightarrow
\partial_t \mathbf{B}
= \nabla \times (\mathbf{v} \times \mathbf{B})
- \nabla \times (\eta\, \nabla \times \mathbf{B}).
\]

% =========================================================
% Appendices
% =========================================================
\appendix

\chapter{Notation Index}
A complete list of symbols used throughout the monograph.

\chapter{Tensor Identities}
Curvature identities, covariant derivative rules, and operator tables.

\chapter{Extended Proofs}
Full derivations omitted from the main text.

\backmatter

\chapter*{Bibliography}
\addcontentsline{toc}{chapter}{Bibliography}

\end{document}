\chapter{Mathematical Foundations}

\section{Manifold Structure}
Let $(\mathcal{M}, g_{\mu\nu})$ be a smooth Riemannian manifold with
metric determinant $g$.

\section{Field Definition}
The matter-intensity field is defined as:
\[
\Psi : \mathcal{M} \times \mathbb{R} \to \mathbb{C}.
\]

\section{Tensor Preliminaries}
We adopt standard conventions for covariant derivatives, curvature
tensors, and index manipulation.

% =========================================================
% CHAPTER 2 — Operator Definitions
% =========================================================
\chapter{Operator Definitions}

\begin{definition}[Non-Linear Conductivity Tensor]
\[
\mathcal{K}^{\mu\nu}
= g^{\mu\nu}
+ \chi_{\text{anom}} (\nabla^\mu \Psi)(\nabla^\nu \Psi^\dagger)
+ \Lambda_0^2 g^{\mu\nu}.
\]
\end{definition}

\begin{definition}[Multi-Scale Potential]
\[
\mathcal{V}(\Psi)
= m^2 |\Psi|^2
+ \lambda_{\text{self}} |\Psi|^4
+ \gamma_{\text{nonB}} \ln(1 + |\Psi|^2).
\]
\end{definition}

\begin{definition}[Spectral Flux Vector]
\[
\Phi_{\text{spec}}^\mu
= J^\mu_{\text{topology}}
+ \epsilon^{\mu\nu\rho\sigma}
(\nabla_\nu \mathcal{A}_\rho)\mathcal{A}_\sigma.
\]
\end{definition}

\begin{definition}[Regulatory Coupling Matrix]
\[
\tilde{\Lambda}
= \alpha_{\mathcal{R}} \mathcal{R}
+ \beta_{\Omega} \rho_{\Omega}.
\]
\end{definition}

% =========================================================
% CHAPTER 3 — Variational Action
% =========================================================
\chapter{Variational Action}

\section{Total Action Functional}
\[
\mathcal{S}_{\text{total}}
= \int_{\mathcal{M}}
\left[
\mathcal{K}^{\mu\nu} (\partial_\mu \Psi)(\partial_\nu \Psi^\dagger)
- \mathcal{V}(\Psi)
+ \Phi_{\text{spec}}^\mu \partial_\mu \Psi
+ \tilde{\Lambda} |\Psi|^2
\right]
\sqrt{|g|}\, d^4x.
\]

\section{Euler--Lagrange Variation}
\[
\frac{\delta \mathcal{S}_{\text{total}}}{\delta \Psi^\dagger} = 0.
\]

\begin{theorem}[Master Evolution Equation]
\[
\nabla_\mu(\mathcal{K}^{\mu\nu} \partial_\nu \Psi)
+ \mathcal{V}'(\Psi)
= \Phi_{\text{spec}}^\mu \partial_\mu \Psi
+ \tilde{\Lambda} \Psi.
\]
\end{theorem}

