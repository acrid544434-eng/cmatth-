\chapter{Physical Reduction Limits}

\section{General Relativity Limit}
\[
\Psi \to 0,\quad
\chi_{\text{anom}} \to 0,\quad
\mathcal{K}^{\mu\nu} \to g^{\mu\nu}
\Rightarrow
R_{\mu\nu} - \frac{1}{2} R g_{\mu\nu}
+ \Lambda_{\text{cc}} g_{\mu\nu} = 0.
\]

\section{Magnetohydrodynamics Limit}
\[
\partial_t \ll \nabla,\quad
\mathcal{K}^{ij} \to \sigma_{\text{cond}} \delta^{ij}
\Rightarrow
\partial_t \mathbf{B}
= \nabla \times (\mathbf{v} \times \mathbf{B})
- \nabla \times (\eta\, \nabla \times \mathbf{B}).
\]

