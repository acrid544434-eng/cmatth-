🔶 4. Drift Calculation — The Diagnostic Layer

fn compute_drift(&self, input: &InputFrame) -> f32 {
    let sum = input.boundary
            + input.signal
            + input.recognition
            + input.genomic
            + input.energy;

    sum / 5.0
}

