fn generate_output(&self, drift: f32) -> OutputFrame {
    OutputFrame {
        boundary_fix: drift > 0.3,
        signal_fix: drift > 0.4,
        immune_fix: drift > 0.5,
        genomic_fix: drift > 0.6,
        coherence_sync: drift > 0.2,
    }
}

