🔶 5. State Transitions — The Behavioral Logic

fn transition(&self, drift: f32) -> KernelState {
    match drift {
        d if d < 0.2 => KernelState::Stable,
        d if d < 0.4 => KernelState::Warning,
        d if d < 0.6 => KernelState::Correction,
        d if d < 0.8 => KernelState::Recovery,
        _            => KernelState::Lockdown,
    }
}

