\subsection{Polyphase Filter Bank Channelizer Execution}
High dynamic range channelization requires separating overlapping frequency bins while preventing side-lobe spectral leakage. The algorithm cascades an $M$-channel polyphase sub-filter network before computing an $M$-point Fast Fourier Transform (FFT), as formalized in Algorithm~\ref{alg:pfb}.

\begin{algorithm}[h]
\caption{Polyphase Filter Bank (PFB) Channelizer Core}\label{alg:pfb}
\begin{algorithmic}[1]
\Require Continuous input stream $x[n]$, prototype coefficients $h[n]$ of length $L = M \cdot P$, channel count $M$, tap depth $P$.
\Ensure Channelized spectrum matrix $Y[k, m]$.
\State Reshape $h[n]$ into polyphase sub-filter matrix $E_{p}[m] = h[m \cdot P + p]$ where $p \in [0, P-1], m \in [0, M-1]$.
\For{each incoming sample frame block $r \ge 0$}
    \State Extract windowed vector $\mathbf{x}_r = x[r M : r M + L - 1]$.
    \State Reshape $\mathbf{x}_r$ into block buffer $X_{p}[m] = \mathbf{x}_r[p \cdot M + m]$.
    \State Compute branch convolutions:
    \Statex \qquad $v_r[m] = \sum_{p=0}^{P-1} X_{p}[m] \cdot E_{p}[m]$
    \State Compute spatial channel spectrum:
    \Statex \qquad $Y[r, k] = \sum_{m=0}^{M-1} v_r[m] \cdot \exp\left(-j \frac{2\pi k m}{M}\right)$
\EndFor
\State \Return $Y[r, k]$
\end{algorithmic}
\end{algorithm}

