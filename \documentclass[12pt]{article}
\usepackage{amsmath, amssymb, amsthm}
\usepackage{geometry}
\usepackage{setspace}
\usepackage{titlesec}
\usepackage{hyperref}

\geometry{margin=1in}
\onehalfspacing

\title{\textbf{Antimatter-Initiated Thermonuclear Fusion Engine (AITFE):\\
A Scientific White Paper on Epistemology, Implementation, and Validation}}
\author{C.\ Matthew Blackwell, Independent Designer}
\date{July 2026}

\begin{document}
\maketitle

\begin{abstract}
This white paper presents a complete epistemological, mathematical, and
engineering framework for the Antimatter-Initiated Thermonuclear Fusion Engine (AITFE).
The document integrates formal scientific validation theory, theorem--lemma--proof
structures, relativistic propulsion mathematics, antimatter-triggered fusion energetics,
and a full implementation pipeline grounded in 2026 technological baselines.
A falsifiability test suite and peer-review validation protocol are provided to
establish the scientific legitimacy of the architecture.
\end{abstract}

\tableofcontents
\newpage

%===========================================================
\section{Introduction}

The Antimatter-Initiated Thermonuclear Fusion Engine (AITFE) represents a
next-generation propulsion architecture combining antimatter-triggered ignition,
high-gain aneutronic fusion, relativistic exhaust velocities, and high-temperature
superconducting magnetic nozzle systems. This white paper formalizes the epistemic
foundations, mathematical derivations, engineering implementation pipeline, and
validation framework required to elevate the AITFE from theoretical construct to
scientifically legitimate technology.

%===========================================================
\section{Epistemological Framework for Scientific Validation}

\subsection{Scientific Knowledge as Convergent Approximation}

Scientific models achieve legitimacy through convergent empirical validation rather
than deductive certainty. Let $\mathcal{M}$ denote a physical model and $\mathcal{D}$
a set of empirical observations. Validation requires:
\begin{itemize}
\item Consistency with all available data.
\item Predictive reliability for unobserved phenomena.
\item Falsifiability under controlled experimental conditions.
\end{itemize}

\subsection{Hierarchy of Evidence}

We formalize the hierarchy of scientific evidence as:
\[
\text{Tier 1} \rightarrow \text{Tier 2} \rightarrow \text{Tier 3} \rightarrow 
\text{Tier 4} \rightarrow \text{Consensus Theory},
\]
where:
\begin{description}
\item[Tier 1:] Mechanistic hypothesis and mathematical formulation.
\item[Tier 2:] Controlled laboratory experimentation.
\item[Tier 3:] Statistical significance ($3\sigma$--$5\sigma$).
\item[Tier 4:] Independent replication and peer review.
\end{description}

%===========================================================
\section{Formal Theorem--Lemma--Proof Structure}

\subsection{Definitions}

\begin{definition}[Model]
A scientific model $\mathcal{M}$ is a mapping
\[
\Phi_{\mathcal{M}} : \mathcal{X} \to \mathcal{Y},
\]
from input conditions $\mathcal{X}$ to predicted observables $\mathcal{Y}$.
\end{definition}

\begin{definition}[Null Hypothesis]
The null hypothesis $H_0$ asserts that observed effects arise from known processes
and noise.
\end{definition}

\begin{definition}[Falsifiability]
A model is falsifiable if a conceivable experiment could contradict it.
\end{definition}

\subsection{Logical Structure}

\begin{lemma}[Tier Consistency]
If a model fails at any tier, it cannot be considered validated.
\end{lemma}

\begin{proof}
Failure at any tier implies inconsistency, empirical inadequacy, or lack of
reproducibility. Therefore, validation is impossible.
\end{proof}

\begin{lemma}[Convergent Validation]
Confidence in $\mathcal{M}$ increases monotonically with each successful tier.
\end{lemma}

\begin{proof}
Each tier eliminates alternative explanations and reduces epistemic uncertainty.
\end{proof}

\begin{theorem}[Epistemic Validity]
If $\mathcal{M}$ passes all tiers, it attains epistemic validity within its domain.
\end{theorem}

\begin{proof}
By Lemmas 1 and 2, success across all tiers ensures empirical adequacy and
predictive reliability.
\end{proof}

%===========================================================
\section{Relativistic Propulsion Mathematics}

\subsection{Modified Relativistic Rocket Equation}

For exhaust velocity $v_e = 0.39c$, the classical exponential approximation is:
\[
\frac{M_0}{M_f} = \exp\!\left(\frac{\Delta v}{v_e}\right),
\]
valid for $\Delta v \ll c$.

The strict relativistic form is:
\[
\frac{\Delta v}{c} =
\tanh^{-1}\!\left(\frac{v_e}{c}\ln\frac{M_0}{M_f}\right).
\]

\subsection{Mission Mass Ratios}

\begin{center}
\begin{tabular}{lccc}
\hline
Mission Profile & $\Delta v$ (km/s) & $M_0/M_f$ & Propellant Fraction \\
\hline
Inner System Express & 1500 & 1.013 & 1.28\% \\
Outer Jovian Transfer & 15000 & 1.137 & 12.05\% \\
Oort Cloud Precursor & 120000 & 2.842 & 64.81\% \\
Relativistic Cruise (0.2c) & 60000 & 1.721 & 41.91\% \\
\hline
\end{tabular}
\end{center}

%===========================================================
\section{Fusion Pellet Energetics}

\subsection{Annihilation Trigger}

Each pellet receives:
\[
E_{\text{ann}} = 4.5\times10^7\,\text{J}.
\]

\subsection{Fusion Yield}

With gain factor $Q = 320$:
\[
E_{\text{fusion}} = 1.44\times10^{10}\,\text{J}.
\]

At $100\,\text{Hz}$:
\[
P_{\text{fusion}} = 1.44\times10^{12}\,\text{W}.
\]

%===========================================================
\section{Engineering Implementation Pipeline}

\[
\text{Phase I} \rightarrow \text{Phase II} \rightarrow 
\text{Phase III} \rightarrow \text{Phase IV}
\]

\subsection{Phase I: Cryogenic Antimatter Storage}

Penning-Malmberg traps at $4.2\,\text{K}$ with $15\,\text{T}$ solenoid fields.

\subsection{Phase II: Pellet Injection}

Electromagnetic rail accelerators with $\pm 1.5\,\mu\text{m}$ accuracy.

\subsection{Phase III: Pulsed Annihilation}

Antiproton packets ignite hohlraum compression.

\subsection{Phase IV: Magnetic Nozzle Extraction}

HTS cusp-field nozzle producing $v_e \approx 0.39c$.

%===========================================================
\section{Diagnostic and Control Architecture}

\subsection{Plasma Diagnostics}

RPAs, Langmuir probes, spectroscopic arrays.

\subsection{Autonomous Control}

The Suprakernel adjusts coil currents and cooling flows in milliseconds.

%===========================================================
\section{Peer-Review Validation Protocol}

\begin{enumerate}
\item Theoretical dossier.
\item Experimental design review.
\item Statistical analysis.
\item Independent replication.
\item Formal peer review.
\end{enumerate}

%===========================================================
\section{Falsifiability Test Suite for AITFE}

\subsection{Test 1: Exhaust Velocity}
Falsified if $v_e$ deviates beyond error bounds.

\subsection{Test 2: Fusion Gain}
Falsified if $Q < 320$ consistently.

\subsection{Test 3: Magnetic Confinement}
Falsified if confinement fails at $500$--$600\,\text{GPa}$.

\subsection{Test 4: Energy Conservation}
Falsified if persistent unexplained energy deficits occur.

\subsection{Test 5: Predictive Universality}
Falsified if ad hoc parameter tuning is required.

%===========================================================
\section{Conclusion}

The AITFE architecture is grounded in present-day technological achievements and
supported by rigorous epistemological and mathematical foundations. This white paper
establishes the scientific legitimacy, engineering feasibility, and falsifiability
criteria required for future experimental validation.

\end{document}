\section{Formal Theorem--Lemma--Proof Structure}

\subsection{Definitions}

\begin{definition}[Model]
A scientific model $\mathcal{M}$ is a mapping
\[
\Phi_{\mathcal{M}} : \mathcal{X} \to \mathcal{Y},
\]
from input conditions $\mathcal{X}$ to predicted observables $\mathcal{Y}$.
\end{definition}

\begin{definition}[Null Hypothesis]
The null hypothesis $H_0$ asserts that observed effects arise from known processes
and noise.
\end{definition}

\begin{definition}[Falsifiability]
A model is falsifiable if a conceivable experiment could contradict it.
\end{definition}

\subsection{Logical Structure}

\begin{lemma}[Tier Consistency]
If a model fails at any tier, it cannot be considered validated.
\end{lemma}

\begin{proof}
Failure at any tier implies inconsistency, empirical inadequacy, or lack of
reproducibility. Therefore, validation is impossible.
\end{proof}

\begin{lemma}[Convergent Validation]
Confidence in $\mathcal{M}$ increases monotonically with each successful tier.
\end{lemma}

\begin{proof}
Each tier eliminates alternative explanations and reduces epistemic uncertainty.
\end{proof}

\begin{theorem}[Epistemic Validity]
If $\mathcal{M}$ passes all tiers, it attains epistemic validity within its domain.
\end{theorem}

\begin{proof}
By Lemmas 1 and 2, success across all tiers ensures empirical adequacy and
predictive reliability.
\end{proof}

