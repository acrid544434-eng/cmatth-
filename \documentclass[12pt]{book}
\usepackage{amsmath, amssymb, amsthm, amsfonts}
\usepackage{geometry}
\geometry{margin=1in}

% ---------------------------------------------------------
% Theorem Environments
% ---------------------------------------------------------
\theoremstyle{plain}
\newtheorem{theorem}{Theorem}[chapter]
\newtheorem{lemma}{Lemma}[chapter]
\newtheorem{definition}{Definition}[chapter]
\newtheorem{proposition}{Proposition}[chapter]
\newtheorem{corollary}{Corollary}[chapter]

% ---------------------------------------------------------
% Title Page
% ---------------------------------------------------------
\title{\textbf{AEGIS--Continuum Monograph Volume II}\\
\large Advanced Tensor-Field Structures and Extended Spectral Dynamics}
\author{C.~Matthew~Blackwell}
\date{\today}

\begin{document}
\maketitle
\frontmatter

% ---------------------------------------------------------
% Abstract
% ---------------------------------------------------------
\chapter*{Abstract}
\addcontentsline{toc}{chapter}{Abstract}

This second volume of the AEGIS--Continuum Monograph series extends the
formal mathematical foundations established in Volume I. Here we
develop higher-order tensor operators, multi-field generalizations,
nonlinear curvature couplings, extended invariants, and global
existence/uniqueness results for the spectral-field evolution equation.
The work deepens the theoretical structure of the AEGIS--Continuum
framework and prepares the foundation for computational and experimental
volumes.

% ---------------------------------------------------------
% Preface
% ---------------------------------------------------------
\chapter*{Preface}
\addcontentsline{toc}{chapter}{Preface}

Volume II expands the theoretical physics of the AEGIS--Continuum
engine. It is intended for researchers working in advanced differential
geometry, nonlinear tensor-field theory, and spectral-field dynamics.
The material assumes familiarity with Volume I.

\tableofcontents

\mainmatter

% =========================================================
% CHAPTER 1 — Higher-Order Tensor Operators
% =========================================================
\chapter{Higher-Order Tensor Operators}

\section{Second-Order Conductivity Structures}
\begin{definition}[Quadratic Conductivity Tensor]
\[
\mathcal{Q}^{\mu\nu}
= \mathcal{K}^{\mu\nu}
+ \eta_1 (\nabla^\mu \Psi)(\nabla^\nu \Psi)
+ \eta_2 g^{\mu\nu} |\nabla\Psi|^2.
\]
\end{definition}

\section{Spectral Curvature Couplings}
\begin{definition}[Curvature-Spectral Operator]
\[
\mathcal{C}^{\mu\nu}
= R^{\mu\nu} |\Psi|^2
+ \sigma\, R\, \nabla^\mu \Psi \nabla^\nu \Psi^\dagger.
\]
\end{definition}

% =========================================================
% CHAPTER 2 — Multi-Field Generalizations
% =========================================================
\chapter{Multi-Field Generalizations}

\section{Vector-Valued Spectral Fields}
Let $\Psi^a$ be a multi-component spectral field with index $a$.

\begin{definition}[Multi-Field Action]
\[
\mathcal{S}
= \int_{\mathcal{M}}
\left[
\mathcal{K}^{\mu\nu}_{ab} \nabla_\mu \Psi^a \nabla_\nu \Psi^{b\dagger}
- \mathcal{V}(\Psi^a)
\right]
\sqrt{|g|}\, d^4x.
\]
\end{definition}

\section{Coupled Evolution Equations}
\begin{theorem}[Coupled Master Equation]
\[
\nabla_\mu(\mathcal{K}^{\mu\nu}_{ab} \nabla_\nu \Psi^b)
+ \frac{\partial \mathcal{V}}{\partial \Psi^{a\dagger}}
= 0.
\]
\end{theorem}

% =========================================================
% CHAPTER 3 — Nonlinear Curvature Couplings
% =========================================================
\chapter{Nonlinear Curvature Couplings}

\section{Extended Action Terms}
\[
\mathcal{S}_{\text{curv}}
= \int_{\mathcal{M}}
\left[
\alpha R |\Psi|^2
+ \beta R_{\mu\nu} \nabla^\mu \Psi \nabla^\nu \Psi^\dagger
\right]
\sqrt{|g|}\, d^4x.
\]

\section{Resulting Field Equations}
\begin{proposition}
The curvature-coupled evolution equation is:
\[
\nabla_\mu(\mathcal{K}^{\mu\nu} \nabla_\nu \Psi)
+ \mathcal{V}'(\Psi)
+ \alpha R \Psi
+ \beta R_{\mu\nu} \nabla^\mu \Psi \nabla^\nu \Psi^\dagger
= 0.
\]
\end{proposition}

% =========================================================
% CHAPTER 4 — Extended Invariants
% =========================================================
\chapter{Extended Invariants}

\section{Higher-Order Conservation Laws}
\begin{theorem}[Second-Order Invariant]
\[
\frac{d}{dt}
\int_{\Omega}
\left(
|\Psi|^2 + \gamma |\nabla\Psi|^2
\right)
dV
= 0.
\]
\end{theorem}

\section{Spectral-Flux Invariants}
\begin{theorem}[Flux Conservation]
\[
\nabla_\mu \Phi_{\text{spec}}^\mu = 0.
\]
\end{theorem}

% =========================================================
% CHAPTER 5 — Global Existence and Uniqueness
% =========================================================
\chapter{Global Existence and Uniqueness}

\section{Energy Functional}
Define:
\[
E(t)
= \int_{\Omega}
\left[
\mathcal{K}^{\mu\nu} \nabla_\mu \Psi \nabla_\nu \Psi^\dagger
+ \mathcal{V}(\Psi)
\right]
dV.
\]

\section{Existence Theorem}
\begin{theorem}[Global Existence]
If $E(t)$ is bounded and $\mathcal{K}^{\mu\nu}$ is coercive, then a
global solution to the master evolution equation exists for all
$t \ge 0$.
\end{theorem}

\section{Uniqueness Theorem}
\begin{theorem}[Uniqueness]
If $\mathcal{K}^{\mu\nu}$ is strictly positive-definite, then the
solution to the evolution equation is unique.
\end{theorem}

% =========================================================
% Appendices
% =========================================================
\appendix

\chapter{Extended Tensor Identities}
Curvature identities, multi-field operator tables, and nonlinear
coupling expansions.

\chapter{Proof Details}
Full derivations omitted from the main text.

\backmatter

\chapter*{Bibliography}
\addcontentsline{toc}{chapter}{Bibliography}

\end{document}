\chapter{Extended Invariants}

\section{Higher-Order Conservation Laws}
\begin{theorem}[Second-Order Invariant]
\[
\frac{d}{dt}
\int_{\Omega}
\left(
|\Psi|^2 + \gamma |\nabla\Psi|^2
\right)
dV
= 0.
\]
\end{theorem}

\section{Spectral-Flux Invariants}
\begin{theorem}[Flux Conservation]
\[
\nabla_\mu \Phi_{\text{spec}}^\mu = 0.
\]
\end{theorem}

