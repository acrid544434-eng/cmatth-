\chapter{Higher-Order Tensor Operators}

\section{Second-Order Conductivity Structures}
\begin{definition}[Quadratic Conductivity Tensor]
\[
\mathcal{Q}^{\mu\nu}
= \mathcal{K}^{\mu\nu}
+ \eta_1 (\nabla^\mu \Psi)(\nabla^\nu \Psi)
+ \eta_2 g^{\mu\nu} |\nabla\Psi|^2.
\]
\end{definition}

\section{Spectral Curvature Couplings}
\begin{definition}[Curvature-Spectral Operator]
\[
\mathcal{C}^{\mu\nu}
= R^{\mu\nu} |\Psi|^2
+ \sigma\, R\, \nabla^\mu \Psi \nabla^\nu \Psi^\dagger.
\]
\end{definition}

