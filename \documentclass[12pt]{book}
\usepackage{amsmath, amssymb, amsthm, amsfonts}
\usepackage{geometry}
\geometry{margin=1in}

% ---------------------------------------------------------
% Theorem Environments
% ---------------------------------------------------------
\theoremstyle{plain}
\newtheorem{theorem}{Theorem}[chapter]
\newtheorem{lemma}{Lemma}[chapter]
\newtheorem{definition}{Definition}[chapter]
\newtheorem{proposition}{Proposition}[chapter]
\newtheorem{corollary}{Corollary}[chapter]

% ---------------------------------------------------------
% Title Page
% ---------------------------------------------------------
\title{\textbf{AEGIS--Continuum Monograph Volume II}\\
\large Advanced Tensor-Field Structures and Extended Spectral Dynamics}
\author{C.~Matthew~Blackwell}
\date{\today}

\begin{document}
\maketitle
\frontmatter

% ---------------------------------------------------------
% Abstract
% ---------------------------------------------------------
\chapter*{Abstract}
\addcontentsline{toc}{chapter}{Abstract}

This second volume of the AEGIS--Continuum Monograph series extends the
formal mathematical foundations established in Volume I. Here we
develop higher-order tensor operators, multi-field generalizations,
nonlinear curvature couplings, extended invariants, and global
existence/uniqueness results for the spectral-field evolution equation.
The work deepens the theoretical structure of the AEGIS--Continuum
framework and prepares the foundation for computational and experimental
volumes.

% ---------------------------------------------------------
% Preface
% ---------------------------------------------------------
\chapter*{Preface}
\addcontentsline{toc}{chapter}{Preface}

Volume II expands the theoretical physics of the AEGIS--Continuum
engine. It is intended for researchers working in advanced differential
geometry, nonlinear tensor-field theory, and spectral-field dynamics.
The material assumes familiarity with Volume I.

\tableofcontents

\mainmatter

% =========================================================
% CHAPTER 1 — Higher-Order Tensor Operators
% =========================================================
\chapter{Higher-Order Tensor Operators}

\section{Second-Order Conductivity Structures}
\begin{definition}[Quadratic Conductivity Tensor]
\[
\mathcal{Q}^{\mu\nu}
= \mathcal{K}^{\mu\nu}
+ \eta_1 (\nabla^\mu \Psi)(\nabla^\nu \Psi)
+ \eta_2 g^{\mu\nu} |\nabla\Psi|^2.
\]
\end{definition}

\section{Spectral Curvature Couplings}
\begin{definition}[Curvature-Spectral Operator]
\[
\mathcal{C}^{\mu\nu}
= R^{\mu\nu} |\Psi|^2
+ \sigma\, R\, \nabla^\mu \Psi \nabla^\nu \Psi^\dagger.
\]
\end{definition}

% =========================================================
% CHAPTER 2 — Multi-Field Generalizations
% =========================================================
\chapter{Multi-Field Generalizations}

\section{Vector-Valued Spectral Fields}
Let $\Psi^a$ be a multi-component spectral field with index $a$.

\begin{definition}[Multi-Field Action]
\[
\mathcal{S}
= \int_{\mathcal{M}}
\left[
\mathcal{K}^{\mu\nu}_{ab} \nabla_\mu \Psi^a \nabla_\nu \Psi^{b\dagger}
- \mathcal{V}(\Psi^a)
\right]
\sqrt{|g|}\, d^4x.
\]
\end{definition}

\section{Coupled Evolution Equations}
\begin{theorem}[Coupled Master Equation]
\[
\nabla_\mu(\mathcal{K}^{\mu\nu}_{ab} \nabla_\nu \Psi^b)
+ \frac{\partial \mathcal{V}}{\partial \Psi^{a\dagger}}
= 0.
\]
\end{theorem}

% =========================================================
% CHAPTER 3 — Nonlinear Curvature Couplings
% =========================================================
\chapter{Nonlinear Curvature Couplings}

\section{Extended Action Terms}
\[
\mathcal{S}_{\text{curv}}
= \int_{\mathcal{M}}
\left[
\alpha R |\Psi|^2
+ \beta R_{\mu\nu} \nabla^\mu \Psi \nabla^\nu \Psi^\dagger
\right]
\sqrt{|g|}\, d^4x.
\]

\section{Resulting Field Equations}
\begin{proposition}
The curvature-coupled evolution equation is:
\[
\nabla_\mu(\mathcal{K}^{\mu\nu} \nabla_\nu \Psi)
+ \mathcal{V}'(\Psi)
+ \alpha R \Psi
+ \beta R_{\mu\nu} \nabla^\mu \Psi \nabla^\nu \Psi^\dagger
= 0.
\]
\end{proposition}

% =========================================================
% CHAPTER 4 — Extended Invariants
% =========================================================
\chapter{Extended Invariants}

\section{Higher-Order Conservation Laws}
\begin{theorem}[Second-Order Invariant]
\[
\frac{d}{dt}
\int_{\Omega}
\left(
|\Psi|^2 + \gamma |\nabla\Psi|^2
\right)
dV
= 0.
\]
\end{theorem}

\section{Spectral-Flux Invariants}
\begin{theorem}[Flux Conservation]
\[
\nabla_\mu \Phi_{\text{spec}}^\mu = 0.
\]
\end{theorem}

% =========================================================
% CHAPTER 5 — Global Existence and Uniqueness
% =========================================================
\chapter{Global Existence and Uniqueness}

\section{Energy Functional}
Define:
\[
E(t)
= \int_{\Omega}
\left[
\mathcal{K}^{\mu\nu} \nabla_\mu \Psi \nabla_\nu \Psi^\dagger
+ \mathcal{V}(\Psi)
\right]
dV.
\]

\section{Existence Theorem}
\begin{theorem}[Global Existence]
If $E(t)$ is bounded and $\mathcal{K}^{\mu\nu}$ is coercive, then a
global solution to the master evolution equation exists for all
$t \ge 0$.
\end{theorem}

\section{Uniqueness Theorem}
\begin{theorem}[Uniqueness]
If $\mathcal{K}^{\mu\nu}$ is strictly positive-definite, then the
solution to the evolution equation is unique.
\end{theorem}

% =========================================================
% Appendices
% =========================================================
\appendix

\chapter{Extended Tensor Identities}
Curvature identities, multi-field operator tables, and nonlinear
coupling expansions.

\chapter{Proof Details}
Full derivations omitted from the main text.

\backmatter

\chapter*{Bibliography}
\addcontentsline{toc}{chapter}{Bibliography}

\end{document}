\chapter{Nonlinear Curvature Couplings}

\section{Extended Action Terms}
\[
\mathcal{S}_{\text{curv}}
= \int_{\mathcal{M}}
\left[
\alpha R |\Psi|^2
+ \beta R_{\mu\nu} \nabla^\mu \Psi \nabla^\nu \Psi^\dagger
\right]
\sqrt{|g|}\, d^4x.
\]

\section{Resulting Field Equations}
\begin{proposition}
The curvature-coupled evolution equation is:
\[
\nabla_\mu(\mathcal{K}^{\mu\nu} \nabla_\nu \Psi)
+ \mathcal{V}'(\Psi)
+ \alpha R \Psi
+ \beta R_{\mu\nu} \nabla^\mu \Psi \nabla^\nu \Psi^\dagger
= 0.
\]
\end{proposition}

