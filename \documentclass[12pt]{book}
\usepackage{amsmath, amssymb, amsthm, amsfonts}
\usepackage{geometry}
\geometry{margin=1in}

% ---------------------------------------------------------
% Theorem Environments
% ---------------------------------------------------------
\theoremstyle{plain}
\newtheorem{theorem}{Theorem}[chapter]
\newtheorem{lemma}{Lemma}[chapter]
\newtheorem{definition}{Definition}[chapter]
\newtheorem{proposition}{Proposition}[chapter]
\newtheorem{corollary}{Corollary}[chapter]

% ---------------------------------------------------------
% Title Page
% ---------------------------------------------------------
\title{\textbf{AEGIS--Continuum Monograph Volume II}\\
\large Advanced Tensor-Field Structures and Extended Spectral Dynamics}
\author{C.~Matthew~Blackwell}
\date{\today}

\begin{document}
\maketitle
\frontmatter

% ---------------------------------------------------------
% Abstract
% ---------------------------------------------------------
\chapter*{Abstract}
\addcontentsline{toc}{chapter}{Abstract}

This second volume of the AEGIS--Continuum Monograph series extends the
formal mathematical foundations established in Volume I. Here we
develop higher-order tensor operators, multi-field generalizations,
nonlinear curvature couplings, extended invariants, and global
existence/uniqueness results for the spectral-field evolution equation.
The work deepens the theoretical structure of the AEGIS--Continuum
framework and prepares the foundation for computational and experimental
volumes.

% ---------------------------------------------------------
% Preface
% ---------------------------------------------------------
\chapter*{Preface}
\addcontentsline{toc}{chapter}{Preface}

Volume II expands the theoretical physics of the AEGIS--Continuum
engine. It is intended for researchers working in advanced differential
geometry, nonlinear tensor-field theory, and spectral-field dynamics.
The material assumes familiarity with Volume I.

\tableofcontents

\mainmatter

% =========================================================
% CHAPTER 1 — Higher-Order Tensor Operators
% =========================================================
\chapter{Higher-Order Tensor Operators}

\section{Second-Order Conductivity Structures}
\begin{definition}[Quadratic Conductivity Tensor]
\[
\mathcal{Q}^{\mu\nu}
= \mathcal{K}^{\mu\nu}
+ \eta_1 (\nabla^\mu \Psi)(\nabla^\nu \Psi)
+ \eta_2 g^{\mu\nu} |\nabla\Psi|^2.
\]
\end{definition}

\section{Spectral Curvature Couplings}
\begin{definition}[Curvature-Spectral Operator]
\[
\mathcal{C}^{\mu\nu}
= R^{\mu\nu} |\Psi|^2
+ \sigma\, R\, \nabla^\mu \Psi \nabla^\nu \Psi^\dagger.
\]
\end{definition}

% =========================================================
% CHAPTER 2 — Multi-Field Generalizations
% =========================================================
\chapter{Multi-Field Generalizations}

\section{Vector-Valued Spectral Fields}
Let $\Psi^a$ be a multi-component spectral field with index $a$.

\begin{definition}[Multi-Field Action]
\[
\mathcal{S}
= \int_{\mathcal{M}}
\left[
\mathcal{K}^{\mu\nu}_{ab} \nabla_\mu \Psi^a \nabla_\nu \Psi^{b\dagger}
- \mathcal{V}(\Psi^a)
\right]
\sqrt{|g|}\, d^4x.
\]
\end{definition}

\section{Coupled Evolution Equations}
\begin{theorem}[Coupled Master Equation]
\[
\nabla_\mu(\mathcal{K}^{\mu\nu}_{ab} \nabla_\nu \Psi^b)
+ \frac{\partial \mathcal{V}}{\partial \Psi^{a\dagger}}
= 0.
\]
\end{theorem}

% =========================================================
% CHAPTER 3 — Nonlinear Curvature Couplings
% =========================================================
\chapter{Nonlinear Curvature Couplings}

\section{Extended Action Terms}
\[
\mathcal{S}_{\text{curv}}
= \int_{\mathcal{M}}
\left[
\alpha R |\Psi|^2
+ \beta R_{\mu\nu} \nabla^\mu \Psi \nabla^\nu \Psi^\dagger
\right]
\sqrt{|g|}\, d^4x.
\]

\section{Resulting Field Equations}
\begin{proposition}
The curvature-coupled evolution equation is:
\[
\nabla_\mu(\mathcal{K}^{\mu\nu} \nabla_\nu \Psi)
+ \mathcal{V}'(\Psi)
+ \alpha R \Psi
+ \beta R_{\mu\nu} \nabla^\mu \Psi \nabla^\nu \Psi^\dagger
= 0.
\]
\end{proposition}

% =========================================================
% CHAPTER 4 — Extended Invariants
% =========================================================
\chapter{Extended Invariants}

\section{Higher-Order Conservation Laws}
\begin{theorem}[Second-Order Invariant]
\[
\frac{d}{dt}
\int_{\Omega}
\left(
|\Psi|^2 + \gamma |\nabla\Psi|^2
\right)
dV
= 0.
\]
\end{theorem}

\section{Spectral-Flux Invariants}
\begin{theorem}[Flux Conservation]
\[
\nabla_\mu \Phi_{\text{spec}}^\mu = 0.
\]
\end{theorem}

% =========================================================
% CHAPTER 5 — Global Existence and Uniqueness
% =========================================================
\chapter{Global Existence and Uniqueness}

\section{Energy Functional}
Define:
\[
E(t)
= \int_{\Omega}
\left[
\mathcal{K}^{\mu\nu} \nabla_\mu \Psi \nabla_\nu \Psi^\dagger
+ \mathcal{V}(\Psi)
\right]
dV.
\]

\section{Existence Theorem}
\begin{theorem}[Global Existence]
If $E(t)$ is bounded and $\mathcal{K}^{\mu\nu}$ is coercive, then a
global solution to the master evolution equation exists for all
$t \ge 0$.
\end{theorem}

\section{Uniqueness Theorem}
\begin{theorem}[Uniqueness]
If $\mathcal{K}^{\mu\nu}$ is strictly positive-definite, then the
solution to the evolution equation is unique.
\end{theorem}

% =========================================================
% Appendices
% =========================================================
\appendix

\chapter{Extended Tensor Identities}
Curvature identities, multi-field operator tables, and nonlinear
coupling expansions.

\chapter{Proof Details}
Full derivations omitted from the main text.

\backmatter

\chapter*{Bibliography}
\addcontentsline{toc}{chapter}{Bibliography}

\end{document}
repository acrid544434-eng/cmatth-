\chapter{Global Existence and Uniqueness}

\section{Energy Functional}
Define:
\[
E(t)
= \int_{\Omega}
\left[
\mathcal{K}^{\mu\nu} \nabla_\mu \Psi \nabla_\nu \Psi^\dagger
+ \mathcal{V}(\Psi)
\right]
dV.
\]

\section{Existence Theorem}
\begin{theorem}[Global Existence]
If $E(t)$ is bounded and $\mathcal{K}^{\mu\nu}$ is coercive, then a
global solution to the master evolution equation exists for all
$t \ge 0$.
\end{theorem}

\section{Uniqueness Theorem}
\begin{theorem}[Uniqueness]
If $\mathcal{K}^{\mu\nu}$ is strictly positive-definite, then the
solution to the evolution equation is unique.
\end{theorem}

