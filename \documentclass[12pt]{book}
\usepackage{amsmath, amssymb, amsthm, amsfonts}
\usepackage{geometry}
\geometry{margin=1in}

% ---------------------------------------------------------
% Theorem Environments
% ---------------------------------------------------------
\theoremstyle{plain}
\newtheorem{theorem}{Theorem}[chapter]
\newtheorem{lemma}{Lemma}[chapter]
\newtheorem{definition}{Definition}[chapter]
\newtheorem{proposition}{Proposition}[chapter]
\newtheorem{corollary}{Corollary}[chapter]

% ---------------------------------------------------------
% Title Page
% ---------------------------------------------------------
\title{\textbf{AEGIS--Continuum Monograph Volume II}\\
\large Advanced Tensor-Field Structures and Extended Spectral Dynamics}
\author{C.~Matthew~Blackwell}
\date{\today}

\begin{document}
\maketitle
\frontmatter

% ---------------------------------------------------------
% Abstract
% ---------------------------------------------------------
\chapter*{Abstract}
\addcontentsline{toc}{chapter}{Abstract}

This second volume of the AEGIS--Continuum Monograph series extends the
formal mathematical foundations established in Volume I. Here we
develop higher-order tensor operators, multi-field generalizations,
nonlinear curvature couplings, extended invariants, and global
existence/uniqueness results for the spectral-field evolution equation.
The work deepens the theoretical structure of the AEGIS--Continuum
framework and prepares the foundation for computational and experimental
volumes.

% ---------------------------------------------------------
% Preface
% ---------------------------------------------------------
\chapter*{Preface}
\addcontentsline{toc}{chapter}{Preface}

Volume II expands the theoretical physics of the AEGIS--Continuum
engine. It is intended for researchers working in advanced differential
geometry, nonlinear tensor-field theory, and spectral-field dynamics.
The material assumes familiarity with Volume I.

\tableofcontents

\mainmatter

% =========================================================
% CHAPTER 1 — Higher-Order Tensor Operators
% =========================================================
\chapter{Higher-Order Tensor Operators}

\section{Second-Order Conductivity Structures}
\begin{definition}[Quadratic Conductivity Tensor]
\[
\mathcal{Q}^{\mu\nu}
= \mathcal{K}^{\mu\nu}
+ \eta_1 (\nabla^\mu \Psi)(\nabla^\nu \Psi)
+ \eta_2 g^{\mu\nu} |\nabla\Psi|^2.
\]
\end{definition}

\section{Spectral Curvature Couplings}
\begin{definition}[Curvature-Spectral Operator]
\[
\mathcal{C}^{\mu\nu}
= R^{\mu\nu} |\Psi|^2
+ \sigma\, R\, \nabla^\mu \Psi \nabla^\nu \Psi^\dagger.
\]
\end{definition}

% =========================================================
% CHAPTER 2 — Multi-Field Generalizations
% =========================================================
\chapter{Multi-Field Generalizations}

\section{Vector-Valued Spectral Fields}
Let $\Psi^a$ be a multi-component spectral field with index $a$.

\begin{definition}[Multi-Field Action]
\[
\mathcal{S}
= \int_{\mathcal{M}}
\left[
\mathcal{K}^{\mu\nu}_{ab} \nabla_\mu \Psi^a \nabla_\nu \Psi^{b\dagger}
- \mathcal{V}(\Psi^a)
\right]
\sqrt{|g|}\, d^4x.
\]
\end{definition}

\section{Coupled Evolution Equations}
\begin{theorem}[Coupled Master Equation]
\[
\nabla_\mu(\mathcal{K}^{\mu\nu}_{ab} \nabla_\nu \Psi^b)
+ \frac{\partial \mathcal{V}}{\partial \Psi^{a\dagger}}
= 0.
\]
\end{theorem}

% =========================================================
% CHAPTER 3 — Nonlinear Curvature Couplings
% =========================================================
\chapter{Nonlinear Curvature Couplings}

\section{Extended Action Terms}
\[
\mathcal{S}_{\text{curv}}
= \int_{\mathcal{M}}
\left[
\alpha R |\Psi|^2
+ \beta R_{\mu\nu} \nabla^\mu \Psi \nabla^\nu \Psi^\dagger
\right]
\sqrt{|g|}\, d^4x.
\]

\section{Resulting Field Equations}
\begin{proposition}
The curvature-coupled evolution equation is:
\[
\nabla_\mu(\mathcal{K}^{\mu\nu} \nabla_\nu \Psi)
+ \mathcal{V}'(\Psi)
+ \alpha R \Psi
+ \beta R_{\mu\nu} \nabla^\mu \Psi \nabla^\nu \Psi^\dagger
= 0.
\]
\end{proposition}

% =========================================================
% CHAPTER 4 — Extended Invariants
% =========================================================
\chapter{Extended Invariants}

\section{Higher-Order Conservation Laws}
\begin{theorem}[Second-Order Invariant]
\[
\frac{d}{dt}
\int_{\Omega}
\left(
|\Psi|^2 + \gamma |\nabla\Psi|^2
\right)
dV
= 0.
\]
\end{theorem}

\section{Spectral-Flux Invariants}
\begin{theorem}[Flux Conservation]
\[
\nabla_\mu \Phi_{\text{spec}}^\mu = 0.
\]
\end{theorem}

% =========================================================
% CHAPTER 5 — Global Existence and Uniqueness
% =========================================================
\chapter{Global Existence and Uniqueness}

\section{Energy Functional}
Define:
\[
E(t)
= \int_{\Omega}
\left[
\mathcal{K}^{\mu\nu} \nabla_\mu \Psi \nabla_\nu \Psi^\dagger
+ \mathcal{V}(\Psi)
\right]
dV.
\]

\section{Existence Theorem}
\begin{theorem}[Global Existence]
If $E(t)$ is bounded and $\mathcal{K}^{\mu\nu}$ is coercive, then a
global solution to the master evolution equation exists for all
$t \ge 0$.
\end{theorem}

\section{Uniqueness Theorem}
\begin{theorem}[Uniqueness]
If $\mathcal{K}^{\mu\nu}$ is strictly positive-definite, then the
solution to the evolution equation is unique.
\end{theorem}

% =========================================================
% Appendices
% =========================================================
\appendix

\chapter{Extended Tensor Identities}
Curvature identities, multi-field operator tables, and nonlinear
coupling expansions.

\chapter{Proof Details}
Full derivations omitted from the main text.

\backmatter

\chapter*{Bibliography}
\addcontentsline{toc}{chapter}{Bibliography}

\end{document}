\chapter{Multi-Field Generalizations}

\section{Vector-Valued Spectral Fields}
Let $\Psi^a$ be a multi-component spectral field with index $a$.

\begin{definition}[Multi-Field Action]
\[
\mathcal{S}
= \int_{\mathcal{M}}
\left[
\mathcal{K}^{\mu\nu}_{ab} \nabla_\mu \Psi^a \nabla_\nu \Psi^{b\dagger}
- \mathcal{V}(\Psi^a)
\right]
\sqrt{|g|}\, d^4x.
\]
\end{definition}

\section{Coupled Evolution Equations}
\begin{theorem}[Coupled Master Equation]
\[
\nabla_\mu(\mathcal{K}^{\mu\nu}_{ab} \nabla_\nu \Psi^b)
+ \frac{\partial \mathcal{V}}{\partial \Psi^{a\dagger}}
= 0.
\]
\end{theorem}

