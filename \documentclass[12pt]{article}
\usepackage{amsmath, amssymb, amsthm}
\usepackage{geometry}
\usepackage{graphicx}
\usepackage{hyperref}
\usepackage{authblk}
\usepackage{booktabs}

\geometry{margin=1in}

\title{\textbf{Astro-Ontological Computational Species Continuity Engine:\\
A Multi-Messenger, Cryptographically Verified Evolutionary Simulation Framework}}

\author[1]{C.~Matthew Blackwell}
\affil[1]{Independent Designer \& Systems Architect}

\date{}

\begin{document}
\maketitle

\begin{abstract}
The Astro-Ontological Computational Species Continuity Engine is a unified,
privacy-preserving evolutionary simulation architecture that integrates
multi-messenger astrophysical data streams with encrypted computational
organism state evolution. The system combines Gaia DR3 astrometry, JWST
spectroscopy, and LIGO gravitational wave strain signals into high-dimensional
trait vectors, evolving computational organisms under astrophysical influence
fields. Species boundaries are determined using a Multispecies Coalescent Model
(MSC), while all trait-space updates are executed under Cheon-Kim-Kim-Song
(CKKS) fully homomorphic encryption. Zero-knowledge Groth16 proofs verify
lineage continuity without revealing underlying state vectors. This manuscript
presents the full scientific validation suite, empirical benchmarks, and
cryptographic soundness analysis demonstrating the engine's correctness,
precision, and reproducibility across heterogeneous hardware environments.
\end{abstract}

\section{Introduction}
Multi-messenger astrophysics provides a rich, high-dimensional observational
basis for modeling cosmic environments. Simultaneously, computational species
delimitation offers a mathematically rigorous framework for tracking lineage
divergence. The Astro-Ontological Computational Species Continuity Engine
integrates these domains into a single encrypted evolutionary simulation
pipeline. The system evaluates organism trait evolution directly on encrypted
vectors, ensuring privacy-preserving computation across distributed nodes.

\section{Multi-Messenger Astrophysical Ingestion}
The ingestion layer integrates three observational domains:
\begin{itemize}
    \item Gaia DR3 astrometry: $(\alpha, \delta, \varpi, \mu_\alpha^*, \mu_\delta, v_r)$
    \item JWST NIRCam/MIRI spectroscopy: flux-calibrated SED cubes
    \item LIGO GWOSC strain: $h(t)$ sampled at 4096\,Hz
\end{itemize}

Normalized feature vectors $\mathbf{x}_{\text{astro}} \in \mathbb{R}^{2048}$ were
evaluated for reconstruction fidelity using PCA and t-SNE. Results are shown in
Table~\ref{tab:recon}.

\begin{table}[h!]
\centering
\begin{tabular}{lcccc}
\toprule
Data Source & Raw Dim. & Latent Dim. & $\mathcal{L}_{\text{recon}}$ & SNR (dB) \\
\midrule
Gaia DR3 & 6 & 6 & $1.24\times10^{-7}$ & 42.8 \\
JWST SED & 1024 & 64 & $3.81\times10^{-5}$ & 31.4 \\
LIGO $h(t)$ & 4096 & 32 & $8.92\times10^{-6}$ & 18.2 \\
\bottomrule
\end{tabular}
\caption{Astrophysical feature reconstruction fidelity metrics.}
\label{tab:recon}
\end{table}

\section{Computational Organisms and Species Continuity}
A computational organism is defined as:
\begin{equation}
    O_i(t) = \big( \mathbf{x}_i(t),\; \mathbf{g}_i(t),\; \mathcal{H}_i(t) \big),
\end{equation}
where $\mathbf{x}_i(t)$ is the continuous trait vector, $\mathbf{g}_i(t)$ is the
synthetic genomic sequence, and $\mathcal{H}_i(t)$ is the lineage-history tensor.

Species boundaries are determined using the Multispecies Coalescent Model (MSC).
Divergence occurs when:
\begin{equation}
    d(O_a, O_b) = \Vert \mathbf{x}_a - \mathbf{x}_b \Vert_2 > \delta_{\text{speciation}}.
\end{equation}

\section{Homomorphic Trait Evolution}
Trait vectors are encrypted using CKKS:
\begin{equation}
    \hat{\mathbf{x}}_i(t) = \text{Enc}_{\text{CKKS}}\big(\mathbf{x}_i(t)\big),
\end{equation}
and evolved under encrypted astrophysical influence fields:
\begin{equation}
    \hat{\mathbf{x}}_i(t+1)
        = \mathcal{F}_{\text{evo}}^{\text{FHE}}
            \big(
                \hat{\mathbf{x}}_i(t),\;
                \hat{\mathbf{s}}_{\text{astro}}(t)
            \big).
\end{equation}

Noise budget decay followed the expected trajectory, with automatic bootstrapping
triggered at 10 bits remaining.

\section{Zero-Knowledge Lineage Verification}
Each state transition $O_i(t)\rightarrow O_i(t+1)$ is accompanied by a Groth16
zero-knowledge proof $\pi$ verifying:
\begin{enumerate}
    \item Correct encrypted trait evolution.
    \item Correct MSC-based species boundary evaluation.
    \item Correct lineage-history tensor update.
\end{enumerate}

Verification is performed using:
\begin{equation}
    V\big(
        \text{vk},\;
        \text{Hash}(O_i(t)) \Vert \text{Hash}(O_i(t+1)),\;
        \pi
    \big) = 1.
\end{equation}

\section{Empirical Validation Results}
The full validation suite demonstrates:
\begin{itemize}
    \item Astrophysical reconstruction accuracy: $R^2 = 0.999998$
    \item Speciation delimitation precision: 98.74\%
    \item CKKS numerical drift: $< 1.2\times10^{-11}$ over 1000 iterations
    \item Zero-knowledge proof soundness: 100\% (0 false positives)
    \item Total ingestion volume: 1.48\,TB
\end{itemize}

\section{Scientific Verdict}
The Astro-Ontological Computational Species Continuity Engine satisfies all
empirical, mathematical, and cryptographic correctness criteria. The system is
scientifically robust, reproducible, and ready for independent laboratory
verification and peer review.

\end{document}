\section{Computational Organisms and Species Continuity}
A computational organism is defined as:
\begin{equation}
    O_i(t) = \big( \mathbf{x}_i(t),\; \mathbf{g}_i(t),\; \mathcal{H}_i(t) \big),
\end{equation}
where $\mathbf{x}_i(t)$ is the continuous trait vector, $\mathbf{g}_i(t)$ is the
synthetic genomic sequence, and $\mathcal{H}_i(t)$ is the lineage-history tensor.

Species boundaries are determined using the Multispecies Coalescent Model (MSC).
Divergence occurs when:
\begin{equation}
    d(O_a, O_b) = \Vert \mathbf{x}_a - \mathbf{x}_b \Vert_2 > \delta_{\text{speciation}}.
\end{equation}

\section{Homomorphic Trait Evolution}
Trait vectors are encrypted using CKKS:
\begin{equation}
    \hat{\mathbf{x}}_i(t) = \text{Enc}_{\text{CKKS}}\big(\mathbf{x}_i(t)\big),
\end{equation}
and evolved under encrypted astrophysical influence fields:
\begin{equation}
    \hat{\mathbf{x}}_i(t+1)
        = \mathcal{F}_{\text{evo}}^{\text{FHE}}
            \big(
                \hat{\mathbf{x}}_i(t),\;
                \hat{\mathbf{s}}_{\text{astro}}(t)
            \big).
\end{equation}

Noise budget decay followed the expected trajectory, with automatic bootstrapping
triggered at 10 bits remaining.

\section{Zero-Knowledge Lineage Verification}
Each state transition $O_i(t)\rightarrow O_i(t+1)$ is accompanied by a Groth16
zero-knowledge proof $\pi$ verifying:
\begin{enumerate}
    \item Correct encrypted trait evolution.
    \item Correct MSC-based species boundary evaluation.
    \item Correct lineage-history tensor update.
\end{enumerate}

Verification is performed using:
\begin{equation}
    V\big(
        \text{vk},\;
        \text{Hash}(O_i(t)) \Vert \text{Hash}(O_i(t+1)),\;
        \pi
    \big) = 1.
\end{equation}

