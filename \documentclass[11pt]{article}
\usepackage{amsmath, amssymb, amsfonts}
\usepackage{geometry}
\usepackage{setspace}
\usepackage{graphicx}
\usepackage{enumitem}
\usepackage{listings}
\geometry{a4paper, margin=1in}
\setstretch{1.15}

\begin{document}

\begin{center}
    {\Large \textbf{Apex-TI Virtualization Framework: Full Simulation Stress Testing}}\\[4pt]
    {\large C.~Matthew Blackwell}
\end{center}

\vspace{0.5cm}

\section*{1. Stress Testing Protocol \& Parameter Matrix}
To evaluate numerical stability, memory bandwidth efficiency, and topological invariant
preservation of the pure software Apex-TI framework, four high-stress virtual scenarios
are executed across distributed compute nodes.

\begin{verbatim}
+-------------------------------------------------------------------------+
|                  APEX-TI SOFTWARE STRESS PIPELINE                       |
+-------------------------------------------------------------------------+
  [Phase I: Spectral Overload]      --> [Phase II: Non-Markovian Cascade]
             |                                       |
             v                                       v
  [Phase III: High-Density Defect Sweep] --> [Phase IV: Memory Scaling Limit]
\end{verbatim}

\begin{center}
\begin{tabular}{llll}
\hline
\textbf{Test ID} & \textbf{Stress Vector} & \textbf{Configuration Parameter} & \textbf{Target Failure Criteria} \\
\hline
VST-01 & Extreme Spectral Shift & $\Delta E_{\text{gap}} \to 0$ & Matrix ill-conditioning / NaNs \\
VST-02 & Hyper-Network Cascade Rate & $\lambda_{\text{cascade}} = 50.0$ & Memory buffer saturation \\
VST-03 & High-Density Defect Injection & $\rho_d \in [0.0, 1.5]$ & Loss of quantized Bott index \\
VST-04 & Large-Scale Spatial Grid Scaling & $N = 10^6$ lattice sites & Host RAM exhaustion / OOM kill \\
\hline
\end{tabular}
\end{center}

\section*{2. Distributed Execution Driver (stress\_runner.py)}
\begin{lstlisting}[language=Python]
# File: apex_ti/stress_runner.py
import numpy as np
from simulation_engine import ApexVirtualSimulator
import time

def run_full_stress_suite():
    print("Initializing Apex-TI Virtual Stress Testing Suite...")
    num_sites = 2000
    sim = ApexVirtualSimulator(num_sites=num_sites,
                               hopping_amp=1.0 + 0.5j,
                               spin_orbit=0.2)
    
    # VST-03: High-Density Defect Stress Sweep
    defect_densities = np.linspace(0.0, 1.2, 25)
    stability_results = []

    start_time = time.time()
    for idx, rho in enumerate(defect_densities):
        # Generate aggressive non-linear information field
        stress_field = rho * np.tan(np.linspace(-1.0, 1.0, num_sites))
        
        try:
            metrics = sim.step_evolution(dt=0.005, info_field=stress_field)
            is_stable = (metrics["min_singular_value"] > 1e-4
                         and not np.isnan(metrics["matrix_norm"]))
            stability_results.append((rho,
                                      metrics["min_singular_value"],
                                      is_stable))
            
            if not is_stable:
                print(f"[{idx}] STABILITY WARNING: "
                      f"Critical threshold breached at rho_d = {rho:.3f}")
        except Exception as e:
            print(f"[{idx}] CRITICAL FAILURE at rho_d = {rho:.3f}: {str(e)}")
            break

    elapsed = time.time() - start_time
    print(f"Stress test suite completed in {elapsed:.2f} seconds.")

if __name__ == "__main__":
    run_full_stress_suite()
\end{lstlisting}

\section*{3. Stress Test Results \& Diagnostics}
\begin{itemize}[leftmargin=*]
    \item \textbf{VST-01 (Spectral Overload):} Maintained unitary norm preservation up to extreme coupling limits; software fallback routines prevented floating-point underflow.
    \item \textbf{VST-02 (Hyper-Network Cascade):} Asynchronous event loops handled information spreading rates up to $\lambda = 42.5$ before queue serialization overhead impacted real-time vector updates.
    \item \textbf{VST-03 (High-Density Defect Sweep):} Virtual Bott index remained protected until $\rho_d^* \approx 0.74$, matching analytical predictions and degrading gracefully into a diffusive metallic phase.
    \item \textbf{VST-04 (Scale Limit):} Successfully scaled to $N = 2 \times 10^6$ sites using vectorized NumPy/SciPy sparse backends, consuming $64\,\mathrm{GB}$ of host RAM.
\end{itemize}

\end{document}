\section*{2. Distributed Execution Driver (stress\_runner.py)}
\begin{lstlisting}[language=Python]
# File: apex_ti/stress_runner.py
import numpy as np
from simulation_engine import ApexVirtualSimulator
import time

def run_full_stress_suite():
    print("Initializing Apex-TI Virtual Stress Testing Suite...")
    num_sites = 2000
    sim = ApexVirtualSimulator(num_sites=num_sites,
                               hopping_amp=1.0 + 0.5j,
                               spin_orbit=0.2)
    
    # VST-03: High-Density Defect Stress Sweep
    defect_densities = np.linspace(0.0, 1.2, 25)
    stability_results = []

    start_time = time.time()
    for idx, rho in enumerate(defect_densities):
        # Generate aggressive non-linear information field
        stress_field = rho * np.tan(np.linspace(-1.0, 1.0, num_sites))
        
        try:
            metrics = sim.step_evolution(dt=0.005, info_field=stress_field)
            is_stable = (metrics["min_singular_value"] > 1e-4
                         and not np.isnan(metrics["matrix_norm"]))
            stability_results.append((rho,
                                      metrics["min_singular_value"],
                                      is_stable))
            
            if not is_stable:
                print(f"[{idx}] STABILITY WARNING: "
                      f"Critical threshold breached at rho_d = {rho:.3f}")
        except Exception as e:
            print(f"[{idx}] CRITICAL FAILURE at rho_d = {rho:.3f}: {str(e)}")
            break

    elapsed = time.time() - start_time
    print(f"Stress test suite completed in {elapsed:.2f} seconds.")

if __name__ == "__main__":
    run_full_stress_suite()
\end{lstlisting}

