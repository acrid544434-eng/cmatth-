\mathbf{v}_n(\mathbf{k}) = \nabla_{\mathbf{k}}E_n(\mathbf{k}),
\qquad
\Omega_{xy}^{\mathrm{eff}}(\mathbf{r},t)
= \Omega_{xy}(\mathbf{r},t)\,I(\mathbf{r},t),
