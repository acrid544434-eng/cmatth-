\section{Hamiltonian Reduction}
We partition the Hilbert space into low-energy edge states $\mathcal{P}$ and high-energy
bulk states $\mathcal{Q}$ using Löwdin partitioning. The effective Hamiltonian is
\[
H_{\mathrm{eff}}(E)
= H_{\mathcal{P}\mathcal{P}}
+ H_{\mathcal{P}\mathcal{Q}}
\left(E - H_{\mathcal{Q}\mathcal{Q}}\right)^{-1}
H_{\mathcal{Q}\mathcal{P}},
\]
which incorporates bulk-mediated self-energy corrections and stress-induced spectral
renormalization.

\section{Non-Hermitian Propagator}
The reduced quantum-network propagator is
\[
U(t) = \mathcal{T}\exp\left[-i\!\int_{t_0}^{t} H_{\mathrm{eff}}(\tau)\,d\tau
      - \int_{t_0}^{t} \Gamma(\tau)\,d\tau\right],
\]
where $\Gamma(\tau)$ encodes non-Markovian information dissipation and cascade leakage.

\section{Lindblad--Kupriyanov Stability}
Open-system evolution is governed by
\[
\frac{d\rho}{dt}
= -i[H_{\mathrm{eff}},\rho]
+ \sum_k\left(
L_k\rho L_k^\dagger
- \frac{1}{2}\{L_k^\dagger L_k,\rho\}
\right),
\]
ensuring trace preservation and positivity under defect-driven decoherence.

\section{Topology-to-Dynamics Mapping}
Macroscopic spreading velocities arise from
