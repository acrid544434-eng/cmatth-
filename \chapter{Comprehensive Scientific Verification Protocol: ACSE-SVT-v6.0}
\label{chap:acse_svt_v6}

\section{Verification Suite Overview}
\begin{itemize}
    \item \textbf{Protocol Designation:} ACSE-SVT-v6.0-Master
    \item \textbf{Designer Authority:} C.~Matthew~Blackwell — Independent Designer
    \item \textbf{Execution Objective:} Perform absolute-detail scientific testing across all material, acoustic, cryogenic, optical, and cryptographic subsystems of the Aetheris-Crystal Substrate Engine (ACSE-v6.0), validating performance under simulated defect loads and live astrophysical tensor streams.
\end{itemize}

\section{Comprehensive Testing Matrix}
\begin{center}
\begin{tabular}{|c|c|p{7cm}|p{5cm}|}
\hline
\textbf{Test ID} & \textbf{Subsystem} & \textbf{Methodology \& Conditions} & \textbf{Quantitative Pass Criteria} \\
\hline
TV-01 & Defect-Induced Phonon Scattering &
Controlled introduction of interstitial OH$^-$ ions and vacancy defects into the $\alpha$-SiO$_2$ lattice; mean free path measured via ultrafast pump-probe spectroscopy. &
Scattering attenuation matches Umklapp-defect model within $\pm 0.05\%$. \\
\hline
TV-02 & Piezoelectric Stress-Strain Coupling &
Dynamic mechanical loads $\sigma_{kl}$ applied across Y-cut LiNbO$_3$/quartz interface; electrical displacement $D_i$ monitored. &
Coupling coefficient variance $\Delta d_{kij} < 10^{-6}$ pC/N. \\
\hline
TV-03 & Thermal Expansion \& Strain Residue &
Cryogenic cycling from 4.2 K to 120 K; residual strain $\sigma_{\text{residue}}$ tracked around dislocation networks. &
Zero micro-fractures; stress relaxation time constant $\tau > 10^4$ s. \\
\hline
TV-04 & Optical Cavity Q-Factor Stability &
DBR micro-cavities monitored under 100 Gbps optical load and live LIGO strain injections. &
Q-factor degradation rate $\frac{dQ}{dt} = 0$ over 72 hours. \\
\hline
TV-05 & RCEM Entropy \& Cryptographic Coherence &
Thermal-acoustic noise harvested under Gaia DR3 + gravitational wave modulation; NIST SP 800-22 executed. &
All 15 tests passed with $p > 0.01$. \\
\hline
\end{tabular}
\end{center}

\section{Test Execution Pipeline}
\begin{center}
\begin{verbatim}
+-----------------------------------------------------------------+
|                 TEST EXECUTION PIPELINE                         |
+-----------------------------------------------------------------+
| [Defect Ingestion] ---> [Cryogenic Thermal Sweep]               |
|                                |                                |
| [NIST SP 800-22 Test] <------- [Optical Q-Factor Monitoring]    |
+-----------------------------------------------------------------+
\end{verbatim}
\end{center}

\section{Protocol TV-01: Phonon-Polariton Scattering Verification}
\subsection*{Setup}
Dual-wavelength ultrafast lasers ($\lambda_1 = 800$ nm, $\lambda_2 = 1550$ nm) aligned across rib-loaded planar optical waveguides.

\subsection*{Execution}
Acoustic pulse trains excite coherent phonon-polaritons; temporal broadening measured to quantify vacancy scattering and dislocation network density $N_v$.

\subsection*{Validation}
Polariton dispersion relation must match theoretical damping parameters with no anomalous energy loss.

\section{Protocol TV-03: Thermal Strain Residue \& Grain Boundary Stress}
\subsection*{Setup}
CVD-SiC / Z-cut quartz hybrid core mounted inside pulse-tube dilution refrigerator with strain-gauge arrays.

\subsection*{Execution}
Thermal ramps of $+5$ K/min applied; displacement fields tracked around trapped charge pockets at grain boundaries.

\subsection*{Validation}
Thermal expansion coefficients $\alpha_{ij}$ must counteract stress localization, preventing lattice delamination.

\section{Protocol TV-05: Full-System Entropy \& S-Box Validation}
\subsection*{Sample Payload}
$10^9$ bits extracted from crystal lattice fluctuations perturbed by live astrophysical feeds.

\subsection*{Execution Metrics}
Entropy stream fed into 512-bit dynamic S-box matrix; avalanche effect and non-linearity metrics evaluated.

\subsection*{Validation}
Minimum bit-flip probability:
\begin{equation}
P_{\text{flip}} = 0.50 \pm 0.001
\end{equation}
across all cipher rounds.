\section{Protocol TV-01: Phonon-Polariton Scattering Verification}
\subsection*{Setup}
Dual-wavelength ultrafast lasers ($\lambda_1 = 800$ nm, $\lambda_2 = 1550$ nm) aligned across rib-loaded planar optical waveguides.

\subsection*{Execution}
Acoustic pulse trains excite coherent phonon-polaritons; temporal broadening measured to quantify vacancy scattering and dislocation network density $N_v$.

\subsection*{Validation}
Polariton dispersion relation must match theoretical damping parameters with no anomalous energy loss.

\section{Protocol TV-03: Thermal Strain Residue \& Grain Boundary Stress}
\subsection*{Setup}
CVD-SiC / Z-cut quartz hybrid core mounted inside pulse-tube dilution refrigerator with strain-gauge arrays.

\subsection*{Execution}
Thermal ramps of $+5$ K/min applied; displacement fields tracked around trapped charge pockets at grain boundaries.

\subsection*{Validation}
Thermal expansion coefficients $\alpha_{ij}$ must counteract stress localization, preventing lattice delamination.

\section{Protocol TV-05: Full-System Entropy \& S-Box Validation}
\subsection*{Sample Payload}
$10^9$ bits extracted from crystal lattice fluctuations perturbed by live astrophysical feeds.

\subsection*{Execution Metrics}
Entropy stream fed into 512-bit dynamic S-box matrix; avalanche effect and non-linearity metrics evaluated.

\subsection*{Validation}
