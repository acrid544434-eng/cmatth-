import cupy as cp
import numpy as np

class AetherisErrorChecker:
    @staticmethod
    def validate_tensor_state(rho: cp.ndarray, u: cp.ndarray, B: cp.ndarray, p: cp.ndarray) -> dict:
        """
        Performs rigorous real-time numerical error checking across all primary 
        simulation state tensors to detect NaN, Inf, negative pressure, or 
        unphysical mass density anomalies.
        """
        errors = {}
        
        # 1. Check for NaN or Infinite values across state arrays
        if not cp.all(cp.isfinite(rho)):
            errors["rho_anomaly"] = "NaN or Inf detected in plasma density tensor (rho)."
        if not cp.all(cp.isfinite(u)):
            errors["u_anomaly"] = "NaN or Inf detected in velocity tensor (u)."
        if not cp.all(cp.isfinite(B)):
            errors["B_anomaly"] = "NaN or Inf detected in magnetic field tensor (B)."
        if not cp.all(cp.isfinite(p)):
            errors["p_anomaly"] = "NaN or Inf detected in thermal pressure tensor (p)."
            
        # 2. Check for physical boundary violations (Negative Density or Pressure)
        min_rho = float(cp.min(rho))
        min_p = float(cp.min(p))
        
        if min_rho <= 0.0:
            errors["negative_density"] = f"Unphysical negative/zero density encountered: {min_rho}"
        if min_p <= 0.0:
            errors["negative_pressure"] = f"Unphysical negative/zero thermal pressure encountered: {min_p}"
            
        # 3. Check Magnetic Divergence Threshold ($\nabla \cdot \mathbf{B}$)
        div_B = cp.abs(cp.sum(cp.gradient(B, axis=(0, 1, 2)), axis=0))
        max_div = float(cp.max(div_B))
        if max_div > 1e-6:
            errors["divergence_warning"] = f"Magnetic divergence exceeds stability threshold: {max_div:.7e}"
            
        is_valid = len(errors) == 0
        return {
            "is_valid": is_valid,
            "error_log": errors,
            "max_divergence": max_div,
            "designer": "C MATTHEW BLACKWELL"
        }

