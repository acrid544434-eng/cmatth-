\section*{Module Identity}

\begin{itemize}
    \item Entity: \texttt{STSU\_64Ch\_PFB\_Top}
    \item Language: VHDL-2008
    \item Target: AMD/Xilinx UltraScale+ (400 MHz)
    \item Interface: AXI4-Stream (512-bit wide)
\end{itemize}

\section{Generics}

\begin{itemize}
    \item $G\_\text{DATA\_WIDTH} = 512$
    \item $G\_\text{NUM\_CHANNELS} = 64$
    \item $G\_\text{COEFF\_WIDTH} = 18$
    \item $G\_\text{DSP\_A\_WIDTH} = 30$
    \item $G\_\text{DSP\_P\_WIDTH} = 48$
    \item $G\_\text{PIPE\_STAGES} = 4$
\end{itemize}

\section{Ports}

\begin{itemize}
    \item Clock: \texttt{clk} (400 MHz)
    \item Reset: \texttt{rst\_n} (active-low)
    \item Input stream: \texttt{s\_axis\_tdata[511:0]}, \texttt{s\_axis\_tvalid}, \texttt{s\_axis\_tready}
    \item Output stream: \texttt{m\_axis\_tdata[511:0]}, \texttt{m\_axis\_tvalid}, \texttt{m\_axis\_tready}
    \item Status: \texttt{pfb\_sync\_alert}
\end{itemize}

\section{Internal Architecture}

\subsection{Coefficient ROM}

\[
\text{addr} \in \{0,\dots,63\},\quad
\text{coeff\_out} \in \mathbb{Z}_{2^{18}}
\]

\subsection{DSP Slice Mapping}

\begin{itemize}
    \item A-port: sign-extended 16-bit sample $\to$ 30-bit
    \item B-port: 18-bit coefficient
    \item P-port: 48-bit accumulator output
\end{itemize}

\section{Pipeline and Control}

\begin{itemize}
    \item Address counter: 6-bit unsigned, rolls over at $G\_\text{NUM\_CHANNELS}-1$
    \item Valid pipeline: $G\_\text{PIPE\_STAGES}$-deep shift register
    \item Sync alert: asserted on channel 63 rollover with valid input
\end{itemize}

\section{Output Reconstruction}

\[
\texttt{m\_axis\_tdata}
=
\texttt{r\_data\_pipe[511:464]}
\;\Vert\;
\texttt{dsp\_p\_output[47:0]}
\;\Vert\;
\texttt{r\_data\_pipe[415:0]}
\]

