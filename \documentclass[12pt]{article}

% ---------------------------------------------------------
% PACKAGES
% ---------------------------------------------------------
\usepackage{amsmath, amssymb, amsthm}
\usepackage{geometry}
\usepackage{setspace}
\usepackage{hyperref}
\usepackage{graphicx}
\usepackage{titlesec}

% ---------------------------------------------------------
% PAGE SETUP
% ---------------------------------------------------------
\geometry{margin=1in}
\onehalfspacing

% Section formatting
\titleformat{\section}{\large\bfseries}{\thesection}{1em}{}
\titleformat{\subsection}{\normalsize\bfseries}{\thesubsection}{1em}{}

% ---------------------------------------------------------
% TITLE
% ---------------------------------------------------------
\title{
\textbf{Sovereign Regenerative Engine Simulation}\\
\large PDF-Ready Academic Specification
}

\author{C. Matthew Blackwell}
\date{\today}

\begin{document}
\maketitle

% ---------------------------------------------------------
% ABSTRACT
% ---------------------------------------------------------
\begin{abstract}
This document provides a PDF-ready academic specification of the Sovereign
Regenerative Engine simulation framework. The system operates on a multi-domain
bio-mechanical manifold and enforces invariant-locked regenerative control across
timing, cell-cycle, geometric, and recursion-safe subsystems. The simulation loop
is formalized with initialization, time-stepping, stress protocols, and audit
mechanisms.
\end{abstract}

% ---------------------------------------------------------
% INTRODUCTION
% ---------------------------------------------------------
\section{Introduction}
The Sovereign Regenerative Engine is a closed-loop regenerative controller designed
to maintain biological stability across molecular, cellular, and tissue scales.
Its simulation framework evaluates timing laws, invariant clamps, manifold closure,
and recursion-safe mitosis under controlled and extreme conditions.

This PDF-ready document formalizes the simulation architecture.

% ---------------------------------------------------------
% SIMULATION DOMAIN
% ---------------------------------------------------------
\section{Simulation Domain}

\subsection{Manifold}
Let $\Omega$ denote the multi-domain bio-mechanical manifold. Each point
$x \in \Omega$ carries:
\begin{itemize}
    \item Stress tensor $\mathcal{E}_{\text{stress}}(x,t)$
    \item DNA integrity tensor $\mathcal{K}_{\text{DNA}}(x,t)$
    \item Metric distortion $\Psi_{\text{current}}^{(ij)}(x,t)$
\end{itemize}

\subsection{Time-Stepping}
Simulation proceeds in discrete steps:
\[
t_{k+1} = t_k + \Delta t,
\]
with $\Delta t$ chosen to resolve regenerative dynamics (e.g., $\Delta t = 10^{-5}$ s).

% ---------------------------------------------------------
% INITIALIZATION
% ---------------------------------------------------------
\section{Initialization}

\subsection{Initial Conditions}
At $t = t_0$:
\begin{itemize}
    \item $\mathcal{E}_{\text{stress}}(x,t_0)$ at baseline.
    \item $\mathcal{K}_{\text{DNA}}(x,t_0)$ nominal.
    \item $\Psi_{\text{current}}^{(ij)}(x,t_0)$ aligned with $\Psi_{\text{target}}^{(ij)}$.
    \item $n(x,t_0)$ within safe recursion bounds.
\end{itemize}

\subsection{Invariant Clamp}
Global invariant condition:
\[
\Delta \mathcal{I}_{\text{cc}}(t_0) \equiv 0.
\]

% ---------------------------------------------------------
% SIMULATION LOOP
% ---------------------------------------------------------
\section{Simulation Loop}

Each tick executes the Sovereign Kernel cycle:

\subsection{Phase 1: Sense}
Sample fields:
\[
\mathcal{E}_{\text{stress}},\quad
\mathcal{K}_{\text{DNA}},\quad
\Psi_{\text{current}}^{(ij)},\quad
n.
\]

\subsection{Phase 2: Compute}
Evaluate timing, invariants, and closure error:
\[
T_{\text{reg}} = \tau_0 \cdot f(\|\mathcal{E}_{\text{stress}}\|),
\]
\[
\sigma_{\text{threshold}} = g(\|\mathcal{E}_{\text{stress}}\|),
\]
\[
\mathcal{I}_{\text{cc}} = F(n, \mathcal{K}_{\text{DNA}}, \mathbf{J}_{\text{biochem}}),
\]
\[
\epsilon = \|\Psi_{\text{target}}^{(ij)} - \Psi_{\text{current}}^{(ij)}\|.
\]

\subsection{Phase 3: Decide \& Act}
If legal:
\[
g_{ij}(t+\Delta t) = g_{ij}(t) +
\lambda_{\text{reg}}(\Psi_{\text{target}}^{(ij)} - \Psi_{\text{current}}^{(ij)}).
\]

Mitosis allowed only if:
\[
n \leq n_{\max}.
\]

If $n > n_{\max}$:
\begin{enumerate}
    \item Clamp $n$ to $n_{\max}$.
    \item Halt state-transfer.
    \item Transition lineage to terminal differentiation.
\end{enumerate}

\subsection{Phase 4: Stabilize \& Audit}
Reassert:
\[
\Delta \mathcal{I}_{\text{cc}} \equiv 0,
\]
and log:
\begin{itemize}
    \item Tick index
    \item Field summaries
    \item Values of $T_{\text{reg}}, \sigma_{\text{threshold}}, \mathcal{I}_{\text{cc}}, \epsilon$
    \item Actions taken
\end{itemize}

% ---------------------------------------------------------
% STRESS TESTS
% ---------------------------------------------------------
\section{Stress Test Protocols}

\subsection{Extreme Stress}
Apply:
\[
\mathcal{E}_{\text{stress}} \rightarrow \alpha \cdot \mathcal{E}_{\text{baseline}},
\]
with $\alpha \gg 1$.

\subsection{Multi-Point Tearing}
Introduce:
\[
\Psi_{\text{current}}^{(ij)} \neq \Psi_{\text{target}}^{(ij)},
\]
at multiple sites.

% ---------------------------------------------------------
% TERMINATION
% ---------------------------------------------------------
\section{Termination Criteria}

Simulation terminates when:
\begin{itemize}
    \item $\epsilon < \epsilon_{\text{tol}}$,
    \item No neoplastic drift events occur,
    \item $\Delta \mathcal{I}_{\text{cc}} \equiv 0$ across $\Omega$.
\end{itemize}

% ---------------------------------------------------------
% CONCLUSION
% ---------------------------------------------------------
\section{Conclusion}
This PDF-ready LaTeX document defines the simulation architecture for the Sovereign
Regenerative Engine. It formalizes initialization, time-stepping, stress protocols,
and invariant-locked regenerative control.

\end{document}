\section{Stress Test Protocols}

\subsection{Extreme Stress}
Apply:
\[
\mathcal{E}_{\text{stress}} \rightarrow \alpha \cdot \mathcal{E}_{\text{baseline}},
\]
with $\alpha \gg 1$.

\subsection{Multi-Point Tearing}
Introduce:
\[
\Psi_{\text{current}}^{(ij)} \neq \Psi_{\text{target}}^{(ij)},
\]
at multiple sites.

% ---------------------------------------------------------
% TERMINATION
% ---------------------------------------------------------
\section{Termination Criteria}

Simulation terminates when:
\begin{itemize}
    \item $\epsilon < \epsilon_{\text{tol}}$,
    \item No neoplastic drift events occur,
    \item $\Delta \mathcal{I}_{\text{cc}} \equiv 0$ across $\Omega$.
\end{itemize}

