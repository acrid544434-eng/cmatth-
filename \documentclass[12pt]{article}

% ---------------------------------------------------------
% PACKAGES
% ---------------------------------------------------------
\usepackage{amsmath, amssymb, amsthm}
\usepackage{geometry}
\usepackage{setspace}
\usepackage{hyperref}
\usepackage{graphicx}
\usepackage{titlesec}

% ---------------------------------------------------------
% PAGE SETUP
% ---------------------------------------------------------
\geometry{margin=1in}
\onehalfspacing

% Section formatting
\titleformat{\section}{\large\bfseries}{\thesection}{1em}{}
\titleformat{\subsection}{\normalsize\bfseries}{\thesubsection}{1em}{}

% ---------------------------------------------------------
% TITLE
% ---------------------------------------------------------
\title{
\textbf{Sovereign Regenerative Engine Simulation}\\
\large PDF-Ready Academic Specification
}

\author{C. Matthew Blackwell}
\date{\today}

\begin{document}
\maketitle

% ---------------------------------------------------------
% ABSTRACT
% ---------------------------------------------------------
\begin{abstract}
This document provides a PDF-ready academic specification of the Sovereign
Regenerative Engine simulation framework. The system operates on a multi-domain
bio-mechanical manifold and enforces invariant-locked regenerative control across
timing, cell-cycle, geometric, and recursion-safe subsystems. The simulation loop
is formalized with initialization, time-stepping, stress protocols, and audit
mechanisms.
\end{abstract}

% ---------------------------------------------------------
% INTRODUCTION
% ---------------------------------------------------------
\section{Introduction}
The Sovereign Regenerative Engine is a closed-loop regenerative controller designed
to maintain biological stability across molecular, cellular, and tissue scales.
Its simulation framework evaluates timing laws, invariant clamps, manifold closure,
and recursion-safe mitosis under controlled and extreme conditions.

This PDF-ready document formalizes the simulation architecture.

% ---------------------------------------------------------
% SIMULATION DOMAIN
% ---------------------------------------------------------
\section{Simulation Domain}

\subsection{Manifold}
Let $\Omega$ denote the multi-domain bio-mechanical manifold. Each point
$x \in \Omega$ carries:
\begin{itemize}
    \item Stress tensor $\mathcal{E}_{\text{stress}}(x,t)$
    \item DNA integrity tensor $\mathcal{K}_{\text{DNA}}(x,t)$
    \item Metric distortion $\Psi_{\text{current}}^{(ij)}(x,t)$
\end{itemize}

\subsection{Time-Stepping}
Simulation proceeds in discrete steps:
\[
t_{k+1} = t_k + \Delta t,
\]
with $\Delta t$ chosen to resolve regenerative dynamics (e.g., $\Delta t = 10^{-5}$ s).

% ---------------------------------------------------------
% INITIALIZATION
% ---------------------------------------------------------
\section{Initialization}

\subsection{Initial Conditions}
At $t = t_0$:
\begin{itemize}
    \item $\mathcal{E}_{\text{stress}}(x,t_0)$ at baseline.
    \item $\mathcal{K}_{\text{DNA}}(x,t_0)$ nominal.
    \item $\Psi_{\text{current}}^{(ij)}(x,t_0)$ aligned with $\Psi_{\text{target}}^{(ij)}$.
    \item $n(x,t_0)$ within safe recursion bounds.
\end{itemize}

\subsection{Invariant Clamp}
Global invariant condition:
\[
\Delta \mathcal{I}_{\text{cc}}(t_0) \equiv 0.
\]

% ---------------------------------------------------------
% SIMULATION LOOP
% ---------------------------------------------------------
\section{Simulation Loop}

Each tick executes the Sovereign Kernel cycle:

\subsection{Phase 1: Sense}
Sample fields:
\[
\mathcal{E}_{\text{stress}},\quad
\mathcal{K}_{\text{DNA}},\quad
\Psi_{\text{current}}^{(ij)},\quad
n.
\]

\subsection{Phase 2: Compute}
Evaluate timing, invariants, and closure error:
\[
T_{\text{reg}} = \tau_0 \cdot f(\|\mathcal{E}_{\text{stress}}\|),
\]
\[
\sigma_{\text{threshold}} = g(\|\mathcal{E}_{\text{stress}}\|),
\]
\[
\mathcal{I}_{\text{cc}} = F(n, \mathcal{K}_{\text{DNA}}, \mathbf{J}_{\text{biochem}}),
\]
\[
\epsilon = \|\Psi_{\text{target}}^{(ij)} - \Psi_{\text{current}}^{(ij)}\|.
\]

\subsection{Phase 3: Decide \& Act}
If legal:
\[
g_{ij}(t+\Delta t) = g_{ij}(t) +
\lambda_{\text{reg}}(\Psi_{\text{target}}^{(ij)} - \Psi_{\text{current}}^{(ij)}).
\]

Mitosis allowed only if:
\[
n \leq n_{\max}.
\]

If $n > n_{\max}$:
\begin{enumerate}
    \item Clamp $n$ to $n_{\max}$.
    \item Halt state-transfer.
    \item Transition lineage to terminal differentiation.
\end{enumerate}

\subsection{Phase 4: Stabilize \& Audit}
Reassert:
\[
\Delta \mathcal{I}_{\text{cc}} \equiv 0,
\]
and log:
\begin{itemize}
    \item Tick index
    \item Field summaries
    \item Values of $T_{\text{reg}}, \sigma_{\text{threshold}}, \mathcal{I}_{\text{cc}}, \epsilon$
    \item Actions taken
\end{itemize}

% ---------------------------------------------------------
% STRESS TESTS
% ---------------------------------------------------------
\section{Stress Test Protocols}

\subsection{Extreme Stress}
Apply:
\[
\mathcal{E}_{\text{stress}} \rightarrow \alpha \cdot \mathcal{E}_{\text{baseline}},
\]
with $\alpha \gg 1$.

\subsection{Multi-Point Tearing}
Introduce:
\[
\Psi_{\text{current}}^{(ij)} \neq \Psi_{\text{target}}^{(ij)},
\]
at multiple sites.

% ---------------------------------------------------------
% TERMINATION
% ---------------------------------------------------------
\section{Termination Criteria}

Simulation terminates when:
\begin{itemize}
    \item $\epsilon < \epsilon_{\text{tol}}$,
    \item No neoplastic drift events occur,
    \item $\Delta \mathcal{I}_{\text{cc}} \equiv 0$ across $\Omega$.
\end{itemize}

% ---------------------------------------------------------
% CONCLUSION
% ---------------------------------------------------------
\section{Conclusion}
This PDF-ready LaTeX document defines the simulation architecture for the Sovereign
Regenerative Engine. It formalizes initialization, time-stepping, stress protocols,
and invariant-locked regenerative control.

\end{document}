% ---------------------------------------------------------
% SIMULATION DOMAIN
% ---------------------------------------------------------
\section{Simulation Domain}

\subsection{Manifold}
Let $\Omega$ denote the multi-domain bio-mechanical manifold. Each point
$x \in \Omega$ carries:
\begin{itemize}
    \item Stress tensor $\mathcal{E}_{\text{stress}}(x,t)$
    \item DNA integrity tensor $\mathcal{K}_{\text{DNA}}(x,t)$
    \item Metric distortion $\Psi_{\text{current}}^{(ij)}(x,t)$
\end{itemize}

\subsection{Time-Stepping}
Simulation proceeds in discrete steps:
\[
t_{k+1} = t_k + \Delta t,
\]
with $\Delta t$ chosen to resolve regenerative dynamics (e.g., $\Delta t = 10^{-5}$ s).

% ---------------------------------------------------------
% INITIALIZATION
% ---------------------------------------------------------
\section{Initialization}

\subsection{Initial Conditions}
At $t = t_0$:
\begin{itemize}
    \item $\mathcal{E}_{\text{stress}}(x,t_0)$ at baseline.
    \item $\mathcal{K}_{\text{DNA}}(x,t_0)$ nominal.
    \item $\Psi_{\text{current}}^{(ij)}(x,t_0)$ aligned with $\Psi_{\text{target}}^{(ij)}$.
    \item $n(x,t_0)$ within safe recursion bounds.
\end{itemize}

\subsection{Invariant Clamp}
Global invariant condition:
\[
\Delta \mathcal{I}_{\text{cc}}(t_0) \equiv 0.
\]

% ---------------------------------------------------------
% SIMULATION LOOP
% ---------------------------------------------------------
\section{Simulation Loop}

Each tick executes the Sovereign Kernel cycle:

\subsection{Phase 1: Sense}
Sample fields:
\[
\mathcal{E}_{\text{stress}},\quad
\mathcal{K}_{\text{DNA}},\quad
\Psi_{\text{current}}^{(ij)},\quad
n.
\]

\subsection{Phase 2: Compute}
Evaluate timing, invariants, and closure error:
\[
T_{\text{reg}} = \tau_0 \cdot f(\|\mathcal{E}_{\text{stress}}\|),
\]
\[
\sigma_{\text{threshold}} = g(\|\mathcal{E}_{\text{stress}}\|),
\]
\[
\mathcal{I}_{\text{cc}} = F(n, \mathcal{K}_{\text{DNA}}, \mathbf{J}_{\text{biochem}}),
\]
\[
\epsilon = \|\Psi_{\text{target}}^{(ij)} - \Psi_{\text{current}}^{(ij)}\|.
\]

\subsection{Phase 3: Decide \& Act}
If legal:
\[
g_{ij}(t+\Delta t) = g_{ij}(t) +
\lambda_{\text{reg}}(\Psi_{\text{target}}^{(ij)} - \Psi_{\text{current}}^{(ij)}).
\]

Mitosis allowed only if:
\[
n \leq n_{\max}.
\]

If $n > n_{\max}$:
\begin{enumerate}
    \item Clamp $n$ to $n_{\max}$.
    \item Halt state-transfer.
    \item Transition lineage to terminal differentiation.
\end{enumerate}

\subsection{Phase 4: Stabilize \& Audit}
Reassert:
\[
\Delta \mathcal{I}_{\text{cc}} \equiv 0,
\]
and log:
\begin{itemize}
    \item Tick index
    \item Field summaries
    \item Values of $T_{\text{reg}}, \sigma_{\text{threshold}}, \mathcal{I}_{\text{cc}}, \epsilon$
    \item Actions taken
\end{itemize}

