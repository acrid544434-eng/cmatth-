\chapter{Mathematical Preliminaries}
\label{chap:math_prelim}

\section{Manifolds and Metrics}
Let $(\mathcal{M}, g_{\mu\nu})$ be a four-dimensional Lorentzian
manifold with signature $(-,+,+,+)$.

The invariant interval is:
\[
ds^2 = g_{\mu\nu} dx^\mu dx^\nu.
\]

\section{Tensor Calculus}
Christoffel symbols:
\[
\Gamma^\lambda_{\mu\nu}
= \frac{1}{2} g^{\lambda\sigma}
(\partial_\mu g_{\sigma\nu}
+ \partial_\nu g_{\sigma\mu}
- \partial_\sigma g_{\mu\nu}).
\]

Riemann tensor:
\[
R^\rho_{\ \sigma\mu\nu}
= \partial_\mu \Gamma^\rho_{\sigma\nu}
- \partial_\nu \Gamma^\rho_{\sigma\mu}
+ \Gamma^\rho_{\lambda\mu}\Gamma^\lambda_{\sigma\nu}
- \Gamma^\rho_{\lambda\nu}\Gamma^\lambda_{\sigma\mu}.
\]

