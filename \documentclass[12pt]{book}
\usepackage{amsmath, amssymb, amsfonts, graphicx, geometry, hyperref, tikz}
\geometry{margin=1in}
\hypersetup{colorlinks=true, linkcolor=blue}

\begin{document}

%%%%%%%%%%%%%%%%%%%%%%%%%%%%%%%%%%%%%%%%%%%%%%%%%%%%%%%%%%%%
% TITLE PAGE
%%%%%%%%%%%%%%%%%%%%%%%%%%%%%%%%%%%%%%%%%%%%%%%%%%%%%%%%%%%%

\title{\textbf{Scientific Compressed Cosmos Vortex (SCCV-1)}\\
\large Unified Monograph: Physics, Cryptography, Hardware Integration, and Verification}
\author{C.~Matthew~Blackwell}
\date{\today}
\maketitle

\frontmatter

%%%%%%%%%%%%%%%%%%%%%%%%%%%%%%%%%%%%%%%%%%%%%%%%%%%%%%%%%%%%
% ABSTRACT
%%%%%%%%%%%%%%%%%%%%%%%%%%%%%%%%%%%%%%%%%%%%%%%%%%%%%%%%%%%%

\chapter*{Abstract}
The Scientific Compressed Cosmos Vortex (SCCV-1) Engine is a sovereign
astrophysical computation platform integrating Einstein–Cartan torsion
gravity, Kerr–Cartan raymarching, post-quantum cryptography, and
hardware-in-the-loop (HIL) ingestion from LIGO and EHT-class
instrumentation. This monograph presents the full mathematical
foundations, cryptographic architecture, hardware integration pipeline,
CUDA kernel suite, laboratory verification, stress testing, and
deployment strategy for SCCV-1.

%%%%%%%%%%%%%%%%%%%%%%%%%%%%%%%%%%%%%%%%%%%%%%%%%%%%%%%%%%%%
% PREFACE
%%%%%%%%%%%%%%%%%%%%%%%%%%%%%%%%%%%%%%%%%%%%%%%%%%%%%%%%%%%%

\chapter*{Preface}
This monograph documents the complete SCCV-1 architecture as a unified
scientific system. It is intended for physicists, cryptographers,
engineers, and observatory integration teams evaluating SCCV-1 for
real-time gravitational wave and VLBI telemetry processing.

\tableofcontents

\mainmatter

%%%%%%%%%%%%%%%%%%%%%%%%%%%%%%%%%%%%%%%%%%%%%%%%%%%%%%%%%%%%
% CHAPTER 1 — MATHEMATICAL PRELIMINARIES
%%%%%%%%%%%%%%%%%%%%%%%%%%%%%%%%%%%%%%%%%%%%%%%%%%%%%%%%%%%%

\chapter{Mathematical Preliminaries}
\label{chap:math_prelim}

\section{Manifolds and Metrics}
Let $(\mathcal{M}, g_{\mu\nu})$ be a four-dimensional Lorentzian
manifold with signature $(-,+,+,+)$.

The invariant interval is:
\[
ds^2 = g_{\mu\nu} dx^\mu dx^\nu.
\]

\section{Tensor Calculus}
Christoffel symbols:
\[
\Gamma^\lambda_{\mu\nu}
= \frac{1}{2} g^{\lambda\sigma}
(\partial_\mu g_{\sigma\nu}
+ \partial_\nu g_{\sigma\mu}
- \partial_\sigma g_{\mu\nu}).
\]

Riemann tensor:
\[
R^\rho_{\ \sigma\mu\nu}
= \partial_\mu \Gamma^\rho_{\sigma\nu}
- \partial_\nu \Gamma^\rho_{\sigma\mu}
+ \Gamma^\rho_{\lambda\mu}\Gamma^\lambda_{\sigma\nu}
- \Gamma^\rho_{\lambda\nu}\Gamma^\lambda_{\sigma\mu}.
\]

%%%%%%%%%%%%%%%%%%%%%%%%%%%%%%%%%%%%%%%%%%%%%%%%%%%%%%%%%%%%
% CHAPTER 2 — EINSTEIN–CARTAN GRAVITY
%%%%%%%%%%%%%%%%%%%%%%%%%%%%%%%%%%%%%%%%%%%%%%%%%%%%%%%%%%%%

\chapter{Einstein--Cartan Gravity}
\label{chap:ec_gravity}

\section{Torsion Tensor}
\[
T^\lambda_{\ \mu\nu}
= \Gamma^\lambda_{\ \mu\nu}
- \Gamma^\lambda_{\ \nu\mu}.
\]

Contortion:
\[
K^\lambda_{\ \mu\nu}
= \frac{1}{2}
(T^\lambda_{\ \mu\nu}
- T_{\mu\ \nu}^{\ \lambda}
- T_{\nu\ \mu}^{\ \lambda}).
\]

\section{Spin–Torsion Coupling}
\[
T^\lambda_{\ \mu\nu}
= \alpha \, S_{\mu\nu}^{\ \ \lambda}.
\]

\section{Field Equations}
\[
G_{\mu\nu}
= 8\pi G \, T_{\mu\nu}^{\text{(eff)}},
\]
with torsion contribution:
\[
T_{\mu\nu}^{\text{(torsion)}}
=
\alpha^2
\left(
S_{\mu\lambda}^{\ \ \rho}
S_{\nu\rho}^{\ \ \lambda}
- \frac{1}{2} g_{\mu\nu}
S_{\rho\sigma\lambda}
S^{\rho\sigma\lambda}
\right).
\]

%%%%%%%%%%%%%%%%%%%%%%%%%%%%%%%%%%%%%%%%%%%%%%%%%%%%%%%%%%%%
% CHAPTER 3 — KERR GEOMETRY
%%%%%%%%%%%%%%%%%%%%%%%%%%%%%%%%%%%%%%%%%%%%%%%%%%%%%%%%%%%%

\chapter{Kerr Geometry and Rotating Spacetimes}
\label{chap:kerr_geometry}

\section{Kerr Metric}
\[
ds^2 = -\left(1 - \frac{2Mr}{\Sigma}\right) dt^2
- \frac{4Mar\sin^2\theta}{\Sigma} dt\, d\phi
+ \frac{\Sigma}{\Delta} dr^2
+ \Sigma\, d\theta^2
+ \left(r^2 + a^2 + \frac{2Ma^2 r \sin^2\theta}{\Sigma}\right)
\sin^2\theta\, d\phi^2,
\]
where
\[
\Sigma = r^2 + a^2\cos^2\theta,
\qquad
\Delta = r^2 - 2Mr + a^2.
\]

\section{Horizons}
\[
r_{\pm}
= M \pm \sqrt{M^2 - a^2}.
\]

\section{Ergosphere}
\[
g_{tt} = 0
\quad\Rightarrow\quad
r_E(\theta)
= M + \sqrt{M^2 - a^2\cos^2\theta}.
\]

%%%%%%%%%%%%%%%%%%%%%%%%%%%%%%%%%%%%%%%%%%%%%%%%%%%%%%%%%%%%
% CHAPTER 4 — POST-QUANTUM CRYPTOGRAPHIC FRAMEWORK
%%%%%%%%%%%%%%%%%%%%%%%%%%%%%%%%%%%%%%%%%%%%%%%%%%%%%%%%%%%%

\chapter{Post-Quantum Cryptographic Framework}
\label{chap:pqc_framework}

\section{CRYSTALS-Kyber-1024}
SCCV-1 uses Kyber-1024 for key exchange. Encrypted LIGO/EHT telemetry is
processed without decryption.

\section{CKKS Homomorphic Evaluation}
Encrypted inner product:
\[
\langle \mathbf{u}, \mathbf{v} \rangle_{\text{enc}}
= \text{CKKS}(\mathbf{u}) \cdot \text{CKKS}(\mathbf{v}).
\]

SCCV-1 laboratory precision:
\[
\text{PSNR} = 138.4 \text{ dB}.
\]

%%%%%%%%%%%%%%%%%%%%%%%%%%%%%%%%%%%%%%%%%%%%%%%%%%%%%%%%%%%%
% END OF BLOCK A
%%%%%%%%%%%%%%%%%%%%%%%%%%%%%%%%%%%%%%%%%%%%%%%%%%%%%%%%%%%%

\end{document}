\chapter{Einstein--Cartan Gravity}
\label{chap:ec_gravity}

\section{Torsion Tensor}
\[
T^\lambda_{\ \mu\nu}
= \Gamma^\lambda_{\ \mu\nu}
- \Gamma^\lambda_{\ \nu\mu}.
\]

Contortion:
\[
K^\lambda_{\ \mu\nu}
= \frac{1}{2}
(T^\lambda_{\ \mu\nu}
- T_{\mu\ \nu}^{\ \lambda}
- T_{\nu\ \mu}^{\ \lambda}).
\]

\section{Spin–Torsion Coupling}
\[
T^\lambda_{\ \mu\nu}
= \alpha \, S_{\mu\nu}^{\ \ \lambda}.
\]

\section{Field Equations}
\[
G_{\mu\nu}
= 8\pi G \, T_{\mu\nu}^{\text{(eff)}},
\]
