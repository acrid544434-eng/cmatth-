\section{Unified Invariant Functional}

\begin{definition}
The sovereign invariant is defined as
\begin{equation}
\mathcal{I}_{\text{cc}}[\Psi]
=
\int_{\Omega}
w(x)\,\Psi(x,t)\, dx.
\end{equation}
\end{definition}

\begin{theorem}
The invariant satisfies
\begin{equation}
\Delta \mathcal{I}_{\text{cc}} = 0.
\end{equation}
\end{theorem}

\begin{proof}
The invariant is preserved if the weighted contributions of all stress-test
operators sum to zero.
\end{proof}

