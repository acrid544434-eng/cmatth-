\begin{lemma}
For small entropy perturbations,
\begin{equation}
\exp\left(\frac{S}{k_B}\right)
\approx
1 + \frac{S}{k_B}.
\end{equation}
\end{lemma}

\begin{proof}
This follows from the Taylor expansion of the exponential function.
\end{proof}

