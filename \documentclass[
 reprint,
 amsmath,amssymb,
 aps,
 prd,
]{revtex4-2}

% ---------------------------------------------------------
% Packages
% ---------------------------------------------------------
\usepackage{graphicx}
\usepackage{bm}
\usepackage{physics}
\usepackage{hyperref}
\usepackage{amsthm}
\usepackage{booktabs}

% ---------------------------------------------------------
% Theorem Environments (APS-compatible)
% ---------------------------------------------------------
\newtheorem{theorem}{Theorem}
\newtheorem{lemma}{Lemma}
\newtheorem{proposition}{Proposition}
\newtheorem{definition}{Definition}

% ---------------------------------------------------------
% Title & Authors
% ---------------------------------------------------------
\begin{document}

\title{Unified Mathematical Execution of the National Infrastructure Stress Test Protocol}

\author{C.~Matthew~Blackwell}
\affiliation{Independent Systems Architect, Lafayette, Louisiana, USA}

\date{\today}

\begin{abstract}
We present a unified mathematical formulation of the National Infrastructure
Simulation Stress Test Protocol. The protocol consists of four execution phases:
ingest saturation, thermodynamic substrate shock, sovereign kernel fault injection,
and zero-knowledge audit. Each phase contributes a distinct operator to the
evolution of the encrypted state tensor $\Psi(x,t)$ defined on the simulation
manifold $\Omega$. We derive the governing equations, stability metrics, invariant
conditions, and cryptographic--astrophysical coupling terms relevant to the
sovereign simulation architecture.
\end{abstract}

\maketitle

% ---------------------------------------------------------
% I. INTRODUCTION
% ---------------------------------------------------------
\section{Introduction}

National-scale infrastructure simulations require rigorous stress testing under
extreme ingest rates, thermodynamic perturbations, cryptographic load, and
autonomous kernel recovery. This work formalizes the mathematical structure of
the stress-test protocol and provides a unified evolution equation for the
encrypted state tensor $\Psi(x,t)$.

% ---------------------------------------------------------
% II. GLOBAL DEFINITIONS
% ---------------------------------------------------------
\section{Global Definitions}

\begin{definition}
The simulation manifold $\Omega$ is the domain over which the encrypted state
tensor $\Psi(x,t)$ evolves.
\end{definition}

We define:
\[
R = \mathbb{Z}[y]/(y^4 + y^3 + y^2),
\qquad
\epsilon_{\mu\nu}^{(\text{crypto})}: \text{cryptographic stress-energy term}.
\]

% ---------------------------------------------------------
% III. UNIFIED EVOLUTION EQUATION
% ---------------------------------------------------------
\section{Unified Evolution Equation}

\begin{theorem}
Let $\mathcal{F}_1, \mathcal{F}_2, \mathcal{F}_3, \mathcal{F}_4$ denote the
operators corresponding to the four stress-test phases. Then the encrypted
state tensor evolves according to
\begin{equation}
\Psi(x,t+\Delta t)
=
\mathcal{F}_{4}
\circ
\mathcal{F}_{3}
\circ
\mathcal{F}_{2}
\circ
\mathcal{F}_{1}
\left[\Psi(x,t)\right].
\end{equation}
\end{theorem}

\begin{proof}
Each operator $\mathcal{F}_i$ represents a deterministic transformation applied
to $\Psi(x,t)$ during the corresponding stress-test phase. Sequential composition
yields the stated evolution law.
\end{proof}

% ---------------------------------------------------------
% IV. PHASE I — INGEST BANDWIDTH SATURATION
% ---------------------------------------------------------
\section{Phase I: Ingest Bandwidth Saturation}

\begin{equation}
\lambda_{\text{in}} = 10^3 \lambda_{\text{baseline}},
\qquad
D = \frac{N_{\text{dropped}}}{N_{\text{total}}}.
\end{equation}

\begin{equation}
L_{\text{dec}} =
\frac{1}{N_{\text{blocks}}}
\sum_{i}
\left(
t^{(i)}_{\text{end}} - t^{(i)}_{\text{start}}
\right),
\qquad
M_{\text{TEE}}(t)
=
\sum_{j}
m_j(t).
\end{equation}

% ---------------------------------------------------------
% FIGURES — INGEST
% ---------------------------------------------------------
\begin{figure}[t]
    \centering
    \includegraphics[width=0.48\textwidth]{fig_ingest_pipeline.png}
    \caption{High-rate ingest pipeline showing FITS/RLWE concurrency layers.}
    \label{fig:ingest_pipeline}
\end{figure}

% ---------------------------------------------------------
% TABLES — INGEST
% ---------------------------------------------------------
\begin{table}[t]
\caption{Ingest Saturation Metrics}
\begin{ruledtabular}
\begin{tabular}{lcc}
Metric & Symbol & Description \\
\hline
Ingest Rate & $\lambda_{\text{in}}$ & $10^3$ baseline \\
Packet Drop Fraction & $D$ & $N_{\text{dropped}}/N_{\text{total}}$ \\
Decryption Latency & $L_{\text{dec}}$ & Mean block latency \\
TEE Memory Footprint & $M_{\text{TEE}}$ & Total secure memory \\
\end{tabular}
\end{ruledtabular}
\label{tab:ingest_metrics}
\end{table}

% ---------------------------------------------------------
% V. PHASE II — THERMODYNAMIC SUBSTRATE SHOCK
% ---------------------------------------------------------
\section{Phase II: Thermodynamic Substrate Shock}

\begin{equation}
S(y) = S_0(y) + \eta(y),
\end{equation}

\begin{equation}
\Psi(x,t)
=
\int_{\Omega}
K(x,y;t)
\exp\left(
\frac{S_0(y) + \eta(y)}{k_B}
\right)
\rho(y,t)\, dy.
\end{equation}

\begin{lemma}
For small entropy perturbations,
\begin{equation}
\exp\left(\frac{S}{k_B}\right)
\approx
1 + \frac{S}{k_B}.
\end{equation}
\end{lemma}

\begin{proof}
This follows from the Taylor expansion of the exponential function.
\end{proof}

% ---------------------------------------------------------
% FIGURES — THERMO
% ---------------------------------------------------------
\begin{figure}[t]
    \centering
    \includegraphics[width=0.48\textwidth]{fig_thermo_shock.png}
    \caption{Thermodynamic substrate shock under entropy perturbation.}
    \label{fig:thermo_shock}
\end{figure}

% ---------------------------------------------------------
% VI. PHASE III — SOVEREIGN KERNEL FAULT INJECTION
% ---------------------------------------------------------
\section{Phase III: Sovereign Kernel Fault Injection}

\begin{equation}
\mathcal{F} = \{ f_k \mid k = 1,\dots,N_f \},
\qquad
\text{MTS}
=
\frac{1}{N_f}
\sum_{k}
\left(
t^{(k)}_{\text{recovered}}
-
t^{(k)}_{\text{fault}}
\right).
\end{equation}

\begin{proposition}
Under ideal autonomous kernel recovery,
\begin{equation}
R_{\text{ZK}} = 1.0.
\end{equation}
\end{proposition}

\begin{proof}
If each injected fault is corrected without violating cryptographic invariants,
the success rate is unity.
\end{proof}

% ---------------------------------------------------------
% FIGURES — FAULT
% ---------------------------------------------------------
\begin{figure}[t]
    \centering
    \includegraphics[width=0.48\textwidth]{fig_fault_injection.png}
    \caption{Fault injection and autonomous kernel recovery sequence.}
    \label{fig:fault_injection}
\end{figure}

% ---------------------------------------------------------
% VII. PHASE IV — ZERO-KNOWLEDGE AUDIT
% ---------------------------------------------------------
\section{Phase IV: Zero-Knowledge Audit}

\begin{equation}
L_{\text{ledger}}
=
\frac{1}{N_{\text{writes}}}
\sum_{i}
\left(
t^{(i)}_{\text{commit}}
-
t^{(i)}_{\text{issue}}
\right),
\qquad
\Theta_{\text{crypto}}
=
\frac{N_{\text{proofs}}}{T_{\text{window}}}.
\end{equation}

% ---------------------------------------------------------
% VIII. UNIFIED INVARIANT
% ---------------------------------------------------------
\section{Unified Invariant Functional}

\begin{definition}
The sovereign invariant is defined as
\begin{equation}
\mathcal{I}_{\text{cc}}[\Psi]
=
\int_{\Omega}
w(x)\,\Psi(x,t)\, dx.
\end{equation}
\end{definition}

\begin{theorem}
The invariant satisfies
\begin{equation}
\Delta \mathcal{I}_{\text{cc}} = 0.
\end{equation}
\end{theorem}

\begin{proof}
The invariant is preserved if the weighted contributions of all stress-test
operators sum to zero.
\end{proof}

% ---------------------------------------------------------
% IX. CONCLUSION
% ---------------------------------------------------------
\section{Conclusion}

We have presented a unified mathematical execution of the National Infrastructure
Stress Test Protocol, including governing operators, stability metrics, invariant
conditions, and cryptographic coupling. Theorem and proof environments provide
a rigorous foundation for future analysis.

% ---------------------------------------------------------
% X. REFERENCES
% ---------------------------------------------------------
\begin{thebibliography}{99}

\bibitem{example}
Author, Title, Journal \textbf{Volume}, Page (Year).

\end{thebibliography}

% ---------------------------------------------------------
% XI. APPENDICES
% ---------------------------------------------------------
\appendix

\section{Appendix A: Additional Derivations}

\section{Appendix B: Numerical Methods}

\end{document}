% III. UNIFIED EVOLUTION EQUATION
% ---------------------------------------------------------
\section{Unified Evolution Equation}

\begin{theorem}
Let $\mathcal{F}_1, \mathcal{F}_2, \mathcal{F}_3, \mathcal{F}_4$ denote the
operators corresponding to the four stress-test phases. Then the encrypted
state tensor evolves according to
\begin{equation}
\Psi(x,t+\Delta t)
=
\mathcal{F}_{4}
\circ
\mathcal{F}_{3}
\circ
\mathcal{F}_{2}
\circ
\mathcal{F}_{1}
\left[\Psi(x,t)\right].
\end{equation}
\end{theorem}

\begin{proof}
Each operator $\mathcal{F}_i$ represents a deterministic transformation applied
to $\Psi(x,t)$ during the corresponding stress-test phase. Sequential composition
yields the stated evolution law.
\end{proof}

