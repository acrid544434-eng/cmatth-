\section{Mathematical Foundations}
Let $(\mathcal{M}, g_{\mu\nu})$ be a Lorentzian manifold with signature
$(-,+,+,+)$.

\subsection{Metric Tensor}
\[
ds^2 = g_{\mu\nu} dx^\mu dx^\nu.
\]

\subsection{Christoffel Symbols}
\[
\Gamma^\lambda_{\mu\nu}
= \frac{1}{2} g^{\lambda\sigma}
(\partial_\mu g_{\sigma\nu}
+ \partial_\nu g_{\sigma\mu}
- \partial_\sigma g_{\mu\nu}).
\]

\subsection{Riemann Tensor}
\[
R^\rho_{\ \sigma\mu\nu}
= \partial_\mu \Gamma^\rho_{\sigma\nu}
- \partial_\nu \Gamma^\rho_{\sigma\mu}
+ \Gamma^\rho_{\lambda\mu}\Gamma^\lambda_{\sigma\nu}
- \Gamma^\rho_{\lambda\nu}\Gamma^\lambda_{\sigma\mu}.
\]

\section{Einstein--Cartan Gravity}
Einstein--Cartan (EC) gravity generalizes GR by introducing torsion.

\subsection{Torsion Tensor}
\[
T^\lambda_{\ \mu\nu}
= \Gamma^\lambda_{\ \mu\nu}
- \Gamma^\lambda_{\ \nu\mu}.
\]

\subsection{Contortion Tensor}
\[
K^\lambda_{\ \mu\nu}
= \frac{1}{2}
(T^\lambda_{\ \mu\nu}
- T_{\mu\ \nu}^{\ \lambda}
- T_{\nu\ \mu}^{\ \lambda}).
\]

\subsection{Spin--Torsion Coupling}
\[
T^\lambda_{\ \mu\nu}
= \alpha \, S_{\mu\nu}^{\ \ \lambda}.
\]

\subsection{Field Equations}
\[
G_{\mu\nu}
= 8\pi G \, T_{\mu\nu}^{\text{(eff)}},
\]
with torsion contribution:
\[
T_{\mu\nu}^{\text{(torsion)}}
=
\alpha^2
\left(
S_{\mu\lambda}^{\ \ \rho}
S_{\nu\rho}^{\ \ \lambda}
- \frac{1}{2} g_{\mu\nu}
S_{\rho\sigma\lambda}
S^{\rho\sigma\lambda}
\right).
\]

\section{Kerr Geometry}
The Kerr metric in Boyer--Lindquist coordinates is:
\[
ds^2 = -\left(1 - \frac{2Mr}{\Sigma}\right) dt^2
- \frac{4Mar\sin^2\theta}{\Sigma} dt\, d\phi
+ \frac{\Sigma}{\Delta} dr^2
+ \Sigma\, d\theta^2
+ \left(r^2 + a^2 + \frac{2Ma^2 r \sin^2\theta}{\Sigma}\right)
\sin^2\theta\, d\phi^2,
\]
where
\[
\Sigma = r^2 + a^2\cos^2\theta,
\qquad
\Delta = r^2 - 2Mr + a^2.
\]

\subsection{Horizons}
\[
r_{\pm}
= M \pm \sqrt{M^2 - a^2}.
\]

\subsection{Ergosphere}
\[
g_{tt} = 0
\quad\Rightarrow\quad
r_E(\theta)
= M + \sqrt{M^2 - a^2\cos^2\theta}.
\]

